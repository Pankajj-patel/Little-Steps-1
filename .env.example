# ==============================================================================
# LittleSteps Environment Configuration Template
# Copy to .env for local development. In production, inject secrets via your
# cloud secret manager (e.g., GCP Secret Manager, AWS Secrets Manager).
# NEVER commit real secrets to version control.
# ==============================================================================

# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Cryptographic Signing Secrets (REQUIRED in production — minimum 32 random bytes hex)
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-char-random-hex-session-secret"
VIDEO_TOKEN_SECRET="replace-with-64-char-random-hex-video-stream-secret"

# Database Configuration
# Prototype / Local Development (SQLite)
SQLITE_DB_PATH="./data/littlesteps.db"
# Production Target (Managed PostgreSQL / Cloud SQL with TLS)
# DATABASE_URL="postgresql://littlesteps_app:REPLACE_ME@10.0.0.10:5432/littlesteps?sslmode=verify-full"

# Private Video Storage Configuration
# Local Demo Vault (strictly outside public/ and dist/; NOT for production real child videos)
PRIVATE_MEDIA_DIR="./private_media"
# Production Private Object Storage (optional — uncomment when connecting GCS / S3 / R2)
# OBJECT_STORAGE_PROVIDER="gcs"
# OBJECT_STORAGE_BUCKET="littlesteps-private-media-prod"
# OBJECT_STORAGE_REGION="asia-south1"
# OBJECT_STORAGE_KMS_KEY_ID=""

# Video Privacy Retention Policy (days)
RETENTION_DAYS="30"

# Transactional Email (optional until production launch — uncomment when connecting SMTP)
# SMTP_HOST="smtp.postmarkapp.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="LittleSteps <no-reply@littlesteps.in>"

# AI Studio Runtime Metadata (auto-injected in AI Studio preview environments)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
