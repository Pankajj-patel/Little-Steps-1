    tool_calls {
      id: "call_16923254338776318387"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Update frontend API client for Step 8 reviewer dashboard summary and 4-level rubric submission modes (draft, publish, not_assessable).\", \"Instruction\":\"Import ReviewerDashboardSummary and update getReviewerQueue and submitReview signatures in src/lib/api.ts.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":18, \"ReplacementContent\":\"  PreferredActivityTime,\\n  ReviewerDashboardSummary,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\", \"StartLine\":12, \"TargetContent\":\"  PreferredActivityTime,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\"}, {\"AllowMultiple\":false, \"EndLine\":326, \"ReplacementContent\":\"  // Reviewer\\n  getReviewerQueue: (status: SubmissionReviewStatus | \'all\', ageGroupSlug: string) =>\\n    requestJson<{ summary: ReviewerDashboardSummary; queue: ReviewerQueueItem[] }>(\\n      `/api/v1/reviewer/queue?status=${encodeURIComponent(status)}&ageGroupSlug=${encodeURIComponent(ageGroupSlug)}`\\n    ),\\n  claimSubmission: (submissionId: string) =>\\n    requestJson<ReviewerSubmissionDetail>(`/api/v1/reviewer/submissions/${submissionId}/claim`, {\\n      method: \'POST\',\\n    }),\\n  getReviewerSubmissionDetail: (submissionId: string) =>\\n    requestJson<ReviewerSubmissionDetail>(`/api/v1/reviewer/submissions/${submissionId}`),\\n  submitReview: (\\n    submissionId: string,\\n    payload: {\\n      mode?: \'draft\' | \'publish\' | \'not_assessable\';\\n      strengthsNote?: string;\\n      coachingTip?: string;\\n      reviewerComments?: string | null;\\n      notAssessableReason?: string | null;\\n      evaluationScopeAcknowledged: boolean;\\n      criterionRatings: Array<{\\n        criterionId: string;\\n        achievedLevel: RubricAchievementLevel;\\n        explanation?: string | null;\\n      }>;\\n    }\\n  ) =>\\n    requestJson<{ review: SubmissionReviewDetail; detail?: ReviewerSubmissionDetail | null }>(\\n      `/api/v1/reviewer/submissions/${submissionId}/review`,\\n      {\\n        method: \'POST\',\\n        body: JSON.stringify(payload),\\n      }\\n    ),\", \"StartLine\":299, \"TargetContent\":\"  // Reviewer\\n  getReviewerQueue: (status: SubmissionReviewStatus | \'all\', ageGroupSlug: string) =>\\n    requestJson<{ queue: ReviewerQueueItem[] }>(\\n      `/api/v1/reviewer/queue?status=${encodeURIComponent(status)}&ageGroupSlug=${encodeURIComponent(ageGroupSlug)}`\\n    ),\\n  claimSubmission: (submissionId: string) =>\\n    requestJson<ReviewerSubmissionDetail>(`/api/v1/reviewer/submissions/${submissionId}/claim`, {\\n      method: \'POST\',\\n    }),\\n  getReviewerSubmissionDetail: (submissionId: string) =>\\n    requestJson<ReviewerSubmissionDetail>(`/api/v1/reviewer/submissions/${submissionId}`),\\n  submitReview: (\\n    submissionId: string,\\n    payload: {\\n      strengthsNote: string;\\n      coachingTip: string;\\n      evaluationScopeAcknowledged: true;\\n      criterionRatings: Array<{ criterionId: string; achievedLevel: RubricAchievementLevel }>;\\n    }\\n  ) =>\\n    requestJson<{ review: SubmissionReviewDetail }>(\\n      `/api/v1/reviewer/submissions/${submissionId}/review`,\\n      {\\n        method: \'POST\',\\n        body: JSON.stringify(payload),\\n      }\\n    ),\"}], \"TargetFile\":\"/src/lib/api.ts\", \"toolAction\":\"Updating frontend API client for Step 8\", \"toolSummary\":\"Update frontend API client\"}"
      original_name: "multi_replace_file_content"
    }
