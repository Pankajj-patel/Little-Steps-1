    tool_calls {
      id: "call_2740655205552799227"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Upgrade LittleStepsRepository with Step 8 reviewer dashboard summary, privacy-minimized parent references, priority calculation, 4-level rubric calculation with Not Assessable exclusion, draft/publish/edit/not_assessable workflows, and immutable review audit history.\", \"Instruction\":\"Update imports, notifications, review detail retrieval, requestSubmissionChanges, reviewer queue/dashboard summary, submission detail, and submitRubricReview in server/repositories/index.ts.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":38, \"ReplacementContent\":\"  MediaAuditLogItem,\\n  QueuePriority,\\n  ReviewAuditAction,\\n  ReviewHistoryEntry,\\n  ReviewerDashboardSummary,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  ReviewPublicationStatus,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\\n  UpcomingPlanDay,\\n  UserProfile,\\n  UserRole,\\n  VideoStorageMode,\\n  VideoSubmissionSummary,\\n} from \'../../src/shared/types\';\\nimport {\\n  calculateAgeInMonths,\\n  calculateInstructionMatchScore,\\n  getRubricMultiplier,\\n  resolveAgeGroupSlug,\\n} from \'../../src/shared/domain\';\", \"StartLine\":20, \"TargetContent\":\"  MediaAuditLogItem,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\\n  UpcomingPlanDay,\\n  UserProfile,\\n  UserRole,\\n  VideoStorageMode,\\n  VideoSubmissionSummary,\\n} from \'../../src/shared/types\';\\nimport {\\n  calculateAgeInMonths,\\n  getRubricMultiplier,\\n  resolveAgeGroupSlug,\\n} from \'../../src/shared/domain\';\"}, {\"AllowMultiple\":false, \"EndLine\":1382, \"ReplacementContent\":\"    submissions.slice(0, 4).forEach((sub) => {\\n      if (sub.review) {\\n        const scoreSummary =\\n          sub.review.isAssessable && sub.review.instructionMatchScorePct !== null\\n            ? `Instruction-match ${sub.review.instructionMatchScorePct}% \302\267 Includes positive observations and gentle tips from ${sub.review.reviewerName}.`\\n            : `Marked Not Assessable \302\267 ${sub.review.reviewerName} left a clear explanation and gentle guidance.`;\\n        notifications.push({\\n          id: `notif_rev_${sub.id}`,\\n          kind: \'review_ready\',\\n          title: `Caregiver feedback ready for ${sub.activityTitle}`,\\n          description: scoreSummary,\\n          createdAt: sub.review.submittedAt,\\n          actionLabel: \'View Feedback\',\\n          targetSection: \'progress\',\\n        });\", \"StartLine\":1367, \"TargetContent\":\"    submissions.slice(0, 4).forEach((sub) => {\\n      if (sub.review) {\\n        notifications.push({\\n          id: `notif_rev_${sub.id}`,\\n          kind: \'review_ready\',\\n          title: `Caregiver feedback ready for ${sub.activityTitle}`,\\n          description: `Instruction-match ${sub.review.instructionMatchScorePct}% \302\267 Includes strengths and a gentle next-time tip from ${sub.review.reviewerName}.`,\\n          createdAt: sub.review.submittedAt,\\n          actionLabel: \'View Feedback\',\\n          targetSection: \'progress\',\\n        });\"}, {\"AllowMultiple\":false, \"EndLine\":1600, \"ReplacementContent\":\"  private formatParentReference(parentUserId: string): string {\\n    const cleaned = parentUserId.replace(/[^a-zA-Z0-9]/g, \'\').toUpperCase();\\n    return `PAR-${cleaned.slice(-6).padStart(6, \'0\')}`;\\n  }\\n\\n  private computeQueuePriority(\\n    status: SubmissionReviewStatus,\\n    createdAt: string,\\n    expiresAt: string\\n  ): QueuePriority {\\n    if (status === \'reviewed\' || status === \'deleted\' || status === \'resubmit_requested\') {\\n      return \'low\';\\n    }\\n    const nowMs = Date.now();\\n    const ageHours = (nowMs - new Date(createdAt).getTime()) / (1000 * 60 * 60);\\n    const daysToExpiry = (new Date(expiresAt).getTime() - nowMs) / (1000 * 60 * 60 * 24);\\n    if (ageHours >= 24 || daysToExpiry <= 5) {\\n      return \'high\';\\n    }\\n    return \'normal\';\\n  }\\n\\n  private appendReviewAuditHistory(params: {\\n    submissionId: string;\\n    reviewId: string | null;\\n    actorUserId: string;\\n    action: ReviewAuditAction;\\n    version: number;\\n    isAssessable: boolean;\\n    instructionMatchScorePct: number | null;\\n    summaryNote: string | null;\\n    snapshot: Record<string, unknown>;\\n  }): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO review_audit_history (\\n           id, submission_id, review_id, actor_user_id, action, version,\\n           is_assessable, instruction_match_score_pct, summary_note, snapshot_json\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`\\n      )\\n      .run(\\n        `rh_${crypto.randomUUID().slice(0, 12)}`,\\n        params.submissionId,\\n        params.reviewId,\\n        params.actorUserId,\\n        params.action,\\n        params.version,\\n        params.isAssessable ? 1 : 0,\\n        params.instructionMatchScorePct,\\n        params.summaryNote,\\n        JSON.stringify(params.snapshot)\\n      );\\n  }\\n\\n  listReviewHistory(submissionId: string): ReviewHistoryEntry[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT rah.*, u.full_name as actor_name\\n         FROM review_audit_history rah\\n         JOIN users u ON u.id = rah.actor_user_id\\n         WHERE rah.submission_id = ?\\n         ORDER BY rah.created_at DESC`\\n      )\\n      .all(submissionId) as Array<{\\n      id: string;\\n      submission_id: string;\\n      review_id: string | null;\\n      actor_user_id: string;\\n      actor_name: string;\\n      action: ReviewAuditAction;\\n      version: number;\\n      is_assessable: number;\\n      instruction_match_score_pct: number | null;\\n      summary_note: string | null;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      submissionId: r.submission_id,\\n      reviewId: r.review_id,\\n      actorUserId: r.actor_user_id,\\n      actorName: r.actor_name,\\n      action: r.action,\\n      version: r.version,\\n      isAssessable: r.is_assessable === 1,\\n      instructionMatchScorePct: r.instruction_match_score_pct,\\n      summaryNote: r.summary_note,\\n      createdAt: r.created_at,\\n    }));\\n  }\\n\\n  getReviewDetailForSubmission(\\n    submissionId: string,\\n    includeDraft = false\\n  ): SubmissionReviewDetail | null {\\n    const statusClause = includeDraft ? \'\' : \\\"AND sr.review_status = \'published\'\\\";\\n    const rev = this.db\\n      .prepare(\\n        `SELECT sr.*, u.full_name as reviewer_name\\n         FROM submission_reviews sr\\n         JOIN users u ON u.id = sr.reviewer_user_id\\n         WHERE sr.submission_id = ? ${statusClause}`\\n      )\\n      .get(submissionId) as\\n      | {\\n          id: string;\\n          submission_id: string;\\n          reviewer_user_id: string;\\n          reviewer_name: string;\\n          review_status: ReviewPublicationStatus;\\n          version: number;\\n          is_assessable: number;\\n          not_assessable_reason: string | null;\\n          instruction_match_score_pct: number | null;\\n          strengths_note: string;\\n          coaching_tip: string;\\n          reviewer_comments: string | null;\\n          evaluation_scope_acknowledged_at: string;\\n          submitted_at: string;\\n        }\\n      | undefined;\\n\\n    if (!rev) return null;\\n\\n    const scoreRows = this.db\\n      .prepare(\\n        `SELECT rrs.*, arc.label as criterion_label, arc.description as criterion_description\\n         FROM review_rubric_scores rrs\\n         JOIN activity_rubric_criteria arc ON arc.id = rrs.rubric_criterion_id\\n         WHERE rrs.review_id = ?\\n         ORDER BY arc.criterion_order ASC`\\n      )\\n      .all(rev.id) as Array<{\\n      id: string;\\n      rubric_criterion_id: string;\\n      criterion_label: string;\\n      criterion_description: string;\\n      achieved_level: RubricAchievementLevel;\\n      earned_points: number;\\n      max_points: number;\\n      explanation: string | null;\\n    }>;\\n\\n    let applicableWeightPoints = 0;\\n    let earnedWeightPoints = 0;\\n    for (const row of scoreRows) {\\n      if (row.achieved_level !== \'not_assessable\') {\\n        applicableWeightPoints += row.max_points;\\n        earnedWeightPoints += row.earned_points;\\n      }\\n    }\\n\\n    return {\\n      id: rev.id,\\n      submissionId: rev.submission_id,\\n      reviewerUserId: rev.reviewer_user_id,\\n      reviewerName: rev.reviewer_name,\\n      reviewStatus: rev.review_status ?? \'published\',\\n      version: rev.version ?? 1,\\n      isAssessable: (rev.is_assessable ?? 1) === 1,\\n      notAssessableReason: rev.not_assessable_reason ?? null,\\n      instructionMatchScorePct: rev.instruction_match_score_pct ?? null,\\n      applicableWeightPoints,\\n      earnedWeightPoints,\\n      strengthsNote: rev.strengths_note,\\n      coachingTip: rev.coaching_tip,\\n      reviewerComments: rev.reviewer_comments ?? null,\\n      evaluationScopeAcknowledgedAt: rev.evaluation_scope_acknowledged_at,\\n      submittedAt: rev.submitted_at,\\n      rubricScores: scoreRows.map((s) => ({\\n        id: s.id,\\n        criterionId: s.rubric_criterion_id,\\n        criterionLabel: s.criterion_label,\\n        criterionDescription: s.criterion_description,\\n        achievedLevel: s.achieved_level,\\n        earnedPoints: s.earned_points,\\n        maxPoints: s.max_points,\\n        explanation: s.explanation ?? null,\\n      })),\\n    };\\n  }\", \"StartLine\":1537, \"TargetContent\":\"  getReviewDetailForSubmission(submissionId: string): SubmissionReviewDetail | null {\\n    const rev = this.db\\n      .prepare(\\n        `SELECT sr.*, u.full_name as reviewer_name\\n         FROM submission_reviews sr\\n         JOIN users u ON u.id = sr.reviewer_user_id\\n         WHERE sr.submission_id = ?`\\n      )\\n      .get(submissionId) as\\n      | {\\n          id: string;\\n          submission_id: string;\\n          reviewer_user_id: string;\\n          reviewer_name: string;\\n          instruction_match_score_pct: number;\\n          strengths_note: string;\\n          coaching_tip: string;\\n          evaluation_scope_acknowledged_at: string;\\n          submitted_at: string;\\n        }\\n      | undefined;\\n\\n    if (!rev) return null;\\n\\n    const scoreRows = this.db\\n      .prepare(\\n        `SELECT rrs.*, arc.label as criterion_label, arc.description as criterion_description\\n         FROM review_rubric_scores rrs\\n         JOIN activity_rubric_criteria arc ON arc.id = rrs.rubric_criterion_id\\n         WHERE rrs.review_id = ?\\n         ORDER BY arc.criterion_order ASC`\\n      )\\n      .all(rev.id) as Array<{\\n      id: string;\\n      rubric_criterion_id: string;\\n      criterion_label: string;\\n      criterion_description: string;\\n      achieved_level: RubricAchievementLevel;\\n      earned_points: number;\\n      max_points: number;\\n    }>;\\n\\n    return {\\n      id: rev.id,\\n      submissionId: rev.submission_id,\\n      reviewerUserId: rev.reviewer_user_id,\\n      reviewerName: rev.reviewer_name,\\n      instructionMatchScorePct: rev.instruction_match_score_pct,\\n      strengthsNote: rev.strengths_note,\\n      coachingTip: rev.coaching_tip,\\n      evaluationScopeAcknowledgedAt: rev.evaluation_scope_acknowledged_at,\\n      submittedAt: rev.submitted_at,\\n      rubricScores: scoreRows.map((s) => ({\\n        id: s.id,\\n        criterionId: s.rubric_criterion_id,\\n        criterionLabel: s.criterion_label,\\n        criterionDescription: s.criterion_description,\\n        achievedLevel: s.achieved_level,\\n        earnedPoints: s.earned_points,\\n        maxPoints: s.max_points,\\n      })),\\n    };\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":1795, \"ReplacementContent\":\"  requestSubmissionChanges(\\n    submissionId: string,\\n    reviewerUserId: string,\\n    note: string\\n  ): boolean {\\n    const raw = this.findSubmissionRawById(submissionId);\\n    if (!raw || raw.deleted_at || raw.review_status === \'reviewed\') {\\n      return false;\\n    }\\n    if (raw.assigned_reviewer_id && raw.assigned_reviewer_id !== reviewerUserId) {\\n      return false;\\n    }\\n    const trimmedNote = note.trim();\\n    const res = this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET review_status = \'resubmit_requested\',\\n             assigned_reviewer_id = ?,\\n             change_request_note = ?\\n         WHERE id = ?`\\n      )\\n      .run(reviewerUserId, trimmedNote, submissionId);\\n    if (res.changes > 0) {\\n      this.appendReviewAuditHistory({\\n        submissionId,\\n        reviewId: null,\\n        actorUserId: reviewerUserId,\\n        action: \'changes_requested\',\\n        version: 1,\\n        isAssessable: false,\\n        instructionMatchScorePct: null,\\n        summaryNote: trimmedNote,\\n        snapshot: { changeRequestNote: trimmedNote },\\n      });\\n    }\\n    return res.changes > 0;\\n  }\", \"StartLine\":1772, \"TargetContent\":\"  requestSubmissionChanges(\\n    submissionId: string,\\n    reviewerUserId: string,\\n    note: string\\n  ): boolean {\\n    const raw = this.findSubmissionRawById(submissionId);\\n    if (!raw || raw.deleted_at || raw.review_status === \'reviewed\') {\\n      return false;\\n    }\\n    if (raw.assigned_reviewer_id && raw.assigned_reviewer_id !== reviewerUserId) {\\n      return false;\\n    }\\n    const res = this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET review_status = \'resubmit_requested\',\\n             assigned_reviewer_id = ?,\\n             change_request_note = ?\\n         WHERE id = ?`\\n      )\\n      .run(reviewerUserId, note.trim(), submissionId);\\n    return res.changes > 0;\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":2102, \"ReplacementContent\":\"  // ======================== REVIEWER QUEUE & EVALUATION ========================\\n\\n  private mapReviewerQueueRow(r: {\\n    submission_id: string;\\n    parent_user_id: string;\\n    activity_id: string;\\n    activity_version: number | null;\\n    activity_title: string;\\n    domain_name: string;\\n    age_group_slug: string;\\n    age_group_label: string;\\n    review_status: SubmissionReviewStatus;\\n    assigned_reviewer_id: string | null;\\n    assigned_reviewer_name: string | null;\\n    storage_key: string | null;\\n    deleted_at: string | null;\\n    duration_seconds: number;\\n    expires_at: string;\\n    created_at: string;\\n    sr_review_status: ReviewPublicationStatus | null;\\n    is_assessable: number | null;\\n    instruction_match_score_pct: number | null;\\n  }): ReviewerQueueItem {\\n    const isPublished = r.sr_review_status === \'published\';\\n    return {\\n      submissionId: r.submission_id,\\n      parentReference: this.formatParentReference(r.parent_user_id),\\n      activityId: r.activity_id,\\n      activityVersion: r.activity_version ?? 1,\\n      activityTitle: r.activity_title,\\n      domainName: r.domain_name,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      reviewStatus: r.review_status,\\n      priority: this.computeQueuePriority(r.review_status, r.created_at, r.expires_at),\\n      assignedReviewerId: r.assigned_reviewer_id,\\n      assignedReviewerName: r.assigned_reviewer_name,\\n      hasActiveVideo: Boolean(r.storage_key && !r.deleted_at),\\n      hasDraftReview: r.sr_review_status === \'draft\',\\n      isAssessable: isPublished ? (r.is_assessable ?? 1) === 1 : null,\\n      durationSeconds: r.duration_seconds,\\n      expiresAt: r.expires_at,\\n      createdAt: r.created_at,\\n      instructionMatchScorePct: isPublished ? r.instruction_match_score_pct : null,\\n    };\\n  }\\n\\n  getReviewerDashboardSummary(): ReviewerDashboardSummary {\\n    const counts = this.db\\n      .prepare(\\n        `SELECT\\n           SUM(CASE WHEN review_status = \'queued\' THEN 1 ELSE 0 END) as pending_count,\\n           SUM(CASE WHEN review_status = \'in_review\' THEN 1 ELSE 0 END) as in_review_count,\\n           SUM(CASE WHEN review_status = \'reviewed\' THEN 1 ELSE 0 END) as reviewed_count,\\n           SUM(CASE WHEN review_status = \'resubmit_requested\' THEN 1 ELSE 0 END) as changes_count\\n         FROM video_submissions\\n         WHERE review_status != \'deleted\'`\\n      )\\n      .get() as {\\n      pending_count: number | null;\\n      in_review_count: number | null;\\n      reviewed_count: number | null;\\n      changes_count: number | null;\\n    };\\n\\n    const recentRows = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.parent_user_id, vs.activity_id, vs.activity_version,\\n                a.title as activity_title, ld.name as domain_name,\\n                ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.duration_seconds, vs.expires_at, vs.created_at,\\n                sr.review_status as sr_review_status, sr.is_assessable, sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         WHERE vs.review_status != \'deleted\'\\n         ORDER BY vs.created_at DESC\\n         LIMIT 5`\\n      )\\n      .all() as Array<Parameters<LittleStepsRepository[\'mapReviewerQueueRow\']>[0]>;\\n\\n    return {\\n      totalPending: counts.pending_count ?? 0,\\n      underReview: counts.in_review_count ?? 0,\\n      completedReviews: counts.reviewed_count ?? 0,\\n      changesRequested: counts.changes_count ?? 0,\\n      recentSubmissions: recentRows.map((r) => this.mapReviewerQueueRow(r)),\\n    };\\n  }\\n\\n  listReviewerQueue(filters?: {\\n    status?: SubmissionReviewStatus | \'all\';\\n    ageGroupSlug?: string;\\n  }): ReviewerQueueItem[] {\\n    const conditions: string[] = [];\\n    const params: unknown[] = [];\\n\\n    if (filters?.status && filters.status !== \'all\') {\\n      conditions.push(\'vs.review_status = ?\');\\n      params.push(filters.status);\\n    } else {\\n      conditions.push(\\\"vs.review_status != \'deleted\'\\\");\\n    }\\n\\n    if (filters?.ageGroupSlug && filters.ageGroupSlug !== \'all\') {\\n      conditions.push(\'ag.slug = ?\');\\n      params.push(filters.ageGroupSlug);\\n    }\\n\\n    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\' AND \')}` : \'\';\\n    const rows = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.parent_user_id, vs.activity_id, vs.activity_version,\\n                a.title as activity_title, ld.name as domain_name,\\n                ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.duration_seconds, vs.expires_at, vs.created_at,\\n                sr.review_status as sr_review_status, sr.is_assessable, sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         ${whereClause}\\n         ORDER BY\\n           CASE vs.review_status\\n             WHEN \'queued\' THEN 1\\n             WHEN \'in_review\' THEN 2\\n             WHEN \'resubmit_requested\' THEN 3\\n             ELSE 4\\n           END ASC,\\n           vs.created_at DESC`\\n      )\\n      .all(...params) as Array<Parameters<LittleStepsRepository[\'mapReviewerQueueRow\']>[0]>;\\n\\n    // Note: Intentionally omits parent email, phone, and legal names (Reviewer Data Minimization)\\n    return rows.map((r) => this.mapReviewerQueueRow(r));\\n  }\\n\\n  claimSubmissionForReviewer(submissionId: string, reviewerId: string): boolean {\\n    const res = this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET assigned_reviewer_id = ?,\\n             review_status = CASE WHEN review_status = \'queued\' THEN \'in_review\' ELSE review_status END\\n         WHERE id = ?\\n           AND (assigned_reviewer_id IS NULL OR assigned_reviewer_id = ?)\\n           AND review_status IN (\'queued\', \'in_review\')`\\n      )\\n      .run(reviewerId, submissionId, reviewerId);\\n    if (res.changes > 0) {\\n      this.logMediaAudit(reviewerId, \'reviewer\', submissionId, \'review_open\');\\n    }\\n    return res.changes > 0;\\n  }\\n\\n  getReviewerSubmissionDetail(submissionId: string): ReviewerSubmissionDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.parent_user_id, vs.activity_id, vs.activity_version,\\n                a.title as activity_title, ld.name as domain_name,\\n                ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.storage_provider, vs.deleted_at, vs.deletion_reason,\\n                vs.duration_seconds, vs.caregiver_notes, vs.change_request_note,\\n                vs.expires_at, vs.created_at,\\n                sr.review_status as sr_review_status, sr.is_assessable, sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         WHERE vs.id = ?`\\n      )\\n      .get(submissionId) as\\n      | {\\n          submission_id: string;\\n          parent_user_id: string;\\n          activity_id: string;\\n          activity_version: number | null;\\n          activity_title: string;\\n          domain_name: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          review_status: SubmissionReviewStatus;\\n          assigned_reviewer_id: string | null;\\n          assigned_reviewer_name: string | null;\\n          storage_key: string | null;\\n          storage_provider: string | null;\\n          deleted_at: string | null;\\n          deletion_reason: string | null;\\n          duration_seconds: number;\\n          caregiver_notes: string | null;\\n          change_request_note: string | null;\\n          expires_at: string;\\n          created_at: string;\\n          sr_review_status: ReviewPublicationStatus | null;\\n          is_assessable: number | null;\\n          instruction_match_score_pct: number | null;\\n        }\\n      | undefined;\\n\\n    if (!row) return null;\\n    const activity = this.getActivityDetail(row.activity_id);\\n    if (!activity) return null;\\n\\n    const baseQueue = this.mapReviewerQueueRow(row);\\n    const storageMode: VideoStorageMode =\\n      row.storage_provider && row.storage_provider !== \'local\'\\n        ? \'production_object_storage\'\\n        : \'demo_local_vault\';\\n\\n    return {\\n      submission: {\\n        ...baseQueue,\\n        caregiverNotes: row.caregiver_notes,\\n        changeRequestNote: row.change_request_note,\\n        deletedAt: row.deleted_at,\\n        deletionReason: row.deletion_reason,\\n        storageMode,\\n        storageReference: row.storage_key ? row.storage_key.split(\'/\').pop() ?? null : null,\\n      },\\n      activity,\\n      review: this.getReviewDetailForSubmission(submissionId, true),\\n      history: this.listReviewHistory(submissionId),\\n    };\\n  }\\n\\n  submitRubricReview(params: {\\n    submissionId: string;\\n    reviewerUserId: string;\\n    mode: \'draft\' | \'publish\' | \'not_assessable\';\\n    strengthsNote?: string;\\n    coachingTip?: string;\\n    reviewerComments?: string | null;\\n    notAssessableReason?: string | null;\\n    criterionRatings: Array<{\\n      criterionId: string;\\n      achievedLevel: RubricAchievementLevel;\\n      explanation?: string | null;\\n    }>;\\n  }): SubmissionReviewDetail {\\n    const rawSub = this.findSubmissionRawById(params.submissionId);\\n    if (!rawSub) {\\n      throw new Error(\'Submission not found\');\\n    }\\n    if (\\n      rawSub.assigned_reviewer_id &&\\n      rawSub.assigned_reviewer_id !== params.reviewerUserId &&\\n      rawSub.review_status === \'in_review\'\\n    ) {\\n      throw new Error(\'This submission is actively assigned to another reviewer.\');\\n    }\\n    const activity = this.getActivityDetail(rawSub.activity_id);\\n    if (!activity) {\\n      throw new Error(\'Activity not found\');\\n    }\\n\\n    const ratingById = new Map(params.criterionRatings.map((r) => [r.criterionId, r]));\\n\\n    const computedScores = activity.rubricCriteria.map((criterion) => {\\n      const match = ratingById.get(criterion.id);\\n      if (!match && params.mode === \'publish\') {\\n        throw new Error(`Missing rubric rating for \\\"${criterion.label}\\\"`);\\n      }\\n      const level: RubricAchievementLevel =\\n        params.mode === \'not_assessable\'\\n          ? \'not_assessable\'\\n          : match?.achievedLevel ?? \'not_assessable\';\\n      const trimmedExplanation = match?.explanation?.trim() || null;\\n\\n      if (params.mode === \'publish\' && level === \'not_assessable\' && !trimmedExplanation) {\\n        throw new Error(\\n          `Please explain why \\\"${criterion.label}\\\" could not be assessed from the video.`\\n        );\\n      }\\n\\n      const mult = getRubricMultiplier(level);\\n      const earned = mult === null ? 0 : criterion.weightPoints * mult;\\n      return {\\n        criterionId: criterion.id,\\n        achievedLevel: level,\\n        earnedPoints: earned,\\n        maxPoints: criterion.weightPoints,\\n        explanation:\\n          trimmedExplanation ||\\n          (params.mode === \'not_assessable\' ? params.notAssessableReason?.trim() || null : null),\\n      };\\n    });\\n\\n    const calc = calculateInstructionMatchScore(\\n      computedScores.map((s) => ({\\n        weightPoints: s.maxPoints,\\n        achievedLevel: s.achievedLevel,\\n      }))\\n    );\\n\\n    const isAssessable = params.mode !== \'not_assessable\' && calc.isAssessable;\\n    const scorePct = isAssessable ? calc.scorePct : null;\\n\\n    let finalNotAssessableReason: string | null = null;\\n    if (!isAssessable) {\\n      const explicitReason = params.notAssessableReason?.trim() || \'\';\\n      const criterionReasons = computedScores\\n        .filter((s) => s.achievedLevel === \'not_assessable\' && s.explanation)\\n        .map((s) => s.explanation)\\n        .join(\' \302\267 \');\\n      finalNotAssessableReason =\\n        explicitReason ||\\n        criterionReasons ||\\n        \'Insufficient visual or audio evidence in the video to calculate a fair instruction-match score.\';\\n    }\\n\\n    const strengths =\\n      params.strengthsNote?.trim() ||\\n      (params.mode === \'not_assessable\'\\n        ? \'Thank you for sharing your practice clip with LittleSteps.\'\\n        : \'\');\\n    const coaching =\\n      params.coachingTip?.trim() ||\\n      (params.mode === \'not_assessable\'\\n        ? \'When convenient, share a clip where the setup and activity steps are clearly visible in good lighting.\'\\n        : \'\');\\n    const comments = params.reviewerComments?.trim() || null;\\n\\n    const nowIso = new Date().toISOString();\\n    const isDraft = params.mode === \'draft\';\\n\\n    const tx = this.db.transaction(() => {\\n      const existingRev = this.db\\n        .prepare(\'SELECT id, review_status, version FROM submission_reviews WHERE submission_id = ?\')\\n        .get(params.submissionId) as\\n        | { id: string; review_status: ReviewPublicationStatus; version: number }\\n        | undefined;\\n\\n      if (isDraft && existingRev?.review_status === \'published\') {\\n        throw new Error(\\n          \'This review is already published. Save your changes using Update Evaluation so revision history is preserved.\'\\n        );\\n      }\\n\\n      const wasAlreadyPublished = existingRev?.review_status === \'published\';\\n      const nextVersion = existingRev\\n        ? wasAlreadyPublished\\n          ? (existingRev.version ?? 1) + 1\\n          : existingRev.version ?? 1\\n        : 1;\\n      const reviewId = existingRev ? existingRev.id : `rev_${crypto.randomUUID().slice(0, 10)}`;\\n      const reviewStatus: ReviewPublicationStatus = isDraft ? \'draft\' : \'published\';\\n\\n      if (existingRev) {\\n        this.db\\n          .prepare(\\n            `UPDATE submission_reviews\\n             SET reviewer_user_id = ?,\\n                 review_status = ?,\\n                 version = ?,\\n                 is_assessable = ?,\\n                 not_assessable_reason = ?,\\n                 instruction_match_score_pct = ?,\\n                 strengths_note = ?,\\n                 coaching_tip = ?,\\n                 reviewer_comments = ?,\\n                 evaluation_scope_acknowledged_at = ?,\\n                 submitted_at = ?\\n             WHERE id = ?`\\n          )\\n          .run(\\n            params.reviewerUserId,\\n            reviewStatus,\\n            nextVersion,\\n            isAssessable ? 1 : 0,\\n            finalNotAssessableReason,\\n            scorePct,\\n            strengths,\\n            coaching,\\n            comments,\\n            nowIso,\\n            nowIso,\\n            reviewId\\n          );\\n        this.db.prepare(\'DELETE FROM review_rubric_scores WHERE review_id = ?\').run(reviewId);\\n      } else {\\n        this.db\\n          .prepare(\\n            `INSERT INTO submission_reviews (\\n               id, submission_id, reviewer_user_id, review_status, version,\\n               is_assessable, not_assessable_reason, instruction_match_score_pct,\\n               strengths_note, coaching_tip, reviewer_comments,\\n               evaluation_scope_acknowledged_at, submitted_at\\n             ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`\\n          )\\n          .run(\\n            reviewId,\\n            params.submissionId,\\n            params.reviewerUserId,\\n            reviewStatus,\\n            nextVersion,\\n            isAssessable ? 1 : 0,\\n            finalNotAssessableReason,\\n            scorePct,\\n            strengths,\\n            coaching,\\n            comments,\\n            nowIso,\\n            nowIso\\n          );\\n      }\\n\\n      const insertScore = this.db.prepare(\\n        `INSERT INTO review_rubric_scores (\\n           id, review_id, rubric_criterion_id, achieved_level, earned_points, max_points, explanation\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?)`\\n      );\\n      for (const s of computedScores) {\\n        insertScore.run(\\n          crypto.randomUUID(),\\n          reviewId,\\n          s.criterionId,\\n          s.achievedLevel,\\n          s.earnedPoints,\\n          s.maxPoints,\\n          s.explanation\\n        );\\n      }\\n\\n      if (isDraft) {\\n        this.db\\n          .prepare(\\n            `UPDATE video_submissions\\n             SET review_status = CASE WHEN review_status = \'queued\' THEN \'in_review\' ELSE review_status END,\\n                 assigned_reviewer_id = ?\\n             WHERE id = ?`\\n          )\\n          .run(params.reviewerUserId, params.submissionId);\\n      } else {\\n        this.db\\n          .prepare(\\n            `UPDATE video_submissions\\n             SET review_status = \'reviewed\',\\n                 assigned_reviewer_id = ?,\\n                 change_request_note = NULL\\n             WHERE id = ?`\\n          )\\n          .run(params.reviewerUserId, params.submissionId);\\n\\n        this.db\\n          .prepare(\\\"UPDATE activity_completions SET status = \'reviewed\' WHERE id = ?\\\")\\n          .run(rawSub.completion_id);\\n      }\\n\\n      const auditAction: ReviewAuditAction = isDraft\\n        ? \'draft_saved\'\\n        : !isAssessable\\n          ? \'marked_not_assessable\'\\n          : wasAlreadyPublished\\n            ? \'updated\'\\n            : \'published\';\\n\\n      this.appendReviewAuditHistory({\\n        submissionId: params.submissionId,\\n        reviewId,\\n        actorUserId: params.reviewerUserId,\\n        action: auditAction,\\n        version: nextVersion,\\n        isAssessable,\\n        instructionMatchScorePct: scorePct,\\n        summaryNote: !isAssessable\\n          ? finalNotAssessableReason\\n          : comments || strengths || \'Draft saved\',\\n        snapshot: {\\n          mode: params.mode,\\n          reviewStatus,\\n          version: nextVersion,\\n          isAssessable,\\n          instructionMatchScorePct: scorePct,\\n          notAssessableReason: finalNotAssessableReason,\\n          strengthsNote: strengths,\\n          coachingTip: coaching,\\n          reviewerComments: comments,\\n          criterionRatings: computedScores,\\n        },\\n      });\\n    });\\n    tx();\\n\\n    return this.getReviewDetailForSubmission(params.submissionId, true)!;\\n  }\", \"StartLine\":1824, \"TargetContent\":\"  // ======================== REVIEWER QUEUE & EVALUATION ========================\\n\\n  listReviewerQueue(filters?: {\\n    status?: SubmissionReviewStatus | \'all\';\\n    ageGroupSlug?: string;\\n  }): ReviewerQueueItem[] {\\n    const conditions: string[] = [];\\n    const params: unknown[] = [];\\n\\n    if (filters?.status && filters.status !== \'all\') {\\n      conditions.push(\'vs.review_status = ?\');\\n      params.push(filters.status);\\n    } else {\\n      conditions.push(\\\"vs.review_status != \'deleted\'\\\");\\n    }\\n\\n    if (filters?.ageGroupSlug && filters.ageGroupSlug !== \'all\') {\\n      conditions.push(\'ag.slug = ?\');\\n      params.push(filters.ageGroupSlug);\\n    }\\n\\n    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\' AND \')}` : \'\';\\n    const rows = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.activity_id, a.title as activity_title,\\n                ld.name as domain_name, ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.duration_seconds, vs.expires_at, vs.created_at,\\n                sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         ${whereClause}\\n         ORDER BY\\n           CASE vs.review_status WHEN \'queued\' THEN 1 WHEN \'in_review\' THEN 2 ELSE 3 END ASC,\\n           vs.created_at ASC`\\n      )\\n      .all(...params) as Array<{\\n      submission_id: string;\\n      activity_id: string;\\n      activity_title: string;\\n      domain_name: string;\\n      age_group_slug: string;\\n      age_group_label: string;\\n      review_status: SubmissionReviewStatus;\\n      assigned_reviewer_id: string | null;\\n      assigned_reviewer_name: string | null;\\n      storage_key: string | null;\\n      deleted_at: string | null;\\n      duration_seconds: number;\\n      expires_at: string;\\n      created_at: string;\\n      instruction_match_score_pct: number | null;\\n    }>;\\n\\n    // Note: Intentionally omits parent email, phone, and legal names (Reviewer Data Minimization)\\n    return rows.map((r) => ({\\n      submissionId: r.submission_id,\\n      activityId: r.activity_id,\\n      activityTitle: r.activity_title,\\n      domainName: r.domain_name,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      reviewStatus: r.review_status,\\n      assignedReviewerId: r.assigned_reviewer_id,\\n      assignedReviewerName: r.assigned_reviewer_name,\\n      hasActiveVideo: Boolean(r.storage_key && !r.deleted_at),\\n      durationSeconds: r.duration_seconds,\\n      expiresAt: r.expires_at,\\n      createdAt: r.created_at,\\n      instructionMatchScorePct: r.instruction_match_score_pct,\\n    }));\\n  }\\n\\n  claimSubmissionForReviewer(submissionId: string, reviewerId: string): boolean {\\n    const res = this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET assigned_reviewer_id = ?,\\n             review_status = CASE WHEN review_status = \'queued\' THEN \'in_review\' ELSE review_status END\\n         WHERE id = ?\\n           AND (assigned_reviewer_id IS NULL OR assigned_reviewer_id = ?)\\n           AND review_status IN (\'queued\', \'in_review\')`\\n      )\\n      .run(reviewerId, submissionId, reviewerId);\\n    if (res.changes > 0) {\\n      this.logMediaAudit(reviewerId, \'reviewer\', submissionId, \'review_open\');\\n    }\\n    return res.changes > 0;\\n  }\\n\\n  getReviewerSubmissionDetail(submissionId: string): ReviewerSubmissionDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.activity_id, a.title as activity_title,\\n                ld.name as domain_name, ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.deletion_reason, vs.duration_seconds,\\n                vs.caregiver_notes, vs.expires_at, vs.created_at,\\n                sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         WHERE vs.id = ?`\\n      )\\n      .get(submissionId) as\\n      | {\\n          submission_id: string;\\n          activity_id: string;\\n          activity_title: string;\\n          domain_name: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          review_status: SubmissionReviewStatus;\\n          assigned_reviewer_id: string | null;\\n          assigned_reviewer_name: string | null;\\n          storage_key: string | null;\\n          deleted_at: string | null;\\n          deletion_reason: string | null;\\n          duration_seconds: number;\\n          caregiver_notes: string | null;\\n          expires_at: string;\\n          created_at: string;\\n          instruction_match_score_pct: number | null;\\n        }\\n      | undefined;\\n\\n    if (!row) return null;\\n    const activity = this.getActivityDetail(row.activity_id);\\n    if (!activity) return null;\\n\\n    return {\\n      submission: {\\n        submissionId: row.submission_id,\\n        activityId: row.activity_id,\\n        activityTitle: row.activity_title,\\n        domainName: row.domain_name,\\n        ageGroupSlug: row.age_group_slug,\\n        ageGroupLabel: row.age_group_label,\\n        reviewStatus: row.review_status,\\n        assignedReviewerId: row.assigned_reviewer_id,\\n        assignedReviewerName: row.assigned_reviewer_name,\\n        hasActiveVideo: Boolean(row.storage_key && !row.deleted_at),\\n        durationSeconds: row.duration_seconds,\\n        expiresAt: row.expires_at,\\n        createdAt: row.created_at,\\n        instructionMatchScorePct: row.instruction_match_score_pct,\\n        caregiverNotes: row.caregiver_notes,\\n        deletedAt: row.deleted_at,\\n        deletionReason: row.deletion_reason,\\n      },\\n      activity,\\n      review: this.getReviewDetailForSubmission(submissionId),\\n    };\\n  }\\n\\n  submitRubricReview(params: {\\n    submissionId: string;\\n    reviewerUserId: string;\\n    strengthsNote: string;\\n    coachingTip: string;\\n    criterionRatings: Array<{ criterionId: string; achievedLevel: RubricAchievementLevel }>;\\n  }): SubmissionReviewDetail {\\n    const rawSub = this.findSubmissionRawById(params.submissionId);\\n    if (!rawSub) {\\n      throw new Error(\'Submission not found\');\\n    }\\n    const activity = this.getActivityDetail(rawSub.activity_id);\\n    if (!activity) {\\n      throw new Error(\'Activity not found\');\\n    }\\n\\n    const criteriaById = new Map(activity.rubricCriteria.map((c) => [c.id, c]));\\n    let earnedTotal = 0;\\n    let maxTotal = 0;\\n\\n    const computedScores = activity.rubricCriteria.map((criterion) => {\\n      const match = params.criterionRatings.find((r) => r.criterionId === criterion.id);\\n      if (!match || !criteriaById.has(criterion.id)) {\\n        throw new Error(`Missing rubric rating for \\\"${criterion.label}\\\"`);\\n      }\\n      const earned = criterion.weightPoints * getRubricMultiplier(match.achievedLevel);\\n      earnedTotal += earned;\\n      maxTotal += criterion.weightPoints;\\n      return {\\n        criterionId: criterion.id,\\n        achievedLevel: match.achievedLevel,\\n        earnedPoints: earned,\\n        maxPoints: criterion.weightPoints,\\n      };\\n    });\\n\\n    const scorePct = maxTotal > 0 ? Math.round((earnedTotal / maxTotal) * 100) : 0;\\n    const nowIso = new Date().toISOString();\\n\\n    const tx = this.db.transaction(() => {\\n      const existingRev = this.db\\n        .prepare(\'SELECT id FROM submission_reviews WHERE submission_id = ?\')\\n        .get(params.submissionId) as { id: string } | undefined;\\n\\n      const reviewId = existingRev ? existingRev.id : `rev_${crypto.randomUUID().slice(0, 10)}`;\\n\\n      if (existingRev) {\\n        this.db\\n          .prepare(\\n            `UPDATE submission_reviews\\n             SET reviewer_user_id = ?, instruction_match_score_pct = ?,\\n                 strengths_note = ?, coaching_tip = ?,\\n                 evaluation_scope_acknowledged_at = ?, submitted_at = ?\\n             WHERE id = ?`\\n          )\\n          .run(\\n            params.reviewerUserId,\\n            scorePct,\\n            params.strengthsNote.trim(),\\n            params.coachingTip.trim(),\\n            nowIso,\\n            nowIso,\\n            reviewId\\n          );\\n        this.db.prepare(\'DELETE FROM review_rubric_scores WHERE review_id = ?\').run(reviewId);\\n      } else {\\n        this.db\\n          .prepare(\\n            `INSERT INTO submission_reviews (\\n               id, submission_id, reviewer_user_id, instruction_match_score_pct,\\n               strengths_note, coaching_tip, evaluation_scope_acknowledged_at, submitted_at\\n             ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`\\n          )\\n          .run(\\n            reviewId,\\n            params.submissionId,\\n            params.reviewerUserId,\\n            scorePct,\\n            params.strengthsNote.trim(),\\n            params.coachingTip.trim(),\\n            nowIso,\\n            nowIso\\n          );\\n      }\\n\\n      const insertScore = this.db.prepare(\\n        `INSERT INTO review_rubric_scores (id, review_id, rubric_criterion_id, achieved_level, earned_points, max_points)\\n         VALUES (?, ?, ?, ?, ?, ?)`\\n      );\\n      for (const s of computedScores) {\\n        insertScore.run(\\n          crypto.randomUUID(),\\n          reviewId,\\n          s.criterionId,\\n          s.achievedLevel,\\n          s.earnedPoints,\\n          s.maxPoints\\n        );\\n      }\\n\\n      this.db\\n        .prepare(\\n          `UPDATE video_submissions\\n           SET review_status = \'reviewed\', assigned_reviewer_id = ?\\n           WHERE id = ?`\\n        )\\n        .run(params.reviewerUserId, params.submissionId);\\n\\n      this.db\\n        .prepare(\\\"UPDATE activity_completions SET status = \'reviewed\' WHERE id = ?\\\")\\n        .run(rawSub.completion_id);\\n    });\\n    tx();\\n\\n    return this.getReviewDetailForSubmission(params.submissionId)!;\\n  }\"}], \"TargetFile\":\"/server/repositories/index.ts\", \"toolAction\":\"Updating repository for Step 8 reviewer workflows\", \"toolSummary\":\"Update server repository\"}"
      thinking_signature: "\022\312J\n\307J\001i\024}\023>\301M8wxm3\322\212\314.\204\204\021\005vxnS\257\022\355\016\\[Ld\'\367qQ}\316U+\302\341l\001\325\343U\313\277\303\234\312%\b\351\253\0273\376`\324)T\232:\300\006G6\324\v\312\370\2558\037\201\214o\315\343z/-\272\230\265\207Ff.\022{\265\310\020\232\260\332\335\276\2428\230\215\3447\264Q6\324\215\200\367\307mdS\243\346\374\022\001\233\300_\bz\002f3z\204u?L\220<JH\362\237\036\335\374\376p\a\020\356\353\340\313A\201\237{\210\357\241\350\350\224B\032\241+\342_\204\303g\026nM\205\3533\236\374\236\274\251\305d\342\3031+w\315\266\3473l\341p\320Q\375 \231\025\256|\202\312\254\246fe\344*\256\267\342\a^^:\020\023\364\b\331\0333,\2031(\263\022\244\023s\\\202\254\361dr\374\233s\345\222\327\314b\372\336\034\233\026\343z\331bT\272)1]\271\271V\231\022]\257\232\352\370\036f\005\022\302vN\253\311-\204\301o\303\301@\240{\274\335\241\276#\227\250\225\2657p\261\335\275*\211B#\231M\n\236\312\264\262?/\204\330\265f\217S\024s\301\374u\253m\334<j\373j}\252\002\340|\177\003\037\277\327+\243w\326\332\353\3603;VR\017\026iu\333\311}Ykeg\3779\375/r\233Nx\360z\v\352h\273\215LH\247\241\344@!\343.\355!P\204\215\351\302\034z\322X\202\357q\223\177\277\236\316\301Y\251\337\267\310\332\220@\203\000\330\370\fl*\2260\340R+\377\266\327$}*O\332\203F\354=\351\330\214E\t\227\204Zb\nNqa\203$\310\223aF}S\223\202)\376\333\201\005y\025c\371\347;?wi\t0\036\302\332W\205\032\n\204\242\346\312\215=c{>>K/\024\262\364\277\300\355aX\273\033s\220d utu\372\354J3l8\265\340x\254\246\257\327~\355\245\344\314\207Lx\343*\314\036\352\211Ni\221\323y.\312\273\021IC\200\373\271\273\364\235\257#\220\342ba\034z5\233\376\313W5\024\022\027Z\265~\2553\345\220#\274\360\235\315\373\252\251\247\253\320>\336$\345\341x\0024(\242\027\354\235\377\035\230\354r\373\215\242`\354\226\2678S%-\033\a5\310\221+d\342\236\346#\341*\237\3619\316\277(\256\037\005\000\v\021\2140\002\357\3231\312\aL\265h\023\304q\341D\345\341\002\255\326\022\a\256\376j`\366r76\344\300\215m\344\030\300\310\264t\326@R