        use_fast_apply: true
        replacement_chunks {
          target_content: "import { ParentActivityStudio } from \'./parent/ParentActivityStudio\';\nimport {\n  ActivitiesLibrarySection,\n  NotificationsSection,\n  ParentingGuidesSection,\n  ProfileSection,\n  ProgressAndFeedbackSection,\n  SettingsSection,\n} from \'./parent/ParentSecondaryViews\';"
          replacement_content: "import {\n  formatPrepLevel,\n  getJourneyStatusMeta,\n  MyPlanSection,\n} from \'./parent/MyPlanSection\';\nimport { ParentActivityStudio } from \'./parent/ParentActivityStudio\';\nimport {\n  ActivitiesLibrarySection,\n  NotificationsSection,\n  ParentingGuidesSection,\n  ProfileSection,\n  ProgressAndFeedbackSection,\n  SettingsSection,\n} from \'./parent/ParentSecondaryViews\';"
          start_line: 53
          end_line: 62
        }
        replacement_chunks {
          target_content: "  // Set of completed activity IDs from today\'s items + submissions for accurate status tags\n  const completedActivityIds = useMemo(() => {\n    const set = new Set<string>();\n    journey?.items.forEach((item) => {\n      if (\n        item.completion?.status === \'completed\' ||\n        item.completion?.status === \'submitted_for_review\' ||\n        item.completion?.status === \'reviewed\'\n      ) {\n        set.add(item.activity.id);\n      }\n    });\n    journey?.recentSubmissions.forEach((sub) => set.add(sub.activityId));\n    return set;\n  }, [journey]);"
          replacement_content: "  // Set of completed activity IDs from today\'s items, completed history, and submissions\n  const completedActivityIds = useMemo(() => {\n    const set = new Set<string>();\n    journey?.items.forEach((item) => {\n      if (\n        item.displayStatus === \'completed\' ||\n        item.displayStatus === \'submitted_for_review\' ||\n        item.displayStatus === \'reviewed\'\n      ) {\n        set.add(item.activity.id);\n      }\n    });\n    journey?.completedHistory.forEach((h) => set.add(h.activityId));\n    journey?.recentSubmissions.forEach((sub) => set.add(sub.activityId));\n    return set;\n  }, [journey]);"
          start_line: 185
          end_line: 200
        }
        replacement_chunks {
          target_content: "  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\n    const isReviewed = Boolean(item.latestSubmission?.review);\n    const isCompleted =\n      item.completion?.status === \'completed\' ||\n      item.completion?.status === \'submitted_for_review\' ||\n      item.completion?.status === \'reviewed\';\n    const isStarted = item.completion?.status === \'started\';\n\n    const statusText = isReviewed\n      ? `Reviewed \302\267 ${item.latestSubmission!.review!.instructionMatchScorePct}%`\n      : item.latestSubmission?.reviewStatus === \'queued\' ||\n          item.latestSubmission?.reviewStatus === \'in_review\'\n        ? \'Clip awaiting feedback\'\n        : isCompleted\n          ? \'Completed\'\n          : isStarted\n            ? \'In progress\'\n            : \'Ready to start\';\n\n    const statusTone = isReviewed || isCompleted ? \'sage\' : isStarted ? \'peach\' : \'neutral\';\n    const actionLabel = isCompleted\n      ? \'Review Activity\'\n      : isStarted\n        ? \'Continue Activity\'\n        : \'Start Activity\';\n\n    return (\n      <ActivityCard\n        key={item.planItemId}\n        title={item.activity.title}\n        summary={item.activity.summary}\n        domainName={item.activity.domainName}\n        ageGroupLabel={item.activity.ageGroupLabel}\n        durationMinutes={item.activity.durationMinutes}\n        materials={item.activity.materials}\n        posterUrl={item.activity.instructionalPosterUrl}\n        statusText={statusText}\n        statusTone={statusTone}\n        completed={isCompleted || isReviewed}\n        actionLabel={actionLabel}\n        onAction={() => void openActivityInStudio(item.activity)}\n      />\n    );\n  };"
          replacement_content: "  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\n    const meta = getJourneyStatusMeta(item);\n\n    return (\n      <ActivityCard\n        key={item.planItemId}\n        title={item.activity.title}\n        summary={item.activity.summary}\n        domainName={item.activity.domainName}\n        ageGroupLabel={item.activity.ageGroupLabel}\n        durationMinutes={item.activity.durationMinutes}\n        prepLevelLabel={formatPrepLevel(item.activity.prepLevel)}\n        materials={item.activity.materials}\n        posterUrl={item.activity.instructionalPosterUrl}\n        statusText={meta.statusText}\n        statusTone={meta.statusTone}\n        statusState={meta.statusState}\n        completed={\n          meta.statusState === \'completed\' ||\n          meta.statusState === \'submitted_for_review\' ||\n          meta.statusState === \'reviewed\'\n        }\n        actionLabel={meta.actionLabel}\n        onAction={() => void openActivityInStudio(item.activity)}\n      />\n    );\n  };"
          start_line: 295
          end_line: 339
        }
        replacement_chunks {
          target_content: "          {/* =============================================================== */}\n          {/* PRIMARY TAB 2: MY PLAN (DAY-BY-DAY STRUCTURED JOURNEY)          */}\n          {/* =============================================================== */}\n          {!studioActivity && !loadingStudioActivity && journey && section === \'my-plan\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex flex-wrap items-end justify-between gap-4\">\n                <div className=\"space-y-1\">\n                  <Badge tone=\"sage\">{journey.child.ageGroupLabel} Plan</Badge>\n                  <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\">\n                    {journey.child.displayName}\342\200\231s Daily Plan\n                  </h2>\n                  <p className=\"text-sm text-muted max-w-2xl\">\n                    Follow one calm day at a time. Repeating familiar activities builds confidence\n                    for your baby.\n                  </p>\n                </div>\n              </div>\n\n              {/* Day Sequence Switcher */}\n              {journey.availableDays.length > 0 && (\n                <div className=\"flex flex-wrap items-center gap-2\">\n                  {journey.availableDays.map((d) => {\n                    const active = d.dayNumber === selectedDay;\n                    return (\n                      <button\n                        key={d.dayNumber}\n                        type=\"button\"\n                        onClick={() => setSelectedDay(d.dayNumber)}\n                        aria-pressed={active}\n                        className={`min-h-[44px] px-4 py-2 rounded-xl border text-sm font-medium transition-colors cursor-pointer ${\n                          active\n                            ? \'bg-sage text-white border-sage\'\n                            : \'bg-surface border-border text-charcoal hover:bg-cream\'\n                        }`}\n                      >\n                        Day {d.dayNumber}\n                      </button>\n                    );\n                  })}\n                </div>\n              )}\n\n              <Card tone=\"cream\" className=\"space-y-2\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                  <h3 className=\"font-display text-lg font-semibold text-charcoal\">\n                    {journey.selectedDay.title}\n                  </h3>\n                  <Badge\n                    tone={\n                      journey.todaySummary.completedTodayCount === journey.todaySummary.totalTodayCount &&\n                      journey.todaySummary.totalTodayCount > 0\n                        ? \'sage\'\n                        : \'neutral\'\n                    }\n                    icon={<CheckCircle2 className=\"w-3.5 h-3.5\" />}\n                  >\n                    {journey.todaySummary.completedTodayCount}/{journey.todaySummary.totalTodayCount} completed\n                  </Badge>\n                </div>\n                <p className=\"text-sm text-muted\">{journey.selectedDay.focusNote}</p>\n              </Card>\n\n              {journey.items.length === 0 ? (\n                <EmptyState\n                  title=\"No activities in this day\342\200\231s plan yet\"\n                  description=\"Explore the Activities Library to choose any age-appropriate activity.\"\n                  actionLabel=\"Open Activities Library\"\n                  onAction={() => handleSelectSection(\'activities\')}\n                />\n              ) : (\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                  {journey.items.map(renderActivityCardForJourneyItem)}\n                </div>\n              )}\n            </div>\n          )}"
          replacement_content: "          {/* =============================================================== */}\n          {/* PRIMARY TAB 2: MY PLAN (STRUCTURED DAILY LEARNING JOURNEY)      */}\n          {/* =============================================================== */}\n          {!studioActivity && !loadingStudioActivity && journey && section === \'my-plan\' && (\n            <MyPlanSection\n              journey={journey}\n              selectedDay={selectedDay}\n              locale={locale}\n              onSelectDay={(dayNumber) => setSelectedDay(dayNumber)}\n              onOpenActivity={(activityOrId) => void openActivityInStudio(activityOrId)}\n              onOpenLibrary={() => handleSelectSection(\'activities\')}\n            />\n          )}"
          start_line: 1145
