    tool_calls {
      id: "call_1211958191017683676"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useId } from \'react\';\\nimport { Calendar } from \'lucide-react\';\\nimport {\\n  calculateAgeInMonths,\\n  CANONICAL_AGE_GROUPS,\\n  resolveAgeGroupSlug,\\n} from \'../shared/domain\';\\n\\nexport interface DatePickerProps\\n  extends Omit<React.InputHTMLAttributes<HTMLInputElement>, \'type\'> {\\n  label: string;\\n  helperText?: string;\\n  error?: string;\\n  showBabyAgePreview?: boolean;\\n}\\n\\nexport const DatePicker = React.forwardRef<HTMLInputElement, DatePickerProps>(function DatePicker(\\n  {\\n    label,\\n    helperText,\\n    error,\\n    showBabyAgePreview = false,\\n    value,\\n    id,\\n    required,\\n    disabled,\\n    className = \'\',\\n    ...rest\\n  },\\n  ref\\n) {\\n  const autoId = useId();\\n  const inputId = id ?? autoId;\\n  const helperId = `${inputId}-helper`;\\n  const errorId = `${inputId}-error`;\\n\\n  let agePreviewText: string | null = null;\\n  if (showBabyAgePreview && typeof value === \'string\' && /^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) {\\n    const months = calculateAgeInMonths(value);\\n    const slug = resolveAgeGroupSlug(months);\\n    const band = CANONICAL_AGE_GROUPS.find((g) => g.slug === slug)?.label ?? \'0\342\200\2233 months\';\\n    agePreviewText = `${months} months \302\267 Matched to ${band} stage`;\\n  }\\n\\n  return (\\n    <div className=\\\"space-y-1.5 w-full\\\">\\n      <label htmlFor={inputId} className=\\\"block text-sm font-medium text-charcoal\\\">\\n        {label}\\n        {required && (\\n          <span className=\\\"text-danger ml-0.5\\\" aria-hidden=\\\"true\\\">\\n            *\\n          </span>\\n        )}\\n      </label>\\n\\n      <div className=\\\"relative\\\">\\n        <Calendar\\n          className=\\\"pointer-events-none w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2\\\"\\n          aria-hidden=\\\"true\\\"\\n        />\\n        <input\\n          ref={ref}\\n          id={inputId}\\n          type=\\\"date\\\"\\n          value={value}\\n          required={required}\\n          disabled={disabled}\\n          aria-invalid={Boolean(error) || undefined}\\n          aria-describedby={error ? errorId : helperText ? helperId : undefined}\\n          className={`w-full min-h-[44px] rounded-lg border bg-surface pl-10 pr-3.5 py-2.5 text-sm text-charcoal font-mono tabular-nums transition-colors disabled:bg-cream disabled:text-muted disabled:cursor-not-allowed ${\\n            error\\n              ? \'border-danger focus:border-danger\'\\n              : \'border-border-strong hover:border-sage/70 focus:border-sage\'\\n          } ${className}`}\\n          {...rest}\\n        />\\n      </div>\\n\\n      {agePreviewText && !error && (\\n        <p className=\\\"text-xs font-mono tabular-nums text-sage\\\">{agePreviewText}</p>\\n      )}\\n      {error ? (\\n        <p id={errorId} role=\\\"alert\\\" className=\\\"text-xs text-danger\\\">\\n          {error}\\n        </p>\\n      ) : helperText ? (\\n        <p id={helperId} className=\\\"text-xs text-muted\\\">\\n          {helperText}\\n        </p>\\n      ) : null}\\n    </div>\\n  );\\n});\\n\", \"Description\":\"Create accessible LittleSteps DatePicker component with optional automatic 0-24 month baby age-band preview.\", \"Overwrite\":true, \"TargetFile\":\"/src/design-system/DatePicker.tsx\", \"toolAction\":\"Creating DatePicker component\", \"toolSummary\":\"Create DatePicker component\"}"
      original_name: "write_to_file"
