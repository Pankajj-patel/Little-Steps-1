  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useCallback, useEffect, useState } from \'react\';\nimport {\n  ArrowLeft,\n  Check,\n  CheckCircle2,\n  Clock,\n  Info,\n  Plus,\n  ShieldAlert,\n  Trash2,\n  Video,\n} from \'lucide-react\';\nimport { EditorialImage } from \'../components/EditorialImage\';\nimport { InstructionalGuidePlayer } from \'../components/InstructionalGuidePlayer\';\nimport { SecureVideoPlayer } from \'../components/SecureVideoPlayer\';\nimport { VideoCaptureUploader } from \'../components/VideoCaptureUploader\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { api } from \'../lib/api\';\nimport {\n  calculateAgeInMonths,\n  CANONICAL_AGE_GROUPS,\n  formatDaysUntilExpiry,\n  resolveAgeGroupSlug,\n} from \'../shared/domain\';\nimport { formatDateReadable } from \'../shared/i18n\';\nimport type {\n  ChildProfile,\n  JourneyActivityItem,\n  TodayJourneyResponse,\n  VideoSubmissionSummary,\n} from \'../shared/types\';\n\nexport type ParentTab = \'today\' | \'feedback\' | \'progress\';\n\ninterface ParentJourneyViewProps {\n  activeTab: ParentTab;\n  onChangeTab: (tab: ParentTab) => void;\n}\n\nexport function ParentJourneyView({ activeTab, onChangeTab }: ParentJourneyViewProps) {\n  const { user, locale, t } = useAuth();\n  const [children, setChildren] = useState<ChildProfile[]>([]);\n  const [selectedChildId, setSelectedChildId] = useState<string | null>(null);\n  const [selectedDay, setSelectedDay] = useState<number>(1);\n  const [journey, setJourney] = useState<TodayJourneyResponse | null>(null);\n  const [loadingChildren, setLoadingChildren] = useState(true);\n  const [loadingJourney, setLoadingJourney] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Add child inline panel\n  const [showAddChild, setShowAddChild] = useState(false);\n  const [newChildName, setNewChildName] = useState(\'\');\n  const [newChildDob, setNewChildDob] = useState(() => {\n    const d = new Date();\n    d.setMonth(d.getMonth() - 5);\n    return d.toISOString().slice(0, 10);\n  });\n  const [savingChild, setSavingChild] = useState(false);\n\n  // Activity Detail Studio state\n  const [activeActivityId, setActiveActivityId] = useState<string | null>(null);\n  const [checkedSteps, setCheckedSteps] = useState<Record<string, boolean>>({});\n  const [reflectionNote, setReflectionNote] = useState(\'\');\n  const [savingCompletion, setSavingCompletion] = useState(false);\n  const [showUploader, setShowUploader] = useState(false);\n  const [statusMessage, setStatusMessage] = useState<string | null>(null);\n\n  // Feedback deletion confirmation state (no window.confirm)\n  const [confirmDeleteSubId, setConfirmDeleteSubId] = useState<string | null>(null);\n  const [deletingVideoId, setDeletingVideoId] = useState<string | null>(null);\n\n  const loadChildren = useCallback(async () => {\n    setLoadingChildren(true);\n    try {\n      const { children: list } = await api.listChildren();\n      setChildren(list);\n      if (list.length > 0) {\n        setSelectedChildId((prev) =>\n          prev && list.some((c) => c.id === prev) ? prev : list[0].id\n        );\n      } else {\n        setSelectedChildId(null);\n      }\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to load family profiles.\');\n    } finally {\n      setLoadingChildren(false);\n    }\n  }, []);\n\n  const loadJourney = useCallback(async (childId: string, day?: number) => {\n    setLoadingJourney(true);\n    setError(null);\n    try {\n      const data = await api.getTodayJourney(childId, day);\n      setJourney(data);\n      setSelectedDay(data.selectedDay.dayNumber);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to load daily journey.\');\n    } finally {\n      setLoadingJourney(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    void loadChildren();\n  }, [loadChildren]);\n\n  useEffect(() => {\n    if (selectedChildId) {\n      void loadJourney(selectedChildId, selectedDay);\n    }\n  }, [selectedChildId, selectedDay, loadJourney]);\n\n  const handleCreateChild = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setSavingChild(true);\n    setError(null);\n    try {\n      const { child } = await api.createChild(newChildName, newChildDob);\n      setChildren((prev) => [...prev, child]);\n      setSelectedChildId(child.id);\n      setSelectedDay(1);\n      setNewChildName(\'\');\n      setShowAddChild(false);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Could not save child profile.\');\n    } finally {\n      setSavingChild(false);\n    }\n  };\n\n  const activeItem: JourneyActivityItem | null =\n    journey?.items.find((i) => i.activity.id === activeActivityId) ?? null;\n\n  const openActivityStudio = (item: JourneyActivityItem) => {\n    setActiveActivityId(item.activity.id);\n    setReflectionNote(item.completion?.caregiverNotes ?? \'\');\n    setCheckedSteps({});\n    setShowUploader(false);\n    setStatusMessage(null);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  const handleMarkCompleted = async () => {\n    if (!journey || !activeItem) return;\n    setSavingCompletion(true);\n    setStatusMessage(null);\n    try {\n      await api.saveCompletion({\n        childId: journey.child.id,\n        activityId: activeItem.activity.id,\n        status: \'completed\',\n        caregiverNotes: reflectionNote,\n      });\n      setStatusMessage(\'Saved to today\342\200\231s journal.\');\n      await loadJourney(journey.child.id, selectedDay);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to save activity progress.\');\n    } finally {\n      setSavingCompletion(false);\n    }\n  };\n\n  const handleVideoSubmitted = async (_submission: VideoSubmissionSummary) => {\n    setShowUploader(false);\n    setStatusMessage(\'Practice clip uploaded securely to your private vault and queued for review.\');\n    if (journey) {\n      await loadJourney(journey.child.id, selectedDay);\n    }\n  };\n\n  const handleDeleteVideo = async (submissionId: string) => {\n    setDeletingVideoId(submissionId);\n    setError(null);\n    try {\n      await api.deleteSubmissionVideo(submissionId);\n      setConfirmDeleteSubId(null);\n      if (journey) {\n        await loadJourney(journey.child.id, selectedDay);\n      }\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to delete video.\');\n    } finally {\n      setDeletingVideoId(null);\n    }\n  };\n\n  const previewAgeMonths = calculateAgeInMonths(newChildDob);\n  const previewBandLabel =\n    CANONICAL_AGE_GROUPS.find((g) => g.slug === resolveAgeGroupSlug(previewAgeMonths))?.label ??\n    \'0\342\200\2233 months\';\n\n  if (loadingChildren) {\n    return (\n      <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-4\">\n        <div className=\"h-8 w-56 bg-oat rounded animate-pulse\" />\n        <div className=\"h-44 w-full bg-oat rounded-xl animate-pulse\" />\n      </div>\n    );\n  }\n\n  // Gentle Onboarding if parent has not added a baby yet\n  if (children.length === 0 || showAddChild) {\n    return (\n      <div className=\"max-w-xl mx-auto px-4 sm:px-6 py-12\">\n        <div className=\"rounded-xl border border-stone bg-linen p-6 sm:p-8 space-y-6\">\n          <div className=\"space-y-2\">\n            <h1 className=\"font-serif text-3xl font-medium text-ink\">\n              {children.length === 0 ? \'Welcome to LittleSteps\' : \'Add Another Child\'}\n            </h1>\n            <p className=\"text-sm text-olive leading-relaxed\">\n              Share your baby\342\200\231s name and date of birth so we can gently match daily activities to their exact 3-month stage.\n            </p>\n          </div>\n\n          <form onSubmit={handleCreateChild} className=\"space-y-4\">\n            <div>\n              <label htmlFor=\"baby-name\" className=\"block text-sm font-medium text-ink mb-1.5\">\n                Baby\342\200\231s name or nickname\n              </label>\n              <input\n                id=\"baby-name\"\n                type=\"text\"\n                required\n                value={newChildName}\n                onChange={(e) => setNewChildName(e.target.value)}\n                placeholder=\"e.g., Aarav or Diya\"\n                className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"baby-dob\" className=\"block text-sm font-medium text-ink mb-1.5\">\n                Date of birth\n              </label>\n              <input\n                id=\"baby-dob\"\n                type=\"date\"\n                required\n                max={new Date().toISOString().slice(0, 10)}\n                value={newChildDob}\n                onChange={(e) => setNewChildDob(e.target.value)}\n                className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\"\n              />\n              <p className=\"text-xs text-olive mt-2 font-mono tabular-nums\">\n                Matched stage: {previewAgeMonths} months \302\267 {previewBandLabel} age group\n              </p>\n            </div>\n\n            {error && (\n              <p role=\"alert\" className=\"text-sm text-crimson bg-crimson-soft px-3.5 py-2 rounded-lg\">\n                {error}\n              </p>\n            )}\n\n            <div className=\"flex items-center justify-end gap-3 pt-2\">\n              {children.length > 0 && (\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddChild(false)}\n                  className=\"px-4 py-2 text-sm text-olive hover:text-ink cursor-pointer\"\n                >\n                  Cancel\n                </button>\n              )}\n              <button\n                type=\"submit\"\n                disabled={savingChild}\n                className=\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\"\n              >\n                {savingChild ? \'Preparing Journey...\' : \'Continue to Today\342\200\231s Plan\'}\n              </button>\n            </div>\n          </form>\n        </div>\n      </div>\n    );\n  }\n\n  // Activity Detail Studio View (when caregiver opens a specific daily activity)\n  if (activeTab === \'today\' && activeItem && journey) {\n    const act = activeItem.activity;\n    const latestSub = activeItem.latestSubmission;\n    const isCompleted =\n      activeItem.completion?.status === \'completed\' ||\n      activeItem.completion?.status === \'submitted_for_review\' ||\n      activeItem.completion?.status === \'reviewed\';\n\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n        <button\n          type=\"button\"\n          onClick={() => {\n            setActiveActivityId(null);\n            setShowUploader(false);\n          }}\n          className=\"inline-flex items-center gap-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          Back to Today\342\200\231s Journey\n        </button>\n\n        {/* Clean Unboxed Metadata Header (Zero-Pill Rule) */}\n        <div className=\"space-y-2\">\n          <p className=\"text-xs text-olive\">\n            {act.domainName} <span aria-hidden=\"true\">\302\267</span> {act.ageGroupLabel}{\' \'}\n            <span aria-hidden=\"true\">\302\267</span>{\' \'}\n            <span className=\"font-mono tabular-nums\">{act.durationMinutes} min</span>\n          </p>\n          <h1 className=\"font-serif text-3xl sm:text-4xl font-medium text-ink\">{act.title}</h1>\n          <p className=\"text-base text-olive leading-relaxed max-w-2xl\">{act.summary}</p>\n        </div>\n\n        {/* Interactive Step-Paced Instructional Guide */}\n        <InstructionalGuidePlayer\n          posterUrl={act.instructionalPosterUrl}\n          activityTitle={act.title}\n          steps={act.steps}\n        />\n\n        {/* Materials & Safety Row */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div className=\"rounded-xl border border-stone bg-linen p-5 space-y-3\">\n            <h2 className=\"font-serif text-lg font-medium text-ink\">Everyday Items Needed</h2>\n            <ul className=\"space-y-2 text-sm text-olive\">\n              {act.materials.map((mat, i) => (\n                <li key={i} className=\"flex items-start gap-2.5\">\n                  <span className=\"font-mono text-xs text-eucalyptus mt-0.5 tabular-nums\">\n                    {String(i + 1).padStart(2, \'0\')}\n                  </span>\n                  <span className=\"text-ink\">{mat}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"rounded-xl border border-stone bg-ochre-soft/60 p-5 space-y-2.5\">\n            <div className=\"flex items-center gap-2 text-ochre\">\n              <ShieldAlert className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n              <h2 className=\"font-serif text-lg font-medium text-ink\">Calm Safety Reminder</h2>\n            </div>\n            <p className=\"text-sm text-ink/90 leading-relaxed\">{act.safetyNotes}</p>\n          </div>\n        </div>\n\n        {/* Numbered Step-by-Step Caregiver Instructions */}\n        <section className=\"rounded-xl border border-stone bg-linen p-6 space-y-5\">\n          <div className=\"flex items-center justify-between gap-4 border-b border-stone pb-3\">\n            <h2 className=\"font-serif text-2xl font-medium text-ink\">Step-by-Step Guide</h2>\n            <span className=\"text-xs text-olive font-mono tabular-nums\">\n              {Object.values(checkedSteps).filter(Boolean).length} / {act.steps.length} steps tried\n            </span>\n          </div>\n\n          <ol className=\"divide-y divide-stone\">\n            {act.steps.map((step) => {\n              const checked = Boolean(checkedSteps[step.id]);\n              return (\n                <li key={step.id} className=\"py-4 first:pt-1 last:pb-1\">\n                  <label className=\"flex items-start gap-3.5 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={checked}\n                      onChange={() =>\n                        setCheckedSteps((prev) => ({ ...prev, [step.id]: !prev[step.id] }))\n                      }\n                      className=\"mt-1 h-4 w-4 rounded border-stone accent-eucalyptus shrink-0\"\n                    />\n                    <div className=\"space-y-1 flex-1\">\n                      <p\n                        className={`text-sm font-semibold ${\n                          checked ? \'text-olive line-through\' : \'text-ink\'\n                        }`}\n                      >\n                        {String(step.stepNumber).padStart(2, \'0\')}. {step.title}\n                      </p>\n                      <p className=\"text-sm text-olive leading-relaxed\">{step.instructionText}</p>\n                      {step.caregiverTip && (\n                        <p className=\"text-xs text-eucalyptus pt-0.5\">\n                          Gentle cue: {step.caregiverTip}\n                        </p>\n                      )}\n                    </div>\n                  </label>\n                </li>\n              );\n            })}\n          </ol>\n        </section>\n\n        {/* Completion & Optional Private Video Coaching */}\n        <section className=\"space-y-5\">\n          {statusMessage && (\n            <div className=\"rounded-lg border border-eucalyptus/30 bg-eucalyptus-soft px-4 py-3 text-sm text-eucalyptus flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n              <span>{statusMessage}</span>\n            </div>\n          )}\n\n          {!showUploader ? (\n            <div className=\"rounded-xl border border-stone bg-linen p-6 space-y-4\">\n              <div className=\"space-y-1\">\n                <h2 className=\"font-serif text-xl font-medium text-ink\">\n                  Log Today\342\200\231s Practice or Request Caregiver Feedback\n                </h2>\n                <p className=\"text-sm text-olive\">\n                  Mark this activity complete for your private journal, or share a short clip if you would like step-by-step coaching.\n                </p>\n              </div>\n\n              <div>\n                <label\n                  htmlFor=\"practice-reflection\"\n                  className=\"block text-xs font-medium text-ink mb-1.5\"\n                >\n                  Short reflection note (optional)\n                </label>\n                <textarea\n                  id=\"practice-reflection\"\n                  rows={2}\n                  value={reflectionNote}\n                  onChange={(e) => setReflectionNote(e.target.value)}\n                  placeholder=\"How did the pace feel today?\"\n                  className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\"\n                />\n              </div>\n\n              <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                <button\n                  type=\"button\"\n                  disabled={savingCompletion}\n                  onClick={() => void handleMarkCompleted()}\n                  className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\"\n                >\n                  <Check className=\"w-4 h-4\" />\n                  {isCompleted ? \'Update Journal Note\' : \'Mark Activity Completed\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setShowUploader(true)}\n                  className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-stone bg-chalk text-ink text-sm font-medium hover:bg-oat transition-colors cursor-pointer\"\n                >\n                  <Video className=\"w-4 h-4 text-eucalyptus\" />\n                  Record or Upload Clip for Feedback\n                </button>\n              </div>\n            </div>\n          ) : (\n            <VideoCaptureUploader\n              childId={journey.child.id}\n              activityId={act.id}\n              activityTitle={act.title}\n              onSubmitted={handleVideoSubmitted}\n              onCancel={() => setShowUploader(false)}\n            />\n          )}\n\n          {/* Latest Submission & Feedback Preview directly inside Activity Studio */}\n          {latestSub && (\n            <div className=\"rounded-xl border border-stone bg-oat/50 p-5 flex flex-wrap items-center justify-between gap-4\">\n              <div className=\"space-y-1\">\n                <p className=\"text-xs text-olive\">\n                  Latest practice clip \302\267 Submitted {formatDateReadable(latestSub.createdAt, locale)}\n                </p>\n                <p className=\"text-sm font-medium text-ink\">\n                  {latestSub.review\n                    ? `Reviewed \302\267 Caregiver Instruction-Match: ${latestSub.review.instructionMatchScorePct}%`\n                    : latestSub.reviewStatus === \'in_review\'\n                      ? \'Currently being reviewed by your caregiver coach\'\n                      : \'Queued privately for caregiver coaching review\'}\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setActiveActivityId(null);\n                  onChangeTab(\'feedback\');\n                }}\n                className=\"text-sm font-medium text-eucalyptus hover:underline cursor-pointer\"\n              >\n                View in Feedback Tab\n              </button>\n            </div>\n          )}\n        </section>\n      </div>\n    );\n  }\n\n  // Main Parent Dashboard Tabs: Today | Feedback | Progress\n  return (\n    <div className=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      {/* Calm Family Context Header */}\n      <div className=\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-6\">\n        <div className=\"space-y-1.5\">\n          <p className=\"text-xs text-olive\">\n            Good day, {user?.fullName.split(\' \')[0]}\n            {journey && (\n              <>\n                {\' \'}\n                <span aria-hidden=\"true\">\302\267</span> {journey.child.displayName}{\' \'}\n                <span aria-hidden=\"true\">\302\267</span>{\' \'}\n                <span className=\"font-mono tabular-nums\">{journey.child.ageInMonths} months</span>{\' \'}\n                <span aria-hidden=\"true\">\302\267</span> {journey.child.ageGroupLabel} stage\n              </>\n            )}\n          </p>\n          <h1 className=\"font-serif text-3xl sm:text-4xl font-medium text-ink\">\n            {activeTab === \'today\' && (journey?.selectedDay.title ?? \'Today\342\200\231s Calm Journey\')}\n            {activeTab === \'feedback\' && \'Caregiver Coaching Feedback\'}\n            {activeTab === \'progress\' && `${journey?.child.displayName ?? \'Baby\'}\342\200\231s Gentle Rhythm`}\n          </h1>\n          {activeTab === \'today\' && journey && (\n            <p className=\"text-sm text-olive max-w-2xl\">{journey.selectedDay.focusNote}</p>\n          )}\n        </div>\n\n        {/* Child Switcher + Add Child */}\n        <div className=\"flex items-center gap-2\">\n          {children.length > 1 && (\n            <select\n              aria-label=\"Select child\"\n              value={selectedChildId ?? \'\'}\n              onChange={(e) => {\n                setSelectedChildId(e.target.value);\n                setSelectedDay(1);\n                setActiveActivityId(null);\n              }}\n              className=\"rounded-lg border border-stone bg-linen px-3 py-2 text-sm text-ink\"\n            >\n              {children.map((c) => (\n                <option key={c.id} value={c.id}>\n                  {c.displayName} ({c.ageGroupLabel})\n                </option>\n              ))}\n            </select>\n          )}\n          <button\n            type=\"button\"\n            onClick={() => setShowAddChild(true)}\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-stone bg-linen text-xs font-medium text-ink hover:bg-oat transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            Add Child\n          </button>\n        </div>\n      </div>\n\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-crimson bg-crimson-soft px-4 py-3 rounded-lg\">\n          {error}\n        </p>\n      )}\n\n      {loadingJourney || !journey ? (\n        <div className=\"space-y-4\">\n          <div className=\"h-40 rounded-xl bg-oat animate-pulse\" />\n          <div className=\"h-40 rounded-xl bg-oat animate-pulse\" />\n        </div>\n      ) : (\n        <>\n          {/* TAB 1: TODAY\'S CALM DAILY JOURNEY */}\n          {activeTab === \'today\' && (\n            <div className=\"space-y-6\">\n              {/* Calm Day Sequence Selector */}\n              {journey.availableDays.length > 1 && (\n                <div className=\"flex items-center gap-1 p-1 rounded-lg bg-oat w-fit\">\n                  {journey.availableDays.map((d) => (\n                    <button\n                      key={d.dayNumber}\n                      type=\"button\"\n                      onClick={() => setSelectedDay(d.dayNumber)}\n                      className={`px-3.5 py-1.5 rounded-md text-xs font-medium transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                        selectedDay === d.dayNumber\n                          ? \'bg-linen text-ink shadow-xs\'\n                          : \'text-olive hover:text-ink\'\n                      }`}\n                    >\n                      Day {d.dayNumber}\n                    </button>\n                  ))}\n                </div>\n              )}\n\n              {/* Daily Activities List (2\342\200\2233 focused cards, zero badge clutter) */}\n              {journey.items.length === 0 ? (\n                <div className=\"rounded-xl border border-stone bg-linen p-8 text-center space-y-2\">\n                  <p className=\"font-serif text-xl text-ink\">\n                    No activities scheduled yet for {journey.child.ageGroupLabel}\n                  </p>\n                  <p className=\"text-sm text-olive\">\n                    An administrator can publish activities and assign them to this age band\342\200\231s daily plan.\n                  </p>\n                </div>\n              ) : (\n                <div className=\"space-y-5\">\n                  {journey.items.map((item, idx) => {\n                    const statusLabel = item.latestSubmission?.review\n                      ? `Reviewed \302\267 ${item.latestSubmission.review.instructionMatchScorePct}% instruction match`\n                      : item.latestSubmission?.reviewStatus === \'queued\' ||\n                          item.latestSubmission?.reviewStatus === \'in_review\'\n                        ? \'Clip submitted \302\267 Awaiting feedback\'\n                        : item.completion?.status === \'completed\'\n                          ? \'Completed today\'\n                          : \'Ready when you are\';\n\n                    return (\n                      <article\n                        key={item.planItemId}\n                        className=\"rounded-xl border border-stone bg-linen overflow-hidden grid grid-cols-1 md:grid-cols-12\"\n                      >\n                        <div className=\"md:col-span-4 min-h-[190px]\">\n                          <EditorialImage\n                            src={item.activity.instructionalPosterUrl}\n                            alt={item.activity.title}\n                            aspectClassName=\"w-full h-full\"\n                          />\n                        </div>\n\n                        <div className=\"md:col-span-8 p-5 sm:p-6 flex flex-col justify-between gap-4\">\n                          <div className=\"space-y-2\">\n                            <p className=\"text-xs text-olive\">\n                              <span className=\"font-mono tabular-nums\">\n                                0{idx + 1}\n                              </span>{\' \'}\n                              <span aria-hidden=\"true\">\302\267</span> {item.activity.domainName}{\' \'}\n                              <span aria-hidden=\"true\">\302\267</span>{\' \'}\n                              <span className=\"font-mono tabular-nums\">\n                                {item.activity.durationMinutes} min\n                              </span>\n                            </p>\n                            <h2 className=\"font-serif text-2xl font-medium text-ink\">\n                              {item.activity.title}\n                            </h2>\n                            <p className=\"text-sm text-olive leading-relaxed\">\n                              {item.activity.summary}\n                            </p>\n                            <p className=\"text-xs text-olive pt-1\">\n                              At home: {item.activity.materials.slice(0, 3).join(\', \')}\n                            </p>\n                          </div>\n\n                          <div className=\"flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-stone\">\n                            <span\n                              className={`text-xs font-medium inline-flex items-center gap-1.5 ${\n                                item.latestSubmission?.review || item.completion?.status === \'completed\'\n                                  ? \'text-eucalyptus\'\n                                  : \'text-olive\'\n                              }`}\n                            >\n                              {item.latestSubmission?.review || item.completion?.status === \'completed\' ? (\n                                <CheckCircle2 className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n                              ) : (\n                                <Clock className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n                              )}\n                              {statusLabel}\n                            </span>\n\n                            <button\n                              type=\"button\"\n                              onClick={() => openActivityStudio(item)}\n                              className=\"px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                            >\n                              Open Activity Guide\n                            </button>\n                          </div>\n                        </div>\n                      </article>\n                    );\n                  })}\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 2: CAREGIVER COACHING FEEDBACK & PRIVATE VIDEO MANAGEMENT */}\n          {activeTab === \'feedback\' && (\n            <div className=\"space-y-6\">\n              {/* Prominent Non-Diagnostic Safeguard Banner */}\n              <div className=\"rounded-xl border border-stone bg-oat/70 p-4 flex items-start gap-3\">\n                <Info className=\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\" aria-hidden=\"true\" />\n                <div className=\"text-xs text-olive leading-relaxed\">\n                  <span className=\"font-semibold text-ink\">{t(\'policy.nonDiagnosticTitle\')}:</span>{\' \'}\n                  {t(\'policy.nonDiagnosticBody\')}\n                </div>\n              </div>\n\n              {journey.recentSubmissions.length === 0 ? (\n                <div className=\"rounded-xl border border-stone bg-linen p-10 text-center space-y-3\">\n                  <p className=\"font-serif text-xl text-ink\">No practice clips shared yet</p>\n                  <p className=\"text-sm text-olive max-w-md mx-auto\">\n                    Whenever you would like warm coaching on an activity\342\200\231s steps, open any activity from Today\342\200\231s Journey and share a short private clip.\n                  </p>\n                  <button\n                    type=\"button\"\n                    onClick={() => onChangeTab(\'today\')}\n                    className=\"px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors cursor-pointer\"\n                  >\n                    Go to Today\342\200\231s Journey\n                  </button>\n                </div>\n              ) : (\n                <div className=\"space-y-6\">\n                  {journey.recentSubmissions.map((sub) => (\n                    <article\n                      key={sub.id}\n                      className=\"rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\"\n                    >\n                      <div className=\"flex flex-wrap items-start justify-between gap-4 border-b border-stone pb-4\">\n                        <div className=\"space-y-1\">\n                          <p className=\"text-xs text-olive\">\n                            {sub.domainName} <span aria-hidden=\"true\">\302\267</span> {sub.ageGroupLabel}{\' \'}\n                            <span aria-hidden=\"true\">\302\267</span> Submitted{\' \'}\n                            {formatDateReadable(sub.createdAt, locale)}\n                          </p>\n                          <h2 className=\"font-serif text-2xl font-medium text-ink\">\n                            {sub.activityTitle}\n                          </h2>\n                        </div>\n\n                        {sub.review ? (\n                          <div className=\"text-left sm:text-right\">\n                            <p className=\"font-mono text-3xl font-medium text-eucalyptus tabular-nums\">\n                              {sub.review.instructionMatchScorePct}%\n                            </p>\n                            <p className=\"text-xs text-olive\">Caregiver Instruction-Match</p>\n                          </div>\n                        ) : (\n                          <p className=\"text-xs font-medium text-ochre\">\n                            {sub.reviewStatus === \'in_review\'\n                              ? \'In review with caregiver coach\'\n                              : sub.reviewStatus === \'deleted\'\n                                ? \'Video deleted prior to review\'\n                                : \'Queued for caregiver review\'}\n                          </p>\n                        )}\n                      </div>\n\n                      {/* Private Signed Video Stream or Privacy Deletion Confirmation */}\n                      <SecureVideoPlayer\n                        submissionId={sub.id}\n                        hasActiveVideo={sub.hasActiveVideo}\n                        expiresAt={sub.expiresAt}\n                        deletionReason={sub.deletionReason}\n                      />\n\n                      {/* Reviewer Coaching Breakdown */}\n                      {sub.review && (\n                        <div className=\"space-y-5 pt-1\">\n                          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                            <div className=\"rounded-lg border border-stone bg-chalk p-4 space-y-1.5\">\n                              <p className=\"text-xs font-semibold text-eucalyptus\">\n                                What Went Well\n                              </p>\n                              <p className=\"text-sm text-ink leading-relaxed\">\n                                {sub.review.strengthsNote}\n                              </p>\n                            </div>\n                            <div className=\"rounded-lg border border-stone bg-chalk p-4 space-y-1.5\">\n                              <p className=\"text-xs font-semibold text-ochre\">\n                                Gentle Tip for Next Time\n                              </p>\n                              <p className=\"text-sm text-ink leading-relaxed\">\n                                {sub.review.coachingTip}\n                              </p>\n                            </div>\n                          </div>\n\n                          <div className=\"space-y-2\">\n                            <h3 className=\"font-serif text-base font-medium text-ink\">\n                              Caregiver Step Rubric Breakdown\n                            </h3>\n                            <div className=\"divide-y divide-stone border-t border-b border-stone\">\n                              {sub.review.rubricScores.map((score) => (\n                                <div\n                                  key={score.id}\n                                  className=\"py-2.5 flex flex-wrap items-center justify-between gap-3 text-sm\"\n                                >\n                                  <div>\n                                    <p className=\"font-medium text-ink\">{score.criterionLabel}</p>\n                                    <p className=\"text-xs text-olive\">{score.criterionDescription}</p>\n                                  </div>\n                                  <div className=\"flex items-center gap-4 text-xs font-mono tabular-nums shrink-0\">\n                                    <span\n                                      className={\n                                        score.achievedLevel === \'met\'\n                                          ? \'text-eucalyptus font-medium\'\n                                          : score.achievedLevel === \'partially_met\'\n                                            ? \'text-ochre font-medium\'\n                                            : \'text-olive\'\n                                      }\n                                    >\n                                      {score.achievedLevel === \'met\'\n                                        ? \'Met\'\n                                        : score.achievedLevel === \'partially_met\'\n                                          ? \'Partially Met\'\n                                          : \'Not Observed\'}\n                                    </span>\n                                    <span className=\"text-olive\">\n                                      {score.earnedPoints}/{score.maxPoints} pts\n                                    </span>\n                                  </div>\n                                </div>\n                              ))}\n                            </div>\n                            <p className=\"text-xs text-olive pt-1\">\n                              Reviewed by {sub.review.reviewerName} on{\' \'}\n                              {formatDateReadable(sub.review.submittedAt, locale)} \302\267 Scope confirmed: caregiver execution only.\n                            </p>\n                          </div>\n                        </div>\n                      )}\n\n                      {/* Instant Right-to-Delete Video Control */}\n                      {sub.hasActiveVideo && (\n                        <div className=\"pt-3 border-t border-stone flex flex-wrap items-center justify-between gap-3\">\n                          <span className=\"text-xs text-olive font-mono tabular-nums\">\n                            Scheduled auto-deletion in {formatDaysUntilExpiry(sub.expiresAt)} days\n                          </span>\n\n                          {confirmDeleteSubId === sub.id ? (\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-xs text-ink\">\n                                Permanently delete video? (Feedback stays)\n                              </span>\n                              <button\n                                type=\"button\"\n                                disabled={deletingVideoId === sub.id}\n                                onClick={() => void handleDeleteVideo(sub.id)}\n                                className=\"px-3 py-1.5 rounded-lg bg-crimson text-white text-xs font-medium hover:opacity-90 cursor-pointer\"\n                              >\n                                {deletingVideoId === sub.id ? \'Deleting...\' : \'Confirm Delete\'}\n                              </button>\n                              <button\n                                type=\"button\"\n                                onClick={() => setConfirmDeleteSubId(null)}\n                                className=\"px-2.5 py-1.5 text-xs text-olive hover:text-ink cursor-pointer\"\n                              >\n                                Cancel\n                              </button>\n                            </div>\n                          ) : (\n                            <button\n                              type=\"button\"\n                              onClick={() => setConfirmDeleteSubId(sub.id)}\n                              className=\"inline-flex items-center gap-1.5 text-xs font-medium text-crimson hover:underline cursor-pointer\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                              Delete Video Now\n                            </button>\n                          )}\n                        </div>\n                      )}\n                    </article>\n                  ))}\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* TAB 3: CALM SIX-DOMAIN BALANCE OVERVIEW */}\n          {activeTab === \'progress\' && (\n            <div className=\"space-y-6\">\n              <div className=\"rounded-xl border border-stone bg-linen p-6 space-y-5\">\n                <div className=\"space-y-1\">\n                  <h2 className=\"font-serif text-2xl font-medium text-ink\">\n                    Activities Practiced Across All Six Domains\n                  </h2>\n                  <p className=\"text-sm text-olive\">\n                    A quiet view of the everyday moments you have shared together\342\200\224never a checklist of pressure or baby grades.\n                  </p>\n                </div>\n\n                <div className=\"divide-y divide-stone border-t border-stone\">\n                  {journey.domainProgress.map((stat) => {\n                    const maxVal = Math.max(\n                      3,\n                      ...journey.domainProgress.map((d) => d.completedCount)\n                    );\n                    const widthPct = Math.min(100, Math.round((stat.completedCount / maxVal) * 100));\n                    return (\n                      <div\n                        key={stat.domainId}\n                        className=\"py-4 grid grid-cols-1 sm:grid-cols-12 items-center gap-3\"\n                      >\n                        <div className=\"sm:col-span-5\">\n                          <p className=\"text-sm font-medium text-ink\">{stat.domainName}</p>\n                        </div>\n                        <div className=\"sm:col-span-5\">\n                          <div className=\"h-2 rounded-full bg-oat overflow-hidden\">\n                            <div\n                              className=\"h-full bg-eucalyptus transition-all duration-300\"\n                              style={{ width: `${widthPct}%` }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"sm:col-span-2 sm:text-right font-mono text-xs text-olive tabular-nums\">\n                          {stat.completedCount}{\' \'}\n                          {stat.completedCount === 1 ? \'session\' : \'sessions\'}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n          )}\n        </>\n      )}\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/ParentJourneyView.tsx"
        }
        overwrite: true
      }
    }
