            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.everydayCup,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Set out only 3 rings first\', instructionText: \'Place the wooden post and just three rings beside it so the task feels achievable.\', caregiverTip: \'You can add more rings on future days.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Show one deliberate ring placement\', instructionText: \'Lift one ring with both hands, slide it slowly down the post, and pause.\', caregiverTip: \'Move slower than feels natural.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Wait patiently\', instructionText: \'Let toddler try, miss, adjust, and retry without grabbing the ring from their hand.\', caregiverTip: \'Offer a quiet smile rather than constant praise.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Wipe or fold cloth to finish\', instructionText: \'Invite toddler to place the cloth neatly beside the stacker when finished.\', caregiverTip: \'Celebrates shared care of space.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Manageable 3-ring setup\', description: \'Caregiver simplified the activity to prevent overwhelm.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Slow deliberate modeling\', description: \'Caregiver demonstrated one step calmly with clear hand visibility.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Patient non-interference\', description: \'Caregiver allowed toddler to retry without taking over.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Gentle closing routine\', description: \'Caregiver modeled placing materials neatly afterward.\', weightPoints: 20 },"
