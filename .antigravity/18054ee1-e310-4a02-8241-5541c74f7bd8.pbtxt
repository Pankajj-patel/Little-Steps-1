            lines {
              text: "    title: \'In-and-Out Steel Katori Drop\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Explore container play by dropping knitted cotton balls into a wide steel bowl.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Wide rounded steel katori\', \'2\342\200\2233 soft knitted cotton balls\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Ensure balls are larger than 4.5 cm so they cannot pose a choking hazard.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.sensoryLinen,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Arrange neatly on the mat\', instructionText: \'Place the steel bowl centered on the mat with two cotton balls resting on the left.\', caregiverTip: \'Neat order invites curiosity.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Demonstrate once silently\', instructionText: \'Pick up one ball slowly, drop it into the bowl with a soft sound, and pause.\', caregiverTip: \'Slow hands teach better than long explanations.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Invite baby\342\200\231s turn\', instructionText: \'Say \342\200\234Your turn\342\200\235 softly and sit back with relaxed hands.\', caregiverTip: \'Let baby dump the bowl out too\342\200\224that is part of learning.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Tidy together\', instructionText: \'Place the balls back in the bowl calmly at the end and say \342\200\234All tucked away.\342\200\235\', caregiverTip: \'Simple closing routines build calm habits.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Ordered mat presentation\', description: \'Caregiver presented bowl and balls neatly without clutter.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Slow single demonstration\', description: \'Caregiver modeled dropping one item slowly and clearly.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Hands-off invitation\', description: \'Caregiver let baby experiment with dropping and emptying freely.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Calm tidy-up closure\', description: \'Caregiver closed the activity with gentle narration.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
