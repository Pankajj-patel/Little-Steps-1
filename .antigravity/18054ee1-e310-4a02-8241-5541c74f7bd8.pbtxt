        replacement_content: "export function getRubricMultiplier(level: RubricAchievementLevel): number | null {\n  switch (level) {\n    case \'met\':\n      return 1;\n    case \'partially_met\':\n      return 0.5;\n    case \'not_met\':\n    case \'not_observed\':\n      return 0;\n    case \'not_assessable\':\n      return null;\n  }\n}\n\n/**\n * Computes the caregiver instruction-match percentage (0\342\200\223100) from weighted criteria:\n *   Instruction Match Percentage = (Weighted points earned / Applicable weighted points) \303\227 100\n * Criteria marked \'not_assessable\' are excluded from applicable weighted points.\n * If applicable weight is 0 or less than 50% of total rubric weight (insufficient evidence),\n * returns isAssessable=false and scorePct=null (\"Not Assessable\") rather than a misleading percentage.\n * Explicitly evaluates caregiver instruction execution only \342\200\224 never baby development.\n */\nexport function calculateInstructionMatchScore(\n  items: Array<{ weightPoints: number; achievedLevel: RubricAchievementLevel }>\n): {\n  isAssessable: boolean;\n  scorePct: number | null;\n  earnedTotal: number;\n  applicableTotal: number;\n  maxTotal: number;\n  excludedCount: number;\n} {\n  const maxTotal = items.reduce((sum, item) => sum + item.weightPoints, 0);\n  if (maxTotal <= 0) {\n    return {\n      isAssessable: false,\n      scorePct: null,\n      earnedTotal: 0,\n      applicableTotal: 0,\n      maxTotal: 0,\n      excludedCount: 0,\n    };\n  }\n\n  let earnedTotal = 0;\n  let applicableTotal = 0;\n  let excludedCount = 0;\n\n  for (const item of items) {\n    const mult = getRubricMultiplier(item.achievedLevel);\n    if (mult === null) {\n      excludedCount += 1;\n      continue;\n    }\n    applicableTotal += item.weightPoints;\n    earnedTotal += item.weightPoints * mult;\n  }\n\n  // Require at least 50% of rubric weight to be assessable to avoid misleading percentages\n  if (applicableTotal <= 0 || applicableTotal < 