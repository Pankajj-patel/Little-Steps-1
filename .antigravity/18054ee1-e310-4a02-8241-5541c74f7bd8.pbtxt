            }
            lines {
              text: "  3. Enable strict TypeScript type-checking (`strict: true`) and install only essential runtime dependencies (`better-sqlite3`, `multer`, `zod`, `cookie-parser`) when Step 1 is approved."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 1. Overview, Core Concept & Workspace Inspection"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Existing Workspace Audit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Frontend Stack**: React 19.0.1, Vite 8.3.0, TypeScript 7.0.2, Tailwind CSS v4.3.3 (`@tailwindcss/vite`), `lucide-react` icons, and `motion` for gentle transitions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Backend Readiness**: Express 4.21.2, `tsx` 4.21.0, and `dotenv` 17.2.3 are already installed; the current dev script serves Vite standalone without an API server or database yet."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Environment Constraints**: Port 3000 single-origin serving, HMR disabled cleanly via `DISABLE_HMR`, and existing asset-copy build hook preserved."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Core Product Concept"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Primary Audience**: Mothers and caregivers in India (responsive mobile-first web initially; API-ready for Android & iOS and global expansion)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **8 Age Groups (0\342\200\22324 Months)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  `0\342\200\2233m` \302\267 `3\342\200\2236m` \302\267 `6\342\200\2239m` \302\267 `9\342\200\22312m` \302\267 `12\342\200\22315m` \302\267 `15\342\200\22318m` \302\267 `18\342\200\22321m` \302\267 `21\342\200\22324m`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Babies are automatically mapped to their exact 3-month band using their date of birth, smoothly unlocking the next stage as they grow."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **6 Learning Domains**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. Cognitive Development"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. Language and Communication"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. Physical Development"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. Social and Emotional Development"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  5. Sensory Development"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  6. Early Independence and Everyday Skills"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Non-Diagnostic Instruction-Match Principle**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Reviewers evaluate **only the caregiver\'s demonstrated execution of activity steps** using an objective, weighted rubric that produces a percentage-based **Instruction-Match Score**. LittleSteps explicitly never scores, diagnoses, or ranks a baby\'s intelligence, developmental level, or health."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 2. User Experience, User Journeys & Visual Design"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Visual Identity & Theme \342\200\224 Warm Calm Montessori Editorial"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Designed to feel like a serene, sunlit Montessori parenting journal rather than a noisy clinical dashboard or overstimulating toy store."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **60-30-10 Color System**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **60% Dominant Neutral Canvas**: Warm Chalk (`#FAF9F6`, `--background`) paired with pure Crisp Linen surfaces (`#FFFFFF`, `--surface`) and Deep Charcoal Forest Ink (`#1F2421`, `--foreground`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **30% Structural Surfaces**: Soft Oat recessed panels (`#F3F1EC`, `--surface-muted`), Warm Stone 1px hairlines (`#E6E3DC`, `--border`), and Slate Olive secondary text (`#57605A`, `--muted-foreground`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **10% Accent Budget**: Deep Botanical Eucalyptus (`#2F5D50`, `--primary`) for primary actions and active navigation states; Warm Honey Ochre (`#B87D2B`, `--accent`) strictly for gentle highlights and pending-review cues. All semantic states (Reviewed, Pending, Action Needed) pair color with explicit text labels and icons \342\200\224 never color alone."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Typography & Hierarchy (2+1 Font Discipline)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Display & Editorial Headings*: `Fraunces` (warm, expressive literary serif with `text-wrap: balance` to eliminate orphan headline words)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Body & Interface Controls*: `Plus Jakarta Sans` (clear, human sans-serif at 15\342\200\22316px with 1.6 line-height for effortless one-handed mobile reading)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Scores, Timestamps & Metrics*: `IBM Plex Mono` with `tabular-nums` strictly for percentage match scores, video durations, age-month indicators, and audit timestamps."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Layout & Restraint Rules**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Top Bar Contract**: Single-row, three-zone header (`LittleSteps` wordmark \342\200\224 4 concise single-line links \342\200\224 1 primary action). Mobile sticky chrome stays strictly under 15% of viewport height."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Zero-Pill Metadata**: Domain names, age bands, durations, and statuses render as quiet unboxed typography separated by `\302\267` (e.g., `Sensory \302\267 6\342\200\2239 months \302\267 5 min`), reserving styled buttons strictly for interactive filters and CTAs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Single-Elevation & Calm Pacing**: Flat surfaces separated by generous whitespace and 1px hairline borders \342\200\224 no nested cards-within-cards, no thick left accent borders, no decorative pulsing dots, and no wall-of-text paragraphs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Motion Budget**: Subtle compositor-only transitions (`opacity`, `transform`) settling within 180ms (`prefers-reduced-motion` respected)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Complete User Journeys"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### A. Parent / Caregiver Journey"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Gentle Onboarding**: Create account (email + password, optional mobile number & locale) \342\206\222 Add child profile (name + date of birth) \342\206\222 System computes age in months and places the family into the exact 3-month age band."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Today\'s Calm Daily Journey**: Opens to a single focused focal anchor \342\200\224 *Today\'s 2\342\200\2233 Recommended Activities* (progressive disclosure: one primary card in focus, remaining cards quiet below). Caregiver can switch between Today, Weekly Progress, and Feedback History."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Guided Activity Session**: Opens an activity \342\206\222 Watches concise instructional video \342\206\222 Scans everyday India-friendly household items and safety reminders \342\206\222 Follows numbered step-by-step instructions one card/step at a time."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Practice & Private Video Submission**: Marks activity complete OR chooses to record in-browser / upload a short video clip (max 2 min / 50 MB) with optional reflection note \342\206\222 Sees clear inline privacy notice (*Private to you and your reviewer \302\267 Auto-deletes in 30 days \302\267 Delete anytime*) and confirms consent before upload."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Constructive Feedback Loop**: Views reviewer\'s **Caregiver Instruction-Match Score (%)**, step-by-step rubric breakdown (e.g., *Setup & Safety: Met*, *Calm Pacing: Met*, *Verbal Cueing: Partially Met*), warm strengths note, and one practical tip for next time \342\206\222 Can delete the uploaded video immediately while keeping the written coaching notes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### B. Reviewer Journey"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Structured Review Queue**: Signs into Reviewer Workbench \342\206\222 Sees prioritized queue filtered by status (`Queued`, `In Review`, `Completed`) and age band, ordered FIFO with clear wait-time timestamps."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Split-Screen Evaluation Workbench**: Claims a submission \342\206\222 Left pane renders the private, stream-only video player alongside the exact Activity Steps reference (showing only child\'s age band \342\200\224 zero parent contact PII); Right pane renders the activity\'s weighted **Caregiver Execution Rubric**."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Objective Scoring & Attestation**: Selects `Met`, `Partially Met`, or `Not Observed` per caregiver step \342\206\222 Percentage instruction-match score auto-calculates live with tabular numerals \342\206\222 Writes encouraging *What Went Well* + *Gentle Next-Time Tip* \342\206\222 Confirms mandatory non-diagnostic attestation (*\"This feedback evaluates caregiver instruction execution only, not the child\"*) \342\206\222 Submits review."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### C. Admin Journey"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Curriculum Coverage Overview**: Views matrix of published activities across all **8 age groups \303\227 6 learning domains** to identify content gaps."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Curriculum & Rubric Authoring**: Creates/edits Activities (domain, age group, summary, household materials, safety notes, instructional media, ordered steps, and weighted rubric criteria summing to 100%) and assigns them into sequenced **Daily Plans**."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Operations & Privacy Governance**: Manages user roles (promoting/deactivating reviewers), monitors video queue volume, inspects automated 30-day retention sweep status, and reviews immutable media access audit logs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Key Product Decisions, Role Governance & Child Video Security"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Role-Based Access Control (RBAC) Matrix"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Capability / Resource | Parent / Caregiver | Reviewer | Admin |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| :--- | :--- | :--- | :--- |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Manage own profile & children | Full (own family only) | None | Read (masked) |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Browse age-matched daily activities | Read (published) | Read (reference) | Full CRUD |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Log completions & upload videos | Full (own children) | None | None |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Stream caregiver activity videos | Own videos only | Assigned/claimed queue only | Restricted (audit-logged) |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Delete uploaded video immediately | Yes (own videos) | No | Moderation/retention purge |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Score rubrics & write feedback | Read own feedback | Create/submit on assigned | Read aggregate metrics |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Manage curriculum, plans & roles | No | No | Full CRUD |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| View media access audit logs | Own deletion history | None | Full read-only audit |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Child Video Security & Privacy Architecture (DPDP Act 2023 & Global Readiness)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "> [!WARNING]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "> Children\'s videos are high-sensitivity personal data. Every video path must be private-by-default, non-enumerable, access-audited, and automatically expired."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Zero Public Exposure**: Uploaded videos are stored in a private media vault **outside** the Vite public/static bundle using random opaque UUID keys (never original filenames or sequential IDs)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Short-Lived Signed Streaming Tokens**: Playback requests require a valid authenticated session and an HMAC-SHA256 signed stream token (5-minute TTL) scoped to `actor_user_id + submission_id`. The Express streaming endpoint enforces RBAC, supports HTTP `Range` requests for smooth mobile seeking, and sends `Cache-Control: private, no-store`, `Content-Disposition: inline`, and `X-Content-Type-Options: nosniff`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Strict Upload Hardening**: Server enforces MIME allowlist (`video/mp4`, `video/webm`, `video/quicktime`), binary magic-byte header validation, 50 MB file cap, and 120-second duration limit (friendly for Indian mobile bandwidth and safe against storage exhaustion)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **30-Day Automatic Deletion + Instant Right-to-Delete**: Every submission sets `expires_at = created_at + 30 days`. A background retention worker periodically purges expired video files from disk and marks records `deleted` (`deletion_reason = \'retention_30d\'`). Parents can also tap **Delete Video** at any time for immediate physical deletion while optionally retaining their written feedback summary."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Reviewer Data Minimization**: Reviewers see only the child\'s age band (e.g., `6\342\200\2239 months`), activity guidelines, and the video stream \342\200\224 never parent email, phone number, address, or full legal identifiers."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Immutable Audit Trail & Auth Hardening**: Every upload, stream open, review submission, parent delete, and auto-purge writes an entry to `media_access_audit_logs`. Authentication uses Node native `crypto.scrypt` per-user salted password hashes, `HttpOnly` + `SameSite=Lax` signed session cookies, Zod input validation, parameterized SQL queries, and endpoint rate limiting."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Key Architectural Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Local SQLite Behind a Repository Interface**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: `better-sqlite3` (WAL mode + strict foreign keys enabled) wrapped in domain repository modules."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Zero external provisioning friction for rapid prototype validation, full relational integrity for rubrics and audit trails, and clean SQL portability to Cloud SQL PostgreSQL before public launch."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Storage Adapter Abstraction for Media**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: `MediaStorageAdapter` interface implemented with private local disk storage in the prototype."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Lets us prove the full upload \342\206\222 signed stream \342\206\222 30-day auto-purge lifecycle immediately while making production migration to GCS/S3 signed URLs a single adapter swap."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Versioned REST API (`/api/v1`) from Day One**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Stateless JSON DTO contracts shared between React client and Express server."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Directly prepares LittleSteps for future Android and iOS native/cross-platform clients without duplicating business logic or RBAC rules."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 4. Technical Architecture, Data Model & Phased Milestones *(Technical Reference)*"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
