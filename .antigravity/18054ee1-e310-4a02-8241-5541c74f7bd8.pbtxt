            lines {
              text: "    title: \'Slow Goodbye Wave & Return Game\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    summary: \'Practice reassuring short separations around a doorway to build trust.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    materials: [\'Familiar room doorway\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    safetyNotes: \'Keep baby in a completely safe floor space while you step just out of sight for 2 seconds.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.heroMontessori,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Announce before stepping\', instructionText: \'Wave calmly at eye level and say \342\200\234Mama is stepping behind the door, I\342\200\231ll be right back.\342\200\235\', caregiverTip: \'Never sneak away unexpectedly.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Step just out of sight briefly\', instructionText: \'Pause 2 seconds while keeping your warm voice audible: \342\200\234I\342\200\231m right here!\342\200\235\', caregiverTip: \'Your voice bridges the moment.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Return warmly\', instructionText: \'Step back in calmly smiling: \342\200\234Mama came back!\342\200\235\', caregiverTip: \'Keep the tone steady rather than overly dramatic.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Offer a warm cuddle if sought\', instructionText: \'Welcome baby with open arms and calm breathing.\', caregiverTip: \'Builds everyday confidence for real goodbyes.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Clear verbal cue before stepping\', description: \'Caregiver told baby calmly before stepping out of sight.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Reassuring vocal bridge\', description: \'Caregiver kept a calm voice during the brief pause.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Predictable warm return\', description: \'Caregiver returned smoothly within 2\342\200\2233 seconds.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Emotionally attuned finish\', description: \'Caregiver responded warmly to baby\342\200\231s reaction.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
