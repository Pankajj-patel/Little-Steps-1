325\256\260<\377\'\234\037H5\031~\251\031\242\303n\3356\177oe\345\006\336\3551\244\267\206v\212\375y\202\362d=mc\362\267\224ZH\270\220\bbT\"\300\250\300\320\033\255\254k\346\325-\005=\314\377)>\023(\270\356\266k\243\031\034\272\365P4\005\241:q\323\353\354\a\214\327g\260\227\260\376_\234zKQv\312\331%Q@\023\330\303\b\331\237\314\360i@\327\000\300\f\200S\311\t\363J|\321]\023\255f[\346\254\201\340\003\3460~\223\245K\a\240K\255\316\276\003\nI>]8w\372\216%\r:\316\317BV\271B\334\363\031\300\376\205\207v\205\237\306>z\253\217\250 (\355\352\236\304\323\321\370\235\002\2012=\020E\030D\f\263\226a\021\315\354\331\360o\232M\036\nE\006\327~\330!I\206E3f\344\331\361\202\360j\302\346\336\252~\324+q\245w\321\272\v\272e@\201\024\370}\215s\205Z\267\361_\335<\370.D(4\037=\330\023T\376\253%\250t\004\320\n\032\336\026h=aMl\332\352\271\376\245\344\000?\005Ui\030Q\236\376g\240m\277OG\220*\245~\312U\v1\0218\273`\372\"\246\203i\246\000\3424\264\303JZ\243\336\264\333\346\315J\241[\320x\t\235\316\023h!\216\177\034\237>\223D\325\234\367\021[\304\213nL\f\204p\335j-j\326w\314\362\n\243\375\310)2\017\"\360\320\310\377\323\375n\237\030\375M\267\267+_\314=S|\276\026\366gU\\\215z\244\207\362\242\243\242:\3458:\275\276\002\344m`D\336\323\335\373\314\346V\333\257\267\211\375\005\252Cj\250\331\363\\\335\030\257\027\322\224\004\327\221\t\317\016M\337\237i\t.\200\300(\345\273\205kK\367\020\262\247p\300\274\3277\2112W\005\301\265=\257(\234\354\307\230g8\244(\222\315\241\301\332\304\255\263\356\224\305\340\303\"l\227\216<\326y\356VZ\240g\211SU\031K<Y\260u\253<\251P\221\t\247\315\224hV\267\026\273\300\037\v\305\325\030r\224\232\230\337_\261\277f\313\344\315@)/\367\263\204\253\307\362G/zH\217Q>\337\234\366t\313\312\237\263x2jG\"\3119<\314Ift\327k>9\246&\3070b\202a\003\025\233\275\204\236\\\242\254\232\317\277\273\316\362\214\300\tT\v\v\032\020\234\3756fFJAD\005\367\332qn[\230P\n\203\f\307{\310N\313\300Z(\305\260D\270\321q+qB\371\347\305p\314\275\307\022+D}qt\n-\330}\3619\332gk\027*t\260\2219\304t\033\242\266`nWfc\356\343\001V\343W>\266Wh\327)\314\026\214k\255\f\\j\370\021\373\260u*c\306\365Il\332`JL\026\360\n\341h\357\375E\306\361\262\024\2440\361\256\214\215,\374A\353i\327\220hQ\377IM\0253M\206\251\0233&k\233\371\307\030\002\240\027\261A\340hxm^B\342Nw\366+1\244n(h\237\343&\227-\340\315\037i\207>\216n\203\ru\364\026eK\231mZU\034\327\271\021\331f/\003D\357\264\261\342[\305u\266\177\305\240\361B\235\003\257\216VMd\a\310\330@J/\035\0048\201\261L\277\211\215\222\372\027\265\v\354\017\247\225\247\336\352\202\336Z=&\277\217\365\213\203\260\274=\374K\001,\240\274~\"S\'&\330J\224\270\273\254\372\250I\255\032\256\347\331\233\020|\023\032\212\351q\323\364\017YRwM(\377\a\357\371!\237:\001B\342g\031u#\3511\353\346A\356\312\321\206\277\266\263\206c\320 s\022\001\373>\000\317e\2775\227\241m\235,\346\026\2016\250<s\353\274\3619jf\035l\323\310\267\255h\020\265\2365\352\000NxZ\313\322\224b\367O\302\222\365$O\304\002\321p\277V4\366\240d\366M\324\023\216\375=\262\332\377\277\v\016\022\037\263lA\233\0047\220\023\2753\036O\361\325\372H\333u\253\341\233\026\272(\\\031K\206+\360\243HX\221Y\260E\202\356>\221\227\236\024\363k\005\254G\362\a\246\026\031\245\301\247\2530\"\363\n\357!\031p\\\377\3269]\022\'\017\t\035\363\234Vl\275H\310t\306H\261\265-\031\344\037\231\022\314\\w\265,\214\266\241u4\255?6\344p\0234u\217\001\342<\332\257bZ\242iT\3558\265\254\241\201f\303\254\335\365\021-\377\202h\366\322\204\200\220\362\334\222\323A\346\272\0023\277}\254\024X\254\346z\240xK\036\351\226a\225\212}KY\377s\375\003o\nrB\307=X\334\\\233\211\204\220DeM\273_\v\024\247\n\212\004$\361\272 \236\\\001\3028\214\251\355\r\223[5\267\240\222\337\364R\326C\005\305\365\313\225\247\310\227c\371\206\252\\\366\363c\r\a6\t\3033g\335\367\234\334\tL\225\312\331\023\200\202\372C\337\273k\315hC\304Q\314\246-$\311G.\r\0260\276\032[\374\227&\272\021\322\242\270\337K\344\360]\020\2038@\345\222\225\245\243\177mZ\2027(\236\030\017\375)S\020q\2169`\r\265*;0Rtj\250\240R\364x\001R\003\304Gpq\352\344\313\305\226\316-\207{Q|\276\314;\350\364\344\f=\033]\316\345"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_330057736009127026"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useState } from \'react\';\\nimport {\\n  ArrowLeft,\\n  Check,\\n  CheckCircle2,\\n  Clock,\\n  Info,\\n  Plus,\\n  ShieldAlert,\\n  Trash2,\\n  Video,\\n} from \'lucide-react\';\\nimport { EditorialImage } from \'../components/EditorialImage\';\\nimport { InstructionalGuidePlayer } from \'../components/InstructionalGuidePlayer\';\\nimport { SecureVideoPlayer } from \'../components/SecureVideoPlayer\';\\nimport { VideoCaptureUploader } from \'../components/VideoCaptureUploader\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { api } from \'../lib/api\';\\nimport {\\n  calculateAgeInMonths,\\n  CANONICAL_AGE_GROUPS,\\n  formatDaysUntilExpiry,\\n  resolveAgeGroupSlug,\\n} from \'../shared/domain\';\\nimport { formatDateReadable } from \'../shared/i18n\';\\nimport type {\\n  ChildProfile,\\n  JourneyActivityItem,\\n  TodayJourneyResponse,\\n  VideoSubmissionSummary,\\n} from \'../shared/types\';\\n\\nexport type ParentTab = \'today\' | \'feedback\' | \'progress\';\\n\\ninterface ParentJourneyViewProps {\\n  activeTab: ParentTab;\\n  onChangeTab: (tab: ParentTab) => void;\\n}\\n\\nexport function ParentJourneyView({ activeTab, onChangeTab }: ParentJourneyViewProps) {\\n  const { user, locale, t } = useAuth();\\n  const [children, setChildren] = useState<ChildProfile[]>([]);\\n  const [selectedChildId, setSelectedChildId] = useState<string | null>(null);\\n  const [selectedDay, setSelectedDay] = useState<number>(1);\\n  const [journey, setJourney] = useState<TodayJourneyResponse | null>(null);\\n  const [loadingChildren, setLoadingChildren] = useState(true);\\n  const [loadingJourney, setLoadingJourney] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  // Add child inline panel\\n  const [showAddChild, setShowAddChild] = useState(false);\\n  const [newChildName, setNewChildName] = useState(\'\');\\n  const [newChildDob, setNewChildDob] = useState(() => {\\n    const d = new Date();\\n    d.setMonth(d.getMonth() - 5);\\n    return d.toISOString().slice(0, 10);\\n  });\\n  const [savingChild, setSavingChild] = useState(false);\\n\\n  // Activity Detail Studio state\\n  const [activeActivityId, setActiveActivityId] = useState<string | null>(null);\\n  const [checkedSteps, setCheckedSteps] = useState<Record<string, boolean>>({});\\n  const [reflectionNote, setReflectionNote] = useState(\'\');\\n  const [savingCompletion, setSavingCompletion] = useState(false);\\n  const [showUploader, setShowUploader] = useState(false);\\n  const [statusMessage, setStatusMessage] = useState<string | null>(null);\\n\\n  // Feedback deletion confirmation state (no window.confirm)\\n  const [confirmDeleteSubId, setConfirmDeleteSubId] = useState<string | null>(null);\\n  const [deletingVideoId, setDeletingVideoId] = useState<string | null>(null);\\n\\n  const loadChildren = useCallback(async () => {\\n    setLoadingChildren(true);\\n    try {\\n      const { children: list } = await api.listChildren();\\n      setChildren(list);\\n      if (list.length > 0) {\\n        setSelectedChildId((prev) =>\\n          prev && list.some((c) => c.id === prev) ? prev : list[0].id\\n        );\\n      } else {\\n        setSelectedChildId(null);\\n      }\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load family profiles.\');\\n    } finally {\\n      setLoadingChildren(false);\\n    }\\n  }, []);\\n\\n  const loadJourney = useCallback(async (childId: string, day?: number) => {\\n    setLoadingJourney(true);\\n    setError(null);\\n    try {\\n      const data = await api.getTodayJourney(childId, day);\\n      setJourney(data);\\n      setSelectedDay(data.selectedDay.dayNumber);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load daily journey.\');\\n    } finally {\\n      setLoadingJourney(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    void loadChildren();\\n  }, [loadChildren]);\\n\\n  useEffect(() => {\\n    if (selectedChildId) {\\n      void loadJourney(selectedChildId, selectedDay);\\n    }\\n  }, [selectedChildId, selectedDay, loadJourney]);\\n\\n  const handleCreateChild = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSavingChild(true);\\n    setError(null);\\n    try {\\n      const { child } = await api.createChild(newChildName, newChildDob);\\n      setChildren((prev) => [...prev, child]);\\n      setSelectedChildId(child.id);\\n      setSelectedDay(1);\\n      setNewChildName(\'\');\\n      setShowAddChild(false);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Could not save child profile.\');\\n    } finally {\\n      setSavingChild(false);\\n    }\\n  };\\n\\n  const activeItem: JourneyActivityItem | null =\\n    journey?.items.find((i) => i.activity.id === activeActivityId) ?? null;\\n\\n  const openActivityStudio = (item: JourneyActivityItem) => {\\n    setActiveActivityId(item.activity.id);\\n    setReflectionNote(item.completion?.caregiverNotes ?? \'\');\\n    setCheckedSteps({});\\n    setShowUploader(false);\\n    setStatusMessage(null);\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  const handleMarkCompleted = async () => {\\n    if (!journey || !activeItem) return;\\n    setSavingCompletion(true);\\n    setStatusMessage(null);\\n    try {\\n      await api.saveCompletion({\\n        childId: journey.child.id,\\n        activityId: activeItem.activity.id,\\n        status: \'completed\',\\n        caregiverNotes: reflectionNote,\\n      });\\n      setStatusMessage(\'Saved to today\342\200\231s journal.\');\\n      await loadJourney(journey.child.id, selectedDay);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to save activity progress.\');\\n    } finally {\\n      setSavingCompletion(false);\\n    }\\n  };\\n\\n  const handleVideoSubmitted = async (_submission: VideoSubmissionSummary) => {\\n    setShowUploader(false);\\n    setStatusMessage(\'Practice clip uploaded securely to your private vault and queued for review.\');\\n    if (journey) {\\n      await loadJourney(journey.child.id, selectedDay);\\n    }\\n  };\\n\\n  const handleDeleteVideo = async (submissionId: string) => {\\n    setDeletingVideoId(submissionId);\\n    setError(null);\\n    try {\\n      await api.deleteSubmissionVideo(submissionId);\\n      setConfirmDeleteSubId(null);\\n      if (journey) {\\n        await loadJourney(journey.child.id, selectedDay);\\n      }\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to delete video.\');\\n    } finally {\\n      setDeletingVideoId(null);\\n    }\\n  };\\n\\n  const previewAgeMonths = calculateAgeInMonths(newChildDob);\\n  const previewBandLabel =\\n    CANONICAL_AGE_GROUPS.find((g) => g.slug === resolveAgeGroupSlug(previewAgeMonths))?.label ??\\n    \'0\342\200\2233 months\';\\n\\n  if (loadingChildren) {\\n    return (\\n      <div className=\\\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-4\\\">\\n        <div className=\\\"h-8 w-56 bg-oat rounded animate-pulse\\\" />\\n        <div className=\\\"h-44 w-full bg-oat rounded-xl animate-pulse\\\" />\\n      </div>\\n    );\\n  }\\n\\n  // Gentle Onboarding if parent has not added a baby yet\\n  if (children.length === 0 || showAddChild) {\\n    return (\\n      <div className=\\\"max-w-xl mx-auto px-4 sm:px-6 py-12\\\">\\n        <div className=\\\"rounded-xl border border-stone bg-linen p-6 sm:p-8 space-y-6\\\">\\n          <div className=\\\"space-y-2\\\">\\n            <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">\\n              {children.length === 0 ? \'Welcome to LittleSteps\' : \'Add Another Child\'}\\n            </h1>\\n            <p className=\\\"text-sm text-olive leading-relaxed\\\">\\n              Share your baby\342\200\231s name and date of birth so we can gently match daily activities to their exact 3-month stage.\\n            </p>\\n          </div>\\n\\n          <form onSubmit={handleCreateChild} className=\\\"space-y-4\\\">\\n            <div>\\n              <label htmlFor=\\\"baby-name\\\" className=\\\"block text-sm font-medium text-ink mb-1.5\\\">\\n                Baby\342\200\231s name or nickname\\n              </label>\\n              <input\\n                id=\\\"baby-name\\\"\\n                type=\\\"text\\\"\\n                required\\n                value={newChildName}\\n                onChange={(e) => setNewChildName(e.target.value)}\\n                placeholder=\\\"e.g., Aarav or Diya\\\"\\n                className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label htmlFor=\\\"baby-dob\\\" className=\\\"block text-sm font-medium text-ink mb-1.5\\\">\\n                Date of birth\\n              </label>\\n              <input\\n                id=\\\"baby-dob\\\"\\n                type=\\\"date\\\"\\n                required\\n                max={new Date().toISOString().slice(0, 10)}\\n                value={newChildDob}\\n                onChange={(e) => setNewChildDob(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\\\"\\n              />\\n              <p className=\\\"text-xs text-olive mt-2 font-mono tabular-nums\\\">\\n                Matched stage: {previewAgeMonths} months \302\267 {previewBandLabel} age group\\n              </p>\\n            </div>\\n\\n            {error && (\\n              <p role=\\\"alert\\\" className=\\\"text-sm text-crimson bg-crimson-soft px-3.5 py-2 rounded-lg\\\">\\n                {error}\\n              </p>\\n            )}\\n\\n            <div className=\\\"flex items-center justify-end gap-3 pt-2\\\">\\n              {children.length > 0 && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddChild(false)}\\n                  className=\\\"px-4 py-2 text-sm text-olive hover:text-ink cursor-pointer\\\"\\n                >\\n                  Cancel\\n                </button>\\n              )}\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={savingChild}\\n                className=\\\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\\\"\\n              >\\n                {savingChild ? \'Preparing Journey...\' : \'Continue to Today\342\200\231s Plan\'}\\n              </button>\\n            </div>\\n          </form>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  // Activity Detail Studio View (when caregiver opens a specific daily activity)\\n  if (activeTab === \'today\' && activeItem && journey) {\\n    const act = activeItem.activity;\\n    const latestSub = activeItem.latestSubmission;\\n    const isCompleted =\\n      activeItem.completion?.status === \'completed\' ||\\n      activeItem.completion?.status === \'submitted_for_review\' ||\\n      activeItem.completion?.status === \'reviewed\';\\n\\n    return (\\n      <div className=\\\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => {\\n            setActiveActivityId(null);\\n            setShowUploader(false);\\n          }}\\n          className=\\\"inline-flex items-center gap-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\\\"\\n        >\\n          <ArrowLeft className=\\\"w-4 h-4\\\" />\\n          Back to Today\342\200\231s Journey\\n        </button>\\n\\n        {/* Clean Unboxed Metadata Header (Zero-Pill Rule) */}\\n        <div className=\\\"space-y-2\\\">\\n          <p className=\\\"text-xs text-olive\\\">\\n            {act.domainName} <span aria-hidden=\\\"true\\\">\302\267</span> {act.ageGroupLabel}{\' \'}\\n            <span aria-hidden=\\\"true\\\">\302\267</span>{\' \'}\\n            <span className=\\\"font-mono tabular-nums\\\">{act.durationMinutes} min</span>\\n          </p>\\n          <h1 className=\\\"font-serif text-3xl sm:text-4xl font-medium text-ink\\\">{act.title}</h1>\\n          <p className=\\\"text-base text-olive leading-relaxed max-w-2xl\\\">{act.summary}</p>\\n        </div>\\n\\n        {/* Interactive Step-Paced Instructional Guide */}\\n        <InstructionalGuidePlayer\\n          posterUrl={act.instructionalPosterUrl}\\n          activityTitle={act.title}\\n          steps={act.steps}\\n        />\\n\\n        {/* Materials & Safety Row */}\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n          <div className=\\\"rounded-xl border border-stone bg-linen p-5 space-y-3\\\">\\n            <h2 className=\\\"font-serif text-lg font-medium text-ink\\\">Everyday Items Needed</h2>\\n            <ul className=\\\"space-y-2 text-sm text-olive\\\">\\n              {act.materials.map((mat, i) => (\\n                <li key={i} className=\\\"flex items-start gap-2.5\\\">\\n                  <span className=\\\"font-mono text-xs text-eucalyptus mt-0.5 tabular-nums\\\">\\n                    {String(i + 1).padStart(2, \'0\')}\\n                  </span>\\n                  <span className=\\\"text-ink\\\">{mat}</span>\\n                </li>\\n              ))}\\n            </ul>\\n          </div>\\n\\n          <div className=\\\"rounded-xl border border-stone bg-ochre-soft/60 p-5 space-y-2.5\\\">\\n            <div className=\\\"flex items-center gap-2 text-ochre\\\">\\n              <ShieldAlert className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n              <h2 className=\\\"font-serif text-lg font-medium text-ink\\\">Calm Safety Reminder</h2>\\n            </div>\\n            <p className=\\\"text-sm text-ink/90 leading-relaxed\\\">{act.safetyNotes}</p>\\n          </div>\\n        </div>\\n\\n        {/* Numbered Step-by-Step Caregiver Instructions */}\\n        <section className=\\\"rounded-xl border border-stone bg-linen p-6 space-y-5\\\">\\n          <div className=\\\"flex items-center justify-between gap-4 border-b border-stone pb-3\\\">\\n            <h2 className=\\\"font-serif text-2xl font-medium text-ink\\\">Step-by-Step Guide</h2>\\n            <span className=\\\"text-xs text-olive font-mono tabular-nums\\\">\\n              {Object.values(checkedSteps).filter(Boolean).length} / {act.steps.length} steps tried\\n            </span>\\n          </div>\\n\\n          <ol className=\\\"divide-y divide-stone\\\">\\n            {act.steps.map((step) => {\\n              const checked = Boolean(checkedSteps[step.id]);\\n              return (\\n                <li key={step.id} className=\\\"py-4 first:pt-1 last:pb-1\\\">\\n                  <label className=\\\"flex items-start gap-3.5 cursor-pointer\\\">\\n                    <input\\n                      type=\\\"checkbox\\\"\\n                      checked={checked}\\n                      onChange={() =>\\n                        setCheckedSteps((prev) => ({ ...prev, [step.id]: !prev[step.id] }))\\n                      }\\n                      className=\\\"mt-1 h-4 w-4 rounded border-stone accent-eucalyptus shrink-0\\\"\\n                    />\\n                    <div className=\\\"space-y-1 flex-1\\\">\\n                      <p\\n                        className={`text-sm font-semibold ${\\n                          checked ? \'text-olive line-through\' : \'text-ink\'\\n                        }`}\\n                      >\\n                        {String(step.stepNumber).padStart(2, \'0\')}. {step.title}\\n                      </p>\\n                      <p className=\\\"text-sm text-olive leading-relaxed\\\">{step.instructionText}</p>\\n                      {step.caregiverTip && (\\n                        <p className=\\\"text-xs text-eucalyptus pt-0.5\\\">\\n                          Gentle cue: {step.caregiverTip}\\n                        </p>\\n                      )}\\n                    </div>\\n                  </label>\\n                </li>\\n              );\\n            })}\\n          </ol>\\n        </section>\\n\\n        {/* Completion & Optional Private Video Coaching */}\\n        <section className=\\\"space-y-5\\\">\\n          {statusMessage && (\\n            <div className=\\\"rounded-lg border border-eucalyptus/30 bg-eucalyptus-soft px-4 py-3 text-sm text-eucalyptus flex items-center gap-2\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n              <span>{statusMessage}</span>\\n            </div>\\n          )}\\n\\n          {!showUploader ? (\\n            <div className=\\\"rounded-xl border border-stone bg-linen p-6 space-y-4\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <h2 className=\\\"font-serif text-xl font-medium text-ink\\\">\\n                  Log Today\342\200\231s Practice or Request Caregiver Feedback\\n                </h2>\\n                <p className=\\\"text-sm text-olive\\\">\\n                  Mark this activity complete for your private journal, or share a short clip if you would like step-by-step coaching.\\n                </p>\\n              </div>\\n\\n              <div>\\n                <label\\n                  htmlFor=\\\"practice-reflection\\\"\\n                  className=\\\"block text-xs font-medium text-ink mb-1.5\\\"\\n                >\\n                  Short reflection note (optional)\\n                </label>\\n                <textarea\\n                  id=\\\"practice-reflection\\\"\\n                  rows={2}\\n                  value={reflectionNote}\\n                  onChange={(e) => setReflectionNote(e.target.value)}\\n                  placeholder=\\\"How did the pace feel today?\\\"\\n                  className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink focus:border-eucalyptus\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={savingCompletion}\\n                  onClick={() => void handleMarkCompleted()}\\n                  className=\\\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\\\"\\n                >\\n                  <Check className=\\\"w-4 h-4\\\" />\\n                  {isCompleted ? \'Update Journal Note\' : \'Mark Activity Completed\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowUploader(true)}\\n                  className=\\\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-stone bg-chalk text-ink text-sm font-medium hover:bg-oat transition-colors cursor-pointer\\\"\\n                >\\n                  <Video className=\\\"w-4 h-4 text-eucalyptus\\\" />\\n                  Record or Upload Clip for Feedback\\n                </button>\\n              </div>\\n            </div>\\n          ) : (\\n            <VideoCaptureUploader\\n              childId={journey.child.id}\\n              activityId={act.id}\\n              activityTitle={act.title}\\n              onSubmitted={handleVideoSubmitted}\\n              onCancel={() => setShowUploader(false)}\\n            />\\n          )}\\n\\n          {/* Latest Submission & Feedback Preview directly inside Activity Studio */}\\n          {latestSub && (\\n            <div className=\\\"rounded-xl border border-stone bg-oat/50 p-5 flex flex-wrap items-center justify-between gap-4\\\">\\n              <div className=\\\"space-y-1\\\">\\n                <p className=\\\"text-xs text-olive\\\">\\n                  Latest practice clip \302\267 Submitted {formatDateReadable(latestSub.createdAt, locale)}\\n                </p>\\n                <p className=\\\"text-sm font-medium text-ink\\\">\\n                  {latestSub.review\\n                    ? `Reviewed \302\267 Caregiver Instruction-Match: ${latestSub.review.instructionMatchScorePct}%`\\n                    : latestSub.reviewStatus === \'in_review\'\\n                      ? \'Currently being reviewed by your caregiver coach\'\\n                      : \'Queued privately for caregiver coaching review\'}\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setActiveActivityId(null);\\n                  onChangeTab(\'feedback\');\\n                }}\\n                className=\\\"text-sm font-medium text-eucalyptus hover:underline cursor-pointer\\\"\\n              >\\n                View in Feedback Tab\\n              </button>\\n            </div>\\n          )}\\n        </section>\\n      </div>\\n    );\\n  }\\n\\n  // Main Parent Dashboard Tabs: Today | Feedback | Progress\\n  return (\\n    <div className=\\\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\\\">\\n      {/* Calm Family Context Header */}\\n      <div className=\\\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-6\\\">\\n        <div className=\\\"space-y-1.5\\\">\\n          <p className=\\\"text-xs text-olive\\\">\\n            Good day, {user?.fullName.split(\' \')[0]}\\n            {journey && (\\n              <>\\n                {\' \'}\\n                <span aria-hidden=\\\"true\\\">\302\267</span> {journey.child.displayName}{\' \'}\\n                <span aria-hidden=\\\"true\\\">\302\267</span>{\' \'}\\n                <span className=\\\"font-mono tabular-nums\\\">{journey.child.ageInMonths} months</span>{\' \'}\\n                <span aria-hidden=\\\"true\\\">\302\267</span> {journey.child.ageGroupLabel} stage\\n              </>\\n            )}\\n          </p>\\n          <h1 className=\\\"font-serif text-3xl sm:text-4xl font-medium text-ink\\\">\\n            {activeTab === \'today\' && (journey?.selectedDay.title ?? \'Today\342\200\231s Calm Journey\')}\\n            {activeTab === \'feedback\' && \'Caregiver Coaching Feedback\'}\\n            {activeTab === \'progress\' && `${journey?.child.displayName ?? \'Baby\'}\342\200\231s Gentle Rhythm`}\\n          </h1>\\n          {activeTab === \'today\' && journey && (\\n            <p className=\\\"text-sm text-olive max-w-2xl\\\">{journey.selectedDay.focusNote}</p>\\n          )}\\n        </div>\\n\\n        {/* Child Switcher + Add Child */}\\n        <div className=\\\"flex items-center gap-2\\\">\\n          {children.length > 1 && (\\n            <select\\n              aria-label=\\\"Select child\\\"\\n              value={selectedChildId ?? \'\'}\\n              onChange={(e) => {\\n                setSelectedChildId(e.target.value);\\n                setSelectedDay(1);\\n                setActiveActivityId(null);\\n              }}\\n              className=\\\"rounded-lg border border-stone bg-linen px-3 py-2 text-sm text-ink\\\"\\n            >\\n              {children.map((c) => (\\n                <option key={c.id} value={c.id}>\\n                  {c.displayName} ({c.ageGroupLabel})\\n                </option>\\n              ))}\\n            </select>\\n          )}\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowAddChild(true)}\\n            className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-stone bg-linen text-xs font-medium text-ink hover:bg-oat transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            <Plus className=\\\"w-3.5 h-3.5\\\" />\\n            Add Child\\n          </button>\\n        </div>\\n      </div>\\n\\n      {error && (\\n        <p role=\\\"alert\\\" className=\\\"text-sm text-crimson bg-crimson-soft px-4 py-3 rounded-lg\\\">\\n          {error}\\n        </p>\\n      )}\\n\\n      {loadingJourney || !journey ? (\\n        <div className=\\\"space-y-4\\\">\\n          <div className=\\\"h-40 rounded-xl bg-oat animate-pulse\\\" />\\n          <div className=\\\"h-40 rounded-xl bg-oat animate-pulse\\\" />\\n        </div>\\n      ) : (\\n        <>\\n          {/* TAB 1: TODAY\'S CALM DAILY JOURNEY */}\\n          {activeTab === \'today\' && (\\n            <div className=\\\"space-y-6\\\">\\n              {/* Calm Day Sequence Selector */}\\n              {journey.availableDays.length > 1 && (\\n                <div className=\\\"flex items-center gap-1 p-1 rounded-lg bg-oat w-fit\\\">\\n                  {journey.availableDays.map((d) => (\\n                    <button\\n                      key={d.dayNumber}\\n                      type=\\\"button\\\"\\n                      onClick={() => setSelectedDay(d.dayNumber)}\\n                      className={`px-3.5 py-1.5 rounded-md text-xs font-medium transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                        selectedDay === d.dayNumber\\n                          ? \'bg-linen text-ink shadow-xs\'\\n                          : \'text-olive hover:text-ink\'\\n                      }`}\\n                    >\\n                      Day {d.dayNumber}\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n\\n              {/* Daily Activities List (2\342\200\2233 focused cards, zero badge clutter) */}\\n              {journey.items.length === 0 ? (\\n                <div className=\\\"rounded-xl border border-stone bg-linen p-8 text-center space-y-2\\\">\\n                  <p className=\\\"font-serif text-xl text-ink\\\">\\n                    No activities scheduled yet for {journey.child.ageGroupLabel}\\n                  </p>\\n                  <p className=\\\"text-sm text-olive\\\">\\n                    An administrator can publish activities and assign them to this age band\342\200\231s daily plan.\\n                  </p>\\n                </div>\\n              ) : (\\n                <div className=\\\"space-y-5\\\">\\n                  {journey.items.map((item, idx) => {\\n                    const statusLabel = item.latestSubmission?.review\\n                      ? `Reviewed \302\267 ${item.latestSubmission.review.instructionMatchScorePct}% instruction match`\\n                      : item.latestSubmission?.reviewStatus === \'queued\' ||\\n                          item.latestSubmission?.reviewStatus === \'in_review\'\\n                        ? \'Clip submitted \302\267 Awaiting feedback\'\\n                        : item.completion?.status === \'completed\'\\n                          ? \'Completed today\'\\n                          : \'Ready when you are\';\\n\\n                    return (\\n                      <article\\n                        key={item.planItemId}\\n                        className=\\\"rounded-xl border border-stone bg-linen overflow-hidden grid grid-cols-1 md:grid-cols-12\\\"\\n                      >\\n                        <div className=\\\"md:col-span-4 min-h-[190px]\\\">\\n                          <EditorialImage\\n                            src={item.activity.instructionalPosterUrl}\\n                            alt={item.activity.title}\\n                            aspectClassName=\\\"w-full h-full\\\"\\n                          />\\n                        </div>\\n\\n                        <div className=\\\"md:col-span-8 p-5 sm:p-6 flex flex-col justify-between gap-4\\\">\\n                          <div className=\\\"space-y-2\\\">\\n                            <p className=\\\"text-xs text-olive\\\">\\n                              <span className=\\\"font-mono tabular-nums\\\">\\n                                0{idx + 1}\\n                              </span>{\' \'}\\n                              <span aria-hidden=\\\"true\\\">\302\267</span> {item.activity.domainName}{\' \'}\\n                              <span aria-hidden=\\\"true\\\">\302\267</span>{\' \'}\\n                              <span className=\\\"font-mono tabular-nums\\\">\\n                                {item.activity.durationMinutes} min\\n                              </span>\\n                            </p>\\n                            <h2 className=\\\"font-serif text-2xl font-medium text-ink\\\">\\n                              {item.activity.title}\\n                            </h2>\\n                            <p className=\\\"text-sm text-olive leading-relaxed\\\">\\n                              {item.activity.summary}\\n                            </p>\\n                            <p className=\\\"text-xs text-olive pt-1\\\">\\n                              At home: {item.activity.materials.slice(0, 3).join(\', \')}\\n                            </p>\\n                          </div>\\n\\n                          <div className=\\\"flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-stone\\\">\\n                            <span\\n                              className={`text-xs font-medium inline-flex items-center gap-1.5 ${\\n                                item.latestSubmission?.review || item.completion?.status === \'completed\'\\n                                  ? \'text-eucalyptus\'\\n                                  : \'text-olive\'\\n                              }`}\\n                            >\\n                              {item.latestSubmission?.review || item.completion?.status === \'completed\' ? (\\n                                <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              ) : (\\n                                <Clock className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                              )}\\n                              {statusLabel}\\n                            </span>\\n\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => openActivityStudio(item)}\\n                              className=\\\"px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n                            >\\n                              Open Activity Guide\\n                            </button>\\n                          </div>\\n                        </div>\\n                      </article>\\n                    );\\n                  })}\\n                </div>\\n              )}\\n            </div>\\n          )}\\n\\n          {/* TAB 2: CAREGIVER COACHING FEEDBACK & PRIVATE VIDEO MANAGEMENT */}\\n          {activeTab === \'feedback\' && (\\n            <div className=\\\"space-y-6\\\">\\n              {/* Prominent Non-Diagnostic Safeguard Banner */}\\n              <div className=\\\"rounded-xl border border-stone bg-oat/70 p-4 flex items-start gap-3\\\">\\n                <Info className=\\\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n                <div className=\\\"text-xs text-olive leading-relaxed\\\">\\n                  <span className=\\\"font-semibold text-ink\\\">{t(\'policy.nonDiagnosticTitle\')}:</span>{\' \'}\\n                  {t(\'policy.nonDiagnosticBody\')}\\n                </div>\\n              </div>\\n\\n              {journey.recentSubmissions.length === 0 ? (\\n                <div className=\\\"rounded-xl border border-stone bg-linen p-10 text-center space-y-3\\\">\\n                  <p className=\\\"font-serif text-xl text-ink\\\">No practice clips shared yet</p>\\n                  <p className=\\\"text-sm text-olive max-w-md mx-auto\\\">\\n                    Whenever you would like warm coaching on an activity\342\200\231s steps, open any activity from Today\342\200\231s Journey and share a short private clip.\\n                  </p>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => onChangeTab(\'today\')}\\n                    className=\\\"px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors cursor-pointer\\\"\\n                  >\\n                    Go to Today\342\200\231s Journey\\n                  </button>\\n                </div>\\n              ) : (\\n                <div className=\\\"space-y-6\\\">\\n                  {journey.recentSubmissions.map((sub) => (\\n                    <article\\n                      key={sub.id}\\n                      className=\\\"rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\\\"\\n                    >\\n                      <div className=\\\"flex flex-wrap items-start justify-between gap-4 border-b border-stone pb-4\\\">\\n                        <div className=\\\"space-y-1\\\">\\n                          <p className=\\\"text-xs text-olive\\\">\\n                            {sub.domainName} <span aria-hidden=\\\"true\\\">\302\267</span> {sub.ageGroupLabel}{\' \'}\\n                            <span aria-hidden=\\\"true\\\">\302\267</span> Submitted{\' \'}\\n                            {formatDateReadable(sub.createdAt, locale)}\\n                          </p>\\n                          <h2 className=\\\"font-serif text-2xl font-medium text-ink\\\">\\n                            {sub.activityTitle}\\n                          </h2>\\n                        </div>\\n\\n                        {sub.review ? (\\n                          <div className=\\\"text-left sm:text-right\\\">\\n                            <p className=\\\"font-mono text-3xl font-medium text-eucalyptus tabular-nums\\\">\\n                              {sub.review.instructionMatchScorePct}%\\n                            </p>\\n                            <p className=\\\"text-xs text-olive\\\">Caregiver Instruction-Match</p>\\n                          </div>\\n                        ) : (\\n                          <p className=\\\"text-xs font-medium text-ochre\\\">\\n                            {sub.reviewStatus === \'in_review\'\\n                              ? \'In review with caregiver coach\'\\n                              : sub.reviewStatus === \'deleted\'\\n                                ? \'Video deleted prior to review\'\\n                                : \'Queued for caregiver review\'}\\n                          </p>\\n                        )}\\n                      </div>\\n\\n                      {/* Private Signed Video Stream or Privacy Deletion Confirmation */}\\n                      <SecureVideoPlayer\\n                        submissionId={sub.id}\\n                        hasActiveVideo={sub.hasActiveVideo}\\n                        expiresAt={sub.expiresAt}\\n                        deletionReason={sub.deletionReason}\\n                      />\\n\\n                      {/* Reviewer Coaching Breakdown */}\\n                      {sub.review && (\\n                        <div className=\\\"space-y-5 pt-1\\\">\\n                          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                            <div className=\\\"rounded-lg border border-stone bg-chalk p-4 space-y-1.5\\\">\\n                              <p className=\\\"text-xs font-semibold text-eucalyptus\\\">\\n                                What Went Well\\n                              </p>\\n                              <p className=\\\"text-sm text-ink leading-relaxed\\\">\\n                                {sub.review.strengthsNote}\\n                              </p>\\n                            </div>\\n                            <div className=\\\"rounded-lg border border-stone bg-chalk p-4 space-y-1.5\\\">\\n                              <p className=\\\"text-xs font-semibold text-ochre\\\">\\n                                Gentle Tip for Next Time\\n                              </p>\\n                              <p className=\\\"text-sm text-ink leading-relaxed\\\">\\n                                {sub.review.coachingTip}\\n                              </p>\\n                            </div>\\n                          </div>\\n\\n                          <div className=\\\"space-y-2\\\">\\n                            <h3 className=\\\"font-serif text-base font-medium text-ink\\\">\\n                              Caregiver Step Rubric Breakdown\\n                            </h3>\\n                            <div className=\\\"divide-y divide-stone border-t border-b border-stone\\\">\\n                              {sub.review.rubricScores.map((score) => (\\n                                <div\\n                                  key={score.id}\\n                                  className=\\\"py-2.5 flex flex-wrap items-center justify-between gap-3 text-sm\\\"\\n                                >\\n                                  <div>\\n                                    <p className=\\\"font-medium text-ink\\\">{score.criterionLabel}</p>\\n                                    <p className=\\\"text-xs text-olive\\\">{score.criterionDescription}</p>\\n                                  </div>\\n                                  <div className=\\\"flex items-center gap-4 text-xs font-mono tabular-nums shrink-0\\\">\\n                                    <span\\n                                      className={\\n                                        score.achievedLevel === \'met\'\\n                                          ? \'text-eucalyptus font-medium\'\\n                                          : score.achievedLevel === \'partially_met\'\\n                                            ? \'text-ochre font-medium\'\\n                                            : \'text-olive\'\\n                                      }\\n                                    >\\n                                      {score.achievedLevel === \'met\'\\n                                        ? \'Met\'\\n                                        : score.achievedLevel === \'partially_met\'\\n                                          ? \'Partially Met\'\\n                                          : \'Not Observed\'}\\n                                    </span>\\n                                    <span className=\\\"text-olive\\\">\\n                                      {score.earnedPoints}/{score.maxPoints} pts\\n                                    </span>\\n                                  </div>\\n                                </div>\\n                              ))}\\n                            </div>\\n                            <p className=\\\"text-xs text-olive pt-1\\\">\\n                              Reviewed by {sub.review.reviewerName} on{\' \'}\\n                              {formatDateReadable(sub.review.submittedAt, locale)} \302\267 Scope confirmed: caregiver execution only.\\n                            </p>\\n                          </div>\\n                        </div>\\n                      )}\\n\\n                      {/* Instant Right-to-Delete Video Control */}\\n                      {sub.hasActiveVideo && (\\n                        <div className=\\\"pt-3 border-t border-stone flex flex-wrap items-center justify-between gap-3\\\">\\n                          <span className=\\\"text-xs text-olive font-mono tabular-nums\\\">\\n                            Scheduled auto-deletion in {formatDaysUntilExpiry(sub.expiresAt)} days\\n                          </span>\\n\\n                          {confirmDeleteSubId === sub.id ? (\\n                            <div className=\\\"flex items-center gap-2\\\">\\n                              <span className=\\\"text-xs text-ink\\\">\\n                                Permanently delete video? (Feedback stays)\\n                              </span>\\n                              <button\\n                                type=\\\"button\\\"\\n                                disabled={deletingVideoId === sub.id}\\n                                onClick={() => void handleDeleteVideo(sub.id)}\\n                                className=\\\"px-3 py-1.5 rounded-lg bg-crimson text-white text-xs font-medium hover:opacity-90 cursor-pointer\\\"\\n                              >\\n                                {deletingVideoId === sub.id ? \'Deleting...\' : \'Confirm Delete\'}\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => setConfirmDeleteSubId(null)}\\n                                className=\\\"px-2.5 py-1.5 text-xs text-olive hover:text-ink cursor-pointer\\\"\\n                              >\\n                                Cancel\\n                              </button>\\n                            </div>\\n                          ) : (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => setConfirmDeleteSubId(sub.id)}\\n                              className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-crimson hover:underline cursor-pointer\\\"\\n                            >\\n                              <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                              Delete Video Now\\n                            </button>\\n                          )}\\n                        </div>\\n                      )}\\n                    </article>\\n                  ))}\\n                </div>\\n              )}\\n            </div>\\n          )}\\n\\n          {/* TAB 3: CALM SIX-DOMAIN BALANCE OVERVIEW */}\\n          {activeTab === \'progress\' && (\\n            <div className=\\\"space-y-6\\\">\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-6 space-y-5\\\">\\n                <div className=\\\"space-y-1\\\">\\n                  <h2 className=\\\"font-serif text-2xl font-medium text-ink\\\">\\n                    Activities Practiced Across All Six Domains\\n                  </h2>\\n                  <p className=\\\"text-sm text-olive\\\">\\n                    A quiet view of the everyday moments you have shared together\342\200\224never a checklist of pressure or baby grades.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"divide-y divide-stone border-t border-stone\\\">\\n                  {journey.domainProgress.map((stat) => {\\n                    const maxVal = Math.max(\\n                      3,\\n                      ...journey.domainProgress.map((d) => d.completedCount)\\n                    );\\n                    const widthPct = Math.min(100, Math.round((stat.completedCount / maxVal) * 100));\\n                    return (\\n                      <div\\n                        key={stat.domainId}\\n                        className=\\\"py-4 grid grid-cols-1 sm:grid-cols-12 items-center gap-3\\\"\\n                      >\\n                        <div className=\\\"sm:col-span-5\\\">\\n                          <p className=\\\"text-sm font-medium text-ink\\\">{stat.domainName}</p>\\n                        </div>\\n                        <div className=\\\"sm:col-span-5\\\">\\n                          <div className=\\\"h-2 rounded-full bg-oat overflow-hidden\\\">\\n                            <div\\n                              className=\\\"h-full bg-eucalyptus transition-all duration-300\\\"\\n                              style={{ width: `${widthPct}%` }}\\n                            />\\n                          </div>\\n                        </div>\\n                        <div className=\\\"sm:col-span-2 sm:text-right font-mono text-xs text-olive tabular-nums\\\">\\n                          {stat.completedCount}{\' \'}\\n                          {stat.completedCount === 1 ? \'session\' : \'sessions\'}\\n                        </div>\\n                      </div>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n        </>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ParentJourneyView covering baby onboarding with age-band calculation, calm Today\'s Journey, Activity Studio, private video upload, feedback view with instant video delete, and 6-domain balance overview.\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ParentJourneyView.tsx\", \"toolAction\":\"Creating ParentJourneyView page\", \"toolSummary\":\"Create ParentJourneyView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_330057736009128079"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useState } from \'react\';\\nimport { ArrowLeft, CheckCircle2, Info, ShieldCheck } from \'lucide-react\';\\nimport { SecureVideoPlayer } from \'../components/SecureVideoPlayer\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { api } from \'../lib/api\';\\nimport { calculateInstructionMatchScore } from \'../shared/domain\';\\nimport { formatDateTimeReadable } from \'../shared/i18n\';\\nimport type {\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewStatus,\\n} from \'../shared/types\';\\n\\nexport function ReviewerWorkbenchView() {\\n  const { ageGroups, locale } = useAuth();\\n  const [statusFilter, setStatusFilter] = useState<SubmissionReviewStatus | \'all\'>(\'all\');\\n  const [ageFilter, setAgeFilter] = useState<string>(\'all\');\\n  const [queue, setQueue] = useState<ReviewerQueueItem[]>([]);\\n  const [loadingQueue, setLoadingQueue] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  // Active workbench submission\\n  const [selectedDetail, setSelectedDetail] = useState<ReviewerSubmissionDetail | null>(null);\\n  const [loadingDetail, setLoadingDetail] = useState(false);\\n\\n  // Rubric state\\n  const [ratings, setRatings] = useState<Record<string, RubricAchievementLevel>>({});\\n  const [strengthsNote, setStrengthsNote] = useState(\'\');\\n  const [coachingTip, setCoachingTip] = useState(\'\');\\n  const [scopeAcknowledged, setScopeAcknowledged] = useState(false);\\n  const [submittingReview, setSubmittingReview] = useState(false);\\n  const [submitSuccess, setSubmitSuccess] = useState<string | null>(null);\\n\\n  const loadQueue = useCallback(async () => {\\n    setLoadingQueue(true);\\n    setError(null);\\n    try {\\n      const { queue: rows } = await api.getReviewerQueue(statusFilter, ageFilter);\\n      setQueue(rows);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load review queue.\');\\n    } finally {\\n      setLoadingQueue(false);\\n    }\\n  }, [statusFilter, ageFilter]);\\n\\n  useEffect(() => {\\n    void loadQueue();\\n  }, [loadQueue]);\\n\\n  const hydrateDetailForm = (detail: ReviewerSubmissionDetail) => {\\n    setSelectedDetail(detail);\\n    setSubmitSuccess(null);\\n    setError(null);\\n    const nextRatings: Record<string, RubricAchievementLevel> = {};\\n    if (detail.review) {\\n      for (const s of detail.review.rubricScores) {\\n        nextRatings[s.criterionId] = s.achievedLevel;\\n      }\\n      setStrengthsNote(detail.review.strengthsNote);\\n      setCoachingTip(detail.review.coachingTip);\\n      setScopeAcknowledged(true);\\n    } else {\\n      for (const c of detail.activity.rubricCriteria) {\\n        nextRatings[c.id] = \'met\';\\n      }\\n      setStrengthsNote(\'\');\\n      setCoachingTip(\'\');\\n      setScopeAcknowledged(false);\\n    }\\n    setRatings(nextRatings);\\n  };\\n\\n  const openSubmission = async (item: ReviewerQueueItem) => {\\n    setLoadingDetail(true);\\n    setError(null);\\n    try {\\n      const detail =\\n        item.reviewStatus === \'queued\'\\n          ? await api.claimSubmission(item.submissionId)\\n          : await api.getReviewerSubmissionDetail(item.submissionId);\\n      hydrateDetailForm(detail);\\n    } catch (err) {\\n      // Fallback to read-only detail if already claimed\\n      try {\\n        const detail = await api.getReviewerSubmissionDetail(item.submissionId);\\n        hydrateDetailForm(detail);\\n      } catch {\\n        setError(err instanceof Error ? err.message : \'Unable to open submission.\');\\n      }\\n    } finally {\\n      setLoadingDetail(false);\\n    }\\n  };\\n\\n  const handleReviewSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!selectedDetail) return;\\n    setError(null);\\n    setSubmittingReview(true);\\n    try {\\n      const criterionRatings = selectedDetail.activity.rubricCriteria.map((c) => ({\\n        criterionId: c.id,\\n        achievedLevel: ratings[c.id] ?? \'not_observed\',\\n      }));\\n\\n      await api.submitReview(selectedDetail.submission.submissionId, {\\n        strengthsNote,\\n        coachingTip,\\n        evaluationScopeAcknowledged: true,\\n        criterionRatings,\\n      });\\n\\n      const refreshed = await api.getReviewerSubmissionDetail(\\n        selectedDetail.submission.submissionId\\n      );\\n      hydrateDetailForm(refreshed);\\n      setSubmitSuccess(\'Caregiver coaching feedback published.\');\\n      await loadQueue();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to submit review.\');\\n    } finally {\\n      setSubmittingReview(false);\\n    }\\n  };\\n\\n  // Split-Screen Evaluation Workbench\\n  if (selectedDetail) {\\n    const { submission, activity } = selectedDetail;\\n    const liveScore = calculateInstructionMatchScore(\\n      activity.rubricCriteria.map((c) => ({\\n        weightPoints: c.weightPoints,\\n        achievedLevel: ratings[c.id] ?? \'not_observed\',\\n      }))\\n    );\\n\\n    const canSubmit =\\n      scopeAcknowledged &&\\n      strengthsNote.trim().length >= 10 &&\\n      coachingTip.trim().length >= 10 &&\\n      !submittingReview;\\n\\n    return (\\n      <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-4\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setSelectedDetail(null);\\n              void loadQueue();\\n            }}\\n            className=\\\"inline-flex items-center gap-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4\\\" />\\n            Back to Review Queue\\n          </button>\\n\\n          <p className=\\\"text-xs text-olive font-mono tabular-nums\\\">\\n            Submission {submission.submissionId} \302\267 Age band: {submission.ageGroupLabel} \302\267 Parent PII hidden\\n          </p>\\n        </div>\\n\\n        {/* Non-Diagnostic Policy Header */}\\n        <div className=\\\"rounded-xl border border-stone bg-oat/70 px-4 py-3 flex items-start gap-3\\\">\\n          <ShieldCheck className=\\\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n          <p className=\\\"text-xs text-olive leading-relaxed\\\">\\n            <strong className=\\\"text-ink\\\">Reviewer Mandate:</strong> Evaluate only the caregiver\342\200\231s demonstration of activity steps, safety setup, and calm pacing. Never assess or comment on the baby\342\200\231s intelligence, developmental level, or medical health.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n          {/* Left Zone (60%): Secure Video Stream + Activity Guidelines Reference */}\\n          <div className=\\\"lg:col-span-7 space-y-5\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"text-xs text-olive\\\">\\n                {submission.domainName} <span aria-hidden=\\\"true\\\">\302\267</span> {submission.ageGroupLabel}\\n              </p>\\n              <h1 className=\\\"font-serif text-2xl sm:text-3xl font-medium text-ink\\\">\\n                {activity.title}\\n              </h1>\\n            </div>\\n\\n            <SecureVideoPlayer\\n              submissionId={submission.submissionId}\\n              hasActiveVideo={submission.hasActiveVideo}\\n              expiresAt={submission.expiresAt}\\n              deletionReason={submission.deletionReason}\\n            />\\n\\n            {submission.caregiverNotes && (\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4 space-y-1\\\">\\n                <p className=\\\"text-xs font-semibold text-olive\\\">Caregiver Note</p>\\n                <p className=\\\"text-sm text-ink\\\">{submission.caregiverNotes}</p>\\n              </div>\\n            )}\\n\\n            {/* Activity Steps Reference */}\\n            <div className=\\\"rounded-xl border border-stone bg-linen p-5 space-y-3\\\">\\n              <h2 className=\\\"font-serif text-lg font-medium text-ink\\\">\\n                Activity Instructions Reference\\n              </h2>\\n              <ol className=\\\"divide-y divide-stone\\\">\\n                {activity.steps.map((s) => (\\n                  <li key={s.id} className=\\\"py-3 first:pt-0 last:pb-0 text-sm\\\">\\n                    <p className=\\\"font-medium text-ink\\\">\\n                      {String(s.stepNumber).padStart(2, \'0\')}. {s.title}\\n                    </p>\\n                    <p className=\\\"text-olive text-xs mt-0.5 leading-relaxed\\\">{s.instructionText}</p>\\n                  </li>\\n                ))}\\n              </ol>\\n              <p className=\\\"text-xs text-ochre pt-2 border-t border-stone\\\">\\n                Safety note: {activity.safetyNotes}\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Right Zone (40%): Weighted Caregiver Execution Rubric */}\\n          <form\\n            onSubmit={handleReviewSubmit}\\n            className=\\\"lg:col-span-5 rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\\\"\\n          >\\n            <div className=\\\"flex items-end justify-between gap-4 border-b border-stone pb-4\\\">\\n              <div>\\n                <h2 className=\\\"font-serif text-xl font-medium text-ink\\\">\\n                  Caregiver Execution Rubric\\n                </h2>\\n                <p className=\\\"text-xs text-olive mt-0.5\\\">Weighted instruction-match score</p>\\n              </div>\\n              <div className=\\\"text-right\\\">\\n                <p className=\\\"font-mono text-3xl font-medium text-eucalyptus tabular-nums\\\">\\n                  {liveScore.scorePct}%\\n                </p>\\n                <p className=\\\"font-mono text-[11px] text-olive tabular-nums\\\">\\n                  {liveScore.earnedTotal}/{liveScore.maxTotal} pts\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-4\\\">\\n              {activity.rubricCriteria.map((criterion) => {\\n                const current = ratings[criterion.id] ?? \'not_observed\';\\n                return (\\n                  <div\\n                    key={criterion.id}\\n                    className=\\\"rounded-lg border border-stone bg-chalk p-3.5 space-y-2.5\\\"\\n                  >\\n                    <div className=\\\"flex items-start justify-between gap-2\\\">\\n                      <div>\\n                        <p className=\\\"text-sm font-medium text-ink\\\">{criterion.label}</p>\\n                        <p className=\\\"text-xs text-olive mt-0.5\\\">{criterion.description}</p>\\n                      </div>\\n                      <span className=\\\"font-mono text-xs text-olive tabular-nums shrink-0\\\">\\n                        {criterion.weightPoints} pts\\n                      </span>\\n                    </div>\\n\\n                    <div className=\\\"grid grid-cols-3 gap-1 p-1 rounded-lg bg-oat\\\">\\n                      {(\\n                        [\\n                          { id: \'met\', label: \'Met\' },\\n                          { id: \'partially_met\', label: \'Partial\' },\\n                          { id: \'not_observed\', label: \'Not Seen\' },\\n                        ] as const\\n                      ).map((opt) => (\\n                        <button\\n                          key={opt.id}\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            setRatings((prev) => ({ ...prev, [criterion.id]: opt.id }))\\n                          }\\n                          className={`py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\\n                            current === opt.id\\n                              ? \'bg-linen text-ink shadow-xs\'\\n                              : \'text-olive hover:text-ink\'\\n                          }`}\\n                        >\\n                          {opt.label}\\n                        </button>\\n                      ))}\\n                    </div>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n\\n            <div className=\\\"space-y-3 pt-2 border-t border-stone\\\">\\n              <div>\\n                <label htmlFor=\\\"rev-strengths\\\" className=\\\"block text-xs font-medium text-ink mb-1\\\">\\n                  What went well (warm, specific observation)\\n                </label>\\n                <textarea\\n                  id=\\\"rev-strengths\\\"\\n                  required\\n                  minLength={10}\\n                  rows={3}\\n                  value={strengthsNote}\\n                  onChange={(e) => setStrengthsNote(e.target.value)}\\n                  placeholder=\\\"Highlight specific caregiver steps demonstrated warmly...\\\"\\n                  className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink focus:border-eucalyptus\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label htmlFor=\\\"rev-tip\\\" className=\\\"block text-xs font-medium text-ink mb-1\\\">\\n                  One practical tip for next time\\n                </label>\\n                <textarea\\n                  id=\\\"rev-tip\\\"\\n                  required\\n                  minLength={10}\\n                  rows={3}\\n                  value={coachingTip}\\n                  onChange={(e) => setCoachingTip(e.target.value)}\\n                  placeholder=\\\"Share one gentle adjustment for the caregiver\342\200\231s next session...\\\"\\n                  className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink focus:border-eucalyptus\\\"\\n                />\\n              </div>\\n\\n              <label className=\\\"flex items-start gap-2.5 text-xs text-ink pt-1 cursor-pointer\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={scopeAcknowledged}\\n                  onChange={(e) => setScopeAcknowledged(e.target.checked)}\\n                  className=\\\"mt-0.5 h-4 w-4 rounded border-stone accent-eucalyptus\\\"\\n                />\\n                <span>\\n                  I confirm this score and written feedback evaluate only the caregiver\342\200\231s activity execution\342\200\224not the baby\342\200\231s intelligence, developmental level, or health.\\n                </span>\\n              </label>\\n            </div>\\n\\n            {error && (\\n              <p role=\\\"alert\\\" className=\\\"text-xs text-crimson bg-crimson-soft px-3 py-2 rounded-lg\\\">\\n                {error}\\n              </p>\\n            )}\\n\\n            {submitSuccess && (\\n              <p className=\\\"text-xs text-eucalyptus bg-eucalyptus-soft px-3 py-2 rounded-lg flex items-center gap-1.5\\\">\\n                <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n                {submitSuccess}\\n              </p>\\n            )}\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={!canSubmit}\\n              className=\\\"w-full px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-45 transition-colors cursor-pointer\\\"\\n            >\\n              {submittingReview\\n                ? \'Publishing Feedback...\'\\n                : selectedDetail.review\\n                  ? \'Update Caregiver Feedback\'\\n                  : \'Publish Caregiver Feedback\'}\\n            </button>\\n          </form>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  // Queue Overview Screen\\n  return (\\n    <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\\\">\\n      <div className=\\\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-5\\\">\\n        <div className=\\\"space-y-1\\\">\\n          <p className=\\\"text-xs text-olive\\\">Reviewer Workbench \302\267 Minimized PII queue</p>\\n          <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">Caregiver Clip Review Queue</h1>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n          <div className=\\\"flex items-center gap-1 p-1 rounded-lg bg-oat\\\">\\n            {(\\n              [\\n                { id: \'all\', label: \'All\' },\\n                { id: \'queued\', label: \'Queued\' },\\n                { id: \'in_review\', label: \'In Review\' },\\n                { id: \'reviewed\', label: \'Reviewed\' },\\n              ] as const\\n            ).map((tab) => (\\n              <button\\n                key={tab.id}\\n                type=\\\"button\\\"\\n                onClick={() => setStatusFilter(tab.id)}\\n                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  statusFilter === tab.id\\n                    ? \'bg-linen text-ink shadow-xs\'\\n                    : \'text-olive hover:text-ink\'\\n                }`}\\n              >\\n                {tab.label}\\n              </button>\\n            ))}\\n          </div>\\n\\n          <select\\n            aria-label=\\\"Filter by age band\\\"\\n            value={ageFilter}\\n            onChange={(e) => setAgeFilter(e.target.value)}\\n            className=\\\"rounded-lg border border-stone bg-linen px-3 py-2 text-xs font-medium text-ink\\\"\\n          >\\n            <option value=\\\"all\\\">All age groups</option>\\n            {ageGroups.map((ag) => (\\n              <option key={ag.id} value={ag.slug}>\\n                {ag.label}\\n              </option>\\n            ))}\\n          </select>\\n        </div>\\n      </div>\\n\\n      <div className=\\\"rounded-xl border border-stone bg-oat/70 p-4 flex items-start gap-2.5 text-xs text-olive\\\">\\n        <Info className=\\\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n        <span>\\n          Parent contact information is hidden by design. Every video stream opened is recorded in the privacy audit log.\\n        </span>\\n      </div>\\n\\n      {error && (\\n        <p role=\\\"alert\\\" className=\\\"text-sm text-crimson bg-crimson-soft px-4 py-3 rounded-lg\\\">\\n          {error}\\n        </p>\\n      )}\\n\\n      {loadingQueue || loadingDetail ? (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"h-14 rounded-lg bg-oat animate-pulse\\\" />\\n          <div className=\\\"h-14 rounded-lg bg-oat animate-pulse\\\" />\\n        </div>\\n      ) : queue.length === 0 ? (\\n        <div className=\\\"rounded-xl border border-stone bg-linen p-10 text-center space-y-2\\\">\\n          <p className=\\\"font-serif text-xl text-ink\\\">No clips matching this filter</p>\\n          <p className=\\\"text-sm text-olive max-w-md mx-auto\\\">\\n            When a caregiver uploads or records an activity clip from the Parent Journey, it will appear here immediately for rubric evaluation.\\n          </p>\\n        </div>\\n      ) : (\\n        <div className=\\\"rounded-xl border border-stone bg-linen overflow-x-auto\\\">\\n          <table className=\\\"w-full text-left border-collapse\\\">\\n            <thead>\\n              <tr className=\\\"border-b border-stone text-xs font-medium text-olive\\\">\\n                <th className=\\\"py-3 px-4\\\">Activity & Domain</th>\\n                <th className=\\\"py-3 px-4\\\">Age Band</th>\\n                <th className=\\\"py-3 px-4\\\">Submitted</th>\\n                <th className=\\\"py-3 px-4\\\">Status</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Match Score</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Action</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-stone text-sm\\\">\\n              {queue.map((item) => (\\n                <tr key={item.submissionId} className=\\\"hover:bg-chalk/70 transition-colors\\\">\\n                  <td className=\\\"py-3.5 px-4\\\">\\n                    <p className=\\\"font-medium text-ink\\\">{item.activityTitle}</p>\\n                    <p className=\\\"text-xs text-olive\\\">{item.domainName}</p>\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 font-mono text-xs text-ink tabular-nums whitespace-nowrap\\\">\\n                    {item.ageGroupLabel}\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 font-mono text-xs text-olive tabular-nums whitespace-nowrap\\\">\\n                    {formatDateTimeReadable(item.createdAt, locale)}\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 text-xs whitespace-nowrap\\\">\\n                    <span\\n                      className={\\n                        item.reviewStatus === \'reviewed\'\\n                          ? \'text-eucalyptus font-medium\'\\n                          : item.reviewStatus === \'in_review\'\\n                            ? \'text-ochre font-medium\'\\n                            : \'text-ink font-medium\'\\n                      }\\n                    >\\n                      {item.reviewStatus === \'queued\'\\n                        ? \'Queued\'\\n                        : item.reviewStatus === \'in_review\'\\n                          ? \'In Review\'\\n                          : \'Reviewed\'}\\n                    </span>\\n                    {!item.hasActiveVideo && (\\n                      <span className=\\\"text-olive\\\"> \302\267 Video deleted</span>\\n                    )}\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 text-right font-mono text-xs tabular-nums\\\">\\n                    {item.instructionMatchScorePct !== null\\n                      ? `${item.instructionMatchScorePct}%`\\n                      : \'\342\200\224\'}\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 text-right whitespace-nowrap\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => void openSubmission(item)}\\n                      className=\\\"px-3.5 py-1.5 rounded-lg border border-stone bg-chalk text-xs font-medium text-ink hover:bg-oat transition-colors cursor-pointer\\\"\\n                    >\\n                      {item.reviewStatus === \'queued\'\\n                        ? \'Claim & Review\'\\n                        : item.reviewStatus === \'in_review\'\\n                          ? \'Continue Review\'\\n                          : \'View Review\'}\\n                    </button>\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ReviewerWorkbenchView with PII-minimized review queue, split-screen secure video & reference guidelines, weighted caregiver execution rubric, and mandatory non-diagnostic attestation.\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ReviewerWorkbenchView.tsx\", \"toolAction\":\"Creating ReviewerWorkbenchView page\", \"toolSummary\":\"Create ReviewerWorkbenchView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_330057736009129132"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useState } from \'react\';\\nimport { Plus, RefreshCw, Trash2 } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { api } from \'../lib/api\';\\nimport { EDITORIAL_IMAGES } from \'../shared/domain\';\\nimport { formatDateTimeReadable } from \'../shared/i18n\';\\nimport type {\\n  ActivityStatus,\\n  ActivitySummary,\\n  AdminOverviewResponse,\\n  MediaAuditLogItem,\\n  UserProfile,\\n  UserRole,\\n} from \'../shared/types\';\\n\\nexport type AdminTab = \'curriculum\' | \'plans\' | \'users\' | \'privacy\';\\n\\ninterface AdminConsoleViewProps {\\n  activeTab: AdminTab;\\n}\\n\\nconst POSTER_OPTIONS = [\\n  { label: \'Sunlit Floor Mat & Wooden Toys\', url: EDITORIAL_IMAGES.heroMontessori },\\n  { label: \'Everyday Household Textures (Katori & Linen)\', url: EDITORIAL_IMAGES.sensoryLinen },\\n  { label: \'Low Montessori Floor Mirror\', url: EDITORIAL_IMAGES.tummyMirror },\\n  { label: \'Open Steel Cup & Wooden Stacker\', url: EDITORIAL_IMAGES.everydayCup },\\n];\\n\\nexport function AdminConsoleView({ activeTab }: AdminConsoleViewProps) {\\n  const { ageGroups, learningDomains, locale } = useAuth();\\n  const [overview, setOverview] = useState<AdminOverviewResponse | null>(null);\\n  const [activities, setActivities] = useState<ActivitySummary[]>([]);\\n  const [filterAgeId, setFilterAgeId] = useState<string>(\'\');\\n  const [filterDomainId, setFilterDomainId] = useState<string>(\'\');\\n  const [users, setUsers] = useState<UserProfile[]>([]);\\n  const [auditLogs, setAuditLogs] = useState<MediaAuditLogItem[]>([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n  const [notice, setNotice] = useState<string | null>(null);\\n\\n  // Activity Editor state\\n  const [showActivityForm, setShowActivityForm] = useState(false);\\n  const [editingActivityId, setEditingActivityId] = useState<string | null>(null);\\n  const [formAgeGroupId, setFormAgeGroupId] = useState(\'\');\\n  const [formDomainId, setFormDomainId] = useState(\'\');\\n  const [formTitle, setFormTitle] = useState(\'\');\\n  const [formSummary, setFormSummary] = useState(\'\');\\n  const [formDuration, setFormDuration] = useState(5);\\n  const [formMaterialsText, setFormMaterialsText] = useState(\'\');\\n  const [formSafety, setFormSafety] = useState(\'\');\\n  const [formPoster, setFormPoster] = useState<string>(EDITORIAL_IMAGES.sensoryLinen);\\n  const [formStatus, setFormStatus] = useState<ActivityStatus>(\'published\');\\n  const [formSteps, setFormSteps] = useState<\\n    Array<{ title: string; instructionText: string; caregiverTip: string }>\\n  >([\\n    { title: \'Prepare calm floor space\', instructionText: \'\', caregiverTip: \'\' },\\n    { title: \'Demonstrate slowly\', instructionText: \'\', caregiverTip: \'\' },\\n  ]);\\n  const [formRubric, setFormRubric] = useState<\\n    Array<{ label: string; description: string; weightPoints: number }>\\n  >([\\n    { label: \'Calm, safe setup\', description: \'Caregiver prepared safe household items on a clear mat.\', weightPoints: 50 },\\n    { label: \'Unhurried pacing & cueing\', description: \'Caregiver spoke calmly and paused for baby\342\200\231s cues.\', weightPoints: 50 },\\n  ]);\\n  const [savingActivity, setSavingActivity] = useState(false);\\n\\n  // Daily Plan Editor state\\n  const [planAgeGroupId, setPlanAgeGroupId] = useState(\'ag_6-9m\');\\n  const [planDayNumber, setPlanDayNumber] = useState(1);\\n  const [planTitle, setPlanTitle] = useState(\'Day 1 \302\267 Gentle Discovery\');\\n  const [planFocusNote, setPlanFocusNote] = useState(\\n    \'Take 10 calm minutes across today. Pause whenever baby wants to rest.\'\\n  );\\n  const [planSelectedActivityIds, setPlanSelectedActivityIds] = useState<string[]>([]);\\n  const [planAgeActivities, setPlanAgeActivities] = useState<ActivitySummary[]>([]);\\n  const [existingPlans, setExistingPlans] = useState<\\n    Array<{ id: string; dayNumber: number; title: string; focusNote: string; activityIds: string[] }>\\n  >([]);\\n  const [savingPlan, setSavingPlan] = useState(false);\\n\\n  // Retention sweep state\\n  const [sweeping, setSweeping] = useState(false);\\n\\n  const loadCurriculumData = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const [ov, acts] = await Promise.all([\\n        api.getAdminOverview(),\\n        api.getAdminActivities(filterAgeId || undefined, filterDomainId || undefined),\\n      ]);\\n      setOverview(ov);\\n      setActivities(acts.activities);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load admin overview.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [filterAgeId, filterDomainId]);\\n\\n  const loadPlansData = useCallback(async (ageId: string) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const data = await api.getAdminDailyPlans(ageId);\\n      setExistingPlans(data.plans);\\n      setPlanAgeActivities(data.activities);\\n      const first = data.plans[0];\\n      if (first) {\\n        setPlanDayNumber(first.dayNumber);\\n        setPlanTitle(first.title);\\n        setPlanFocusNote(first.focusNote);\\n        setPlanSelectedActivityIds(first.activityIds);\\n      } else {\\n        setPlanDayNumber(1);\\n        setPlanTitle(\'Day 1 \302\267 Calm Discovery\');\\n        setPlanFocusNote(\'Two calm, everyday activities matched to this age band.\');\\n        setPlanSelectedActivityIds(data.activities.slice(0, 2).map((a) => a.id));\\n      }\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load daily plans.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  const loadUsersData = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const { users: list } = await api.getAdminUsers();\\n      setUsers(list);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load users.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  const loadPrivacyData = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const [ov, logs] = await Promise.all([api.getAdminOverview(), api.getAdminAuditLogs()]);\\n      setOverview(ov);\\n      setAuditLogs(logs.logs);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load audit logs.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    setNotice(null);\\n    if (activeTab === \'curriculum\') void loadCurriculumData();\\n    if (activeTab === \'plans\') void loadPlansData(planAgeGroupId);\\n    if (activeTab === \'users\') void loadUsersData();\\n    if (activeTab === \'privacy\') void loadPrivacyData();\\n  }, [activeTab, loadCurriculumData, loadPlansData, loadUsersData, loadPrivacyData, planAgeGroupId]);\\n\\n  const openNewActivityForm = () => {\\n    setEditingActivityId(null);\\n    setFormAgeGroupId(filterAgeId || ageGroups[0]?.id || \'ag_0-3m\');\\n    setFormDomainId(filterDomainId || learningDomains[0]?.id || \'dom_cognitive\');\\n    setFormTitle(\'\');\\n    setFormSummary(\'\');\\n    setFormDuration(5);\\n    setFormMaterialsText(\'Woven cotton mat\\\\nSmooth wooden spoon\');\\n    setFormSafety(\'Supervise closely on a clean, firm floor mat away from hard edges.\');\\n    setFormPoster(EDITORIAL_IMAGES.sensoryLinen);\\n    setFormStatus(\'published\');\\n    setFormSteps([\\n      {\\n        title: \'Prepare a calm space\',\\n        instructionText: \'Lay out 2\342\200\2233 safe household objects neatly on a cotton mat.\',\\n        caregiverTip: \'Keep the surroundings uncluttered.\',\\n      },\\n      {\\n        title: \'Guide gently and pause\',\\n        instructionText: \'Name each object softly and pause 5 seconds for baby\342\200\231s response.\',\\n        caregiverTip: \'Follow baby\342\200\231s pace without rushing.\',\\n      },\\n    ]);\\n    setFormRubric([\\n      {\\n        label: \'Calm, uncluttered setup\',\\n        description: \'Caregiver prepared safe materials on a clear floor surface.\',\\n        weightPoints: 50,\\n      },\\n      {\\n        label: \'Responsive caregiver pacing\',\\n        description: \'Caregiver spoke calmly and paused without rushing baby.\',\\n        weightPoints: 50,\\n      },\\n    ]);\\n    setShowActivityForm(true);\\n    setError(null);\\n  };\\n\\n  const openEditActivityForm = async (activityId: string) => {\\n    setError(null);\\n    try {\\n      const { activity } = await api.getAdminActivityDetail(activityId);\\n      setEditingActivityId(activity.id);\\n      setFormAgeGroupId(activity.ageGroupId);\\n      setFormDomainId(activity.domainId);\\n      setFormTitle(activity.title);\\n      setFormSummary(activity.summary);\\n      setFormDuration(activity.durationMinutes);\\n      setFormMaterialsText(activity.materials.join(\'\\\\n\'));\\n      setFormSafety(activity.safetyNotes);\\n      setFormPoster(activity.instructionalPosterUrl);\\n      setFormStatus(activity.status);\\n      setFormSteps(\\n        activity.steps.map((s) => ({\\n          title: s.title,\\n          instructionText: s.instructionText,\\n          caregiverTip: s.caregiverTip ?? \'\',\\n        }))\\n      );\\n      setFormRubric(\\n        activity.rubricCriteria.map((c) => ({\\n          label: c.label,\\n          description: c.description,\\n          weightPoints: c.weightPoints,\\n        }))\\n      );\\n      setShowActivityForm(true);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load activity details.\');\\n    }\\n  };\\n\\n  const rubricWeightTotal = formRubric.reduce((sum, r) => sum + Number(r.weightPoints || 0), 0);\\n\\n  const handleSaveActivity = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (rubricWeightTotal !== 100) {\\n      setError(`Rubric weights must sum to exactly 100 points (currently ${rubricWeightTotal}).`);\\n      return;\\n    }\\n    setSavingActivity(true);\\n    try {\\n      const materials = formMaterialsText\\n        .split(\'\\\\n\')\\n        .map((m) => m.trim())\\n        .filter(Boolean);\\n      await api.saveAdminActivity(editingActivityId, {\\n        ageGroupId: formAgeGroupId,\\n        domainId: formDomainId,\\n        title: formTitle,\\n        summary: formSummary,\\n        durationMinutes: formDuration,\\n        materials: materials.length > 0 ? materials : [\'Clean cotton floor mat\'],\\n        safetyNotes: formSafety,\\n        instructionalPosterUrl: formPoster,\\n        status: formStatus,\\n        steps: formSteps,\\n        rubricCriteria: formRubric,\\n      });\\n      setShowActivityForm(false);\\n      setNotice(editingActivityId ? \'Activity updated.\' : \'New activity published to curriculum.\');\\n      await loadCurriculumData();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to save activity.\');\\n    } finally {\\n      setSavingActivity(false);\\n    }\\n  };\\n\\n  const handleSaveDailyPlan = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSavingPlan(true);\\n    setError(null);\\n    try {\\n      const { plans } = await api.saveAdminDailyPlan({\\n        ageGroupId: planAgeGroupId,\\n        dayNumber: planDayNumber,\\n        title: planTitle,\\n        focusNote: planFocusNote,\\n        activityIds: planSelectedActivityIds,\\n      });\\n      setExistingPlans(plans);\\n      setNotice(`Saved Day ${planDayNumber} plan.`);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to save daily plan.\');\\n    } finally {\\n      setSavingPlan(false);\\n    }\\n  };\\n\\n  const handleRoleUpdate = async (userId: string, role: UserRole) => {\\n    setError(null);\\n    try {\\n      await api.updateAdminUser(userId, { role });\\n      setNotice(\'Account role updated.\');\\n      await loadUsersData();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to update role.\');\\n    }\\n  };\\n\\n  const handleRunRetentionSweep = async () => {\\n    setSweeping(true);\\n    setError(null);\\n    try {\\n      const res = await api.runAdminRetentionSweep();\\n      setNotice(`30-day retention sweep completed \302\267 ${res.purgedCount} expired videos purged.`);\\n      await loadPrivacyData();\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to run retention sweep.\');\\n    } finally {\\n      setSweeping(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\\\">\\n      {notice && (\\n        <div className=\\\"rounded-lg border border-eucalyptus/30 bg-eucalyptus-soft px-4 py-2.5 text-sm text-eucalyptus\\\">\\n          {notice}\\n        </div>\\n      )}\\n      {error && (\\n        <div role=\\\"alert\\\" className=\\\"rounded-lg bg-crimson-soft px-4 py-2.5 text-sm text-crimson\\\">\\n          {error}\\n        </div>\\n      )}\\n\\n      {/* TAB 1: CURRICULUM MATRIX & ACTIVITY CMS */}\\n      {activeTab === \'curriculum\' && (\\n        <div className=\\\"space-y-8\\\">\\n          <div className=\\\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-5\\\">\\n            <div>\\n              <p className=\\\"text-xs text-olive\\\">Admin Console \302\267 8 Age Groups \303\227 6 Domains</p>\\n              <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">Curriculum Management</h1>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={openNewActivityForm}\\n              className=\\\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n            >\\n              <Plus className=\\\"w-4 h-4\\\" />\\n              New Activity\\n            </button>\\n          </div>\\n\\n          {/* High-Level Operational Metrics Strip */}\\n          {overview && (\\n            <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Published Activities</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.publishedActivities}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Queued / In Review</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.queuedSubmissions}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Active Vault Videos</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.activeVideosCount}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Parents / Reviewers</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.totalParents} / {overview.counts.totalReviewers}\\n                </p>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* Create / Edit Activity Form */}\\n          {showActivityForm && (\\n            <form\\n              onSubmit={handleSaveActivity}\\n              className=\\\"rounded-xl border border-stone bg-linen p-6 space-y-5\\\"\\n            >\\n              <div className=\\\"flex items-center justify-between border-b border-stone pb-3\\\">\\n                <h2 className=\\\"font-serif text-2xl font-medium text-ink\\\">\\n                  {editingActivityId ? \'Edit Activity & Caregiver Rubric\' : \'Create Activity\'}\\n                </h2>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowActivityForm(false)}\\n                  className=\\\"text-sm text-olive hover:text-ink cursor-pointer\\\"\\n                >\\n                  Close\\n                </button>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Age Group</label>\\n                  <select\\n                    value={formAgeGroupId}\\n                    onChange={(e) => setFormAgeGroupId(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink\\\"\\n                  >\\n                    {ageGroups.map((ag) => (\\n                      <option key={ag.id} value={ag.id}>\\n                        {ag.label}\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Learning Domain</label>\\n                  <select\\n                    value={formDomainId}\\n                    onChange={(e) => setFormDomainId(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink\\\"\\n                  >\\n                    {learningDomains.map((d) => (\\n                      <option key={d.id} value={d.id}>\\n                        {d.name}\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Minutes</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={1}\\n                      max={30}\\n                      value={formDuration}\\n                      onChange={(e) => setFormDuration(Number(e.target.value))}\\n                      className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink font-mono tabular-nums\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Status</label>\\n                    <select\\n                      value={formStatus}\\n                      onChange={(e) => setFormStatus(e.target.value as ActivityStatus)}\\n                      className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink\\\"\\n                    >\\n                      <option value=\\\"published\\\">Published</option>\\n                      <option value=\\\"draft\\\">Draft</option>\\n                      <option value=\\\"archived\\\">Archived</option>\\n                    </select>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Activity Title</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={formTitle}\\n                    onChange={(e) => setFormTitle(e.target.value)}\\n                    placeholder=\\\"e.g., Gentle Cotton Cloth Peek-a-Boo\\\"\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Editorial Visual</label>\\n                  <select\\n                    value={formPoster}\\n                    onChange={(e) => setFormPoster(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink\\\"\\n                  >\\n                    {POSTER_OPTIONS.map((p) => (\\n                      <option key={p.url} value={p.url}>\\n                        {p.label}\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Calm One-Line Summary</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={formSummary}\\n                  onChange={(e) => setFormSummary(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">\\n                    Everyday Household Materials (one per line)\\n                  </label>\\n                  <textarea\\n                    rows={3}\\n                    value={formMaterialsText}\\n                    onChange={(e) => setFormMaterialsText(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Safety Notes</label>\\n                  <textarea\\n                    rows={3}\\n                    required\\n                    value={formSafety}\\n                    onChange={(e) => setFormSafety(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              {/* Dynamic Steps */}\\n              <div className=\\\"space-y-3 border-t border-stone pt-4\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <h3 className=\\\"font-serif text-lg font-medium text-ink\\\">Caregiver Steps</h3>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() =>\\n                      setFormSteps((prev) => [\\n                        ...prev,\\n                        { title: \'\', instructionText: \'\', caregiverTip: \'\' },\\n                      ])\\n                    }\\n                    className=\\\"text-xs font-medium text-eucalyptus hover:underline cursor-pointer\\\"\\n                  >\\n                    + Add Step\\n                  </button>\\n                </div>\\n                {formSteps.map((st, idx) => (\\n                  <div\\n                    key={idx}\\n                    className=\\\"grid grid-cols-1 md:grid-cols-12 gap-2.5 p-3 rounded-lg border border-stone bg-chalk\\\"\\n                  >\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder={`Step ${idx + 1} title`}\\n                      value={st.title}\\n                      onChange={(e) =>\\n                        setFormSteps((prev) =>\\n                          prev.map((item, i) => (i === idx ? { ...item, title: e.target.value } : item))\\n                        )\\n                      }\\n                      className=\\\"md:col-span-4 rounded border border-stone bg-linen px-3 py-1.5 text-sm\\\"\\n                    />\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder=\\\"Clear plain-language caregiver instruction\\\"\\n                      value={st.instructionText}\\n                      onChange={(e) =>\\n                        setFormSteps((prev) =>\\n                          prev.map((item, i) =>\\n                            i === idx ? { ...item, instructionText: e.target.value } : item\\n                          )\\n                        )\\n                      }\\n                      className=\\\"md:col-span-7 rounded border border-stone bg-linen px-3 py-1.5 text-sm\\\"\\n                    />\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={formSteps.length <= 1}\\n                      onClick={() => setFormSteps((prev) => prev.filter((_, i) => i !== idx))}\\n                      aria-label=\\\"Remove step\\\"\\n                      className=\\\"md:col-span-1 flex items-center justify-center text-olive hover:text-crimson disabled:opacity-30 cursor-pointer\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                ))}\\n              </div>\\n\\n              {/* Dynamic Weighted Caregiver Execution Rubric */}\\n              <div className=\\\"space-y-3 border-t border-stone pt-4\\\">\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                  <div>\\n                    <h3 className=\\\"font-serif text-lg font-medium text-ink\\\">\\n                      Caregiver Execution Rubric (Must Total 100 pts)\\n                    </h3>\\n                    <p className=\\\"text-xs text-olive\\\">\\n                      Criteria must evaluate caregiver technique only\342\200\224never baby development.\\n                    </p>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-3\\\">\\n                    <span\\n                      className={`font-mono text-xs tabular-nums font-medium ${\\n                        rubricWeightTotal === 100 ? \'text-eucalyptus\' : \'text-crimson\'\\n                      }`}\\n                    >\\n                      Total: {rubricWeightTotal}/100 pts\\n                    </span>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        setFormRubric((prev) => [\\n                          ...prev,\\n                          { label: \'\', description: \'\', weightPoints: 25 },\\n                        ])\\n                      }\\n                      className=\\\"text-xs font-medium text-eucalyptus hover:underline cursor-pointer\\\"\\n                    >\\n                      + Add Criterion\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {formRubric.map((crit, idx) => (\\n                  <div\\n                    key={idx}\\n                    className=\\\"grid grid-cols-1 md:grid-cols-12 gap-2.5 p-3 rounded-lg border border-stone bg-chalk\\\"\\n                  >\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder=\\\"Criterion label\\\"\\n                      value={crit.label}\\n                      onChange={(e) =>\\n                        setFormRubric((prev) =>\\n                          prev.map((item, i) => (i === idx ? { ...item, label: e.target.value } : item))\\n                        )\\n                      }\\n                      className=\\\"md:col-span-4 rounded border border-stone bg-linen px-3 py-1.5 text-sm\\\"\\n                    />\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder=\\\"Observable caregiver behavior\\\"\\n                      value={crit.description}\\n                      onChange={(e) =>\\n                        setFormRubric((prev) =>\\n                          prev.map((item, i) =>\\n                            i === idx ? { ...item, description: e.target.value } : item\\n                          )\\n                        )\\n                      }\\n                      className=\\\"md:col-span-5 rounded border border-stone bg-linen px-3 py-1.5 text-sm\\\"\\n                    />\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={5}\\n                      max={100}\\n                      required\\n                      value={crit.weightPoints}\\n                      onChange={(e) =>\\n                        setFormRubric((prev) =>\\n                          prev.map((item, i) =>\\n                            i === idx ? { ...item, weightPoints: Number(e.target.value) } : item\\n                          )\\n                        )\\n                      }\\n                      className=\\\"md:col-span-2 rounded border border-stone bg-linen px-3 py-1.5 text-sm font-mono tabular-nums\\\"\\n                    />\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={formRubric.length <= 1}\\n                      onClick={() => setFormRubric((prev) => prev.filter((_, i) => i !== idx))}\\n                      aria-label=\\\"Remove criterion\\\"\\n                      className=\\\"md:col-span-1 flex items-center justify-center text-olive hover:text-crimson disabled:opacity-30 cursor-pointer\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  </div>\\n                ))}\\n              </div>\\n\\n              <div className=\\\"flex justify-end gap-3 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowActivityForm(false)}\\n                  className=\\\"px-4 py-2 text-sm text-olive hover:text-ink cursor-pointer\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={savingActivity}\\n                  className=\\\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\\\"\\n                >\\n                  {savingActivity ? \'Saving...\' : \'Save Activity\'}\\n                </button>\\n              </div>\\n            </form>\\n          )}\\n\\n          {/* 8 \303\227 6 Curriculum Coverage Matrix */}\\n          {overview && (\\n            <div className=\\\"rounded-xl border border-stone bg-linen overflow-x-auto\\\">\\n              <div className=\\\"px-4 py-3 border-b border-stone flex items-center justify-between\\\">\\n                <h2 className=\\\"font-serif text-lg font-medium text-ink\\\">\\n                  Published Coverage Matrix (Click Any Cell to Filter)\\n                </h2>\\n                {(filterAgeId || filterDomainId) && (\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setFilterAgeId(\'\');\\n                      setFilterDomainId(\'\');\\n                    }}\\n                    className=\\\"text-xs font-medium text-eucalyptus hover:underline cursor-pointer\\\"\\n                  >\\n                    Clear Filter\\n                  </button>\\n                )}\\n              </div>\\n              <table className=\\\"w-full text-left border-collapse text-xs\\\">\\n                <thead>\\n                  <tr className=\\\"border-b border-stone text-olive\\\">\\n                    <th className=\\\"py-2.5 px-4 font-medium\\\">Age Group</th>\\n                    {learningDomains.map((dom) => (\\n                      <th key={dom.id} className=\\\"py-2.5 px-3 font-medium text-center\\\">\\n                        {dom.name.split(\' \')[0]}\\n                      </th>\\n                    ))}\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-stone\\\">\\n                  {overview.coverageMatrix.map((row) => (\\n                    <tr key={row.ageGroupId}>\\n                      <td className=\\\"py-2.5 px-4 font-mono font-medium text-ink tabular-nums whitespace-nowrap\\\">\\n                        {row.ageGroupLabel}\\n                      </td>\\n                      {learningDomains.map((dom) => {\\n                        const cnt = row.domainCounts[dom.slug] ?? 0;\\n                        const active = filterAgeId === row.ageGroupId && filterDomainId === dom.id;\\n                        return (\\n                          <td key={dom.id} className=\\\"py-2 px-3 text-center\\\">\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => {\\n                                setFilterAgeId(row.ageGroupId);\\n                                setFilterDomainId(dom.id);\\n                              }}\\n                              className={`w-8 h-7 rounded font-mono tabular-nums transition-colors cursor-pointer ${\\n                                active\\n                                  ? \'bg-eucalyptus text-white\'\\n                                  : cnt > 0\\n                                    ? \'bg-eucalyptus-soft text-eucalyptus hover:bg-eucalyptus/20\'\\n                                    : \'bg-oat text-olive hover:bg-stone/70\'\\n                              }`}\\n                            >\\n                              {cnt}\\n                            </button>\\n                          </td>\\n                        );\\n                      })}\\n                    </tr>\\n                  ))}\\n                </tbody>\\n              </table>\\n            </div>\\n          )}\\n\\n          {/* Activities List */}\\n          <div className=\\\"rounded-xl border border-stone bg-linen overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-stone text-xs font-medium text-olive\\\">\\n                  <th className=\\\"py-3 px-4\\\">Activity</th>\\n                  <th className=\\\"py-3 px-4\\\">Age Band</th>\\n                  <th className=\\\"py-3 px-4\\\">Domain</th>\\n                  <th className=\\\"py-3 px-4\\\">Status</th>\\n                  <th className=\\\"py-3 px-4 text-right\\\">Manage</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-stone text-sm\\\">\\n                {loading ? (\\n                  <tr>\\n                    <td colSpan={5} className=\\\"py-6 px-4 text-center text-olive text-sm\\\">\\n                      Loading curriculum...\\n                    </td>\\n                  </tr>\\n                ) : activities.length === 0 ? (\\n                  <tr>\\n                    <td colSpan={5} className=\\\"py-6 px-4 text-center text-olive text-sm\\\">\\n                      No activities match this filter yet.\\n                    </td>\\n                  </tr>\\n                ) : (\\n                  activities.map((a) => (\\n                    <tr key={a.id} className=\\\"hover:bg-chalk/70\\\">\\n                      <td className=\\\"py-3 px-4\\\">\\n                        <p className=\\\"font-medium text-ink\\\">{a.title}</p>\\n                        <p className=\\\"text-xs text-olive line-clamp-1\\\">{a.summary}</p>\\n                      </td>\\n                      <td className=\\\"py-3 px-4 font-mono text-xs text-ink tabular-nums whitespace-nowrap\\\">\\n                        {a.ageGroupLabel}\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs text-olive\\\">{a.domainName}</td>\\n                      <td className=\\\"py-3 px-4 text-xs capitalize text-ink\\\">{a.status}</td>\\n                      <td className=\\\"py-3 px-4 text-right whitespace-nowrap\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => void openEditActivityForm(a.id)}\\n                          className=\\\"text-xs font-medium text-eucalyptus hover:underline cursor-pointer\\\"\\n                        >\\n                          Edit\\n                        </button>\\n                      </td>\\n                    </tr>\\n                  ))\\n                )}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: DAILY PLAN SEQUENCER */}\\n      {activeTab === \'plans\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-5\\\">\\n            <div>\\n              <p className=\\\"text-xs text-olive\\\">Calm Pacing \302\267 Max 2\342\200\2233 activities per day</p>\\n              <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">Daily Plan Sequencer</h1>\\n            </div>\\n            <select\\n              aria-label=\\\"Age group for daily plans\\\"\\n              value={planAgeGroupId}\\n              onChange={(e) => setPlanAgeGroupId(e.target.value)}\\n              className=\\\"rounded-lg border border-stone bg-linen px-3.5 py-2 text-sm text-ink\\\"\\n            >\\n              {ageGroups.map((ag) => (\\n                <option key={ag.id} value={ag.id}>\\n                  {ag.label}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n            <div className=\\\"lg:col-span-4 space-y-3\\\">\\n              <p className=\\\"text-xs font-medium text-olive\\\">Existing Days</p>\\n              {existingPlans.map((p) => (\\n                <button\\n                  key={p.id}\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setPlanDayNumber(p.dayNumber);\\n                    setPlanTitle(p.title);\\n                    setPlanFocusNote(p.focusNote);\\n                    setPlanSelectedActivityIds(p.activityIds);\\n                  }}\\n                  className={`w-full text-left rounded-xl border p-4 transition-colors cursor-pointer ${\\n                    planDayNumber === p.dayNumber\\n                      ? \'border-eucalyptus bg-eucalyptus-soft/40\'\\n                      : \'border-stone bg-linen hover:bg-oat/50\'\\n                  }`}\\n                >\\n                  <p className=\\\"font-mono text-xs text-olive tabular-nums\\\">Day {p.dayNumber}</p>\\n                  <p className=\\\"font-medium text-sm text-ink mt-0.5\\\">{p.title}</p>\\n                  <p className=\\\"text-xs text-olive mt-1\\\">\\n                    {p.activityIds.length} scheduled activities\\n                  </p>\\n                </button>\\n              ))}\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  const nextDay =\\n                    existingPlans.length > 0\\n                      ? Math.max(...existingPlans.map((p) => p.dayNumber)) + 1\\n                      : 1;\\n                  setPlanDayNumber(nextDay);\\n                  setPlanTitle(`Day ${nextDay} \302\267 Gentle Practice`);\\n                  setPlanFocusNote(\'Short, warm sessions paced around baby\342\200\231s natural energy.\');\\n                  setPlanSelectedActivityIds([]);\\n                }}\\n                className=\\\"w-full py-2.5 rounded-lg border border-dashed border-stone text-xs font-medium text-eucalyptus hover:bg-oat/60 cursor-pointer\\\"\\n              >\\n                + Add Day Plan\\n              </button>\\n            </div>\\n\\n            <form\\n              onSubmit={handleSaveDailyPlan}\\n              className=\\\"lg:col-span-8 rounded-xl border border-stone bg-linen p-6 space-y-4\\\"\\n            >\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-4 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Day #</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    min={1}\\n                    max={30}\\n                    value={planDayNumber}\\n                    onChange={(e) => setPlanDayNumber(Number(e.target.value))}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm font-mono tabular-nums\\\"\\n                  />\\n                </div>\\n                <div className=\\\"sm:col-span-3\\\">\\n                  <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Day Title</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={planTitle}\\n                    onChange={(e) => setPlanTitle(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-ink mb-1\\\">Calm Focus Note</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={planFocusNote}\\n                  onChange={(e) => setPlanFocusNote(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"space-y-2\\\">\\n                <p className=\\\"text-xs font-medium text-ink\\\">\\n                  Select Published Activities (recommended: 2\342\200\2233)\\n                </p>\\n                {planAgeActivities.length === 0 ? (\\n                  <p className=\\\"text-xs text-olive\\\">\\n                    No published activities exist in this age group yet.\\n                  </p>\\n                ) : (\\n                  <div className=\\\"space-y-2\\\">\\n                    {planAgeActivities.map((act) => {\\n                      const checked = planSelectedActivityIds.includes(act.id);\\n                      return (\\n                        <label\\n                          key={act.id}\\n                          className=\\\"flex items-start gap-3 p-3 rounded-lg border border-stone bg-chalk cursor-pointer\\\"\\n                        >\\n                          <input\\n                            type=\\\"checkbox\\\"\\n                            checked={checked}\\n                            onChange={() =>\\n                              setPlanSelectedActivityIds((prev) =>\\n                                checked ? prev.filter((id) => id !== act.id) : [...prev, act.id]\\n                              )\\n                            }\\n                            className=\\\"mt-0.5 h-4 w-4 accent-eucalyptus\\\"\\n                          />\\n                          <div>\\n                            <p className=\\\"text-sm font-medium text-ink\\\">{act.title}</p>\\n                            <p className=\\\"text-xs text-olive\\\">\\n                              {act.domainName} \302\267 {act.durationMinutes} min\\n                            </p>\\n                          </div>\\n                        </label>\\n                      );\\n                    })}\\n                  </div>\\n                )}\\n              </div>\\n\\n              <div className=\\\"flex justify-end pt-2\\\">\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={savingPlan || planSelectedActivityIds.length === 0}\\n                  className=\\\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-45 cursor-pointer\\\"\\n                >\\n                  {savingPlan ? \'Saving Plan...\' : \'Save Daily Plan\'}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: USERS & ROLE MANAGEMENT */}\\n      {activeTab === \'users\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"border-b border-stone pb-5\\\">\\n            <p className=\\\"text-xs text-olive\\\">Role-Based Access Control</p>\\n            <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">Accounts & Roles</h1>\\n          </div>\\n\\n          <div className=\\\"rounded-xl border border-stone bg-linen overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-stone text-xs font-medium text-olive\\\">\\n                  <th className=\\\"py-3 px-4\\\">Name</th>\\n                  <th className=\\\"py-3 px-4\\\">Email</th>\\n                  <th className=\\\"py-3 px-4\\\">Joined</th>\\n                  <th className=\\\"py-3 px-4\\\">Role</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-stone text-sm\\\">\\n                {users.map((u) => (\\n                  <tr key={u.id}>\\n                    <td className=\\\"py-3 px-4 font-medium text-ink\\\">{u.fullName}</td>\\n                    <td className=\\\"py-3 px-4 text-xs text-olive\\\">{u.email}</td>\\n                    <td className=\\\"py-3 px-4 font-mono text-xs text-olive tabular-nums\\\">\\n                      {formatDateTimeReadable(u.createdAt, locale)}\\n                    </td>\\n                    <td className=\\\"py-3 px-4\\\">\\n                      <select\\n                        aria-label={`Role for ${u.fullName}`}\\n                        value={u.role}\\n                        onChange={(e) => void handleRoleUpdate(u.id, e.target.value as UserRole)}\\n                        className=\\\"rounded-lg border border-stone bg-chalk px-2.5 py-1 text-xs font-medium text-ink\\\"\\n                      >\\n                        <option value=\\\"parent\\\">Parent</option>\\n                        <option value=\\\"reviewer\\\">Reviewer</option>\\n                        <option value=\\\"admin\\\">Admin</option>\\n                      </select>\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: PRIVACY, 30-DAY RETENTION & AUDIT LOG */}\\n      {activeTab === \'privacy\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-5\\\">\\n            <div>\\n              <p className=\\\"text-xs text-olive\\\">Children\342\200\231s Media Security & Retention Governance</p>\\n              <h1 className=\\\"font-serif text-3xl font-medium text-ink\\\">\\n                Privacy Retention & Audit Trail\\n              </h1>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              disabled={sweeping}\\n              onClick={() => void handleRunRetentionSweep()}\\n              className=\\\"inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-stone bg-linen text-sm font-medium text-ink hover:bg-oat transition-colors cursor-pointer\\\"\\n            >\\n              <RefreshCw className={`w-4 h-4 ${sweeping ? \'animate-spin\' : \'\'}`} />\\n              {sweeping ? \'Running Sweep...\' : \'Run 30-Day Retention Sweep\'}\\n            </button>\\n          </div>\\n\\n          {overview && (\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Active Private Vault Videos</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.activeVideosCount}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Auto-Purged (30-Day Policy)</p>\\n                <p className=\\\"font-mono text-2xl font-medium text-ink tabular-nums mt-1\\\">\\n                  {overview.counts.expiredPurgedCount}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-xl border border-stone bg-linen p-4\\\">\\n                <p className=\\\"text-xs text-olive\\\">Last Retention Sweep</p>\\n                <p className=\\\"font-mono text-sm font-medium text-ink tabular-nums mt-2\\\">\\n                  {overview.lastRetentionSweepAt\\n                    ? formatDateTimeReadable(overview.lastRetentionSweepAt, locale)\\n                    : \'Not run yet\'}\\n                </p>\\n              </div>\\n            </div>\\n          )}\\n\\n          <div className=\\\"rounded-xl border border-stone bg-linen overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-stone text-xs font-medium text-olive\\\">\\n                  <th className=\\\"py-3 px-4\\\">Timestamp</th>\\n                  <th className=\\\"py-3 px-4\\\">Actor</th>\\n                  <th className=\\\"py-3 px-4\\\">Role</th>\\n                  <th className=\\\"py-3 px-4\\\">Action</th>\\n                  <th className=\\\"py-3 px-4\\\">Submission ID</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-stone text-xs\\\">\\n                {auditLogs.map((log) => (\\n                  <tr key={log.id}>\\n                    <td className=\\\"py-3 px-4 font-mono text-olive tabular-nums whitespace-nowrap\\\">\\n                      {formatDateTimeReadable(log.createdAt, locale)}\\n                    </td>\\n                    <td className=\\\"py-3 px-4 font-medium text-ink\\\">{log.actorName}</td>\\n                    <td className=\\\"py-3 px-4 capitalize text-olive\\\">{log.actorRole}</td>\\n                    <td className=\\\"py-3 px-4 font-mono text-ink\\\">{log.action}</td>\\n                    <td className=\\\"py-3 px-4 font-mono text-olive\\\">{log.submissionId}</td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create AdminConsoleView with 8x6 curriculum matrix, full Activity/Step/Rubric CMS, Daily Plan sequencer, role management, and 30-day retention & audit log viewer.\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AdminConsoleView.tsx\", \"toolAction\":\"Creating AdminConsoleView page\", \"toolSummary\":\"Create AdminConsoleView\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_330057736009126089"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { TopBar, type TopBarNavItem } from \'./components/TopBar\';\\nimport { AuthProvider, useAuth } from \'./context/AuthContext\';\\nimport { AdminConsoleView, type AdminTab } from \'./pages/AdminConsoleView\';\\nimport { LandingAuthView } from \'./pages/LandingAuthView\';\\nimport { ParentJourneyView, type ParentTab } from \'./pages/ParentJourneyView\';\\nimport { ReviewerWorkbenchView } from \'./pages/ReviewerWorkbenchView\';\\n\\nfunction LittleStepsShell() {\\n  const { user, loading, logout, t } = useAuth();\\n  const [parentTab, setParentTab] = useState<ParentTab>(\'today\');\\n  const [adminTab, setAdminTab] = useState<AdminTab>(\'curriculum\');\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"min-h-screen bg-chalk flex items-center justify-center\\\">\\n        <p className=\\\"font-serif text-lg text-olive\\\">Preparing LittleSteps...</p>\\n      </div>\\n    );\\n  }\\n\\n  if (!user) {\\n    return <LandingAuthView />;\\n  }\\n\\n  if (user.role === \'parent\') {\\n    const navItems: TopBarNavItem[] = [\\n      { id: \'today\', label: t(\'nav.today\') },\\n      { id: \'feedback\', label: t(\'nav.feedback\') },\\n      { id: \'progress\', label: t(\'nav.progress\') },\\n    ];\\n    return (\\n      <div className=\\\"min-h-screen bg-chalk text-ink flex flex-col\\\">\\n        <TopBar\\n          navItems={navItems}\\n          activeNavId={parentTab}\\n          onSelectNav={(id) => setParentTab(id as ParentTab)}\\n          primaryActionLabel={t(\'auth.signOut\')}\\n          onPrimaryAction={() => void logout()}\\n          onBrandClick={() => setParentTab(\'today\')}\\n        />\\n        <main className=\\\"flex-1\\\">\\n          <ParentJourneyView activeTab={parentTab} onChangeTab={setParentTab} />\\n        </main>\\n      </div>\\n    );\\n  }\\n\\n  if (user.role === \'reviewer\') {\\n    const navItems: TopBarNavItem[] = [{ id: \'queue\', label: t(\'nav.queue\') }];\\n    return (\\n      <div className=\\\"min-h-screen bg-chalk text-ink flex flex-col\\\">\\n        <TopBar\\n          navItems={navItems}\\n          activeNavId=\\\"queue\\\"\\n          onSelectNav={() => {}}\\n          primaryActionLabel={t(\'auth.signOut\')}\\n          onPrimaryAction={() => void logout()}\\n        />\\n        <main className=\\\"flex-1\\\">\\n          <ReviewerWorkbenchView />\\n        </main>\\n      </div>\\n    );\\n  }\\n\\n  // Admin Console\\n  const adminNavItems: TopBarNavItem[] = [\\n    { id: \'curriculum\', label: t(\'nav.curriculum\') },\\n    { id: \'plans\', label: t(\'nav.plans\') },\\n    { id: \'users\', label: t(\'nav.users\') },\\n    { id: \'privacy\', label: t(\'nav.privacy\') },\\n  ];\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-chalk text-ink flex flex-col\\\">\\n      <TopBar\\n        navItems={adminNavItems}\\n        activeNavId={adminTab}\\n        onSelectNav={(id) => setAdminTab(id as AdminTab)}\\n        primaryActionLabel={t(\'auth.signOut\')}\\n        onPrimaryAction={() => void logout()}\\n        onBrandClick={() => setAdminTab(\'curriculum\')}\\n      />\\n      <main className=\\\"flex-1\\\">\\n        <AdminConsoleView activeTab={adminTab} />\\n      </main>\\n    </div>\\n  );\\n}\\n\\nexport default function App() {\\n  return (\\n    <AuthProvider>\\n      <LittleStepsShell />\\n    </AuthProvider>\\n  );\\n}\\n\", \"Description\":\"Wire root App component with AuthProvider and role-isolated Parent, Reviewer, and Admin workspaces.\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Wiring root App shell\", \"toolSummary\":\"Update src/App.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 312
      nanos: 37491967
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "N3QAa_CPNZC9vdIP1a74yA8"
  }
}
