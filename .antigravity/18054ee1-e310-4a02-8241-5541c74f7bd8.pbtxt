            lines {
              text: "- **Confirmed \342\200\224 Children\'s Video Privacy & Retention**: Private, authenticated access via short-lived signed streaming tokens (never public URLs) with **30-day automatic deletion** plus immediate parent-initiated deletion at any time."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
