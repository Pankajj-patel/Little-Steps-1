            lines {
              text: "    materials: [\'Small open steel cup\', \'Wooden spoon\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    safetyNotes: \'Sit comfortably at toddler\342\200\231s eye level on a floor mat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.everydayCup,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Hold two familiar items apart\', instructionText: \'Hold the cup in one hand and wooden spoon in the other, clearly naming each once.\', caregiverTip: \'Pause between the two names.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Ask an open calm question\', instructionText: \'Ask \342\200\234Would you like the cup or the spoon?\342\200\235 and wait patiently.\', caregiverTip: \'Honor pointing, gazing, or sounds equally.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Confirm their choice\', instructionText: \'Hand over the chosen item while naming it warmly: \342\200\234You chose the cup!\342\200\235\', caregiverTip: \'Avoid quizzing or repeating \342\200\234Say cup!\342\200\235\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Follow their play briefly\', instructionText: \'Join quietly for 2 minutes following what they do with the item.\', caregiverTip: \'Real choices motivate communication.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Clear two-option presentation\', description: \'Caregiver held items clearly spaced at eye level.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Simple choice question + pause\', description: \'Caregiver asked once and waited patiently.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Honoring non-verbal & vocal cues\', description: \'Caregiver responded warmly to pointing or sound without pressuring speech.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Warm confirmation\', description: \'Caregiver named the chosen item clearly when handing it over.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
