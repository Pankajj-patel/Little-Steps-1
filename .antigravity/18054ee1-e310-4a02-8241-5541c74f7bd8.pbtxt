              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <strong className=\"text-charcoal\">Never public:</strong> Uploaded or recorded practice clips are stored in an isolated private vault outside public web directories with random opaque storage keys."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <strong className=\"text-charcoal\">Short-lived signed playback:</strong> Videos stream only over authenticated, time-limited signed tokens (5-minute expiry) with browser caching and downloads disabled."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
