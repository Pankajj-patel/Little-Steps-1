            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Create two clear anchors\', instructionText: \'Place one wooden spoon in the left bowl and one folded cloth in the right bowl.\', caregiverTip: \'Visual anchors reduce verbal instructions.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Model one match silently\', instructionText: \'Pick up another spoon, look between bowls, and place it gently with the first spoon.\', caregiverTip: \'Let toddler notice the visual match.\' },"
