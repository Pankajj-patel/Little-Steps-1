  view_file {
    absolute_path_uri: "file:///src/design-system/ConfirmDialog.tsx"
    end_line: 52
    content: "import React from \'react\';\nimport { Button } from \'./Button\';\nimport { Modal } from \'./Modal\';\n\nexport interface ConfirmDialogProps {\n  open: boolean;\n  onClose: () => void;\n  onConfirm: () => void;\n  title: string;\n  message: string;\n  confirmLabel?: string;\n  cancelLabel?: string;\n  destructive?: boolean;\n  loading?: boolean;\n}\n\nexport function ConfirmDialog({\n  open,\n  onClose,\n  onConfirm,\n  title,\n  message,\n  confirmLabel = \'Confirm\',\n  cancelLabel = \'Cancel\',\n  destructive = false,\n  loading = false,\n}: ConfirmDialogProps) {\n  return (\n    <Modal\n      open={open}\n      onClose={onClose}\n      title={title}\n      size=\"sm\"\n      footer={\n        <>\n          <Button variant=\"subtle\" onClick={onClose} disabled={loading}>\n            {cancelLabel}\n          </Button>\n          <Button\n            variant={destructive ? \'danger\' : \'primary\'}\n            onClick={onConfirm}\n            loading={loading}\n          >\n            {confirmLabel}\n          </Button>\n        </>\n      }\n    >\n      <p className=\"text-sm text-muted leading-relaxed\">{message}</p>\n    </Modal>\n  );\n}\n"
    num_lines: 53
    num_bytes: 1095
    line_range_bytes: 1095
  }
