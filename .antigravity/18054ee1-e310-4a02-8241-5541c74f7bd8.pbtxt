    content: "import React, { useEffect, useRef, useState } from \'react\';\nimport {\n  ArrowRight,\n  Baby,\n  Bell,\n  BookOpen,\n  Camera,\n  CheckCircle2,\n  Clock,\n  Info,\n  KeyRound,\n  LogOut,\n  MailCheck,\n  Palette,\n  Plus,\n  ShieldCheck,\n  Sparkles,\n  Trash2,\n  User,\n} from \'lucide-react\';\nimport { SecureVideoPlayer } from \'../../components/SecureVideoPlayer\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport {\n  ActivityCard,\n  AgeGroupSelector,\n  Badge,\n  Button,\n  Card,\n  ConfirmDialog,\n  DatePicker,\n  EmptyState,\n  Input,\n  Modal,\n  ProgressIndicator,\n  Select,\n  SkeletonCard,\n  useToast,\n} from \'../../design-system\';\nimport { api } from \'../../lib/api\';\nimport type { NavigateTarget } from \'../../lib/router\';\nimport { formatDaysUntilExpiry } from \'../../shared/domain\';\nimport { formatDateReadable } from \'../../shared/i18n\';\nimport type {\n  ActivitySummary,\n  AgeGroup,\n  ChildProfile,\n  LearningDomain,\n  LocaleCode,\n  NotificationPreference,\n  ParentNotificationItem,\n  PreferredActivityTime,\n  TodayJourneyResponse,\n} from \'../../shared/types\';\nimport { formatPrepLevel } from \'./MyPlanSection\';\n\n/* ========================================================================= */\n/* 1. ACTIVITIES LIBRARY SECTION                                             */\n/* ========================================================================= */\ninterface ActivitiesLibrarySectionProps {\n  ageGroups: AgeGroup[];\n  learningDomains: LearningDomain[];\n  initialAgeGroupSlug: string;\n  initialDomainId?: string;\n  completedActivityIds: Set<string>;\n  onOpenActivity: (activityId: string) => void;\n}\n\nexport function ActivitiesLibrarySection({\n  ageGroups,\n  learningDomains,\n  initialAgeGroupSlug,\n  initialDomainId = \'all\',\n  completedActivityIds,\n  onOpenActivity,\n}: ActivitiesLibrarySectionProps) {\n  const [selectedAgeSlug, setSelectedAgeSlug] = useState(initialAgeGroupSlug);\n  const [selectedDomainId, setSelectedDomainId] = useState(initialDomainId);\n  const [activities, setActivities] = useState<ActivitySummary[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    setSelectedAgeSlug(initialAgeGroupSlug);\n  }, [initialAgeGroupSlug]);\n\n  useEffect(() => {\n    setSelectedDomainId(initialDomainId);\n  }, [initialDomainId]);\n\n  const loadActivities = async (ageSlug: string, domainId: string) => {\n    setLoading(true);\n    setError(null);\n    try {\n      const matchedAge = ageGroups.find((g) => g.slug === ageSlug);\n      const { activities: list } = await api.listPublishedActivities(\n        matchedAge?.id,\n        domainId === \'all\' ? undefined : domainId\n      );\n      setActivities(list);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to load activities right now.\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    if (ageGroups.length > 0) {\n      void loadActivities(selectedAgeSlug, selectedDomainId);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [selectedAgeSlug, selectedDomainId, ageGroups.length]);\n\n  const domainOptions = [\n    { value: \'all\', label: \'All six development areas\' },\n    ...learningDomains.map((d) => ({ value: d.id, label: d.name })),\n  ];\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"space-y-1\">\n        <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\">\n          Activity Library\n        </h2>\n        <p className=\"text-sm text-muted\">\n          Explore calm, everyday activities by age stage and development area.\n        </p>\n      </div>\n\n      <Card className=\"space-y-4\">\n        <AgeGroupSelector\n          label=\"Choose age stage (0\342\200\22324 months)\"\n          selectedSlug={selectedAgeSlug}\n          onSelect={(slug) => setSelectedAgeSlug(slug)}\n          allowAll\n        />\n\n        <div className=\"max-w-sm\">\n          <Select\n            label=\"Filter by development area\"\n            options={domainOptions}\n            value={selectedDomainId}\n            onChange={(e) => setSelectedDomainId(e.target.value)}\n          />\n        </div>\n      </Card>\n\n      {error && (\n        <Card className=\"border-danger/40 bg-danger-soft/50 flex flex-wrap items-center justify-between gap-3\">\n          <p role=\"alert\" className=\"text-sm text-danger\">\n            {error}\n          </p>\n          <Button\n            variant=\"secondary\"\n            size=\"sm\"\n            onClick={() => void loadActivities(selectedAgeSlug, selectedDomainId)}\n          >\n            Try Again\n          </Button>\n        </Card>\n      )}\n\n      {loading ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          <SkeletonCard />\n          <SkeletonCard />\n        </div>\n      ) : activities.length === 0 ? (\n        <EmptyState\n          title=\"No activities in this filter yet\"\n          description=\"Try switching to another development area or viewing all six areas for this age stage.\"\n          actionLabel=\"Show All Six Areas\"\n          onAction={() => setSelectedDomainId(\'all\')}\n        />\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          {activities.map((act) => {\n            const done = completedActivityIds.has(act.id);\n            return (\n              <ActivityCard\n                key={act.id}\n                title={act.title}\n                summary={act.summary}\n                domainName={act.domainName}\n                ageGroupLabel={act.ageGroupLabel}\n                durationMinutes={act.durationMinutes}\n                prepLevelLabel={formatPrepLevel(act.prepLevel)}\n                materials={act.materials}\n                posterUrl={act.instructionalPosterUrl}\n                statusText={done ? \'Completed\' : \'Not started\'}\n                statusTone={done ? \'sage\' : \'neutral\'}\n                statusState={done ? \'completed\' : \'not_started\'}\n                completed={done}\n                actionLabel={done ? \'View Activity\' : \'Start Activity\'}\n                onAction={() => onOpenActivity(act.id)}\n              />\n            );\n          })}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/* ========================================================================= */\n/* 2. PROGRESS & CAREGIVER FEEDBACK SECTION                                  */\n/* ========================================================================= */\ninterface ProgressAndFeedbackSectionProps {\n  journey: TodayJourneyResponse;\n  locale: LocaleCode;\n  nonDiagnosticTitle: string;\n  nonDiagnosticBody: string;\n  onRefreshJourney: () => Promise<void>;\n  onExploreDomain: (domainId: string) => void;\n  onGoToday: () => void;\n}\n\nexport function ProgressAndFeedbackSection({\n  journey,\n  locale,\n  nonDiagnosticTitle,\n  nonDiagnosticBody,\n  onRefreshJourney,\n  onExploreDomain,\n  onGoToday,\n}: ProgressAndFeedbackSectionProps) {\n  const { notify } = useToast();\n  const [confirmDeleteSubId, setConfirmDeleteSubId] = useState<string | null>(null);\n  const [deletingVideoId, setDeletingVideoId] = useState<string | null>(null);\n\n  const weeklyTotal = journey.weeklyProgress.reduce((sum, d) => sum + d.completedCount, 0);\n  const maxDaily = Math.max(3, ...journey.weeklyProgress.map((d) => d.completedCount));\n\n  const handleConfirmDeleteVideo = async () => {\n    if (!confirmDeleteSubId) return;\n    setDeletingVideoId(confirmDeleteSubId);\n    try {\n      await api.deleteSubmissionVideo(confirmDeleteSubId);\n      setConfirmDeleteSubId(null);\n      notify({\n        tone: \'success\',\n        title: \'Video deleted permanently\',\n        description: \'Your written coaching feedback remains safely preserved.\',\n      });\n      await onRefreshJourney();\n    } catch (err) {\n      notify({\n        tone: \'error\',\n        title: \'Could not delete video\',\n        description: err instanceof Error ? err.message : \'Please try again.\',\n      });\n    } finally {\n      setDeletingVideoId(null);\n    }\n  };\n\n  return (\n    <div className=\"space-y-8\">\n      <div className=\"space-y-1\">\n        <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\">\n          {journey.child.displayName}\342\200\231s Learning Progress\n        </h2>\n        <p className=\"text-sm text-muted\">\n          A calm reflection of completed daily activities and caregiver coaching feedback \342\200\224 never\n          a test or grade of your baby.\n        </p>\n      </div>\n\n      {/* Weekly Chart Summary */}\n      <Card padding=\"lg\" className=\"space-y-5\">\n        <div className=\"flex flex-wrap items-baseline justify-between gap-3\">\n          <div>\n            <h3 className=\"font-display text-lg font-semibold text-charcoal\">\n              Last 7 Days Rhythm\n            </h3>\n            <p className=\"text-xs text-muted\">Actual activities logged across the past week.</p>\n          </div>\n          <Badge tone=\"sage\">\n            <span className=\"font-mono tabular-nums\">{weeklyTotal}</span>{\' \'}\n            {weeklyTotal === 1 ? \'activity\' : \'activities\'} this week"
    num_lines: 1250
    num_bytes: 47367
    line_range_bytes: 8968
  }
}
