      thinking_signature: "\022\220\022\n\215\022\001i\024}\023\216\317\313\025\272\300\354\022\fo&\304\001\373zu\vH\2545$\217KE\345\366\246u[\365\200\277\247d\n\312G\327%\214\340\020\376\235 \226c\270\215_\360\236p\324%\224p\210?\271{(\303\003\317P\245\021]\213\337<oY\377k\264\020\026\274h\361\275\323\242\bR[\360\016mSc\"\300v\357=#m\223\205%\245s\302\206\251K\025G\377!S\317\340\316u\364\367\222rC)xt\334\366\347\362\244\3335\230\346)\346\033\325\206\306:L!\371\275\236q\r\320b\020\315E\266\224\006.\bU\016\006\001:q\331/Jc\003\210\200M\v{\340\036\232\246F\257@\3243\236T\216\337\215\376\001\030ed\024\337\257$f\342\272\205\306\246\370\360\220\362\303\313\026z\201,4v\340B+~A%r\374\252^\255k\371p`\1772\2062t4\316k\206\317\213;2\311\257l|mwy\265!v\"\276h\214\255\223\244\367\215\342\023\371\313\355\312\247r\000\357\347\354>\324\233&\210HuN\303\343NX\302\237L\354\250:*\261M\312)d\367\026\257\354\371\232\252\377\344\027nW\367\354Z\306\314\001\207v8\300K\036\252\321\360=l\265\361J\225k\351\335\226\350\362\304\211\3068\363/\3452R\352q\364AQ\3227\f\267\323\233\337\222HSB(\001q\206#\223\345\344\f\t\002Q\004\256\244K\207\335\234\260\343\310?Y\327\275\243=\317\034\350\321Z\205\271\376\3252S\364\3227,\376{]\230\b\275\266\031X\0057c\212dh\003\033\325N\\\3470\305\032\241\236<\257\027\344\250\255\362\363U5v\272G\225\212\025\216\243n\242\350\r~\365x^G\217$N\v\257\326\367\261\267\240N\300\\D\216\275_\000n\272\247\021 \355vR\201\241\v6\336\027\260\227\303\273\031\\@\217\022\003\343\336\226l{\aA\304\343<t\331?v\370sCL E\341!\233\304*\232b\321(\226\347b\254v9\316L\344\246Z\0218\231\377\001\177\\\346\253\217\277\313\232\025\213\202\022n\342S\275\265\026\034\217\271ys+\375\336\"\227\a\001+\212{I\256;QQ\"*q\273J\252\274\372\352\371\236\376\232\020\251W\020\210kq>\227l\304\242Ho\325\366\366#\030a\340\224\301\'\016<\314\304\274\000\r\027[~l\242\223\362\233m\311\337\001+\365\215q\370@\251u\364\237\031\330}\000R\aG\356`\031\373\214\021\243\bs\374L\022@X\274>]\301 \346\237.\256\336V\231\020@\001\\