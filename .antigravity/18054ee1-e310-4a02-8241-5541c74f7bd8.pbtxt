              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Supported Mirror Tummy Time\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Encourage comfortable floor exploration with a low baby-safe mirror and rolled towel.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Firm cotton mat or dhurrie\', \'Safe shatterproof low mirror\', \'Small rolled cotton towel\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Never use glass mirrors that can tip. Stay within arm\342\200\231s reach and roll baby gently onto their back if tired.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.tummyMirror,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Anchor the mirror safely\', instructionText: \'Position the baby-safe mirror flat and secure at floor level beside the cotton mat.\', caregiverTip: \'Check that the frame cannot wobble.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Roll gently onto tummy\', instructionText: \'Guide baby slowly from back to side to tummy, tucking elbows neatly under shoulders.\', caregiverTip: \'Offer a small rolled towel under the chest if needed.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Lie down at eye level\', instructionText: \'Rest on the mat beside the mirror so baby sees both you and their reflection.\', caregiverTip: \'Your calm voice gives reassurance.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Roll out with ease\', instructionText: \'After 2\342\200\2233 minutes or at early fussing, narrate \342\200\234rolling back now\342\200\235 and turn baby gently.\', caregiverTip: \'Short positive sessions build comfort.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Safe surface & mirror stability\', description: \'Caregiver used a firm floor mat and stable low mirror.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Gentle shoulder-tucked transition\', description: \'Caregiver rolled baby smoothly and supported comfortable arm placement.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Caregiver at eye level\', description: \'Caregiver stayed down on the floor narrating calmly beside baby.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Respectful session length\', description: \'Caregiver ended smoothly before distress escalated.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ageSlug: \'3-6m\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domainSlug: \'language\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Echo & Pause Cooing Turn-Taking\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Practice warm back-and-forth vocal rhythm during relaxed floor time.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Quiet mat space\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Keep background audio off so your natural speaking voice is easy to hear.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.heroMontessori,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Sit face-to-face\', instructionText: \'Sit comfortably facing baby on the mat so baby clearly sees your mouth and expressions.\', caregiverTip: \'Natural daylight helps baby read facial expressions.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Listen first\', instructionText: \'Wait quietly for a sigh, coo, or vowel sound from baby.\', caregiverTip: \'Resist filling every silent moment.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Mirror warmly\', instructionText: \'Repeat baby\342\200\231s exact sound softly, then add one simple warm phrase like \342\200\234Yes, you\342\200\231re talking to Mama.\342\200\235\', caregiverTip: \'Keep your tone natural and gentle.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Pause for a reply\', instructionText: \'Hold a smiling 5-second pause to invite another turn.\', caregiverTip: \'Even 4\342\200\2235 exchanges are wonderful.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Clear face-to-face positioning\', description: \'Caregiver sat directly in baby\342\200\231s line of sight.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Quiet listening space\', description: \'Caregiver minimized background noise and waited before speaking.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Warm mirroring & naming\', description: \'Caregiver echoed baby\342\200\231s sounds with natural, affectionate speech.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Consistent 5-second pauses\', description: \'Caregiver left deliberate pauses for conversational turn-taking.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
