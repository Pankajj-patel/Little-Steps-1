    tool_calls {
      id: "call_13481422133758297464"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add prep_level and immutable historical age-group snapshot migrations to SQLite schema\", \"EndLine\":230, \"Instruction\":\"Add prep_level on activities and age_group_id_snapshot/age_group_label_snapshot on activity_completions with idempotent backfill\", \"ReplacementContent\":\"  ensureColumn(\'children\', \'profile_photo_url\', \'TEXT\');\\n  ensureColumn(\'children\', \'activity_preferences\', \'TEXT\');\\n  ensureColumn(\'activities\', \'prep_level\', \\\"TEXT NOT NULL DEFAULT \'quick_setup\'\\\");\\n  ensureColumn(\'activity_completions\', \'last_opened_at\', \'TEXT\');\\n  ensureColumn(\'activity_completions\', \'age_group_id_snapshot\', \'TEXT\');\\n  ensureColumn(\'activity_completions\', \'age_group_label_snapshot\', \'TEXT\');\\n\\n  // Backfill immutable historical stage snapshots for any pre-existing completion records\\n  db.exec(`\\n    UPDATE activity_completions\\n    SET age_group_id_snapshot = COALESCE(\\n          age_group_id_snapshot,\\n          (SELECT a.age_group_id FROM activities a WHERE a.id = activity_completions.activity_id)\\n        ),\\n        age_group_label_snapshot = COALESCE(\\n          age_group_label_snapshot,\\n          (SELECT ag.label FROM activities a JOIN age_groups ag ON ag.id = a.age_group_id WHERE a.id = activity_completions.activity_id)\\n        )\\n    WHERE age_group_id_snapshot IS NULL OR age_group_label_snapshot IS NULL;\\n  `);\\n\\n  // Ensure seeded demo accounts are marked verified & onboarded\\n  db.exec(`\\n    UPDATE users\\n    SET email_verified_at = COALESCE(email_verified_at, created_at),\\n        onboarding_completed_at = COALESCE(onboarding_completed_at, created_at)\\n    WHERE id IN (\'usr_parent_meera\', \'usr_reviewer_ananya\', \'usr_admin_kavita\');\\n  `);\\n}\", \"StartLine\":215, \"TargetContent\":\"  ensureColumn(\'children\', \'profile_photo_url\', \'TEXT\');\\n  ensureColumn(\'children\', \'activity_preferences\', \'TEXT\');\\n  ensureColumn(\'activity_completions\', \'last_opened_at\', \'TEXT\');\\n\\n  // Ensure seeded demo accounts are marked verified & onboarded\\n  db.exec(`\\n    UPDATE users\\n    SET email_verified_at = COALESCE(email_verified_at, created_at),\\n        onboarding_completed_at = COALESCE(onboarding_completed_at, created_at)\\n    WHERE id IN (\'usr_parent_meera\', \'usr_reviewer_ananya\', \'usr_admin_kavita\');\\n  `);\\n}\", \"TargetFile\":\"/server/db/schema.ts\", \"toolAction\":\"Adding prep_level and historical snapshot columns to SQLite schema\", \"toolSummary\":\"Add prep_level and completion snapshot migrations\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_13481422133758298519"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add idempotent multi-day 6-domain curriculum enrichment so every age band has Today + Upcoming Days without duplicate activities\", \"EndLine\":422, \"Instruction\":\"Run ensureStructuredDailyPlans even on already-seeded databases so multi-day age-appropriate plans and prep levels are always present\", \"ReplacementContent\":\"export function seedDatabaseIfEmpty(db: Database.Database): void {\\n  const existingAgeGroups = db.prepare(\'SELECT COUNT(*) as count FROM age_groups\').get() as {\\n    count: number;\\n  };\\n  if (existingAgeGroups.count > 0) {\\n    ensureStructuredDailyPlans(db);\\n    return;\\n  }\", \"StartLine\":410, \"TargetContent\":\"export function seedDatabaseIfEmpty(db: Database.Database): void {\\n  const existingAgeGroups = db.prepare(\'SELECT COUNT(*) as count FROM age_groups\').get() as {\\n    count: number;\\n  };\\n  if (existingAgeGroups.count > 0) {\\n    return;\\n  }\", \"TargetFile\":\"/server/db/seed.ts\", \"toolAction\":\"Wiring idempotent structured plan enrichment into seedDatabaseIfEmpty\", \"toolSummary\":\"Call ensureStructuredDailyPlans on boot\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_13481422133758299574"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Append ensureStructuredDailyPlans to seed.ts for rich 6-domain multi-day plans across age groups without duplicates\", \"EndLine\":672, \"Instruction\":\"Add ensureStructuredDailyPlans at end of seed.ts to seed missing domains, prep_level metadata, and non-duplicate multi-day plans idempotently\", \"ReplacementContent\":\"    // Seed audit log history showing full privacy lifecycle\\n    const insertAudit = db.prepare(\\n      `INSERT INTO media_access_audit_logs (id, actor_user_id, actor_role, submission_id, action, created_at)\\n       VALUES (?, ?, ?, ?, ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', ?))`\\n    );\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'upload\', \'-24 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'review_open\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'stream\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'parent_delete\', \'-2 hours\');\\n  });\\n\\n  insertTransaction();\\n  ensureStructuredDailyPlans(db);\\n}\\n\\n/**\\n * Idempotently ensures rich 6-domain coverage, preparation-level metadata, and realistic\\n * multi-day plans (Today + Upcoming Days) with zero duplicate activities per day.\\n */\\nfunction ensureStructuredDailyPlans(db: Database.Database): void {\\n  const EXTRA_ACTIVITIES: Array<SeedActivityDef & { id: string; prepLevel: \'no_prep\' | \'quick_setup\' | \'guided_prep\' }> = [\\n    {\\n      id: \'act_ext_6_9m_social\',\\n      ageSlug: \'6-9m\',\\n      domainSlug: \'social-emotional\',\\n      prepLevel: \'no_prep\',\\n      title: \'Warm Mirror Greeting & Name Smile\',\\n      summary: \'Strengthen joyful recognition and emotional security through unhurried side-by-side mirror smiles.\',\\n      durationMinutes: 5,\\n      materials: [\'Baby-safe low wall mirror\', \'Soft cotton mat\'],\\n      safetyNotes: \'Ensure the mirror is shatterproof and firmly secured against the wall.\',\\n      posterUrl: EDITORIAL_IMAGES.tummyMirror,\\n      steps: [\\n        { title: \'Sit side-by-side comfortably\', instructionText: \'Sit beside baby on the floor mat facing the low mirror so both of your reflections are clear.\', caregiverTip: \'Keep your posture relaxed and warm.\' },\\n        { title: \'Greet gently by name\', instructionText: \'Wave softly at the reflection and say baby\342\200\231s name followed by \342\200\234and Mama are right here.\342\200\235\', caregiverTip: \'Pause so baby can study both faces.\' },\\n        { title: \'Mirror baby\342\200\231s expressions\', instructionText: \'Gently reflect any smile, widened eyes, or happy sound baby makes without rushing.\', caregiverTip: \'Warm mirroring builds emotional confidence.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe low mirror positioning\', description: \'Caregiver positioned baby safely beside a stable mirror.\', weightPoints: 25 },\\n        { label: \'Warm side-by-side presence\', description: \'Caregiver stayed at eye level sharing calm focus.\', weightPoints: 25 },\\n        { label: \'Responsive mirroring & pauses\', description: \'Caregiver echoed baby\342\200\231s expressions and waited gently.\', weightPoints: 50 },\\n      ],\\n    },\\n    {\\n      id: \'act_ext_0_3m_lang\',\\n      ageSlug: \'0-3m\',\\n      domainSlug: \'language\',\\n      prepLevel: \'no_prep\',\\n      title: \'Soft Lullaby & Humming Pause\',\\n      summary: \'Soothe and introduce natural speech rhythm with a slow family lullaby.\',\\n      durationMinutes: 4,\\n      materials: [\'Quiet room or sunlit corner\'],\\n      safetyNotes: \'Hold baby securely supporting head and neck throughout.\',\\n      posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n      steps: [\\n        { title: \'Hold baby comfortably close\', instructionText: \'Cradle baby gently with steady head support so they feel your calm breathing.\', caregiverTip: \'Lower room lights slightly if bright.\' },\\n        { title: \'Hum two slow lines\', instructionText: \'Hum or sing a familiar lullaby slowly in a soft, natural speaking pitch.\', caregiverTip: \'Avoid loud or sudden volume changes.\' },\\n        { title: \'Pause and observe\', instructionText: \'Pause quietly for 5 seconds to notice baby\342\200\231s listening stillness or tiny vocalizations.\', caregiverTip: \'Gentle repetition feels comforting to newborns.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe supportive hold\', description: \'Caregiver supported newborn head and neck securely.\', weightPoints: 30 },\\n        { label: \'Calm slow vocal pacing\', description: \'Caregiver sang or hummed softly without rushing.\', weightPoints: 40 },\\n        { label: \'Attentive listening pause\', description: \'Caregiver paused calmly to observe baby\342\200\231s cues.\', weightPoints: 30 },\\n      ],\\n    },\\n    {\\n      id: \'act_ext_0_3m_phys\',\\n      ageSlug: \'0-3m\',\\n      domainSlug: \'physical\',\\n      prepLevel: \'no_prep\',\\n      title: \'Chest-to-Chest Gentle Head Lift\',\\n      summary: \'Offer comfortable early tummy-time warmth resting calmly on your reclined chest.\',\\n      durationMinutes: 3,\\n      materials: [\'Cushioned backrest for caregiver\'],\\n      safetyNotes: \'Stay fully awake and keep both hands supporting baby securely on your chest.\',\\n      posterUrl: EDITORIAL_IMAGES.tummyMirror,\\n      steps: [\\n        { title: \'Recline comfortably\', instructionText: \'Lean back at a gentle angle with pillows behind your shoulders.\', caregiverTip: \'A relaxed angle makes lifting easier for newborns.\' },\\n        { title: \'Place baby chest-to-chest\', instructionText: \'Rest baby on their tummy over your chest with hands tucked comfortably by their face.\', caregiverTip: \'Speak softly so they hear your familiar voice.\' },\\n        { title: \'End while calm\', instructionText: \'After 1\342\200\2232 minutes or at early tiredness, gently roll baby back into a cradled hold.\', caregiverTip: \'Short positive moments build steady comfort.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe reclined support\', description: \'Caregiver kept steady hands on baby throughout.\', weightPoints: 40 },\\n        { label: \'Warm verbal encouragement\', description: \'Caregiver spoke calmly at eye level.\', weightPoints: 30 },\\n        { label: \'Short respectful duration\', description: \'Caregiver ended gently before distress.\', weightPoints: 30 },\\n      ],\\n    },\\n    {\\n      id: \'act_ext_3_6m_sens\',\\n      ageSlug: \'3-6m\',\\n      domainSlug: \'sensory\',\\n      prepLevel: \'quick_setup\',\\n      title: \'Soft Cotton & Wooden Ring Grasp\',\\n      summary: \'Invite curious two-handed reaching using a lightweight muslin cloth and smooth wooden ring.\',\\n      durationMinutes: 5,\\n      materials: [\'Smooth unfinished wooden ring\', \'Soft cotton muslin cloth\'],\\n      safetyNotes: \'Inspect wooden ring for smoothness and stay seated beside baby throughout.\',\\n      posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n      steps: [\\n        { title: \'Lay baby comfortably on back\', instructionText: \'Spread a firm cotton mat in soft daylight.\', caregiverTip: \'Choose a calm alert window after feeds.\' },\\n        { title: \'Present the ring slowly\', instructionText: \'Hold the wooden ring steadily within easy reach above baby\342\200\231s chest.\', caregiverTip: \'Wait for baby to reach rather than placing it in their palm.\' },\\n        { title: \'Describe simply\', instructionText: \'When baby grasps or taps it, say warmly \342\200\234Smooth wood ring.\342\200\235\', caregiverTip: \'Follow baby\342\200\231s unhurried pace.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe material inspection\', description: \'Caregiver offered smooth, baby-safe natural items.\', weightPoints: 30 },\\n        { label: \'Patient reach distance\', description: \'Caregiver held object steadily for baby to reach.\', weightPoints: 40 },\\n        { label: \'Calm naming\', description: \'Caregiver narrated briefly without rushing.\', weightPoints: 30 },\\n      ],\\n    },\\n    {\\n      id: \'act_ext_9_12m_phys\',\\n      ageSlug: \'9-12m\',\\n      domainSlug: \'physical\',\\n      prepLevel: \'quick_setup\',\\n      title: \'Low Cushion Over-and-Around Crawl\',\\n      summary: \'Encourage joyful floor balance with one firm folded bolster cushion on the mat.\',\\n      durationMinutes: 6,\\n      materials: [\'Firm cotton mat\', \'1 flat folded cotton cushion or bolster\', \'Smooth wooden ring\'],\\n      safetyNotes: \'Clear surrounding hard furniture edges and supervise closely.\',\\n      posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n      steps: [\\n        { title: \'Place one low cushion\', instructionText: \'Set a firm, low folded cushion across the middle of the floor mat.\', caregiverTip: \'Keep the height low and inviting.\' },\\n        { title: \'Rest a familiar ring beyond\', instructionText: \'Place the wooden ring calmly on the far side of the cushion.\', caregiverTip: \'Let baby decide whether to crawl over or around.\' },\\n        { title: \'Celebrate effort quietly\', instructionText: \'Stay seated nearby smiling without lifting baby across.\', caregiverTip: \'Independent problem-solving builds joyful confidence.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe low obstacle setup\', description: \'Caregiver cleared open space and used a stable low cushion.\', weightPoints: 35 },\\n        { label: \'Independent movement invitation\', description: \'Caregiver avoided dragging or lifting baby over.\', weightPoints: 40 },\\n        { label: \'Calm warm encouragement\', description: \'Caregiver stayed attentive at floor level.\', weightPoints: 25 },\\n      ],\\n    },\\n    {\\n      id: \'act_ext_12_15m_sens\',\\n      ageSlug: \'12-15m\',\\n      domainSlug: \'sensory\',\\n      prepLevel: \'quick_setup\',\\n      title: \'Warm & Cool Steel Bowl Touch\',\\n      summary: \'Explore safe temperature contrast gently with two rounded steel bowls and a dry cloth.\',\\n      durationMinutes: 6,\\n      materials: [\'2 small steel katoris\', \'Lukewarm water & cool room-temperature water\', \'Cotton hand towel\'],\\n      safetyNotes: \'Always test warm water on your inner wrist first\342\200\224it should feel comfortably lukewarm, never hot.\',\\n      posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n      steps: [\\n        { title: \'Prepare lukewarm & cool bowls\', instructionText: \'Fill each bowl halfway with safe lukewarm or room-cool water on a low tray with a towel.\', caregiverTip: \'Keep water shallow and calm.\' },\\n        { title: \'Model dipping fingertips\', instructionText: \'Dip your fingertips gently and name \342\200\234Warm water\342\200\235 and \342\200\234Cool water.\342\200\235\', caregiverTip: \'Move slowly and calmly.\' },\\n        { title: \'Dry hands together\', instructionText: \'Offer the soft cotton towel afterward so toddler practices wiping their own hands.\', caregiverTip: \'Closing routines nurture independence.\' },\\n      ],\\n      rubric: [\\n        { label: \'Safe temperature & tray setup\', description: \'Caregiver prepared shallow safe water on a stable tray.\', weightPoints: 35 },\\n        { label: \'Clear gentle naming\', description: \'Caregiver named warm and cool clearly.\', weightPoints: 35 },\\n        { label: \'Independent hand-drying finish\', description: \'Caregiver invited toddler to dry hands calmly.\', weightPoints: 30 },\\n      ],\\n    },\\n  ];\\n\\n  const tx = db.transaction(() => {\\n    // 1. Set realistic prep_level on existing starter activities\\n    const prepUpdates: Array<[string, \'no_prep\' | \'quick_setup\' | \'guided_prep\']> = [\\n      [\'act_01\', \'no_prep\'],\\n      [\'act_02\', \'quick_setup\'],\\n      [\'act_03\', \'quick_setup\'],\\n      [\'act_04\', \'no_prep\'],\\n      [\'act_05\', \'quick_setup\'],\\n      [\'act_06\', \'no_prep\'],\\n      [\'act_07\', \'quick_setup\'],\\n      [\'act_08\', \'no_prep\'],\\n      [\'act_09\', \'guided_prep\'],\\n      [\'act_10\', \'quick_setup\'],\\n      [\'act_11\', \'no_prep\'],\\n      [\'act_12\', \'guided_prep\'],\\n      [\'act_13\', \'no_prep\'],\\n      [\'act_14\', \'guided_prep\'],\\n      [\'act_15\', \'quick_setup\'],\\n      [\'act_16\', \'no_prep\'],\\n    ];\\n    const updatePrep = db.prepare(\'UPDATE activities SET prep_level = ? WHERE id = ?\');\\n    for (const [id, level] of prepUpdates) {\\n      updatePrep.run(level, id);\\n    }\\n\\n    // 2. Insert any additional domain-balancing activities idempotently\\n    const insertAct = db.prepare(\\n      `INSERT OR IGNORE INTO activities (\\n         id, age_group_id, domain_id, title, summary, duration_minutes, prep_level,\\n         materials_json, safety_notes, instructional_poster_url, status, created_by\\n       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, \'published\', \'usr_admin_kavita\')`\\n    );\\n    const insertStep = db.prepare(\\n      `INSERT OR IGNORE INTO activity_steps (id, activity_id, step_number, title, instruction_text, caregiver_tip)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n    const insertRubric = db.prepare(\\n      `INSERT OR IGNORE INTO activity_rubric_criteria (id, activity_id, criterion_order, label, description, weight_points)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n\\n    for (const act of EXTRA_ACTIVITIES) {\\n      const ageId = `ag_${act.ageSlug}`;\\n      const domId = `dom_${act.domainSlug}`;\\n      insertAct.run(\\n        act.id,\\n        ageId,\\n        domId,\\n        act.title,\\n        act.summary,\\n        act.durationMinutes,\\n        act.prepLevel,\\n        JSON.stringify(act.materials),\\n        act.safetyNotes,\\n        act.posterUrl\\n      );\\n      act.steps.forEach((s, idx) => {\\n        insertStep.run(`${act.id}_step_${idx + 1}`, act.id, idx + 1, s.title, s.instructionText, s.caregiverTip);\\n      });\\n      act.rubric.forEach((r, idx) => {\\n        insertRubric.run(`${act.id}_rub_${idx + 1}`, act.id, idx + 1, r.label, r.description, r.weightPoints);\\n      });\\n    }\\n\\n    // 3. Ensure 6-9m Day 3 includes the 6th domain (Social & Emotional) without duplicating Day 1 activities unnecessarily\\n    const day3Plan = db\\n      .prepare(\\\"SELECT id FROM daily_plans WHERE age_group_id = \'ag_6-9m\' AND day_number = 3\\\")\\n      .get() as { id: string } | undefined;\\n    if (day3Plan) {\\n      const hasSocial = db\\n        .prepare(\\\"SELECT 1 FROM daily_plan_items WHERE daily_plan_id = ? AND activity_id = \'act_ext_6_9m_social\'\\\")\\n        .get(day3Plan.id);\\n      if (!hasSocial) {\\n        db.prepare(\'DELETE FROM daily_plan_items WHERE daily_plan_id = ?\').run(day3Plan.id);\\n        db.prepare(\'UPDATE daily_plans SET title = ?, focus_note = ? WHERE id = ?\').run(\\n          \'Day 3 \302\267 Warm Connection & Independence\',\\n          \'Balance emotional closeness by the mirror with calm, everyday floor confidence.\',\\n          day3Plan.id\\n        );\\n        const insItem = db.prepare(\\n          \'INSERT OR IGNORE INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order) VALUES (?, ?, ?, ?)\'\\n        );\\n        insItem.run(crypto.randomUUID(), day3Plan.id, \'act_ext_6_9m_social\', 1);\\n        insItem.run(crypto.randomUUID(), day3Plan.id, \'act_08\', 2);\\n      }\\n    }\\n\\n    // 4. Ensure every other age band with >= 3 activities has a structured Day 2 upcoming plan with zero duplicates\\n    const multiDaySeeds: Array<{\\n      ageSlug: string;\\n      dayNumber: number;\\n      title: string;\\n      focusNote: string;\\n      activityIds: string[];\\n    }> = [\\n      {\\n        ageSlug: \'0-3m\',\\n        dayNumber: 2,\\n        title: \'Day 2 \302\267 Soft Voices & Warmth\',\\n        focusNote: \'Two unhurried moments of voice rhythm and supported chest-to-chest bonding.\',\\n        activityIds: [\'act_ext_0_3m_lang\', \'act_ext_0_3m_phys\'],\\n      },\\n      {\\n        ageSlug: \'3-6m\',\\n        dayNumber: 2,\\n        title: \'Day 2 \302\267 Curious Reaching\',\\n        focusNote: \'Pair soft cotton texture exploration with gentle vocal turn-taking.\',\\n        activityIds: [\'act_ext_3_6m_sens\', \'act_04\'],\\n      },\\n      {\\n        ageSlug: \'9-12m\',\\n        dayNumber: 2,\\n        title: \'Day 2 \302\267 Steady Floor Movement\',\\n        focusNote: \'Build floor balance and warm confidence around familiar spaces.\',\\n        activityIds: [\'act_ext_9_12m_phys\', \'act_11\'],\\n      },\\n      {\\n        ageSlug: \'12-15m\',\\n        dayNumber: 2,\\n        title: \'Day 2 \302\267 Everyday Senses & Choices\',\\n        focusNote: \'Calm sensory discovery followed by meaningful two-item everyday choices.\',\\n        activityIds: [\'act_ext_12_15m_sens\', \'act_13\'],\\n      },\\n    ];\\n\\n    const insertPlan = db.prepare(\\n      `INSERT OR IGNORE INTO daily_plans (id, age_group_id, day_number, title, focus_note)\\n       VALUES (?, ?, ?, ?, ?)`\\n    );\\n    const insertItem = db.prepare(\\n      `INSERT OR IGNORE INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order)\\n       VALUES (?, ?, ?, ?)`\\n    );\\n\\n    for (const seedPlan of multiDaySeeds) {\\n      const ageId = `ag_${seedPlan.ageSlug}`;\\n      const existing = db\\n        .prepare(\'SELECT id FROM daily_plans WHERE age_group_id = ? AND day_number = ?\')\\n        .get(ageId, seedPlan.dayNumber) as { id: string } | undefined;\\n      if (!existing) {\\n        const planId = `plan_${seedPlan.ageSlug}_d${seedPlan.dayNumber}`;\\n        insertPlan.run(planId, ageId, seedPlan.dayNumber, seedPlan.title, seedPlan.focusNote);\\n        seedPlan.activityIds.forEach((actId, idx) => {\\n          insertItem.run(crypto.randomUUID(), planId, actId, idx + 1);\\n        });\\n      }\\n    }\\n  });\\n\\n  tx();\\n}\\n\", \"StartLine\":655, \"TargetContent\":\"    // Seed audit log history showing full privacy lifecycle\\n    const insertAudit = db.prepare(\\n      `INSERT INTO media_access_audit_logs (id, actor_user_id, actor_role, submission_id, action, created_at)\\n       VALUES (?, ?, ?, ?, ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', ?))`\\n    );\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'upload\', \'-24 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'review_open\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'stream\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'parent_delete\', \'-2 hours\');\\n  });\\n\\n  insertTransaction();\\n}\", \"TargetFile\":\"/server/db/seed.ts\", \"toolAction\":\"Adding multi-day 6-domain curriculum enrichment to seed.ts\", \"toolSummary\":\"Add structured multi-day plans to seed.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_13481422133758296533"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Enforce all Step 5 daily journey business rules, prepLevel mapping, upcoming days, learning week, and immutable completion history in repository\", \"Instruction\":\"Update listActivities, getActivityDetail, upsertDailyPlan, getJourneyForChild, and upsertActivityCompletion with strict business rules\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":33, \"ReplacementContent\":\"import type {\\n  ActivityDetail,\\n  ActivityPrepLevel,\\n  ActivityRubricCriterion,\\n  ActivityStatus,\\n  ActivityStep,\\n  ActivitySummary,\\n  AdminOverviewResponse,\\n  AgeGroup,\\n  ChildProfile,\\n  CompletedHistoryItem,\\n  CompletionStatus,\\n  DomainProgressStat,\\n  JourneyActivityItem,\\n  JourneyDisplayStatus,\\n  LearningDomain,\\n  LocaleCode,\\n  MediaAuditAction,\\n  MediaAuditLogItem,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\\n  UpcomingPlanDay,\\n  UserProfile,\\n  UserRole,\\n  VideoSubmissionSummary,\\n} from \'../../src/shared/types\';\", \"StartLine\":3, \"TargetContent\":\"import type {\\n  ActivityDetail,\\n  ActivityRubricCriterion,\\n  ActivityStatus,\\n  ActivityStep,\\n  ActivitySummary,\\n  AdminOverviewResponse,\\n  AgeGroup,\\n  ChildProfile,\\n  CompletionStatus,\\n  DomainProgressStat,\\n  JourneyActivityItem,\\n  LearningDomain,\\n  LocaleCode,\\n  MediaAuditAction,\\n  MediaAuditLogItem,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\\n  UserProfile,\\n  UserRole,\\n  VideoSubmissionSummary,\\n} from \'../../src/shared/types\';\"}, {\"AllowMultiple\":false, \"EndLine\":692, \"ReplacementContent\":\"      title: string;\\n      summary: string;\\n      duration_minutes: number;\\n      prep_level?: ActivityPrepLevel | null;\\n      materials_json: string;\\n      safety_notes: string;\\n      instructional_poster_url: string;\\n      status: ActivityStatus;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      ageGroupId: r.age_group_id,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      domainId: r.domain_id,\\n      domainSlug: r.domain_slug,\\n      domainName: r.domain_name,\\n      title: r.title,\\n      summary: r.summary,\\n      durationMinutes: r.duration_minutes,\\n      prepLevel: (r.prep_level as ActivityPrepLevel) || \'quick_setup\',\\n      materials: JSON.parse(r.materials_json) as string[],\\n      safetyNotes: r.safety_notes,\\n      instructionalPosterUrl: r.instructional_poster_url,\\n      status: r.status,\\n      createdAt: r.created_at,\\n    }));\\n  }\\n\\n  getActivityDetail(activityId: string): ActivityDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT a.*, ag.slug as age_group_slug, ag.label as age_group_label,\\n                ld.slug as domain_slug, ld.name as domain_name\\n         FROM activities a\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         WHERE a.id = ?`\\n      )\\n      .get(activityId) as\\n      | {\\n          id: string;\\n          age_group_id: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          domain_id: string;\\n          domain_slug: string;\\n          domain_name: string;\\n          title: string;\\n          summary: string;\\n          duration_minutes: number;\\n          prep_level?: ActivityPrepLevel | null;\\n          materials_json: string;\\n          safety_notes: string;\\n          instructional_poster_url: string;\\n          status: ActivityStatus;\\n          created_at: string;\\n        }\\n      | undefined;\\n    if (!row) return null;\\n\\n    const steps = (\\n      this.db\\n        .prepare(\'SELECT * FROM activity_steps WHERE activity_id = ? ORDER BY step_number ASC\')\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        step_number: number;\\n        title: string;\\n        instruction_text: string;\\n        caregiver_tip: string | null;\\n      }>\\n    ).map<ActivityStep>((s) => ({\\n      id: s.id,\\n      activityId: s.activity_id,\\n      stepNumber: s.step_number,\\n      title: s.title,\\n      instructionText: s.instruction_text,\\n      caregiverTip: s.caregiver_tip,\\n    }));\\n\\n    const rubricCriteria = (\\n      this.db\\n        .prepare(\\n          \'SELECT * FROM activity_rubric_criteria WHERE activity_id = ? ORDER BY criterion_order ASC\'\\n        )\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        criterion_order: number;\\n        label: string;\\n        description: string;\\n        weight_points: number;\\n      }>\\n    ).map<ActivityRubricCriterion>((c) => ({\\n      id: c.id,\\n      activityId: c.activity_id,\\n      criterionOrder: c.criterion_order,\\n      label: c.label,\\n      description: c.description,\\n      weightPoints: c.weight_points,\\n    }));\\n\\n    return {\\n      id: row.id,\\n      ageGroupId: row.age_group_id,\\n      ageGroupSlug: row.age_group_slug,\\n      ageGroupLabel: row.age_group_label,\\n      domainId: row.domain_id,\\n      domainSlug: row.domain_slug,\\n      domainName: row.domain_name,\\n      title: row.title,\\n      summary: row.summary,\\n      durationMinutes: row.duration_minutes,\\n      prepLevel: (row.prep_level as ActivityPrepLevel) || \'quick_setup\',\\n      materials: JSON.parse(row.materials_json) as string[],\\n      safetyNotes: row.safety_notes,\\n      instructionalPosterUrl: row.instructional_poster_url,\\n      status: row.status,\\n      createdAt: row.created_at,\\n      steps,\\n      rubricCriteria,\\n    };\\n  }\", \"StartLine\":560, \"TargetContent\":\"      title: string;\\n      summary: string;\\n      duration_minutes: number;\\n      materials_json: string;\\n      safety_notes: string;\\n      instructional_poster_url: string;\\n      status: ActivityStatus;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      ageGroupId: r.age_group_id,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      domainId: r.domain_id,\\n      domainSlug: r.domain_slug,\\n      domainName: r.domain_name,\\n      title: r.title,\\n      summary: r.summary,\\n      durationMinutes: r.duration_minutes,\\n      materials: JSON.parse(r.materials_json) as string[],\\n      safetyNotes: r.safety_notes,\\n      instructionalPosterUrl: r.instructional_poster_url,\\n      status: r.status,\\n      createdAt: r.created_at,\\n    }));\\n  }\\n\\n  getActivityDetail(activityId: string): ActivityDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT a.*, ag.slug as age_group_slug, ag.label as age_group_label,\\n                ld.slug as domain_slug, ld.name as domain_name\\n         FROM activities a\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         WHERE a.id = ?`\\n      )\\n      .get(activityId) as\\n      | {\\n          id: string;\\n          age_group_id: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          domain_id: string;\\n          domain_slug: string;\\n          domain_name: string;\\n          title: string;\\n          summary: string;\\n          duration_minutes: number;\\n          materials_json: string;\\n          safety_notes: string;\\n          instructional_poster_url: string;\\n          status: ActivityStatus;\\n          created_at: string;\\n        }\\n      | undefined;\\n    if (!row) return null;\\n\\n    const steps = (\\n      this.db\\n        .prepare(\'SELECT * FROM activity_steps WHERE activity_id = ? ORDER BY step_number ASC\')\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        step_number: number;\\n        title: string;\\n        instruction_text: string;\\n        caregiver_tip: string | null;\\n      }>\\n    ).map<ActivityStep>((s) => ({\\n      id: s.id,\\n      activityId: s.activity_id,\\n      stepNumber: s.step_number,\\n      title: s.title,\\n      instructionText: s.instruction_text,\\n      caregiverTip: s.caregiver_tip,\\n    }));\\n\\n    const rubricCriteria = (\\n      this.db\\n        .prepare(\\n          \'SELECT * FROM activity_rubric_criteria WHERE activity_id = ? ORDER BY criterion_order ASC\'\\n        )\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        criterion_order: number;\\n        label: string;\\n        description: string;\\n        weight_points: number;\\n      }>\\n    ).map<ActivityRubricCriterion>((c) => ({\\n      id: c.id,\\n      activityId: c.activity_id,\\n      criterionOrder: c.criterion_order,\\n      label: c.label,\\n      description: c.description,\\n      weightPoints: c.weight_points,\\n    }));\\n\\n    return {\\n      id: row.id,\\n      ageGroupId: row.age_group_id,\\n      ageGroupSlug: row.age_group_slug,\\n      ageGroupLabel: row.age_group_label,\\n      domainId: row.domain_id,\\n      domainSlug: row.domain_slug,\\n      domainName: row.domain_name,\\n      title: row.title,\\n      summary: row.summary,\\n      durationMinutes: row.duration_minutes,\\n      materials: JSON.parse(row.materials_json) as string[],\\n      safetyNotes: row.safety_notes,\\n      instructionalPosterUrl: row.instructional_poster_url,\\n      status: row.status,\\n      createdAt: row.created_at,\\n      steps,\\n      rubricCriteria,\\n    };\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":1295, \"ReplacementContent\":\"      const insertItem = this.db.prepare(\\n        \'INSERT INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order) VALUES (?, ?, ?, ?)\'\\n      );\\n      // Business rule: prevent duplicate activities within a daily plan and verify matching age group\\n      const uniqueActivityIds = Array.from(new Set(params.activityIds));\\n      uniqueActivityIds.forEach((actId, idx) => {\\n        const act = this.getActivityDetail(actId);\\n        if (act && act.ageGroupId === params.ageGroupId) {\\n          insertItem.run(crypto.randomUUID(), planId, actId, idx + 1);\\n        }\\n      });\\n    });\\n    tx();\\n  }\\n\\n  /**\\n   * Business rule: An activity is ONLY marked \'reviewed\' when a real submission_reviews record exists,\\n   * and only \'submitted_for_review\' when an active queued/in_review submission exists.\\n   */\\n  private resolveEffectiveDisplayStatus(\\n    completionStatus: CompletionStatus | null,\\n    latestSubmission: VideoSubmissionSummary | null\\n  ): JourneyDisplayStatus {\\n    if (latestSubmission?.review) {\\n      return \'reviewed\';\\n    }\\n    if (\\n      latestSubmission &&\\n      (latestSubmission.reviewStatus === \'queued\' || latestSubmission.reviewStatus === \'in_review\')\\n    ) {\\n      return \'submitted_for_review\';\\n    }\\n    if (\\n      completionStatus === \'completed\' ||\\n      completionStatus === \'submitted_for_review\' ||\\n      completionStatus === \'reviewed\'\\n    ) {\\n      return \'completed\';\\n    }\\n    if (completionStatus === \'started\') {\\n      return \'in_progress\';\\n    }\\n    return \'not_started\';\\n  }\\n\\n  private computeLearningWeek(child: ChildProfile) {\\n    const ageGroup = this.findAgeGroupBySlug(child.ageGroupSlug);\\n    const minMonths = ageGroup?.minMonths ?? 0;\\n    const maxMonths = ageGroup?.maxMonths ?? 3;\\n    const totalStageWeeks = Math.max(1, (maxMonths - minMonths) * 4);\\n    const monthsIntoStage = Math.max(0, child.ageInMonths - minMonths);\\n    const weekNumber = Math.min(totalStageWeeks, Math.max(1, monthsIntoStage * 4 + 1));\\n    return {\\n      weekNumber,\\n      totalStageWeeks,\\n      stageLabel: child.ageGroupLabel,\\n      todayDateIso: new Date().toISOString().slice(0, 10),\\n    };\\n  }\\n\\n  getJourneyForChild(child: ChildProfile, requestedDayNumber?: number) {\\n    const plans = this.listDailyPlansForAgeGroup(child.activeAgeGroupId);\\n    const availableDays = plans.map((p) => ({\\n      dayNumber: p.dayNumber,\\n      title: p.title,\\n      focusNote: p.focusNote,\\n    }));\\n\\n    const selectedPlan =\\n      plans.find((p) => p.dayNumber === requestedDayNumber) ??\\n      plans[0] ?? {\\n        id: \'fallback\',\\n        ageGroupId: child.activeAgeGroupId,\\n        dayNumber: 1,\\n        title: \'Day 1 \302\267 Calm Discovery\',\\n        focusNote: \'Gentle, age-appropriate activities for today.\',\\n        activityIds: this.listActivities({\\n          ageGroupId: child.activeAgeGroupId,\\n          status: \'published\',\\n        })\\n          .slice(0, 3)\\n          .map((a) => a.id),\\n      };\\n\\n    const items: JourneyActivityItem[] = [];\\n    const seenActivityIds = new Set<string>();\\n    selectedPlan.activityIds.forEach((actId, idx) => {\\n      // Business rule: never duplicate activities within the same daily plan\\n      if (seenActivityIds.has(actId)) return;\\n      const activity = this.getActivityDetail(actId);\\n      // Business rule: strictly filter activities by the baby\'s active age group & published status\\n      if (!activity || activity.status !== \'published\' || activity.ageGroupId !== child.activeAgeGroupId) {\\n        return;\\n      }\\n      seenActivityIds.add(actId);\\n\\n      const comp = this.db\\n        .prepare(\\n          `SELECT id, status, caregiver_notes, completed_at\\n           FROM activity_completions\\n           WHERE child_id = ? AND activity_id = ?\\n           ORDER BY COALESCE(last_opened_at, completed_at, created_at) DESC LIMIT 1`\\n        )\\n        .get(child.id, actId) as\\n        | {\\n            id: string;\\n            status: CompletionStatus;\\n            caregiver_notes: string | null;\\n            completed_at: string | null;\\n          }\\n        | undefined;\\n\\n      const latestSubmission = this.findLatestSubmissionForChildActivity(child.id, actId);\\n      const displayStatus = this.resolveEffectiveDisplayStatus(\\n        comp?.status ?? null,\\n        latestSubmission\\n      );\\n\\n      items.push({\\n        planItemId: `${selectedPlan.id}_${actId}`,\\n        sortOrder: idx + 1,\\n        activity,\\n        displayStatus,\\n        completion: comp\\n          ? {\\n              id: comp.id,\\n              status: comp.status,\\n              caregiverNotes: comp.caregiver_notes,\\n              completedAt: comp.completed_at,\\n            }\\n          : null,\\n        latestSubmission,\\n      });\\n    });\\n\\n    const completedTodayCount = items.filter(\\n      (i) =>\\n        i.displayStatus === \'completed\' ||\\n        i.displayStatus === \'submitted_for_review\' ||\\n        i.displayStatus === \'reviewed\'\\n    ).length;\\n    const totalTodayCount = items.length;\\n    const completionPct =\\n      totalTodayCount > 0 ? Math.round((completedTodayCount / totalTodayCount) * 100) : 0;\\n\\n    // Build upcoming days strictly from child\'s active age group, without duplicate activities per day\\n    const upcomingDays: UpcomingPlanDay[] = [];\\n    const todayDate = new Date();\\n    plans\\n      .filter((p) => p.dayNumber > selectedPlan.dayNumber)\\n      .forEach((plan, idx) => {\\n        const scheduled = new Date(todayDate);\\n        scheduled.setDate(todayDate.getDate() + idx + 1);\\n        const daySeen = new Set<string>();\\n        const acts: ActivitySummary[] = [];\\n        for (const aid of plan.activityIds) {\\n          if (daySeen.has(aid)) continue;\\n          const detail = this.getActivityDetail(aid);\\n          if (!detail || detail.status !== \'published\' || detail.ageGroupId !== child.activeAgeGroupId) {\\n            continue;\\n          }\\n          daySeen.add(aid);\\n          acts.push(detail);\\n        }\\n        if (acts.length > 0) {\\n          upcomingDays.push({\\n            dayNumber: plan.dayNumber,\\n            title: plan.title,\\n            focusNote: plan.focusNote,\\n            scheduledDate: scheduled.toISOString().slice(0, 10),\\n            activities: acts,\\n          });\\n        }\\n      });\\n\\n    const inProgressItems = this.listInProgressItemsForChild(child);\\n    const completedHistory = this.listCompletedHistoryForChild(child.id);\\n    const domainProgress = this.getDomainProgressForChild(child.id, child.activeAgeGroupId);\\n    const weeklyProgress = this.getWeeklyProgressForChild(child.id);\\n    const lastActivity = this.getLastOpenedActivityForChild(child.id);\\n    const recentSubmissions = this.listSubmissionsForChild(child.id);\\n    const parentingTip = this.getParentingTipForAgeGroup(child.ageGroupSlug);\\n    const parent = this.findUserById(child.parentUserId);\\n    const notifications = this.buildParentNotifications(parent, child, recentSubmissions, items);\\n    const learningWeek = this.computeLearningWeek(child);\\n\\n    return {\\n      child,\\n      learningWeek,\\n      availableDays,\\n      selectedDay: {\\n        id: selectedPlan.id,\\n        dayNumber: selectedPlan.dayNumber,\\n        title: selectedPlan.title,\\n        focusNote: selectedPlan.focusNote,\\n      },\\n      todaySummary: {\\n        completedTodayCount,\\n        totalTodayCount,\\n        completionPct,\\n      },\\n      items,\\n      upcomingDays,\\n      inProgressItems,\\n      completedHistory,\\n      weeklyProgress,\\n      domainProgress,\\n      lastActivity,\\n      parentingTip,\\n      notifications,\\n      recentSubmissions,\\n    };\\n  }\\n\\n  private listInProgressItemsForChild(child: ChildProfile): JourneyActivityItem[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT id, activity_id, status, caregiver_notes, completed_at\\n         FROM activity_completions\\n         WHERE child_id = ? AND status = \'started\'\\n         ORDER BY COALESCE(last_opened_at, created_at) DESC\\n         LIMIT 5`\\n      )\\n      .all(child.id) as Array<{\\n      id: string;\\n      activity_id: string;\\n      status: CompletionStatus;\\n      caregiver_notes: string | null;\\n      completed_at: string | null;\\n    }>;\\n\\n    const results: JourneyActivityItem[] = [];\\n    const seen = new Set<string>();\\n    rows.forEach((row, idx) => {\\n      if (seen.has(row.activity_id)) return;\\n      const activity = this.getActivityDetail(row.activity_id);\\n      if (!activity || activity.status !== \'published\' || activity.ageGroupId !== child.activeAgeGroupId) {\\n        return;\\n      }\\n      const latestSubmission = this.findLatestSubmissionForChildActivity(child.id, row.activity_id);\\n      const displayStatus = this.resolveEffectiveDisplayStatus(row.status, latestSubmission);\\n      if (displayStatus !== \'in_progress\') return;\\n      seen.add(row.activity_id);\\n      results.push({\\n        planItemId: `inprog_${row.id}`,\\n        sortOrder: idx + 1,\\n        activity,\\n        displayStatus,\\n        completion: {\\n          id: row.id,\\n          status: row.status,\\n          caregiverNotes: row.caregiver_notes,\\n          completedAt: row.completed_at,\\n        },\\n        latestSubmission,\\n      });\\n    });\\n    return results;\\n  }\\n\\n  /**\\n   * Returns immutable historical completion records across all age stages.\\n   * Changing the baby\'s age later never rewrites age_group_id_snapshot / age_group_label_snapshot.\\n   */\\n  listCompletedHistoryForChild(childId: string): CompletedHistoryItem[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT ac.id, ac.activity_id, ac.plan_date, ac.status, ac.caregiver_notes,\\n                COALESCE(ac.completed_at, ac.created_at) as completed_at,\\n                COALESCE(ac.age_group_id_snapshot, a.age_group_id) as age_group_id_snapshot,\\n                COALESCE(ac.age_group_label_snapshot, ag.label) as age_group_label_snapshot,\\n                a.title as activity_title, a.duration_minutes, a.prep_level,\\n                ld.name as domain_name, ld.slug as domain_slug\\n         FROM activity_completions ac\\n         JOIN activities a ON a.id = ac.activity_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         WHERE ac.child_id = ?\\n           AND ac.status IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n         ORDER BY COALESCE(ac.completed_at, ac.created_at) DESC\\n         LIMIT 50`\\n      )\\n      .all(childId) as Array<{\\n      id: string;\\n      activity_id: string;\\n      plan_date: string;\\n      status: CompletionStatus;\\n      caregiver_notes: string | null;\\n      completed_at: string;\\n      age_group_id_snapshot: string;\\n      age_group_label_snapshot: string;\\n      activity_title: string;\\n      duration_minutes: number;\\n      prep_level: ActivityPrepLevel | null;\\n      domain_name: string;\\n      domain_slug: string;\\n    }>;\\n\\n    return rows.map((r) => {\\n      const latestSubmission = this.findLatestSubmissionForChildActivity(childId, r.activity_id);\\n      const displayStatus = this.resolveEffectiveDisplayStatus(r.status, latestSubmission);\\n      return {\\n        completionId: r.id,\\n        activityId: r.activity_id,\\n        activityTitle: r.activity_title,\\n        domainName: r.domain_name,\\n        domainSlug: r.domain_slug,\\n        durationMinutes: r.duration_minutes,\\n        prepLevel: r.prep_level || \'quick_setup\',\\n        planDate: r.plan_date,\\n        completedAt: r.completed_at,\\n        caregiverNotes: r.caregiver_notes,\\n        ageGroupIdSnapshot: r.age_group_id_snapshot,\\n        ageGroupLabelSnapshot: r.age_group_label_snapshot,\\n        displayStatus,\\n        reviewScorePct: latestSubmission?.review?.instructionMatchScorePct ?? null,\\n      };\\n    });\\n  }\\n\\n  getWeeklyProgressForChild(childId: string) {\\n    const today = new Date();\\n    const dayNames = [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n    const days: Array<{ date: string; dayLabel: string; completedCount: number; isToday: boolean }> = [];\\n\\n    for (let offset = 6; offset >= 0; offset -= 1) {\\n      const d = new Date(today);\\n      d.setDate(today.getDate() - offset);\\n      const iso = d.toISOString().slice(0, 10);\\n      const row = this.db\\n        .prepare(\\n          `SELECT COUNT(*) as cnt\\n           FROM activity_completions\\n           WHERE child_id = ?\\n             AND plan_date = ?\\n             AND status IN (\'completed\', \'submitted_for_review\', \'reviewed\')`\\n        )\\n        .get(childId, iso) as { cnt: number };\\n\\n      days.push({\\n        date: iso,\\n        dayLabel: dayNames[d.getDay()],\\n        completedCount: row.cnt,\\n        isToday: offset === 0,\\n      });\\n    }\\n    return days;\\n  }\\n\\n  getLastOpenedActivityForChild(childId: string) {\\n    const row = this.db\\n      .prepare(\\n        `SELECT activity_id, status, COALESCE(last_opened_at, completed_at, created_at) as touched_at\\n         FROM activity_completions\\n         WHERE child_id = ?\\n         ORDER BY COALESCE(last_opened_at, completed_at, created_at) DESC\\n         LIMIT 1`\\n      )\\n      .get(childId) as\\n      | { activity_id: string; status: CompletionStatus; touched_at: string }\\n      | undefined;\\n\\n    if (!row) return null;\\n    const activity = this.getActivityDetail(row.activity_id);\\n    if (!activity || activity.status !== \'published\') return null;\\n    const latestSubmission = this.findLatestSubmissionForChildActivity(childId, row.activity_id);\\n    return {\\n      activity,\\n      status: row.status,\\n      displayStatus: this.resolveEffectiveDisplayStatus(row.status, latestSubmission),\\n      updatedAt: row.touched_at,\\n    };\\n  }\\n\\n  private getParentingTipForAgeGroup(ageGroupSlug: string) {\\n    const tips: Record<string, { title: string; body: string; focusArea: string }> = {\\n      \'0-3m\': {\\n        title: \'Slow down and pause for five quiet seconds\',\\n        body: \'Newborns take a few extra moments to process faces and voices. After smiling or speaking softly, wait calmly so your baby has space to respond in their own rhythm.\',\\n        focusArea: \'Social & emotional bonding\',\\n      },\\n      \'3-6m\': {\\n        title: \'Get down to your baby\342\200\231s eye level on the mat\',\\n        body: \'Resting on the floor beside your baby during tummy time makes exploration feel safe and reassuring\342\200\224two calm minutes is worth more than a rushed long session.\',\\n        focusArea: \'Physical comfort\',\\n      },\\n      \'6-9m\': {\\n        title: \'Offer fewer objects for deeper calm focus\',\\n        body: \'Placing just two or three safe household textures on a clean mat invites unhurried curiosity. When your hands stay quiet in your lap, your baby practices choosing freely.\',\\n        focusArea: \'Sensory & focus\',\\n      },\\n      \'9-12m\': {\\n        title: \'Narrate transitions before they happen\',\\n        body: \'Before picking your baby up or stepping across the room, say softly what happens next. Predictable everyday language builds deep trust and early vocabulary together.\',\\n        focusArea: \'Language & trust\',\\n      },\\n      \'12-15m\': {\\n        title: \'Let small attempts finish without stepping in\',\\n        body: \'When your toddler tries stacking a ring or holding an open cup, pausing before helping lets them experience the quiet satisfaction of adjusting and trying again.\',\\n        focusArea: \'Early independence\',\\n      },\\n      \'15-18m\': {\\n        title: \'Turn everyday moments into shared participation\',\\n        body: \'Handing your child a small folded cotton cloth to wipe a few water drops turns ordinary home routines into joyful, purposeful practice.\',\\n        focusArea: \'Everyday skills\',\\n      },\\n      \'18-21m\': {\\n        title: \'Describe what you notice instead of quizzing\',\\n        body: \'Saying \342\200\234You put the smooth wooden spoons in the bowl\342\200\235 encourages concentration far more calmly than asking repeated test questions.\',\\n        focusArea: \'Cognitive curiosity\',\\n      },\\n      \'21-24m\': {\\n        title: \'Name everyday feelings with a calm voice\',\\n        body: \'Putting simple words to happy, sleepy, or frustrated moments helps toddlers gradually recognize what they feel while knowing you are steady beside them.\',\\n        focusArea: \'Emotional awareness\',\\n      },\\n    };\\n    const chosen = tips[ageGroupSlug] ?? tips[\'6-9m\'];\\n    return {\\n      id: `tip_${ageGroupSlug}`,\\n      ageGroupSlug,\\n      ...chosen,\\n    };\\n  }\\n\\n  private buildParentNotifications(\\n    parent: UserProfile | null,\\n    child: ChildProfile,\\n    submissions: VideoSubmissionSummary[],\\n    todayItems: JourneyActivityItem[]\\n  ) {\\n    const notifications: Array<{\\n      id: string;\\n      kind: \'review_ready\' | \'submission_queued\' | \'email_verify\' | \'daily_rhythm\';\\n      title: string;\\n      description: string;\\n      createdAt: string;\\n      actionLabel?: string;\\n      targetSection?: \'today\' | \'my-plan\' | \'activities\' | \'progress\' | \'verify-email\';\\n    }> = [];\\n\\n    if (parent && !parent.emailVerifiedAt) {\\n      notifications.push({\\n        id: \'notif_verify_email\',\\n        kind: \'email_verify\',\\n        title: \'Confirm your email address\',\\n        description: `Verify ${parent.email} so you can recover your account safely anytime.`,\\n        createdAt: parent.createdAt,\\n        actionLabel: \'Verify Email\',\\n        targetSection: \'verify-email\',\\n      });\\n    }\\n\\n    submissions.slice(0, 4).forEach((sub) => {\\n      if (sub.review) {\\n        notifications.push({\\n          id: `notif_rev_${sub.id}`,\\n          kind: \'review_ready\',\\n          title: `Caregiver feedback ready for ${sub.activityTitle}`,\\n          description: `Instruction-match ${sub.review.instructionMatchScorePct}% \302\267 Includes strengths and a gentle next-time tip from ${sub.review.reviewerName}.`,\\n          createdAt: sub.review.submittedAt,\\n          actionLabel: \'View Feedback\',\\n          targetSection: \'progress\',\\n        });\\n      } else if (sub.reviewStatus === \'queued\' || sub.reviewStatus === \'in_review\') {\\n        notifications.push({\\n          id: `notif_q_${sub.id}`,\\n          kind: \'submission_queued\',\\n          title: `Practice clip received for ${sub.activityTitle}`,\\n          description:\\n            sub.reviewStatus === \'in_review\'\\n              ? \'A caregiver coach is reviewing your clip privately.\'\\n              : \'Stored privately in your vault and queued for coaching feedback.\',\\n          createdAt: sub.createdAt,\\n          actionLabel: \'Check Status\',\\n          targetSection: \'progress\',\\n        });\\n      }\\n    });\\n\\n    const remaining = todayItems.filter(\\n      (i) => i.displayStatus === \'not_started\' || i.displayStatus === \'in_progress\'\\n    ).length;\\n\\n    if (remaining > 0) {\\n      notifications.push({\\n        id: `notif_today_${child.id}`,\\n        kind: \'daily_rhythm\',\\n        title: `${remaining} gentle ${remaining === 1 ? \'activity\' : \'activities\'} ready for ${child.displayName}`,\\n        description: `Matched to the ${child.ageGroupLabel} stage whenever your little one is rested and alert.`,\\n        createdAt: new Date().toISOString(),\\n        actionLabel: \'View Today\',\\n        targetSection: \'today\',\\n      });\\n    }\\n\\n    return notifications;\\n  }\\n\\n  getDomainProgressForChild(childId: string, ageGroupId?: string): DomainProgressStat[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT ld.id, ld.slug, ld.name,\\n                COUNT(DISTINCT ac.id) as completed_count,\\n                (\\n                  SELECT COUNT(*)\\n                  FROM activities a2\\n                  WHERE a2.domain_id = ld.id\\n                    AND a2.status = \'published\'\\n                    AND (? IS NULL OR a2.age_group_id = ?)\\n                ) as stage_available_count,\\n                (\\n                  SELECT COUNT(*)\\n                  FROM activities a3\\n                  WHERE a3.domain_id = ld.id\\n                    AND a3.status = \'published\'\\n                ) as total_available_count\\n         FROM learning_domains ld\\n         LEFT JOIN activities a ON a.domain_id = ld.id\\n         LEFT JOIN activity_completions ac\\n           ON ac.activity_id = a.id\\n           AND ac.child_id = ?\\n           AND ac.status IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n         GROUP BY ld.id\\n         ORDER BY ld.sort_order ASC`\\n      )\\n      .all(ageGroupId ?? null, ageGroupId ?? null, childId) as Array<{\\n      id: string;\\n      slug: string;\\n      name: string;\\n      completed_count: number;\\n      stage_available_count: number;\\n      total_available_count: number;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      domainId: r.id,\\n      domainSlug: r.slug,\\n      domainName: r.name,\\n      completedCount: r.completed_count,\\n      availableCount: Math.max(1, r.stage_available_count || r.total_available_count || 1),\\n    }));\\n  }\\n\\n  upsertActivityCompletion(params: {\\n    childId: string;\\n    activityId: string;\\n    status: CompletionStatus;\\n    caregiverNotes?: string | null;\\n  }): { id: string; status: CompletionStatus } {\\n    // Business rule: a completion must NEVER be marked \'reviewed\' unless a real submission review exists\\n    let safeRequestedStatus: CompletionStatus = params.status;\\n    if (safeRequestedStatus === \'reviewed\') {\\n      const latestSub = this.findLatestSubmissionForChildActivity(params.childId, params.activityId);\\n      if (!latestSub?.review) {\\n        safeRequestedStatus = \'completed\';\\n      }\\n    }\\n\\n    const planDate = new Date().toISOString().slice(0, 10);\\n    const existing = this.db\\n      .prepare(\\n        \'SELECT id, status FROM activity_completions WHERE child_id = ? AND activity_id = ? AND plan_date = ?\'\\n      )\\n      .get(params.childId, params.activityId, planDate) as\\n      | { id: string; status: CompletionStatus }\\n      | undefined;\\n\\n    if (existing) {\\n      // Never downgrade an already completed/submitted/reviewed activity back to \'started\'\\n      const nextStatus: CompletionStatus =\\n        safeRequestedStatus === \'started\' && existing.status !== \'started\'\\n          ? existing.status\\n          : safeRequestedStatus;\\n\\n      this.db\\n        .prepare(\\n          `UPDATE activity_completions\\n           SET status = ?,\\n               caregiver_notes = COALESCE(?, caregiver_notes),\\n               last_opened_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'),\\n               completed_at = CASE WHEN ? IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n                                   THEN COALESCE(completed_at, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n                                   ELSE completed_at END\\n           WHERE id = ?`\\n        )\\n        .run(nextStatus, params.caregiverNotes ?? null, nextStatus, existing.id);\\n      return { id: existing.id, status: nextStatus };\\n    }\\n\\n    // Snapshot the activity\'s age group so later baby DOB changes never silently rewrite historical records\\n    const activity = this.getActivityDetail(params.activityId);\\n    const id = `comp_${crypto.randomUUID().slice(0, 10)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO activity_completions (\\n           id, child_id, activity_id, plan_date, status, caregiver_notes,\\n           age_group_id_snapshot, age_group_label_snapshot,\\n           last_opened_at, completed_at\\n         )\\n         VALUES (\\n           ?, ?, ?, ?, ?, ?, ?, ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'),\\n           CASE WHEN ? IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n                THEN strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\') ELSE NULL END\\n         )`\\n      )\\n      .run(\\n        id,\\n        params.childId,\\n        params.activityId,\\n        planDate,\\n        safeRequestedStatus,\\n        params.caregiverNotes?.trim() || null,\\n        activity?.ageGroupId ?? null,\\n        activity?.ageGroupLabel ?? null,\\n        safeRequestedStatus\\n      );\\n    return { id, status: safeRequestedStatus };\\n  }\", \"StartLine\":895, \"TargetContent\":\"      const insertItem = this.db.prepare(\\n        \'INSERT INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order) VALUES (?, ?, ?, ?)\'\\n      );\\n      params.activityIds.forEach((actId, idx) => {\\n        insertItem.run(crypto.randomUUID(), planId, actId, idx + 1);\\n      });\\n    });\\n    tx();\\n  }\\n\\n  getJourneyForChild(child: ChildProfile, requestedDayNumber?: number) {\\n    const plans = this.listDailyPlansForAgeGroup(child.activeAgeGroupId);\\n    const availableDays = plans.map((p) => ({\\n      dayNumber: p.dayNumber,\\n      title: p.title,\\n      focusNote: p.focusNote,\\n    }));\\n\\n    const selectedPlan =\\n      plans.find((p) => p.dayNumber === requestedDayNumber) ??\\n      plans[0] ?? {\\n        id: \'fallback\',\\n        ageGroupId: child.activeAgeGroupId,\\n        dayNumber: 1,\\n        title: \'Day 1 \302\267 Calm Discovery\',\\n        focusNote: \'Gentle, age-appropriate activities for today.\',\\n        activityIds: this.listActivities({\\n          ageGroupId: child.activeAgeGroupId,\\n          status: \'published\',\\n        })\\n          .slice(0, 3)\\n          .map((a) => a.id),\\n      };\\n\\n    const items: JourneyActivityItem[] = [];\\n    selectedPlan.activityIds.forEach((actId, idx) => {\\n      const activity = this.getActivityDetail(actId);\\n      if (!activity || activity.status !== \'published\') return;\\n\\n      const comp = this.db\\n        .prepare(\\n          `SELECT id, status, caregiver_notes, completed_at\\n           FROM activity_completions\\n           WHERE child_id = ? AND activity_id = ?\\n           ORDER BY COALESCE(last_opened_at, completed_at, created_at) DESC LIMIT 1`\\n        )\\n        .get(child.id, actId) as\\n        | {\\n            id: string;\\n            status: CompletionStatus;\\n            caregiver_notes: string | null;\\n            completed_at: string | null;\\n          }\\n        | undefined;\\n\\n      const latestSubmission = this.findLatestSubmissionForChildActivity(child.id, actId);\\n\\n      items.push({\\n        planItemId: `${selectedPlan.id}_${actId}`,\\n        sortOrder: idx + 1,\\n        activity,\\n        completion: comp\\n          ? {\\n              id: comp.id,\\n              status: comp.status,\\n              caregiverNotes: comp.caregiver_notes,\\n              completedAt: comp.completed_at,\\n            }\\n          : null,\\n        latestSubmission,\\n      });\\n    });\\n\\n    const completedTodayCount = items.filter(\\n      (i) =>\\n        i.completion?.status === \'completed\' ||\\n        i.completion?.status === \'submitted_for_review\' ||\\n        i.completion?.status === \'reviewed\'\\n    ).length;\\n    const totalTodayCount = items.length;\\n    const completionPct =\\n      totalTodayCount > 0 ? Math.round((completedTodayCount / totalTodayCount) * 100) : 0;\\n\\n    const domainProgress = this.getDomainProgressForChild(child.id, child.activeAgeGroupId);\\n    const weeklyProgress = this.getWeeklyProgressForChild(child.id);\\n    const lastActivity = this.getLastOpenedActivityForChild(child.id);\\n    const recentSubmissions = this.listSubmissionsForChild(child.id);\\n    const parentingTip = this.getParentingTipForAgeGroup(child.ageGroupSlug);\\n    const parent = this.findUserById(child.parentUserId);\\n    const notifications = this.buildParentNotifications(parent, child, recentSubmissions, items);\\n\\n    return {\\n      child,\\n      availableDays,\\n      selectedDay: {\\n        id: selectedPlan.id,\\n        dayNumber: selectedPlan.dayNumber,\\n        title: selectedPlan.title,\\n        focusNote: selectedPlan.focusNote,\\n      },\\n      todaySummary: {\\n        completedTodayCount,\\n        totalTodayCount,\\n        completionPct,\\n      },\\n      items,\\n      weeklyProgress,\\n      domainProgress,\\n      lastActivity,\\n      parentingTip,\\n      notifications,\\n      recentSubmissions,\\n    };\\n  }\\n\\n  getWeeklyProgressForChild(childId: string) {\\n    const today = new Date();\\n    const dayNames = [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n    const days: Array<{ date: string; dayLabel: string; completedCount: number; isToday: boolean }> = [];\\n\\n    for (let offset = 6; offset >= 0; offset -= 1) {\\n      const d = new Date(today);\\n      d.setDate(today.getDate() - offset);\\n      const iso = d.toISOString().slice(0, 10);\\n      const row = this.db\\n        .prepare(\\n          `SELECT COUNT(*) as cnt\\n           FROM activity_completions\\n           WHERE child_id = ?\\n             AND plan_date = ?\\n             AND status IN (\'completed\', \'submitted_for_review\', \'reviewed\')`\\n        )\\n        .get(childId, iso) as { cnt: number };\\n\\n      days.push({\\n        date: iso,\\n        dayLabel: dayNames[d.getDay()],\\n        completedCount: row.cnt,\\n        isToday: offset === 0,\\n      });\\n    }\\n    return days;\\n  }\\n\\n  getLastOpenedActivityForChild(childId: string) {\\n    const row = this.db\\n      .prepare(\\n        `SELECT activity_id, status, COALESCE(last_opened_at, completed_at, created_at) as touched_at\\n         FROM activity_completions\\n         WHERE child_id = ?\\n         ORDER BY COALESCE(last_opened_at, completed_at, created_at) DESC\\n         LIMIT 1`\\n      )\\n      .get(childId) as\\n      | { activity_id: string; status: CompletionStatus; touched_at: string }\\n      | undefined;\\n\\n    if (!row) return null;\\n    const activity = this.getActivityDetail(row.activity_id);\\n    if (!activity || activity.status !== \'published\') return null;\\n    return {\\n      activity,\\n      status: row.status,\\n      updatedAt: row.touched_at,\\n    };\\n  }\\n\\n  private getParentingTipForAgeGroup(ageGroupSlug: string) {\\n    const tips: Record<string, { title: string; body: string; focusArea: string }> = {\\n      \'0-3m\': {\\n        title: \'Slow down and pause for five quiet seconds\',\\n        body: \'Newborns take a few extra moments to process faces and voices. After smiling or speaking softly, wait calmly so your baby has space to respond in their own rhythm.\',\\n        focusArea: \'Social & emotional bonding\',\\n      },\\n      \'3-6m\': {\\n        title: \'Get down to your baby\342\200\231s eye level on the mat\',\\n        body: \'Resting on the floor beside your baby during tummy time makes exploration feel safe and reassuring\342\200\224two calm minutes is worth more than a rushed long session.\',\\n        focusArea: \'Physical comfort\',\\n      },\\n      \'6-9m\': {\\n        title: \'Offer fewer objects for deeper calm focus\',\\n        body: \'Placing just two or three safe household textures on a clean mat invites unhurried curiosity. When your hands stay quiet in your lap, your baby practices choosing freely.\',\\n        focusArea: \'Sensory & focus\',\\n      },\\n      \'9-12m\': {\\n        title: \'Narrate transitions before they happen\',\\n        body: \'Before picking your baby up or stepping across the room, say softly what happens next. Predictable everyday language builds deep trust and early vocabulary together.\',\\