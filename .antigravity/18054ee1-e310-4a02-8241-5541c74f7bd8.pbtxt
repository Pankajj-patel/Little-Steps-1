            lines {
              text: "    title: \'Two-Handed Open Cup Sip Practice\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Introduce a tiny splash of water in a small open steel cup with calm guidance.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Small baby-sized open steel cup (1\342\200\2232 tsp water)\', \'Soft linen napkin\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Baby must be seated upright with steady head and trunk support. Use only 1\342\200\2232 teaspoons of water at a time to prevent coughing.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.everydayCup,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Ensure upright seating\', instructionText: \'Seat baby comfortably upright in your lap or a supportive chair with the napkin nearby.\', caregiverTip: \'Never offer liquids while reclined.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Pour a tiny amount\', instructionText: \'Add just one or two teaspoons of water so tilting stays easy and mess stays small.\', caregiverTip: \'Spills are completely normal practice.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Guide hands together\', instructionText: \'Rest your hands gently over baby\342\200\231s hands on the cup, bring the rim to the lower lip, and tip slightly.\', caregiverTip: \'Pause after one small sip.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Wipe gently and narrate\', instructionText: \'Set the cup down together and dab chin calmly with the napkin: \342\200\234All done, warm cloth.\342\200\235\', caregiverTip: \'Keep the mood relaxed and encouraging.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Upright safe seating\', description: \'Caregiver ensured upright posture throughout drinking.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Small water portion\', description: \'Caregiver filled cup with only a tiny safe sip amount.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Gentle hand-over-hand support\', description: \'Caregiver tipped cup slowly and paused between sips.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Calm wipe-and-narrate closure\', description: \'Caregiver handled drips calmly without rushing or scolding.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
