    tool_calls {
      id: "call_4033236578715604357"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Award,\\n  Camera,\\n  CheckCircle2,\\n  Clock,\\n  Film,\\n  Info,\\n  RefreshCw,\\n  RotateCcw,\\n  Shield,\\n  Square,\\n  Trash2,\\n  Upload,\\n  UploadCloud,\\n  Video,\\n  X,\\n} from \'lucide-react\';\\nimport {\\n  Badge,\\n  Button,\\n  Card,\\n  ProgressIndicator,\\n  type BadgeTone,\\n} from \'../design-system\';\\nimport { api } from \'../lib/api\';\\nimport { MAX_VIDEO_DURATION_SECONDS, MAX_VIDEO_SIZE_BYTES } from \'../shared/domain\';\\nimport type {\\n  VideoStorageStatusResponse,\\n  VideoSubmissionSummary,\\n} from \'../shared/types\';\\n\\nexport type SubmissionUiState =\\n  | \'draft\'\\n  | \'uploading\'\\n  | \'submitted\'\\n  | \'under_review\'\\n  | \'reviewed\'\\n  | \'changes_requested\'\\n  | \'failed\';\\n\\nexport function mapServerSubmissionToUiState(\\n  sub: VideoSubmissionSummary | null | undefined\\n): SubmissionUiState | null {\\n  if (!sub) return null;\\n  if (sub.review || sub.reviewStatus === \'reviewed\') return \'reviewed\';\\n  if (sub.reviewStatus === \'resubmit_requested\') return \'changes_requested\';\\n  if (sub.reviewStatus === \'in_review\') return \'under_review\';\\n  if (sub.reviewStatus === \'queued\') return \'submitted\';\\n  return null;\\n}\\n\\nexport function getSubmissionStateBadge(state: SubmissionUiState): {\\n  label: string;\\n  tone: BadgeTone;\\n  description: string;\\n  icon: React.ReactNode;\\n} {\\n  switch (state) {\\n    case \'draft\':\\n      return {\\n        label: \'Draft\',\\n        tone: \'neutral\',\\n        description: \'Record or choose a short clip, preview it, and confirm consent before submitting.\',\\n        icon: <Video className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'uploading\':\\n      return {\\n        label: \'Uploading\',\\n        tone: \'peach\',\\n        description: \'Uploading your practice clip. Keep this tab open until progress reaches 100%.\',\\n        icon: <UploadCloud className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'submitted\':\\n      return {\\n        label: \'Submitted\',\\n        tone: \'lavender\',\\n        description: \'Your clip has been received and is waiting in the caregiver coaching queue.\',\\n        icon: <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'under_review\':\\n      return {\\n        label: \'Under review\',\\n        tone: \'lavender\',\\n        description: \'A caregiver coach is currently reviewing your clip against the activity steps.\',\\n        icon: <Clock className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'reviewed\':\\n      return {\\n        label: \'Reviewed\',\\n        tone: \'sage\',\\n        description: \'Caregiver coaching feedback and instruction-match guidance are ready to read.\',\\n        icon: <Award className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'changes_requested\':\\n      return {\\n        label: \'Changes requested\',\\n        tone: \'peach\',\\n        description: \'Your reviewer asked for a clearer or updated clip. You can record or upload a new one below.\',\\n        icon: <RotateCcw className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n    case \'failed\':\\n      return {\\n        label: \'Failed\',\\n        tone: \'danger\',\\n        description: \'The upload did not complete. Your prepared clip is still here\342\200\224tap Retry Upload or replace it.\',\\n        icon: <AlertTriangle className=\\\"w-3.5 h-3.5\\\" aria-hidden=\\\"true\\\" />,\\n      };\\n  }\\n}\\n\\ninterface VideoCaptureUploaderProps {\\n  childId: string;\\n  childName: string;\\n  activityId: string;\\n  activityTitle: string;\\n  activityVersion: number;\\n  initialMode?: \'record\' | \'upload\';\\n  existingSubmission?: VideoSubmissionSummary | null;\\n  onSubmitted: (submission: VideoSubmissionSummary) => void;\\n  onCancel: () => void;\\n}\\n\\nexport function VideoCaptureUploader({\\n  childId,\\n  childName,\\n  activityId,\\n  activityTitle,\\n  activityVersion,\\n  initialMode,\\n  existingSubmission,\\n  onSubmitted,\\n  onCancel,\\n}: VideoCaptureUploaderProps) {\\n  const [selectedFile, setSelectedFile] = useState<Blob | null>(null);\\n  const [filename, setFilename] = useState<string>(\'practice.webm\');\\n  const [previewUrl, setPreviewUrl] = useState<string | null>(null);\\n  const [durationSeconds, setDurationSeconds] = useState<number>(10);\\n  const [caregiverNotes, setCaregiverNotes] = useState(\'\');\\n  const [consentConfirmed, setConsentConfirmed] = useState(false);\\n\\n  const [isRecording, setIsRecording] = useState(false);\\n  const [isGeneratingSample, setIsGeneratingSample] = useState(false);\\n  const [recordSeconds, setRecordSeconds] = useState(0);\\n  const [uiState, setUiState] = useState<SubmissionUiState>(\\n    existingSubmission?.reviewStatus === \'resubmit_requested\' ? \'changes_requested\' : \'draft\'\\n  );\\n  const [uploadProgress, setUploadProgress] = useState(0);\\n  const [error, setError] = useState<string | null>(null);\\n  const [storageStatus, setStorageStatus] = useState<VideoStorageStatusResponse | null>(null);\\n\\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\\n  const liveVideoRef = useRef<HTMLVideoElement | null>(null);\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n  const streamRef = useRef<MediaStream | null>(null);\\n  const chunksRef = useRef<Blob[]>([]);\\n  const timerRef = useRef<number | null>(null);\\n  const abortControllerRef = useRef<AbortController | null>(null);\\n  const recordSecondsRef = useRef<number>(0);\\n\\n  // Fetch honest storage mode status (Demo Local Vault vs Production Private Object Storage)\\n  useEffect(() => {\\n    let active = true;\\n    api\\n      .getVideoStorageStatus()\\n      .then((status) => {\\n        if (active) setStorageStatus(status);\\n      })\\n      .catch(() => {\\n        if (active) {\\n          setStorageStatus({\\n            mode: \'demo_local_vault\',\\n            providerLabel: \'Demo Local Vault (Isolated Prototype Storage)\',\\n            isProductionConfigured: false,\\n            maxSizeBytes: MAX_VIDEO_SIZE_BYTES,\\n            maxDurationSeconds: MAX_VIDEO_DURATION_SECONDS,\\n            allowedMimeTypes: [\'video/mp4\', \'video/webm\', \'video/quicktime\'],\\n            retentionDays: 30,\\n            warningNotice:\\n              \'Demo Mode: Production private cloud object storage (GCS/S3) is not configured in this prototype. Please use the 3-second test clip or non-sensitive sample videos rather than real personal child recordings.\',\\n          });\\n        }\\n      });\\n    return () => {\\n      active = false;\\n    };\\n  }, []);\\n\\n  const cleanupCamera = () => {\\n    if (timerRef.current) {\\n      window.clearInterval(timerRef.current);\\n      timerRef.current = null;\\n    }\\n    if (streamRef.current) {\\n      streamRef.current.getTracks().forEach((t) => t.stop());\\n      streamRef.current = null;\\n    }\\n  };\\n\\n  useEffect(() => {\\n    return () => {\\n      abortControllerRef.current?.abort();\\n      cleanupCamera();\\n      if (previewUrl) URL.revokeObjectURL(previewUrl);\\n    };\\n  }, [previewUrl]);\\n\\n  const setPreparedVideo = (blob: Blob, name: string, seconds: number) => {\\n    if (previewUrl) URL.revokeObjectURL(previewUrl);\\n    const url = URL.createObjectURL(blob);\\n    setSelectedFile(blob);\\n    setFilename(name);\\n    setDurationSeconds(Math.max(1, Math.min(MAX_VIDEO_DURATION_SECONDS, Math.round(seconds))));\\n    setPreviewUrl(url);\\n    setError(null);\\n    setUiState(\'draft\');\\n  };\\n\\n  const handleRemoveVideo = () => {\\n    if (previewUrl) URL.revokeObjectURL(previewUrl);\\n    setPreviewUrl(null);\\n    setSelectedFile(null);\\n    setFilename(\'practice.webm\');\\n    setError(null);\\n    setUploadProgress(0);\\n    setUiState(\\n      existingSubmission?.reviewStatus === \'resubmit_requested\' ? \'changes_requested\' : \'draft\'\\n    );\\n    if (fileInputRef.current) {\\n      fileInputRef.current.value = \'\';\\n    }\\n  };\\n\\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    if (file.size === 0) {\\n      setError(\'The selected file appears to be empty. Please pick another video clip.\');\\n      return;\\n    }\\n    if (file.size > MAX_VIDEO_SIZE_BYTES) {\\n      setError(\'Please choose a video smaller than 50 MB.\');\\n      return;\\n    }\\n    const normalized = file.type.split(\';\')[0].trim().toLowerCase();\\n    if (![\'video/mp4\', \'video/webm\', \'video/quicktime\'].includes(normalized)) {\\n      setError(\'Only MP4, WebM, or MOV video files are supported.\');\\n      return;\\n    }\\n    const tempUrl = URL.createObjectURL(file);\\n    const probe = document.createElement(\'video\');\\n    probe.preload = \'metadata\';\\n    probe.onloadedmetadata = () => {\\n      const dur = Number.isFinite(probe.duration) ? probe.duration : 15;\\n      URL.revokeObjectURL(tempUrl);\\n      if (dur > MAX_VIDEO_DURATION_SECONDS) {\\n        setError(\'Please keep activity clips at 2 minutes (120 seconds) or shorter.\');\\n        return;\\n      }\\n      setPreparedVideo(file, file.name, dur);\\n    };\\n    probe.onerror = () => {\\n      URL.revokeObjectURL(tempUrl);\\n      setPreparedVideo(file, file.name, 15);\\n    };\\n    probe.src = tempUrl;\\n    e.target.value = \'\';\\n  };\\n\\n  /**\\n   * Requests camera/audio ONLY when parent explicitly clicks \\\"Record Activity\\\".\\n   * Falls back to video-only if microphone is unavailable so no unnecessary permissions block recording.\\n   */\\n  const startCameraRecording = async () => {\\n    setError(null);\\n    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === \'undefined\') {\\n      setError(\\n        \'Camera recording is not supported in this browser. You can upload a video from your device or create a 3-second demo clip below.\'\\n      );\\n      return;\\n    }\\n    try {\\n      let stream: MediaStream;\\n      try {\\n        stream = await navigator.mediaDevices.getUserMedia({\\n          video: { facingMode: \'user\' },\\n          audio: true,\\n        });\\n      } catch {\\n        // Fallback to video-only if mic permission is declined or absent\\n        stream = await navigator.mediaDevices.getUserMedia({\\n          video: true,\\n          audio: false,\\n        });\\n      }\\n      streamRef.current = stream;\\n      setIsRecording(true);\\n      setRecordSeconds(0);\\n      recordSecondsRef.current = 0;\\n\\n      // Wait a tick for the live video element to mount before attaching srcObject\\n      window.setTimeout(() => {\\n        if (liveVideoRef.current && streamRef.current) {\\n          liveVideoRef.current.srcObject = streamRef.current;\\n          void liveVideoRef.current.play().catch(() => {});\\n        }\\n      }, 30);\\n\\n      chunksRef.current = [];\\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm;codecs=vp8\')\\n        ? \'video/webm;codecs=vp8\'\\n        : MediaRecorder.isTypeSupported(\'video/webm\')\\n          ? \'video/webm\'\\n          : \'\';\\n      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);\\n      mediaRecorderRef.current = recorder;\\n\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data.size > 0) chunksRef.current.push(ev.data);\\n      };\\n      recorder.onstop = () => {\\n        const blob = new Blob(chunksRef.current, { type: \'video/webm\' });\\n        const recordedDur = Math.max(1, recordSecondsRef.current);\\n        cleanupCamera();\\n        setIsRecording(false);\\n        if (blob.size > 0) {\\n          setPreparedVideo(blob, `littlesteps-activity-${Date.now()}.webm`, recordedDur);\\n        }\\n      };\\n\\n      recorder.start(250);\\n      timerRef.current = window.setInterval(() => {\\n        recordSecondsRef.current += 1;\\n        setRecordSeconds(recordSecondsRef.current);\\n        if (recordSecondsRef.current >= MAX_VIDEO_DURATION_SECONDS) {\\n          recorder.stop();\\n        }\\n      }, 1000);\\n    } catch {\\n      cleanupCamera();\\n      setIsRecording(false);\\n      setError(\\n        \'Camera access was declined or unavailable. You can upload an existing video from your device or generate a 3-second demo sample clip.\'\\n      );\\n    }\\n  };\\n\\n  const stopCameraRecording = () => {\\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state !== \'inactive\') {\\n      mediaRecorderRef.current.stop();\\n    }\\n  };\\n\\n  const cancelCameraRecording = () => {\\n    chunksRef.current = [];\\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state !== \'inactive\') {\\n      mediaRecorderRef.current.onstop = () => {\\n        cleanupCamera();\\n        setIsRecording(false);\\n      };\\n      mediaRecorderRef.current.stop();\\n    } else {\\n      cleanupCamera();\\n      setIsRecording(false);\\n    }\\n  };\\n\\n  /**\\n   * Generates a real binary WebM clip via Canvas + MediaRecorder for demo testing\\n   * without needing a camera or uploading real personal child footage in Demo Mode.\\n   */\\n  const recordSampleTestClip = async () => {\\n    setError(null);\\n    if (typeof MediaRecorder === \'undefined\') {\\n      setError(\'Sample clip recording is unavailable in this browser. Please upload a video file instead.\');\\n      return;\\n    }\\n    setIsGeneratingSample(true);\\n    try {\\n      const canvas = document.createElement(\'canvas\');\\n      canvas.width = 640;\\n      canvas.height = 360;\\n      const ctx = canvas.getContext(\'2d\');\\n      if (!ctx) throw new Error(\'Canvas unavailable\');\\n\\n      const stream = canvas.captureStream(20);\\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm\') ? \'video/webm\' : \'\';\\n      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);\\n      const chunks: Blob[] = [];\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data.size > 0) chunks.push(ev.data);\\n      };\\n\\n      const done = new Promise<Blob>((resolve) => {\\n        recorder.onstop = () => {\\n          stream.getTracks().forEach((t) => t.stop());\\n          resolve(new Blob(chunks, { type: \'video/webm\' }));\\n        };\\n      });\\n\\n      recorder.start();\\n      let frame = 0;\\n      const drawInterval = window.setInterval(() => {\\n        frame += 1;\\n        ctx.fillStyle = \'#FBF9F5\';\\n        ctx.fillRect(0, 0, 640, 360);\\n        ctx.strokeStyle = \'#E5DFD3\';\\n        ctx.lineWidth = 2;\\n        ctx.strokeRect(24, 24, 592, 312);\\n\\n        const radius = 34 + Math.sin(frame / 8) * 10;\\n        ctx.beginPath();\\n        ctx.arc(320, 140, radius, 0, Math.PI * 2);\\n        ctx.fillStyle = \'#E8EFE9\';\\n        ctx.fill();\\n        ctx.strokeStyle = \'#4A6B5D\';\\n        ctx.lineWidth = 2;\\n        ctx.stroke();\\n\\n        ctx.fillStyle = \'#2B2D2A\';\\n        ctx.font = \'600 20px Georgia, serif\';\\n        ctx.textAlign = \'center\';\\n        ctx.fillText(activityTitle.slice(0, 44), 320, 232);\\n\\n        ctx.fillStyle = \'#656963\';\\n        ctx.font = \'14px sans-serif\';\\n        ctx.fillText(\\n          `Demo Practice Clip \302\267 00:0${Math.min(3, Math.floor(frame / 20))}`,\\n          320,\\n          266\\n        );\\n        ctx.fillText(\'Non-sensitive sample clip for LittleSteps workflow preview\', 320, 292);\\n      }, 50);\\n\\n      await new Promise((r) => window.setTimeout(r, 3000));\\n      window.clearInterval(drawInterval);\\n      recorder.stop();\\n      const blob = await done;\\n      setPreparedVideo(blob, `demo-sample-${Date.now()}.webm`, 3);\\n    } catch {\\n      setError(\'Could not generate a sample clip in this browser. Please upload a video file instead.\');\\n    } finally {\\n      setIsGeneratingSample(false);\\n    }\\n  };\\n\\n  const executeUpload = async () => {\\n    if (!selectedFile) {\\n      setError(\'Please record or upload a practice video first.\');\\n      return;\\n    }\\n    if (!consentConfirmed) {\\n      setError(\'Please confirm your consent checkbox before submitting for review.\');\\n      return;\\n    }\\n\\n    const controller = new AbortController();\\n    abortControllerRef.current = controller;\\n    setUiState(\'uploading\');\\n    setUploadProgress(5);\\n    setError(null);\\n\\n    try {\\n      const { submission } = await api.uploadSubmissionVideo(\\n        {\\n          childId,\\n          activityId,\\n          file: selectedFile,\\n          filename,\\n          durationSeconds,\\n          caregiverNotes,\\n          consentConfirmed,\\n        },\\n        (pct) => setUploadProgress(pct),\\n        controller.signal\\n      );\\n      abortControllerRef.current = null;\\n      setUiState(\'submitted\');\\n      onSubmitted(submission);\\n    } catch (err) {\\n      abortControllerRef.current = null;\\n      setUiState(\'failed\');\\n      setError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Upload did not complete. Please check your connection and try again.\'\\n      );\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    await executeUpload();\\n  };\\n\\n  const handleCancelUpload = () => {\\n    if (abortControllerRef.current) {\\n      abortControllerRef.current.abort();\\n      abortControllerRef.current = null;\\n    }\\n  };\\n\\n  const stateBadge = getSubmissionStateBadge(uiState);\\n  const isUploading = uiState === \'uploading\';\\n  const isDemoMode = !storageStatus || !storageStatus.isProductionConfigured;\\n\\n  return (\\n    <Card padding=\\\"lg\\\" className=\\\"space-y-6\\\">\\n      <form onSubmit={handleSubmit} className=\\\"space-y-6\\\">\\n        {/* Hidden shared file input for both initial Upload and Replace Video */}\\n        <input\\n          ref={fileInputRef}\\n          type=\\\"file\\\"\\n          accept=\\\"video/mp4,video/webm,video/quicktime\\\"\\n          onChange={handleFileChange}\\n          className=\\\"sr-only\\\"\\n          aria-label=\\\"Choose a video file from your device\\\"\\n        />\\n\\n        {/* Header + Active Submission Status */}\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-4 border-b border-border pb-4\\\">\\n          <div className=\\\"space-y-1.5\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <Badge tone={stateBadge.tone} icon={stateBadge.icon}>\\n                {stateBadge.label}\\n              </Badge>\\n              <Badge tone=\\\"neutral\\\">\\n                Activity v{activityVersion} \302\267 {childName}\\n              </Badge>\\n            </div>\\n            <h2 className=\\\"font-display text-xl sm:text-2xl font-semibold text-charcoal\\\">\\n              Submit Practice Video for Caregiver Feedback\\n            </h2>\\n            <p className=\\\"text-sm text-muted leading-relaxed max-w-2xl\\\">\\n              {stateBadge.description}\\n            </p>\\n          </div>\\n\\n          <Button\\n            type=\\\"button\\\"\\n            variant=\\\"subtle\\\"\\n            size=\\\"sm\\\"\\n            disabled={isUploading}\\n            leftIcon={<X className=\\\"w-4 h-4\\\" />}\\n            onClick={onCancel}\\n          >\\n            Close\\n          </Button>\\n        </div>\\n\\n        {/* Honest Demo Storage Disclosure Banner when production object storage is not configured */}\\n        {isDemoMode && (\\n          <div\\n            role=\\\"note\\\"\\n            className=\\\"rounded-xl border border-peach bg-peach-soft/60 p-4 flex items-start gap-3\\\"\\n          >\\n            <AlertTriangle className=\\\"w-5 h-5 text-peach-ink shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n            <div className=\\\"space-y-1 text-xs sm:text-sm\\\">\\n              <p className=\\\"font-semibold text-charcoal\\\">\\n                Demo Storage Mode Active \302\267 Prototype Environment\\n              </p>\\n              <p className=\\\"text-charcoal/85 leading-relaxed\\\">\\n                {storageStatus?.warningNotice ||\\n                  \'Production private cloud object storage (GCS/S3) is not configured in this prototype. Clips are isolated outside public folders with short-lived signed links for testing, but please use the 3-second demo test clip or non-sensitive sample videos instead of real personal child recordings.\'}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Reviewer Changes Requested Note (when resubmitting) */}\\n        {existingSubmission?.reviewStatus === \'resubmit_requested\' &&\\n          existingSubmission.changeRequestNote && (\\n            <div className=\\\"rounded-xl border border-peach bg-cream p-4 space-y-1\\\">\\n              <p className=\\\"text-xs font-semibold text-peach-ink uppercase tracking-wide\\\">\\n                Reviewer Note \302\267 Changes Requested\\n              </p>\\n              <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                {existingSubmission.changeRequestNote}\\n              </p>\\n            </div>\\n          )}\\n\\n        {/* ================================================================= */}\\n        {/* STEP A: RECORD OR UPLOAD CHOOSER (NO UNNECESSARY PERMISSIONS)     */}\\n        {/* ================================================================= */}\\n        {!isRecording && !previewUrl && (\\n          <div className=\\\"space-y-4\\\">\\n            {/* Large Recording Button + Upload from Device */}\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void startCameraRecording()}\\n                className={`min-h-[120px] p-6 rounded-xl border-2 text-left flex flex-col justify-between gap-3 transition-colors cursor-pointer ${\\n                  initialMode === \'record\'\\n                    ? \'border-sage bg-sage-soft/50 hover:bg-sage-soft\'\\n                    : \'border-sage/70 bg-sage-soft/30 hover:bg-sage-soft/60\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between w-full\\\">\\n                  <span className=\\\"w-11 h-11 rounded-xl bg-sage text-white inline-flex items-center justify-center shrink-0\\\">\\n                    <Camera className=\\\"w-5 h-5\\\" aria-hidden=\\\"true\\\" />\\n                  </span>\\n                  <Badge tone=\\\"sage\\\">Recommended</Badge>\\n                </div>\\n                <div className=\\\"space-y-0.5\\\">\\n                  <p className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n                    Record Activity\\n                  </p>\\n                  <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n                    Opens your camera only when you tap here. Keep clips calm and under 2 minutes.\\n                  </p>\\n                </div>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => fileInputRef.current?.click()}\\n                className={`min-h-[120px] p-6 rounded-xl border text-left flex flex-col justify-between gap-3 transition-colors cursor-pointer ${\\n                  initialMode === \'upload\'\\n                    ? \'border-sage bg-cream hover:bg-cream/80\'\\n                    : \'border-border-strong bg-offwhite hover:bg-cream\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between w-full\\\">\\n                  <span className=\\\"w-11 h-11 rounded-xl bg-surface border border-border text-sage inline-flex items-center justify-center shrink-0\\\">\\n                    <Upload className=\\\"w-5 h-5\\\" aria-hidden=\\\"true\\\" />\\n                  </span>\\n                  <span className=\\\"font-mono text-xs text-muted\\\">MP4 \302\267 WebM \302\267 MOV</span>\\n                </div>\\n                <div className=\\\"space-y-0.5\\\">\\n                  <p className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n                    Upload from Device\\n                  </p>\\n                  <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n                    Select a clip you already recorded on your phone or computer.\\n                  </p>\\n                </div>\\n              </button>\\n            </div>\\n\\n            {/* Safe Demo Sample Clip Generator + File Size & Format Guidance */}\\n            <div className=\\\"rounded-xl border border-border bg-offwhite p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <div className=\\\"flex items-start gap-2.5 text-xs text-muted leading-relaxed\\\">\\n                <Info className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n                <div>\\n                  <p className=\\\"font-medium text-charcoal\\\">\\n                    Format & Size Guidance\\n                  </p>\\n                  <p>\\n                    Accepted formats: <strong>MP4, WebM, MOV</strong> \302\267 Max file size:{\' \'}\\n                    <span className=\\\"font-mono tabular-nums\\\">50 MB</span> \302\267 Max length:{\' \'}\\n                    <span className=\\\"font-mono tabular-nums\\\">2 minutes</span>.\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"secondary\\\"\\n                size=\\\"sm\\\"\\n                loading={isGeneratingSample}\\n                leftIcon={<Film className=\\\"w-4 h-4\\\" />}\\n                onClick={() => void recordSampleTestClip()}\\n                className=\\\"shrink-0 self-start sm:self-center\\\"\\n              >\\n                {isGeneratingSample ? \'Creating 3s Demo Clip...\' : \'Use 3s Demo Test Clip\'}\\n              </Button>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* ================================================================= */}\\n        {/* LIVE CAMERA RECORDING VIEW                                        */}\\n        {/* ================================================================= */}\\n        {isRecording && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"aspect-video rounded-xl overflow-hidden bg-charcoal relative border border-border\\\">\\n              <video\\n                ref={liveVideoRef}\\n                muted\\n                playsInline\\n                className=\\\"w-full h-full object-cover\\\"\\n              />\\n              <div className=\\\"absolute top-3 left-3 px-3 py-1.5 rounded-lg bg-charcoal/85 text-white text-xs font-mono tabular-nums inline-flex items-center gap-2\\\">\\n                <span className=\\\"w-2 h-2 rounded-full bg-danger animate-pulse\\\" aria-hidden=\\\"true\\\" />\\n                Recording \302\267 {String(Math.floor(recordSeconds / 60)).padStart(2, \'0\')}:\\n                {String(recordSeconds % 60).padStart(2, \'0\')} / 02:00\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"danger\\\"\\n                size=\\\"lg\\\"\\n                leftIcon={<Square className=\\\"w-4 h-4\\\" />}\\n                onClick={stopCameraRecording}\\n              >\\n                Stop & Preview Recording\\n              </Button>\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"secondary\\\"\\n                size=\\\"md\\\"\\n                onClick={cancelCameraRecording}\\n              >\\n                Cancel Recording\\n              </Button>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* ================================================================= */}\\n        {/* VIDEO PREVIEW WITH REPLACE & REMOVE ACTIONS                       */}\\n        {/* ================================================================= */}\\n        {previewUrl && !isRecording && (\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"aspect-video rounded-xl overflow-hidden bg-charcoal border border-border\\\">\\n              <video\\n                src={previewUrl}\\n                controls\\n                playsInline\\n                className=\\\"w-full h-full object-contain\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"rounded-xl border border-border bg-offwhite px-4 py-3 flex flex-wrap items-center justify-between gap-3\\\">\\n              <div className=\\\"flex items-center gap-2 text-xs text-muted min-w-0\\\">\\n                <Video className=\\\"w-4 h-4 text-sage shrink-0\\\" aria-hidden=\\\"true\\\" />\\n                <span className=\\\"font-medium text-charcoal truncate\\\">{filename}</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span className=\\\"font-mono tabular-nums\\\">{durationSeconds}s</span>\\n                {selectedFile && (\\n                  <>\\n                    <span aria-hidden=\\\"true\\\">\302\267</span>\\n                    <span className=\\\"font-mono tabular-nums\\\">\\n                      {(selectedFile.size / (1024 * 1024)).toFixed(2)} MB\\n                    </span>\\n                  </>\\n                )}\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                <Button\\n                  type=\\\"button\\\"\\n                  variant=\\\"secondary\\\"\\n                  size=\\\"sm\\\"\\n                  disabled={isUploading}\\n                  leftIcon={<RefreshCw className=\\\"w-3.5 h-3.5\\\" />}\\n                  onClick={() => fileInputRef.current?.click()}\\n                >\\n                  Replace Video\\n                </Button>\\n                <Button\\n                  type=\\\"button\\\"\\n                  variant=\\\"subtle\\\"\\n                  size=\\\"sm\\\"\\n                  disabled={isUploading}\\n                  leftIcon={<Trash2 className=\\\"w-3.5 h-3.5\\\" />}\\n                  onClick={handleRemoveVideo}\\n                >\\n                  Remove\\n                </Button>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* ================================================================= */}\\n        {/* OPTIONAL CAREGIVER NOTES                                          */}\\n        {/* ================================================================= */}\\n        <div className=\\\"space-y-1.5\\\">\\n          <div className=\\\"flex items-baseline justify-between gap-2\\\">\\n            <label htmlFor=\\\"caregiver-video-note\\\" className=\\\"block text-sm font-medium text-charcoal\\\">\\n              Optional note for your reviewer\\n            </label>\\n            <span className=\\\"font-mono text-[11px] text-muted tabular-nums\\\">\\n              {caregiverNotes.length}/600\\n            </span>\\n          </div>\\n          <textarea\\n            id=\\\"caregiver-video-note\\\"\\n            rows={2}\\n            maxLength={600}\\n            disabled={isUploading}\\n            value={caregiverNotes}\\n            onChange={(e) => setCaregiverNotes(e.target.value)}\\n            placeholder=\\\"Example: Morning session after feeding, used a soft cotton cloth and smooth wooden spoon.\\\"\\n            className=\\\"w-full rounded-lg border border-border-strong bg-surface px-3.5 py-2.5 text-sm text-charcoal placeholder:text-muted/70 focus:border-sage disabled:opacity-60\\\"\\n          />\\n        </div>\\n\\n        {/* ================================================================= */}\\n        {/* EXPLICIT PRIVACY & CONSENT CHECKBOX                               */}\\n        {/* ================================================================= */}\\n        <div className=\\\"rounded-xl border border-border bg-cream/80 p-4 space-y-3\\\">\\n          <div className=\\\"flex items-start gap-2.5 text-xs text-muted leading-relaxed\\\">\\n            <Shield className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n            <div className=\\\"space-y-1\\\">\\n              <p className=\\\"font-semibold text-charcoal\\\">\\n                Private Access \302\267 Short-Lived Signed Links \302\267 30-Day Auto-Deletion \302\267 Delete Anytime\\n              </p>\\n              <p>\\n                Videos are never publicly accessible. Only you and authorized reviewers can view\\n                your clip via short-lived signed URLs, and reviewers evaluate caregiver instruction\\n                steps only\342\200\224never your baby\342\200\231s development or health. A timestamped consent record is\\n                linked directly to your submission.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <label className=\\\"flex items-start gap-3 text-sm text-charcoal cursor-pointer min-h-[44px] pt-1\\\">\\n            <input\\n              type=\\\"checkbox\\\"\\n              disabled={isUploading}\\n              checked={consentConfirmed}\\n              onChange={(e) => setConsentConfirmed(e.target.checked)}\\n              className=\\\"mt-1 h-4 w-4 rounded border-border-strong accent-sage shrink-0\\\"\\n            />\\n            <span className=\\\"leading-relaxed\\\">\\n              I consent to storing this video clip for caregiver activity coaching under the 30-day\\n              auto-deletion policy{isDemoMode ? \' (acknowledging Demo Storage Mode is currently active)\' : \'\'}.\\n            </span>\\n          </label>\\n        </div>\\n\\n        {/* ================================================================= */}\\n        {/* UPLOAD PROGRESS BAR + CANCEL UPLOAD                               */}\\n        {/* ================================================================= */}\\n        {isUploading && (\\n          <div className=\\\"rounded-xl border border-peach bg-peach-soft/40 p-4 space-y-3\\\">\\n            <ProgressIndicator\\n              value={uploadProgress}\\n              max={100}\\n              label=\\\"Uploading practice clip...\\\"\\n              sublabel={`${uploadProgress}%`}\\n              tone=\\\"sage\\\"\\n            />\\n            <div className=\\\"flex justify-end\\\">\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"secondary\\\"\\n                size=\\\"sm\\\"\\n                onClick={handleCancelUpload}\\n              >\\n                Cancel Upload\\n              </Button>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* ================================================================= */}\\n        {/* CLEAR ERROR / FAILED STATE WITH RETRY ACTION                      */}\\n        {/* ================================================================= */}\\n        {error && (\\n          <div\\n            role=\\\"alert\\\"\\n            className=\\\"rounded-xl border border-danger/40 bg-danger-soft/60 px-4 py-3 flex flex-wrap items-center justify-between gap-3\\\"\\n          >\\n            <p className=\\\"text-sm text-danger flex items-center gap-2\\\">\\n              <AlertTriangle className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n              <span>{error}</span>\\n            </p>\\n            {uiState === \'failed\' && selectedFile && consentConfirmed && (\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"secondary\\\"\\n                size=\\\"sm\\\"\\n                leftIcon={<RotateCcw className=\\\"w-3.5 h-3.5\\\" />}\\n                onClick={() => void executeUpload()}\\n              >\\n                Retry Upload\\n              </Button>\\n            )}\\n          </div>\\n        )}\\n\\n        {/* ================================================================= */}\\n        {/* FORM FOOTER ACTIONS                                               */}\\n        {/* ================================================================= */}\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-border\\\">\\n          <p className=\\\"text-xs text-muted\\\">\\n            {selectedFile\\n              ? consentConfirmed\\n                ? \'Ready to submit for caregiver coaching.\'\\n                : \'Tick the consent box above to enable submission.\'\\n              : \'Record or choose a video clip to continue.\'}\\n          </p>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            <Button\\n              type=\\\"button\\\"\\n              variant=\\\"secondary\\\"\\n              disabled={isUploading}\\n              onClick={onCancel}\\n            >\\n              Cancel\\n            </Button>\\n\\n            {uiState === \'failed\' && selectedFile && consentConfirmed ? (\\n              <Button\\n                type=\\\"button\\\"\\n                variant=\\\"primary\\\"\\n                leftIcon={<RotateCcw className=\\\"w-4 h-4\\\" />}\\n                onClick={() => void executeUpload()}\\n              >\\n                Retry Upload\\n              </Button>\\n            ) : (\\n              <Button\\n                type=\\\"submit\\\"\\n                variant=\\\"primary\\\"\\n                loading={isUploading}\\n                disabled={isUploading || isRecording || !selectedFile || !consentConfirmed}\\n                leftIcon={<UploadCloud className=\\\"w-4 h-4\\\" />}\\n              >\\n                {isUploading ? \'Uploading...\' : \'Submit for Review\'}\\n              </Button>\\n            )}\\n          </div>\\n        </div>\\n      </form>\\n    </Card>\\n  );\\n}\\n\", \"Description\":\"Rebuild VideoCaptureUploader with Step 7 Montessori Design System UI, honest Demo Mode disclosure, large Record Activity button, device upload, preview/replace/remove, 7 submission states, abortable progress bar, retry, and linked consent.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/VideoCaptureUploader.tsx\", \"toolAction\":\"Upgrading VideoCaptureUploader workflow\", \"toolSummary\":\"Rebuild VideoCaptureUploader component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4033236578715606478"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update SecureVideoPlayer to use approved Design System tokens and transparently indicate demo isolated storage vs configured production cloud object storage.\", \"EndLine\":110, \"Instruction\":\"Migrate legacy class names to Design System tokens and add optional storageMode label to SecureVideoPlayer.\", \"ReplacementContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Lock, RefreshCw, ShieldCheck } from \'lucide-react\';\\nimport { api } from \'../lib/api\';\\nimport { formatDaysUntilExpiry } from \'../shared/domain\';\\nimport type { VideoStorageMode } from \'../shared/types\';\\n\\ninterface SecureVideoPlayerProps {\\n  submissionId: string;\\n  hasActiveVideo: boolean;\\n  expiresAt: string;\\n  deletionReason?: string | null;\\n  storageMode?: VideoStorageMode;\\n}\\n\\n/**\\n * Plays private child-activity videos strictly via short-lived (5-min) HMAC-signed\\n * streaming tokens. Never caches publicly and disables download affordances.\\n */\\nexport function SecureVideoPlayer({\\n  submissionId,\\n  hasActiveVideo,\\n  expiresAt,\\n  deletionReason,\\n  storageMode = \'demo_local_vault\',\\n}: SecureVideoPlayerProps) {\\n  const [streamUrl, setStreamUrl] = useState<string | null>(null);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const loadToken = async () => {\\n    if (!hasActiveVideo) return;\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const res = await api.getVideoStreamToken(submissionId);\\n      setStreamUrl(res.streamUrl);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load private video stream.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    setStreamUrl(null);\\n    if (hasActiveVideo) {\\n      void loadToken();\\n    }\\n  }, [submissionId, hasActiveVideo]);\\n\\n  if (!hasActiveVideo) {\\n    return (\\n      <div className=\\\"rounded-xl border border-border bg-cream/70 p-6 text-center\\\">\\n        <ShieldCheck className=\\\"w-6 h-6 text-sage mx-auto mb-2\\\" aria-hidden=\\\"true\\\" />\\n        <p className=\\\"text-sm font-semibold text-charcoal mb-1\\\">\\n          Video Permanently Removed from Storage\\n        </p>\\n        <p className=\\\"text-xs text-muted max-w-md mx-auto leading-relaxed\\\">\\n          {deletionReason === \'retention_30d\'\\n            ? \'This video was automatically deleted after the 30-day privacy retention window. Written caregiver feedback remains preserved.\'\\n            : \'This video was deleted from storage. Written caregiver coaching notes and rubric scores remain saved.\'}\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  const daysLeft = formatDaysUntilExpiry(expiresAt);\\n\\n  return (\\n    <div className=\\\"rounded-xl border border-border bg-surface overflow-hidden\\\">\\n      <div className=\\\"aspect-video bg-charcoal flex items-center justify-center relative\\\">\\n        {loading && (\\n          <p className=\\\"text-sm text-white/80\\\">Preparing signed video stream...</p>\\n        )}\\n        {!loading && error && (\\n          <div className=\\\"p-6 text-center\\\">\\n            <p className=\\\"text-sm text-white/90 mb-3\\\">{error}</p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void loadToken()}\\n              className=\\\"inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/15 text-white text-xs font-medium hover:bg-white/25 transition-colors cursor-pointer\\\"\\n            >\\n              <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n              Refresh Signed Stream\\n            </button>\\n          </div>\\n        )}\\n        {!loading && !error && streamUrl && (\\n          <video\\n            key={streamUrl}\\n            src={streamUrl}\\n            controls\\n            controlsList=\\\"nodownload noplaybackrate\\\"\\n            disablePictureInPicture\\n            playsInline\\n            onContextMenu={(e) => e.preventDefault()}\\n            className=\\\"w-full h-full object-contain bg-black\\\"\\n          />\\n        )}\\n      </div>\\n      <div className=\\\"px-4 py-2.5 bg-cream/70 border-t border-border flex flex-wrap items-center justify-between gap-2 text-xs text-muted\\\">\\n        <span className=\\\"inline-flex items-center gap-1.5\\\">\\n          <Lock className=\\\"w-3.5 h-3.5 text-sage\\\" aria-hidden=\\\"true\\\" />\\n          {storageMode === \'production_object_storage\'\\n            ? \'Private cloud signed stream \302\267 Access audited \302\267 Non-downloadable\'\\n            : \'Demo isolated vault \302\267 Short-lived signed URL \302\267 Access audited\'}\\n        </span>\\n        <span className=\\\"font-mono tabular-nums\\\">\\n          Auto-deletes in {daysLeft} {daysLeft === 1 ? \'day\' : \'days\'}\\n        </span>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"StartLine\":1, \"TargetContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Lock, RefreshCw, ShieldCheck } from \'lucide-react\';\\nimport { api } from \'../lib/api\';\\nimport { formatDaysUntilExpiry } from \'../shared/domain\';\\n\\ninterface SecureVideoPlayerProps {\\n  submissionId: string;\\n  hasActiveVideo: boolean;\\n  expiresAt: string;\\n  deletionReason?: string | null;\\n}\\n\\n/**\\n * Plays private child-activity videos strictly via short-lived (5-min) HMAC-signed\\n * streaming tokens. Never caches publicly and disables download affordances.\\n */\\nexport function SecureVideoPlayer({\\n  submissionId,\\n  hasActiveVideo,\\n  expiresAt,\\n  deletionReason,\\n}: SecureVideoPlayerProps) {\\n  const [streamUrl, setStreamUrl] = useState<string | null>(null);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const loadToken = async () => {\\n    if (!hasActiveVideo) return;\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const res = await api.getVideoStreamToken(submissionId);\\n      setStreamUrl(res.streamUrl);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load private video stream.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    setStreamUrl(null);\\n    if (hasActiveVideo) {\\n      void loadToken();\\n    }\\n  }, [submissionId, hasActiveVideo]);\\n\\n  if (!hasActiveVideo) {\\n    return (\\n      <div className=\\\"rounded-xl border border-stone bg-oat/70 p-6 text-center\\\">\\n        <ShieldCheck className=\\\"w-6 h-6 text-eucalyptus mx-auto mb-2\\\" aria-hidden=\\\"true\\\" />\\n        <p className=\\\"text-sm font-medium text-ink mb-1\\\">\\n          Video Permanently Removed from Private Vault\\n        </p>\\n        <p className=\\\"text-xs text-olive max-w-md mx-auto\\\">\\n          {deletionReason === \'retention_30d\'\\n            ? \'This video was automatically deleted after the 30-day privacy retention window. Written caregiver feedback remains preserved.\'\\n            : \'This video was deleted from storage. Written caregiver coaching notes and rubric scores remain saved.\'}\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  const daysLeft = formatDaysUntilExpiry(expiresAt);\\n\\n  return (\\n    <div className=\\\"rounded-xl border border-stone bg-linen overflow-hidden\\\">\\n      <div className=\\\"aspect-video bg-ink flex items-center justify-center relative\\\">\\n        {loading && (\\n          <p className=\\\"text-sm text-white/80\\\">Preparing private encrypted stream...</p>\\n        )}\\n        {!loading && error && (\\n          <div className=\\\"p-6 text-center\\\">\\n            <p className=\\\"text-sm text-white/90 mb-3\\\">{error}</p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void loadToken()}\\n              className=\\\"inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/15 text-white text-xs font-medium hover:bg-white/25 transition-colors cursor-pointer\\\"\\n            >\\n              <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n              Refresh Private Stream\\n            </button>\\n          </div>\\n        )}\\n        {!loading && !error && streamUrl && (\\n          <video\\n            key={streamUrl}\\n            src={streamUrl}\\n            controls\\n            controlsList=\\\"nodownload noplaybackrate\\\"\\n            disablePictureInPicture\\n            playsInline\\n            onContextMenu={(e) => e.preventDefault()}\\n            className=\\\"w-full h-full object-contain bg-black\\\"\\n          />\\n        )}\\n      </div>\\n      <div className=\\\"px-4 py-2.5 bg-oat/60 border-t border-stone flex flex-wrap items-center justify-between gap-2 text-xs text-olive\\\">\\n        <span className=\\\"inline-flex items-center gap-1.5\\\">\\n          <Lock className=\\\"w-3.5 h-3.5 text-eucalyptus\\\" aria-hidden=\\\"true\\\" />\\n          Private signed stream \302\267 Access audited \302\267 Non-downloadable\\n        </span>\\n        <span className=\\\"font-mono tabular-nums\\\">\\n          Auto-deletes in {daysLeft} {daysLeft === 1 ? \'day\' : \'days\'}\\n        </span>\\n      </div>\\n    </div>\\n  );\\n}\", \"TargetFile\":\"/src/components/SecureVideoPlayer.tsx\", \"toolAction\":\"Updating SecureVideoPlayer design tokens\", \"toolSummary\":\"Update SecureVideoPlayer component\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_4033236578715604503"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  ArrowLeft,\\n  Camera,\\n  Check,\\n  CheckCircle2,\\n  ShieldAlert,\\n  Trash2,\\n  Upload,\\n} from \'lucide-react\';\\nimport { InstructionalGuidePlayer } from \'../../components/InstructionalGuidePlayer\';\\nimport { SecureVideoPlayer } from \'../../components/SecureVideoPlayer\';\\nimport {\\n  getSubmissionStateBadge,\\n  mapServerSubmissionToUiState,\\n  VideoCaptureUploader,\\n} from \'../../components/VideoCaptureUploader\';\\nimport { Badge, Button, Card, ConfirmDialog } from \'../../design-system\';\\nimport { api } from \'../../lib/api\';\\nimport { formatDateReadable } from \'../../shared/i18n\';\\nimport type {\\n  ActivityDetail,\\n  CompletionStatus,\\n  LocaleCode,\\n  VideoSubmissionSummary,\\n} from \'../../shared/types\';\\nimport { formatPrepLevel } from \'./MyPlanSection\';\\n\\ninterface ParentActivityStudioProps {\\n  childId: string;\\n  childName: string;\\n  activity: ActivityDetail;\\n  completionStatus: CompletionStatus | null;\\n  initialNotes: string;\\n  latestSubmission: VideoSubmissionSummary | null;\\n  locale: LocaleCode;\\n  onBack: () => void;\\n  onProgressUpdated: () => Promise<void>;\\n  onOpenFeedback: () => void;\\n}\\n\\nexport function ParentActivityStudio({\\n  childId,\\n  childName,\\n  activity,\\n  completionStatus,\\n  initialNotes,\\n  latestSubmission,\\n  locale,\\n  onBack,\\n  onProgressUpdated,\\n  onOpenFeedback,\\n}: ParentActivityStudioProps) {\\n  const [checkedSteps, setCheckedSteps] = useState<Record<string, boolean>>({});\\n  const [reflectionNote, setReflectionNote] = useState(initialNotes);\\n  const [savingCompletion, setSavingCompletion] = useState(false);\\n  const [uploaderMode, setUploaderMode] = useState<\'record\' | \'upload\' | null>(null);\\n  const [statusMessage, setStatusMessage] = useState<string | null>(null);\\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\\n  const [confirmDeleteOpen, setConfirmDeleteOpen] = useState(false);\\n  const [deletingVideo, setDeletingVideo] = useState(false);\\n\\n  const isCompleted =\\n    completionStatus === \'completed\' ||\\n    completionStatus === \'submitted_for_review\' ||\\n    completionStatus === \'reviewed\';\\n\\n  const latestUiState = mapServerSubmissionToUiState(latestSubmission);\\n  const latestStateMeta = latestUiState ? getSubmissionStateBadge(latestUiState) : null;\\n\\n  const handleMarkCompleted = async () => {\\n    setSavingCompletion(true);\\n    setStatusMessage(null);\\n    setErrorMessage(null);\\n    try {\\n      await api.saveCompletion({\\n        childId,\\n        activityId: activity.id,\\n        status: \'completed\',\\n        caregiverNotes: reflectionNote,\\n      });\\n      setStatusMessage(`Saved to ${childName}\342\200\231s daily journal.`);\\n      await onProgressUpdated();\\n    } catch (err) {\\n      setErrorMessage(\\n        err instanceof Error ? err.message : \'Unable to save activity progress right now.\'\\n      );\\n    } finally {\\n      setSavingCompletion(false);\\n    }\\n  };\\n\\n  const handleVideoSubmitted = async (submission: VideoSubmissionSummary) => {\\n    setUploaderMode(null);\\n    setStatusMessage(\\n      submission.storageMode === \'production_object_storage\'\\n        ? \'Practice clip submitted to private storage and queued for caregiver coaching.\'\\n        : \'Practice clip submitted in Demo Storage Mode and queued for caregiver coaching.\'\\n    );\\n    await onProgressUpdated();\\n  };\\n\\n  const handleDeleteLatestVideo = async () => {\\n    if (!latestSubmission) return;\\n    setDeletingVideo(true);\\n    setErrorMessage(null);\\n    try {\\n      await api.deleteSubmissionVideo(latestSubmission.id);\\n      setConfirmDeleteOpen(false);\\n      setStatusMessage(\\n        \'Video permanently removed from storage. Written coaching notes remain preserved.\'\\n      );\\n      await onProgressUpdated();\\n    } catch (err) {\\n      setErrorMessage(err instanceof Error ? err.message : \'Could not delete video.\');\\n    } finally {\\n      setDeletingVideo(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n        <Button\\n          variant=\\\"subtle\\\"\\n          size=\\\"sm\\\"\\n          leftIcon={<ArrowLeft className=\\\"w-4 h-4\\\" />}\\n          onClick={onBack}\\n        >\\n          Back to Dashboard\\n        </Button>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n          {latestStateMeta && (\\n            <Badge tone={latestStateMeta.tone} icon={latestStateMeta.icon}>\\n              {latestStateMeta.label}\\n            </Badge>\\n          )}\\n          {isCompleted && !latestStateMeta && (\\n            <Badge tone=\\\"sage\\\" icon={<CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />}>\\n              Completed\\n            </Badge>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* Activity Title & Calm Metadata */}\\n      <div className=\\\"space-y-2\\\">\\n        <p className=\\\"text-xs text-muted\\\">\\n          {activity.domainName} <span aria-hidden=\\\"true\\\">\302\267</span> {activity.ageGroupLabel}{\' \'}\\n          <span aria-hidden=\\\"true\\\">\302\267</span>{\' \'}\\n          <span className=\\\"font-mono tabular-nums\\\">{activity.durationMinutes} min</span>{\' \'}\\n          <span aria-hidden=\\\"true\\\">\302\267</span> {formatPrepLevel(activity.prepLevel)}{\' \'}\\n          <span aria-hidden=\\\"true\\\">\302\267</span>{\' \'}\\n          <span className=\\\"font-mono tabular-nums\\\">v{activity.version}</span>\\n        </p>\\n        <h1 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          {activity.title}\\n        </h1>\\n        <p className=\\\"text-sm sm:text-base text-muted leading-relaxed max-w-2xl\\\">\\n          {activity.summary}\\n        </p>\\n      </div>\\n\\n      {/* Interactive Step-Paced Instructional Guide */}\\n      <InstructionalGuidePlayer\\n        posterUrl={activity.instructionalPosterUrl}\\n        activityTitle={activity.title}\\n        steps={activity.steps}\\n      />\\n\\n      {/* Everyday Items & Calm Safety Reminder */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n        <Card className=\\\"space-y-3\\\">\\n          <h2 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n            Everyday Items Needed\\n          </h2>\\n          <ul className=\\\"space-y-2 text-sm text-muted\\\">\\n            {activity.materials.map((mat, i) => (\\n              <li key={i} className=\\\"flex items-start gap-2.5\\\">\\n                <span className=\\\"font-mono text-xs text-sage mt-0.5 tabular-nums\\\">\\n                  {String(i + 1).padStart(2, \'0\')}\\n                </span>\\n                <span className=\\\"text-charcoal\\\">{mat}</span>\\n              </li>\\n            ))}\\n          </ul>\\n        </Card>\\n\\n        <Card tone=\\\"peach\\\" className=\\\"space-y-2.5\\\">\\n          <div className=\\\"flex items-center gap-2 text-peach-ink\\\">\\n            <ShieldAlert className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n            <h2 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n              Calm Safety Reminder\\n            </h2>\\n          </div>\\n          <p className=\\\"text-sm text-charcoal/90 leading-relaxed\\\">{activity.safetyNotes}</p>\\n        </Card>\\n      </div>\\n\\n      {/* Step-by-Step Caregiver Instructions */}\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n        <div className=\\\"flex items-center justify-between gap-4 border-b border-border pb-3\\\">\\n          <h2 className=\\\"font-display text-xl font-semibold text-charcoal\\\">Step-by-Step Guide</h2>\\n          <span className=\\\"text-xs text-muted font-mono tabular-nums\\\">\\n            {Object.values(checkedSteps).filter(Boolean).length} / {activity.steps.length} steps tried\\n          </span>\\n        </div>\\n\\n        <ol className=\\\"divide-y divide-border\\\">\\n          {activity.steps.map((step) => {\\n            const checked = Boolean(checkedSteps[step.id]);\\n            return (\\n              <li key={step.id} className=\\\"py-4 first:pt-1 last:pb-1\\\">\\n                <label className=\\\"flex items-start gap-3.5 cursor-pointer min-h-[44px]\\\">\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    checked={checked}\\n                    onChange={() =>\\n                      setCheckedSteps((prev) => ({ ...prev, [step.id]: !prev[step.id] }))\\n                    }\\n                    className=\\\"mt-1 h-4 w-4 rounded border-border-strong accent-sage shrink-0\\\"\\n                  />\\n                  <div className=\\\"space-y-1 flex-1\\\">\\n                    <p\\n                      className={`text-sm font-semibold ${\\n                        checked ? \'text-muted line-through\' : \'text-charcoal\'\\n                      }`}\\n                    >\\n                      {String(step.stepNumber).padStart(2, \'0\')}. {step.title}\\n                    </p>\\n                    <p className=\\\"text-sm text-muted leading-relaxed\\\">{step.instructionText}</p>\\n                    {step.caregiverTip && (\\n                      <p className=\\\"text-xs text-sage pt-0.5\\\">\\n                        Gentle cue: {step.caregiverTip}\\n                      </p>\\n                    )}\\n                  </div>\\n                </label>\\n              </li>\\n            );\\n          })}\\n        </ol>\\n      </Card>\\n\\n      {/* Completion & Caregiver Video Submission */}\\n      <section className=\\\"space-y-4\\\">\\n        {statusMessage && (\\n          <div\\n            role=\\\"status\\\"\\n            className=\\\"rounded-xl border border-sage-border bg-sage-soft px-4 py-3 text-sm text-sage flex items-center gap-2\\\"\\n          >\\n            <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" aria-hidden=\\\"true\\\" />\\n            <span>{statusMessage}</span>\\n          </div>\\n        )}\\n\\n        {errorMessage && (\\n          <p role=\\\"alert\\\" className=\\\"text-sm text-danger bg-danger-soft px-4 py-3 rounded-xl\\\">\\n            {errorMessage}\\n          </p>\\n        )}\\n\\n        {!uploaderMode ? (\\n          <Card padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <h2 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n                Finish Activity or Share a Video for Caregiver Feedback\\n              </h2>\\n              <p className=\\\"text-sm text-muted leading-relaxed\\\">\\n                Save your practice to {childName}\342\200\231s daily journal, or record/upload a short clip so\\n                a reviewer can share warm feedback on how clearly the activity steps were demonstrated.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"space-y-1.5\\\">\\n              <label\\n                htmlFor=\\\"studio-reflection-note\\\"\\n                className=\\\"block text-xs font-medium text-charcoal\\\"\\n              >\\n                Short reflection note (Optional)\\n              </label>\\n              <textarea\\n                id=\\\"studio-reflection-note\\\"\\n                rows={2}\\n                value={reflectionNote}\\n                onChange={(e) => setReflectionNote(e.target.value)}\\n                placeholder=\\\"How did the pace feel for you and your baby today?\\\"\\n                className=\\\"w-full rounded-lg border border-border-strong bg-surface px-3.5 py-2.5 text-sm text-charcoal focus:border-sage\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n              <Button\\n                variant=\\\"primary\\\"\\n                loading={savingCompletion}\\n                leftIcon={<Check className=\\\"w-4 h-4\\\" />}\\n                onClick={() => void handleMarkCompleted()}\\n              >\\n                {isCompleted ? \'Update Journal Note\' : \'Mark Activity Completed\'}\\n              </Button>\\n\\n              <Button\\n                variant=\\\"secondary\\\"\\n                leftIcon={<Camera className=\\\"w-4 h-4 text-sage\\\" />}\\n                onClick={() => setUploaderMode(\'record\')}\\n              >\\n                Record Activity\\n              </Button>\\n\\n              <Button\\n                variant=\\\"secondary\\\"\\n                leftIcon={<Upload className=\\\"w-4 h-4 text-sage\\\" />}\\n                onClick={() => setUploaderMode(\'upload\')}\\n              >\\n                Upload Video\\n              </Button>\\n            </div>\\n          </Card>\\n        ) : (\\n          <VideoCaptureUploader\\n            childId={childId}\\n            childName={childName}\\n            activityId={activity.id}\\n            activityTitle={activity.title}\\n            activityVersion={activity.version}\\n            initialMode={uploaderMode}\\n            existingSubmission={latestSubmission}\\n            onSubmitted={handleVideoSubmitted}\\n            onCancel={() => setUploaderMode(null)}\\n          />\\n        )}\\n\\n        {/* Existing Submission Status Card with Linked Metadata, Preview & Secure Deletion */}\\n        {latestSubmission && !uploaderMode && (\\n          <Card tone=\\\"cream\\\" padding=\\\"lg\\\" className=\\\"space-y-4\\\">\\n            <div className=\\\"flex flex-wrap items-start justify-between gap-4 border-b border-border pb-3.5\\\">\\n              <div className=\\\"space-y-1.5\\\">\\n                <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                  {latestStateMeta ? (\\n                    <Badge tone={latestStateMeta.tone} icon={latestStateMeta.icon}>\\n                      {latestStateMeta.label}\\n                    </Badge>\\n                  ) : (\\n                    <Badge tone=\\\"neutral\\\">Video deleted</Badge>\\n                  )}\\n                  <Badge tone=\\\"neutral\\\">\\n                    Activity v{latestSubmission.activityVersion}\\n                  </Badge>\\n                  {latestSubmission.consentRecordId && (\\n                    <Badge tone=\\\"sage\\\">Consent recorded</Badge>\\n                  )}\\n                </div>\\n                <p className=\\\"text-xs text-muted\\\">\\n                  Submitted {formatDateReadable(latestSubmission.createdAt, locale)}\\n                  {latestSubmission.storageMode === \'demo_local_vault\'\\n                    ? \' \302\267 Demo Storage Mode\'\\n                    : \' \302\267 Private Cloud Storage\'}\\n                </p>\\n                <p className=\\\"text-sm font-medium text-charcoal\\\">\\n                  {latestSubmission.review\\n                    ? `Reviewed \302\267 Caregiver Instruction-Match: ${latestSubmission.review.instructionMatchScorePct}%`\\n                    : latestSubmission.reviewStatus === \'resubmit_requested\'\\n                      ? latestSubmission.changeRequestNote ||\\n                        \'Your reviewer requested an updated clip for clearer coaching feedback.\'\\n                      : latestSubmission.reviewStatus === \'in_review\'\\n                        ? \'Currently under review by your caregiver coach.\'\\n                        : latestSubmission.reviewStatus === \'deleted\'\\n                          ? \'Practice clip was removed from storage.\'\\n                          : \'Submitted and queued for caregiver coaching review.\'}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                {latestSubmission.reviewStatus === \'resubmit_requested\' && (\\n                  <Button\\n                    variant=\\\"primary\\\"\\n                    size=\\\"sm\\\"\\n                    onClick={() => setUploaderMode(\'record\')}\\n                  >\\n                    Submit Updated Clip\\n                  </Button>\\n                )}\\n                <Button variant=\\\"secondary\\\" size=\\\"sm\\\" onClick={onOpenFeedback}>\\n                  View in Progress & Feedback\\n                </Button>\\n              </div>\\n            </div>\\n\\n            <SecureVideoPlayer\\n              submissionId={latestSubmission.id}\\n              hasActiveVideo={latestSubmission.hasActiveVideo}\\n              expiresAt={latestSubmission.expiresAt}\\n              deletionReason={latestSubmission.deletionReason}\\n              storageMode={latestSubmission.storageMode}\\n            />\\n\\n            {latestSubmission.hasActiveVideo && (\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3 pt-1\\\">\\n                <p className=\\\"text-xs text-muted font-mono tabular-nums\\\">\\n                  Ref: {latestSubmission.storageReference || latestSubmission.id}\\n                </p>\\n                <Button\\n                  variant=\\\"danger\\\"\\n                  size=\\\"sm\\\"\\n                  leftIcon={<Trash2 className=\\\"w-3.5 h-3.5\\\" />}\\n                  onClick={() => setConfirmDeleteOpen(true)}\\n                >\\n                  Delete Video Now\\n                </Button>\\n              </div>\\n            )}\\n          </Card>\\n        )}\\n      </section>\\n\\n      <ConfirmDialog\\n        open={confirmDeleteOpen}\\n        onClose={() => setConfirmDeleteOpen(false)}\\n        onConfirm={() => void handleDeleteLatestVideo()}\\n        title=\\\"Delete practice video permanently?\\\"\\n        message=\\\"This removes the uploaded video immediately from storage. Your written caregiver coaching feedback remains preserved.\\\"\\n        confirmLabel=\\\"Delete Video\\\"\\n        destructive\\n        loading={deletingVideo}\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Upgrade ParentActivityStudio with dedicated Record Activity and Upload Video entry points, full submission state display (including Changes Requested), linked metadata, inline signed preview, and secure deletion workflow.\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/parent/ParentActivityStudio.tsx\", \"toolAction\":\"Upgrading ParentActivityStudio workflow\", \"toolSummary\":\"Update ParentActivityStudio component\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
