            lines {
              text: "    title: \'Cloth Wiping a Tiny Water Spill\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    summary: \'Turn everyday spills into calm, capable participation with a small cotton cloth.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    durationMinutes: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    materials: [\'Small cotton cloth\', \'Low table or tray\', \'A few drops of water\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    safetyNotes: \'Use only a few drops of water on a non-slip low table so the floor stays dry.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.everydayCup,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Place a few drops on a tray\', instructionText: \'Put a tiny splash of water on a low tray and place the folded cotton cloth beside it.\', caregiverTip: \'Keep it playful and matter-of-fact.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Model wiping slowly\', instructionText: \'Press the cloth gently onto the water and move in a slow circle: \342\200\234Wipe, wipe.\342\200\235\', caregiverTip: \'Use calm, encouraging words.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Hand the cloth to toddler\', instructionText: \'Invite toddler to wipe the remaining drops independently.\', caregiverTip: \'Resist wiping over their work immediately.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Place cloth to dry together\', instructionText: \'Walk together to place the damp cloth on a low hook or drying spot.\', caregiverTip: \'Builds pride in everyday contribution.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Prepared low workspace\', description: \'Caregiver set up a safe, manageable spill size on a tray.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Clear slow demonstration\', description: \'Caregiver showed the wiping motion calmly before handing over.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { label: \'Encouraging independent attempt\', description: \'Caregiver let toddler finish without criticizing or redoing immediately.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
