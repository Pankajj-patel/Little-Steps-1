      thinking_signature: "\022\324\026\n\321\026\001i\024}\023,\021\272\024\325H\rm\027K\257(#\330\221g\036)\233$\340\'\346q4\366\325\021\235k@\216\346g\221\300\256\210J\233\304\n\030\346\277W\332\005\363Ss\267\326L\323}z\350)\376\365\2430y\241\245\025!;\n\332`t\024\004.\232\256\372!7\212e\370\364\361\240U\354\262\001\314\321U\025g\314\272\263\211_\327\224V\257^\316e?\304\v\354\021\225\005\214\331\037`\'\361hx\023\342\t_)\240\214\361!\n\200\246\220\243\336\236.\233[\210\332\233\236\230$\342`8\317\320\030\274\025\240@z\234\f|0\357\263\350\365\016\022\210~\224\234\r}\326?6\372\223\020\232(\205\247\363S\245\016\200\020\024\263\377\v\264C\352u<r_\240\222\313\276-D\020\273\347\363\022\201{\265\231\257\026O\037\314\273s\000\356\254\024\334*Km\274\335\204\314N\f\317\335\354\215\372!\227s\324\276\303R\030V\331\223}V\277\r\326dku4\321\211\020\037q\373g\224\030A\362D\316\362\210\273\005\030C\301\"\274m\317\004\206\214Q\320\367\226\203\307\234\345#n-E\237\202\340\274\260\356\360H)\337e\251\263\361\317<\264J\004\375z\375#\337\322\245\204\336\246,N\037\262\341Yv1\241u^_\304\272\306\235p\365\263G@\353\371\225\242*\202\213\373U\243\215\374P\366\021\207]\355\301\261\377<E\236e(\352<\016\214\231`\357Gi*D!\003O\215\277}\372\327\033H\302\223k\346\263\355wi\024\310H\202\024O\373Hs\213\217\311\376\301bt\026\217X\276\374\332U\300M!\022\351~\220x\222\262\251\r\222\315\343\236\202\001\203Y\027\270\364gTJN\322d\242\214\360\335\352%E\201\317,\333PE\026\026\322\370\vyc\332\264\322\032\360\343\314\332\362\310FT\346\001l\td^h\252\2112\262\264?\317B\2064pbK\243\210\000\271$\376\213zq\313\345C\r`\245\334\347\\\246\001|\357\220\000\360\001b\316\330\363\257\251\351\037r\357\261=\217\212\n\322\271`2GI\311A,$\az\354\276e\031h\347\217\275\237\372\330\373\256\231\215$\350\035%\330\036p\263\341\027\357 \212\340\244l\002Q=W\324Z\333$\322\346\215 X\376\335\b\322\026p\033\277\245u\00212\231\345Y\342~\351\370C\276\243\347\375s\03030\215\367\351A8\342\344\261\223mD\256\357\210\206\253r\332\357F\263\256\207\227x\240\207\330\207\v![\265\345\262\262\215Z\220L(\301\177-|\261/\212\207\201\250#x\232Q\330\210\331/\353`,\307\330\245\246p\300\344T\330\263<f\202\341\300^\350\aA\341W\020\214\0165/\353\000\3312\213_\036\320\\\025ri_\335\352\215\353\373\346u\233\371\033r*`\231\337\t\034\243\0303\326\f\276 q5\031\347$\351F\004@>\004\346\240\3358\026\326W|\367\211\241\3153\327\\9\342\277^A.\025\177!\347\004\200|\265\241\250S\016\350\003\3665\344Vv\260\365\255\314\026\277\341\036\352<\'\003\211H(J\311\213\267\254&\337\214Pf\301\237ajR\006>\b\330\231g\373\223\206\260\301\320\311\275\210dh\264uL\235\027d\237U\276\232\005\003\n+;R\031\215\0040\316\020G\330T\310\"\316\006rq \263\032\257t*\355\272\257\205\236[\254\371\343\005D\365<\004\2170\'\241U\374\206\267\032\302\270\000\270\361\207\244M\304\024\'\362\246\2452\336\277\f\307\031\362\3715\217I\256\266\020\322p\346\247=\2330\355\0355\267\333]\273\270\221\036<\2558\276rS\035\206L\017\317\r\243\267,\264pS\311\201\206L\304\220\227\334\235\006:\"B\211p\261\372sN\030h\223nk\202>\027\'v\235\336#^\030\335\275|J\n\315\001\303\340j\027\357`x\266\021\200PN~\361\034\331\3336\255\355\251\313r\357\317\376\322\356\214\244+<-\324B\263M\006\\\020r1\362b~%\375\006-\3705z.Y\214\321\035\227\350/E\362\303\352\333\340GT\273\342\201\310\303\232\033\347\367I\241e\313\302\261\000*:0\217\377\241j^\032\301U+\376\265\276\360\000\003vA\315\030\346\334\000\036\254\234\274\207;\f\220\352:\305\021\223s\331\332\314-L\340\247\335z\254\"\3768L,n\257&\313\n\034\b\034\317\277\247\305*9\246\023Yg\362\003\200\277\242\034\'$\332V\250\261\307\241mP\371\367\367\3412\225q \376\331x\214Fi\375q\266\003l2\363\tN)\3150\006\273-\302S&\177\223\345\353\316!\252\036\003 \233\001\245G\235\372z>f\177r\346\244\v\f\3428\237\003X\266\347H\021\215z\334*\377%\363G\273\032T\276\242QP/\\\312\3509\330\361\252\235\fH\327WT}-0\224\215\323\232\373\307\252q\371\362\033\360C\242\223B\"x\256\203\234\001U\335\005\267\177`\006@D\340Z\351#\020\335\252\307\262.f\255q\224\3418\346\272\321\351k!\2431\301p\34