      id: "call_12474837487471321751"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport {\\n  ArrowLeft,\\n  ArrowRight,\\n  CheckCircle2,\\n  KeyRound,\\n  MailCheck,\\n  RefreshCw,\\n  ShieldCheck,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../../context/AuthContext\';\\nimport { Button, Card, Input, useToast } from \'../../design-system\';\\nimport { api } from \'../../lib/api\';\\nimport type { NavigateTarget } from \'../../lib/router\';\\n\\ninterface AuthPageProps {\\n  onNavigate: (route: NavigateTarget) => void;\\n}\\n\\ninterface TokenAuthPageProps extends AuthPageProps {\\n  initialToken: string | null;\\n}\\n\\nconst EMAIL_REGEX = /^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/;\\n\\n/* ========================================================================= */\\n/* 1. LOGIN PAGE                                                             */\\n/* ========================================================================= */\\nexport function LoginPage({ onNavigate }: AuthPageProps) {\\n  const { login } = useAuth();\\n  const { notify } = useToast();\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [fieldErrors, setFieldErrors] = useState<{ email?: string; password?: string }>({});\\n  const [submitting, setSubmitting] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const validate = () => {\\n    const next: { email?: string; password?: string } = {};\\n    if (!email.trim() || !EMAIL_REGEX.test(email.trim())) {\\n      next.email = \'Please enter a valid email address.\';\\n    }\\n    if (!password) {\\n      next.password = \'Please enter your password.\';\\n    }\\n    setFieldErrors(next);\\n    return Object.keys(next).length === 0;\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (!validate()) return;\\n    setSubmitting(true);\\n    try {\\n      const user = await login(email.trim(), password);\\n      notify({\\n        tone: \'success\',\\n        title: `Welcome back, ${user.fullName.split(\' \')[0]}`,\\n      });\\n      onNavigate(\'/\');\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to sign in.\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleDemoLogin = async (demoEmail: string) => {\\n    setError(null);\\n    setFieldErrors({});\\n    setSubmitting(true);\\n    try {\\n      const user = await login(demoEmail, \'LittleSteps123!\');\\n      notify({\\n        tone: \'success\',\\n        title: `Signed in as ${user.fullName}`,\\n        description: `Opening ${user.role} workspace.`,\\n      });\\n      onNavigate(\'/\');\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to sign in.\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-md mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\\\">\\n      <div className=\\\"text-center space-y-2\\\">\\n        <p className=\\\"font-mono text-xs text-sage tabular-nums\\\">Welcome Back</p>\\n        <h1 className=\\\"font-display text-3xl font-semibold text-charcoal\\\">\\n          Sign in to LittleSteps\\n        </h1>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Continue your baby\342\200\231s calm daily activity journey.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-5\\\">\\n        <form onSubmit={handleSubmit} noValidate className=\\\"space-y-4\\\">\\n          <Input\\n            label=\\\"Email address\\\"\\n            type=\\\"email\\\"\\n            required\\n            autoComplete=\\\"email\\\"\\n            value={email}\\n            onChange={(e) => {\\n              setEmail(e.target.value);\\n              if (fieldErrors.email) setFieldErrors((p) => ({ ...p, email: undefined }));\\n            }}\\n            error={fieldErrors.email}\\n            placeholder=\\\"you@example.com\\\"\\n          />\\n\\n          <div className=\\\"space-y-1.5\\\">\\n            <Input\\n              label=\\\"Password\\\"\\n              type=\\\"password\\\"\\n              required\\n              autoComplete=\\\"current-password\\\"\\n              value={password}\\n              onChange={(e) => {\\n                setPassword(e.target.value);\\n                if (fieldErrors.password) setFieldErrors((p) => ({ ...p, password: undefined }));\\n              }}\\n              error={fieldErrors.password}\\n              placeholder=\\\"Enter your password\\\"\\n            />\\n            <div className=\\\"flex justify-end\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'/forgot-password\')}\\n                className=\\\"text-xs font-medium text-sage hover:underline min-h-[32px] inline-flex items-center cursor-pointer\\\"\\n              >\\n                Forgot password?\\n              </button>\\n            </div>\\n          </div>\\n\\n          {error && (\\n            <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n              {error}\\n            </p>\\n          )}\\n\\n          <Button\\n            type=\\\"submit\\\"\\n            variant=\\\"primary\\\"\\n            fullWidth\\n            loading={submitting}\\n            rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n          >\\n            Sign In\\n          </Button>\\n        </form>\\n\\n        <div className=\\\"pt-4 border-t border-border space-y-2.5\\\">\\n          <p className=\\\"text-xs text-muted\\\">Quick prototype workspace access:</p>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-2\\\">\\n            <Button\\n              variant=\\\"subtle\\\"\\n              size=\\\"sm\\\"\\n              disabled={submitting}\\n              onClick={() => void handleDemoLogin(\'meera@littlesteps.in\')}\\n            >\\n              Parent\\n            </Button>\\n            <Button\\n              variant=\\\"subtle\\\"\\n              size=\\\"sm\\\"\\n              disabled={submitting}\\n              onClick={() => void handleDemoLogin(\'ananya.reviewer@littlesteps.in\')}\\n            >\\n              Reviewer\\n            </Button>\\n            <Button\\n              variant=\\\"subtle\\\"\\n              size=\\\"sm\\\"\\n              disabled={submitting}\\n              onClick={() => void handleDemoLogin(\'kavita.admin@littlesteps.in\')}\\n            >\\n              Admin\\n            </Button>\\n          </div>\\n        </div>\\n      </Card>\\n\\n      <p className=\\\"text-center text-sm text-muted\\\">\\n        New to LittleSteps?{\' \'}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/register\')}\\n          className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n        >\\n          Create a parent account\\n        </button>\\n      </p>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 2. REGISTER PAGE                                                          */\\n/* ========================================================================= */\\nexport function RegisterPage({ onNavigate }: AuthPageProps) {\\n  const { register } = useAuth();\\n  const { notify } = useToast();\\n  const [fullName, setFullName] = useState(\'\');\\n  const [email, setEmail] = useState(\'\');\\n  const [phoneNumber, setPhoneNumber] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\\n  const [fieldErrors, setFieldErrors] = useState<{\\n    fullName?: string;\\n    email?: string;\\n    password?: string;\\n    confirmPassword?: string;\\n  }>({});\\n  const [submitting, setSubmitting] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const validate = () => {\\n    const next: {\\n      fullName?: string;\\n      email?: string;\\n      password?: string;\\n      confirmPassword?: string;\\n    } = {};\\n    if (fullName.trim().length < 2) {\\n      next.fullName = \'Please enter your name (at least 2 characters).\';\\n    }\\n    if (!email.trim() || !EMAIL_REGEX.test(email.trim())) {\\n      next.email = \'Please enter a valid email address.\';\\n    }\\n    if (password.length < 8) {\\n      next.password = \'Password must be at least 8 characters long.\';\\n    }\\n    if (confirmPassword !== password) {\\n      next.confirmPassword = \'Passwords do not match. Please re-enter.\';\\n    }\\n    setFieldErrors(next);\\n    return Object.keys(next).length === 0;\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (!validate()) return;\\n    setSubmitting(true);\\n    try {\\n      await register({\\n        fullName: fullName.trim(),\\n        email: email.trim(),\\n        phoneNumber: phoneNumber.trim() || undefined,\\n        password,\\n      });\\n      notify({\\n        tone: \'success\',\\n        title: \'Account created\',\\n        description: \'Let\342\200\231s personalize LittleSteps for you and your baby.\',\\n      });\\n      onNavigate(\'/\');\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to create your account.\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-lg mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\\\">\\n      <div className=\\\"text-center space-y-2\\\">\\n        <p className=\\\"font-mono text-xs text-sage tabular-nums\\\">Start Your Journey</p>\\n        <h1 className=\\\"font-display text-3xl font-semibold text-charcoal\\\">\\n          Create your parent account\\n        </h1>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Gentle, age-appropriate daily activities matched automatically to your baby\342\200\231s stage.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-5\\\">\\n        <form onSubmit={handleSubmit} noValidate className=\\\"space-y-4\\\">\\n          <Input\\n            label=\\\"Your name\\\"\\n            required\\n            autoComplete=\\\"name\\\"\\n            value={fullName}\\n            onChange={(e) => {\\n              setFullName(e.target.value);\\n              if (fieldErrors.fullName) setFieldErrors((p) => ({ ...p, fullName: undefined }));\\n            }}\\n            error={fieldErrors.fullName}\\n            placeholder=\\\"e.g., Priya Sharma\\\"\\n          />\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <Input\\n              label=\\\"Email address\\\"\\n              type=\\\"email\\\"\\n              required\\n              autoComplete=\\\"email\\\"\\n              value={email}\\n              onChange={(e) => {\\n                setEmail(e.target.value);\\n                if (fieldErrors.email) setFieldErrors((p) => ({ ...p, email: undefined }));\\n              }}\\n              error={fieldErrors.email}\\n              placeholder=\\\"you@example.com\\\"\\n            />\\n\\n            <Input\\n              label=\\\"Mobile number (Optional)\\\"\\n              type=\\\"tel\\\"\\n              autoComplete=\\\"tel\\\"\\n              value={phoneNumber}\\n              onChange={(e) => setPhoneNumber(e.target.value)}\\n              placeholder=\\\"+91 98xxx xxxxx\\\"\\n              helperText=\\\"Optional contact for account recovery.\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <Input\\n              label=\\\"Create password\\\"\\n              type=\\\"password\\\"\\n              required\\n              minLength={8}\\n              autoComplete=\\\"new-password\\\"\\n              value={password}\\n              onChange={(e) => {\\n                setPassword(e.target.value);\\n                if (fieldErrors.password) setFieldErrors((p) => ({ ...p, password: undefined }));\\n              }}\\n              error={fieldErrors.password}\\n              placeholder=\\\"At least 8 characters\\\"\\n            />\\n\\n            <Input\\n              label=\\\"Confirm password\\\"\\n              type=\\\"password\\\"\\n              required\\n              minLength={8}\\n              autoComplete=\\\"new-password\\\"\\n              value={confirmPassword}\\n              onChange={(e) => {\\n                setConfirmPassword(e.target.value);\\n                if (fieldErrors.confirmPassword) {\\n                  setFieldErrors((p) => ({ ...p, confirmPassword: undefined }));\\n                }\\n              }}\\n              error={fieldErrors.confirmPassword}\\n              placeholder=\\\"Re-enter password\\\"\\n            />\\n          </div>\\n\\n          {error && (\\n            <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n              {error}\\n            </p>\\n          )}\\n\\n          <div className=\\\"rounded-lg bg-cream/80 border border-border p-3.5 flex items-start gap-2.5 text-xs text-muted leading-relaxed\\\">\\n            <ShieldCheck className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n            <span>\\n              By creating an account you agree to our{\' \'}\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'/terms\')}\\n                className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n              >\\n                Terms & Conditions\\n              </button>{\' \'}\\n              and{\' \'}\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'/privacy\')}\\n                className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n              >\\n                Privacy Policy\\n              </button>\\n              . Uploaded baby videos remain strictly private and auto-delete after 30 days.\\n            </span>\\n          </div>\\n\\n          <Button\\n            type=\\\"submit\\\"\\n            variant=\\\"primary\\\"\\n            fullWidth\\n            loading={submitting}\\n            rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n          >\\n            Create Account & Personalize\\n          </Button>\\n        </form>\\n      </Card>\\n\\n      <p className=\\\"text-center text-sm text-muted\\\">\\n        Already have an account?{\' \'}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/login\')}\\n          className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n        >\\n          Sign in\\n        </button>\\n      </p>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 3. FORGOT PASSWORD PAGE                                                   */\\n/* ========================================================================= */\\nexport function ForgotPasswordPage({ onNavigate }: AuthPageProps) {\\n  const [email, setEmail] = useState(\'\');\\n  const [emailError, setEmailError] = useState<string | undefined>(undefined);\\n  const [submitting, setSubmitting] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n  const [submittedMessage, setSubmittedMessage] = useState<string | null>(null);\\n  const [resetPreviewPath, setResetPreviewPath] = useState<string | null>(null);\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (!email.trim() || !EMAIL_REGEX.test(email.trim())) {\\n      setEmailError(\'Please enter the email address associated with your account.\');\\n      return;\\n    }\\n    setEmailError(undefined);\\n    setSubmitting(true);\\n    try {\\n      const res = await api.forgotPassword(email.trim());\\n      setSubmittedMessage(res.message);\\n      setResetPreviewPath(res.resetPreviewPath ?? null);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to send reset instructions.\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-md mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\\\">\\n      <div className=\\\"text-center space-y-2\\\">\\n        <p className=\\\"font-mono text-xs text-sage tabular-nums\\\">Account Recovery</p>\\n        <h1 className=\\\"font-display text-3xl font-semibold text-charcoal\\\">\\n          Reset your password\\n        </h1>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Enter your email address and we\342\200\231ll prepare a secure one-time link to set a new password.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-5\\\">\\n        {submittedMessage ? (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"rounded-xl bg-sage-soft border border-sage-border p-4 flex items-start gap-3\\\">\\n              <MailCheck className=\\\"w-5 h-5 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n              <div className=\\\"space-y-1 text-sm\\\">\\n                <p className=\\\"font-medium text-charcoal\\\">Check your email</p>\\n                <p className=\\\"text-muted text-xs leading-relaxed\\\">{submittedMessage}</p>\\n              </div>\\n            </div>\\n\\n            {resetPreviewPath && (\\n              <div className=\\\"rounded-xl bg-cream border border-border p-4 space-y-3\\\">\\n                <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n                  In this local prototype environment, outgoing email is simulated. Open your\\n                  one-time reset link directly below (valid for 30 minutes):\\n                </p>\\n                <Button\\n                  variant=\\\"primary\\\"\\n                  fullWidth\\n                  rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n                  onClick={() => onNavigate(resetPreviewPath as NavigateTarget)}\\n                >\\n                  Open Password Reset Link\\n                </Button>\\n              </div>\\n            )}\\n\\n            <Button\\n              variant=\\\"secondary\\\"\\n              fullWidth\\n              leftIcon={<ArrowLeft className=\\\"w-4 h-4\\\" />}\\n              onClick={() => onNavigate(\'/login\')}\\n            >\\n              Back to Sign In\\n            </Button>\\n          </div>\\n        ) : (\\n          <form onSubmit={handleSubmit} noValidate className=\\\"space-y-4\\\">\\n            <Input\\n              label=\\\"Email address\\\"\\n              type=\\\"email\\\"\\n              required\\n              autoComplete=\\\"email\\\"\\n              value={email}\\n              onChange={(e) => {\\n                setEmail(e.target.value);\\n                if (emailError) setEmailError(undefined);\\n              }}\\n              error={emailError}\\n              placeholder=\\\"you@example.com\\\"\\n              helperText=\\\"For your privacy, we never disclose whether an email is registered.\\\"\\n            />\\n\\n            {error && (\\n              <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n                {error}\\n              </p>\\n            )}\\n\\n            <Button\\n              type=\\\"submit\\\"\\n              variant=\\\"primary\\\"\\n              fullWidth\\n              loading={submitting}\\n              rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n            >\\n              Send Reset Link\\n            </Button>\\n          </form>\\n        )}\\n      </Card>\\n\\n      <p className=\\\"text-center text-sm text-muted\\\">\\n        Remembered your password?{\' \'}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/login\')}\\n          className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n        >\\n          Return to sign in\\n        </button>\\n      </p>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 4. RESET PASSWORD PAGE                                                    */\\n/* ========================================================================= */\\nexport function ResetPasswordPage({ onNavigate, initialToken }: TokenAuthPageProps) {\\n  const { setUser } = useAuth();\\n  const { notify } = useToast();\\n  const [token, setToken] = useState(initialToken ?? \'\');\\n  const [newPassword, setNewPassword] = useState(\'\');\\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\\n  const [fieldErrors, setFieldErrors] = useState<{\\n    token?: string;\\n    newPassword?: string;\\n    confirmPassword?: string;\\n  }>({});\\n  const [submitting, setSubmitting] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n  const [completed, setCompleted] = useState(false);\\n\\n  useEffect(() => {\\n    if (initialToken) setToken(initialToken);\\n  }, [initialToken]);\\n\\n  const validate = () => {\\n    const next: { token?: string; newPassword?: string; confirmPassword?: string } = {};\\n    if (token.trim().length < 10) {\\n      next.token = \'A valid reset token is required. Request a new link if yours expired.\';\\n    }\\n    if (newPassword.length < 8) {\\n      next.newPassword = \'New password must be at least 8 characters long.\';\\n    }\\n    if (confirmPassword !== newPassword) {\\n      next.confirmPassword = \'Passwords do not match.\';\\n    }\\n    setFieldErrors(next);\\n    return Object.keys(next).length === 0;\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n    if (!validate()) return;\\n    setSubmitting(true);\\n    try {\\n      await api.resetPassword(token.trim(), newPassword);\\n      setUser(null);\\n      setCompleted(true);\\n      notify({\\n        tone: \'success\',\\n        title: \'Password updated\',\\n        description: \'You can now sign in with your new password.\',\\n      });\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to reset password.\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-md mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\\\">\\n      <div className=\\\"text-center space-y-2\\\">\\n        <p className=\\\"font-mono text-xs text-sage tabular-nums\\\">Security Update</p>\\n        <h1 className=\\\"font-display text-3xl font-semibold text-charcoal\\\">\\n          Choose a new password\\n        </h1>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Updating your password signs out previous sessions to keep your family account safe.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-5\\\">\\n        {completed ? (\\n          <div className=\\\"space-y-4 text-center py-2\\\">\\n            <div className=\\\"w-12 h-12 rounded-full bg-sage-soft text-sage mx-auto flex items-center justify-center\\\">\\n              <CheckCircle2 className=\\\"w-6 h-6\\\" aria-hidden=\\\"true\\\" />\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <h2 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n                Your password has been reset\\n              </h2>\\n              <p className=\\\"text-sm text-muted\\\">\\n                Please sign in with your new password to continue your journey.\\n              </p>\\n            </div>\\n            <Button\\n              variant=\\\"primary\\\"\\n              fullWidth\\n              rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n              onClick={() => onNavigate(\'/login\')}\\n            >\\n              Sign In Now\\n            </Button>\\n          </div>\\n        ) : (\\n          <form onSubmit={handleSubmit} noValidate className=\\\"space-y-4\\\">\\n            {!initialToken && (\\n              <Input\\n                label=\\\"Reset token\\\"\\n                required\\n                value={token}\\n                onChange={(e) => {\\n                  setToken(e.target.value);\\n                  if (fieldErrors.token) setFieldErrors((p) => ({ ...p, token: undefined }));\\n                }}\\n                error={fieldErrors.token}\\n                placeholder=\\\"Paste the reset token from your email\\\"\\n              />\\n            )}\\n\\n            <Input\\n              label=\\\"New password\\\"\\n              type=\\\"password\\\"\\n              required\\n              minLength={8}\\n              autoComplete=\\\"new-password\\\"\\n              value={newPassword}\\n              onChange={(e) => {\\n                setNewPassword(e.target.value);\\n                if (fieldErrors.newPassword) {\\n                  setFieldErrors((p) => ({ ...p, newPassword: undefined }));\\n                }\\n              }}\\n              error={fieldErrors.newPassword}\\n              placeholder=\\\"At least 8 characters\\\"\\n              leadingIcon={<KeyRound className=\\\"w-4 h-4\\\" />}\\n            />\\n\\n            <Input\\n              label=\\\"Confirm new password\\\"\\n              type=\\\"password\\\"\\n              required\\n              minLength={8}\\n              autoComplete=\\\"new-password\\\"\\n              value={confirmPassword}\\n              onChange={(e) => {\\n                setConfirmPassword(e.target.value);\\n                if (fieldErrors.confirmPassword) {\\n                  setFieldErrors((p) => ({ ...p, confirmPassword: undefined }));\\n                }\\n              }}\\n              error={fieldErrors.confirmPassword}\\n              placeholder=\\\"Re-enter your new password\\\"\\n            />\\n\\n            {fieldErrors.token && initialToken && (\\n              <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n                {fieldErrors.token}\\n              </p>\\n            )}\\n\\n            {error && (\\n              <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n                {error}\\n              </p>\\n            )}\\n\\n            <Button\\n              type=\\\"submit\\\"\\n              variant=\\\"primary\\\"\\n              fullWidth\\n              loading={submitting}\\n              rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n            >\\n              Save New Password\\n            </Button>\\n          </form>\\n        )}\\n      </Card>\\n\\n      <p className=\\\"text-center text-sm text-muted\\\">\\n        Need a fresh link?{\' \'}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => onNavigate(\'/forgot-password\')}\\n          className=\\\"text-sage font-medium hover:underline cursor-pointer\\\"\\n        >\\n          Request another reset link\\n        </button>\\n      </p>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 5. EMAIL VERIFICATION PAGE                                                */\\n/* ========================================================================= */\\nexport function VerifyEmailPage({ onNavigate, initialToken }: TokenAuthPageProps) {\\n  const { user, refreshUser, verificationPreviewPath, setVerificationPreviewPath } = useAuth();\\n  const { notify } = useToast();\\n  const [manualToken, setManualToken] = useState(initialToken ?? \'\');\\n  const [status, setStatus] = useState<\'idle\' | \'verifying\' | \'verified\' | \'error\'>(\\n    user?.emailVerifiedAt ? \'verified\' : initialToken ? \'verifying\' : \'idle\'\\n  );\\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\\n  const [resending, setResending] = useState(false);\\n\\n  const runVerification = async (tokenToVerify: string) => {\\n    setStatus(\'verifying\');\\n    setErrorMessage(null);\\n    try {\\n      await api.verifyEmail(tokenToVerify.trim());\\n      setVerificationPreviewPath(null);\\n      if (user) {\\n        await refreshUser();\\n      }\\n      setStatus(\'verified\');\\n      notify({\\n        tone: \'success\',\\n        title: \'Email verified\',\\n        description: \'Your LittleSteps email address is now confirmed.\',\\n      });\\n    } catch (err) {\\n      setStatus(\'error\');\\n      setErrorMessage(\\n        err instanceof Error ? err.message : \'This verification link is invalid or has expired.\'\\n      );\\n    }\\n  };\\n\\n  useEffect(() => {\\n    if (initialToken && !user?.emailVerifiedAt) {\\n      void runVerification(initialToken);\\n    }\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n  }, [initialToken]);\\n\\n  const handleResend = async () => {\\n    setResending(true);\\n    setErrorMessage(null);\\n    try {\\n      const res = await api.resendVerification();\\n      if (res.alreadyVerified) {\\n        await refreshUser();\\n        setStatus(\'verified\');\\n        return;\\n      }\\n      if (res.verificationPreviewPath) {\\n        setVerificationPreviewPath(res.verificationPreviewPath);\\n      }\\n      notify({\\n        tone: \'info\',\\n        title: \'Verification link refreshed\',\\n        description: \'Use the link below to verify your email.\',\\n      });\\n    } catch (err) {\\n      setErrorMessage(err instanceof Error ? err.message : \'Unable to send verification link.\');\\n    } finally {\\n      setResending(false);\\n    }\\n  };\\n\\n  const continueLabel = user\\n    ? user.role === \'parent\' && !user.onboardingCompletedAt\\n      ? \'Continue Onboarding\'\\n      : \'Go to Dashboard\'\\n    : \'Sign In to LittleSteps\';\\n\\n  const handleContinue = () => {\\n    onNavigate(user ? \'/\' : \'/login\');\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-md mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\\\">\\n      <div className=\\\"text-center space-y-2\\\">\\n        <p className=\\\"font-mono text-xs text-sage tabular-nums\\\">Email Verification</p>\\n        <h1 className=\\\"font-display text-3xl font-semibold text-charcoal\\\">\\n          Confirm your email address\\n        </h1>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Verifying your email helps protect your account and ensures you can recover access safely.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-5\\\">\\n        {status === \'verifying\' && (\\n          <div className=\\\"py-6 text-center space-y-2\\\">\\n            <p className=\\\"text-sm font-medium text-charcoal\\\">Verifying your link...</p>\\n            <p className=\\\"text-xs text-muted\\\">This takes just a moment.</p>\\n          </div>\\n        )}\\n\\n        {status === \'verified\' && (\\n          <div className=\\\"space-y-4 text-center py-2\\\">\\n            <div className=\\\"w-12 h-12 rounded-full bg-sage-soft text-sage mx-auto flex items-center justify-center\\\">\\n              <CheckCircle2 className=\\\"w-6 h-6\\\" aria-hidden=\\\"true\\\" />\\n            </div>\\n            <div className=\\\"space-y-1\\\">\\n              <h2 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n                Email verified\\n              </h2>\\n              <p className=\\\"text-sm text-muted\\\">\\n                Thank you for confirming{user?.email ? ` ${user.email}` : \' your email address\'}.\\n              </p>\\n            </div>\\n            <Button\\n              variant=\\\"primary\\\"\\n              fullWidth\\n              rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n              onClick={handleContinue}\\n            >\\n              {continueLabel}\\n            </Button>\\n          </div>\\n        )}\\n\\n        {(status === \'idle\' || status === \'error\') && (\\n          <div className=\\\"space-y-4\\\">\\n            {errorMessage && (\\n              <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\\\">\\n                {errorMessage}\\n              </p>\\n            )}\\n\\n            {user && verificationPreviewPath && (\\n              <div className=\\\"rounded-xl bg-cream border border-border p-4 space-y-3\\\">\\n                <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n                  Your local preview verification link is ready for{\' \'}\\n                  <span className=\\\"font-medium text-charcoal\\\">{user.email}</span>:\\n                </p>\\n                <Button\\n                  variant=\\\"primary\\\"\\n                  fullWidth\\n                  rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n                  onClick={() => onNavigate(verificationPreviewPath as NavigateTarget)}\\n                >\\n                  Verify Email Now\\n                </Button>\\n              </div>\\n            )}\\n\\n            <form\\n              onSubmit={(e) => {\\n                e.preventDefault();\\n                if (manualToken.trim().length < 10) {\\n                  setErrorMessage(\'Please enter a valid verification token.\');\\n                  return;\\n                }\\n                void runVerification(manualToken);\\n              }}\\n              className=\\\"space-y-3\\\"\\n            >\\n              <Input\\n                label=\\\"Verification token\\\"\\n                value={manualToken}\\n                onChange={(e) => setManualToken(e.target.value)}\\n                placeholder=\\\"Paste verification token\\\"\\n                helperText=\\\"Opened this page directly? Paste your token or request a fresh link.\\\"\\n              />\\n              <Button type=\\\"submit\\\" variant=\\\"secondary\\\" fullWidth>\\n                Verify Token\\n              </Button>\\n            </form>\\n\\n            {user && (\\n              <div className=\\\"pt-3 border-t border-border flex flex-col gap-2\\\">\\n                <Button\\n                  variant=\\\"ghost\\\"\\n                  fullWidth\\n                  loading={resending}\\n                  leftIcon={<RefreshCw className=\\\"w-4 h-4\\\" />}\\n                  onClick={() => void handleResend()}\\n                >\\n                  Generate Fresh Verification Link\\n                </Button>\\n                <Button variant=\\\"subtle\\\" fullWidth onClick={handleContinue}>\\n                  {continueLabel}\\n                </Button>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </Card>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Implement Login, Register, Forgot Password, Reset Password, and Email Verification pages with inline field validation\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/public/AuthPages.tsx\", \"toolAction\":\"Writing authentication pages\", \"toolSummary\":\"Implement all authentication pages\"}"
      thinking_signature: "\022\323M\n\320M\001i\024}\023\020\227\342\302o\001\217m\222)\330\344\335\a+\252\030%\240L\312\2354\f5\235\307\031q.\341pYM\270+\337\257\222R[\360\310\017S\233\261\262\243\246\220\353\276\f\252\242d\346$\243\243\274\222\326\345Td\202\227\314\237\355A\245\255<*\246\354$pP/\025\032\250\355C\315K\363\305\342\261\253\372\254g\342\035\001\375\0304\rR\207\355\300\367\233\214\367\216MUO\233\376\353~S\254Y\025\027\302l`\256\312\216Cq*3\317\300M\267\214\200\375\230\246\024y\310|=/\202pt\335nU\341p\222P\364\275\\S\361>\260\241\016\v\350I\344\324\334t\275\211\226\341\241\005\021#)Z!\302\322\332v\3767\303\016^X\362\266\032\226sQ\332X\334R\214,\252\024\325\t\350:D\r\211K\v\336\250\216\246+y\246\340L\312R$\300\266\030\016\345\352J\222\037\372c\353\234\312\324\300\251\354I\006V~\361\272\304\002\223\206\247\v;\245\324\036\362\373D\346:b\365\344\276\222\nE\276\213\t\266\303\2168}/D\240\300\032\316\314\n\337\023N\375}\265\276\347*M\357\317\263\206\001\230\347\326\267\267\005\273\310T\222D\t\354/\273\215\203\"\277q\350\024\321\332\347\323\220i\022\001\274\365\3708\016\020(\220\262B\242\363\t\265n\256\274+\273\334\313\306\212L\215\261\211g\337\367\177\212zZ\246*\v\267G\205\222x\274Y\203\346\235G%0YX\006\241l\227D\351C\240\326\2749\022\330IG*\276\222j0\2123\320\277\031K\373M\263Q\201\251,\260\302\023b:\017\035\177\316\230\214\216=\253\232\223Z\321#\354\352\021jFf\264\232\256_K\374\371\211\032I\034\354\373\345L\372\366\231\323K\021\214Y\305\234`E\035\235d1ixr1UW\262UN&\247\224\257h&\001\250\336\363J\246\237\370~E\253XZ\252\360\237W^\2470\214\304hl\322\222\314/~%\225\326%zT\243M\'\266\215\036\020zSgv\301;r\240\310\2777wf_\313]>\'^\006\245\031}\257\322\236R\023~F\324\275L`&]G\320\312\033\005\302(\205\ry\337\267\341\316Z/\312\314(#Y\313[\033\267\343\303\347\361P\033R\2020\245<\351*\341\000\233i\325\024/\330\346\304M<uT\336\002XC\365.L\aS\a\306\004\301\aE|\232\242\306M\n\3020a\336[\361\366\373\375\033\245\254\330\365HE\224\016P\257\303\345\b\'\030\212\235\374\270\3