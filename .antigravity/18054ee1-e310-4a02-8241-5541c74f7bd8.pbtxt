              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Hold one object near your cheek\', instructionText: \'Lift the wooden spoon beside your face and say clearly: \342\200\234Spoon. Wooden spoon.\342\200\235\', caregiverTip: \'Speak slightly slower than adult conversation.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Offer and pause\', instructionText: \'Place the spoon on the mat in front of baby and wait for any babble, reach, or look.\', caregiverTip: \'Respond to babbling as a real reply.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
