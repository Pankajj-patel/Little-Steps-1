  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Camera, Film, Shield, Square, Upload, Video } from \'lucide-react\';\nimport { api } from \'../lib/api\';\nimport { MAX_VIDEO_DURATION_SECONDS, MAX_VIDEO_SIZE_BYTES } from \'../shared/domain\';\nimport type { VideoSubmissionSummary } from \'../shared/types\';\n\ninterface VideoCaptureUploaderProps {\n  childId: string;\n  activityId: string;\n  activityTitle: string;\n  onSubmitted: (submission: VideoSubmissionSummary) => void;\n  onCancel: () => void;\n}\n\nexport function VideoCaptureUploader({\n  childId,\n  activityId,\n  activityTitle,\n  onSubmitted,\n  onCancel,\n}: VideoCaptureUploaderProps) {\n  const [selectedFile, setSelectedFile] = useState<Blob | null>(null);\n  const [filename, setFilename] = useState<string>(\'practice.webm\');\n  const [previewUrl, setPreviewUrl] = useState<string | null>(null);\n  const [durationSeconds, setDurationSeconds] = useState<number>(10);\n  const [caregiverNotes, setCaregiverNotes] = useState(\'\');\n  const [consentConfirmed, setConsentConfirmed] = useState(false);\n\n  const [isRecording, setIsRecording] = useState(false);\n  const [isGeneratingSample, setIsGeneratingSample] = useState(false);\n  const [recordSeconds, setRecordSeconds] = useState(0);\n  const [uploading, setUploading] = useState(false);\n  const [uploadProgress, setUploadProgress] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n\n  const liveVideoRef = useRef<HTMLVideoElement | null>(null);\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const streamRef = useRef<MediaStream | null>(null);\n  const chunksRef = useRef<Blob[]>([]);\n  const timerRef = useRef<number | null>(null);\n\n  const cleanupCamera = () => {\n    if (timerRef.current) {\n      window.clearInterval(timerRef.current);\n      timerRef.current = null;\n    }\n    if (streamRef.current) {\n      streamRef.current.getTracks().forEach((t) => t.stop());\n      streamRef.current = null;\n    }\n  };\n\n  useEffect(() => {\n    return () => {\n      cleanupCamera();\n      if (previewUrl) URL.revokeObjectURL(previewUrl);\n    };\n  }, [previewUrl]);\n\n  const setPreparedVideo = (blob: Blob, name: string, seconds: number) => {\n    if (previewUrl) URL.revokeObjectURL(previewUrl);\n    const url = URL.createObjectURL(blob);\n    setSelectedFile(blob);\n    setFilename(name);\n    setDurationSeconds(Math.max(1, Math.min(MAX_VIDEO_DURATION_SECONDS, Math.round(seconds))));\n    setPreviewUrl(url);\n    setError(null);\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    if (file.size > MAX_VIDEO_SIZE_BYTES) {\n      setError(\'Please choose a video smaller than 50 MB.\');\n      return;\n    }\n    const normalized = file.type.split(\';\')[0].toLowerCase();\n    if (![\'video/mp4\', \'video/webm\', \'video/quicktime\'].includes(normalized)) {\n      setError(\'Please upload an MP4, WebM, or MOV video file.\');\n      return;\n    }\n    const tempUrl = URL.createObjectURL(file);\n    const probe = document.createElement(\'video\');\n    probe.preload = \'metadata\';\n    probe.onloadedmetadata = () => {\n      const dur = Number.isFinite(probe.duration) ? probe.duration : 15;\n      URL.revokeObjectURL(tempUrl);\n      if (dur > MAX_VIDEO_DURATION_SECONDS) {\n        setError(\'Please keep activity clips under 2 minutes so uploads stay light and fast.\');\n        return;\n      }\n      setPreparedVideo(file, file.name, dur);\n    };\n    probe.onerror = () => {\n      URL.revokeObjectURL(tempUrl);\n      setPreparedVideo(file, file.name, 15);\n    };\n    probe.src = tempUrl;\n  };\n\n  const startCameraRecording = async () => {\n    setError(null);\n    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === \'undefined\') {\n      setError(\n        \'Camera recording is unavailable in this browser. You can upload a video file or record a 3-second test clip below.\'\n      );\n      return;\n    }\n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });\n      streamRef.current = stream;\n      if (liveVideoRef.current) {\n        liveVideoRef.current.srcObject = stream;\n        await liveVideoRef.current.play();\n      }\n      chunksRef.current = [];\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm;codecs=vp8\')\n        ? \'video/webm;codecs=vp8\'\n        : \'video/webm\';\n      const recorder = new MediaRecorder(stream, { mimeType });\n      mediaRecorderRef.current = recorder;\n\n      recorder.ondataavailable = (ev) => {\n        if (ev.data.size > 0) chunksRef.current.push(ev.data);\n      };\n      recorder.onstop = () => {\n        const blob = new Blob(chunksRef.current, { type: \'video/webm\' });\n        cleanupCamera();\n        setIsRecording(false);\n        setPreparedVideo(blob, `littlesteps-recording-${Date.now()}.webm`, Math.max(1, recordSeconds));\n      };\n\n      setRecordSeconds(0);\n      setIsRecording(true);\n      recorder.start(250);\n\n      timerRef.current = window.setInterval(() => {\n        setRecordSeconds((prev) => {\n          const next = prev + 1;\n          if (next >= MAX_VIDEO_DURATION_SECONDS) {\n            recorder.stop();\n          }\n          return next;\n        });\n      }, 1000);\n    } catch {\n      cleanupCamera();\n      setIsRecording(false);\n      setError(\n        \'Could not access camera permission. You can upload a saved video clip or record a 3-second sample clip.\'\n      );\n    }\n  };\n\n  const stopCameraRecording = () => {\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state !== \'inactive\') {\n      mediaRecorderRef.current.stop();\n    }\n  };\n\n  /**\n   * Generates a real binary WebM clip via HTMLCanvasElement.captureStream() + MediaRecorder\n   * so caregivers/testers on devices without a webcam can test genuine end-to-end encrypted vault upload & review.\n   */\n  const recordSampleTestClip = async () => {\n    setError(null);\n    if (typeof MediaRecorder === \'undefined\') {\n      setError(\'MediaRecorder is unavailable in this browser. Please choose a video file to upload.\');\n      return;\n    }\n    setIsGeneratingSample(true);\n    try {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 640;\n      canvas.height = 360;\n      const ctx = canvas.getContext(\'2d\');\n      if (!ctx) throw new Error(\'Canvas unavailable\');\n\n      const stream = canvas.captureStream(20);\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm\') ? \'video/webm\' : \'\';\n      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);\n      const chunks: Blob[] = [];\n      recorder.ondataavailable = (ev) => {\n        if (ev.data.size > 0) chunks.push(ev.data);\n      };\n\n      const done = new Promise<Blob>((resolve) => {\n        recorder.onstop = () => {\n          stream.getTracks().forEach((t) => t.stop());\n          resolve(new Blob(chunks, { type: \'video/webm\' }));\n        };\n      });\n\n      recorder.start();\n      let frame = 0;\n      const drawInterval = window.setInterval(() => {\n        frame += 1;\n        ctx.fillStyle = \'#FAF9F6\';\n        ctx.fillRect(0, 0, 640, 360);\n        ctx.strokeStyle = \'#E6E3DC\';\n        ctx.lineWidth = 2;\n        ctx.strokeRect(24, 24, 592, 312);\n\n        // Gentle expanding botanical circle representing calm caregiver pacing\n        const radius = 34 + Math.sin(frame / 8) * 10;\n        ctx.beginPath();\n        ctx.arc(320, 140, radius, 0, Math.PI * 2);\n        ctx.fillStyle = \'#EAF1EE\';\n        ctx.fill();\n        ctx.strokeStyle = \'#2F5D50\';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n\n        ctx.fillStyle = \'#1F2421\';\n        ctx.font = \'600 20px Georgia, serif\';\n        ctx.textAlign = \'center\';\n        ctx.fillText(activityTitle.slice(0, 44), 320, 235);\n\n        ctx.fillStyle = \'#57605A\';\n        ctx.font = \'14px sans-serif\';\n        ctx.fillText(`Caregiver Practice Clip \302\267 00:0${Math.min(3, Math.floor(frame / 20))}`, 320, 268);\n        ctx.fillText(\'Private 30-day vault recording\', 320, 294);\n      }, 50);\n\n      await new Promise((r) => window.setTimeout(r, 3000));\n      window.clearInterval(drawInterval);\n      recorder.stop();\n      const blob = await done;\n      setPreparedVideo(blob, `practice-sample-${Date.now()}.webm`, 3);\n    } catch {\n      setError(\'Could not generate a sample clip in this browser. Please upload a video file instead.\');\n    } finally {\n      setIsGeneratingSample(false);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedFile) {\n      setError(\'Please record or select a short practice clip first.\');\n      return;\n    }\n    if (!consentConfirmed) {\n      setError(\'Please confirm private review consent before uploading.\');\n      return;\n    }\n\n    setUploading(true);\n    setUploadProgress(5);\n    setError(null);\n    try {\n      const { submission } = await api.uploadSubmissionVideo(\n        {\n          childId,\n          activityId,\n          file: selectedFile,\n          filename,\n          durationSeconds,\n          caregiverNotes,\n          consentConfirmed,\n        },\n        (pct) => setUploadProgress(pct)\n      );\n      onSubmitted(submission);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to upload video.\');\n    } finally {\n      setUploading(false);\n    }\n  };\n\n  return (\n    <form onSubmit={handleSubmit} className=\"rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\">\n      <div className=\"flex items-start justify-between gap-4\">\n        <div>\n          <h3 className=\"font-serif text-xl font-medium text-ink\">\n            Share a Short Practice Clip for Feedback\n          </h3>\n          <p className=\"text-sm text-olive mt-1\">\n            A reviewer will assess how clearly the activity steps were demonstrated and share one encouraging tip.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          onClick={onCancel}\n          className=\"text-sm text-olive hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n        >\n          Cancel\n        </button>\n      </div>\n\n      {/* Capture / Upload options */}\n      {!isRecording && !previewUrl && (\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n          <button\n            type=\"button\"\n            onClick={() => void startCameraRecording()}\n            className=\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center cursor-pointer\"\n          >\n            <Camera className=\"w-5 h-5 text-eucalyptus\" aria-hidden=\"true\" />\n            <span className=\"text-sm font-medium text-ink\">Record with Camera</span>\n            <span className=\"text-xs text-olive\">Up to 2 minutes</span>\n          </button>\n\n          <label className=\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center cursor-pointer\">\n            <Upload className=\"w-5 h-5 text-eucalyptus\" aria-hidden=\"true\" />\n            <span className=\"text-sm font-medium text-ink\">Upload Video File</span>\n            <span className=\"text-xs text-olive\">MP4, WebM, MOV \302\267 Max 50 MB</span>\n            <input\n              type=\"file\"\n              accept=\"video/mp4,video/webm,video/quicktime\"\n              onChange={handleFileChange}\n              className=\"sr-only\"\n            />\n          </label>\n\n          <button\n            type=\"button\"\n            onClick={() => void recordSampleTestClip()}\n            disabled={isGeneratingSample}\n            className=\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center disabled:opacity-50 cursor-pointer\"\n          >\n            <Film className=\"w-5 h-5 text-eucalyptus\" aria-hidden=\"true\" />\n            <span className=\"text-sm font-medium text-ink\">\n              {isGeneratingSample ? \'Creating 3s Clip...\' : \'Record 3s Test Clip\'}\n            </span>\n            <span className=\"text-xs text-olive\">No camera required</span>\n          </button>\n        </div>\n      )}\n\n      {/* Live recording preview */}\n      {isRecording && (\n        <div className=\"space-y-3\">\n          <div className=\"aspect-video rounded-lg overflow-hidden bg-black relative\">\n            <video ref={liveVideoRef} muted playsInline className=\"w-full h-full object-cover\" />\n            <div className=\"absolute top-3 left-3 px-2.5 py-1 rounded bg-black/75 text-white text-xs font-mono tabular-nums\">\n              Recording \302\267 {String(Math.floor(recordSeconds / 60)).padStart(2, \'0\')}:\n              {String(recordSeconds % 60).padStart(2, \'0\')}\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={stopCameraRecording}\n            className=\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-crimson text-white text-sm font-medium hover:opacity-90 transition-opacity cursor-pointer\"\n          >\n            <Square className=\"w-4 h-4\" />\n            Stop Recording\n          </button>\n        </div>\n      )}\n\n      {/* Prepared video preview */}\n      {previewUrl && !isRecording && (\n        <div className=\"space-y-3\">\n          <div className=\"aspect-video rounded-lg overflow-hidden bg-black\">\n            <video src={previewUrl} controls playsInline className=\"w-full h-full object-contain\" />\n          </div>\n          <div className=\"flex items-center justify-between text-xs text-olive\">\n            <span className=\"inline-flex items-center gap-1.5 font-mono tabular-nums\">\n              <Video className=\"w-3.5 h-3.5 text-eucalyptus\" />\n              {filename} \302\267 {durationSeconds}s \302\267{\' \'}\n              {selectedFile ? `${(selectedFile.size / (1024 * 1024)).toFixed(2)} MB` : \'\'}\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => {\n                if (previewUrl) URL.revokeObjectURL(previewUrl);\n                setPreviewUrl(null);\n                setSelectedFile(null);\n              }}\n              className=\"text-eucalyptus hover:underline font-medium cursor-pointer\"\n            >\n              Choose a different clip\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Optional caregiver reflection */}\n      <div>\n        <label htmlFor=\"caregiver-video-note\" className=\"block text-sm font-medium text-ink mb-1.5\">\n          Optional note for your reviewer\n        </label>\n        <textarea\n          id=\"caregiver-video-note\"\n          rows={2}\n          value={caregiverNotes}\n          onChange={(e) => setCaregiverNotes(e.target.value)}\n          placeholder=\"For example: Morning session after feeding, used a steel katori and wooden spoon.\"\n          className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink placeholder:text-olive/70 focus:border-eucalyptus\"\n        />\n      </div>\n\n      {/* Explicit Child Video Privacy & Non-Diagnostic Notice */}\n      <div className=\"rounded-lg border border-stone bg-oat/70 p-4 space-y-3\">\n        <div className=\"flex items-start gap-2.5 text-xs text-olive leading-relaxed\">\n          <Shield className=\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\" aria-hidden=\"true\" />\n          <div>\n            <p className=\"font-medium text-ink\">Private \302\267 Auto-deletes in 30 days \302\267 Delete anytime</p>\n            <p className=\"mt-0.5\">\n              Your clip is stored in a private vault accessible only to you and your assigned reviewer (who sees only your baby\342\200\231s age band, never your contact details). Review scores measure caregiver activity execution only\342\200\224never your baby\342\200\231s development or health.\n            </p>\n          </div>\n        </div>\n\n        <label className=\"flex items-start gap-2.5 text-sm text-ink cursor-pointer\">\n          <input\n            type=\"checkbox\"\n            checked={consentConfirmed}\n            onChange={(e) => setConsentConfirmed(e.target.checked)}\n            className=\"mt-1 h-4 w-4 rounded border-stone accent-eucalyptus\"\n          />\n          <span>\n            I consent to private storage of this activity clip for caregiver feedback under the 30-day auto-deletion policy.\n          </span>\n        </label>\n      </div>\n\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-crimson bg-crimson-soft px-3.5 py-2.5 rounded-lg\">\n          {error}\n        </p>\n      )}\n\n      {uploading && (\n        <div className=\"space-y-1.5\">\n          <div className=\"flex justify-between text-xs text-olive font-mono tabular-nums\">\n            <span>Encrypting & uploading to private vault...</span>\n            <span>{uploadProgress}%</span>\n          </div>\n          <div className=\"h-1.5 w-full rounded-full bg-oat overflow-hidden\">\n            <div\n              className=\"h-full bg-eucalyptus transition-all duration-150\"\n              style={{ width: `${uploadProgress}%` }}\n            />\n          </div>\n        </div>\n      )}\n\n      <div className=\"flex items-center justify-end gap-3 pt-1\">\n        <button\n          type=\"button\"\n          onClick={onCancel}\n          disabled={uploading}\n          className=\"px-4 py-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\"\n        >\n          Cancel\n        </button>\n        <button\n          type=\"submit\"\n          disabled={uploading || !selectedFile || !consentConfirmed}\n          className=\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-45 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n        >\n          {uploading ? \'Uploading...\' : \'Submit Clip for Review\'}\n        </button>\n      </div>\n    </form>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/VideoCaptureUploader.tsx"
        }
        overwrite: true
      }
    }
    action_result {
