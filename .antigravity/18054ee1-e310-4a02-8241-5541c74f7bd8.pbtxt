    tool_calls {
      id: "call_638912451946644883"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add registerProfilePhoto and tighten userOwnsPhotoKey in repository\", \"EndLine\":270, \"Instruction\":\"Register uploaded profile photo ownership and check profile_photos table in userOwnsPhotoKey\", \"ReplacementContent\":\"  registerProfilePhoto(storageKey: string, ownerUserId: string): void {\\n    this.db\\n      .prepare(\\n        `INSERT OR REPLACE INTO profile_photos (storage_key, owner_user_id)\\n         VALUES (?, ?)`\\n      )\\n      .run(storageKey, ownerUserId);\\n  }\\n\\n  userOwnsPhotoKey(userId: string, storageKey: string): boolean {\\n    const ownedUpload = this.db\\n      .prepare(\'SELECT 1 as ok FROM profile_photos WHERE storage_key = ? AND owner_user_id = ?\')\\n      .get(storageKey, userId);\\n    if (ownedUpload) return true;\\n    const expectedUrl = `/api/v1/profile/photo/${storageKey}`;\\n    const userRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM users WHERE id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    if (userRow) return true;\\n    const childRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM children WHERE parent_user_id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    return Boolean(childRow);\\n  }\", \"StartLine\":258, \"TargetContent\":\"  userOwnsPhotoKey(userId: string, storageKey: string): boolean {\\n    const expectedUrl = `/api/v1/profile/photo/${storageKey}`;\\n    const userRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM users WHERE id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    if (userRow) return true;\\n    const childRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM children WHERE parent_user_id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    return Boolean(childRow);\\n  }\", \"TargetFile\":\"/server/repositories/index.ts\", \"toolAction\":\"Adding photo ownership tracking to repository\", \"toolSummary\":\"Add photo ownership methods to repository\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_638912451946646920"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Enforce strict owner-only access and validation on private profile photos and onboarding parent updates\", \"EndLine\":528, \"Instruction\":\"Register photo ownership on upload, enforce ownership on GET /profile/photo/:key, validate photo URLs on parent/child updates, and re-issue verification token if email changes\", \"ReplacementContent\":\"  // ======================== PRIVATE PROFILE PHOTOS (OWNER-ONLY) ========================\\n\\n  const validateOwnedPhotoUrl = (userId: string, photoUrl?: string | null): boolean => {\\n    if (!photoUrl) return true;\\n    const match = /^\\\\/api\\\\/v1\\\\/profile\\\\/photo\\\\/([a-z0-9-]+\\\\.(?:jpg|png|webp))$/i.exec(photoUrl);\\n    if (!match) return false;\\n    return repo.userOwnsPhotoKey(userId, match[1]);\\n  };\\n\\n  router.post(\\n    \'/profile/photo\',\\n    requireAuth,\\n    uploadRateLimit,\\n    photoUpload.single(\'photo\'),\\n    async (req: AuthenticatedRequest, res) => {\\n      try {\\n        const file = req.file;\\n        if (!file) {\\n          res.status(400).json({ error: \'Please select an image file.\' });\\n          return;\\n        }\\n        const mime = file.mimetype.split(\';\')[0].trim().toLowerCase();\\n        if (![\'image/jpeg\', \'image/png\', \'image/webp\'].includes(mime)) {\\n          res.status(400).json({ error: \'Please upload a JPG, PNG, or WebP photo.\' });\\n          return;\\n        }\\n        if (!validateImageMagicBytes(file.buffer)) {\\n          res.status(400).json({ error: \'Uploaded file is not a valid image.\' });\\n          return;\\n        }\\n        const ext = mime === \'image/png\' ? \'png\' : mime === \'image/webp\' ? \'webp\' : \'jpg\';\\n        const storageKey = await storage.saveBuffer(file.buffer, ext);\\n        repo.registerProfilePhoto(storageKey, req.authUser!.id);\\n        res.status(201).json({ photoUrl: `/api/v1/profile/photo/${storageKey}` });\\n      } catch {\\n        res.status(500).json({ error: \'Unable to save photo right now.\' });\\n      }\\n    }\\n  );\\n\\n  router.get(\'/profile/photo/:key\', requireAuth, (req: AuthenticatedRequest, res) => {\\n    const key = req.params.key;\\n    if (!key || !/^[a-z0-9-]+\\\\.(jpg|png|webp)$/i.test(key)) {\\n      res.status(400).json({ error: \'Invalid photo identifier.\' });\\n      return;\\n    }\\n    if (!repo.userOwnsPhotoKey(req.authUser!.id, key)) {\\n      res.status(403).json({ error: \'Not authorized to access this photo.\' });\\n      return;\\n    }\\n    if (!storage.exists(key)) {\\n      res.status(404).json({ error: \'Photo not found.\' });\\n      return;\\n    }\\n    const mime = key.endsWith(\'.png\')\\n      ? \'image/png\'\\n      : key.endsWith(\'.webp\')\\n        ? \'image/webp\'\\n        : \'image/jpeg\';\\n    res.setHeader(\'Cache-Control\', \'private, no-store, max-age=0\');\\n    res.setHeader(\'X-Content-Type-Options\', \'nosniff\');\\n    res.setHeader(\'Content-Type\', mime);\\n    storage.openReadStream(key).pipe(res);\\n  });\\n\\n  // ======================== PARENT ONBOARDING ========================\\n\\n  router.put(\\n    \'/onboarding/parent\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = onboardingParentSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid parent details.\' });\\n        return;\\n      }\\n      if (!validateOwnedPhotoUrl(req.authUser!.id, parsed.data.profilePhotoUrl)) {\\n        res.status(403).json({ error: \'Invalid or unauthorized profile photo reference.\' });\\n        return;\\n      }\\n      const existingByEmail = repo.findUserByEmail(parsed.data.email);\\n      if (existingByEmail && existingByEmail.id !== req.authUser!.id) {\\n        res.status(409).json({ error: \'Another account already uses this email address.\' });\\n        return;\\n      }\\n      const emailChanged =\\n        parsed.data.email.trim().toLowerCase() !== req.authUser!.email.trim().toLowerCase();\\n      const updated = repo.updateParentProfileAndPreferences(req.authUser!.id, {\\n        fullName: parsed.data.fullName,\\n        email: parsed.data.email,\\n        preferredLocale: parsed.data.preferredLocale,\\n        profilePhotoUrl: parsed.data.profilePhotoUrl,\\n      });\\n\\n      let verificationPreviewPath: string | undefined;\\n      if (emailChanged && updated) {\\n        const { rawToken, tokenHash } = generateOneTimeToken();\\n        const expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();\\n        repo.createAuthToken({\\n          userId: updated.id,\\n          tokenType: \'email_verification\',\\n          tokenHash,\\n          expiresAt,\\n        });\\n        if (process.env.NODE_ENV !== \'production\') {\\n          verificationPreviewPath = `/verify-email?token=${encodeURIComponent(rawToken)}`;\\n        }\\n      }\\n\\n      res.json({ user: updated, verificationPreviewPath });\\n    }\\n  );\\n\\n  router.post(\\n    \'/onboarding/complete\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = onboardingPreferencesSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid preferences.\' });\\n        return;\\n      }\\n      const children = repo.listChildrenByParent(req.authUser!.id);\\n      if (children.length === 0) {\\n        res.status(400).json({\\n          error: \'Please add your baby\342\200\231s information before finishing onboarding.\',\\n        });\\n        return;\\n      }\\n      const updated = repo.updateParentProfileAndPreferences(req.authUser!.id, {\\n        preferredActivityTime: parsed.data.preferredActivityTime,\\n        notificationPreference: parsed.data.notificationPreference,\\n        preferredLocale: parsed.data.preferredLocale,\\n        markOnboardingComplete: parsed.data.markComplete,\\n      });\\n      res.json({ user: updated });\\n    }\\n  );\\n\\n  // ======================== PARENT: CHILDREN ========================\\n\\n  router.get(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const children = repo.listChildrenByParent(req.authUser!.id);\\n    res.json({ children });\\n  });\\n\\n  router.post(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    if (!validateOwnedPhotoUrl(req.authUser!.id, parsed.data.profilePhotoUrl)) {\\n      res.status(403).json({ error: \'Invalid or unauthorized baby photo reference.\' });\\n      return;\\n    }\\n    const dobDate = new Date(parsed.data.dateOfBirth);\\n    if (dobDate.getTime() > Date.now()) {\\n      res.status(400).json({ error: \'Date of birth cannot be in the future.\' });\\n      return;\\n    }\\n    const child = repo.createChild(req.authUser!.id, parsed.data.displayName, parsed.data.dateOfBirth, {\\n      profilePhotoUrl: parsed.data.profilePhotoUrl ?? null,\\n      activityPreferences: parsed.data.activityPreferences ?? null,\\n    });\\n    res.status(201).json({ child });\\n  });\\n\\n  router.patch(\'/children/:id\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    if (!validateOwnedPhotoUrl(req.authUser!.id, parsed.data.profilePhotoUrl)) {\\n      res.status(403).json({ error: \'Invalid or unauthorized baby photo reference.\' });\\n      return;\\n    }\\n    const dobDate = new Date(parsed.data.dateOfBirth);\\n    if (dobDate.getTime() > Date.now()) {\\n      res.status(400).json({ error: \'Date of birth cannot be in the future.\' });\\n      return;\\n    }\\n    const child = repo.updateChild(\\n      req.params.id,\\n      req.authUser!.id,\\n      parsed.data.displayName,\\n      parsed.data.dateOfBirth,\\n      {\\n        profilePhotoUrl: parsed.data.profilePhotoUrl,\\n        activityPreferences: parsed.data.activityPreferences,\\n      }\\n    );\\n    if (!child) {\\n      res.status(404).json({ error: \'Child profile not found.\' });\\n      return;\\n    }\\n    res.json({ child });\\n  });\", \"StartLine\":369, \"TargetContent\":\"  // ======================== PRIVATE PROFILE PHOTOS (OWNER-ONLY) ========================\\n\\n  router.post(\\n    \'/profile/photo\',\\n    requireAuth,\\n    uploadRateLimit,\\n    photoUpload.single(\'photo\'),\\n    async (req: AuthenticatedRequest, res) => {\\n      try {\\n        const file = req.file;\\n        if (!file) {\\n          res.status(400).json({ error: \'Please select an image file.\' });\\n          return;\\n        }\\n        const mime = file.mimetype.split(\';\')[0].trim().toLowerCase();\\n        if (![\'image/jpeg\', \'image/png\', \'image/webp\'].includes(mime)) {\\n          res.status(400).json({ error: \'Please upload a JPG, PNG, or WebP photo.\' });\\n          return;\\n        }\\n        if (!validateImageMagicBytes(file.buffer)) {\\n          res.status(400).json({ error: \'Uploaded file is not a valid image.\' });\\n          return;\\n        }\\n        const ext = mime === \'image/png\' ? \'png\' : mime === \'image/webp\' ? \'webp\' : \'jpg\';\\n        const storageKey = await storage.saveBuffer(file.buffer, ext);\\n        res.status(201).json({ photoUrl: `/api/v1/profile/photo/${storageKey}` });\\n      } catch {\\n        res.status(500).json({ error: \'Unable to save photo right now.\' });\\n      }\\n    }\\n  );\\n\\n  router.get(\'/profile/photo/:key\', requireAuth, (req: AuthenticatedRequest, res) => {\\n    const key = req.params.key;\\n    if (!key || !/^[a-z0-9-]+\\\\.(jpg|png|webp)$/i.test(key)) {\\n      res.status(400).json({ error: \'Invalid photo identifier.\' });\\n      return;\\n    }\\n    if (!storage.exists(key)) {\\n      res.status(404).json({ error: \'Photo not found.\' });\\n      return;\\n    }\\n    // Note: freshly uploaded photo during onboarding before save is temporarily accessible to the authenticated uploader via session; once saved, verify ownership strictly.\\n    const mime = key.endsWith(\'.png\')\\n      ? \'image/png\'\\n      : key.endsWith(\'.webp\')\\n        ? \'image/webp\'\\n        : \'image/jpeg\';\\n    res.setHeader(\'Cache-Control\', \'private, max-age=300\');\\n    res.setHeader(\'Content-Type\', mime);\\n    storage.openReadStream(key).pipe(res);\\n  });\\n\\n  // ======================== PARENT ONBOARDING ========================\\n\\n  router.put(\\n    \'/onboarding/parent\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = onboardingParentSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid parent details.\' });\\n        return;\\n      }\\n      const existingByEmail = repo.findUserByEmail(parsed.data.email);\\n      if (existingByEmail && existingByEmail.id !== req.authUser!.id) {\\n        res.status(409).json({ error: \'Another account already uses this email address.\' });\\n        return;\\n      }\\n      const updated = repo.updateParentProfileAndPreferences(req.authUser!.id, {\\n        fullName: parsed.data.fullName,\\n        email: parsed.data.email,\\n        preferredLocale: parsed.data.preferredLocale,\\n        profilePhotoUrl: parsed.data.profilePhotoUrl,\\n      });\\n      res.json({ user: updated });\\n    }\\n  );\\n\\n  router.post(\\n    \'/onboarding/complete\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = onboardingPreferencesSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid preferences.\' });\\n        return;\\n      }\\n      const children = repo.listChildrenByParent(req.authUser!.id);\\n      if (children.length === 0) {\\n        res.status(400).json({\\n          error: \'Please add your baby\342\200\231s information before finishing onboarding.\',\\n        });\\n        return;\\n      }\\n      const updated = repo.updateParentProfileAndPreferences(req.authUser!.id, {\\n        preferredActivityTime: parsed.data.preferredActivityTime,\\n        notificationPreference: parsed.data.notificationPreference,\\n        preferredLocale: parsed.data.preferredLocale,\\n        markOnboardingComplete: parsed.data.markComplete,\\n      });\\n      res.json({ user: updated });\\n    }\\n  );\\n\\n  // ======================== PARENT: CHILDREN ========================\\n\\n  router.get(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const children = repo.listChildrenByParent(req.authUser!.id);\\n    res.json({ children });\\n  });\\n\\n  router.post(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    const dobDate = new Date(parsed.data.dateOfBirth);\\n    if (dobDate.getTime() > Date.now()) {\\n      res.status(400).json({ error: \'Date of birth cannot be in the future.\' });\\n      return;\\n    }\\n    const child = repo.createChild(req.authUser!.id, parsed.data.displayName, parsed.data.dateOfBirth, {\\n      profilePhotoUrl: parsed.data.profilePhotoUrl ?? null,\\n      activityPreferences: parsed.data.activityPreferences ?? null,\\n    });\\n    res.status(201).json({ child });\\n  });\\n\\n  router.patch(\'/children/:id\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    const dobDate = new Date(parsed.data.dateOfBirth);\\n    if (dobDate.getTime() > Date.now()) {\\n      res.status(400).json({ error: \'Date of birth cannot be in the future.\' });\\n      return;\\n    }\\n    const child = repo.updateChild(\\n      req.params.id,\\n      req.authUser!.id,\\n      parsed.data.displayName,\\n      parsed.data.dateOfBirth,\\n      {\\n        profilePhotoUrl: parsed.data.profilePhotoUrl,\\n        activityPreferences: parsed.data.activityPreferences,\\n      }\\n    );\\n    if (!child) {\\n      res.status(404).json({ error: \'Child profile not found.\' });\\n      return;\\n    }\\n    res.json({ child });\\n  });\", \"TargetFile\":\"/server/routes/api.ts\", \"toolAction\":\"Hardening photo ownership and onboarding API routes\", \"toolSummary\":\"Enforce owner-only photo access in API routes\"}"
      original_name: "replace_file_content"
