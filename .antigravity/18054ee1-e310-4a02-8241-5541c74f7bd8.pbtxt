              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Roll gently onto tummy\', instructionText: \'Guide baby slowly from back to side to tummy, tucking elbows neatly under shoulders.\', caregiverTip: \'Offer a small rolled towel under the chest if needed.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Lie down at eye level\', instructionText: \'Rest on the mat beside the mirror so baby sees both you and their reflection.\', caregiverTip: \'Your calm voice gives reassurance.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Roll out with ease\', instructionText: \'After 2\342\200\2233 minutes or at early fussing, narrate \342\200\234rolling back now\342\200\235 and turn baby gently.\', caregiverTip: \'Short positive sessions build comfort.\' },"
