    end_line: 301
    content: "import React, { useState } from \'react\';\nimport { ArrowRight, ShieldCheck } from \'lucide-react\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { Button, Card, Input, useToast } from \'../../design-system\';\nimport type { PublicRoute } from \'../../lib/router\';\n\ninterface AuthPageProps {\n  onNavigate: (route: PublicRoute) => void;\n}\n\n/* ========================================================================= */\n/* 8. LOGIN PAGE                                                             */\n/* ========================================================================= */\nexport function LoginPage({ onNavigate }: AuthPageProps) {\n  const { login } = useAuth();\n  const { notify } = useToast();\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [submitting, setSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setSubmitting(true);\n    try {\n      const user = await login(email, password);\n      notify({\n        tone: \'success\',\n        title: `Welcome back, ${user.fullName.split(\' \')[0]}`,\n      });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to sign in.\');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const handleDemoLogin = async (demoEmail: string) => {\n    setError(null);\n    setSubmitting(true);\n    try {\n      const user = await login(demoEmail, \'LittleSteps123!\');\n      notify({\n        tone: \'success\',\n        title: `Signed in as ${user.fullName}`,\n        description: `Opening ${user.role} workspace.`,\n      });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to sign in.\');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-md mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\">\n      <div className=\"text-center space-y-2\">\n        <p className=\"font-mono text-xs text-sage tabular-nums\">Welcome Back</p>\n        <h1 className=\"font-display text-3xl font-semibold text-charcoal\">\n          Sign in to LittleSteps\n        </h1>\n        <p className=\"text-sm text-muted\">\n          Continue your baby\342\200\231s calm daily activity journey.\n        </p>\n      </div>\n\n      <Card className=\"space-y-5\">\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <Input\n            label=\"Email address\"\n            type=\"email\"\n            required\n            autoComplete=\"email\"\n            value={email}\n            onChange={(e) => setEmail(e.target.value)}\n            placeholder=\"you@example.com\"\n          />\n\n          <Input\n            label=\"Password\"\n            type=\"password\"\n            required\n            autoComplete=\"current-password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            placeholder=\"Enter your password\"\n          />\n\n          {error && (\n            <p role=\"alert\" className=\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\">\n              {error}\n            </p>\n          )}\n\n          <Button\n            type=\"submit\"\n            variant=\"primary\"\n            fullWidth\n            loading={submitting}\n            rightIcon={<ArrowRight className=\"w-4 h-4\" />}\n          >\n            Sign In\n          </Button>\n        </form>\n\n        <div className=\"pt-4 border-t border-border space-y-2.5\">\n          <p className=\"text-xs text-muted\">Quick prototype workspace access:</p>\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n            <Button\n              variant=\"subtle\"\n              size=\"sm\"\n              disabled={submitting}\n              onClick={() => void handleDemoLogin(\'meera@littlesteps.in\')}\n            >\n              Parent\n            </Button>\n            <Button\n              variant=\"subtle\"\n              size=\"sm\"\n              disabled={submitting}\n              onClick={() => void handleDemoLogin(\'ananya.reviewer@littlesteps.in\')}\n            >\n              Reviewer\n            </Button>\n            <Button\n              variant=\"subtle\"\n              size=\"sm\"\n              disabled={submitting}\n              onClick={() => void handleDemoLogin(\'kavita.admin@littlesteps.in\')}\n            >\n              Admin\n            </Button>\n          </div>\n        </div>\n      </Card>\n\n      <p className=\"text-center text-sm text-muted\">\n        New to LittleSteps?{\' \'}\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\'/register\')}\n          className=\"text-sage font-medium hover:underline cursor-pointer\"\n        >\n          Create a parent account\n        </button>\n      </p>\n    </div>\n  );\n}\n\n/* ========================================================================= */\n/* 9. REGISTER PAGE                                                          */\n/* ========================================================================= */\nexport function RegisterPage({ onNavigate }: AuthPageProps) {\n  const { register } = useAuth();\n  const { notify } = useToast();\n  const [fullName, setFullName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [phoneNumber, setPhoneNumber] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [submitting, setSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    if (password.length < 8) {\n      setError(\'Please choose a password with at least 8 characters.\');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      await register({\n        fullName,\n        email,\n        phoneNumber: phoneNumber || undefined,\n        password,\n      });\n      notify({\n        tone: \'success\',\n        title: \'Welcome to LittleSteps\',\n        description: \'Next, add your baby\342\200\231s date of birth to match daily activities.\',\n      });\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to create your account.\');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-lg mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-6\">\n      <div className=\"text-center space-y-2\">\n        <p className=\"font-mono text-xs text-sage tabular-nums\">Start Your Journey</p>\n        <h1 className=\"font-display text-3xl font-semibold text-charcoal\">\n          Create your parent account\n        </h1>\n        <p className=\"text-sm text-muted\">\n          Gentle, age-appropriate daily activities matched automatically to your baby\342\200\231s stage.\n        </p>\n      </div>\n\n      <Card className=\"space-y-5\">\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <Input\n            label=\"Your name\"\n            required\n            autoComplete=\"name\"\n            value={fullName}\n            onChange={(e) => setFullName(e.target.value)}\n            placeholder=\"e.g., Priya Sharma\"\n          />\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <Input\n              label=\"Email address\"\n              type=\"email\"\n              required\n              autoComplete=\"email\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              placeholder=\"you@example.com\"\n            />\n\n            <Input\n              label=\"Mobile number (optional)\"\n              type=\"tel\"\n              autoComplete=\"tel\"\n              value={phoneNumber}\n              onChange={(e) => setPhoneNumber(e.target.value)}\n              placeholder=\"+91 98xxx xxxxx\"\n            />\n          </div>\n\n          <Input\n            label=\"Create password\"\n            type=\"password\"\n            required\n            minLength={8}\n            autoComplete=\"new-password\"\n            value={password}\n            onChange={(e) => setPassword(e.target.value)}\n            placeholder=\"At least 8 characters\"\n            helperText=\"Used only to keep your family journal and private clips secure.\"\n          />\n\n          {error && (\n            <p role=\"alert\" className=\"text-xs text-danger bg-danger-soft px-3.5 py-2.5 rounded-lg\">\n              {error}\n            </p>\n          )}\n\n          <div className=\"rounded-lg bg-cream/80 border border-border p-3.5 flex items-start gap-2.5 text-xs text-muted leading-relaxed\">\n            <ShieldCheck className=\"w-4 h-4 text-sage shrink-0 mt-0.5\" aria-hidden=\"true\" />\n            <span>\n              By creating an account you agree to our{\' \'}\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'/terms\')}\n                className=\"text-sage font-medium hover:underline cursor-pointer\"\n              >\n                Terms & Conditions\n              </button>{\' \'}\n              and{\' \'}\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'/privacy\')}\n                className=\"text-sage font-medium hover:underline cursor-pointer\"\n              >\n                Privacy Policy\n              </button>\n              . Uploaded baby videos remain strictly private and auto-delete after 30 days.\n            </span>\n          </div>\n\n          <Button\n            type=\"submit\"\n            variant=\"primary\"\n            fullWidth\n            loading={submitting}\n            rightIcon={<ArrowRight className=\"w-4 h-4\" />}\n          >\n            Start Your Journey\n          </Button>\n        </form>\n      </Card>\n\n      <p className=\"text-center text-sm text-muted\">\n        Already have an account?{\' \'}\n        <button\n          type=\"button\"\n          onClick={() => onNavigate(\'/login\')}\n          className=\"text-sage font-medium hover:underline cursor-pointer\"\n        >\n          Sign in\n        </button>\n      </p>\n    </div>\n  );\n}\n"
    num_lines: 302
    num_bytes: 9833
    line_range_bytes: 9833
  }
}
