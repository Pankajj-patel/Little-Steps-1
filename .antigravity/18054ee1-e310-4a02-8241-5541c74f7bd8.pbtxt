e: string;\n    focusNote: string;\n    activityIds: string[];\n  }) =>\n    requestJson<{\n      plans: Array<{\n        id: string;\n        ageGroupId: string;\n        dayNumber: number;\n        title: string;\n        focusNote: string;\n        activityIds: string[];\n      }>;\n    }>(\'/api/v1/admin/daily-plans\', {\n      method: \'PUT\',\n      body: JSON.stringify(payload),\n    }),\n  getAdminUsers: () => requestJson<{ users: UserProfile[] }>(\'/api/v1/admin/users\'),\n  updateAdminUser: (id: string, updates: { role?: UserRole; isActive?: boolean }) =>\n    requestJson<{ user: UserProfile }>(`/api/v1/admin/users/${id}/role`, {\n      method: \'PATCH\',\n      body: JSON.stringify(updates),\n    }),\n  getAdminAuditLogs: () =>\n    requestJson<{ logs: MediaAuditLogItem[]; lastRetentionSweepAt: string | null }>(\n      \'/api/v1/admin/audit-logs\'\n    ),\n  runAdminRetentionSweep: () =>\n    requestJson<{ purgedCount: number; sweptAt: string }>(\'/api/v1/admin/retention/run\', {\n      method: \'POST\',\n    }),\n};"
          replacement_content: "  // Admin\n  getAdminOverview: () => requestJson<AdminOverviewResponse>(\'/api/v1/admin/overview\'),\n\n  getAdminAgeGroups: () => requestJson<{ ageGroups: AdminAgeGroupItem[] }>(\'/api/v1/admin/age-groups\'),\n  saveAdminAgeGroup: (\n    id: string | null,\n    payload: {\n      slug: string;\n      label: string;\n      minMonths: number;\n      maxMonths: number;\n      sortOrder: number;\n    }\n  ) =>\n    requestJson<{ ageGroup: AdminAgeGroupItem }>(\n      id ? `/api/v1/admin/age-groups/${encodeURIComponent(id)}` : \'/api/v1/admin/age-groups\',\n      {\n        method: id ? \'PUT\' : \'POST\',\n        body: JSON.stringify(payload),\n      }\n    ),\n\n  getAdminDomains: () => requestJson<{ domains: AdminDomainItem[] }>(\'/api/v1/admin/domains\'),\n  saveAdminDomain: (\n    id: string | null,\n    payload: {\n      slug: string;\n      name: string;\n      description: string;\n      sortOrder: number;\n    }\n  ) =>\n    requestJson<{ domain: AdminDomainItem }>(\n      id ? `/api/v1/admin/domains/${encodeURIComponent(id)}` : \'/api/v1/admin/domains\',\n      {\n        method: id ? \'PUT\' : \'POST\',\n        body: JSON.stringify(payload),\n      }\n    ),\n\n  getAdminActivities: (ageGroupId?: string, domainId?: string, status?: ActivityStatus | \'all\') => {\n    const qs = new URLSearchParams();\n    if (ageGroupId) qs.set(\'ageGroupId\', ageGroupId);\n    if (domainId) qs.set(\'domainId\', domainId);\n    if (status && status !== \'all\') qs.set(\'status\', status);\n    const suffix = qs.toString() ? `?${qs.toString()}` : \'\';\n    return requestJson<{ activities: ActivitySummary[] }>(`/api/v1/admin/activities${suffix}`);\n  },\n  getAdminActivityDetail: (id: string) =>\n    requestJson<{ activity: ActivityDetail }>(`/api/v1/admin/activities/${encodeURIComponent(id)}`),\n  getAdminActivityVersions: (id: string) =>\n    requestJson<{\n      activityId: string;\n      currentVersion: number;\n      versions: ActivityVersionSnapshot[];\n    }>(`/api/v1/admin/activities/${encodeURIComponent(id)}/versions`),\n  saveAdminActivity: (\n    id: string | null,\n    payload: {\n      ageGroupId: string;\n      domainId: string;\n      title: string;\n      summary: string;\n      objectives?: string[];\n      durationMinutes: number;\n      prepLevel?: ActivityPrepLevel;\n      materials: string[];\n      safetyNotes: string;\n      instructionalPosterUrl: string;\n      instructionalVideoUrl?: string | null;\n      status: ActivityStatus;\n      changeNote?: string | null;\n      steps: Array<{ title: string; instructionText: string; caregiverTip?: string | null }>;\n      rubricCriteria: Array<{ label: string; description: string; weightPoints: number }>;\n    }\n  ) =>\n    requestJson<{ activity: ActivityDetail }>(\n      id ? `/api/v1/admin/activities/${encodeURIComponent(id)}` : \'/api/v1/admin/activities\',\n      {\n        method: id ? \'PUT\' : \'POST\',\n        body: JSON.stringify(payload),\n      }\n    ),\n  updateAdminActivityStatus: (id: string, status: ActivityStatus) =>\n    requestJson<{ activity: ActivityDetail }>(\n      `/api/v1/admin/activities/${encodeURIComponent(id)}/status`,\n      {\n        method: \'PATCH\',\n        body: JSON.stringify({ status }),\n      }\n    ),\n  deleteAdminActivity: (id: string) =>\n    requestJson<{ ok: boolean }>(`/api/v1/admin/activities/${encodeURIComponent(id)}`, {\n      method: \'DELETE\',\n    }),\n\n  getAdminDailyPlans: (ageGroupId: string) =>\n    requestJson<{\n      plans: Array<{\n        id: string;\n        ageGroupId: string;\n        dayNumber: number;\n        title: string;\n        focusNote: string;\n        activityIds: string[];\n      }>;\n      activities: ActivitySummary[];\n    }>(`/api/v1/admin/daily-plans?ageGroupId=${encodeURIComponent(ageGroupId)}`),\n  saveAdminDailyPlan: (payload: {\n    ageGroupId: string;\n    dayNumber: number;\n    title: string;\n    focusNote: string;\n    activityIds: string[];\n  }) =>\n    requestJson<{\n      plans: Array<{\n        id: string;\n        ageGroupId: string;\n        dayNumber: number;\n        title: string;\n        focusNote: string;\n        activityIds: string[];\n      }>;\n    }>(\'/api/v1/admin/daily-plans\', {\n      method: \'PUT\',\n      body: JSON.stringify(payload),\n    }),\n  deleteAdminDailyPlan: (id: string) =>\n    requestJson<{ ok: boolean }>(`/api/v1/admin/daily-plans/${encodeURIComponent(id)}`, {\n      method: \'DELETE\',\n    }),\n\n  getAdminReviewers: () =>\n    requestJson<{ reviewers: AdminReviewerItem[] }>(\'/api/v1/admin/reviewers\'),\n  createAdminReviewer: (payload: {\n    email: string;\n    fullName: string;\n    password: string;\n    allowedAgeGroupSlugs: string[];\n    specialtyNote?: string | null;\n  }) =>\n    requestJson<{ reviewer: AdminReviewerItem }>(\'/api/v1/admin/reviewers\', {\n      method: \'POST\',\n      body: JSON.stringify(payload),\n    }),\n  updateAdminReviewer: (\n    id: string,\n    payload: {\n      isActive?: boolean;\n      allowedAgeGroupSlugs?: string[];\n      specialtyNote?: string | null;\n    }\n  ) =>\n    requestJson<{ reviewer: AdminReviewerItem }>(\n      `/api/v1/admin/reviewers/${encodeURIComponent(id)}`,\n      {\n        method: \'PATCH\',\n        body: JSON.stringify(payload),\n      }\n    ),\n\n  getAdminSubmissions: (status: SubmissionReviewStatus | \'all\' = \'all\', ageGroupSlug = \'all\') =>\n    requestJson<{ submissions: AdminSubmissionItem[] }>(\n      `/api/v1/admin/submissions?status=${encodeURIComponent(status)}&ageGroupSlug=${encodeURIComponent(ageGroupSlug)}`\n    ),\n  assignAdminSubmission: (submissionId: string, reviewerUserId: string | null) =>\n    requestJson<{ submission: AdminSubmissionItem }>(\n      `/api/v1/admin/submissions/${encodeURIComponent(submissionId)}/assign`,\n      {\n        method: \'PATCH\',\n        body: JSON.stringify({ reviewerUserId }),\n      }\n    ),\n\n  getAdminUsers: () => requestJson<{ users: AdminUserItem[] }>(\'/api/v1/admin/users\'),\n  updateAdminUser: (id: string, updates: { role?: UserRole; isActive?: boolean }) =>\n    requestJson<{ user: UserProfile }>(`/api/v1/admin/users/${encodeURIComponent(id)}/role`, {\n      method: \'PATCH\',\n      body: JSON.stringify(updates),\n    }),\n\n  getAdminAuditLogs: (category: UnifiedAuditCategory | \'all\' = \'all\') =>\n    requestJson<{\n      unifiedLogs: UnifiedAuditLogItem[];\n      logs: MediaAuditLogItem[];\n      lastRetentionSweepAt: string | null;\n    }>(`/api/v1/admin/audit-logs?category=${encodeURIComponent(category)}`),\n  runAdminRetentionSweep: () =>\n    requestJson<{ purgedCount: number; sweptAt: string }>(\'/api/v1/admin/retention/run\', {\n      method: \'POST\',\n    }),\n};"
