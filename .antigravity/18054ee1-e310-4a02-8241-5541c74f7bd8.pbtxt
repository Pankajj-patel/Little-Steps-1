            lines {
              text: "    title: \'How optional caregiver coaching works (and stays private)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    summary:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Video coaching evaluates how clearly an activity\342\200\231s instructions were set up and paced\342\200\224never your baby\342\200\231s intelligence or health.\',"
