  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  /* Typography Families */\n  --font-display: \"Nunito\", \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-serif: \"Nunito\", \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-sans: \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  --font-mono: \"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace;\n\n  /* LittleSteps Step 1 Color Palette Tokens (WCAG 2.2 AA calibrated) */\n  --color-sage: #446E5A;\n  --color-sage-hover: #375A49;\n  --color-sage-soft: #EBF2EE;\n  --color-sage-border: #C5D8CE;\n\n  --color-cream: #F6F1E7;\n  --color-offwhite: #FAF9F6;\n  --color-surface: #FFFFFF;\n\n  --color-peach: #E8B99B;\n  --color-peach-soft: #FBF1EA;\n  --color-peach-ink: #844825;\n\n  --color-lavender: #D6CEE9;\n  --color-lavender-soft: #F3F0FA;\n  --color-lavender-ink: #4F4278;\n\n  --color-charcoal: #222624;\n  --color-muted: #5C635E;\n  --color-border: #E5E2DA;\n  --color-border-strong: #D3CEC3;\n\n  /* Semantic Feedback Tokens */\n  --color-success: #3B6B53;\n  --color-success-soft: #EAF3EE;\n  --color-warning: #8F5815;\n  --color-warning-soft: #FBF3E6;\n  --color-danger: #A63232;\n  --color-danger-soft: #FCEFEF;\n\n  /* Backward-compatible semantic aliases */\n  --color-chalk: #FAF9F6;\n  --color-linen: #FFFFFF;\n  --color-oat: #F6F1E7;\n  --color-stone: #E5E2DA;\n  --color-ink: #222624;\n  --color-olive: #5C635E;\n  --color-eucalyptus: #446E5A;\n  --color-eucalyptus-hover: #375A49;\n  --color-eucalyptus-soft: #EBF2EE;\n  --color-ochre: #8F5815;\n  --color-ochre-soft: #FBF3E6;\n  --color-crimson: #A63232;\n  --color-crimson-soft: #FCEFEF;\n}\n\n@layer base {\n  html {\n    background-color: var(--color-offwhite);\n    color: var(--color-charcoal);\n    font-family: var(--font-sans);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    overflow-x: clip;\n  }\n\n  body {\n    margin: 0;\n    min-height: 100vh;\n    background-color: var(--color-offwhite);\n    color: var(--color-charcoal);\n    line-height: 1.6;\n    overflow-x: clip;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: var(--font-display);\n    text-wrap: balance;\n    letter-spacing: -0.015em;\n  }\n\n  button:focus-visible,\n  a:focus-visible,\n  input:focus-visible,\n  select:focus-visible,\n  textarea:focus-visible,\n  [tabindex]:focus-visible {\n    outline: 2px solid var(--color-sage);\n    outline-offset: 2px;\n  }\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n.pb-safe {\n  padding-bottom: max(0.5rem, env(safe-area-inset-bottom));\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
