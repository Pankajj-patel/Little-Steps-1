            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### Core Entity Highlights"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`users` & `user_consents`**: Role-typed accounts (`parent`, `reviewer`, `admin`), locale preference, and timestamped privacy/video consent records."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`age_groups` & `learning_domains`**: Seeded reference tables for all 8 age bands (`min_months`, `max_months`) and 6 developmental domains with translation-key hooks."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`children`**: Linked to `parent_user_id`, storing `display_name`, `date_of_birth`, and computed active age band."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`activities`, `activity_steps`, `activity_rubric_criteria`**: Structured activity definition including household materials, safety notes, instructional media, ordered caregiver steps, and weighted observable rubric items (strictly scoped to caregiver technique)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`daily_plans` & `daily_plan_items`**: Curated day-by-day sequences per age group (2\342\200\2233 focused activities/day across rotating domains) preventing caregiver overwhelm."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`activity_completions` & `video_submissions`**: Tracks completion progress, optional caregiver reflections, opaque private media storage keys, review queue assignment, and automatic `expires_at` (30-day retention) + `deleted_at` / `deletion_reason`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`submission_reviews` & `review_rubric_scores`**: Stores criterion-level ratings (`met` = 100%, `partially_met` = 50%, `not_observed` = 0%), weighted **Caregiver Instruction-Match Score (%)**, strengths note, next-time coaching tip, and reviewer non-diagnostic attestation timestamp."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`media_access_audit_logs`**: Immutable ledger of every video upload, playback stream, review access, parent deletion, and automated 30-day purge."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Interactive Component & State Mapping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Auth & Role Routing**: Session hydration checks `/api/v1/auth/me` on boot and routes users strictly to their permitted workspace (Parent, Reviewer, or Admin) with graceful unauthorized fallback."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Child Age-Band Calculation**: Creating or editing a baby\'s DOB immediately recalculates age in months on both client preview and server validation, updating Today\'s Journey dynamically."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Activity Stepper & Submission Flow**: Interactive step completion toggles persist locally during practice; submitting a video validates MIME/size/duration client-side before multipart upload, shows real progress, enforces consent checkbox, and transitions card status cleanly to `Submitted for Review`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Reviewer Rubric Engine**: Toggling any rubric criterion (`Met` / `Partially Met` / `Not Observed`) recalculates the weighted caregiver instruction-match percentage live; submission stays disabled until all criteria are rated, coaching notes are entered, and the non-diagnostic attestation checkbox is checked."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Retention & Instant Delete**: Clicking `Delete Video` opens an inline confirmation (never `window.confirm`), calls `DELETE /api/v1/submissions/:id/video`, immediately unlinks the file, refreshes the UI state to `Video Deleted (Feedback Preserved)`, and records the audit entry."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Phased, Independently Testable Implementation Milestones"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| Milestone | Scope & Deliverables | Independent Verification Criteria |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| :--- | :--- | :--- |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Milestone 1 (Step 1): Core Foundation, DB, Auth & Editorial Shell** | Express + Vite unified server on port 3000; strict TypeScript; SQLite schema, migrations, Repository layer & seed data (8 age groups, 6 domains, realistic starter curriculum + demo accounts for Parent, Reviewer, Admin); Auth + RBAC middleware; i18n dictionary setup; Warm Calm Montessori Editorial design tokens & shell. | Register/login works for all 3 roles; RBAC blocks cross-role API calls (`403`); seeded age groups and domains load from SQLite; responsive editorial layout passes type-check and build. |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Milestone 2 (Step 2): Parent Onboarding, Child Profiles & Today\'s Daily Journey** | Add/switch child profile with auto age-band calculation; Today\'s Journey calm daily view (2\342\200\2233 focused activities); Activity Detail experience with instructional video player, materials, safety notes, step-by-step guide, and completion logging; gentle domain-balance progress summary. | Adding a baby with any DOB (0\342\200\22324m) maps to the exact 3-month band; caregiver can complete daily activities, add notes, and see persisted progress across reloads. |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Milestone 3 (Step 3): Private Video Submission & 30-Day Media Vault** | In-browser camera recording (`MediaRecorder`) + file upload with consent capture; server-side MIME/magic-byte/size validation; private non-public storage vault; short-lived HMAC-signed `Range` video streaming; instant parent delete; scheduled 30-day auto-purge worker + audit logging. | Uploaded video streams only with valid signed token and authorized role; direct unauthenticated access returns `401/403`; parent delete physically removes file; retention sweep removes expired videos and logs audit rows. |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Milestone 4 (Step 4): Reviewer Workbench & Caregiver Rubric Scoring** | Reviewer Queue with age-band & status filters and claim workflow; split-screen secure video + activity reference + weighted rubric checklist; live caregiver instruction-match % calculator; non-diagnostic attestation; Parent Feedback Detail view. | Reviewer claims submission without seeing parent PII, scores rubric, verifies weighted % math, submits feedback; parent immediately views score, rubric breakdown, and coaching tip. |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Milestone 5 (Step 5): Admin Curriculum CMS, Audit Console & Hardening** | Admin 8\303\2276 curriculum coverage matrix; full Activity, Step, Rubric, and Daily Plan editor; Reviewer account management; Media Access Audit Log & Retention monitor; accessibility, mobile touch-target, and end-to-end verification across all 3 roles. | Admin creates a new activity + weighted rubric + daily plan item and it immediately appears in matching parents\' daily journey; audit log accurately tracks uploads, streams, and deletions; full lint & production build pass cleanly. |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
