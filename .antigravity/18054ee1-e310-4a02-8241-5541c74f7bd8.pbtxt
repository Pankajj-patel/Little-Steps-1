            lines {
              text: "      { title: \'Sit face-to-face\', instructionText: \'Sit comfortably facing baby on the mat so baby clearly sees your mouth and expressions.\', caregiverTip: \'Natural daylight helps baby read facial expressions.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Listen first\', instructionText: \'Wait quietly for a sigh, coo, or vowel sound from baby.\', caregiverTip: \'Resist filling every silent moment.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Mirror warmly\', instructionText: \'Repeat baby\342\200\231s exact sound softly, then add one simple warm phrase like \342\200\234Yes, you\342\200\231re talking to Mama.\342\200\235\', caregiverTip: \'Keep your tone natural and gentle.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Pause for a reply\', instructionText: \'Hold a smiling 5-second pause to invite another turn.\', caregiverTip: \'Even 4\342\200\2235 exchanges are wonderful.\' },"
