        instruction: "import React, { useState } from \'react\';\nimport { ArrowRight, Check, Lock, ShieldCheck } from \'lucide-react\';\nimport { EditorialImage } from \'../components/EditorialImage\';\nimport { useAuth } from \'../context/AuthContext\';\nimport {\n  CANONICAL_AGE_GROUPS,\n  CANONICAL_LEARNING_DOMAINS,\n  EDITORIAL_IMAGES,\n} from \'../shared/domain\';\n\nexport function LandingAuthView() {\n  const { login, register, t } = useAuth();\n  const [mode, setMode] = useState<\'login\' | \'register\'>(\'login\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [fullName, setFullName] = useState(\'\');\n  const [phoneNumber, setPhoneNumber] = useState(\'\');\n  const [submitting, setSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const scrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) el.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n    setSubmitting(true);\n    try {\n      if (mode === \'login\') {\n        await login(email, password);\n      } else {\n        await register({ email, password, fullName, phoneNumber: phoneNumber || undefined });\n      }\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to complete sign in.\');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const handleQuickDemoLogin = async (demoEmail: string) => {\n    setError(null);\n    setSubmitting(true);\n    try {\n      await login(demoEmail, \'LittleSteps123!\');\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to sign in with demo account.\');\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-chalk text-ink flex flex-col\">\n      {/* Strict 3-Zone Top Bar Contract */}\n      <header className=\"sticky top-0 z-30 bg-chalk/95 backdrop-blur-sm border-b border-stone\">\n        <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8\">\n          <a\n            href=\"#top\"\n            className=\"font-serif text-xl font-medium tracking-tight text-ink whitespace-nowrap shrink-0\"\n          >\n            LittleSteps\n          </a>\n\n          <nav\n            aria-label=\"Overview navigation\"\n            className=\"hidden md:flex items-center gap-7 text-sm font-medium text-olive\"\n          >\n            <button\n              type=\"button\"\n              onClick={() => scrollToSection(\'how-it-works\')}\n              className=\"hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              How It Works\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => scrollToSection(\'domains\')}\n              className=\"hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              Six Domains\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => scrollToSection(\'age-bands\')}\n              className=\"hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              0\342\200\22324 Months\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => scrollToSection(\'privacy\')}\n              className=\"hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              Privacy\n            </button>\n          </nav>\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'register\');\n              scrollToSection(\'auth-panel\');\n            }}\n            className=\"px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            Start Journey\n          </button>\n        </div>\n      </header>\n\n      <main id=\"top\" className=\"flex-1\">\n        {/* Hero Split Section */}\n        <section className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-stretch\">\n            {/* Left column: Serene editorial promise + Auth Panel */}\n            <div className=\"lg:col-span-6 flex flex-col justify-between space-y-8\">\n              <div className=\"space-y-4\">\n                <p className=\"text-xs font-medium text-olive tracking-wide\">\n                  Birth to 24 months \302\267 Calm daily guidance \302\267 India-first\n                </p>\n                <h1 className=\"font-serif text-4xl sm:text-5xl font-medium text-ink leading-[1.12] max-w-xl\">\n                  Unhurried daily moments that nurture your baby\342\200\231s first two years.\n                </h1>\n                <p className=\"text-base text-olive leading-relaxed max-w-lg\">\n                  Two or three gentle, age-matched activities each day using everyday items already at home\342\200\224with optional private caregiver video coaching that supports you without ever overwhelming you.\n                </p>\n              </div>\n\n              {/* Auth Card */}\n              <div\n                id=\"auth-panel\"\n                className=\"rounded-xl border border-stone bg-linen p-6 space-y-5\"\n              >\n                <div className=\"flex items-center justify-between gap-4 border-b border-stone pb-3\">\n                  <div className=\"flex items-center gap-1 p-1 rounded-lg bg-oat\">\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setMode(\'login\');\n                        setError(null);\n                      }}\n                      className={`px-3.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                        mode === \'login\'\n                          ? \'bg-linen text-ink shadow-xs\'\n                          : \'text-olive hover:text-ink\'\n                      }`}\n                    >\n                      Sign In\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        setMode(\'register\');\n                        setError(null);\n                      }}\n                      className={`px-3.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                        mode === \'register\'\n                          ? \'bg-linen text-ink shadow-xs\'\n                          : \'text-olive hover:text-ink\'\n                      }`}\n                    >\n                      Create Parent Account\n                    </button>\n                  </div>\n                  <span className=\"text-xs text-olive hidden sm:inline\">Private & secure</span>\n                </div>\n\n                <form onSubmit={handleSubmit} className=\"space-y-3.5\">\n                  {mode === \'register\' && (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n                      <div>\n                        <label\n                          htmlFor=\"auth-name\"\n                          className=\"block text-xs font-medium text-ink mb-1\"\n                        >\n                          Your name\n                        </label>\n                        <input\n                          id=\"auth-name\"\n                          type=\"text\"\n                          required\n                          value={fullName}\n                          onChange={(e) => setFullName(e.target.value)}\n                          placeholder=\"e.g., Priya Sharma\"\n                          className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink placeholder:text-olive/60 focus:border-eucalyptus\"\n                        />\n                      </div>\n                      <div>\n                        <label\n                          htmlFor=\"auth-phone\"\n                          className=\"block text-xs font-medium text-ink mb-1\"\n                        >\n                          Mobile number (optional)\n                        </label>\n                        <input\n                          id=\"auth-phone\"\n                          type=\"tel\"\n                          value={phoneNumber}\n                          onChange={(e) => setPhoneNumber(e.target.value)}\n                          placeholder=\"+91 98xxx xxxxx\"\n                          className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink placeholder:text-olive/60 focus:border-eucalyptus\"\n                        />\n                      </div>\n                    </div>\n                  )}\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n                    <div>\n                      <label\n                        htmlFor=\"auth-email\"\n                        className=\"block text-xs font-medium text-ink mb-1\"\n                      >\n                        Email address\n                      </label>\n                      <input\n                        id=\"auth-email\"\n                        type=\"email\"\n                        required\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        placeholder=\"you@example.com\"\n                        className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink placeholder:text-olive/60 focus:border-eucalyptus\"\n                      />\n                    </div>\n                    <div>\n                      <label\n                        htmlFor=\"auth-password\"\n                        className=\"block text-xs font-medium text-ink mb-1\"\n                      >\n                        Password\n                      </label>\n                      <input\n                        id=\"auth-password\"\n                        type=\"password\"\n                        required\n                        minLength={8}\n                        value={password}\n                        onChange={(e) => setPassword(e.target.value)}\n                        placeholder={mode === \'register\' ? \'At least 8 characters\' : \'Your password\'}\n                        className=\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2 text-sm text-ink placeholder:text-olive/60 focus:border-eucalyptus\"\n                      />\n                    </div>\n                  </div>\n\n                  {error && (\n                    <p\n                      role=\"alert\"\n                      className=\"text-xs text-crimson bg-crimson-soft px-3 py-2 rounded-lg\"\n                    >\n                      {error}\n                    </p>\n                  )}\n\n                  <button\n                    type=\"submit\"\n                    disabled={submitting}\n                    className=\"w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-50 transition-colors cursor-pointer\"\n                  >\n                    {submitting\n                      ? \'Please wait...\'\n                      : mode === \'login\'\n                        ? \'Sign In to LittleSteps\'\n                        : \'Create Account\'}\n                    <ArrowRight className=\"w-4 h-4\" aria-hidden=\"true\" />\n                  </button>\n                </form>\n\n                {/* Direct Role Access for Testing All Three Workspaces */}\n                <div className=\"pt-3 border-t border-stone\">\n                  <p className=\"text-xs text-olive mb-2.5\">\n                    Explore seeded prototype workspaces directly:\n                  </p>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                    <button\n                      type=\"button\"\n                      disabled={submitting}\n                      onClick={() => void handleQuickDemoLogin(\'meera@littlesteps.in\')}\n                      className=\"px-3 py-2 rounded-lg border border-stone bg-chalk hover:bg-oat text-left transition-colors cursor-pointer\"\n                    >\n                      <span className=\"block text-xs font-semibold text-ink\">Parent</span>\n                      <span className=\"block text-[11px] text-olive truncate\">\n                        Meera \302\267 Baby Aarav\n                      </span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      disabled={submitting}\n                      onClick={() => void handleQuickDemoLogin(\'ananya.reviewer@littlesteps.in\')}\n                      className=\"px-3 py-2 rounded-lg border border-stone bg-chalk hover:bg-oat text-left transition-colors cursor-pointer\"\n                    >\n                      <span className=\"block text-xs font-semibold text-ink\">Reviewer</span>\n                      <span className=\"block text-[11px] text-olive truncate\">\n                        Ananya \302\267 Rubric Queue\n                      </span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      disabled={submitting}\n                      onClick={() => void handleQuickDemoLogin(\'kavita.admin@littlesteps.in\')}\n                      className=\"px-3 py-2 rounded-lg border border-stone bg-chalk hover:bg-oat text-left transition-colors cursor-pointer\"\n                    >\n                      <span className=\"block text-xs font-semibold text-ink\">Admin</span>\n                      <span className=\"block text-[11px] text-olive truncate\">\n                        Kavita \302\267 Curriculum CMS\n                      </span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Right column: Full-height sunlit Montessori editorial photograph */}\n            <div className=\"lg:col-span-6 flex\">\n              <div className=\"w-full rounded-xl border border-stone overflow-hidden bg-linen flex flex-col\">\n                <div className=\"flex-1 min-h-[320px] lg:min-h-0\">\n                  <EditorialImage\n                    src={EDITORIAL_IMAGES.heroMontessori}\n                    alt=\"Mother sitting calmly with her baby on a sunlit woven cotton floor mat with natural wooden rattles\"\n                    aspectClassName=\"w-full h-full\"\n                  />\n                </div>\n                <div className=\"p-5 border-t border-stone bg-linen flex flex-wrap items-center justify-between gap-4 text-xs text-olive\">\n                  <span>Everyday Indian household objects \302\267 Zero expensive kits</span>\n                  <span className=\"font-mono tabular-nums text-ink\">8 age bands \302\267 6 domains</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* How It Works */}\n        <section id=\"how-it-works\" className=\"border-t border-stone bg-linen py-14\">\n          <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"font-serif text-3xl font-medium text-ink\">\n                One gentle step at a time, never a wall of parenting advice\n              </h2>\n              <p className=\"text-sm text-olive mt-2 leading-relaxed\">\n                Every day delivers two to three age-appropriate activities matched automatically to your baby\342\200\231s exact month.\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n              <div className=\"space-y-2.5\">\n                <p className=\"font-mono text-xs text-eucalyptus tabular-nums\">01</p>\n                <h3 className=\"font-serif text-xl font-medium text-ink\">\n                  Watch & Gather Simple Items\n                </h3>\n                <p className=\"text-sm text-olive leading-relaxed\">\n                  Preview a calm step-paced guide and gather two or three familiar items\342\200\224a steel katori, muslin scarf, or wooden spoon.\n                </p>\n              </div>\n              <div className=\"space-y-2.5\">\n                <p className=\"font-mono text-xs text-eucalyptus tabular-nums\">02</p>\n                <h3 className=\"font-serif text-xl font-medium text-ink\">\n                  Practice at Baby\342\200\231s Pace\n                </h3>\n                <p className=\"text-sm text-olive leading-relaxed\">\n                  Follow clear numbered steps with safety reminders. Optionally record or upload a short clip whenever you want gentle coaching.\n                </p>\n              </div>\n              <div className=\"space-y-2.5\">\n                <p className=\"font-mono text-xs text-eucalyptus tabular-nums\">03</p>\n                <h3 className=\"font-serif text-xl font-medium text-ink\">\n                  Caregiver-Only Feedback\n                </h3>\n                <p className=\"text-sm text-olive leading-relaxed\">\n                  Reviewers score how closely you demonstrated the activity instructions and share one warm tip\342\200\224never grading or diagnosing your baby.\n                </p>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Six Learning Domains */}\n        <section id=\"domains\" className=\"border-t border-stone bg-chalk py-14\">\n          <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"font-serif text-3xl font-medium text-ink\">\n                Six balanced domains woven calmly into everyday life\n              </h2>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n              {CANONICAL_LEARNING_DOMAINS.map((domain, idx) => (\n                <div\n                  key={domain.slug}\n                  className=\"rounded-xl border border-stone bg-linen p-5 space-y-2\"\n                >\n                  <p className=\"font-mono text-xs text-olive tabular-nums\">\n                    {String(idx + 1).padStart(2, \'0\')}\n                  </p>\n                  <h3 className=\"font-serif text-lg font-medium text-ink\">{domain.name}</h3>\n                  <p className=\"text-sm text-olive leading-relaxed\">{domain.description}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </section>\n\n        {/* Eight Age Groups + Privacy Trust Band */}\n        <section id=\"age-bands\" className=\"border-t border-stone bg-linen py-14\">\n          <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10\">\n            <div className=\"lg:col-span-7 space-y-5\">\n              <h2 className=\"font-serif text-3xl font-medium text-ink\">\n                Eight 3-month stages from newborn to two years\n              </h2>\n              <p className=\"text-sm text-olive leading-relaxed max-w-xl\">\n                Enter your baby\342\200\231s date of birth once. LittleSteps automatically advances your daily plan as your baby transitions through each three-month stage.\n              </p>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2\">\n                {CANONICAL_AGE_GROUPS.map((band) => (\n                  <div\n                    key={band.slug}\n                    className=\"rounded-lg border border-stone bg-chalk px-3.5 py-3\"\n                  >\n                    <p className=\"font-mono text-sm font-medium text-ink tabular-nums\">\n                      {band.label}\n                    </p>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div\n              id=\"privacy\"\n              className=\"lg:col-span-5 rounded-xl border border-stone bg-oat/70 p-6 space-y-4 self-start\"\n            >\n              <div className=\"flex items-center gap-2 text-eucalyptus\">\n                <ShieldCheck className=\"w-5 h-5\" aria-hidden=\"true\" />\n                <h3 className=\"font-serif text-xl font-medium text-ink\">\n                  Built for Children\342\200\231s Privacy\n                </h3>\n              </div>\n              <ul className=\"space-y-2.5 text-sm text-olive\">\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-eucalyptus shrink-0 mt-1\" aria-hidden=\"true\" />\n                  <span>\n                    <strong className=\"text-ink font-medium\">Zero public video URLs:</strong> Clips stream only via 5-minute signed tokens for you and your reviewer.\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-eucalyptus shrink-0 mt-1\" aria-hidden=\"true\" />\n                  <span>\n                    <strong className=\"text-ink font-medium\">30-day auto-deletion:</strong> Videos automatically purge after 30 days, or delete immediately with one tap while keeping your written coaching notes.\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Lock className=\"w-4 h-4 text-eucalyptus shrink-0 mt-1\" aria-hidden=\"true\" />\n                  <span>\n                    <strong className=\"text-ink font-medium\">{t(\'policy.nonDiagnosticTitle\')}:</strong> {t(\'policy.nonDiagnosticBody\')}\n                  </span>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      <footer className=\"border-t border-stone bg-chalk py-6\">\n        <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-4 text-xs text-olive\">\n          <span>LittleSteps \302\267 Calm early-childhood daily guidance</span>\n          <span>Non-diagnostic caregiver coaching \302\267 Private 30-day video retention</span>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/LandingAuthView.tsx"
        }
        overwrite: true
      }
    }
