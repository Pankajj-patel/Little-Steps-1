              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Household Texture Basket\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Introduce safe everyday Indian home textures\342\200\224wood, steel, and soft muslin\342\200\224one item at a time.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Woven cotton mat\', \'Smooth neem wooden spoon\', \'Small rounded steel katori\', \'Folded unbleached muslin cloth\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Inspect every object for sharp rims or splinters. Objects must be larger than 4 cm in diameter to prevent choking.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.sensoryLinen,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Offer just three objects\', instructionText: \'Place the wooden spoon, small rounded steel katori, and folded muslin cloth neatly on the mat\342\200\224avoid clutter.\', caregiverTip: \'Fewer objects invite deeper calm focus.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Sit beside, not over\', instructionText: \'Sit calmly on the mat next to baby so they can reach freely with both hands.\', caregiverTip: \'Keep your hands resting quietly in your lap.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Name textures gently\', instructionText: \'When baby touches an item, name it simply: \342\200\234Cool steel bowl\342\200\235 or \342\200\234Soft cotton cloth.\342\200\235\', caregiverTip: \'Narrate only what baby chooses\342\200\224avoid redirecting.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Allow unhurried mouthing & tapping\', instructionText: \'Let baby explore safely with hands and mouth while you stay observant and calm.\', caregiverTip: \'End when baby\342\200\231s interest naturally drifts.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Clean, uncluttered 3-object setup\', description: \'Caregiver laid out 2\342\200\2233 safe household objects neatly on a mat without visual overload.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Hands-off patient observation\', description: \'Caregiver allowed baby to choose and grasp independently without pushing objects into hands.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Simple descriptive language\', description: \'Caregiver named textures calmly in short phrases matching baby\342\200\231s focus.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Close safety supervision\', description: \'Caregiver remained seated within arm\342\200\231s reach monitoring safe exploration.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ageSlug: \'6-9m\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domainSlug: \'cognitive\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Muslin Scarf Peek-a-Boo Object Permanence\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Explore hidden-and-found play gently using a breathable cotton scarf and wooden ring.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Light breathable muslin cloth\', \'Smooth wooden ring or rattle\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Never leave cloth over baby\342\200\231s face; always keep peek-a-boo light, brief, and joyful.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.heroMontessori,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Show the wooden ring clearly\', instructionText: \'Place the wooden ring on the mat between you and baby so both of you see it.\', caregiverTip: \'Let baby touch it briefly first.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Cover half the ring first\', instructionText: \'Drape the light muslin scarf over half of the ring so one edge stays visible.\', caregiverTip: \'Start easy so baby experiences success.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Ask warmly and wait\', instructionText: \'Ask \342\200\234Where did the wooden ring go?\342\200\235 and wait calmly with an encouraging smile.\', caregiverTip: \'Give baby plenty of time to pull the scarf.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Celebrate calmly\', instructionText: \'When the ring appears, say softly \342\200\234There it is! You found the ring,\342\200\235 without startling loud noises.\', caregiverTip: \'Repeat 2\342\200\2233 times if baby stays engaged.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Clear visual setup\', description: \'Caregiver introduced the toy clearly before covering it.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Partial-cover scaffolding\', description: \'Caregiver started with the object partially visible to keep frustration low.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Patient waiting pause\', description: \'Caregiver waited calmly instead of pulling the cloth off immediately.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Warm, calm narration\', description: \'Caregiver spoke gently and clearly without overstimulating volume.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ageSlug: \'6-9m\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domainSlug: \'language\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Everyday Kitchen Naming Rhyme\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Connect familiar household words with clear lip movement and soothing rhythm.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Steel katori\', \'Wooden spoon\', \'Cotton napkin\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Keep metal items lightweight with smooth rolled edges.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.sensoryLinen,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Sit face-to-face on the mat\', instructionText: \'Position yourself across from baby so they can see both your face and the object.\', caregiverTip: \'Keep the other items tucked aside.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Hold one object near your cheek\', instructionText: \'Lift the wooden spoon beside your face and say clearly: \342\200\234Spoon. Wooden spoon.\342\200\235\', caregiverTip: \'Speak slightly slower than adult conversation.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Offer and pause\', instructionText: \'Place the spoon on the mat in front of baby and wait for any babble, reach, or look.\', caregiverTip: \'Respond to babbling as a real reply.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Repeat with rhythm\', instructionText: \'Tap the wooden spoon gently twice on the mat and say \342\200\234Tap, tap,\342\200\235 keeping the pace calm.\', caregiverTip: \'Two objects per session is enough.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Face-to-face visibility\', description: \'Caregiver ensured baby could see both caregiver\342\200\231s mouth and the object.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Single-object focus\', description: \'Caregiver introduced one item at a time without clutter.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Clear, unhurried pronunciation\', description: \'Caregiver used slow, simple everyday words.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Responsive pauses\', description: \'Caregiver paused after naming to welcome baby\342\200\231s vocal or gesture response.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ageSlug: \'6-9m\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    domainSlug: \'physical\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Side-Reach Wooden Ring Roll\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary: \'Invite comfortable reaching and weight shifting on the floor mat.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    durationMinutes: 6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'Firm woven floor mat\', \'Smooth wooden ring or knitted cotton ball\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Clear nearby hard furniture corners so baby has open floor space to shift safely.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.heroMontessori,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Prepare open floor space\', instructionText: \'Spread a firm mat away from sharp furniture edges so baby can move freely.\', caregiverTip: \'Bare feet offer better grip on cotton mats.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Place ring slightly to one side\', instructionText: \'Set the wooden ring just outside easy reach to baby\342\200\231s right side.\', caregiverTip: \'Keep it close enough to feel inviting.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Encourage without pulling\', instructionText: \'Tap the mat lightly beside the ring and smile, allowing baby to shift or lean on their own.\', caregiverTip: \'Avoid dragging baby forward by the arms.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Switch sides gently\', instructionText: \'After baby grasps and explores, offer the next turn softly on the left side.\', caregiverTip: \'Stop while baby is still smiling.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
