    tool_calls {
      id: "call_9914145052409323738"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  ArrowRight,\\n  Baby,\\n  Bell,\\n  BookOpen,\\n  Camera,\\n  CheckCircle2,\\n  Clock,\\n  Info,\\n  KeyRound,\\n  LogOut,\\n  MailCheck,\\n  Palette,\\n  Plus,\\n  ShieldCheck,\\n  Sparkles,\\n  Trash2,\\n  User,\\n} from \'lucide-react\';\\nimport { SecureVideoPlayer } from \'../../components/SecureVideoPlayer\';\\nimport { useAuth } from \'../../context/AuthContext\';\\nimport {\\n  ActivityCard,\\n  AgeGroupSelector,\\n  Badge,\\n  Button,\\n  Card,\\n  ConfirmDialog,\\n  DatePicker,\\n  EmptyState,\\n  Input,\\n  Modal,\\n  ProgressIndicator,\\n  Select,\\n  SkeletonCard,\\n  useToast,\\n} from \'../../design-system\';\\nimport { api } from \'../../lib/api\';\\nimport type { NavigateTarget } from \'../../lib/router\';\\nimport { formatDaysUntilExpiry } from \'../../shared/domain\';\\nimport { formatDateReadable } from \'../../shared/i18n\';\\nimport type {\\n  ActivitySummary,\\n  AgeGroup,\\n  ChildProfile,\\n  LearningDomain,\\n  LocaleCode,\\n  NotificationPreference,\\n  ParentNotificationItem,\\n  PreferredActivityTime,\\n  TodayJourneyResponse,\\n} from \'../../shared/types\';\\n\\n/* ========================================================================= */\\n/* 1. ACTIVITIES LIBRARY SECTION                                             */\\n/* ========================================================================= */\\ninterface ActivitiesLibrarySectionProps {\\n  ageGroups: AgeGroup[];\\n  learningDomains: LearningDomain[];\\n  initialAgeGroupSlug: string;\\n  initialDomainId?: string;\\n  completedActivityIds: Set<string>;\\n  onOpenActivity: (activityId: string) => void;\\n}\\n\\nexport function ActivitiesLibrarySection({\\n  ageGroups,\\n  learningDomains,\\n  initialAgeGroupSlug,\\n  initialDomainId = \'all\',\\n  completedActivityIds,\\n  onOpenActivity,\\n}: ActivitiesLibrarySectionProps) {\\n  const [selectedAgeSlug, setSelectedAgeSlug] = useState(initialAgeGroupSlug);\\n  const [selectedDomainId, setSelectedDomainId] = useState(initialDomainId);\\n  const [activities, setActivities] = useState<ActivitySummary[]>([]);\\n  const [loading, setLoading] = useState(true);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    setSelectedAgeSlug(initialAgeGroupSlug);\\n  }, [initialAgeGroupSlug]);\\n\\n  useEffect(() => {\\n    setSelectedDomainId(initialDomainId);\\n  }, [initialDomainId]);\\n\\n  const loadActivities = async (ageSlug: string, domainId: string) => {\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const matchedAge = ageGroups.find((g) => g.slug === ageSlug);\\n      const { activities: list } = await api.listPublishedActivities(\\n        matchedAge?.id,\\n        domainId === \'all\' ? undefined : domainId\\n      );\\n      setActivities(list);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load activities right now.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    if (ageGroups.length > 0) {\\n      void loadActivities(selectedAgeSlug, selectedDomainId);\\n    }\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n  }, [selectedAgeSlug, selectedDomainId, ageGroups.length]);\\n\\n  const domainOptions = [\\n    { value: \'all\', label: \'All six development areas\' },\\n    ...learningDomains.map((d) => ({ value: d.id, label: d.name })),\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          Activity Library\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Explore calm, everyday activities by age stage and development area.\\n        </p>\\n      </div>\\n\\n      <Card className=\\\"space-y-4\\\">\\n        <div className=\\\"space-y-2\\\">\\n          <p className=\\\"text-xs font-medium text-charcoal\\\">Choose age stage (0\342\200\22324 months)</p>\\n          <AgeGroupSelector\\n            value={selectedAgeSlug}\\n            onChange={(slug) => setSelectedAgeSlug(slug)}\\n          />\\n        </div>\\n\\n        <div className=\\\"max-w-sm\\\">\\n          <Select\\n            label=\\\"Filter by development area\\\"\\n            options={domainOptions}\\n            value={selectedDomainId}\\n            onChange={(e) => setSelectedDomainId(e.target.value)}\\n          />\\n        </div>\\n      </Card>\\n\\n      {error && (\\n        <Card className=\\\"border-danger/40 bg-danger-soft/50 flex flex-wrap items-center justify-between gap-3\\\">\\n          <p role=\\\"alert\\\" className=\\\"text-sm text-danger\\\">\\n            {error}\\n          </p>\\n          <Button\\n            variant=\\\"secondary\\\"\\n            size=\\\"sm\\\"\\n            onClick={() => void loadActivities(selectedAgeSlug, selectedDomainId)}\\n          >\\n            Try Again\\n          </Button>\\n        </Card>\\n      )}\\n\\n      {loading ? (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n          <SkeletonCard />\\n          <SkeletonCard />\\n        </div>\\n      ) : activities.length === 0 ? (\\n        <EmptyState\\n          title=\\\"No activities in this filter yet\\\"\\n          description=\\\"Try switching to another development area or viewing all six areas for this age stage.\\\"\\n          actionLabel=\\\"Show All Six Areas\\\"\\n          onAction={() => setSelectedDomainId(\'all\')}\\n        />\\n      ) : (\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n          {activities.map((act) => {\\n            const done = completedActivityIds.has(act.id);\\n            return (\\n              <ActivityCard\\n                key={act.id}\\n                title={act.title}\\n                summary={act.summary}\\n                domainName={act.domainName}\\n                ageGroupLabel={act.ageGroupLabel}\\n                durationMinutes={act.durationMinutes}\\n                materials={act.materials}\\n                posterUrl={act.instructionalPosterUrl}\\n                statusText={done ? \'Completed\' : \'Ready to start\'}\\n                statusTone={done ? \'sage\' : \'neutral\'}\\n                completed={done}\\n                actionLabel={done ? \'Review Activity\' : \'Start Activity\'}\\n                onAction={() => onOpenActivity(act.id)}\\n              />\\n            );\\n          })}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 2. PROGRESS & CAREGIVER FEEDBACK SECTION                                  */\\n/* ========================================================================= */\\ninterface ProgressAndFeedbackSectionProps {\\n  journey: TodayJourneyResponse;\\n  locale: LocaleCode;\\n  nonDiagnosticTitle: string;\\n  nonDiagnosticBody: string;\\n  onRefreshJourney: () => Promise<void>;\\n  onExploreDomain: (domainId: string) => void;\\n  onGoToday: () => void;\\n}\\n\\nexport function ProgressAndFeedbackSection({\\n  journey,\\n  locale,\\n  nonDiagnosticTitle,\\n  nonDiagnosticBody,\\n  onRefreshJourney,\\n  onExploreDomain,\\n  onGoToday,\\n}: ProgressAndFeedbackSectionProps) {\\n  const { notify } = useToast();\\n  const [confirmDeleteSubId, setConfirmDeleteSubId] = useState<string | null>(null);\\n  const [deletingVideoId, setDeletingVideoId] = useState<string | null>(null);\\n\\n  const weeklyTotal = journey.weeklyProgress.reduce((sum, d) => sum + d.completedCount, 0);\\n  const maxDaily = Math.max(3, ...journey.weeklyProgress.map((d) => d.completedCount));\\n\\n  const handleConfirmDeleteVideo = async () => {\\n    if (!confirmDeleteSubId) return;\\n    setDeletingVideoId(confirmDeleteSubId);\\n    try {\\n      await api.deleteSubmissionVideo(confirmDeleteSubId);\\n      setConfirmDeleteSubId(null);\\n      notify({\\n        tone: \'success\',\\n        title: \'Video deleted permanently\',\\n        description: \'Your written coaching feedback remains safely preserved.\',\\n      });\\n      await onRefreshJourney();\\n    } catch (err) {\\n      notify({\\n        tone: \'danger\',\\n        title: \'Could not delete video\',\\n        description: err instanceof Error ? err.message : \'Please try again.\',\\n      });\\n    } finally {\\n      setDeletingVideoId(null);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-8\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          {journey.child.displayName}\342\200\231s Learning Progress\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          A calm reflection of completed daily activities and caregiver coaching feedback \342\200\224 never\\n          a test or grade of your baby.\\n        </p>\\n      </div>\\n\\n      {/* Weekly Chart Summary */}\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n        <div className=\\\"flex flex-wrap items-baseline justify-between gap-3\\\">\\n          <div>\\n            <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n              Last 7 Days Rhythm\\n            </h3>\\n            <p className=\\\"text-xs text-muted\\\">Actual activities logged across the past week.</p>\\n          </div>\\n          <Badge tone=\\\"sage\\\">\\n            <span className=\\\"font-mono tabular-nums\\\">{weeklyTotal}</span>{\' \'}\\n            {weeklyTotal === 1 ? \'activity\' : \'activities\'} this week\\n          </Badge>\\n        </div>\\n\\n        <div\\n          className=\\\"grid grid-cols-7 gap-2 sm:gap-4 items-end h-40 pt-4 border-t border-border\\\"\\n          role=\\\"img\\\"\\n          aria-label={`Weekly activity chart showing ${weeklyTotal} completed activities over the last 7 days`}\\n        >\\n          {journey.weeklyProgress.map((day) => {\\n            const pct = day.completedCount > 0 ? Math.max(18, Math.round((day.completedCount / maxDaily) * 100)) : 6;\\n            return (\\n              <div key={day.date} className=\\\"flex flex-col items-center gap-2 h-full justify-end\\\">\\n                <span className=\\\"font-mono text-xs tabular-nums text-muted\\\">\\n                  {day.completedCount}\\n                </span>\\n                <div className=\\\"w-full max-w-[40px] h-24 rounded-lg bg-cream flex items-end overflow-hidden p-1\\\">\\n                  <div\\n                    className={`w-full rounded-md transition-all duration-300 ${\\n                      day.completedCount > 0\\n                        ? day.isToday\\n                          ? \'bg-sage\'\\n                          : \'bg-sage/70\'\\n                        : \'bg-border-strong/50\'\\n                    }`}\\n                    style={{ height: `${pct}%` }}\\n                  />\\n                </div>\\n                <span\\n                  className={`text-xs ${\\n                    day.isToday ? \'font-semibold text-sage\' : \'text-muted\'\\n                  }`}\\n                >\\n                  {day.dayLabel}\\n                </span>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </Card>\\n\\n      {/* Six Development Areas */}\\n      <section className=\\\"space-y-4\\\">\\n        <h3 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n          Six Development Areas\\n        </h3>\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n          {journey.domainProgress.map((stat) => (\\n            <Card key={stat.domainId} className=\\\"flex flex-col justify-between gap-4\\\">\\n              <div className=\\\"space-y-3\\\">\\n                <div className=\\\"flex items-start justify-between gap-2\\\">\\n                  <p className=\\\"font-display text-base font-semibold text-charcoal\\\">\\n                    {stat.domainName}\\n                  </p>\\n                  <span className=\\\"font-mono text-xs tabular-nums text-sage shrink-0\\\">\\n                    {stat.completedCount}/{stat.availableCount}\\n                  </span>\\n                </div>\\n                <ProgressIndicator\\n                  value={Math.min(stat.completedCount, stat.availableCount)}\\n                  max={stat.availableCount}\\n                  tone=\\\"sage\\\"\\n                  size=\\\"sm\\\"\\n                />\\n              </div>\\n              <Button\\n                variant=\\\"subtle\\\"\\n                size=\\\"sm\\\"\\n                rightIcon={<ArrowRight className=\\\"w-3.5 h-3.5\\\" />}\\n                onClick={() => onExploreDomain(stat.domainId)}\\n              >\\n                Explore Activities\\n              </Button>\\n            </Card>\\n          ))}\\n        </div>\\n      </section>\\n\\n      {/* Caregiver Coaching Feedback & Private Video Management */}\\n      <section className=\\\"space-y-4\\\">\\n        <div className=\\\"space-y-1\\\">\\n          <h3 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n            Caregiver Coaching Feedback\\n          </h3>\\n          <p className=\\\"text-sm text-muted\\\">\\n            Private practice clips and step-by-step reviewer guidance.\\n          </p>\\n        </div>\\n\\n        <Card tone=\\\"cream\\\" className=\\\"flex items-start gap-3\\\">\\n          <Info className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n          <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n            <strong className=\\\"text-charcoal font-semibold\\\">{nonDiagnosticTitle}:</strong>{\' \'}\\n            {nonDiagnosticBody}\\n          </p>\\n        </Card>\\n\\n        {journey.recentSubmissions.length === 0 ? (\\n          <EmptyState\\n            title=\\\"No practice clips shared yet\\\"\\n            description=\\\"Whenever you would like warm coaching on an activity\342\200\231s steps, open any activity and share a short private clip.\\\"\\n            actionLabel=\\\"Go to Today\342\200\231s Activities\\\"\\n            onAction={onGoToday}\\n          />\\n        ) : (\\n          <div className=\\\"space-y-5\\\">\\n            {journey.recentSubmissions.map((sub) => (\\n              <Card key={sub.id} padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n                <div className=\\\"flex flex-wrap items-start justify-between gap-4 border-b border-border pb-4\\\">\\n                  <div className=\\\"space-y-1\\\">\\n                    <p className=\\\"text-xs text-muted\\\">\\n                      {sub.domainName} <span aria-hidden=\\\"true\\\">\302\267</span> {sub.ageGroupLabel}{\' \'}\\n                      <span aria-hidden=\\\"true\\\">\302\267</span> Submitted{\' \'}\\n                      {formatDateReadable(sub.createdAt, locale)}\\n                    </p>\\n                    <h4 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n                      {sub.activityTitle}\\n                    </h4>\\n                  </div>\\n\\n                  {sub.review ? (\\n                    <div className=\\\"text-left sm:text-right\\\">\\n                      <p className=\\\"font-mono text-2xl font-semibold text-sage tabular-nums\\\">\\n                        {sub.review.instructionMatchScorePct}%\\n                      </p>\\n                      <p className=\\\"text-xs text-muted\\\">Caregiver Instruction-Match</p>\\n                    </div>\\n                  ) : (\\n                    <Badge tone=\\\"peach\\\">\\n                      {sub.reviewStatus === \'in_review\'\\n                        ? \'In review\'\\n                        : sub.reviewStatus === \'deleted\'\\n                          ? \'Video deleted\'\\n                          : \'Queued for review\'}\\n                    </Badge>\\n                  )}\\n                </div>\\n\\n                <SecureVideoPlayer\\n                  submissionId={sub.id}\\n                  hasActiveVideo={sub.hasActiveVideo}\\n                  expiresAt={sub.expiresAt}\\n                  deletionReason={sub.deletionReason}\\n                />\\n\\n                {sub.review && (\\n                  <div className=\\\"space-y-4\\\">\\n                    <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                      <div className=\\\"rounded-xl border border-sage-border bg-sage-soft/50 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-sage\\\">What Went Well</p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.strengthsNote}\\n                        </p>\\n                      </div>\\n                      <div className=\\\"rounded-xl border border-peach bg-peach-soft/60 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-peach-ink\\\">\\n                          Gentle Tip for Next Time\\n                        </p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.coachingTip}\\n                        </p>\\n                      </div>\\n                    </div>\\n\\n                    <div className=\\\"divide-y divide-border border-t border-b border-border\\\">\\n                      {sub.review.rubricScores.map((score) => (\\n                        <div\\n                          key={score.id}\\n                          className=\\\"py-2.5 flex flex-wrap items-center justify-between gap-3 text-sm\\\"\\n                        >\\n                          <div>\\n                            <p className=\\\"font-medium text-charcoal\\\">{score.criterionLabel}</p>\\n                            <p className=\\\"text-xs text-muted\\\">{score.criterionDescription}</p>\\n                          </div>\\n                          <div className=\\\"flex items-center gap-3 text-xs font-mono tabular-nums\\\">\\n                            <span\\n                              className={\\n                                score.achievedLevel === \'met\'\\n                                  ? \'text-sage font-medium\'\\n                                  : score.achievedLevel === \'partially_met\'\\n                                    ? \'text-peach-ink font-medium\'\\n                                    : \'text-muted\'\\n                              }\\n                            >\\n                              {score.achievedLevel === \'met\'\\n                                ? \'Met\'\\n                                : score.achievedLevel === \'partially_met\'\\n                                  ? \'Partially Met\'\\n                                  : \'Not Observed\'}\\n                            </span>\\n                            <span className=\\\"text-muted\\\">\\n                              {score.earnedPoints}/{score.maxPoints} pts\\n                            </span>\\n                          </div>\\n                        </div>\\n                      ))}\\n                    </div>\\n                  </div>\\n                )}\\n\\n                {sub.hasActiveVideo && (\\n                  <div className=\\\"pt-3 border-t border-border flex flex-wrap items-center justify-between gap-3\\\">\\n                    <span className=\\\"text-xs text-muted font-mono tabular-nums\\\">\\n                      Scheduled auto-deletion in {formatDaysUntilExpiry(sub.expiresAt)} days\\n                    </span>\\n                    <Button\\n                      variant=\\\"danger\\\"\\n                      size=\\\"sm\\\"\\n                      leftIcon={<Trash2 className=\\\"w-3.5 h-3.5\\\" />}\\n                      onClick={() => setConfirmDeleteSubId(sub.id)}\\n                    >\\n                      Delete Video Now\\n                    </Button>\\n                  </div>\\n                )}\\n              </Card>\\n            ))}\\n          </div>\\n        )}\\n      </section>\\n\\n      <ConfirmDialog\\n        open={Boolean(confirmDeleteSubId)}\\n        onClose={() => setConfirmDeleteSubId(null)}\\n        onConfirm={() => void handleConfirmDeleteVideo()}\\n        title=\\\"Delete practice video permanently?\\\"\\n        description=\\\"Your video clip will be removed immediately from our private storage vault. Your written caregiver coaching feedback stays preserved.\\\"\\n        confirmLabel=\\\"Delete Video\\\"\\n        tone=\\\"danger\\\"\\n        loading={Boolean(deletingVideoId)}\\n      />\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 3. PARENTING GUIDES SECTION                                               */\\n/* ========================================================================= */\\nconst PARENTING_GUIDES = [\\n  {\\n    id: \'guide_floor_space\',\\n    tag: \'Home Setup\',\\n    readTime: \'3 min read\',\\n    title: \'Setting up a calm, clutter-free floor mat at home\',\\n    summary:\\n      \'A folded cotton dhurrie in natural morning light with two or three safe household items is all a baby needs for deep focus.\',\\n    points: [\\n      \'Choose a firm, flat mat away from bright overhead bulbs and background television noise.\',\\n      \'Offer just 2\342\200\2233 objects at a time so your baby can choose without visual overwhelm.\',\\n      \'Sit comfortably beside your baby with relaxed shoulders\342\200\224calm energy invites curiosity.\',\\n    ],\\n  },\\n  {\\n    id: \'guide_follow_cues\',\\n    tag: \'Gentle Pacing\',\\n    readTime: \'2 min read\',\\n    title: \'Recognizing alert windows and early tired cues\',\\n    summary:\\n      \'Short, joyful 4-minute sessions during a rested window support learning far better than pushing through fussiness.\',\\n    points: [\\n      \'Best times are usually 20\342\200\22330 minutes after a feed and nap when eyes are bright and relaxed.\',\\n      \'Looking away, arching back, or rubbing eyes are gentle signs your baby is ready to rest.\',\\n      \'Stopping early while everyone is smiling makes tomorrow\342\200\231s play even smoother.\',\\n    ],\\n  },\\n  {\\n    id: \'guide_household_items\',\\n    tag: \'Everyday Materials\',\\n    readTime: \'3 min read\',\\n    title: \'Safe everyday Indian home items for sensory play\',\\n    summary:\\n      \'You never need expensive plastic toys\342\200\224smooth neem spoons, rounded steel katoris, and breathable muslin cloths offer rich natural textures.\',\\n    points: [\\n      \'Always check that items have smooth edges and are larger than 4.5 cm in diameter.\',\\n      \'Wash household items with mild soap and warm water before floor exploration.\',\\n      \'Stay within arm\342\200\231s reach throughout mouthing, tapping, and reaching play.\',\\n    ],\\n  },\\n  {\\n    id: \'guide_coaching_promise\',\\n    tag: \'Privacy & Trust\',\\n    readTime: \'2 min read\',\\n    title: \'How optional caregiver coaching works (and stays private)\',\\n    summary:\\n      \'Video coaching evaluates how clearly an activity\342\200\231s instructions were set up and paced\342\200\224never your baby\342\200\231s intelligence or health.\',\\n    points: [\\n      \'Clips are stored privately outside public folders and auto-delete after 30 days.\',\\n      \'You can permanently delete any uploaded clip at any time while keeping your written tips.\',\\n      \'Coaching focuses on warm encouragement and one simple adjustment for next time.\',\\n    ],\\n  },\\n];\\n\\nexport function ParentingGuidesSection({ childAgeLabel }: { childAgeLabel: string }) {\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <Badge tone=\\\"sage\\\">Practical Caregiver Library</Badge>\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          Parenting Guides\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Short, reassuring home guides to accompany your {childAgeLabel} daily journey.\\n        </p>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n        {PARENTING_GUIDES.map((guide) => (\\n          <Card key={guide.id} padding=\\\"lg\\\" className=\\\"space-y-4 flex flex-col justify-between\\\">\\n            <div className=\\\"space-y-3\\\">\\n              <div className=\\\"flex items-center justify-between gap-2\\\">\\n                <Badge tone=\\\"neutral\\\">{guide.tag}</Badge>\\n                <span className=\\\"font-mono text-xs text-muted tabular-nums\\\">{guide.readTime}</span>\\n              </div>\\n              <h3 className=\\\"font-display text-xl font-semibold text-charcoal leading-snug\\\">\\n                {guide.title}\\n              </h3>\\n              <p className=\\\"text-sm text-muted leading-relaxed\\\">{guide.summary}</p>\\n              <ul className=\\\"space-y-2 pt-1 text-sm text-charcoal\\\">\\n                {guide.points.map((pt, i) => (\\n                  <li key={i} className=\\\"flex items-start gap-2.5\\\">\\n                    <BookOpen className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n                    <span className=\\\"text-xs sm:text-sm leading-relaxed\\\">{pt}</span>\\n                  </li>\\n                ))}\\n              </ul>\\n            </div>\\n          </Card>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 4. NOTIFICATIONS SECTION                                                  */\\n/* ========================================================================= */\\ninterface NotificationsSectionProps {\\n  notifications: ParentNotificationItem[];\\n  locale: LocaleCode;\\n  onNotificationAction: (item: ParentNotificationItem) => void;\\n}\\n\\nexport function NotificationsSection({\\n  notifications,\\n  locale,\\n  onNotificationAction,\\n}: NotificationsSectionProps) {\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          Notifications\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Calm updates on caregiver coaching feedback, account security, and today\342\200\231s plan.\\n        </p>\\n      </div>\\n\\n      {notifications.length === 0 ? (\\n        <EmptyState\\n          icon={<Bell className=\\\"w-6 h-6\\\" />}\\n          title=\\\"You\342\200\231re all caught up\\\"\\n          description=\\\"There are no new alerts right now. Take a calm breath and enjoy today\342\200\231s moments.\\\"\\n        />\\n      ) : (\\n        <div className=\\\"space-y-3\\\">\\n          {notifications.map((n) => (\\n            <Card key={n.id} className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n              <div className=\\\"flex items-start gap-3\\\">\\n                <span\\n                  className={`w-9 h-9 rounded-lg inline-flex items-center justify-center shrink-0 ${\\n                    n.kind === \'review_ready\'\\n                      ? \'bg-sage-soft text-sage\'\\n                      : n.kind === \'email_verify\'\\n                        ? \'bg-peach-soft text-peach-ink\'\\n                        : \'bg-cream text-sage\'\\n                  }`}\\n                >\\n                  {n.kind === \'review_ready\' ? (\\n                    <CheckCircle2 className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                  ) : n.kind === \'email_verify\' ? (\\n                    <MailCheck className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                  ) : n.kind === \'submission_queued\' ? (\\n                    <Clock className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                  ) : (\\n                    <Sparkles className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                  )}\\n                </span>\\n                <div className=\\\"space-y-1\\\">\\n                  <p className=\\\"text-sm font-semibold text-charcoal\\\">{n.title}</p>\\n                  <p className=\\\"text-xs text-muted leading-relaxed\\\">{n.description}</p>\\n                  <p className=\\\"font-mono text-[11px] text-muted tabular-nums\\\">\\n                    {formatDateReadable(n.createdAt, locale)}\\n                  </p>\\n                </div>\\n              </div>\\n              {n.actionLabel && (\\n                <Button\\n                  variant=\\\"secondary\\\"\\n                  size=\\\"sm\\\"\\n                  onClick={() => onNotificationAction(n)}\\n                >\\n                  {n.actionLabel}\\n                </Button>\\n              )}\\n            </Card>\\n          ))}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 5. PROFILE SECTION (PARENT + BABY PROFILES)                               */\\n/* ========================================================================= */\\ninterface ProfileSectionProps {\\n  childrenList: ChildProfile[];\\n  selectedChildId: string | null;\\n  onSelectChild: (childId: string) => void;\\n  onChildrenUpdated: () => Promise<void>;\\n}\\n\\nexport function ProfileSection({\\n  childrenList,\\n  selectedChildId,\\n  onSelectChild,\\n  onChildrenUpdated,\\n}: ProfileSectionProps) {\\n  const { user, setUser, setVerificationPreviewPath } = useAuth();\\n  const { notify } = useToast();\\n\\n  const [fullName, setFullName] = useState(user?.fullName ?? \'\');\\n  const [email, setEmail] = useState(user?.email ?? \'\');\\n  const [photoUrl, setPhotoUrl] = useState<string | null>(user?.profilePhotoUrl ?? null);\\n  const [uploadingPhoto, setUploadingPhoto] = useState(false);\\n  const [savingParent, setSavingParent] = useState(false);\\n  const photoInputRef = useRef<HTMLInputElement | null>(null);\\n\\n  // Add / Edit Child Modal\\n  const [childModalOpen, setChildModalOpen] = useState(false);\\n  const [editingChild, setEditingChild] = useState<ChildProfile | null>(null);\\n  const [childName, setChildName] = useState(\'\');\\n  const [childDob, setChildDob] = useState(\'\');\\n  const [childPrefs, setChildPrefs] = useState(\'\');\\n  const [savingChild, setSavingChild] = useState(false);\\n  const [childError, setChildError] = useState<string | null>(null);\\n\\n  const openAddChild = () => {\\n    const d = new Date();\\n    d.setMonth(d.getMonth() - 4);\\n    setEditingChild(null);\\n    setChildName(\'\');\\n    setChildDob(d.toISOString().slice(0, 10));\\n    setChildPrefs(\'\');\\n    setChildError(null);\\n    setChildModalOpen(true);\\n  };\\n\\n  const openEditChild = (child: ChildProfile) => {\\n    setEditingChild(child);\\n    setChildName(child.displayName);\\n    setChildDob(child.dateOfBirth);\\n    setChildPrefs(child.activityPreferences ?? \'\');\\n    setChildError(null);\\n    setChildModalOpen(true);\\n  };\\n\\n  const handleUploadPhoto = async (file: File | undefined) => {\\n    if (!file) return;\\n    setUploadingPhoto(true);\\n    try {\\n      const { photoUrl: nextUrl } = await api.uploadProfilePhoto(file);\\n      setPhotoUrl(nextUrl);\\n      notify({ tone: \'success\', title: \'Profile photo uploaded privately\' });\\n    } catch (err) {\\n      notify({\\n        tone: \'danger\',\\n        title: \'Photo upload failed\',\\n        description: err instanceof Error ? err.message : \'Please try a JPG, PNG, or WebP photo.\',\\n      });\\n    } finally {\\n      setUploadingPhoto(false);\\n    }\\n  };\\n\\n  const handleSaveParent = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!user) return;\\n    setSavingParent(true);\\n    try {\\n      const res = await api.saveOnboardingParent({\\n        fullName: fullName.trim(),\\n        email: email.trim(),\\n        preferredLocale: user.preferredLocale,\\n        profilePhotoUrl: photoUrl,\\n      });\\n      setUser(res.user);\\n      if (res.verificationPreviewPath) {\\n        setVerificationPreviewPath(res.verificationPreviewPath);\\n      }\\n      notify({ tone: \'success\', title: \'Parent profile updated\' });\\n    } catch (err) {\\n      notify({\\n        tone: \'danger\',\\n        title: \'Could not update profile\',\\n        description: err instanceof Error ? err.message : \'Please check your details.\',\\n      });\\n    } finally {\\n      setSavingParent(false);\\n    }\\n  };\\n\\n  const handleSaveChild = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setChildError(null);\\n    if (!childName.trim()) {\\n      setChildError(\'Please enter your baby\342\200\231s name or nickname.\');\\n      return;\\n    }\\n    setSavingChild(true);\\n    try {\\n      const { child } = editingChild\\n        ? await api.updateChild(editingChild.id, childName.trim(), childDob, {\\n            activityPreferences: childPrefs.trim() || null,\\n          })\\n        : await api.createChild(childName.trim(), childDob, {\\n            activityPreferences: childPrefs.trim() || null,\\n          });\\n      await onChildrenUpdated();\\n      onSelectChild(child.id);\\n      setChildModalOpen(false);\\n      notify({\\n        tone: \'success\',\\n        title: editingChild ? \'Baby profile updated\' : `${child.displayName} added`,\\n      });\\n    } catch (err) {\\n      setChildError(err instanceof Error ? err.message : \'Unable to save baby profile.\');\\n    } finally {\\n      setSavingChild(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          Family Profile\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Manage your caregiver profile and your baby\342\200\231s stage details.\\n        </p>\\n      </div>\\n\\n      {/* Parent Profile Card */}\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n        <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">Parent Details</h3>\\n        <form onSubmit={handleSaveParent} className=\\\"space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-4\\\">\\n            <div className=\\\"w-16 h-16 rounded-full bg-cream border border-border-strong overflow-hidden flex items-center justify-center shrink-0\\\">\\n              {photoUrl ? (\\n                <img src={photoUrl} alt=\\\"Parent avatar\\\" className=\\\"w-full h-full object-cover\\\" />\\n              ) : (\\n                <User className=\\\"w-7 h-7 text-muted\\\" aria-hidden=\\\"true\\\" />\\n              )}\\n            </div>\\n            <div className=\\\"space-y-1.5\\\">\\n              <input\\n                ref={photoInputRef}\\n                type=\\\"file\\\"\\n                accept=\\\"image/jpeg,image/png,image/webp\\\"\\n                className=\\\"hidden\\\"\\n                onChange={(e) => {\\n                  void handleUploadPhoto(e.target.files?.[0]);\\n                  e.target.value = \'\';\\n                }}\\n              />\\n              <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                <Button\\n                  type=\\\"button\\\"\\n                  variant=\\\"secondary\\\"\\n                  size=\\\"sm\\\"\\n                  loading={uploadingPhoto}\\n                  leftIcon={<Camera className=\\\"w-4 h-4\\\" />}\\n                  onClick={() => photoInputRef.current?.click()}\\n                >\\n                  {photoUrl ? \'Change Photo\' : \'Add Photo (Optional)\'}\\n                </Button>\\n                {photoUrl && (\\n                  <Button\\n                    type=\\\"button\\\"\\n                    variant=\\\"subtle\\\"\\n                    size=\\\"sm\\\"\\n                    onClick={() => setPhotoUrl(null)}\\n                  >\\n                    Remove\\n                  </Button>\\n                )}\\n              </div>\\n              <p className=\\\"text-xs text-muted\\\">Private to your account only.</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <Input\\n              label=\\\"Parent\342\200\231s name\\\"\\n              required\\n              value={fullName}\\n              onChange={(e) => setFullName(e.target.value)}\\n            />\\n            <Input\\n              label=\\\"Email address\\\"\\n              type=\\\"email\\\"\\n              required\\n              value={email}\\n              onChange={(e) => setEmail(e.target.value)}\\n            />\\n          </div>\\n\\n          <div className=\\\"flex justify-end\\\">\\n            <Button type=\\\"submit\\\" variant=\\\"primary\\\" loading={savingParent}>\\n              Save Profile Changes\\n            </Button>\\n          </div>\\n        </form>\\n      </Card>\\n\\n      {/* Baby Profiles */}\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-4\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n          <div>\\n            <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">Your Little Ones</h3>\\n            <p className=\\\"text-xs text-muted\\\">\\n              Activities automatically match each child\342\200\231s 3-month developmental stage.\\n            </p>\\n          </div>\\n          <Button\\n            variant=\\\"secondary\\\"\\n            size=\\\"sm\\\"\\n            leftIcon={<Plus className=\\\"w-4 h-4\\\" />}\\n            onClick={openAddChild}\\n          >\\n            Add Child\\n          </Button>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n          {childrenList.map((child) => {\\n            const isActive = child.id === selectedChildId;\\n            return (\\n              <div\\n                key={child.id}\\n                className={`rounded-xl border p-4 space-y-3 ${\\n                  isActive ? \'border-sage bg-sage-soft/40\' : \'border-border bg-offwhite\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-start justify-between gap-2\\\">\\n                  <div className=\\\"flex items-center gap-3\\\">\\n                    <div className=\\\"w-11 h-11 rounded-full bg-surface border border-border overflow-hidden flex items-center justify-center shrink-0\\\">\\n                      {child.profilePhotoUrl ? (\\n                        <img\\n                          src={child.profilePhotoUrl}\\n                          alt={child.displayName}\\n                          className=\\\"w-full h-full object-cover\\\"\\n                        />\\n                      ) : (\\n                        <Baby className=\\\"w-5 h-5 text-sage\\\" aria-hidden=\\\"true\\\" />\\n                      )}\\n                    </div>\\n                    <div>\\n                      <p className=\\\"font-display text-base font-semibold text-charcoal\\\">\\n                        {child.displayName}\\n                      </p>\\n                      <p className=\\\"text-xs text-muted font-mono tabular-nums\\\">\\n                        {child.ageInMonths} months \302\267 {child.ageGroupLabel}\\n                      </p>\\n                    </div>\\n                  </div>\\n                  {isActive && <Badge tone=\\\"sage\\\">Active</Badge>}\\n                </div>\\n\\n                {child.activityPreferences && (\\n                  <p className=\\\"text-xs text-muted bg-surface/80 rounded-lg px-3 py-2 border border-border\\\">\\n                    Notes: {child.activityPreferences}\\n                  </p>\\n                )}\\n\\n                <div className=\\\"flex items-center gap-2 pt-1\\\">\\n                  {!isActive && (\\n                    <Button\\n                      variant=\\\"primary\\\"\\n                      size=\\\"sm\\\"\\n                      onClick={() => onSelectChild(child.id)}\\n                    >\\n                      Switch to {child.displayName}\\n                    </Button>\\n                  )}\\n                  <Button\\n                    variant=\\\"secondary\\\"\\n                    size=\\\"sm\\\"\\n                    onClick={() => openEditChild(child)}\\n                  >\\n                    Edit Details\\n                  </Button>\\n                </div>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </Card>\\n\\n      <Modal\\n        open={childModalOpen}\\n        onClose={() => setChildModalOpen(false)}\\n        title={editingChild ? `Edit ${editingChild.displayName}` : \'Add a Child Profile\'}\\n        description=\\\"Your baby\342\200\231s date of birth matches them to the right 0\342\200\22324 month stage.\\\"\\n      >\\n        <form onSubmit={handleSaveChild} className=\\\"space-y-4\\\">\\n          <Input\\n            label=\\\"Baby\342\200\231s name or nickname\\\"\\n            required\\n            value={childName}\\n            onChange={(e) => setChildName(e.target.value)}\\n            placeholder=\\\"e.g., Aarav or Diya\\\"\\n          />\\n          <DatePicker\\n            label=\\\"Date of birth\\\"\\n            required\\n            max={new Date().toISOString().slice(0, 10)}\\n            value={childDob}\\n            onChange={(e) => setChildDob(e.target.value)}\\n            showBabyAgePreview\\n          />\\n          <div className=\\\"space-y-1.5\\\">\\n            <label htmlFor=\\\"edit-child-prefs\\\" className=\\\"block text-sm font-medium text-charcoal\\\">\\n              Accessibility or activity preferences (Optional)\\n            </label>\\n            <textarea\\n              id=\\\"edit-child-prefs\\\"\\n              rows={2}\\n              value={childPrefs}\\n              onChange={(e) => setChildPrefs(e.target.value)}\\n              placeholder=\\\"Any quiet play or comfort preferences\\\"\\n              className=\\\"w-full rounded-lg border border-border-strong bg-surface px-3.5 py-2.5 text-sm text-charcoal focus:border-sage\\\"\\n            />\\n          </div>\\n          {childError && (\\n            <p role=\\\"alert\\\" className=\\\"text-xs text-danger bg-danger-soft px-3 py-2 rounded-lg\\\">\\n              {childError}\\n            </p>\\n          )}\\n          <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n            <Button type=\\\"button\\\" variant=\\\"secondary\\\" onClick={() => setChildModalOpen(false)}>\\n              Cancel\\n            </Button>\\n            <Button type=\\\"submit\\\" variant=\\\"primary\\\" loading={savingChild}>\\n              {editingChild ? \'Save Changes\' : \'Add Child\'}\\n            </Button>\\n          </div>\\n        </form>\\n      </Modal>\\n    </div>\\n  );\\n}\\n\\n/* ========================================================================= */\\n/* 6. SETTINGS SECTION                                                       */\\n/* ========================================================================= */\\ninterface SettingsSectionProps {\\n  onNavigate: (target: NavigateTarget) => void;\\n  onOpenDesignSystem: () => void;\\n  onLogout: () => Promise<void>;\\n}\\n\\nexport function SettingsSection({\\n  onNavigate,\\n  onOpenDesignSystem,\\n  onLogout,\\n}: SettingsSectionProps) {\\n  const { user, setUser, verificationPreviewPath } = useAuth();\\n  const { notify } = useToast();\\n\\n  const [activityTime, setActivityTime] = useState<PreferredActivityTime>(\\n    user?.preferredActivityTime ?? \'morning\'\\n  );\\n  const [notifPref, setNotifPref] = useState<NotificationPreference>(\\n    user?.notificationPreference ?? \'daily_gentle\'\\n  );\\n  const [locale, setLocale] = useState<LocaleCode>(user?.preferredLocale ?? \'en\');\\n  const [saving, setSaving] = useState(false);\\n\\n  const handleSaveSettings = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSaving(true);\\n    try {\\n      const { user: updated } = await api.completeOnboarding({\\n        preferredActivityTime: activityTime,\\n        notificationPreference: notifPref,\\n        preferredLocale: locale,\\n        markComplete: true,\\n      });\\n      setUser(updated);\\n      notify({ tone: \'success\', title: \'Preferences saved\' });\\n    } catch (err) {\\n      notify({\\n        tone: \'danger\',\\n        title: \'Unable to save settings\',\\n        description: err instanceof Error ? err.message : \'Please try again.\',\\n      });\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"space-y-1\\\">\\n        <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n          Settings\\n        </h2>\\n        <p className=\\\"text-sm text-muted\\\">\\n          Personalize your daily rhythm, notifications, language, and account security.\\n        </p>\\n      </div>\\n\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n        <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n          Daily Rhythm & Language\\n        </h3>\\n        <form onSubmit={handleSaveSettings} className=\\\"space-y-4\\\">\\n          <Select\\n            label=\\\"Preferred daily activity time\\\"\\n            value={activityTime}\\n            onChange={(e) => setActivityTime(e.target.value as PreferredActivityTime)}\\n            options={[\\n              { value: \'morning\', label: \'Morning (8:00 AM \342\200\223 11:30 AM)\' },\\n              { value: \'afternoon\', label: \'Afternoon (1:00 PM \342\200\223 4:30 PM)\' },\\n              { value: \'evening\', label: \'Evening (5:00 PM \342\200\223 7:30 PM)\' },\\n              { value: \'flexible\', label: \'Flexible \302\267 Whenever baby is rested\' },\\n            ]}\\n          />\\n          <Select\\n            label=\\\"Notification preference\\\"\\n            value={notifPref}\\n            onChange={(e) => setNotifPref(e.target.value as NotificationPreference)}\\n            options={[\\n              { value: \'daily_gentle\', label: \'Gentle daily reminder\' },\\n              { value: \'weekly_summary\', label: \'Weekly summary only\' },\\n              { value: \'none\', label: \'No reminders\' },\\n            ]}\\n          />\\n          <Select\\n            label=\\\"Preferred language\\\"\\n            value={locale}\\n            onChange={(e) => setLocale(e.target.value as LocaleCode)}\\n            options={[\\n              { value: \'en\', label: \'English\' },\\n              { value: \'hi\', label: \'\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200 (Hindi \302\267 beta)\' },\\n            ]}\\n          />\\n          <div className=\\\"flex justify-end\\\">\\n            <Button type=\\\"submit\\\" variant=\\\"primary\\\" loading={saving}>\\n              Save Preferences\\n            </Button>\\n          </div>\\n        </form>\\n      </Card>\\n\\n      <Card padding=\\\"lg\\\" className=\\\"space-y-4\\\">\\n        <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n          Account & Security\\n        </h3>\\n        <div className=\\\"divide-y divide-border\\\">\\n          <div className=\\\"py-3 flex flex-wrap items-center justify-between gap-3\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <ShieldCheck className=\\\"w-4 h-4 text-sage\\\" aria-hidden=\\\"true\\\" />\\n              <div>\\n                <p className=\\\"text-sm font-medium text-charcoal\\\">Email Verification</p>\\n                <p className=\\\"text-xs text-muted\\\">\\n                  {user?.emailVerifiedAt\\n                    ? `Verified (${user.email})`\\n                    : `Not yet verified (${user?.email})`}\\n                </p>\\n              </div>\\n            </div>\\n            {user?.emailVerifiedAt ? (\\n              <Badge tone=\\\"sage\\\">Verified</Badge>\\n            ) : (\\n              <Button\\n                variant=\\\"secondary\\\"\\n                size=\\\"sm\\\"\\n                onClick={() =>\\n                  onNavigate((verificationPreviewPath || \'/verify-email\') as NavigateTarget)\\n                }\\n              >\\n                Verify Email\\n              </Button>\\n            )}\\n          </div>\\n\\n          <div className=\\\"py-3 flex flex-wrap items-center justify-between gap-3\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <KeyRound className=\\\"w-4 h-4 text-sage\\\" aria-hidden=\\\"true\\\" />\\n              <div>\\n                <p className=\\\"text-sm font-medium text-charcoal\\\">Password Reset</p>\\n                <p className=\\\"text-xs text-muted\\\">\\n                  Request a one-time reset link to update your password.\\n                </p>\\n              </div>\\n            </div>\\n            <Button\\n              variant=\\\"secondary\\\"\\n              size=\\\"sm\\\"\\n              onClick={() => onNavigate(\'/forgot-password\')}\\n            >\\n              Reset Password\\n            </Button>\\n          </div>\\n\\n          <div className=\\\"py-3 flex flex-wrap items-center justify-between gap-3\\\">\\n            <div className=\\\"flex items-center gap-2.5\\\">\\n              <Palette className=\\\"w-4 h-4 text-sage\\\" aria-hidden=\\\"true\\\" />\\n              <div>\\n                <p className=\\\"text-sm font-medium text-charcoal\\\">LittleSteps Design System</p>\\n                <p className=\\\"text-xs text-muted\\\">View the UI component foundation.</p>\\n              </div>\\n            </div>\\n            <Button variant=\\\"subtle\\\" size=\\\"sm\\\" onClick={onOpenDesignSystem}>\\n              Open Reference\\n            </Button>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"pt-2 border-t border-border flex justify-end\\\">\\n          <Button\\n            variant=\\\"secondary\\\"\\n            leftIcon={<LogOut className=\\\"w-4 h-4\\\" />}\\n            onClick={() => void onLogout()}\\n          >\\n            Sign Out\\n          </Button>\\n        </div>\\n      </Card>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create ParentSecondaryViews for Activities Library, Progress & Feedback, Parenting Guides, Notifications, Profile, and Settings\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/parent/ParentSecondaryViews.tsx\", \"toolAction\":\"Creating secondary parent dashboard views\", \"toolSummary\":\"Create ParentSecondaryViews module\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 112
      nanos: 147766959
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "kPUAa9PSAfin1MkPvY-FsAU"
  }
}
