            lines {
              text: "- **Confirmed \342\200\224 Visual Aesthetic Direction**: **Warm Calm Montessori Editorial** \342\200\224 serene, unhurried, high-legibility layout with generous whitespace and progressive disclosure so mothers are never overwhelmed."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
