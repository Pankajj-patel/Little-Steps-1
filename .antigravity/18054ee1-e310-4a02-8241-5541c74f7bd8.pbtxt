        target_content: "          {/* =============================================================== */}\n          {/* PRIMARY TAB 2: MY PLAN (DAY-BY-DAY STRUCTURED JOURNEY)          */}\n          {/* =============================================================== */}\n          {!studioActivity && !loadingStudioActivity && journey && section === \'my-plan\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex flex-wrap items-end justify-between gap-4\">\n                <div className=\"space-y-1\">\n                  <Badge tone=\"sage\">{journey.child.ageGroupLabel} Plan</Badge>\n                  <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\">\n                    {journey.child.displayName}\342\200\231s Daily Plan\n                  </h2>\n                  <p className=\"text-sm text-muted max-w-2xl\">\n                    Follow one calm day at a time. Repeating familiar activities builds confidence\n                    for your baby.\n                  </p>\n                </div>\n              </div>\n\n              {/* Day Sequence Switcher */}\n              {journey.availableDays.length > 0 && (\n                <div className=\"flex flex-wrap items-center gap-2\">\n                  {journey.availableDays.map((d) => {\n                    const active = d.dayNumber === selectedDay;\n                    return (\n                      <button\n                        key={d.dayNumber}\n                        type=\"button\"\n                        onClick={() => setSelectedDay(d.dayNumber)}\n                        aria-pressed={active}\n                        className={`min-h-[44px] px-4 py-2 rounded-xl border text-sm font-medium transition-colors cursor-pointer ${\n                          active\n                            ? \'bg-sage text-white border-sage\'\n                            : \'bg-surface border-border text-charcoal hover:bg-cream\'\n                        }`}\n                      >\n                        Day {d.dayNumber}\n                      </button>\n                    );\n                  })}\n                </div>\n              )}\n\n              <Card tone=\"cream\" className=\"space-y-2\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                  <h3 className=\"font-display text-lg font-semibold text-charcoal\">\n                    {journey.selectedDay.title}\n                  </h3>\n                  <Badge\n                    tone={\n                      journey.todaySummary.completedTodayCount === journey.todaySummary.totalTodayCount &&\n                      journey.todaySummary.totalTodayCount > 0\n                        ? \'sage\'\n                        : \'neutral\'\n                    }\n                    icon={<CheckCircle2 className=\"w-3.5 h-3.5\" />}\n                  >\n                    {journey.todaySummary.completedTodayCount}/{journey.todaySummary.totalTodayCount} completed\n                  </Badge>\n                </div>\n                <p className=\"text-sm text-muted\">{journey.selectedDay.focusNote}</p>\n              </Card>\n\n              {journey.items.length === 0 ? (\n                <EmptyState\n                  title=\"No activities in this day\342\200\231s plan yet\"\n                  description=\"Explore the Activities Library to choose any age-appropriate activity.\"\n                  actionLabel=\"Open Activities Library\"\n                  onAction={() => handleSelectSection(\'activities\')}\n                />\n              ) : (\n                <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                  {journey.items.map(renderActivityCardForJourneyItem)}\n                </div>\n              )}\n            </div>\n          )}"
