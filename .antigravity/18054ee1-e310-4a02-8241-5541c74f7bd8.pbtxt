            }
            lines {
              text: "      { title: \'Arrange neatly on the mat\', instructionText: \'Place the steel bowl centered on the mat with two cotton balls resting on the left.\', caregiverTip: \'Neat order invites curiosity.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Demonstrate once silently\', instructionText: \'Pick up one ball slowly, drop it into the bowl with a soft sound, and pause.\', caregiverTip: \'Slow hands teach better than long explanations.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Invite baby\342\200\231s turn\', instructionText: \'Say \342\200\234Your turn\342\200\235 softly and sit back with relaxed hands.\', caregiverTip: \'Let baby dump the bowl out too\342\200\224that is part of learning.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Tidy together\', instructionText: \'Place the balls back in the bowl calmly at the end and say \342\200\234All tucked away.\342\200\235\', caregiverTip: \'Simple closing routines build calm habits.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
