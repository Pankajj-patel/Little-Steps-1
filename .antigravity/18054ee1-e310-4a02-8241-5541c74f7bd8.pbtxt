      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\nexport type CardTone = \'default\' | \'cream\' | \'sage\' | \'peach\' | \'lavender\';\\n\\nexport interface CardProps extends React.HTMLAttributes<HTMLDivElement> {\\n  tone?: CardTone;\\n  padding?: \'none\' | \'sm\' | \'md\' | \'lg\';\\n  interactive?: boolean;\\n}\\n\\nconst TONE_CLASSES: Record<CardTone, string> = {\\n  default: \'bg-surface border-border\',\\n  cream: \'bg-cream border-border\',\\n  sage: \'bg-sage-soft border-sage-border\',\\n  peach: \'bg-peach-soft border-peach/60\',\\n  lavender: \'bg-lavender-soft border-lavender\',\\n};\\n\\nconst PADDING_CLASSES = {\\n  none: \'\',\\n  sm: \'p-4\',\\n  md: \'p-5 sm:p-6\',\\n  lg: \'p-6 sm:p-8\',\\n};\\n\\nexport function Card({\\n  tone = \'default\',\\n  padding = \'md\',\\n  interactive = false,\\n  className = \'\',\\n  children,\\n  ...rest\\n}: CardProps) {\\n  return (\\n    <div\\n      className={`rounded-xl border transition-colors ${TONE_CLASSES[tone]} ${\\n        PADDING_CLASSES[padding]\\n      } ${interactive ? \'hover:border-sage/60 cursor-pointer\' : \'\'} ${className}`}\\n      {...rest}\\n    >\\n      {children}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create single-elevation Card container component with warm palette surface tones and hairline borders.\", \"Overwrite\":true, \"TargetFile\":\"/src/design-system/Card.tsx\", \"toolAction\":\"Creating Card component\", \"toolSummary\":\"Create Card component\"}"
