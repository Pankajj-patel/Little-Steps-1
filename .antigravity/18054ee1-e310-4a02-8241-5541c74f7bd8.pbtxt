        use_fast_apply: true
        replacement_chunks {
          target_content: "      const journey = repo.getJourneyForChild(child, Number.isNaN(dayNumber) ? undefined : dayNumber);\n      res.json(journey);\n    }\n  );"
          replacement_content: "      const journey = repo.getJourneyForChild(child, Number.isNaN(dayNumber) ? undefined : dayNumber);\n      res.json(journey);\n    }\n  );\n\n  router.get(\n    \'/progress/:childId\',\n    requireAuth,\n    requireRole(\'parent\'),\n    (req: AuthenticatedRequest, res) => {\n      const child = repo.findChildById(req.params.childId, req.authUser!.id);\n      if (!child) {\n        res.status(404).json({ error: \'Child profile not found.\' });\n        return;\n      }\n\n      const querySchema = z.object({\n        dateFrom: z\n          .string()\n          .regex(/^\\d{4}-\\d{2}-\\d{2}$/)\n          .optional(),\n        dateTo: z\n          .string()\n          .regex(/^\\d{4}-\\d{2}-\\d{2}$/)\n          .optional(),\n        domainId: z.string().max(64).optional(),\n        completionStatus: z\n          .enum([\'all\', \'not_started\', \'in_progress\', \'completed\', \'submitted_for_review\', \'reviewed\'])\n          .optional(),\n        reviewStatus: z\n          .enum([\'all\', \'none\', \'queued\', \'in_review\', \'resubmit_requested\', \'reviewed\'])\n          .optional(),\n      });\n\n      const parsed = querySchema.safeParse({\n        dateFrom: typeof req.query.dateFrom === \'string\' && req.query.dateFrom ? req.query.dateFrom : undefined,\n        dateTo: typeof req.query.dateTo === \'string\' && req.query.dateTo ? req.query.dateTo : undefined,\n        domainId: typeof req.query.domainId === \'string\' && req.query.domainId ? req.query.domainId : undefined,\n        completionStatus:\n          typeof req.query.completionStatus === \'string\' && req.query.completionStatus\n            ? req.query.completionStatus\n            : undefined,\n        reviewStatus:\n          typeof req.query.reviewStatus === \'string\' && req.query.reviewStatus\n            ? req.query.reviewStatus\n            : undefined,\n      });\n\n      if (!parsed.success) {\n        res.status(400).json({ error: \'Invalid progress filter parameters.\' });\n        return;\n      }\n\n      const overview = repo.getParentProgressOverview(child.id, parsed.data);\n      if (!overview) {\n        res.status(404).json({ error: \'Progress data not found.\' });\n        return;\n      }\n      res.json(overview);\n    }\n  );"
