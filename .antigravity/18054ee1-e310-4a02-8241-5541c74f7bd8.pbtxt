  planner_response {
    thinking: "**Updating Parent View Displays**\n\nI\'m now focused on updating the `ParentSecondaryViews.tsx` file. The goal is a clear display of all six key parent result fields, especially the instruction-match percentage. I will show the earned weight points divided by applicable weight points where assessable, to provide helpful context.\n\n\n**Refining Assessability Displays**\n\nI\'m now implementing the detailed display for non-assessable reviews, including the \"**Not Assessable**\" badge with the `notAssessableReason` callout, and displaying specific feedback such as `score.explanation`, reviewer comments and coaching tips where present. I\'m also updating the journey status and submission status card to handle the `isAssessable` flag accurately, displaying the correct status message.\n\n\n"
    message_id: "sR8Ba9TTH-LDqtsPxK-FwAY"
    tool_calls {
      id: "call_11342517053905775054"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Upgrade parent coaching feedback cards in ProgressAndFeedbackSection to display all Step 8 result fields (instruction-match percentage or Not Assessable + reason, criteria-wise feedback with explanations, positive observations, areas to improve, reviewer comments, and review date).\", \"EndLine\":505, \"Instruction\":\"Update the submission review header and body inside ProgressAndFeedbackSection in src/pages/parent/ParentSecondaryViews.tsx.\", \"ReplacementContent\":\"                  {sub.review ? (\\n                    <div className=\\\"text-left sm:text-right space-y-0.5\\\">\\n                      {sub.review.isAssessable && sub.review.instructionMatchScorePct !== null ? (\\n                        <>\\n                          <p className=\\\"font-mono text-2xl font-semibold text-sage tabular-nums\\\">\\n                            {sub.review.instructionMatchScorePct}%\\n                          </p>\\n                          <p className=\\\"text-xs text-muted\\\">\\n                            Caregiver Instruction-Match{\' \'}\\n                            <span className=\\\"font-mono tabular-nums\\\">\\n                              ({sub.review.earnedWeightPoints}/{sub.review.applicableWeightPoints}{\' \'}\\n                              pts)\\n                            </span>\\n                          </p>\\n                        </>\\n                      ) : (\\n                        <>\\n                          <Badge tone=\\\"peach\\\">Not Assessable</Badge>\\n                          <p className=\\\"text-xs text-muted mt-1\\\">\\n                            Insufficient evidence for a percentage\\n                          </p>\\n                        </>\\n                      )}\\n                      <p className=\\\"text-[11px] text-muted font-mono tabular-nums\\\">\\n                        Reviewed {formatDateReadable(sub.review.submittedAt, locale)} \302\267{\' \'}\\n                        {sub.review.reviewerName}\\n                        {sub.review.version > 1 ? ` \302\267 v${sub.review.version}` : \'\'}\\n                      </p>\\n                    </div>\\n                  ) : (\\n                    <Badge\\n                      tone={\\n                        sub.reviewStatus === \'resubmit_requested\'\\n                          ? \'peach\'\\n                          : sub.reviewStatus === \'deleted\'\\n                            ? \'neutral\'\\n                            : \'lavender\'\\n                      }\\n                    >\\n                      {sub.reviewStatus === \'in_review\'\\n                        ? \'Under review\'\\n                        : sub.reviewStatus === \'resubmit_requested\'\\n                          ? \'Changes requested\'\\n                          : sub.reviewStatus === \'deleted\'\\n                            ? \'Video deleted\'\\n                            : \'Submitted\'}\\n                    </Badge>\\n                  )}\\n                </div>\\n\\n                {sub.reviewStatus === \'resubmit_requested\' && sub.changeRequestNote && (\\n                  <div className=\\\"rounded-xl border border-peach bg-peach-soft/50 p-4 space-y-1\\\">\\n                    <p className=\\\"text-xs font-semibold text-peach-ink uppercase tracking-wide\\\">\\n                      Reviewer Requested an Updated Clip\\n                    </p>\\n                    <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                      {sub.changeRequestNote}\\n                    </p>\\n                  </div>\\n                )}\\n\\n                <SecureVideoPlayer\\n                  submissionId={sub.id}\\n                  hasActiveVideo={sub.hasActiveVideo}\\n                  expiresAt={sub.expiresAt}\\n                  deletionReason={sub.deletionReason}\\n                  storageMode={sub.storageMode}\\n                />\\n\\n                {sub.review && (\\n                  <div className=\\\"space-y-4\\\">\\n                    {!sub.review.isAssessable && sub.review.notAssessableReason && (\\n                      <div className=\\\"rounded-xl border border-peach bg-peach-soft/60 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-peach-ink uppercase tracking-wide\\\">\\n                          Why This Clip Was Marked Not Assessable\\n                        </p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.notAssessableReason}\\n                        </p>\\n                      </div>\\n                    )}\\n\\n                    <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                      <div className=\\\"rounded-xl border border-sage-border bg-sage-soft/50 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-sage\\\">Positive Observations</p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.strengthsNote}\\n                        </p>\\n                      </div>\\n                      <div className=\\\"rounded-xl border border-peach bg-peach-soft/60 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-peach-ink\\\">Areas to Improve</p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.coachingTip}\\n                        </p>\\n                      </div>\\n                    </div>\\n\\n                    {sub.review.reviewerComments && (\\n                      <div className=\\\"rounded-xl border border-border bg-cream/70 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-charcoal\\\">Reviewer Comments</p>\\n                        <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                          {sub.review.reviewerComments}\\n                        </p>\\n                      </div>\\n                    )}\\n\\n                    <div className=\\\"space-y-1\\\">\\n                      <p className=\\\"text-xs font-semibold text-muted uppercase tracking-wide\\\">\\n                        Criteria-Wise Feedback\\n                      </p>\\n                      <div className=\\\"divide-y divide-border border-t border-b border-border\\\">\\n                        {sub.review.rubricScores.map((score) => {\\n                          const isExcluded = score.achievedLevel === \'not_assessable\';\\n                          const levelLabel =\\n                            score.achievedLevel === \'met\'\\n                              ? \'Met\'\\n                              : score.achievedLevel === \'partially_met\'\\n                                ? \'Partially Met\'\\n                                : score.achievedLevel === \'not_assessable\'\\n                                  ? \'Not Assessable\'\\n                                  : \'Not Met\';\\n                          const levelColor =\\n                            score.achievedLevel === \'met\'\\n                              ? \'text-sage font-medium\'\\n                              : score.achievedLevel === \'partially_met\'\\n                                ? \'text-peach-ink font-medium\'\\n                                : score.achievedLevel === \'not_assessable\'\\n                                  ? \'text-lavender-ink font-medium\'\\n                                  : \'text-muted font-medium\';\\n                          return (\\n                            <div\\n                              key={score.id}\\n                              className=\\\"py-3 flex flex-wrap items-start justify-between gap-3 text-sm\\\"\\n                            >\\n                              <div className=\\\"space-y-0.5 max-w-xl\\\">\\n                                <p className=\\\"font-medium text-charcoal\\\">{score.criterionLabel}</p>\\n                                <p className=\\\"text-xs text-muted\\\">{score.criterionDescription}</p>\\n                                {score.explanation && (\\n                                  <p className=\\\"text-xs text-charcoal/85 pt-1\\\">\\n                                    Note: {score.explanation}\\n                                  </p>\\n                                )}\\n                              </div>\\n                              <div className=\\\"flex items-center gap-3 text-xs font-mono tabular-nums shrink-0\\\">\\n                                <span className={levelColor}>{levelLabel}</span>\\n                                <span className=\\\"text-muted\\\">\\n                                  {isExcluded\\n                                    ? \'Excluded\'\\n                                    : `${score.earnedPoints}/${score.maxPoints} pts`}\\n                                </span>\\n                              </div>\\n                            </div>\\n                          );\\n                        })}\\n                      </div>\\n                    </div>\\n                  </div>\\n                )}\", \"StartLine\":401, \"TargetContent\":\"                  {sub.review ? (\\n                    <div className=\\\"text-left sm:text-right\\\">\\n                      <p className=\\\"font-mono text-2xl font-semibold text-sage tabular-nums\\\">\\n                        {sub.review.instructionMatchScorePct}%\\n                      </p>\\n                      <p className=\\\"text-xs text-muted\\\">Caregiver Instruction-Match</p>\\n                    </div>\\n                  ) : (\\n                    <Badge\\n                      tone={\\n                        sub.reviewStatus === \'resubmit_requested\'\\n                          ? \'peach\'\\n                          : sub.reviewStatus === \'deleted\'\\n                            ? \'neutral\'\\n                            : \'lavender\'\\n                      }\\n                    >\\n                      {sub.reviewStatus === \'in_review\'\\n                        ? \'Under review\'\\n                        : sub.reviewStatus === \'resubmit_requested\'\\n                          ? \'Changes requested\'\\n                          : sub.reviewStatus === \'deleted\'\\n                            ? \'Video deleted\'\\n                            : \'Submitted\'}\\n                    </Badge>\\n                  )}\\n                </div>\\n\\n                {sub.reviewStatus === \'resubmit_requested\' && sub.changeRequestNote && (\\n                  <div className=\\\"rounded-xl border border-peach bg-peach-soft/50 p-4 space-y-1\\\">\\n                    <p className=\\\"text-xs font-semibold text-peach-ink uppercase tracking-wide\\\">\\n                      Reviewer Requested an Updated Clip\\n                    </p>\\n                    <p className=\\\"text-sm text-charcoal leading-relaxed\\\">\\n                      {sub.changeRequestNote}\\n                    </p>\\n                  </div>\\n                )}\\n\\n                <SecureVideoPlayer\\n                  submissionId={sub.id}\\n                  hasActiveVideo={sub.hasActiveVideo}\\n                  expiresAt={sub.expiresAt}\\n                  deletionReason={sub.deletionReason}\\n                  storageMode={sub.storageMode}\\n                />\\n\\n                {sub.review && (\\n                  <div className=\\\"space-y-4\\\">\\n                    <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                      <div className=\\\"rounded-xl border border-sage-border bg-sage-soft/50 p-4 space-y-1\\\">\\n                        <p className=\\\"text-xs font-semibold text-sage\\\">What Went Well</p>\\n                        <p className=\\\"text-sm tex