      arguments_json: "{\"Description\":\"Display preparation level and state styling on Activity Library cards in ParentSecondaryViews.\", \"Instruction\":\"Import formatPrepLevel and pass prepLevelLabel and statusState to ActivityCard in ActivitiesLibrarySection.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":54, \"ReplacementContent\":\"  PreferredActivityTime,\\n  TodayJourneyResponse,\\n} from \'../../shared/types\';\\nimport { formatPrepLevel } from \'./MyPlanSection\';\", \"StartLine\":51, \"TargetContent\":\"  PreferredActivityTime,\\n  TodayJourneyResponse,\\n} from \'../../shared/types\';\"}, {\"AllowMultiple\":false, \"EndLine\":196, \"ReplacementContent\":\"              <ActivityCard\\n                key={act.id}\\n                title={act.title}\\n                summary={act.summary}\\n                domainName={act.domainName}\\n                ageGroupLabel={act.ageGroupLabel}\\n                durationMinutes={act.durationMinutes}\\n                prepLevelLabel={formatPrepLevel(act.prepLevel)}\\n                materials={act.materials}\\n                posterUrl={act.instructionalPosterUrl}\\n                statusText={done ? \'Completed\' : \'Not started\'}\\n                statusTone={done ? \'sage\' : \'neutral\'}\\n                statusState={done ? \'completed\' : \'not_started\'}\\n                completed={done}\\n                actionLabel={done ? \'View Activity\' : \'Start Activity\'}\\n                onAction={() => onOpenActivity(act.id)}\\n              />\", \"StartLine\":178, \"TargetContent\":\"              <ActivityCard\\n                key={act.id}\\n                title={act.title}\\n                summary={act.summary}\\n                domainName={act.domainName}\\n                ageGroupLabel={act.ageGroupLabel}\\n                durationMinutes={act.durationMinutes}\\n                materials={act.materials}\\n                posterUrl={act.instructionalPosterUrl}\\n                statusText={done ? \'Completed\' : \'Ready to start\'}\\n                statusTone={done ? \'sage\' : \'neutral\'}\\n                completed={done}\\n                actionLabel={done ? \'Review Activity\' : \'Start Activity\'}\\n                onAction={() => onOpenActivity(act.id)}\\n              />\"}], \"TargetFile\":\"/src/pages/parent/ParentSecondaryViews.tsx\", \"toolAction\":\"Adding prep level to library cards\", \"toolSummary\":\"Update library cards with prep level\"}"
