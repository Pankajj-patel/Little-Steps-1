 ${className}`}\n          {...rest}\n        />\n      </div>\n\n      {error ? (\n        <p id={errorId} role=\"alert\" className=\"text-xs text-danger\">\n          {error}\n        </p>\n      ) : helperText ? (\n        <p id={helperId} className=\"text-xs text-muted\">\n          {helperText}\n        </p>\n      ) : null}\n    </div>\n  );\n});\n"
        path {
          absolute_uri: "file:///src/design-system/Input.tsx"
        }
        overwrite: true
      }
    }
