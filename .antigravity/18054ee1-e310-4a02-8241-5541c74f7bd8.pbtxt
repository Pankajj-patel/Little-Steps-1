      arguments_json: "{\"CodeContent\":\"import crypto from \'crypto\';\\nimport type Database from \'better-sqlite3\';\\nimport {\\n  CANONICAL_AGE_GROUPS,\\n  CANONICAL_LEARNING_DOMAINS,\\n  EDITORIAL_IMAGES,\\n  RETENTION_DAYS,\\n} from \'../../src/shared/domain\';\\nimport { hashPassword } from \'../security/crypto\';\\n\\ninterface SeedActivityDef {\\n  ageSlug: string;\\n  domainSlug: string;\\n  title: string;\\n  summary: string;\\n  durationMinutes: number;\\n  materials: string[];\\n  safetyNotes: string;\\n  posterUrl: string;\\n  steps: Array<{ title: string; instructionText: string; caregiverTip: string }>;\\n  rubric: Array<{ label: string; description: string; weightPoints: number }>;\\n}\\n\\nconst STARTER_ACTIVITIES: SeedActivityDef[] = [\\n  // 0-3 months\\n  {\\n    ageSlug: \'0-3m\',\\n    domainSlug: \'social-emotional\',\\n    title: \'Unhurried Face-to-Face Greeting\',\\n    summary: \'Build calm eye contact and responsive warmth during alert morning minutes.\',\\n    durationMinutes: 4,\\n    materials: [\'Folded cotton dhurrie or clean bedsheet\', \'Quiet sunlit room\'],\\n    safetyNotes: \'Place baby on their back on a firm flat surface. Pause immediately if baby turns away or shows tiredness.\',\\n    posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n    steps: [\\n      {\\n        title: \'Prepare a calm floor spot\',\\n        instructionText: \'Lay baby on their back in soft natural light, away from bright overhead bulbs or loud TV noise.\',\\n        caregiverTip: \'Sit comfortably so your shoulders stay relaxed.\',\\n      },\\n      {\\n        title: \'Hold comfortable newborn distance\',\\n        instructionText: \'Bring your face about 20\342\200\22325 cm from baby\342\200\231s eyes so your features stay gently in focus.\',\\n        caregiverTip: \'Keep movements slow and predictable.\',\\n      },\\n      {\\n        title: \'Greet softly and wait\',\\n        instructionText: \'Say baby\342\200\231s name in a warm, unhurried voice, smile gently, and pause for 5 seconds to notice any gaze or tiny movement.\',\\n        caregiverTip: \'Silence is part of the conversation.\',\\n      },\\n      {\\n        title: \'Follow baby\342\200\231s lead\',\\n        instructionText: \'Respond warmly when baby looks back; if baby looks away, let them rest quietly before ending.\',\\n        caregiverTip: \'Two peaceful minutes is plenty for newborns.\',\\n      },\\n    ],\\n    rubric: [\\n      { label: \'Calm, distraction-free setup\', description: \'Caregiver positioned baby safely on a flat surface in soft lighting without competing screens.\', weightPoints: 25 },\\n      { label: \'Appropriate face distance\', description: \'Caregiver stayed within ~20\342\200\22330 cm at baby\342\200\231s eye level for comfortable focus.\', weightPoints: 25 },\\n      { label: \'Slow, warm voice & pauses\', description: \'Caregiver spoke gently and paused to leave space for baby\342\200\231s cues.\', weightPoints: 25 },\\n      { label: \'Responsive pacing\', description: \'Caregiver respected baby\342\200\231s gaze breaks without forcing attention.\', weightPoints: 25 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'0-3m\',\\n    domainSlug: \'sensory\',\\n    title: \'High-Contrast Cloth Tracking\',\\n    summary: \'Invite slow visual tracking using a simple black-and-white cotton card.\',\\n    durationMinutes: 4,\\n    materials: [\'High-contrast linen card or bold striped cloth\', \'Soft floor mat\'],\\n    safetyNotes: \'Keep cloth out of baby\342\200\231s mouth and maintain hands-on supervision throughout.\',\\n    posterUrl: EDITORIAL_IMAGES.tummyMirror,\\n    steps: [\\n      { title: \'Settle comfortably\', instructionText: \'Place baby on their back during a calm, alert window after feeding and burping.\', caregiverTip: \'Avoid starting when baby is hungry.\' },\\n      { title: \'Present the card steadily\', instructionText: \'Hold the high-contrast cloth 20\342\200\22325 cm above baby\342\200\231s chest line until their eyes settle on it.\', caregiverTip: \'Wait patiently rather than shaking it.\' },\\n      { title: \'Move in a slow arc\', instructionText: \'Glide the card slowly from center to right, pause, then return smoothly to center and left.\', caregiverTip: \'Count to four as you move across.\' },\\n      { title: \'Close softly\', instructionText: \'Lower the cloth out of view and gently place your warm hand on baby\342\200\231s tummy.\', caregiverTip: \'Finish while baby is still relaxed.\' },\\n    ],\\n    rubric: [\\n      { label: \'Safe positioning\', description: \'Baby rested safely on a firm surface during an alert window.\', weightPoints: 25 },\\n      { label: \'Steady initial presentation\', description: \'Caregiver held the visual object still until baby noticed it.\', weightPoints: 25 },\\n      { label: \'Slow horizontal arc\', description: \'Caregiver moved smoothly without rapid shaking or jerking.\', weightPoints: 30 },\\n      { label: \'Gentle transition out\', description: \'Caregiver ended calmly before signs of overstimulation.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 3-6 months\\n  {\\n    ageSlug: \'3-6m\',\\n    domainSlug: \'physical\',\\n    title: \'Supported Mirror Tummy Time\',\\n    summary: \'Encourage comfortable floor exploration with a low baby-safe mirror and rolled towel.\',\\n    durationMinutes: 5,\\n    materials: [\'Firm cotton mat or dhurrie\', \'Safe shatterproof low mirror\', \'Small rolled cotton towel\'],\\n    safetyNotes: \'Never use glass mirrors that can tip. Stay within arm\342\200\231s reach and roll baby gently onto their back if tired.\',\\n    posterUrl: EDITORIAL_IMAGES.tummyMirror,\\n    steps: [\\n      { title: \'Anchor the mirror safely\', instructionText: \'Position the baby-safe mirror flat and secure at floor level beside the cotton mat.\', caregiverTip: \'Check that the frame cannot wobble.\' },\\n      { title: \'Roll gently onto tummy\', instructionText: \'Guide baby slowly from back to side to tummy, tucking elbows neatly under shoulders.\', caregiverTip: \'Offer a small rolled towel under the chest if needed.\' },\\n      { title: \'Lie down at eye level\', instructionText: \'Rest on the mat beside the mirror so baby sees both you and their reflection.\', caregiverTip: \'Your calm voice gives reassurance.\' },\\n      { title: \'Roll out with ease\', instructionText: \'After 2\342\200\2233 minutes or at early fussing, narrate \342\200\234rolling back now\342\200\235 and turn baby gently.\', caregiverTip: \'Short positive sessions build comfort.\' },\\n    ],\\n    rubric: [\\n      { label: \'Safe surface & mirror stability\', description: \'Caregiver used a firm floor mat and stable low mirror.\', weightPoints: 25 },\\n      { label: \'Gentle shoulder-tucked transition\', description: \'Caregiver rolled baby smoothly and supported comfortable arm placement.\', weightPoints: 25 },\\n      { label: \'Caregiver at eye level\', description: \'Caregiver stayed down on the floor narrating calmly beside baby.\', weightPoints: 25 },\\n      { label: \'Respectful session length\', description: \'Caregiver ended smoothly before distress escalated.\', weightPoints: 25 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'3-6m\',\\n    domainSlug: \'language\',\\n    title: \'Echo & Pause Cooing Turn-Taking\',\\n    summary: \'Practice warm back-and-forth vocal rhythm during relaxed floor time.\',\\n    durationMinutes: 5,\\n    materials: [\'Quiet mat space\'],\\n    safetyNotes: \'Keep background audio off so your natural speaking voice is easy to hear.\',\\n    posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n    steps: [\\n      { title: \'Sit face-to-face\', instructionText: \'Sit comfortably facing baby on the mat so baby clearly sees your mouth and expressions.\', caregiverTip: \'Natural daylight helps baby read facial expressions.\' },\\n      { title: \'Listen first\', instructionText: \'Wait quietly for a sigh, coo, or vowel sound from baby.\', caregiverTip: \'Resist filling every silent moment.\' },\\n      { title: \'Mirror warmly\', instructionText: \'Repeat baby\342\200\231s exact sound softly, then add one simple warm phrase like \342\200\234Yes, you\342\200\231re talking to Mama.\342\200\235\', caregiverTip: \'Keep your tone natural and gentle.\' },\\n      { title: \'Pause for a reply\', instructionText: \'Hold a smiling 5-second pause to invite another turn.\', caregiverTip: \'Even 4\342\200\2235 exchanges are wonderful.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clear face-to-face positioning\', description: \'Caregiver sat directly in baby\342\200\231s line of sight.\', weightPoints: 25 },\\n      { label: \'Quiet listening space\', description: \'Caregiver minimized background noise and waited before speaking.\', weightPoints: 25 },\\n      { label: \'Warm mirroring & naming\', description: \'Caregiver echoed baby\342\200\231s sounds with natural, affectionate speech.\', weightPoints: 25 },\\n      { label: \'Consistent 5-second pauses\', description: \'Caregiver left deliberate pauses for conversational turn-taking.\', weightPoints: 25 },\\n    ],\\n  },\\n\\n  // 6-9 months (Aarav\'s active band \342\200\224 rich 3-day sequence!)\\n  {\\n    ageSlug: \'6-9m\',\\n    domainSlug: \'sensory\',\\n    title: \'Household Texture Basket\',\\n    summary: \'Introduce safe everyday Indian home textures\342\200\224wood, steel, and soft muslin\342\200\224one item at a time.\',\\n    durationMinutes: 6,\\n    materials: [\'Woven cotton mat\', \'Smooth neem wooden spoon\', \'Small rounded steel katori\', \'Folded unbleached muslin cloth\'],\\n    safetyNotes: \'Inspect every object for sharp rims or splinters. Objects must be larger than 4 cm in diameter to prevent choking.\',\\n    posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n    steps: [\\n      { title: \'Offer just three objects\', instructionText: \'Place the wooden spoon, small rounded steel katori, and folded muslin cloth neatly on the mat\342\200\224avoid clutter.\', caregiverTip: \'Fewer objects invite deeper calm focus.\' },\\n      { title: \'Sit beside, not over\', instructionText: \'Sit calmly on the mat next to baby so they can reach freely with both hands.\', caregiverTip: \'Keep your hands resting quietly in your lap.\' },\\n      { title: \'Name textures gently\', instructionText: \'When baby touches an item, name it simply: \342\200\234Cool steel bowl\342\200\235 or \342\200\234Soft cotton cloth.\342\200\235\', caregiverTip: \'Narrate only what baby chooses\342\200\224avoid redirecting.\' },\\n      { title: \'Allow unhurried mouthing & tapping\', instructionText: \'Let baby explore safely with hands and mouth while you stay observant and calm.\', caregiverTip: \'End when baby\342\200\231s interest naturally drifts.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clean, uncluttered 3-object setup\', description: \'Caregiver laid out 2\342\200\2233 safe household objects neatly on a mat without visual overload.\', weightPoints: 25 },\\n      { label: \'Hands-off patient observation\', description: \'Caregiver allowed baby to choose and grasp independently without pushing objects into hands.\', weightPoints: 30 },\\n      { label: \'Simple descriptive language\', description: \'Caregiver named textures calmly in short phrases matching baby\342\200\231s focus.\', weightPoints: 25 },\\n      { label: \'Close safety supervision\', description: \'Caregiver remained seated within arm\342\200\231s reach monitoring safe exploration.\', weightPoints: 20 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'6-9m\',\\n    domainSlug: \'cognitive\',\\n    title: \'Muslin Scarf Peek-a-Boo Object Permanence\',\\n    summary: \'Explore hidden-and-found play gently using a breathable cotton scarf and wooden ring.\',\\n    durationMinutes: 5,\\n    materials: [\'Light breathable muslin cloth\', \'Smooth wooden ring or rattle\'],\\n    safetyNotes: \'Never leave cloth over baby\342\200\231s face; always keep peek-a-boo light, brief, and joyful.\',\\n    posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n    steps: [\\n      { title: \'Show the wooden ring clearly\', instructionText: \'Place the wooden ring on the mat between you and baby so both of you see it.\', caregiverTip: \'Let baby touch it briefly first.\' },\\n      { title: \'Cover half the ring first\', instructionText: \'Drape the light muslin scarf over half of the ring so one edge stays visible.\', caregiverTip: \'Start easy so baby experiences success.\' },\\n      { title: \'Ask warmly and wait\', instructionText: \'Ask \342\200\234Where did the wooden ring go?\342\200\235 and wait calmly with an encouraging smile.\', caregiverTip: \'Give baby plenty of time to pull the scarf.\' },\\n      { title: \'Celebrate calmly\', instructionText: \'When the ring appears, say softly \342\200\234There it is! You found the ring,\342\200\235 without startling loud noises.\', caregiverTip: \'Repeat 2\342\200\2233 times if baby stays engaged.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clear visual setup\', description: \'Caregiver introduced the toy clearly before covering it.\', weightPoints: 20 },\\n      { label: \'Partial-cover scaffolding\', description: \'Caregiver started with the object partially visible to keep frustration low.\', weightPoints: 30 },\\n      { label: \'Patient waiting pause\', description: \'Caregiver waited calmly instead of pulling the cloth off immediately.\', weightPoints: 30 },\\n      { label: \'Warm, calm narration\', description: \'Caregiver spoke gently and clearly without overstimulating volume.\', weightPoints: 20 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'6-9m\',\\n    domainSlug: \'language\',\\n    title: \'Everyday Kitchen Naming Rhyme\',\\n    summary: \'Connect familiar household words with clear lip movement and soothing rhythm.\',\\n    durationMinutes: 5,\\n    materials: [\'Steel katori\', \'Wooden spoon\', \'Cotton napkin\'],\\n    safetyNotes: \'Keep metal items lightweight with smooth rolled edges.\',\\n    posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n    steps: [\\n      { title: \'Sit face-to-face on the mat\', instructionText: \'Position yourself across from baby so they can see both your face and the object.\', caregiverTip: \'Keep the other items tucked aside.\' },\\n      { title: \'Hold one object near your cheek\', instructionText: \'Lift the wooden spoon beside your face and say clearly: \342\200\234Spoon. Wooden spoon.\342\200\235\', caregiverTip: \'Speak slightly slower than adult conversation.\' },\\n      { title: \'Offer and pause\', instructionText: \'Place the spoon on the mat in front of baby and wait for any babble, reach, or look.\', caregiverTip: \'Respond to babbling as a real reply.\' },\\n      { title: \'Repeat with rhythm\', instructionText: \'Tap the wooden spoon gently twice on the mat and say \342\200\234Tap, tap,\342\200\235 keeping the pace calm.\', caregiverTip: \'Two objects per session is enough.\' },\\n    ],\\n    rubric: [\\n      { label: \'Face-to-face visibility\', description: \'Caregiver ensured baby could see both caregiver\342\200\231s mouth and the object.\', weightPoints: 25 },\\n      { label: \'Single-object focus\', description: \'Caregiver introduced one item at a time without clutter.\', weightPoints: 25 },\\n      { label: \'Clear, unhurried pronunciation\', description: \'Caregiver used slow, simple everyday words.\', weightPoints: 25 },\\n      { label: \'Responsive pauses\', description: \'Caregiver paused after naming to welcome baby\342\200\231s vocal or gesture response.\', weightPoints: 25 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'6-9m\',\\n    domainSlug: \'physical\',\\n    title: \'Side-Reach Wooden Ring Roll\',\\n    summary: \'Invite comfortable reaching and weight shifting on the floor mat.\',\\n    durationMinutes: 6,\\n    materials: [\'Firm woven floor mat\', \'Smooth wooden ring or knitted cotton ball\'],\\n    safetyNotes: \'Clear nearby hard furniture corners so baby has open floor space to shift safely.\',\\n    posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n    steps: [\\n      { title: \'Prepare open floor space\', instructionText: \'Spread a firm mat away from sharp furniture edges so baby can move freely.\', caregiverTip: \'Bare feet offer better grip on cotton mats.\' },\\n      { title: \'Place ring slightly to one side\', instructionText: \'Set the wooden ring just outside easy reach to baby\342\200\231s right side.\', caregiverTip: \'Keep it close enough to feel inviting.\' },\\n      { title: \'Encourage without pulling\', instructionText: \'Tap the mat lightly beside the ring and smile, allowing baby to shift or lean on their own.\', caregiverTip: \'Avoid dragging baby forward by the arms.\' },\\n      { title: \'Switch sides gently\', instructionText: \'After baby grasps and explores, offer the next turn softly on the left side.\', caregiverTip: \'Stop while baby is still smiling.\' },\\n    ],\\n    rubric: [\\n      { label: \'Safe open mat space\', description: \'Caregiver prepared a clear, firm floor area.\', weightPoints: 25 },\\n      { label: \'Thoughtful reach distance\', description: \'Caregiver placed the object slightly to the side without placing it frustratingly far.\', weightPoints: 25 },\\n      { label: \'No physical forcing\', description: \'Caregiver let baby initiate movement without pulling hands or torso.\', weightPoints: 30 },\\n      { label: \'Balanced left-and-right invitation\', description: \'Caregiver offered calm encouragement on both sides.\', weightPoints: 20 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'6-9m\',\\n    domainSlug: \'early-independence\',\\n    title: \'Two-Handed Open Cup Sip Practice\',\\n    summary: \'Introduce a tiny splash of water in a small open steel cup with calm guidance.\',\\n    durationMinutes: 5,\\n    materials: [\'Small baby-sized open steel cup (1\342\200\2232 tsp water)\', \'Soft linen napkin\'],\\n    safetyNotes: \'Baby must be seated upright with steady head and trunk support. Use only 1\342\200\2232 teaspoons of water at a time to prevent coughing.\',\\n    posterUrl: EDITORIAL_IMAGES.everydayCup,\\n    steps: [\\n      { title: \'Ensure upright seating\', instructionText: \'Seat baby comfortably upright in your lap or a supportive chair with the napkin nearby.\', caregiverTip: \'Never offer liquids while reclined.\' },\\n      { title: \'Pour a tiny amount\', instructionText: \'Add just one or two teaspoons of water so tilting stays easy and mess stays small.\', caregiverTip: \'Spills are completely normal practice.\' },\\n      { title: \'Guide hands together\', instructionText: \'Rest your hands gently over baby\342\200\231s hands on the cup, bring the rim to the lower lip, and tip slightly.\', caregiverTip: \'Pause after one small sip.\' },\\n      { title: \'Wipe gently and narrate\', instructionText: \'Set the cup down together and dab chin calmly with the napkin: \342\200\234All done, warm cloth.\342\200\235\', caregiverTip: \'Keep the mood relaxed and encouraging.\' },\\n    ],\\n    rubric: [\\n      { label: \'Upright safe seating\', description: \'Caregiver ensured upright posture throughout drinking.\', weightPoints: 30 },\\n      { label: \'Small water portion\', description: \'Caregiver filled cup with only a tiny safe sip amount.\', weightPoints: 20 },\\n      { label: \'Gentle hand-over-hand support\', description: \'Caregiver tipped cup slowly and paused between sips.\', weightPoints: 30 },\\n      { label: \'Calm wipe-and-narrate closure\', description: \'Caregiver handled drips calmly without rushing or scolding.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 9-12 months\\n  {\\n    ageSlug: \'9-12m\',\\n    domainSlug: \'cognitive\',\\n    title: \'In-and-Out Steel Katori Drop\',\\n    summary: \'Explore container play by dropping knitted cotton balls into a wide steel bowl.\',\\n    durationMinutes: 6,\\n    materials: [\'Wide rounded steel katori\', \'2\342\200\2233 soft knitted cotton balls\'],\\n    safetyNotes: \'Ensure balls are larger than 4.5 cm so they cannot pose a choking hazard.\',\\n    posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n    steps: [\\n      { title: \'Arrange neatly on the mat\', instructionText: \'Place the steel bowl centered on the mat with two cotton balls resting on the left.\', caregiverTip: \'Neat order invites curiosity.\' },\\n      { title: \'Demonstrate once silently\', instructionText: \'Pick up one ball slowly, drop it into the bowl with a soft sound, and pause.\', caregiverTip: \'Slow hands teach better than long explanations.\' },\\n      { title: \'Invite baby\342\200\231s turn\', instructionText: \'Say \342\200\234Your turn\342\200\235 softly and sit back with relaxed hands.\', caregiverTip: \'Let baby dump the bowl out too\342\200\224that is part of learning.\' },\\n      { title: \'Tidy together\', instructionText: \'Place the balls back in the bowl calmly at the end and say \342\200\234All tucked away.\342\200\235\', caregiverTip: \'Simple closing routines build calm habits.\' },\\n    ],\\n    rubric: [\\n      { label: \'Ordered mat presentation\', description: \'Caregiver presented bowl and balls neatly without clutter.\', weightPoints: 25 },\\n      { label: \'Slow single demonstration\', description: \'Caregiver modeled dropping one item slowly and clearly.\', weightPoints: 25 },\\n      { label: \'Hands-off invitation\', description: \'Caregiver let baby experiment with dropping and emptying freely.\', weightPoints: 30 },\\n      { label: \'Calm tidy-up closure\', description: \'Caregiver closed the activity with gentle narration.\', weightPoints: 20 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'9-12m\',\\n    domainSlug: \'social-emotional\',\\n    title: \'Slow Goodbye Wave & Return Game\',\\n    summary: \'Practice reassuring short separations around a doorway to build trust.\',\\n    durationMinutes: 5,\\n    materials: [\'Familiar room doorway\'],\\n    safetyNotes: \'Keep baby in a completely safe floor space while you step just out of sight for 2 seconds.\',\\n    posterUrl: EDITORIAL_IMAGES.heroMontessori,\\n    steps: [\\n      { title: \'Announce before stepping\', instructionText: \'Wave calmly at eye level and say \342\200\234Mama is stepping behind the door, I\342\200\231ll be right back.\342\200\235\', caregiverTip: \'Never sneak away unexpectedly.\' },\\n      { title: \'Step just out of sight briefly\', instructionText: \'Pause 2 seconds while keeping your warm voice audible: \342\200\234I\342\200\231m right here!\342\200\235\', caregiverTip: \'Your voice bridges the moment.\' },\\n      { title: \'Return warmly\', instructionText: \'Step back in calmly smiling: \342\200\234Mama came back!\342\200\235\', caregiverTip: \'Keep the tone steady rather than overly dramatic.\' },\\n      { title: \'Offer a warm cuddle if sought\', instructionText: \'Welcome baby with open arms and calm breathing.\', caregiverTip: \'Builds everyday confidence for real goodbyes.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clear verbal cue before stepping\', description: \'Caregiver told baby calmly before stepping out of sight.\', weightPoints: 30 },\\n      { label: \'Reassuring vocal bridge\', description: \'Caregiver kept a calm voice during the brief pause.\', weightPoints: 25 },\\n      { label: \'Predictable warm return\', description: \'Caregiver returned smoothly within 2\342\200\2233 seconds.\', weightPoints: 25 },\\n      { label: \'Emotionally attuned finish\', description: \'Caregiver responded warmly to baby\342\200\231s reaction.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 12-15 months\\n  {\\n    ageSlug: \'12-15m\',\\n    domainSlug: \'early-independence\',\\n    title: \'Wooden Ring Stack & Linen Fold\',\\n    summary: \'Practice purposeful hand coordination and gentle tidying on a low tabletop.\',\\n    durationMinutes: 7,\\n    materials: [\'Unpainted wooden ring stacker\', \'Small folded linen cloth\'],\\n    safetyNotes: \'Keep peg upright on a stable low table or floor mat while seated.\',\\n    posterUrl: EDITORIAL_IMAGES.everydayCup,\\n    steps: [\\n      { title: \'Set out only 3 rings first\', instructionText: \'Place the wooden post and just three rings beside it so the task feels achievable.\', caregiverTip: \'You can add more rings on future days.\' },\\n      { title: \'Show one deliberate ring placement\', instructionText: \'Lift one ring with both hands, slide it slowly down the post, and pause.\', caregiverTip: \'Move slower than feels natural.\' },\\n      { title: \'Wait patiently\', instructionText: \'Let toddler try, miss, adjust, and retry without grabbing the ring from their hand.\', caregiverTip: \'Offer a quiet smile rather than constant praise.\' },\\n      { title: \'Wipe or fold cloth to finish\', instructionText: \'Invite toddler to place the cloth neatly beside the stacker when finished.\', caregiverTip: \'Celebrates shared care of space.\' },\\n    ],\\n    rubric: [\\n      { label: \'Manageable 3-ring setup\', description: \'Caregiver simplified the activity to prevent overwhelm.\', weightPoints: 25 },\\n      { label: \'Slow deliberate modeling\', description: \'Caregiver demonstrated one step calmly with clear hand visibility.\', weightPoints: 25 },\\n      { label: \'Patient non-interference\', description: \'Caregiver allowed toddler to retry without taking over.\', weightPoints: 30 },\\n      { label: \'Gentle closing routine\', description: \'Caregiver modeled placing materials neatly afterward.\', weightPoints: 20 },\\n    ],\\n  },\\n  {\\n    ageSlug: \'12-15m\',\\n    domainSlug: \'language\',\\n    title: \'Everyday Object Choice & Naming\',\\n    summary: \'Offer two familiar household items and celebrate pointing, gestures, and first words.\',\\n    durationMinutes: 5,\\n    materials: [\'Small open steel cup\', \'Wooden spoon\'],\\n    safetyNotes: \'Sit comfortably at toddler\342\200\231s eye level on a floor mat.\',\\n    posterUrl: EDITORIAL_IMAGES.everydayCup,\\n    steps: [\\n      { title: \'Hold two familiar items apart\', instructionText: \'Hold the cup in one hand and wooden spoon in the other, clearly naming each once.\', caregiverTip: \'Pause between the two names.\' },\\n      { title: \'Ask an open calm question\', instructionText: \'Ask \342\200\234Would you like the cup or the spoon?\342\200\235 and wait patiently.\', caregiverTip: \'Honor pointing, gazing, or sounds equally.\' },\\n      { title: \'Confirm their choice\', instructionText: \'Hand over the chosen item while naming it warmly: \342\200\234You chose the cup!\342\200\235\', caregiverTip: \'Avoid quizzing or repeating \342\200\234Say cup!\342\200\235\' },\\n      { title: \'Follow their play briefly\', instructionText: \'Join quietly for 2 minutes following what they do with the item.\', caregiverTip: \'Real choices motivate communication.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clear two-option presentation\', description: \'Caregiver held items clearly spaced at eye level.\', weightPoints: 25 },\\n      { label: \'Simple choice question + pause\', description: \'Caregiver asked once and waited patiently.\', weightPoints: 30 },\\n      { label: \'Honoring non-verbal & vocal cues\', description: \'Caregiver responded warmly to pointing or sound without pressuring speech.\', weightPoints: 25 },\\n      { label: \'Warm confirmation\', description: \'Caregiver named the chosen item clearly when handing it over.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 15-18 months\\n  {\\n    ageSlug: \'15-18m\',\\n    domainSlug: \'early-independence\',\\n    title: \'Cloth Wiping a Tiny Water Spill\',\\n    summary: \'Turn everyday spills into calm, capable participation with a small cotton cloth.\',\\n    durationMinutes: 6,\\n    materials: [\'Small cotton cloth\', \'Low table or tray\', \'A few drops of water\'],\\n    safetyNotes: \'Use only a few drops of water on a non-slip low table so the floor stays dry.\',\\n    posterUrl: EDITORIAL_IMAGES.everydayCup,\\n    steps: [\\n      { title: \'Place a few drops on a tray\', instructionText: \'Put a tiny splash of water on a low tray and place the folded cotton cloth beside it.\', caregiverTip: \'Keep it playful and matter-of-fact.\' },\\n      { title: \'Model wiping slowly\', instructionText: \'Press the cloth gently onto the water and move in a slow circle: \342\200\234Wipe, wipe.\342\200\235\', caregiverTip: \'Use calm, encouraging words.\' },\\n      { title: \'Hand the cloth to toddler\', instructionText: \'Invite toddler to wipe the remaining drops independently.\', caregiverTip: \'Resist wiping over their work immediately.\' },\\n      { title: \'Place cloth to dry together\', instructionText: \'Walk together to place the damp cloth on a low hook or drying spot.\', caregiverTip: \'Builds pride in everyday contribution.\' },\\n    ],\\n    rubric: [\\n      { label: \'Prepared low workspace\', description: \'Caregiver set up a safe, manageable spill size on a tray.\', weightPoints: 25 },\\n      { label: \'Clear slow demonstration\', description: \'Caregiver showed the wiping motion calmly before handing over.\', weightPoints: 25 },\\n      { label: \'Encouraging independent attempt\', description: \'Caregiver let toddler finish without criticizing or redoing immediately.\', weightPoints: 30 },\\n      { label: \'Complete routine closure\', description: \'Caregiver included putting the cloth away calmly.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 18-21 months\\n  {\\n    ageSlug: \'18-21m\',\\n    domainSlug: \'cognitive\',\\n    title: \'Two-Basket Natural Matching\',\\n    summary: \'Sort smooth wooden spoons and folded cotton cloths into two simple bowls.\',\\n    durationMinutes: 7,\\n    materials: [\'2 wide bowls or baskets\', \'3 wooden spoons\', \'3 folded muslin cloths\'],\\n    safetyNotes: \'Use smooth, clean household items and supervise seated floor play.\',\\n    posterUrl: EDITORIAL_IMAGES.sensoryLinen,\\n    steps: [\\n      { title: \'Create two clear anchors\', instructionText: \'Place one wooden spoon in the left bowl and one folded cloth in the right bowl.\', caregiverTip: \'Visual anchors reduce verbal instructions.\' },\\n      { title: \'Model one match silently\', instructionText: \'Pick up another spoon, look between bowls, and place it gently with the first spoon.\', caregiverTip: \'Let toddler notice the visual match.\' },\\n      { title: \'Offer remaining items one by one\', instructionText: \'Hand one item at a time so toddler can decide where it belongs.\', caregiverTip: \'If they mix them up, stay warm and curious.\' },\\n      { title: \'Appreciate effort calmly\', instructionText: \'Observe specifically: \342\200\234You put all the soft cloths together.\342\200\235\', caregiverTip: \'Specific calm observation encourages focus.\' },\\n    ],\\n    rubric: [\\n      { label: \'Clear visual anchor setup\', description: \'Caregiver placed one anchor item in each bowl.\', weightPoints: 25 },\\n      { label: \'One-by-one calm pacing\', description: \'Caregiver offered items gradually without rushing.\', weightPoints: 25 },\\n      { label: \'Supportive non-corrective tone\', description: \'Caregiver allowed exploration without harsh correction.\', weightPoints: 30 },\\n      { label: \'Specific calm reflection\', description: \'Caregiver described what toddler did rather than generic rushing.\', weightPoints: 20 },\\n    ],\\n  },\\n\\n  // 21-24 months\\n  {\\n    ageSlug: \'21-24m\',\\n    domainSlug: \'social-emotional\',\\n    title: \'Calm Naming of Everyday Feelings\',\\n    summary: \'Use a low mirror and warm storytelling to name happy, sleepy, and calm faces together.\',\\n    durationMinutes: 6,\\n    materials: [\'Low mirror on cotton mat\'],\\n    safetyNotes: \'Ensure mirror is firmly secured against a wall.\',\\n    posterUrl: EDITORIAL_IMAGES.tummyMirror,\\n    steps: [\\n      { title: \'Sit side-by-side by the mirror\', instructionText: \'Invite toddler to sit beside you facing the safe low mirror.\', caregiverTip: \'Let toddler choose their comfortable seat.\' },\\n      { title: \'Name one gentle feeling\', instructionText: \'Make a soft smiling face and say \342\200\234Warm happy face. Mama feels calm and happy.\342\200\235\', caregiverTip: \'Keep expressions authentic and gentle.\' },\\n      { title: \'Invite imitation without pressure\', instructionText: \'Ask \342\200\234Can we try a sleepy yawn face together?\342\200\235 and pause playfully.\', caregiverTip: \'Follow any expression toddler invents.\' },\\n      { title: \'Practice one slow breath together\', instructionText: \'Place hands on tummies and take one slow \342\200\234smell the flower\342\200\235 breath to close.\', caregiverTip: \'A soothing habit toddlers love reusing.\' },\\n    ],\\n    rubric: [\\n      { label: \'Side-by-side mirror setup\', description: \'Caregiver sat comfortably beside toddler at eye level.\', weightPoints: 25 },\\n      { label: \'Clear, relatable feeling words\', description: \'Caregiver named simple everyday emotions gently.\', weightPoints: 25 },\\n      { label: \'Playful zero-pressure invitation\', description: \'Caregiver followed toddler\342\200\231s lead without forcing poses.\', weightPoints: 25 },\\n      { label: \'Calming breath closure\', description: \'Caregiver ended with a slow regulating transition.\', weightPoints: 25 },\\n    ],\\n  },\\n];\\n\\nexport function seedDatabaseIfEmpty(db: Database.Database): void {\\n  const existingAgeGroups = db.prepare(\'SELECT COUNT(*) as count FROM age_groups\').get() as {\\n    count: number;\\n  };\\n  if (existingAgeGroups.count > 0) {\\n    return;\\n  }\\n\\n  const insertTransaction = db.transaction(() => {\\n    const ageGroupIds: Record<string, string> = {};\\n    const insertAge = db.prepare(\\n      `INSERT INTO age_groups (id, slug, label, min_months, max_months, sort_order)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n    for (const group of CANONICAL_AGE_GROUPS) {\\n      const id = `ag_${group.slug}`;\\n      ageGroupIds[group.slug] = id;\\n      insertAge.run(id, group.slug, group.label, group.minMonths, group.maxMonths, group.sortOrder);\\n    }\\n\\n    const domainIds: Record<string, string> = {};\\n    const insertDomain = db.prepare(\\n      `INSERT INTO learning_domains (id, slug, name, description, sort_order)\\n       VALUES (?, ?, ?, ?, ?)`\\n    );\\n    for (const domain of CANONICAL_LEARNING_DOMAINS) {\\n      const id = `dom_${domain.slug}`;\\n      domainIds[domain.slug] = id;\\n      insertDomain.run(id, domain.slug, domain.name, domain.description, domain.sortOrder);\\n    }\\n\\n    // Seed demo accounts across all 3 roles (Password for all demo accounts: LittleSteps123!)\\n    const demoPasswordHash = hashPassword(\'LittleSteps123!\');\\n    const parentId = \'usr_parent_meera\';\\n    const reviewerId = \'usr_reviewer_ananya\';\\n    const adminId = \'usr_admin_kavita\';\\n\\n    const insertUser = db.prepare(\\n      `INSERT INTO users (id, email, password_hash, full_name, phone_number, role, preferred_locale, is_active)\\n       VALUES (?, ?, ?, ?, ?, ?, \'en\', 1)`\\n    );\\n    insertUser.run(parentId, \'meera@littlesteps.in\', demoPasswordHash, \'Meera Deshmukh\', \'+91 98200 11223\', \'parent\');\\n    insertUser.run(reviewerId, \'ananya.reviewer@littlesteps.in\', demoPasswordHash, \'Ananya Kulkarni\', \'+91 98200 44556\', \'reviewer\');\\n    insertUser.run(adminId, \'kavita.admin@littlesteps.in\', demoPasswordHash, \'Kavita Nair\', \'+91 98200 77889\', \'admin\');\\n\\n    db.prepare(\\n      `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n       VALUES (?, ?, \'privacy_policy\', \'v1.0\', \'seeded\'),\\n              (?, ?, \'video_processing\', \'v1.0\', \'seeded\')`\\n    ).run(crypto.randomUUID(), parentId, crypto.randomUUID(), parentId);\\n\\n    // Seed all starter activities, steps, and weighted rubrics\\n    const insertActivity = db.prepare(\\n      `INSERT INTO activities (\\n         id, age_group_id, domain_id, title, summary, duration_minutes,\\n         materials_json, safety_notes, instructional_poster_url, status, created_by\\n       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, \'published\', ?)`\\n    );\\n    const insertStep = db.prepare(\\n      `INSERT INTO activity_steps (id, activity_id, step_number, title, instruction_text, caregiver_tip)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n    const insertRubric = db.prepare(\\n      `INSERT INTO activity_rubric_criteria (id, activity_id, criterion_order, label, description, weight_points)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n\\n    const activitiesByAge: Record<string, string[]> = {};\\n    const rubricIdsByActivity: Record<string, Array<{ id: string; weight: number }>> = {};\\n\\n    STARTER_ACTIVITIES.forEach((act, idx) => {\\n      const actId = `act_${String(idx + 1).padStart(2, \'0\')}`;\\n      const ageId = ageGroupIds[act.ageSlug];\\n      const domainId = domainIds[act.domainSlug];\\n      insertActivity.run(\\n        actId,\\n        ageId,\\n        domainId,\\n        act.title,\\n        act.summary,\\n        act.durationMinutes,\\n        JSON.stringify(act.materials),\\n        act.safetyNotes,\\n        act.posterUrl,\\n        adminId\\n      );\\n      activitiesByAge[act.ageSlug] = activitiesByAge[act.ageSlug] || [];\\n      activitiesByAge[act.ageSlug].push(actId);\\n\\n      act.steps.forEach((step, sIdx) => {\\n        insertStep.run(\\n          `${actId}_step_${sIdx + 1}`,\\n          actId,\\n          sIdx + 1,\\n          step.title,\\n          step.instructionText,\\n          step.caregiverTip\\n        );\\n      });\\n\\n      rubricIdsByActivity[actId] = [];\\n      act.rubric.forEach((crit, rIdx) => {\\n        const critId = `${actId}_rub_${rIdx + 1}`;\\n        insertRubric.run(critId, actId, rIdx + 1, crit.label, crit.description, crit.weightPoints);\\n        rubricIdsByActivity[actId].push({ id: critId, weight: crit.weightPoints });\\n      });\\n    });\\n\\n    // Seed calm Daily Plans for every age group (2\342\200\2233 focused activities per day)\\n    const insertPlan = db.prepare(\\n      `INSERT INTO daily_plans (id, age_group_id, day_number, title, focus_note)\\n       VALUES (?, ?, ?, ?, ?)`\\n    );\\n    const insertPlanItem = db.prepare(\\n      `INSERT INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order)\\n       VALUES (?, ?, ?, ?)`\\n    );\\n\\n    for (const group of CANONICAL_AGE_GROUPS) {\\n      const ageId = ageGroupIds[group.slug];\\n      const acts = activitiesByAge[group.slug] || [];\\n      if (acts.length === 0) continue;\\n\\n      if (group.slug === \'6-9m\' && acts.length >= 5) {\\n        // Rich 3-day sequence for the demo parent\'s baby Aarav (7 months)\\n        const plan1 = `plan_${group.slug}_d1`;\\n        insertPlan.run(\\n          plan1,\\n          ageId,\\n          1,\\n          \'Day 1 \302\267 Gentle Curiosity\',\\n          \'Take just 10 unhurried minutes across today. Pause whenever baby wants to rest.\'\\n        );\\n        insertPlanItem.run(crypto.randomUUID(), plan1, acts[0], 1);\\n        insertPlanItem.run(crypto.randomUUID(), plan1, acts[1], 2);\\n        insertPlanItem.run(crypto.randomUUID(), plan1, acts[2], 3);\\n\\n        const plan2 = `plan_${group.slug}_d2`;\\n        insertPlan.run(\\n          plan2,\\n          ageId,\\n          2,\\n          \'Day 2 \302\267 Reaching & Everyday Sips\',\\n          \'Warm floor movement paired with a tiny, joyful sip from an open steel cup.\'\\n        );\\n        insertPlanItem.run(crypto.randomUUID(), plan2, acts[3], 1);\\n        insertPlanItem.run(crypto.randomUUID(), plan2, acts[4], 2);\\n\\n        const plan3 = `plan_${group.slug}_d3`;\\n        insertPlan.run(\\n          plan3,\\n          ageId,\\n          3,\\n          \'Day 3 \302\267 Familiar Rhythms\',\\n          \'Repeating familiar activities builds deep comfort and confidence for babies.\'\\n        );\\n        insertPlanItem.run(crypto.randomUUID(), plan3, acts[0], 1);\\n        insertPlanItem.run(crypto.randomUUID(), plan3, acts[3], 2);\\n      } else {\\n        const plan1 = `plan_${group.slug}_d1`;\\n        insertPlan.run(\\n          plan1,\\n          ageId,\\n          1,\\n          \'Day 1 \302\267 Calm Discovery\',\\n          \'Choose one quiet window today when baby is rested and fed.\'\\n        );\\n        acts.slice(0, 3).forEach((actId, idx) => {\\n          insertPlanItem.run(crypto.randomUUID(), plan1, actId, idx + 1);\\n        });\\n      }\\n    }\\n\\n    // Seed Aarav (7 months old) for Meera Deshmukh\\n    const dob = new Date();\\n    dob.setMonth(dob.getMonth() - 7);\\n    const dobIso = dob.toISOString().slice(0, 10);\\n    const childId = \'ch_aarav_01\';\\n    db.prepare(\\n      `INSERT INTO children (id, parent_user_id, display_name, date_of_birth, active_age_group_id)\\n       VALUES (?, ?, \'Aarav\', ?, ?)`\\n    ).run(childId, parentId, dobIso, ageGroupIds[\'6-9m\']);\\n\\n    // Seed 1 reviewed activity completion with a real caregiver-execution rubric score\\n    // and privacy-deleted video demonstrating \\\"Video deleted by parent \302\267 Feedback preserved\\\"\\n    const todayIso = new Date().toISOString().slice(0, 10);\\n    const reviewedActivityId = activitiesByAge[\'6-9m\'][0]; // Household Texture Basket\\n    const compId = \'comp_seed_01\';\\n    db.prepare(\\n      `INSERT INTO activity_completions (id, child_id, activity_id, plan_date, status, caregiver_notes, completed_at)\\n       VALUES (?, ?, ?, ?, \'reviewed\', ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', \'-1 day\'))`\\n    ).run(\\n      compId,\\n      childId,\\n      reviewedActivityId,\\n      todayIso,\\n      \'Aarav loved tapping the cool steel katori gently with the neem spoon.\'\\n    );\\n\\n    const subId = \'sub_seed_reviewed_01\';\\n    const expiresDate = new Date(Date.now() + RETENTION_DAYS * 86400 * 1000).toISOString();\\n    db.prepare(\\n      `INSERT INTO video_submissions (\\n         id, completion_id, parent_user_id, child_id, activity_id,\\n         storage_key, mime_type, file_size_bytes, duration_seconds,\\n         review_status, assigned_reviewer_id, caregiver_notes,\\n         expires_at, deleted_at, deletion_reason, created_at\\n       ) VALUES (\\n         ?, ?, ?, ?, ?,\\n         NULL, \'video/webm\', 4120000, 48,\\n         \'reviewed\', ?, \'Morning session by the sunlit window.\',\\n         ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', \'-2 hours\'), \'parent_deleted\',\\n         strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', \'-1 day\')\\n       )`\\n    ).run(subId, compId, parentId, childId, reviewedActivityId, reviewerId, expiresDate);\\n\\n    const revId = \'rev_seed_01\';\\n    db.prepare(\\n      `INSERT INTO submission_reviews (\\n         id, submission_id, reviewer_user_id, instruction_match_score_pct,\\n         strengths_note, coaching_tip, evaluation_scope_acknowledged_at, submitted_at\\n       ) VALUES (\\n         ?, ?, ?, 88,\\n         \'Your mat setup was serene and uncluttered with three safe household items, and you stayed warmly at Aarav\342\200\231s side without rushing.\',\\n         \'Next time, pause for 3\342\200\2234 quiet seconds after naming \342\200\234cool steel bowl\342\200\235 so baby has extra space to look back at your voice.\',\\n         strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', \'-20 hours\'),\\n         strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', \'-20 hours\')\\n       )`\\n    ).run(revId, subId, reviewerId);\\n\\n    const seedRubrics = rubricIdsByActivity[reviewedActivityId] || [];\\n    const insertRevScore = db.prepare(\\n      `INSERT INTO review_rubric_scores (id, review_id, rubric_criterion_id, achieved_level, earned_points, max_points)\\n       VALUES (?, ?, ?, ?, ?, ?)`\\n    );\\n    seedRubrics.forEach((r, idx) => {\\n      const level = idx === 2 ? \'partially_met\' : \'met\';\\n      const earned = level === \'met\' ? r.weight : r.weight * 0.5;\\n      insertRevScore.run(crypto.randomUUID(), revId, r.id, level, earned, r.weight);\\n    });\\n\\n    // Seed audit log history showing full privacy lifecycle\\n    const insertAudit = db.prepare(\\n      `INSERT INTO media_access_audit_logs (id, actor_user_id, actor_role, submission_id, action, created_at)\\n       VALUES (?, ?, ?, ?, ?, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\', ?))`\\n    );\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'upload\', \'-24 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'review_open\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), reviewerId, \'reviewer\', subId, \'stream\', \'-21 hours\');\\n    insertAudit.run(crypto.randomUUID(), parentId, \'parent\', subId, \'parent_delete\', \'-2 hours\');\\n  });\\n\\n  insertTransaction();\\n}\\n\", \"Description\":\"Seed LittleSteps with all 8 age groups, 6 learning domains, India-friendly Montessori activities, weighted caregiver rubrics, daily plans, and demo accounts.\", \"Overwrite\":true, \"TargetFile\":\"/server/db/seed.ts\", \"toolAction\":\"Creating database seed module\", \"toolSummary\":\"Create database seed\"}"
      thinking_signature: "\022\207\n\n\204\n\001i\024}\023j\\\004\255\022\022\020I\226\034\261\347\033\337\306\375L\230\264#\317\257{=\252&\330\fP\362\331\253C\2331\022\v\335Y/=\320\235X\\Mks\260\201\202:G\033\t\244\313\023`I\a\202\241\305\216\031\335pas{\332\377\262KA\243s\270@h\316\346\035\'\214\317\316\344n\246\364V\262\205\253\331\313T!:\225\324s\030vae\005\207kyF(A4\377yN\202\220\231eC\234=&\342\377\313\376pp\252*EO\315\017\364\255;\005\216!\204>\000\f\242\003\260\023\323\270Q\022epn\201\336\020\342\b\325\037\2728t\255\256\367~\342\333k>\v\214\342$I\213\273\f\206T\006\204\216\177\266\313r\261\244U\366\242X)\370O\370{\340\313V+R\017\221\303J\311[[G\001O\353\311\273!\226\2072F\311\354\372 \207\026q\033\306h\316\272\325\215F\321f\035?\313\202fY\367\345\034\244\025f\235\311\334Gu\a\326\r\333\212\v\271B\034\303(:M(\227\026\006\362\1770Uyo\345H\004\'\233Z\274\236\351u\2766T\210\377\2276y\354\232\260\307\263\016\006\225\'\352)\245\271\332\001\311\376\302L\270X\270kN\342N\'/\345>\253\375\363\344\"`\201\"\264c\26375\3058\363x\236\205\021\233\364\262\f\306s\r\a\017\254\331N\331wV\222\237l\215\214\212\200\214\215\315\3567]\332S\251\022\302\361\0322\370K\337\022L\t_\252\f\235\267*\204T\177\242\331<\314\251;d\325\203j\326r\226!\372\374\243\204`\313~\353\224\352[_\324\305\330\315[t\325hVK-\217\365\354S\336\203\361\020\nBS\252\305N`-@4\330\352\200(\216\350\363Z\336\006\375\210%S\204\003\\\367+*\370\",\376\t\033\270\314\323y/r\305j\235\244\331$\316\327^vg\3510<u\340\006\343t\302\316\021\373\222\253\022\227\270\020~pp3\331$o\352\361\213UP\254\227&\"o#\273\240\336v\325\256\207\344`\023\332p\201\\CY\342\350%\241W\2037\303w\213\227\232F\343M\262\3005\273\302F/\016\232\273\022\334 \034\"[\035\230\234\264M\373V\203\357\377\342\250\016\376\320\212\217\261\354\343 \273\344\272\272\003m(\020)\"8i\373%\230\2740\350\034\033\243|z3c.5+=U\205@\237n\t@\262l\323e\203X\375\361\232\302\354^pN\203\227\350?E[Uu\036)L\334\032\260\202\355,\347\rx\306BAu\tz\2255G\322Z\224Gn\321\210\200\266\347\363X\vkUA\311<j3R\225a#\006e\177N\2144&Iq\201\217!\0311\334X\222\212\351\030^\317O\a{\177\363}w\022\f\245\377~\253\a\006\234\0204_\240\377\261\265\"\256\030\212\354\224\034\267H\'\320\340\276\251<\310\257s.\335\240\000\230\320\256\334k9\302\005\372\330\360Sk\350\'<5V\022>\244\355\375T\372\372\201)\372n\036\2413\253\233\245\351\316\364\321\322rm\232\316\306cjtF`\332\350\321\304Ig\'\025%\033=#\322\020R\203*\327\352L\352DD\256J\224\213\030+\354\311\026C\367\212}\312\b{|\360c\2622\267\017\200\273\016\372`p\206\005x\233Z\261d\245\257\371\006\213\256\\\240\352VK\024Z\314\271\363\326O:6M\361{@\222\030I\363\271+\030\252\340\021)\202\366\306\375\373\356\a\031\031\345\341QM\316\272\336\351=\272\002\313\341&3\"4sZ\272b\204\230\233\310\221\372\257f\222Pt\3601~\226,\240\230WUo\224\206K\250l\251b\'\324g\3256\3327\301\302\267\307B[Vy-/\361\344\022\216\362\375s+\036Z\337|\021=\200/\264\330G\367Uc]\v@\b\225\316\000\376\203\263x\203I\316\231m3\221\303\022\264!E\313`\314\260\364\220d\216v4\367\324\311\334\025\301\363\343S\370\364\220\037\227Q\026\326\364\316V\n\004d~\005p\322yH!\201\364\335\371\332\243S}k{u\006\001\305\264O\266\0304\255\016h\241\016j\336\2269 \020\334\203\3259\361d\204\257\a\261\214NU\320\016\241C\r\375O\302\376\353\303\350\337\024z\344.\233=\\{\347\356Py\374\341W\204%*e\254\201\023\366\274\231\315\001\372\331@,A\002\306\313!L\374\210\370Q\340\215b\261\207\266\337s\366\277\326\342A\000\303\222\b\312|\ve\222\006\317(\330\350\377\345\243Y\2128\250\323\\\366\000\213\374\362\240\311U\372\371\020\253\226\346\3200\226\300r\267$\364\231\350\353\346\377\344\210\r\335\242a\304\fNW\215JZ\205#w\253nA\332\214U\321h.\a\242\272\263\304\3239P\327\364\272\235"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15288952640661382750"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import crypto from \'crypto\';\\nimport type Database from \'better-sqlite3\';\\nimport type {\\n  ActivityDetail,\\n  ActivityRubricCriterion,\\n  ActivityStatus,\\n  ActivityStep,\\n  ActivitySummary,\\n  AdminOverviewResponse,\\n  AgeGroup,\\n  ChildProfile,\\n  CompletionStatus,\\n  DomainProgressStat,\\n  JourneyActivityItem,\\n  LearningDomain,\\n  LocaleCode,\\n  MediaAuditAction,\\n  MediaAuditLogItem,\\n  ReviewerQueueItem,\\n  ReviewerSubmissionDetail,\\n  RubricAchievementLevel,\\n  SubmissionReviewDetail,\\n  SubmissionReviewStatus,\\n  UserProfile,\\n  UserRole,\\n  VideoSubmissionSummary,\\n} from \'../../src/shared/types\';\\nimport {\\n  calculateAgeInMonths,\\n  getRubricMultiplier,\\n  resolveAgeGroupSlug,\\n} from \'../../src/shared/domain\';\\n\\ninterface UserRow {\\n  id: string;\\n  email: string;\\n  password_hash: string;\\n  full_name: string;\\n  phone_number: string | null;\\n  role: UserRole;\\n  preferred_locale: LocaleCode;\\n  is_active: number;\\n  created_at: string;\\n}\\n\\nfunction mapUser(row: UserRow): UserProfile {\\n  return {\\n    id: row.id,\\n    email: row.email,\\n    fullName: row.full_name,\\n    phoneNumber: row.phone_number,\\n    role: row.role,\\n    preferredLocale: row.preferred_locale,\\n    isActive: row.is_active === 1,\\n    createdAt: row.created_at,\\n  };\\n}\\n\\nexport class LittleStepsRepository {\\n  constructor(private readonly db: Database.Database) {}\\n\\n  // ======================== USERS & CONSENT ========================\\n\\n  findUserByEmail(email: string): (UserProfile & { passwordHash: string }) | null {\\n    const row = this.db\\n      .prepare(\'SELECT * FROM users WHERE email = ?\')\\n      .get(email.trim().toLowerCase()) as UserRow | undefined;\\n    if (!row) return null;\\n    return { ...mapUser(row), passwordHash: row.password_hash };\\n  }\\n\\n  findUserById(id: string): UserProfile | null {\\n    const row = this.db.prepare(\'SELECT * FROM users WHERE id = ?\').get(id) as UserRow | undefined;\\n    return row ? mapUser(row) : null;\\n  }\\n\\n  createUser(params: {\\n    email: string;\\n    passwordHash: string;\\n    fullName: string;\\n    phoneNumber: string | null;\\n    role: UserRole;\\n    preferredLocale: LocaleCode;\\n    ipHash: string;\\n  }): UserProfile {\\n    const id = `usr_${crypto.randomUUID().slice(0, 12)}`;\\n    const tx = this.db.transaction(() => {\\n      this.db\\n        .prepare(\\n          `INSERT INTO users (id, email, password_hash, full_name, phone_number, role, preferred_locale)\\n           VALUES (?, ?, ?, ?, ?, ?, ?)`\\n        )\\n        .run(\\n          id,\\n          params.email.trim().toLowerCase(),\\n          params.passwordHash,\\n          params.fullName.trim(),\\n          params.phoneNumber?.trim() || null,\\n          params.role,\\n          params.preferredLocale\\n        );\\n      this.db\\n        .prepare(\\n          `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n           VALUES (?, ?, \'privacy_policy\', \'v1.0\', ?)`\\n        )\\n        .run(crypto.randomUUID(), id, params.ipHash);\\n    });\\n    tx();\\n    return this.findUserById(id)!;\\n  }\\n\\n  recordUserConsent(\\n    userId: string,\\n    consentType: \'video_processing\' | \'privacy_policy\' | \'child_data\',\\n    ipHash: string\\n  ): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n         VALUES (?, ?, ?, \'v1.0\', ?)`\\n      )\\n      .run(crypto.randomUUID(), userId, consentType, ipHash);\\n  }\\n\\n  listAllUsers(): UserProfile[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM users ORDER BY created_at DESC\')\\n      .all() as UserRow[];\\n    return rows.map(mapUser);\\n  }\\n\\n  updateUserRoleAndStatus(\\n    userId: string,\\n    updates: { role?: UserRole; isActive?: boolean }\\n  ): UserProfile | null {\\n    const existing = this.findUserById(userId);\\n    if (!existing) return null;\\n    const nextRole = updates.role ?? existing.role;\\n    const nextActive = updates.isActive !== undefined ? (updates.isActive ? 1 : 0) : existing.isActive ? 1 : 0;\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET role = ?, is_active = ?, updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(nextRole, nextActive, userId);\\n    return this.findUserById(userId);\\n  }\\n\\n  // ======================== META: AGE GROUPS & DOMAINS ========================\\n\\n  listAgeGroups(): AgeGroup[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM age_groups ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      label: string;\\n      min_months: number;\\n      max_months: number;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  findAgeGroupBySlug(slug: string): AgeGroup | null {\\n    const r = this.db.prepare(\'SELECT * FROM age_groups WHERE slug = ?\').get(slug) as\\n      | {\\n          id: string;\\n          slug: string;\\n          label: string;\\n          min_months: number;\\n          max_months: number;\\n          sort_order: number;\\n        }\\n      | undefined;\\n    if (!r) return null;\\n    return {\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    };\\n  }\\n\\n  listLearningDomains(): LearningDomain[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM learning_domains ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      name: string;\\n      description: string;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      name: r.name,\\n      description: r.description,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  // ======================== CHILDREN ========================\\n\\n  listChildrenByParent(parentUserId: string): ChildProfile[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT c.*, ag.label as age_group_label, ag.slug as age_group_slug\\n         FROM children c\\n         JOIN age_groups ag ON ag.id = c.active_age_group_id\\n         WHERE c.parent_user_id = ?\\n         ORDER BY c.created_at ASC`\\n      )\\n      .all(parentUserId) as Array<{\\n      id: string;\\n      parent_user_id: string;\\n      display_name: string;\\n      date_of_birth: string;\\n      active_age_group_id: string;\\n      age_group_label: string;\\n      age_group_slug: string;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => {\\n      const ageMonths = calculateAgeInMonths(r.date_of_birth);\\n      const currentSlug = resolveAgeGroupSlug(ageMonths);\\n      // Keep child\'s age band automatically synced as baby grows\\n      let activeAgeGroupId = r.active_age_group_id;\\n      let ageGroupLabel = r.age_group_label;\\n      let ageGroupSlug = r.age_group_slug;\\n      if (currentSlug !== r.age_group_slug) {\\n        const freshGroup = this.findAgeGroupBySlug(currentSlug);\\n        if (freshGroup) {\\n          this.db\\n            .prepare(\'UPDATE children SET active_age_group_id = ? WHERE id = ?\')\\n            .run(freshGroup.id, r.id);\\n          activeAgeGroupId = freshGroup.id;\\n          ageGroupLabel = freshGroup.label;\\n          ageGroupSlug = freshGroup.slug;\\n        }\\n      }\\n      return {\\n        id: r.id,\\n        parentUserId: r.parent_user_id,\\n        displayName: r.display_name,\\n        dateOfBirth: r.date_of_birth,\\n        activeAgeGroupId,\\n        ageGroupLabel,\\n        ageGroupSlug,\\n        ageInMonths: ageMonths,\\n        createdAt: r.created_at,\\n      };\\n    });\\n  }\\n\\n  findChildByIdForParent(childId: string, parentUserId: string): ChildProfile | null {\\n    const children = this.listChildrenByParent(parentUserId);\\n    return children.find((c) => c.id === childId) ?? null;\\n  }\\n\\n  createChild(parentUserId: string, displayName: string, dateOfBirth: string): ChildProfile {\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const slug = resolveAgeGroupSlug(ageMonths);\\n    const ageGroup = this.findAgeGroupBySlug(slug);\\n    if (!ageGroup) {\\n      throw new Error(\'Could not resolve age group\');\\n    }\\n    const id = `ch_${crypto.randomUUID().slice(0, 10)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO children (id, parent_user_id, display_name, date_of_birth, active_age_group_id)\\n         VALUES (?, ?, ?, ?, ?)`\\n      )\\n      .run(id, parentUserId, displayName.trim(), dateOfBirth, ageGroup.id);\\n    return this.findChildByIdForParent(id, parentUserId)!;\\n  }\\n\\n  updateChild(\\n    childId: string,\\n    parentUserId: string,\\n    displayName: string,\\n    dateOfBirth: string\\n  ): ChildProfile | null {\\n    const existing = this.findChildByIdForParent(childId, parentUserId);\\n    if (!existing) return null;\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const ageGroup = this.findAgeGroupBySlug(resolveAgeGroupSlug(ageMonths))!;\\n    this.db\\n      .prepare(\\n        `UPDATE children\\n         SET display_name = ?, date_of_birth = ?, active_age_group_id = ?,\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ? AND parent_user_id = ?`\\n      )\\n      .run(displayName.trim(), dateOfBirth, ageGroup.id, childId, parentUserId);\\n    return this.findChildByIdForParent(childId, parentUserId);\\n  }\\n\\n  deleteChild(childId: string, parentUserId: string): boolean {\\n    const res = this.db\\n      .prepare(\'DELETE FROM children WHERE id = ? AND parent_user_id = ?\')\\n      .run(childId, parentUserId);\\n    return res.changes > 0;\\n  }\\n\\n  // ======================== CURRICULUM & ACTIVITIES ========================\\n\\n  listActivities(filters?: {\\n    ageGroupId?: string;\\n    domainId?: string;\\n    status?: ActivityStatus;\\n  }): ActivitySummary[] {\\n    const conditions: string[] = [];\\n    const params: unknown[] = [];\\n    if (filters?.ageGroupId) {\\n      conditions.push(\'a.age_group_id = ?\');\\n      params.push(filters.ageGroupId);\\n    }\\n    if (filters?.domainId) {\\n      conditions.push(\'a.domain_id = ?\');\\n      params.push(filters.domainId);\\n    }\\n    if (filters?.status) {\\n      conditions.push(\'a.status = ?\');\\n      params.push(filters.status);\\n    }\\n    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\' AND \')}` : \'\';\\n    const rows = this.db\\n      .prepare(\\n        `SELECT a.*, ag.slug as age_group_slug, ag.label as age_group_label,\\n                ld.slug as domain_slug, ld.name as domain_name\\n         FROM activities a\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         ${whereClause}\\n         ORDER BY ag.sort_order ASC, ld.sort_order ASC, a.created_at DESC`\\n      )\\n      .all(...params) as Array<{\\n      id: string;\\n      age_group_id: string;\\n      age_group_slug: string;\\n      age_group_label: string;\\n      domain_id: string;\\n      domain_slug: string;\\n      domain_name: string;\\n      title: string;\\n      summary: string;\\n      duration_minutes: number;\\n      materials_json: string;\\n      safety_notes: string;\\n      instructional_poster_url: string;\\n      status: ActivityStatus;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      ageGroupId: r.age_group_id,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      domainId: r.domain_id,\\n      domainSlug: r.domain_slug,\\n      domainName: r.domain_name,\\n      title: r.title,\\n      summary: r.summary,\\n      durationMinutes: r.duration_minutes,\\n      materials: JSON.parse(r.materials_json) as string[],\\n      safetyNotes: r.safety_notes,\\n      instructionalPosterUrl: r.instructional_poster_url,\\n      status: r.status,\\n      createdAt: r.created_at,\\n    }));\\n  }\\n\\n  getActivityDetail(activityId: string): ActivityDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT a.*, ag.slug as age_group_slug, ag.label as age_group_label,\\n                ld.slug as domain_slug, ld.name as domain_name\\n         FROM activities a\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         WHERE a.id = ?`\\n      )\\n      .get(activityId) as\\n      | {\\n          id: string;\\n          age_group_id: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          domain_id: string;\\n          domain_slug: string;\\n          domain_name: string;\\n          title: string;\\n          summary: string;\\n          duration_minutes: number;\\n          materials_json: string;\\n          safety_notes: string;\\n          instructional_poster_url: string;\\n          status: ActivityStatus;\\n          created_at: string;\\n        }\\n      | undefined;\\n    if (!row) return null;\\n\\n    const steps = (\\n      this.db\\n        .prepare(\'SELECT * FROM activity_steps WHERE activity_id = ? ORDER BY step_number ASC\')\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        step_number: number;\\n        title: string;\\n        instruction_text: string;\\n        caregiver_tip: string | null;\\n      }>\\n    ).map<ActivityStep>((s) => ({\\n      id: s.id,\\n      activityId: s.activity_id,\\n      stepNumber: s.step_number,\\n      title: s.title,\\n      instructionText: s.instruction_text,\\n      caregiverTip: s.caregiver_tip,\\n    }));\\n\\n    const rubricCriteria = (\\n      this.db\\n        .prepare(\\n          \'SELECT * FROM activity_rubric_criteria WHERE activity_id = ? ORDER BY criterion_order ASC\'\\n        )\\n        .all(activityId) as Array<{\\n        id: string;\\n        activity_id: string;\\n        criterion_order: number;\\n        label: string;\\n        description: string;\\n        weight_points: number;\\n      }>\\n    ).map<ActivityRubricCriterion>((c) => ({\\n      id: c.id,\\n      activityId: c.activity_id,\\n      criterionOrder: c.criterion_order,\\n      label: c.label,\\n      description: c.description,\\n      weightPoints: c.weight_points,\\n    }));\\n\\n    return {\\n      id: row.id,\\n      ageGroupId: row.age_group_id,\\n      ageGroupSlug: row.age_group_slug,\\n      ageGroupLabel: row.age_group_label,\\n      domainId: row.domain_id,\\n      domainSlug: row.domain_slug,\\n      domainName: row.domain_name,\\n      title: row.title,\\n      summary: row.summary,\\n      durationMinutes: row.duration_minutes,\\n      materials: JSON.parse(row.materials_json) as string[],\\n      safetyNotes: row.safety_notes,\\n      instructionalPosterUrl: row.instructional_poster_url,\\n      status: row.status,\\n      createdAt: row.created_at,\\n      steps,\\n      rubricCriteria,\\n    };\\n  }\\n\\n  saveActivity(\\n    createdBy: string,\\n    payload: {\\n      id?: string;\\n      ageGroupId: string;\\n      domainId: string;\\n      title: string;\\n      summary: string;\\n      durationMinutes: number;\\n      materials: string[];\\n      safetyNotes: string;\\n      instructionalPosterUrl: string;\\n      status: ActivityStatus;\\n      steps: Array<{ title: string; instructionText: string; caregiverTip?: string | null }>;\\n      rubricCriteria: Array<{ label: string; description: string; weightPoints: number }>;\\n    }\\n  ): ActivityDetail {\\n    const activityId = payload.id || `act_${crypto.randomUUID().slice(0, 10)}`;\\n    const tx = this.db.transaction(() => {\\n      if (payload.id) {\\n        this.db\\n          .prepare(\\n            `UPDATE activities\\n             SET age_group_id = ?, domain_id = ?, title = ?, summary = ?, duration_minutes = ?,\\n                 materials_json = ?, safety_notes = ?, instructional_poster_url = ?, status = ?,\\n                 updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n             WHERE id = ?`\\n          )\\n          .run(\\n            payload.ageGroupId,\\n            payload.domainId,\\n            payload.title.trim(),\\n            payload.summary.trim(),\\n            payload.durationMinutes,\\n            JSON.stringify(payload.materials),\\n            payload.safetyNotes.trim(),\\n            payload.instructionalPosterUrl,\\n            payload.status,\\n            activityId\\n          );\\n        this.db.prepare(\'DELETE FROM activity_steps WHERE activity_id = ?\').run(activityId);\\n        // Only recreate rubric criteria if no reviews reference them; otherwise update in place when counts match\\n        const reviewRefCount = this.db\\n          .prepare(\\n            `SELECT COUNT(*) as cnt FROM review_rubric_scores rrs\\n             JOIN activity_rubric_criteria arc ON arc.id = rrs.rubric_criterion_id\\n             WHERE arc.activity_id = ?`\\n          )\\n          .get(activityId) as { cnt: number };\\n        if (reviewRefCount.cnt === 0) {\\n          this.db\\n            .prepare(\'DELETE FROM activity_rubric_criteria WHERE activity_id = ?\')\\n            .run(activityId);\\n        } else {\\n          // Preserve existing referenced criteria IDs to protect historical review integrity\\n          const existingCriteria = this.db\\n            .prepare(\\n              \'SELECT id FROM activity_rubric_criteria WHERE activity_id = ? ORDER BY criterion_order ASC\'\\n            )\\n            .all(activityId) as Array<{ id: string }>;\\n          payload.rubricCriteria.forEach((c, idx) => {\\n            if (existingCriteria[idx]) {\\n              this.db\\n                .prepare(\\n                  `UPDATE activity_rubric_criteria\\n                   SET label = ?, description = ?, weight_points = ?\\n                   WHERE id = ?`\\n                )\\n                .run(c.label.trim(), c.description.trim(), c.weightPoints, existingCriteria[idx].id);\\n            } else {\\n              this.db\\n                .prepare(\\n                  `INSERT INTO activity_rubric_criteria (id, activity_id, criterion_order, label, description, weight_points)\\n                   VALUES (?, ?, ?, ?, ?, ?)`\\n                )\\n                .run(\\n                  crypto.randomUUID(),\\n                  activityId,\\n                  idx + 1,\\n                  c.label.trim(),\\n                  c.description.trim(),\\n                  c.weightPoints\\n                );\\n            }\\n          });\\n        }\\n      } else {\\n        this.db\\n          .prepare(\\n            `INSERT INTO activities (\\n               id, age_group_id, domain_id, title, summary, duration_minutes,\\n               materials_json, safety_notes, instructional_poster_url, status, created_by\\n             ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`\\n          )\\n          .run(\\n            activityId,\\n            payload.ageGroupId,\\n            payload.domainId,\\n            payload.title.trim(),\\n            payload.summary.trim(),\\n            payload.durationMinutes,\\n            JSON.stringify(payload.materials),\\n            payload.safetyNotes.trim(),\\n            payload.instructionalPosterUrl,\\n            payload.status,\\n            createdBy\\n          );\\n      }\\n\\n      const insertStep = this.db.prepare(\\n        `INSERT INTO activity_steps (id, activity_id, step_number, title, instruction_text, caregiver_tip)\\n         VALUES (?, ?, ?, ?, ?, ?)`\\n      );\\n      payload.steps.forEach((s, idx) => {\\n        insertStep.run(\\n          crypto.randomUUID(),\\n          activityId,\\n          idx + 1,\\n          s.title.trim(),\\n          s.instructionText.trim(),\\n          s.caregiverTip?.trim() || null\\n        );\\n      });\\n\\n      const currentRubricCount = this.db\\n        .prepare(\'SELECT COUNT(*) as cnt FROM activity_rubric_criteria WHERE activity_id = ?\')\\n        .get(activityId) as { cnt: number };\\n      if (currentRubricCount.cnt === 0) {\\n        const insertRubric = this.db.prepare(\\n          `INSERT INTO activity_rubric_criteria (id, activity_id, criterion_order, label, description, weight_points)\\n           VALUES (?, ?, ?, ?, ?, ?)`\\n        );\\n        payload.rubricCriteria.forEach((c, idx) => {\\n          insertRubric.run(\\n            crypto.randomUUID(),\\n            activityId,\\n            idx + 1,\\n            c.label.trim(),\\n            c.description.trim(),\\n            c.weightPoints\\n          );\\n        });\\n      }\\n    });\\n    tx();\\n    return this.getActivityDetail(activityId)!;\\n  }\\n\\n  deleteActivity(activityId: string): boolean {\\n    const res = this.db.prepare(\'DELETE FROM activities WHERE id = ?\').run(activityId);\\n    return res.changes > 0;\\n  }\\n\\n  // ======================== DAILY PLANS & JOURNEY ========================\\n\\n  listDailyPlansForAgeGroup(ageGroupId: string): Array<{\\n    id: string;\\n    ageGroupId: string;\\n    dayNumber: number;\\n    title: string;\\n    focusNote: string;\\n    activityIds: string[];\\n  }> {\\n    const plans = this.db\\n      .prepare(\'SELECT * FROM daily_plans WHERE age_group_id = ? ORDER BY day_number ASC\')\\n      .all(ageGroupId) as Array<{\\n      id: string;\\n      age_group_id: string;\\n      day_number: number;\\n      title: string;\\n      focus_note: string;\\n    }>;\\n\\n    return plans.map((p) => {\\n      const items = this.db\\n        .prepare(\'SELECT activity_id FROM daily_plan_items WHERE daily_plan_id = ? ORDER BY sort_order ASC\')\\n        .all(p.id) as Array<{ activity_id: string }>;\\n      return {\\n        id: p.id,\\n        ageGroupId: p.age_group_id,\\n        dayNumber: p.day_number,\\n        title: p.title,\\n        focusNote: p.focus_note,\\n        activityIds: items.map((i) => i.activity_id),\\n      };\\n    });\\n  }\\n\\n  upsertDailyPlan(params: {\\n    ageGroupId: string;\\n    dayNumber: number;\\n    title: string;\\n    focusNote: string;\\n    activityIds: string[];\\n  }): void {\\n    const tx = this.db.transaction(() => {\\n      const existing = this.db\\n        .prepare(\'SELECT id FROM daily_plans WHERE age_group_id = ? AND day_number = ?\')\\n        .get(params.ageGroupId, params.dayNumber) as { id: string } | undefined;\\n\\n      const planId = existing ? existing.id : `plan_${crypto.randomUUID().slice(0, 10)}`;\\n      if (existing) {\\n        this.db\\n          .prepare(\'UPDATE daily_plans SET title = ?, focus_note = ? WHERE id = ?\')\\n          .run(params.title.trim(), params.focusNote.trim(), planId);\\n        this.db.prepare(\'DELETE FROM daily_plan_items WHERE daily_plan_id = ?\').run(planId);\\n      } else {\\n        this.db\\n          .prepare(\\n            \'INSERT INTO daily_plans (id, age_group_id, day_number, title, focus_note) VALUES (?, ?, ?, ?, ?)\'\\n          )\\n          .run(planId, params.ageGroupId, params.dayNumber, params.title.trim(), params.focusNote.trim());\\n      }\\n\\n      const insertItem = this.db.prepare(\\n        \'INSERT INTO daily_plan_items (id, daily_plan_id, activity_id, sort_order) VALUES (?, ?, ?, ?)\'\\n      );\\n      params.activityIds.forEach((actId, idx) => {\\n        insertItem.run(crypto.randomUUID(), planId, actId, idx + 1);\\n      });\\n    });\\n    tx();\\n  }\\n\\n  getJourneyForChild(child: ChildProfile, requestedDayNumber?: number) {\\n    const plans = this.listDailyPlansForAgeGroup(child.activeAgeGroupId);\\n    const availableDays = plans.map((p) => ({\\n      dayNumber: p.dayNumber,\\n      title: p.title,\\n      focusNote: p.focusNote,\\n    }));\\n\\n    const selectedPlan =\\n      plans.find((p) => p.dayNumber === requestedDayNumber) ??\\n      plans[0] ?? {\\n        id: \'fallback\',\\n        ageGroupId: child.activeAgeGroupId,\\n        dayNumber: 1,\\n        title: \'Day 1 \302\267 Calm Discovery\',\\n        focusNote: \'Gentle, age-appropriate activities for today.\',\\n        activityIds: this.listActivities({\\n          ageGroupId: child.activeAgeGroupId,\\n          status: \'published\',\\n        })\\n          .slice(0, 3)\\n          .map((a) => a.id),\\n      };\\n\\n    const items: JourneyActivityItem[] = [];\\n    selectedPlan.activityIds.forEach((actId, idx) => {\\n      const activity = this.getActivityDetail(actId);\\n      if (!activity || activity.status !== \'published\') return;\\n\\n      const comp = this.db\\n        .prepare(\\n          `SELECT id, status, caregiver_notes, completed_at\\n           FROM activity_completions\\n           WHERE child_id = ? AND activity_id = ?\\n           ORDER BY created_at DESC LIMIT 1`\\n        )\\n        .get(child.id, actId) as\\n        | {\\n            id: string;\\n            status: CompletionStatus;\\n            caregiver_notes: string | null;\\n            completed_at: string | null;\\n          }\\n        | undefined;\\n\\n      const latestSubmission = this.findLatestSubmissionForChildActivity(child.id, actId);\\n\\n      items.push({\\n        planItemId: `${selectedPlan.id}_${actId}`,\\n        sortOrder: idx + 1,\\n        activity,\\n        completion: comp\\n          ? {\\n              id: comp.id,\\n              status: comp.status,\\n              caregiverNotes: comp.caregiver_notes,\\n              completedAt: comp.completed_at,\\n            }\\n          : null,\\n        latestSubmission,\\n      });\\n    });\\n\\n    const domainProgress = this.getDomainProgressForChild(child.id);\\n    const recentSubmissions = this.listSubmissionsForChild(child.id);\\n\\n    return {\\n      child,\\n      availableDays,\\n      selectedDay: {\\n        id: selectedPlan.id,\\n        dayNumber: selectedPlan.dayNumber,\\n        title: selectedPlan.title,\\n        focusNote: selectedPlan.focusNote,\\n      },\\n      items,\\n      domainProgress,\\n      recentSubmissions,\\n    };\\n  }\\n\\n  getDomainProgressForChild(childId: string): DomainProgressStat[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT ld.id, ld.slug, ld.name, COUNT(ac.id) as completed_count\\n         FROM learning_domains ld\\n         LEFT JOIN activities a ON a.domain_id = ld.id\\n         LEFT JOIN activity_completions ac\\n           ON ac.activity_id = a.id\\n           AND ac.child_id = ?\\n           AND ac.status IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n         GROUP BY ld.id\\n         ORDER BY ld.sort_order ASC`\\n      )\\n      .all(childId) as Array<{\\n      id: string;\\n      slug: string;\\n      name: string;\\n      completed_count: number;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      domainId: r.id,\\n      domainSlug: r.slug,\\n      domainName: r.name,\\n      completedCount: r.completed_count,\\n    }));\\n  }\\n\\n  upsertActivityCompletion(params: {\\n    childId: string;\\n    activityId: string;\\n    status: CompletionStatus;\\n    caregiverNotes?: string | null;\\n  }): { id: string; status: CompletionStatus } {\\n    const planDate = new Date().toISOString().slice(0, 10);\\n    const existing = this.db\\n      .prepare(\\n        \'SELECT id FROM activity_completions WHERE child_id = ? AND activity_id = ? AND plan_date = ?\'\\n      )\\n      .get(params.childId, params.activityId, planDate) as { id: string } | undefined;\\n\\n    if (existing) {\\n      this.db\\n        .prepare(\\n          `UPDATE activity_completions\\n           SET status = ?, caregiver_notes = COALESCE(?, caregiver_notes),\\n               completed_at = CASE WHEN ? IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n                                   THEN COALESCE(completed_at, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n                                   ELSE completed_at END\\n           WHERE id = ?`\\n        )\\n        .run(params.status, params.caregiverNotes ?? null, params.status, existing.id);\\n      return { id: existing.id, status: params.status };\\n    }\\n\\n    const id = `comp_${crypto.randomUUID().slice(0, 10)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO activity_completions (id, child_id, activity_id, plan_date, status, caregiver_notes, completed_at)\\n         VALUES (?, ?, ?, ?, ?, ?, CASE WHEN ? IN (\'completed\', \'submitted_for_review\', \'reviewed\')\\n                                        THEN strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\') ELSE NULL END)`\\n      )\\n      .run(\\n        id,\\n        params.childId,\\n        params.activityId,\\n        planDate,\\n        params.status,\\n        params.caregiverNotes?.trim() || null,\\n        params.status\\n      );\\n    return { id, status: params.status };\\n  }\\n\\n  // ======================== VIDEO SUBMISSIONS & REVIEWS ========================\\n\\n  getReviewDetailForSubmission(submissionId: string): SubmissionReviewDetail | null {\\n    const rev = this.db\\n      .prepare(\\n        `SELECT sr.*, u.full_name as reviewer_name\\n         FROM submission_reviews sr\\n         JOIN users u ON u.id = sr.reviewer_user_id\\n         WHERE sr.submission_id = ?`\\n      )\\n      .get(submissionId) as\\n      | {\\n          id: string;\\n          submission_id: string;\\n          reviewer_user_id: string;\\n          reviewer_name: string;\\n          instruction_match_score_pct: number;\\n          strengths_note: string;\\n          coaching_tip: string;\\n          evaluation_scope_acknowledged_at: string;\\n          submitted_at: string;\\n        }\\n      | undefined;\\n\\n    if (!rev) return null;\\n\\n    const scoreRows = this.db\\n      .prepare(\\n        `SELECT rrs.*, arc.label as criterion_label, arc.description as criterion_description\\n         FROM review_rubric_scores rrs\\n         JOIN activity_rubric_criteria arc ON arc.id = rrs.rubric_criterion_id\\n         WHERE rrs.review_id = ?\\n         ORDER BY arc.criterion_order ASC`\\n      )\\n      .all(rev.id) as Array<{\\n      id: string;\\n      rubric_criterion_id: string;\\n      criterion_label: string;\\n      criterion_description: string;\\n      achieved_level: RubricAchievementLevel;\\n      earned_points: number;\\n      max_points: number;\\n    }>;\\n\\n    return {\\n      id: rev.id,\\n      submissionId: rev.submission_id,\\n      reviewerUserId: rev.reviewer_user_id,\\n      reviewerName: rev.reviewer_name,\\n      instructionMatchScorePct: rev.instruction_match_score_pct,\\n      strengthsNote: rev.strengths_note,\\n      coachingTip: rev.coaching_tip,\\n      evaluationScopeAcknowledgedAt: rev.evaluation_scope_acknowledged_at,\\n      submittedAt: rev.submitted_at,\\n      rubricScores: scoreRows.map((s) => ({\\n        id: s.id,\\n        criterionId: s.rubric_criterion_id,\\n        criterionLabel: s.criterion_label,\\n        criterionDescription: s.criterion_description,\\n        achievedLevel: s.achieved_level,\\n        earnedPoints: s.earned_points,\\n        maxPoints: s.max_points,\\n      })),\\n    };\\n  }\\n\\n  private mapSubmissionRow(row: {\\n    id: string;\\n    completion_id: string;\\n    child_id: string;\\n    activity_id: string;\\n    activity_title: string;\\n    domain_name: string;\\n    age_group_label: string;\\n    storage_key: string | null;\\n    mime_type: string;\\n    file_size_bytes: number;\\n    duration_seconds: number;\\n    review_status: SubmissionReviewStatus;\\n    expires_at: string;\\n    deleted_at: string | null;\\n    deletion_reason: string | null;\\n    caregiver_notes: string | null;\\n    created_at: string;\\n  }): VideoSubmissionSummary {\\n    return {\\n      id: row.id,\\n      completionId: row.completion_id,\\n      childId: row.child_id,\\n      activityId: row.activity_id,\\n      activityTitle: row.activity_title,\\n      domainName: row.domain_name,\\n      ageGroupLabel: row.age_group_label,\\n      mimeType: row.mime_type,\\n      fileSizeBytes: row.file_size_bytes,\\n      durationSeconds: row.duration_seconds,\\n      reviewStatus: row.review_status,\\n      hasActiveVideo: Boolean(row.storage_key && !row.deleted_at),\\n      expiresAt: row.expires_at,\\n      deletedAt: row.deleted_at,\\n      deletionReason: row.deletion_reason,\\n      caregiverNotes: row.caregiver_notes,\\n      createdAt: row.created_at,\\n      review: this.getReviewDetailForSubmission(row.id),\\n    };\\n  }\\n\\n  findLatestSubmissionForChildActivity(\\n    childId: string,\\n    activityId: string\\n  ): VideoSubmissionSummary | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT vs.*, a.title as activity_title, ld.name as domain_name, ag.label as age_group_label\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         WHERE vs.child_id = ? AND vs.activity_id = ?\\n         ORDER BY vs.created_at DESC LIMIT 1`\\n      )\\n      .get(childId, activityId) as Parameters<LittleStepsRepository[\'mapSubmissionRow\']>[0] | undefined;\\n    return row ? this.mapSubmissionRow(row) : null;\\n  }\\n\\n  listSubmissionsForChild(childId: string): VideoSubmissionSummary[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT vs.*, a.title as activity_title, ld.name as domain_name, ag.label as age_group_label\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         WHERE vs.child_id = ?\\n         ORDER BY vs.created_at DESC`\\n      )\\n      .all(childId) as Array<Parameters<LittleStepsRepository[\'mapSubmissionRow\']>[0]>;\\n    return rows.map((r) => this.mapSubmissionRow(r));\\n  }\\n\\n  findSubmissionRawById(submissionId: string): {\\n    id: string;\\n    completion_id: string;\\n    parent_user_id: string;\\n    child_id: string;\\n    activity_id: string;\\n    storage_key: string | null;\\n    mime_type: string;\\n    file_size_bytes: number;\\n    duration_seconds: number;\\n    review_status: SubmissionReviewStatus;\\n    assigned_reviewer_id: string | null;\\n    caregiver_notes: string | null;\\n    expires_at: string;\\n    deleted_at: string | null;\\n    deletion_reason: string | null;\\n    created_at: string;\\n  } | null {\\n    const row = this.db\\n      .prepare(\'SELECT * FROM video_submissions WHERE id = ?\')\\n      .get(submissionId) as ReturnType<LittleStepsRepository[\'findSubmissionRawById\']>;\\n    return row ?? null;\\n  }\\n\\n  createVideoSubmission(params: {\\n    completionId: string;\\n    parentUserId: string;\\n    childId: string;\\n    activityId: string;\\n    storageKey: string;\\n    mimeType: string;\\n    fileSizeBytes: number;\\n    durationSeconds: number;\\n    caregiverNotes: string | null;\\n    expiresAt: string;\\n  }): VideoSubmissionSummary {\\n    const id = `sub_${crypto.randomUUID().slice(0, 12)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO video_submissions (\\n           id, completion_id, parent_user_id, child_id, activity_id,\\n           storage_key, mime_type, file_size_bytes, duration_seconds,\\n           review_status, caregiver_notes, expires_at\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, \'queued\', ?, ?)`\\n      )\\n      .run(\\n        id,\\n        params.completionId,\\n        params.parentUserId,\\n        params.childId,\\n        params.activityId,\\n        params.storageKey,\\n        params.mimeType,\\n        params.fileSizeBytes,\\n        params.durationSeconds,\\n        params.caregiverNotes?.trim() || null,\\n        params.expiresAt\\n      );\\n    this.logMediaAudit(params.parentUserId, \'parent\', id, \'upload\');\\n    return this.findLatestSubmissionForChildActivity(params.childId, params.activityId)!;\\n  }\\n\\n  markSubmissionVideoDeleted(\\n    submissionId: string,\\n    deletionReason: \'parent_deleted\' | \'admin_deleted\' | \'retention_30d\'\\n  ): void {\\n    this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET storage_key = NULL,\\n             deleted_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'),\\n             deletion_reason = ?,\\n             review_status = CASE WHEN review_status = \'reviewed\' THEN \'reviewed\' ELSE \'deleted\' END\\n         WHERE id = ?`\\n      )\\n      .run(deletionReason, submissionId);\\n  }\\n\\n  listExpiredActiveSubmissions(): Array<{ id: string; storage_key: string }> {\\n    return this.db\\n      .prepare(\\n        `SELECT id, storage_key\\n         FROM video_submissions\\n         WHERE storage_key IS NOT NULL\\n           AND deleted_at IS NULL\\n           AND expires_at <= strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')`\\n      )\\n      .all() as Array<{ id: string; storage_key: string }>;\\n  }\\n\\n  // ======================== REVIEWER QUEUE & EVALUATION ========================\\n\\n  listReviewerQueue(filters?: {\\n    status?: SubmissionReviewStatus | \'all\';\\n    ageGroupSlug?: string;\\n  }): ReviewerQueueItem[] {\\n    const conditions: string[] = [];\\n    const params: unknown[] = [];\\n\\n    if (filters?.status && filters.status !== \'all\') {\\n      conditions.push(\'vs.review_status = ?\');\\n      params.push(filters.status);\\n    } else {\\n      conditions.push(\\\"vs.review_status != \'deleted\'\\\");\\n    }\\n\\n    if (filters?.ageGroupSlug && filters.ageGroupSlug !== \'all\') {\\n      conditions.push(\'ag.slug = ?\');\\n      params.push(filters.ageGroupSlug);\\n    }\\n\\n    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(\' AND \')}` : \'\';\\n    const rows = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.activity_id, a.title as activity_title,\\n                ld.name as domain_name, ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.duration_seconds, vs.expires_at, vs.created_at,\\n                sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         ${whereClause}\\n         ORDER BY\\n           CASE vs.review_status WHEN \'queued\' THEN 1 WHEN \'in_review\' THEN 2 ELSE 3 END ASC,\\n           vs.created_at ASC`\\n      )\\n      .all(...params) as Array<{\\n      submission_id: string;\\n      activity_id: string;\\n      activity_title: string;\\n      domain_name: string;\\n      age_group_slug: string;\\n      age_group_label: string;\\n      review_status: SubmissionReviewStatus;\\n      assigned_reviewer_id: string | null;\\n      assigned_reviewer_name: string | null;\\n      storage_key: string | null;\\n      deleted_at: string | null;\\n      duration_seconds: number;\\n      expires_at: string;\\n      created_at: string;\\n      instruction_match_score_pct: number | null;\\n    }>;\\n\\n    // Note: Intentionally omits parent email, phone, and legal names (Reviewer Data Minimization)\\n    return rows.map((r) => ({\\n      submissionId: r.submission_id,\\n      activityId: r.activity_id,\\n      activityTitle: r.activity_title,\\n      domainName: r.domain_name,\\n      ageGroupSlug: r.age_group_slug,\\n      ageGroupLabel: r.age_group_label,\\n      reviewStatus: r.review_status,\\n      assignedReviewerId: r.assigned_reviewer_id,\\n      assignedReviewerName: r.assigned_reviewer_name,\\n      hasActiveVideo: Boolean(r.storage_key && !r.deleted_at),\\n      durationSeconds: r.duration_seconds,\\n      expiresAt: r.expires_at,\\n      createdAt: r.created_at,\\n      instructionMatchScorePct: r.instruction_match_score_pct,\\n    }));\\n  }\\n\\n  claimSubmissionForReviewer(submissionId: string, reviewerId: string): boolean {\\n    const res = this.db\\n      .prepare(\\n        `UPDATE video_submissions\\n         SET assigned_reviewer_id = ?,\\n             review_status = CASE WHEN review_status = \'queued\' THEN \'in_review\' ELSE review_status END\\n         WHERE id = ?\\n           AND (assigned_reviewer_id IS NULL OR assigned_reviewer_id = ?)\\n           AND review_status IN (\'queued\', \'in_review\')`\\n      )\\n      .run(reviewerId, submissionId, reviewerId);\\n    if (res.changes > 0) {\\n      this.logMediaAudit(reviewerId, \'reviewer\', submissionId, \'review_open\');\\n    }\\n    return res.changes > 0;\\n  }\\n\\n  getReviewerSubmissionDetail(submissionId: string): ReviewerSubmissionDetail | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT vs.id as submission_id, vs.activity_id, a.title as activity_title,\\n                ld.name as domain_name, ag.slug as age_group_slug, ag.label as age_group_label,\\n                vs.review_status, vs.assigned_reviewer_id, u.full_name as assigned_reviewer_name,\\n                vs.storage_key, vs.deleted_at, vs.deletion_reason, vs.duration_seconds,\\n                vs.caregiver_notes, vs.expires_at, vs.created_at,\\n                sr.instruction_match_score_pct\\n         FROM video_submissions vs\\n         JOIN activities a ON a.id = vs.activity_id\\n         JOIN learning_domains ld ON ld.id = a.domain_id\\n         JOIN age_groups ag ON ag.id = a.age_group_id\\n         LEFT JOIN users u ON u.id = vs.assigned_reviewer_id\\n         LEFT JOIN submission_reviews sr ON sr.submission_id = vs.id\\n         WHERE vs.id = ?`\\n      )\\n      .get(submissionId) as\\n      | {\\n          submission_id: string;\\n          activity_id: string;\\n          activity_title: string;\\n          domain_name: string;\\n          age_group_slug: string;\\n          age_group_label: string;\\n          review_status: SubmissionReviewStatus;\\n          assigned_reviewer_id: string | null;\\n          assigned_reviewer_name: string | null;\\n          storage_key: string | null;\\n          deleted_at: string | null;\\n          deletion_reason: string | null;\\n          duration_seconds: number;\\n          caregiver_notes: string | null;\\n          expires_at: string;\\n          created_at: string;\\n          instruction_match_score_pct: number | null;\\n        }\\n      | undefined;\\n\\n    if (!row) return null;\\n    const activity = this.getActivityDetail(row.activity_id);\\n    if (!activity) return null;\\n\\n    return {\\n      submission: {\\n        submissionId: row.submission_id,\\n        activityId: row.activity_id,\\n        activityTitle: row.activity_title,\\n        domainName: row.domain_name,\\n        ageGroupSlug: row.age_group_slug,\\n        ageGroupLabel: row.age_group_label,\\n        reviewStatus: row.review_status,\\n        assignedReviewerId: row.assigned_reviewer_id,\\n        assignedReviewerName: row.assigned_reviewer_name,\\n        hasActiveVideo: Boolean(row.storage_key && !row.deleted_at),\\n        durationSeconds: row.duration_seconds,\\n        expiresAt: row.expires_at,\\n        createdAt: row.created_at,\\n        instructionMatchScorePct: row.instruction_match_score_pct,\\n        caregiverNotes: row.caregiver_notes,\\n        deletedAt: row.deleted_at,\\n        deletionReason: row.deletion_reason,\\n      },\\n      activity,\\n      review: this.getReviewDetailForSubmission(submissionId),\\n    };\\n  }\\n\\n  submitRubricReview(params: {\\n    submissionId: string;\\n    reviewerUserId: string;\\n    strengthsNote: string;\\n    coachingTip: string;\\n    criterionRatings: Array<{ criterionId: string; achievedLevel: RubricAchievementLevel }>;\\n  }): SubmissionReviewDetail {\\n    const rawSub = this.findSubmissionRawById(params.submissionId);\\n    if (!rawSub) {\\n      throw new Error(\'Submission not found\');\\n    }\\n    const activity = this.getActivityDetail(rawSub.activity_id);\\n    if (!activity) {\\n      throw new Error(\'Activity not found\');\\n    }\\n\\n    const criteriaById = new Map(activity.rubricCriteria.map((c) => [c.id, c]));\\n    let earnedTotal = 0;\\n    let maxTotal = 0;\\n\\n    const computedScores = activity.rubricCriteria.map((criterion) => {\\n      const match = params.criterionRatings.find((r) => r.criterionId === criterion.id);\\n      if (!match || !criteriaById.has(criterion.id)) {\\n        throw new Error(`Missing rubric rating for \\\"${criterion.label}\\\"`);\\n      }\\n      const earned = criterion.weightPoints * getRubricMultiplier(match.achievedLevel);\\n      earnedTotal += earned;\\n      maxTotal += criterion.weightPoints;\\n      return {\\n        criterionId: criterion.id,\\n        achievedLevel: match.achievedLevel,\\n        earnedPoints: earned,\\n        maxPoints: criterion.weightPoints,\\n      };\\n    });\\n\\n    const scorePct = maxTotal > 0 ? Math.round((earnedTotal / maxTotal) * 100) : 0;\\n    const nowIso = new Date().toISOString();\\n\\n    const tx = this.db.transaction(() => {\\n      const existingRev = this.db\\n        .prepare(\'SELECT id FROM submission_reviews WHERE submission_id = ?\')\\n        .get(params.submissionId) as { id: string } | undefined;\\n\\n      const reviewId = existingRev ? existingRev.id : `rev_${crypto.randomUUID().slice(0, 10)}`;\\n\\n      if (existingRev) {\\n        this.db\\n          .prepare(\\n            `UPDATE submission_reviews\\n             SET reviewer_user_id = ?, instruction_match_score_pct = ?,\\n                 strengths_note = ?, coaching_tip = ?,\\n                 evaluation_scope_acknowledged_at = ?, submitted_at = ?\\n             WHERE id = ?`\\n          )\\n          .run(\\n            params.reviewerUserId,\\n            scorePct,\\n            params.strengthsNote.trim(),\\n            params.coachingTip.trim(),\\n            nowIso,\\n            nowIso,\\n            reviewId\\n          );\\n        this.db.prepare(\'DELETE FROM review_rubric_scores WHERE review_id = ?\').run(reviewId);\\n      } else {\\n        this.db\\n          .prepare(\\n            `INSERT INTO submission_reviews (\\n               id, submission_id, reviewer_user_id, instruction_match_score_pct,\\n               strengths_note, coaching_tip, evaluation_scope_acknowledged_at, submitted_at\\n             ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`\\n          )\\n          .run(\\n            reviewId,\\n            params.submissionId,\\n            params.reviewerUserId,\\n            scorePct,\\n            params.strengthsNote.trim(),\\n            params.coachingTip.trim(),\\n            nowIso,\\n            nowIso\\n          );\\n      }\\n\\n      const insertScore = this.db.prepare(\\n        `INSERT INTO review_rubric_scores (id, review_id, rubric_criterion_id, achieved_level, earned_points, max_points)\\n         VALUES (?, ?, ?, ?, ?, ?)`\\n      );\\n      for (const s of computedScores) {\\n        insertScore.run(\\n          crypto.randomUUID(),\\n          reviewId,\\n          s.criterionId,\\n          s.achievedLevel,\\n          s.earnedPoints,\\n          s.maxPoints\\n        );\\n      }\\n\\n      this.db\\n        .prepare(\\n          `UPDATE video_submissions\\n           SET review_status = \'reviewed\', assigned_reviewer_id = ?\\n           WHERE id = ?`\\n        )\\n        .run(params.reviewerUserId, params.submissionId);\\n\\n      this.db\\n        .prepare(\\\"UPDATE activity_completions SET status = \'reviewed\' WHERE id = ?\\\")\\n        .run(rawSub.completion_id);\\n    });\\n    tx();\\n\\n    return this.getReviewDetailForSubmission(params.submissionId)!;\\n  }\\n\\n  // ======================== AUDIT & ADMIN OVERVIEW ========================\\n\\n  logMediaAudit(\\n    actorUserId: string | null,\\n    actorRole: string,\\n    submissionId: string,\\n    action: MediaAuditAction\\n  ): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO media_access_audit_logs (id, actor_user_id, actor_role, submission_id, action)\\n         VALUES (?, ?, ?, ?, ?)`\\n      )\\n      .run(crypto.randomUUID(), actorUserId, actorRole, submissionId, action);\\n  }\\n\\n  listMediaAuditLogs(limit = 100): MediaAuditLogItem[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT l.id, l.actor_user_id, COALESCE(u.full_name, \'Retention System\') as actor_name,\\n                l.actor_role, l.submission_id, l.action, l.created_at\\n         FROM media_access_audit_logs l\\n         LEFT JOIN users u ON u.id = l.actor_user_id\\n         ORDER BY l.created_at DESC\\n         LIMIT ?`\\n      )\\n      .all(limit) as Array<{\\n      id: string;\\n      actor_user_id: string | null;\\n      actor_name: string;\\n      actor_role: string;\\n      submission_id: string;\\n      action: MediaAuditAction;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      actorUserId: r.actor_user_id,\\n      actorName: r.actor_name,\\n      actorRole: r.actor_role,\\n      submissionId: r.submission_id,\\n      action: r.action,\\n      createdAt: r.created_at,\\n    }));\\n  }\\n\\n  getAdminOverview(lastRetentionSweepAt: string | null): AdminOverviewResponse {\\n    const ageGroups = this.listAgeGroups();\\n    const domains = this.listLearningDomains();\\n\\n    const totalActivities = (\\n      this.db.prepare(\'SELECT COUNT(*) as c FROM activities\').get() as { c: number }\\n    ).c;\\n    const publishedActivities = (\\n      this.db.prepare(\\\"SELECT COUNT(*) as c FROM activities WHERE status = \'published\'\\\").get() as {\\n        c: number;\\n      }\\n    ).c;\\n    const totalParents = (\\n      this.db.prepare(\\\"SELECT COUNT(*) as c FROM users WHERE role = \'parent\'\\\").get() as { c: number }\\n    ).c;\\n    const totalReviewers = (\\n      this.db.prepare(\\\"SELECT COUNT(*) as c FROM users WHERE role = \'reviewer\'\\\").get() as {\\n        c: number;\\n      }\\n    ).c;\\n    const queuedSubmissions = (\\n      this.db\\n        .prepare(\\\"SELECT COUNT(*) as c FROM video_submissions WHERE review_status IN (\'queued\', \'in_review\')\\\")\\n        .get() as { c: number }\\n    ).c;\\n    const activeVideosCount = (\\n      this.db\\n        .prepare(\'SELECT COUNT(*) as c FROM video_submissions WHERE storage_key IS NOT NULL AND deleted_at IS NULL\')\\n        .get() as { c: number }\\n    ).c;\\n    const expiredPurgedCount = (\\n      this.db\\n        .prepare(\\\"SELECT COUNT(*) as c FROM video_submissions WHERE deletion_reason = \'retention_30d\'\\\")\\n        .get() as { c: number }\\n    ).c;\\n\\n    const matrixRows = this.db\\n      .prepare(\\n        `SELECT age_group_id, domain_id, COUNT(*) as cnt\\n         FROM activities\\n         WHERE status = \'published\'\\n         GROUP BY age_group_id, domain_id`\\n      )\\n      .all() as Array<{ age_group_id: string; domain_id: string; cnt: number }>;\\n\\n    const countLookup = new Map<string, number>();\\n    for (const row of matrixRows) {\\n      countLookup.set(`${row.age_group_id}::${row.domain_id}`, row.cnt);\\n    }\\n\\n    const coverageMatrix = ageGroups.map((ag) => {\\n      const domainCounts: Record<string, number> = {};\\n      for (const dom of domains) {\\n        domainCounts[dom.slug] = countLookup.get(`${ag.id}::${dom.id}`) ?? 0;\\n      }\\n      return {\\n        ageGroupId: ag.id,\\n        ageGroupSlug: ag.slug,\\n        ageGroupLabel: ag.label,\\n        domainCounts,\\n      };\\n    });\\n\\n    return {\\n      counts: {\\n        totalActivities,\\n        publishedActivities,\\n        totalParents,\\n        totalReviewers,\\n        queuedSubmissions,\\n        activeVideosCount,\\n        expiredPurgedCount,\\n      },\\n      coverageMatrix,\\n      lastRetentionSweepAt,\\n    };\\n  }\\n}\\n\", \"Description\":\"Implement SQLite Repository Layer isolating all SQL queries behind typed domain methods for future PostgreSQL portability.\", \"Overwrite\":true, \"TargetFile\":\"/server/repositories/index.ts\", \"toolAction\":\"Creating SQLite repository layer\", \"toolSummary\":\"Create repository layer\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15288952640661384365"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { LittleStepsRepository } from \'../repositories/index\';\\nimport type { MediaStorageAdapter } from \'../storage/mediaStorage\';\\n\\nexport class RetentionWorker {\\n  private timer: NodeJS.Timeout | null = null;\\n  public lastSweepAt: string | null = null;\\n\\n  constructor(\\n    private readonly repo: LittleStepsRepository,\\n    private readonly storage: MediaStorageAdapter\\n  ) {}\\n\\n  async runSweep(): Promise<{ purgedCount: number; sweptAt: string }> {\\n    const expired = this.repo.listExpiredActiveSubmissions();\\n    let purgedCount = 0;\\n\\n    for (const item of expired) {\\n      await this.storage.deleteObject(item.storage_key);\\n      this.repo.markSubmissionVideoDeleted(item.id, \'retention_30d\');\\n      this.repo.logMediaAudit(null, \'system\', item.id, \'auto_purge\');\\n      purgedCount += 1;\\n    }\\n\\n    this.lastSweepAt = new Date().toISOString();\\n    return { purgedCount, sweptAt: this.lastSweepAt };\\n  }\\n\\n  startHourlySchedule(): void {\\n    if (this.timer) return;\\n    void this.runSweep();\\n    this.timer = setInterval(() => {\\n      void this.runSweep();\\n    }, 60 * 60 * 1000);\\n    this.timer.unref();\\n  }\\n}\\n\", \"Description\":\"Create 30-day automatic child video deletion worker with audit logging.\", \"Overwrite\":true, \"TargetFile\":\"/server/services/retentionWorker.ts\", \"toolAction\":\"Creating 30-day retention worker\", \"toolSummary\":\"Create retention worker\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15288952640661381884"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { NextFunction, Request, Response } from \'express\';\\nimport type { UserProfile, UserRole } from \'../../src/shared/types\';\\nimport type { LittleStepsRepository } from \'../repositories/index\';\\nimport { verifySessionToken } from \'../security/crypto\';\\n\\nexport const SESSION_COOKIE_NAME = \'ls_session\';\\n\\nexport interface AuthenticatedRequest extends Request {\\n  authUser?: UserProfile;\\n}\\n\\nexport function createAuthMiddleware(repo: LittleStepsRepository) {\\n  return function requireAuth(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\\n    const token = req.cookies?.[SESSION_COOKIE_NAME] as string | undefined;\\n    const payload = verifySessionToken(token);\\n    if (!payload) {\\n      res.status(401).json({ error: \'Authentication required. Please sign in.\' });\\n      return;\\n    }\\n    const user = repo.findUserById(payload.userId);\\n    if (!user || !user.isActive) {\\n      res.clearCookie(SESSION_COOKIE_NAME);\\n      res.status(401).json({ error: \'Account is inactive or no longer valid.\' });\\n      return;\\n    }\\n    req.authUser = user;\\n    next();\\n  };\\n}\\n\\nexport function requireRole(...allowedRoles: UserRole[]) {\\n  return function roleGuard(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\\n    if (!req.authUser) {\\n      res.status(401).json({ error: \'Authentication required.\' });\\n      return;\\n    }\\n    if (!allowedRoles.includes(req.authUser.role)) {\\n      res.status(403).json({ error: \'You do not have permission to access this resource.\' });\\n      return;\\n    }\\n    next();\\n  };\\n}\\n\\n/**\\n * Lightweight in-memory sliding-window rate limiter for auth and upload endpoints.\\n */\\nexport function createRateLimiter(windowMs: number, maxRequests: number) {\\n  const buckets = new Map<string, number[]>();\\n  return function rateLimit(req: Request, res: Response, next: NextFunction): void {\\n    const key = `${req.ip || \'local\'}:${req.path}`;\\n    const now = Date.now();\\n    const recent = (buckets.get(key) || []).filter((ts) => now - ts < windowMs);\\n    if (recent.length >= maxRequests) {\\n      res.status(429).json({ error: \'Too many requests. Please wait a moment and try again.\' });\\n      return;\\n    }\\n    recent.push(now);\\n    buckets.set(key, recent);\\n    next();\\n  };\\n}\\n\", \"Description\":\"Create session authentication middleware, strict RBAC role guards, and lightweight rate limiter.\", \"Overwrite\":true, \"TargetFile\":\"/server/middleware/auth.ts\", \"toolAction\":\"Creating auth and RBAC middleware\", \"toolSummary\":\"Create auth middleware\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15288952640661383499"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import express, { type Response } from \'express\';\\nimport multer from \'multer\';\\nimport { z } from \'zod\';\\nimport {\\n  ALLOWED_VIDEO_MIME_TYPES,\\n  MAX_VIDEO_DURATION_SECONDS,\\n  MAX_VIDEO_SIZE_BYTES,\\n  RETENTION_DAYS,\\n} from \'../../src/shared/domain\';\\nimport type { LittleStepsRepository } from \'../repositories/index\';\\nimport type { RetentionWorker } from \'../services/retentionWorker\';\\nimport type { MediaStorageAdapter } from \'../storage/mediaStorage\';\\nimport {\\n  createAuthMiddleware,\\n  createRateLimiter,\\n  requireRole,\\n  SESSION_COOKIE_NAME,\\n  type AuthenticatedRequest,\\n} from \'../middleware/auth\';\\nimport {\\n  hashIp,\\n  hashPassword,\\n  signSessionToken,\\n  signVideoStreamToken,\\n  validateVideoMagicBytes,\\n  verifyPassword,\\n  verifyVideoStreamToken,\\n} from \'../security/crypto\';\\n\\nconst upload = multer({\\n  storage: multer.memoryStorage(),\\n  limits: {\\n    fileSize: MAX_VIDEO_SIZE_BYTES,\\n    files: 1,\\n  },\\n});\\n\\nconst registerSchema = z.object({\\n  email: z.string().email(\'Please enter a valid email address.\'),\\n  password: z.string().min(8, \'Password must be at least 8 characters.\'),\\n  fullName: z.string().min(2, \'Please enter your name.\').max(100),\\n  phoneNumber: z.string().max(24).optional().nullable(),\\n  preferredLocale: z.enum([\'en\', \'hi\']).optional().default(\'en\'),\\n});\\n\\nconst loginSchema = z.object({\\n  email: z.string().email(),\\n  password: z.string().min(1),\\n});\\n\\nconst childSchema = z.object({\\n  displayName: z.string().min(1, \'Please enter your baby\342\200\231s name.\').max(60),\\n  dateOfBirth: z\\n    .string()\\n    .regex(/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/, \'Please select a valid date of birth.\'),\\n});\\n\\nconst completionSchema = z.object({\\n  childId: z.string().min(1),\\n  activityId: z.string().min(1),\\n  status: z.enum([\'started\', \'completed\']),\\n  caregiverNotes: z.string().max(600).optional().nullable(),\\n});\\n\\nconst reviewSubmitSchema = z.object({\\n  strengthsNote: z.string().min(10, \'Please share a warm, specific strength note.\').max(1000),\\n  coachingTip: z.string().min(10, \'Please share one practical next-time tip.\').max(1000),\\n  evaluationScopeAcknowledged: z.literal(true, {\\n    errorMap: () => ({\\n      message: \'Please confirm this evaluation assesses caregiver instruction execution only.\',\\n    }),\\n  }),\\n  criterionRatings: z\\n    .array(\\n      z.object({\\n        criterionId: z.string().min(1),\\n        achievedLevel: z.enum([\'met\', \'partially_met\', \'not_observed\']),\\n      })\\n    )\\n    .min(1),\\n});\\n\\nconst adminActivitySchema = z.object({\\n  ageGroupId: z.string().min(1),\\n  domainId: z.string().min(1),\\n  title: z.string().min(3).max(120),\\n  summary: z.string().min(10).max(300),\\n  durationMinutes: z.coerce.number().int().min(1).max(30),\\n  materials: z.array(z.string().min(1).max(100)).min(1).max(10),\\n  safetyNotes: z.string().min(5).max(500),\\n  instructionalPosterUrl: z.string().min(1),\\n  status: z.enum([\'draft\', \'published\', \'archived\']),\\n  steps: z\\n    .array(\\n      z.object({\\n        title: z.string().min(2).max(100),\\n        instructionText: z.string().min(5).max(500),\\n        caregiverTip: z.string().max(240).optional().nullable(),\\n      })\\n    )\\n    .min(1)\\n    .max(8),\\n  rubricCriteria: z\\n    .array(\\n      z.object({\\n        label: z.string().min(3).max(100),\\n        description: z.string().min(5).max(300),\\n        weightPoints: z.coerce.number().int().min(5).max(100),\\n      })\\n    )\\n    .min(1)\\n    .max(8),\\n});\\n\\nconst dailyPlanSchema = z.object({\\n  ageGroupId: z.string().min(1),\\n  dayNumber: z.coerce.number().int().min(1).max(30),\\n  title: z.string().min(3).max(100),\\n  focusNote: z.string().min(5).max(300),\\n  activityIds: z.array(z.string().min(1)).min(1).max(4),\\n});\\n\\nfunction setSessionCookie(res: Response, token: string): void {\\n  res.cookie(SESSION_COOKIE_NAME, token, {\\n    httpOnly: true,\\n    sameSite: \'lax\',\\n    secure: process.env.NODE_ENV === \'production\',\\n    maxAge: 7 * 24 * 60 * 60 * 1000,\\n    path: \'/\',\\n  });\\n}\\n\\nexport function createApiRouter(\\n  repo: LittleStepsRepository,\\n  storage: MediaStorageAdapter,\\n  retentionWorker: RetentionWorker\\n): express.Router {\\n  const router = express.Router();\\n  const requireAuth = createAuthMiddleware(repo);\\n  const authRateLimit = createRateLimiter(15 * 60 * 1000, 40);\\n  const uploadRateLimit = createRateLimiter(15 * 60 * 1000, 20);\\n\\n  // ======================== HEALTH & META ========================\\n\\n  router.get(\'/health\', (_req, res) => {\\n    res.json({ status: \'ok\', service: \'LittleSteps API v1\' });\\n  });\\n\\n  router.get(\'/curriculum/meta\', (_req, res) => {\\n    res.json({\\n      ageGroups: repo.listAgeGroups(),\\n      learningDomains: repo.listLearningDomains(),\\n    });\\n  });\\n\\n  // ======================== AUTHENTICATION ========================\\n\\n  router.post(\'/auth/register\', authRateLimit, (req, res) => {\\n    const parsed = registerSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid registration data.\' });\\n      return;\\n    }\\n    const existing = repo.findUserByEmail(parsed.data.email);\\n    if (existing) {\\n      res.status(409).json({ error: \'An account with this email already exists.\' });\\n      return;\\n    }\\n    const user = repo.createUser({\\n      email: parsed.data.email,\\n      passwordHash: hashPassword(parsed.data.password),\\n      fullName: parsed.data.fullName,\\n      phoneNumber: parsed.data.phoneNumber ?? null,\\n      role: \'parent\', // Self-registration always creates a parent role\\n      preferredLocale: parsed.data.preferredLocale,\\n      ipHash: hashIp(req.ip || \'unknown\'),\\n    });\\n    const token = signSessionToken(user.id, user.role);\\n    setSessionCookie(res, token);\\n    res.status(201).json({ user });\\n  });\\n\\n  router.post(\'/auth/login\', authRateLimit, (req, res) => {\\n    const parsed = loginSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: \'Please enter a valid email and password.\' });\\n      return;\\n    }\\n    const found = repo.findUserByEmail(parsed.data.email);\\n    if (!found || !found.isActive || !verifyPassword(parsed.data.password, found.passwordHash)) {\\n      res.status(401).json({ error: \'Invalid email or password.\' });\\n      return;\\n    }\\n    const { passwordHash: _omit, ...user } = found;\\n    const token = signSessionToken(user.id, user.role);\\n    setSessionCookie(res, token);\\n    res.json({ user });\\n  });\\n\\n  router.post(\'/auth/logout\', (_req, res) => {\\n    res.clearCookie(SESSION_COOKIE_NAME, { path: \'/\' });\\n    res.json({ ok: true });\\n  });\\n\\n  router.get(\'/auth/me\', requireAuth, (req: AuthenticatedRequest, res) => {\\n    res.json({ user: req.authUser });\\n  });\\n\\n  // ======================== PARENT: CHILDREN ========================\\n\\n  router.get(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const children = repo.listChildrenByParent(req.authUser!.id);\\n    res.json({ children });\\n  });\\n\\n  router.post(\'/children\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    const dobDate = new Date(parsed.data.dateOfBirth);\\n    if (dobDate.getTime() > Date.now()) {\\n      res.status(400).json({ error: \'Date of birth cannot be in the future.\' });\\n      return;\\n    }\\n    const child = repo.createChild(req.authUser!.id, parsed.data.displayName, parsed.data.dateOfBirth);\\n    res.status(201).json({ child });\\n  });\\n\\n  router.patch(\'/children/:id\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const parsed = childSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid child profile.\' });\\n      return;\\n    }\\n    const child = repo.updateChild(\\n      req.params.id,\\n      req.authUser!.id,\\n      parsed.data.displayName,\\n      parsed.data.dateOfBirth\\n    );\\n    if (!child) {\\n      res.status(404).json({ error: \'Child profile not found.\' });\\n      return;\\n    }\\n    res.json({ child });\\n  });\\n\\n  router.delete(\'/children/:id\', requireAuth, requireRole(\'parent\'), (req: AuthenticatedRequest, res) => {\\n    const deleted = repo.deleteChild(req.params.id, req.authUser!.id);\\n    if (!deleted) {\\n      res.status(404).json({ error: \'Child profile not found.\' });\\n      return;\\n    }\\n    res.json({ ok: true });\\n  });\\n\\n  // ======================== PARENT: JOURNEY & COMPLETIONS ========================\\n\\n  router.get(\\n    \'/journey/:childId/today\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const child = repo.findChildByIdForParent(req.params.childId, req.authUser!.id);\\n      if (!child) {\\n        res.status(404).json({ error: \'Child profile not found.\' });\\n        return;\\n      }\\n      const dayParam = req.query.day ? Number(req.query.day) : undefined;\\n      const journey = repo.getJourneyForChild(\\n        child,\\n        dayParam && Number.isFinite(dayParam) ? dayParam : undefined\\n      );\\n      res.json(journey);\\n    }\\n  );\\n\\n  router.post(\\n    \'/completions\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = completionSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid completion data.\' });\\n        return;\\n      }\\n      const child = repo.findChildByIdForParent(parsed.data.childId, req.authUser!.id);\\n      if (!child) {\\n        res.status(404).json({ error: \'Child profile not found.\' });\\n        return;\\n      }\\n      const activity = repo.getActivityDetail(parsed.data.activityId);\\n      if (!activity || activity.status !== \'published\') {\\n        res.status(404).json({ error: \'Activity not found.\' });\\n        return;\\n      }\\n      const result = repo.upsertActivityCompletion({\\n        childId: child.id,\\n        activityId: activity.id,\\n        status: parsed.data.status,\\n        caregiverNotes: parsed.data.caregiverNotes ?? null,\\n      });\\n      res.status(201).json({ completion: result });\\n    }\\n  );\\n\\n  // ======================== PRIVATE VIDEO UPLOAD, SIGNED STREAM & DELETE ========================\\n\\n  router.post(\\n    \'/submissions\',\\n    requireAuth,\\n    requireRole(\'parent\'),\\n    uploadRateLimit,\\n    upload.single(\'video\'),\\n    async (req: AuthenticatedRequest, res) => {\\n      try {\\n        const file = req.file;\\n        const { childId, activityId, caregiverNotes, durationSeconds, consentConfirmed } = req.body as {\\n          childId?: string;\\n          activityId?: string;\\n          caregiverNotes?: string;\\n          durationSeconds?: string;\\n          consentConfirmed?: string;\\n        };\\n\\n        if (consentConfirmed !== \'true\') {\\n          res.status(400).json({\\n            error: \'Please confirm your consent for private 30-day review storage before uploading.\',\\n          });\\n          return;\\n        }\\n        if (!childId || !activityId) {\\n          res.status(400).json({ error: \'Child and activity must be specified.\' });\\n          return;\\n        }\\n        if (!file) {\\n          res.status(400).json({ error: \'Please record or choose a video clip to upload.\' });\\n          return;\\n        }\\n        const normalizedMime = file.mimetype.split(\';\')[0].trim().toLowerCase();\\n        if (\\n          !ALLOWED_VIDEO_MIME_TYPES.includes(\\n            normalizedMime as (typeof ALLOWED_VIDEO_MIME_TYPES)[number]\\n          )\\n        ) {\\n          res.status(400).json({\\n            error: \'Only MP4, WebM, or MOV video files are accepted.\',\\n          });\\n          return;\\n        }\\n        if (!validateVideoMagicBytes(file.buffer)) {\\n          res.status(400).json({\\n            error: \'Uploaded file failed binary video verification. Please upload a valid video.\',\\n          });\\n          return;\\n        }\\n\\n        const parsedDuration = Math.max(\\n          1,\\n          Math.min(MAX_VIDEO_DURATION_SECONDS, Math.round(Number(durationSeconds) || 10))\\n        );\\n\\n        const child = repo.findChildByIdForParent(childId, req.authUser!.id);\\n        if (!child) {\\n          res.status(404).json({ error: \'Child profile not found.\' });\\n          return;\\n        }\\n        const activity = repo.getActivityDetail(activityId);\\n        if (!activity || activity.status !== \'published\') {\\n          res.status(404).json({ error: \'Activity not found.\' });\\n          return;\\n        }\\n\\n        const ext = normalizedMime === \'video/mp4\' ? \'mp4\' : normalizedMime === \'video/quicktime\' ? \'mov\' : \'webm\';\\n        const storageKey = await storage.saveBuffer(file.buffer, ext);\\n\\n        repo.recordUserConsent(req.authUser!.id, \'video_processing\', hashIp(req.ip || \'unknown\'));\\n\\n        const completion = repo.upsertActivityCompletion({\\n          childId: child.id,\\n          activityId: activity.id,\\n          status: \'submitted_for_review\',\\n          caregiverNotes: caregiverNotes ?? null,\\n        });\\n\\n        const expiresAt = new Date(Date.now() + RETENTION_DAYS * 24 * 60 * 60 * 1000).toISOString();\\n        const submission = repo.createVideoSubmission({\\n          completionId: completion.id,\\n          parentUserId: req.authUser!.id,\\n          childId: child.id,\\n          activityId: activity.id,\\n          storageKey,\\n          mimeType: normalizedMime,\\n          fileSizeBytes: file.size,\\n          durationSeconds: parsedDuration,\\n          caregiverNotes: caregiverNotes ?? null,\\n          expiresAt,\\n        });\\n\\n        res.status(201).json({ submission });\\n      } catch (err) {\\n        const message = err instanceof Error ? err.message : \'Unable to save video submission.\';\\n        res.status(500).json({ error: message });\\n      }\\n    }\\n  );\\n\\n  router.get(\\n    \'/submissions/:id/stream-token\',\\n    requireAuth,\\n    (req: AuthenticatedRequest, res) => {\\n      const user = req.authUser!;\\n      const sub = repo.findSubmissionRawById(req.params.id);\\n      if (!sub) {\\n        res.status(404).json({ error: \'Submission not found.\' });\\n        return;\\n      }\\n\\n      // Strict RBAC ownership / assignment enforcement\\n      const allowed =\\n        (user.role === \'parent\' && sub.parent_user_id === user.id) ||\\n        user.role === \'reviewer\' ||\\n        user.role === \'admin\';\\n\\n      if (!allowed) {\\n        res.status(403).json({ error: \'Not authorized to access this video.\' });\\n        return;\\n      }\\n\\n      if (!sub.storage_key || sub.deleted_at || !storage.exists(sub.storage_key)) {\\n        res.status(410).json({\\n          error: \'This video is no longer stored in the private vault.\',\\n          deletionReason: sub.deletion_reason || \'deleted\',\\n        });\\n        return;\\n      }\\n\\n      const { token, expiresAt } = signVideoStreamToken(user.id, user.role, sub.id);\\n      res.json({\\n        streamUrl: `/api/v1/media/stream/${sub.id}?token=${encodeURIComponent(token)}`,\\n        expiresAt,\\n      });\\n    }\\n  );\\n\\n  router.get(\'/media/stream/:submissionId\', (req, res) => {\\n    const token = typeof req.query.token === \'string\' ? req.query.token : undefined;\\n    const verified = verifyVideoStreamToken(token);\\n    if (!verified || verified.submissionId !== req.params.submissionId) {\\n      res.status(401).json({ error: \'Invalid or expired video stream token.\' });\\n      return;\\n    }\\n\\n    const sub = repo.findSubmissionRawById(req.params.submissionId);\\n    if (!sub || !sub.storage_key || sub.deleted_at || !storage.exists(sub.storage_key)) {\\n      res.status(410).json({ error: \'Video file has been deleted.\' });\\n      return;\\n    }\\n\\n    // Re-check RBAC at streaming time\\n    if (verified.role === \'parent\' && sub.parent_user_id !== verified.userId) {\\n      res.status(403).json({ error: \'Forbidden.\' });\\n      return;\\n    }\\n\\n    const fileSize = storage.getSize(sub.storage_key);\\n    const range = req.headers.range;\\n\\n    // Log first stream open (not every subsequent range chunk)\\n    if (!range || range.startsWith(\'bytes=0-\')) {\\n      repo.logMediaAudit(verified.userId, verified.role, sub.id, \'stream\');\\n    }\\n\\n    res.setHeader(\'Cache-Control\', \'private, no-store, max-age=0\');\\n    res.setHeader(\'Content-Disposition\', \'inline\');\\n    res.setHeader(\'X-Content-Type-Options\', \'nosniff\');\\n    res.setHeader(\'Accept-Ranges\', \'bytes\');\\n\\n    if (range) {\\n      const [startStr, endStr] = range.replace(/bytes=/, \'\').split(\'-\');\\n      const start = parseInt(startStr, 10);\\n      const end = endStr ? parseInt(endStr, 10) : Math.min(start + 1024 * 1024, fileSize - 1);\\n      if (Number.isNaN(start) || start >= fileSize || end >= fileSize || start > end) {\\n        res.status(416).setHeader(\'Content-Range\', `bytes */${fileSize}`).end();\\n        return;\\n      }\\n      res.status(206);\\n      res.setHeader(\'Content-Range\', `bytes ${start}-${end}/${fileSize}`);\\n      res.setHeader(\'Content-Length\', String(end - start + 1));\\n      res.setHeader(\'Content-Type\', sub.mime_type);\\n      storage.openReadStream(sub.storage_key, start, end).pipe(res);\\n      return;\\n    }\\n\\n    res.status(200);\\n    res.setHeader(\'Content-Length\', String(fileSize));\\n    res.setHeader(\'Content-Type\', sub.mime_type);\\n    storage.openReadStream(sub.storage_key).pipe(res);\\n  });\\n\\n  router.delete(\\n    \'/submissions/:id/video\',\\n    requireAuth,\\n    requireRole(\'parent\', \'admin\'),\\n    async (req: AuthenticatedRequest, res) => {\\n      const user = req.authUser!;\\n      const sub = repo.findSubmissionRawById(req.params.id);\\n      if (!sub) {\\n        res.status(404).json({ error: \'Submission not found.\' });\\n        return;\\n      }\\n      if (user.role === \'parent\' && sub.parent_user_id !== user.id) {\\n        res.status(403).json({ error: \'You can only delete your own videos.\' });\\n        return;\\n      }\\n      if (sub.storage_key) {\\n        await storage.deleteObject(sub.storage_key);\\n      }\\n      const reason = user.role === \'admin\' ? \'admin_deleted\' : \'parent_deleted\';\\n      repo.markSubmissionVideoDeleted(sub.id, reason);\\n      repo.logMediaAudit(\\n        user.id,\\n        user.role,\\n        sub.id,\\n        user.role === \'admin\' ? \'admin_delete\' : \'parent_delete\'\\n      );\\n      res.json({ ok: true, deletedAt: new Date().toISOString() });\\n    }\\n  );\\n\\n  // ======================== REVIEWER WORKBENCH ========================\\n\\n  router.get(\\n    \'/reviewer/queue\',\\n    requireAuth,\\n    requireRole(\'reviewer\', \'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const status = typeof req.query.status === \'string\' ? req.query.status : \'all\';\\n      const ageGroupSlug =\\n        typeof req.query.ageGroupSlug === \'string\' ? req.query.ageGroupSlug : \'all\';\\n      const queue = repo.listReviewerQueue({\\n        status: status as \'queued\' | \'in_review\' | \'reviewed\' | \'all\',\\n        ageGroupSlug,\\n      });\\n      res.json({ queue });\\n    }\\n  );\\n\\n  router.post(\\n    \'/reviewer/submissions/:id/claim\',\\n    requireAuth,\\n    requireRole(\'reviewer\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const claimed = repo.claimSubmissionForReviewer(req.params.id, req.authUser!.id);\\n      if (!claimed) {\\n        res.status(409).json({\\n          error: \'This submission is already assigned to another reviewer or completed.\',\\n        });\\n        return;\\n      }\\n      const detail = repo.getReviewerSubmissionDetail(req.params.id);\\n      res.json(detail);\\n    }\\n  );\\n\\n  router.get(\\n    \'/reviewer/submissions/:id\',\\n    requireAuth,\\n    requireRole(\'reviewer\', \'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const detail = repo.getReviewerSubmissionDetail(req.params.id);\\n      if (!detail) {\\n        res.status(404).json({ error: \'Submission not found.\' });\\n        return;\\n      }\\n      res.json(detail);\\n    }\\n  );\\n\\n  router.post(\\n    \'/reviewer/submissions/:id/review\',\\n    requireAuth,\\n    requireRole(\'reviewer\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = reviewSubmitSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid review input.\' });\\n        return;\\n      }\\n      try {\\n        const review = repo.submitRubricReview({\\n          submissionId: req.params.id,\\n          reviewerUserId: req.authUser!.id,\\n          strengthsNote: parsed.data.strengthsNote,\\n          coachingTip: parsed.data.coachingTip,\\n          criterionRatings: parsed.data.criterionRatings,\\n        });\\n        res.status(201).json({ review });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to submit review.\';\\n        res.status(400).json({ error: msg });\\n      }\\n    }\\n  );\\n\\n  // ======================== ADMIN CURRICULUM, PLANS, USERS & AUDIT ========================\\n\\n  router.get(\'/admin/overview\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json(repo.getAdminOverview(retentionWorker.lastSweepAt));\\n  });\\n\\n  router.get(\'/admin/activities\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' ? req.query.ageGroupId : undefined;\\n    const domainId = typeof req.query.domainId === \'string\' ? req.query.domainId : undefined;\\n    res.json({ activities: repo.listActivities({ ageGroupId, domainId }) });\\n  });\\n\\n  router.get(\'/admin/activities/:id\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const activity = repo.getActivityDetail(req.params.id);\\n    if (!activity) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({ activity });\\n  });\\n\\n  router.post(\\n    \'/admin/activities\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      const activity = repo.saveActivity(req.authUser!.id, parsed.data);\\n      res.status(201).json({ activity });\\n    }\\n  );\\n\\n  router.put(\\n    \'/admin/activities/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      const activity = repo.saveActivity(req.authUser!.id, {\\n        ...parsed.data,\\n        id: req.params.id,\\n      });\\n      res.json({ activity });\\n    }\\n  );\\n\\n  router.delete(\'/admin/activities/:id\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const deleted = repo.deleteActivity(req.params.id);\\n    if (!deleted) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({ ok: true });\\n  });\\n\\n  router.get(\'/admin/daily-plans\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' ? req.query.ageGroupId : \'ag_6-9m\';\\n    const plans = repo.listDailyPlansForAgeGroup(ageGroupId);\\n    const activities = repo.listActivities({ ageGroupId, status: \'published\' });\\n    res.json({ plans, activities });\\n  });\\n\\n  router.put(\'/admin/daily-plans\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const parsed = dailyPlanSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid daily plan data.\' });\\n      return;\\n    }\\n    repo.upsertDailyPlan(parsed.data);\\n    res.json({ plans: repo.listDailyPlansForAgeGroup(parsed.data.ageGroupId) });\\n  });\\n\\n  router.get(\'/admin/users\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ users: repo.listAllUsers() });\\n  });\\n\\n  router.patch(\\n    \'/admin/users/:id/role\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const schema = z.object({\\n        role: z.enum([\'parent\', \'reviewer\', \'admin\']).optional(),\\n        isActive: z.boolean().optional(),\\n      });\\n      const parsed = schema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: \'Invalid role or status update.\' });\\n        return;\\n      }\\n      if (req.params.id === req.authUser!.id && parsed.data.isActive === false) {\\n        res.status(400).json({ error: \'You cannot deactivate your own admin account.\' });\\n        return;\\n      }\\n      const updated = repo.updateUserRoleAndStatus(req.params.id, parsed.data);\\n      if (!updated) {\\n        res.status(404).json({ error: \'User not found.\' });\\n        return;\\n      }\\n      res.json({ user: updated });\\n    }\\n  );\\n\\n  router.get(\'/admin/audit-logs\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({\\n      logs: repo.listMediaAuditLogs(100),\\n      lastRetentionSweepAt: retentionWorker.lastSweepAt,\\n    });\\n  });\\n\\n  router.post(\'/admin/retention/run\', requireAuth, requireRole(\'admin\'), async (_req, res) => {\\n    const result = await retentionWorker.runSweep();\\n    res.json(result);\\n  });\\n\\n  return router;\\n}\\n\", \"Description\":\"Implement versioned /api/v1 Express REST routes for auth, children, daily journey, private video upload/signed streaming/deletion, reviewer rubrics, and admin CMS/audit.\", \"Overwrite\":true, \"TargetFile\":\"/server/routes/api.ts\", \"toolAction\":\"Creating Express API routes\", \"toolSummary\":\"Create API routes\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_15288952640661385114"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import \'dotenv/config\';\\nimport cookieParser from \'cookie-parser\';\\nimport express from \'express\';\\nimport fs from \'fs\';\\nimport path from \'path\';\\nimport { getDb } from \'./server/db/connection\';\\nimport { runMigrations } from \'./server/db/schema\';\\nimport { seedDatabaseIfEmpty } from \'./server/db/seed\';\\nimport { LittleStepsRepository } from \'./server/repositories/index\';\\nimport { createApiRouter } from \'./server/routes/api\';\\nimport { RetentionWorker } from \'./server/services/retentionWorker\';\\nimport { mediaStorage } from \'./server/storage/mediaStorage\';\\n\\nconst PORT = Number(process.env.PORT || 3000);\\nconst isProduction = process.env.NODE_ENV === \'production\';\\n\\nasync function startServer() {\\n  // 1. Initialize SQLite database, migrations, and starter seed\\n  const db = getDb();\\n  runMigrations(db);\\n  seedDatabaseIfEmpty(db);\\n\\n  const repo = new LittleStepsRepository(db);\\n  const retentionWorker = new RetentionWorker(repo, mediaStorage);\\n  retentionWorker.startHourlySchedule();\\n\\n  // 2. Configure Express application\\n  const app = express();\\n  app.disable(\'x-powered-by\');\\n  app.use(express.json({ limit: \'2mb\' }));\\n  app.use(cookieParser());\\n\\n  // Basic security headers (compatible with AI Studio preview iframe)\\n  app.use((_req, res, next) => {\\n    res.setHeader(\'X-Content-Type-Options\', \'nosniff\');\\n    res.setHeader(\'Referrer-Policy\', \'strict-origin-when-cross-origin\');\\n    next();\\n  });\\n\\n  // Mount versioned REST API\\n  app.use(\'/api/v1\', createApiRouter(repo, mediaStorage, retentionWorker));\\n\\n  // 3. Mount Vite dev middleware in development or static dist in production\\n  if (!isProduction) {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: {\\n        middlewareMode: true,\\n        hmr: process.env.DISABLE_HMR !== \'true\',\\n      },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    const distDir = path.resolve(process.cwd(), \'dist\');\\n    app.use(express.static(distDir));\\n    app.get(\'*\', (_req, res) => {\\n      const indexHtml = path.join(distDir, \'index.html\');\\n      if (fs.existsSync(indexHtml)) {\\n        res.sendFile(indexHtml);\\n      } else {\\n        res.status(404).send(\'Build output not found.\');\\n      }\\n    });\\n  }\\n\\n  app.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`LittleSteps server listening on http://0.0.0.0:${PORT}`);\\n  });\\n}\\n\\nstartServer().catch((err) => {\\n  console.error(\'Failed to start LittleSteps server:\', err);\\n  process.exit(1);\\n});\\n\", \"Description\":\"Create unified Express + Vite server entry on port 3000 initializing SQLite, migrations, seed data, and 30-day retention worker.\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Creating Express server entry point\", \"toolSummary\":\"Create server.ts\"}"
      original_name: "write_to_file"
    }
