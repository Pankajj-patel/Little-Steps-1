\'Add at least one step-by-step instruction.\')\\n    .max(8),\\n  rubricCriteria: z\\n    .array(\\n      z.object({\\n        label: z.string().min(3, \'Criterion label must be at least 3 characters.\').max(100),\\n        description: z.string().min(5, \'Criterion description must be at least 5 characters.\').max(300),\\n        weightPoints: z.coerce.number().int().min(5).max(100),\\n      })\\n    )\\n    .min(1, \'Add at least one rubric criterion.\')\\n    .max(8),\\n});\\n\\nconst ageGroupSchema = z.object({\\n  slug: z\\n    .string()\\n    .trim()\\n    .min(2, \'Slug is required.\')\\n    .max(24)\\n    .regex(/^[a-z0-9-]+$/, \'Slug may only contain lowercase letters, numbers, and hyphens.\'),\\n  label: z.string().trim().min(2, \'Label is required.\').max(60),\\n  minMonths: z.coerce.number().int().min(0).max(48),\\n  maxMonths: z.coerce.number().int().min(1).max(60),\\n  sortOrder: z.coerce.number().int().min(1).max(100),\\n});\\n\\nconst domainSchema = z.object({\\n  slug: z\\n    .string()\\n    .trim()\\n    .min(2, \'Slug is required.\')\\n    .max(40)\\n    .regex(/^[a-z0-9_-]+$/, \'Slug may only contain lowercase letters, numbers, hyphens, and underscores.\'),\\n  name: z.string().trim().min(2, \'Domain name is required.\').max(80),\\n  description: z.string().trim().min(10, \'Description must be at least 10 characters.\').max(400),\\n  sortOrder: z.coerce.number().int().min(1).max(100),\\n});\\n\\nconst createReviewerSchema = z.object({\\n  email: z.string().email(\'Please enter a valid reviewer email address.\'),\\n  fullName: z.string().trim().min(2, \'Please enter the reviewer\342\200\231s full name.\').max(100),\\n  password: z.string().min(8, \'Temporary password must be at least 8 characters.\'),\\n  allowedAgeGroupSlugs: z.array(z.string().max(32)).max(16).optional().default([]),\\n  specialtyNote: z.string().max(240).optional().nullable(),\\n});\\n\\nconst updateReviewerSchema = z.object({\\n  isActive: z.boolean().optional(),\\n  allowedAgeGroupSlugs: z.array(z.string().max(32)).max(16).optional(),\\n  specialtyNote: z.string().max(240).optional().nullable(),\\n});\\n\\nconst dailyPlanSchema = z.object({\\n  ageGroupId: z.string().min(1),\\n  dayNumber: z.coerce.number().int().min(1).max(30),\\n  title: z.string().min(3).max(100),\\n  focusNote: z.string().min(5).max(300),\\n  activityIds: z.array(z.string().min(1)).min(1).max(4),\\n});\", \"StartLine\":173, \"TargetContent\":\"const adminActivitySchema = z.object({\\n  ageGroupId: z.string().min(1),\\n  domainId: z.string().min(1),\\n  title: z.string().min(3).max(120),\\n  summary: z.string().min(10).max(300),\\n  durationMinutes: z.coerce.number().int().min(1).max(30),\\n  materials: z.array(z.string().min(1).max(100)).min(1).max(10),\\n  safetyNotes: z.string().min(5).max(500),\\n  instructionalPosterUrl: z.string().min(1),\\n  status: z.enum([\'draft\', \'published\', \'archived\']),\\n  steps: z\\n    .array(\\n      z.object({\\n        title: z.string().min(2).max(100),\\n        instructionText: z.string().min(5).max(500),\\n        caregiverTip: z.string().max(240).optional().nullable(),\\n      })\\n    )\\n    .min(1)\\n    .max(8),\\n  rubricCriteria: z\\n    .array(\\n      z.object({\\n        label: z.string().min(3).max(100),\\n        description: z.string().min(5).max(300),\\n        weightPoints: z.coerce.number().int().min(5).max(100),\\n      })\\n    )\\n    .min(1)\\n    .max(8),\\n});\\n\\nconst dailyPlanSchema = z.object({\\n  ageGroupId: z.string().min(1),\\n  dayNumber: z.coerce.number().int().min(1).max(30),\\n  title: z.string().min(3).max(100),\\n  focusNote: z.string().min(5).max(300),\\n  activityIds: z.array(z.string().min(1)).min(1).max(4),\\n});\"}, {\"AllowMultiple\":false, \"EndLine\":1050, \"ReplacementContent\":\"      const reason = user.role === \'admin\' ? \'admin_deleted\' : \'parent_deleted\';\\n      repo.markSubmissionVideoDeleted(sub.id, reason);\\n      repo.logMediaAudit(\\n        user.id,\\n        user.role,\\n        sub.id,\\n        user.role === \'admin\' ? \'admin_delete\' : \'parent_delete\'\\n      );\\n      if (user.role === \'admin\') {\\n        repo.logAdminAudit({\\n          actorUserId: user.id,\\n          actorRole: \'admin\',\\n          action: \'submission_video_deleted\',\\n          entityType: \'video_submission\',\\n          entityId: sub.id,\\n          summary: `Admin deleted stored video file for submission ${sub.id}`,\\n        });\\n      }\\n      res.json({ ok: true, deletedAt: new Date().toISOString() });\\n    }\\n  );\", \"StartLine\":1037, \"TargetContent\":\"      const reason = user.role === \'admin\' ? \'admin_deleted\' : \'parent_deleted\';\\n      repo.markSubmissionVideoDeleted(sub.id, reason);\\n      repo.logMediaAudit(\\n        user.id,\\n        user.role,\\n        sub.id,\\n        user.role === \'admin\' ? \'admin_delete\' : \'parent_delete\'\\n      );\\n      res.json({ ok: true, deletedAt: new Date().toISOString() });\\n    }\\n  );\"}, {\"AllowMultiple\":false, \"EndLine\":1365, \"ReplacementContent\":\"  // ======================== ADMIN: OVERVIEW, TAXONOMY, ACTIVITIES, PLANS, REVIEWERS, SUBMISSIONS, USERS & AUDIT ========================\\n\\n  router.get(\'/admin/overview\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json(repo.getAdminOverview(retentionWorker.lastSweepAt));\\n  });\\n\\n  // ---- Age Group Management ----\\n\\n  router.get(\'/admin/age-groups\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ ageGroups: repo.listAdminAgeGroups() });\\n  });\\n\\n  router.post(\\n    \'/admin/age-groups\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = ageGroupSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid age group details.\' });\\n        return;\\n      }\\n      try {\\n        const ageGroup = repo.saveAgeGroup(req.authUser!.id, parsed.data);\\n        res.status(201).json({ ageGroup });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to save age group.\';\\n        res.status(msg.includes(\'UNIQUE\') ? 409 : 400).json({\\n          error: msg.includes(\'UNIQUE\') ? \'An age group with this slug already exists.\' : msg,\\n        });\\n      }\\n    }\\n  );\\n\\n  router.put(\\n    \'/admin/age-groups/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = ageGroupSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid age group details.\' });\\n        return;\\n      }\\n      try {\\n        const ageGroup = repo.saveAgeGroup(req.authUser!.id, {\\n          ...parsed.data,\\n          id: req.params.id,\\n        });\\n        res.json({ ageGroup });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to update age group.\';\\n        const status = msg.includes(\'not found\') ? 404 : msg.includes(\'UNIQUE\') ? 409 : 400;\\n        res.status(status).json({\\n          error: msg.includes(\'UNIQUE\') ? \'Another age group already uses that slug.\' : msg,\\n        });\\n      }\\n    }\\n  );\\n\\n  // ---- Development Domain Management ----\\n\\n  router.get(\'/admin/domains\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ domains: repo.listAdminDomains() });\\n  });\\n\\n  router.post(\\n    \'/admin/domains\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = domainSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid domain details.\' });\\n        return;\\n      }\\n      try {\\n        const domain = repo.saveDomain(req.authUser!.id, parsed.data);\\n        res.status(201).json({ domain });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to save development domain.\';\\n        res.status(msg.includes(\'UNIQUE\') ? 409 : 400).json({\\n          error: msg.includes(\'UNIQUE\') ? \'A domain with this slug already exists.\' : msg,\\n        });\\n      }\\n    }\\n  );\\n\\n  router.put(\\n    \'/admin/domains/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = domainSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid domain details.\' });\\n        return;\\n      }\\n      try {\\n        const domain = repo.saveDomain(req.authUser!.id, {\\n          ...parsed.data,\\n          id: req.params.id,\\n        });\\n        res.json({ domain });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to update development domain.\';\\n        const status = msg.includes(\'not found\') ? 404 : msg.includes(\'UNIQUE\') ? 409 : 400;\\n        res.status(status).json({\\n          error: msg.includes(\'UNIQUE\') ? \'Another domain already uses that slug.\' : msg,\\n        });\\n      }\\n    }\\n  );\\n\\n  // ---- Activity Management & Versioning ----\\n\\n  router.get(\'/admin/activities\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' && req.query.ageGroupId ? req.query.ageGroupId : undefined;\\n    const domainId = typeof req.query.domainId === \'string\' && req.query.domainId ? req.query.domainId : undefined;\\n    const statusParam = typeof req.query.status === \'string\' ? req.query.status : undefined;\\n    const status =\\n      statusParam === \'draft\' || statusParam === \'published\' || statusParam === \'archived\'\\n        ? statusParam\\n        : undefined;\\n    res.json({ activities: repo.listActivities({ ageGroupId, domainId, status }) });\\n  });\\n\\n  router.get(\'/admin/activities/:id\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const activity = repo.getActivityDetail(req.params.id);\\n    if (!activity) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({ activity });\\n  });\\n\\n  router.get(\'/admin/activities/:id/versions\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const activity = repo.getActivityDetail(req.params.id);\\n    if (!activity) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({\\n      activityId: activity.id,\\n      currentVersion: activity.version,\\n      versions: repo.listActivityVersions(activity.id),\\n    });\\n  });\\n\\n  router.post(\\n    \'/admin/activities\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      const activity = repo.saveActivity(req.authUser!.id, parsed.data);\\n      res.status(201).json({ activity });\\n    }\\n  );\\n\\n  router.put(\\n    \'/admin/activities/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      try {\\n        const activity = repo.saveActivity(req.authUser!.id, {\\n          ...parsed.data,\\n          id: req.params.id,\\n        });\\n        res.json({ activity });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to update activity.\';\\n        res.status(msg.includes(\'not found\') ? 404 : 400).json({ error: msg });\\n      }\\n    }\\n  );\\n\\n  router.patch(\\n    \'/admin/activities/:id/status\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const schema = z.object({ status: z.enum([\'draft\', \'published\', \'archived\']) });\\n      const parsed = schema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: \'Status must be draft, published, or archived.\' });\\n        return;\\n      }\\n      const updated = repo.updateActivityStatus(req.authUser!.id, req.params.id, parsed.data.status);\\n      if (!updated) {\\n        res.status(404).json({ error: \'Activity not found.\' });\\n        return;\\n      }\\n      res.json({ activity: updated });\\n    }\\n  );\\n\\n  router.delete(\\n    \'/admin/activities/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      try {\\n        const deleted = repo.deleteActivity(req.params.id, req.authUser!.id);\\n        if (!deleted) {\\n          res.status(404).json({ error: \'Activity not found.\' });\\n          return;\\n        }\\n        res.json({ ok: true });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to delete activity.\';\\n        res.status(409).json({ error: msg });\\n      }\\n    }\\n  );\\n\\n  // ---- Daily Plan Management ----\\n\\n  router.get(\'/admin/daily-plans\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' ? req.query.ageGroupId : \'ag_6-9m\';\\n    const plans = repo.listDailyPlansForAgeGroup(ageGroupId);\\n    const activities = repo.listActivities({ ageGroupId, status: \'published\' });\\n    res.json({ plans, activities });\\n  });\\n\\n  router.put(\\n    \'/admin/daily-plans\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = dailyPlanSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid daily plan data.\' });\\n        return;\\n      }\\n      const uniqueActivityIds = new Set(parsed.data.activityIds);\\n      if (uniqueActivityIds.size !== parsed.data.activityIds.length) {\\n        res.status(400).json({\\n          error: \'A daily plan cannot include the same activity more than once.\',\\n        });\\n        return;\\n      }\\n      for (const actId of uniqueActivityIds) {\\n        const act = repo.getActivityDetail(actId);\\n        if (!act || act.ageGroupId !== parsed.data.ageGroupId) {\\n          res.status(400).json({\\n            error: \'All activities in a daily plan must belong to the selected age group.\',\\n          });\\n          return;\\n        }\\n      }\\n      repo.upsertDailyPlan(parsed.data, req.authUser!.id);\\n      res.json({ plans: repo.listDailyPlansForAgeGroup(parsed.data.ageGroupId) });\\n    }\\n  );\\n\\n  router.delete(\\n    \'/admin/daily-plans/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const deleted = repo.deleteDailyPlan(req.params.id, req.authUser!.id);\\n      if (!deleted) {\\n        res.status(404).json({ error: \'Daily plan not found.\' });\\n        return;\\n      }\\n      res.json({ ok: true });\\n    }\\n  );\\n\\n  // ---- Reviewer Management ----\\n\\n  router.get(\'/admin/reviewers\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ reviewers: repo.listAdminReviewers() });\\n  });\\n\\n  router.post(\\n    \'/admin/reviewers\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = createReviewerSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid reviewer details.\' });\\n        return;\\n      }\\n      const existing = repo.findUserByEmail(parsed.data.email);\\n      if (existing) {\\n        res.status(409).json({ error: \'An account with this email already exists.\' });\\n        return;\\n      }\\n      const reviewer = repo.createReviewerAccount(req.authUser!.id, {\\n        email: parsed.data.email,\\n        fullName: parsed.data.fullName,\\n        passwordHash: hashPassword(parsed.data.password),\\n        allowedAgeGroupSlugs: parsed.data.allowedAgeGroupSlugs,\\n        specialtyNote: parsed.data.specialtyNote ?? null,\\n      });\\n      res.status(201).json({ reviewer });\\n    }\\n  );\\n\\n  router.patch(\\n    \'/admin/reviewers/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = updateReviewerSchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid reviewer update.\' });\\n        return;\\n      }\\n      const updated = repo.updateReviewerPermissions(req.authUser!.id, req.params.id, parsed.data);\\n      if (!updated) {\\n        res.status(404).json({ error: \'Reviewer account not found.\' });\\n        return;\\n      }\\n      res.json({ reviewer: updated });\\n    }\\n  );\\n\\n  // ---- Submission Management ----\\n\\n  router.get(\'/admin/submissions\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const statusParam = typeof req.query.status === \'string\' ? req.query.status : \'all\';\\n    const ageGroupSlug = typeof req.query.ageGroupSlug === \'string\' ? req.query.ageGroupSlug : \'all\';\\n    const submissions = repo.listAdminSubmissions({\\n      status: statusParam as \'queued\' | \'in_review\' | \'reviewed\' | \'resubmit_requested\' | \'deleted\' | \'all\',\\n      ageGroupSlug,\\n    });\\n    res.json({ submissions });\\n  });\\n\\n  router.patch(\\n    \'/admin/submissions/:id/assign\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const schema = z.object({ reviewerUserId: z.string().min(1).nullable() });\\n      const parsed = schema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: \'Invalid reviewer assignment payload.\' });\\n        return;\\n      }\\n      try {\\n        const submission = repo.assignSubmissionReviewer(\\n          req.authUser!.id,\\n          req.params.id,\\n          parsed.data.reviewerUserId\\n        );\\n        if (!submission) {\\n          res.status(404).json({ error: \'Submission not found.\' });\\n          return;\\n        }\\n        res.json({ submission });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to assign reviewer.\';\\n        res.status(400).json({ error: msg });\\n      }\\n    }\\n  );\\n\\n  // ---- User Management ----\\n\\n  router.get(\'/admin/users\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ users: repo.listAdminUsers() });\\n  });\\n\\n  router.patch(\\n    \'/admin/users/:id/role\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const schema = z.object({\\n        role: z.enum([\'parent\', \'reviewer\', \'admin\']).optional(),\\n        isActive: z.boolean().optional(),\\n      });\\n      const parsed = schema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: \'Invalid role or status update.\' });\\n        return;\\n      }\\n      if (req.params.id === req.authUser!.id && parsed.data.isActive === false) {\\n        res.status(400).json({ error: \'You cannot deactivate your own admin account.\' });\\n        return;\\n      }\\n      try {\\n        const updated = repo.updateUserRoleAndStatus(req.params.id, parsed.data, req.authUser!.id);\\n        if (!updated) {\\n          res.status(404).json({ error: \'User not found.\' });\\n          return;\\n        }\\n        res.json({ user: updated });\\n      } catch (err) {\\n        const msg = err instanceof Error ? err.message : \'Unable to update user.\';\\n        res.status(400).json({ error: msg });\\n      }\\n    }\\n  );\\n\\n  // ---- Unified Audit Logs & Retention ----\\n\\n  router.get(\'/admin/audit-logs\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const rawCat = typeof req.query.category === \'string\' ? req.query.category : \'all\';\\n    const category =\\n      rawCat === \'admin\' || rawCat === \'review\' || rawCat === \'media\' ? rawCat : \'all\';\\n    res.json({\\n      unifiedLogs: repo.listUnifiedAuditLogs({ category, limit: 200 }),\\n      logs: repo.listMediaAuditLogs(100),\\n      lastRetentionSweepAt: retentionWorker.lastSweepAt,\\n    });\\n  });\\n\\n  router.post(\\n    \'/admin/retention/run\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    async (req: AuthenticatedRequest, res) => {\\n      const result = await retentionWorker.runSweep();\\n      repo.logAdminAudit({\\n        actorUserId: req.authUser!.id,\\n        actorRole: \'admin\',\\n        action: \'retention_sweep_triggered\',\\n        entityType: \'system\',\\n        entityId: \'retention_30d\',\\n        summary: `Triggered manual 30-day video retention sweep (${result.purgedCount} expired file(s) purged)`,\\n        metadata: { purgedCount: result.purgedCount },\\n      });\\n      res.json(result);\\n    }\\n  );\\n\\n  return router;\\n}\", \"StartLine\":1211, \"TargetContent\":\"  // ======================== ADMIN CURRICULUM, PLANS, USERS & AUDIT ========================\\n\\n  router.get(\'/admin/overview\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json(repo.getAdminOverview(retentionWorker.lastSweepAt));\\n  });\\n\\n  router.get(\'/admin/activities\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' ? req.query.ageGroupId : undefined;\\n    const domainId = typeof req.query.domainId === \'string\' ? req.query.domainId : undefined;\\n    res.json({ activities: repo.listActivities({ ageGroupId, domainId }) });\\n  });\\n\\n  router.get(\'/admin/activities/:id\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const activity = repo.getActivityDetail(req.params.id);\\n    if (!activity) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({ activity });\\n  });\\n\\n  router.post(\\n    \'/admin/activities\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      const activity = repo.saveActivity(req.authUser!.id, parsed.data);\\n      res.status(201).json({ activity });\\n    }\\n  );\\n\\n  router.put(\\n    \'/admin/activities/:id\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const parsed = adminActivitySchema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid activity fields.\' });\\n        return;\\n      }\\n      const weightSum = parsed.data.rubricCriteria.reduce((acc, c) => acc + c.weightPoints, 0);\\n      if (weightSum !== 100) {\\n        res.status(400).json({\\n          error: `Rubric criteria weights must sum to 100 points (currently ${weightSum}).`,\\n        });\\n        return;\\n      }\\n      const activity = repo.saveActivity(req.authUser!.id, {\\n        ...parsed.data,\\n        id: req.params.id,\\n      });\\n      res.json({ activity });\\n    }\\n  );\\n\\n  router.delete(\'/admin/activities/:id\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const deleted = repo.deleteActivity(req.params.id);\\n    if (!deleted) {\\n      res.status(404).json({ error: \'Activity not found.\' });\\n      return;\\n    }\\n    res.json({ ok: true });\\n  });\\n\\n  router.get(\'/admin/daily-plans\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const ageGroupId = typeof req.query.ageGroupId === \'string\' ? req.query.ageGroupId : \'ag_6-9m\';\\n    const plans = repo.listDailyPlansForAgeGroup(ageGroupId);\\n    const activities = repo.listActivities({ ageGroupId, status: \'published\' });\\n    res.json({ plans, activities });\\n  });\\n\\n  router.put(\'/admin/daily-plans\', requireAuth, requireRole(\'admin\'), (req, res) => {\\n    const parsed = dailyPlanSchema.safeParse(req.body);\\n    if (!parsed.success) {\\n      res.status(400).json({ error: parsed.error.issues[0]?.message || \'Invalid daily plan data.\' });\\n      return;\\n    }\\n    const uniqueActivityIds = new Set(parsed.data.activityIds);\\n    if (uniqueActivityIds.size !== parsed.data.activityIds.length) {\\n      res.status(400).json({\\n        error: \'A daily plan cannot include the same activity more than once.\',\\n      });\\n      return;\\n    }\\n    for (const actId of uniqueActivityIds) {\\n      const act = repo.getActivityDetail(actId);\\n      if (!act || act.ageGroupId !== parsed.data.ageGroupId) {\\n        res.status(400).json({\\n          error: \'All activities in a daily plan must belong to the selected age group.\',\\n        });\\n        return;\\n      }\\n    }\\n    repo.upsertDailyPlan(parsed.data);\\n    res.json({ plans: repo.listDailyPlansForAgeGroup(parsed.data.ageGroupId) });\\n  });\\n\\n  router.get(\'/admin/users\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({ users: repo.listAllUsers() });\\n  });\\n\\n  router.patch(\\n    \'/admin/users/:id/role\',\\n    requireAuth,\\n    requireRole(\'admin\'),\\n    (req: AuthenticatedRequest, res) => {\\n      const schema = z.object({\\n        role: z.enum([\'parent\', \'reviewer\', \'admin\']).optional(),\\n        isActive: z.boolean().optional(),\\n      });\\n      const parsed = schema.safeParse(req.body);\\n      if (!parsed.success) {\\n        res.status(400).json({ error: \'Invalid role or status update.\' });\\n        return;\\n      }\\n      if (req.params.id === req.authUser!.id && parsed.data.isActive === false) {\\n        res.status(400).json({ error: \'You cannot deactivate your own admin account.\' });\\n        return;\\n      }\\n      const updated = repo.updateUserRoleAndStatus(req.params.id, parsed.data);\\n      if (!updated) {\\n        res.status(404).json({ error: \'User not found.\' });\\n        return;\\n      }\\n      res.json({ user: updated });\\n    }\\n  );\\n\\n  router.get(\'/admin/audit-logs\', requireAuth, requireRole(\'admin\'), (_req, res) => {\\n    res.json({\\n      logs: repo.listMediaAuditLogs(100),\\n      lastRetentionSweepAt: retentionWorker.lastSweepAt,\\n    });\\n  });\\n\\n  router.post(\'/admin/retention/run\', requireAuth, requireRole(\'admin\'), async (_req, res) => {\\n    const result = await retentionWorker.runSweep();\\n    res.json(result);\\n  });\\n\\n  return router;\\n}\"}], \"TargetFile\":\"/server/routes/api.ts\", \"toolAction\":\"Adding admin API endpoints to server routes\", \"toolSummary\":\"Add admin API routes\"}"
      thinking_signature: "\022\263\b\n\260\b\001i\024}\023\350\026\026Y\274\004G\314\357\330\274\t\325\334/\372}\241\024\245u\332>5\3468\305\342Q8\304y\a?\316\225\271\035\363PuA\365\216\276\315\005\321n\317\334x\361\365I&\303\2467\2172Jo\371\271cQ\301\374\203\267\033\233DL\367\212W\364a\316d\020\"\264\243\266`\375s\347\230\017\023~wt\233xn\336\344\037\230Xy=\032!p\001\350\265\031;\223j\212\002\310|\214\332\a\314\276\346\235\030\312\301\344\201\tN\264\311\315\215t\272\224Q+\263d\233,\331\005p/\360A\234Q\336S\025\2308\021\345\276\244\254\000G\315\3712\337I\230Uk3\004X1&m\372\222\341\260\226\264\245v\257\256L\212\310\021U\232$l\377\002\334\225C\366\017\262\302\253=\227]\310m\344\326Xp\314\006\"\311\317\321(\243\017\243\310\214\235\302\377\230\362\252\224\354b\305\256\213\027\327\025\375d\021\262\017x2\370^\0061\3276\026\333T\354\223\263E\004\b\034M\232b\357p\2248\330\314\370\262\204dN\223\265\317\303\370\005\246\257\243\261\264&%\342xf\252\254\204\375\265!\223\n\303\334\231\367.\365\006\305\033\255^0\306z+\021x\366?\262b\245lt7[w_\315\373\226\024\264\264w\262I\231\257,Z\320\215\3007\023=5a\024\202\202\347X\332\346\230\266\241d7d\270\226\\\300\264\225R\262\f#\247~\334I F\222\026-\323\246 y\271q\356\373U\246o\247b\275\270)\356\271\327=\263\352\216\275a{\3236\332m\305\217\335\346\374<=\302\261:\002\263-\2371A9q\302\201b\250\241vdm\337\201\345\\$\232\305Kae\224\326\'Q\032\304]\016\240B\263\273\356\373\324\v\001\227\252\213\330\366xu\276(mH\245\a\211\366FH\345U\324j\246\313\214`\215A\032\317@\345\030u\205_\n\237l/\300b%\rR>\231/!Kl\n\002P\231\324U;\345\227qIQn\376\223<\330\245\315f\333\355!\030&7\320}\234\257NlH\207\036\372\317|,\335\376*KL`.n\006\016y\271\365\345i\206\"\203\324\375\351\263:u\273\235\215\347\235\270\2033z\2457+\316\365S\255\310\302\274\266\275[\361\312gsThc\314\226\232C\005\365\374z\200|M\351\215R%\257\304\201iQ\036\024\'\226f+\356\273+\331!e+\276Y)\307\251\265\345\352Q\325\231\210\306\353\\6\255:\3631`\276:\350h*\000\234U\302\312m/\003\240\257\'\213\306[\037,<\274C\313\204Rd\364S\351\035\035cd\216G\021\247\332\2517\035,\243[\036Y\276\220\320\201T\341\3472*T\366Su\330x\325\035UJ\006F\321C\035\343S\020\303\242\335\270\016F=W\016\001\v\271P(\000G/\375\220\362\305\226\355x@S\034By\244o\226\223\017\332\342SU\330\327\216Vl_\236\003^,\006\326\260\346\210x\276\201\364\033\003!\264\353\313\3064\006:\314\022k\024\271Q\366\377S\344\260)\375}\310\271\025\263\017\230\356\361DK\3200\261\016\004\225[\023\203\347\344?\227\330\aj\371\275)\252A\323\v~~\225\361\230\273\240\'\344kN\037\315\272[\260\2567(v\2619\376\235z\355\270ndn\332pc\036\035\305\2064\035\204:\221\263\343\031;\215\204\025X5K\242S\265\025\025\023\254\305)\3115Dl\":\005\037\r\322\307\351hV\204\331\322\233T\332\323c\b\250\264yw\330x\216BC\n\355\302{\241\252\336\021\266(:k\261Pm\327g#\241\000\317\234h\256\314\374\376l\323R\221\266\251\370\375\275\374\315r\260\a\272\006\267\031\315)\336~\2241U@\212+\037\346\277x\006\357Q\263\027}\211\244\027\340\020\323\360\361\034=^?X\243D\335\341Y\262\240m\250\f%\252\352;p7\300\211a\2507\323\n\005;U\005\302\361\360[\3256I\026\343\030:\037\036"
