              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    safetyNotes: \'Keep peg upright on a stable low table or floor mat while seated.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
