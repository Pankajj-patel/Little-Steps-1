      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Button } from \'./Button\';\\nimport { Modal } from \'./Modal\';\\n\\nexport interface ConfirmDialogProps {\\n  open: boolean;\\n  onClose: () => void;\\n  onConfirm: () => void;\\n  title: string;\\n  message: string;\\n  confirmLabel?: string;\\n  cancelLabel?: string;\\n  destructive?: boolean;\\n  loading?: boolean;\\n}\\n\\nexport function ConfirmDialog({\\n  open,\\n  onClose,\\n  onConfirm,\\n  title,\\n  message,\\n  confirmLabel = \'Confirm\',\\n  cancelLabel = \'Cancel\',\\n  destructive = false,\\n  loading = false,\\n}: ConfirmDialogProps) {\\n  return (\\n    <Modal\\n      open={open}\\n      onClose={onClose}\\n      title={title}\\n      size=\\\"sm\\\"\\n      footer={\\n        <>\\n          <Button variant=\\\"subtle\\\" onClick={onClose} disabled={loading}>\\n            {cancelLabel}\\n          </Button>\\n          <Button\\n            variant={destructive ? \'danger\' : \'primary\'}\\n            onClick={onConfirm}\\n            loading={loading}\\n          >\\n            {confirmLabel}\\n          </Button>\\n        </>\\n      }\\n    >\\n      <p className=\\\"text-sm text-muted leading-relaxed\\\">{message}</p>\\n    </Modal>\\n  );\\n}\\n\", \"Description\":\"Create reusable ConfirmDialog component built on Modal for safe destructive and non-destructive confirmations.\", \"Overwrite\":true, \"TargetFile\":\"/src/design-system/ConfirmDialog.tsx\", \"toolAction\":\"Creating ConfirmDialog component\", \"toolSummary\":\"Create ConfirmDialog component\"}"
      original_name: "write_to_file"
    }
