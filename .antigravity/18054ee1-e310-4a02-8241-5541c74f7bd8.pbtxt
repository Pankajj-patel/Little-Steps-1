      thinking_signature: "\022\245\f\n\242\f\001i\024}\023\207\351J\340\203nv\f\035\032\303O\327\207\350>\266\342\021x~\365\300\367\247Y.\034\3152V\324\261\227\365\274\312\347vN\023y\a{\034\363}xQ`\244\370\213(8^\026f\017|\nk/\275\363@\001\221|\276wo\327\275\264FU\315\222T`,Q\351\3602\203ndx\217\220\030ftAf\322 \307\026s\227\240\336\205\251\334\300\033\210\2239\300>v\366\201>\0314\360\177\277\376\216\323\a \217^\005\207\233\330\303\236\b\333q\351\231\253Nq\261\261\255%\327\2600B\212\364e\vs\350w\276\230bg{\304\233\004\325\313I\340tw}$\f\034\312\266\033\252D\334\022\335\260\321\374yc\313\242\002\031\365\255\277^\261%\206\306\335a\250\1776\247ym\374\331\025\346\344\230\321\022\205)S\276X\314h\377\001l\026\377\327.\322\217\365+\306\003\311\274M\357\334\003\247r\351\371\270\375\310\340\314\202\240\366\343\006P|\310#\341\362\361a\206\022\276a\036B\227z\213q\036\361rQ\002\325\307\325w\vm\177\265p 4\272\325{i\215\232&\370\001\322\205TeEG\246<re\331\205\230\236\266\222DC\b\234\226\v;\v\244\223M7\006\210\315{\217a\354\332\256`\252\'\235\331\376A/\376\274(\324\223\003\023\273)\344\314\332\022~\230\273\262\377\025\306\240\224\375\343]c\\\203\364t\334\327\352\312gK&\266t\242\263^\006R\022J\003\304\337V\221\306\361p\333\371Jn\033\t0S\224\332\0353\300\367P%\251\206X\3531N\261\016\235\224l%\327\203\372\306\233\312c\023\253|\347b\262\237\024\003\223-\n\342\214X2B\267&\367\272\274\232\221\232\205\221+\027r\230>UP-\375p\326\306S\t*3\362D/\307\362j3\004Rj\334a\331\361\'\020`4j\212{\357\"\274\271\225GD\246%~V\376\301\371\311\301\241}h\343\367A\177\207\231\302\244s\373:\351B\243\353\326\211\325B\223\024\336#\322\225\201\316\254\"\216\2221\023\320\357\314\274\021!v\a: \005\231\224q\342]\264aHd\342\316&nsI~\330\305\277B\r\v\n\211cW@$\321\235I\203F\334\351x{f\267\305a\375H\'\n:q\002\210\366\250]\376\271+X\275\236\006\253\r~\026\265\304\002o\310\355\nwCT\364\232\362\036\000\336\305\377\226\340\365\a\371\024\000\305M\036\371Z)\344\253\274\rd\2667\307\214\210m3\274\201\232\247\021]\202s\0034\227\232\341\217\3717\362\355=%\345;\0047\343a\341\263\350\256\006\244i!\200\303%\222(\323\024hA\342\316\205M\365\367\355f\b\307a\000X\245\022\342\235\033\001\030\302\211[\341\026\034\353D\245\312CE\344\332E~`\366&\336\312\351\017M\357\3458J\016\260m\211\t\221\v\376J\367\327\004\214\255\323\215\376\275\035,\205\243\324\030\347\333\305b\376~k\263~\f/4\0308\365\267O\257Q\362\304\241\\\354\001&ow\025\261\313(\226\177\f4FR\301\351\3458Zk\377\347\f\004\330{\234\332\237\370\276\277-\335CsVz\250qI\323C\326\311\312\301\030\221\245\225\263rf\205}Y=Q\223\354\337\232\370\353\330\006\006N\b\271q\334+\335\335\026\250\310\243{\032\352\\,\303G \355\362\331\006_HL\303\300\216\3449\311Y\215Z0\327\037\260\233<\203!%\326\311z\232\266\354n\272/C \332\251\036\323\300\317\\P\325\234\355w\022\036&\314Pt\340\373:\336\314\346\346\n\223\233,\351\311\357\277\230\205\325\370IL0T\236\337\370 \035\021\353O\272\021\261\201\316\274\350\202sEL1O\216\001N,o\337\361Z\2614P\366*\220\321\227\342\351\361\326.\v@L\362\371\377\226\3103\265\353\022&Q\306\264\276\253\321\246\001\256y8G\301,!\234r\225\017\370\2654A\277\302\225\023\245\212h\364;Y\265\231\200\305c\326ch\\voKI\020+\260\006\314\250\030\234C=\263[\221@x\212dU\244\306\345)8\374\326\032I/\350\300\376\213\307 \230\367\261\t\002G\231\277XLC\377\376Q7\333|I\311^&\240h\260\252m\000\373X)z\350\226:\2609\272\272\326\244\201\004\251Y\204\036BGJ\336\"w\025\341\353\364}\034\3031\023\227\036\323M=g7>o\016\006\224\245\375\252\021\203~\320?\024\364\025O\005\256\030\025ph\250ZyU\236\257;\037\225!\214\215\2672F60\230k\353\353OiI\255G\334\ra\377n\335\212\277\237i\376\245r\337\353\257&\251\343\224\314\216o\365F\"\260\212\374N\032Pj\257~\032\3308\211#q\300?\313\0268\002\271\375Y\206Kb\200ca\377\261\232\020\v\320\356\265\312hH\300\241[\226\240\3506>\377]\202\025<\255lbDc\271\351D\251\354,\254\222\036\246\317\002\355\252G\220\370\302\2159\272\037\343\343\b\335h\207\026Bt\374\362\346\340\315D\314\361\251\023\375\342#\awM\021\271\302R\200{u\255\302,\255L\270\362\2459\2