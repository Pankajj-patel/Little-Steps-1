            }
            lines {
              text: "    const cols = db.prepare(`PRAGMA table_info(${table})`).all() as Array<{ name: string }>;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (!cols.some((c) => c.name === column)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      db.exec(`ALTER TABLE ${table} ADD COLUMN ${column} ${definition}`);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    }"
