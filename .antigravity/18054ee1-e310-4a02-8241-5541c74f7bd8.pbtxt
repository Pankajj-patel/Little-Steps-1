          replacement_content: "            `UPDATE activities\n             SET age_group_id = ?, domain_id = ?, title = ?, summary = ?, duration_minutes = ?,\n                 materials_json = ?, safety_notes = ?, instructional_poster_url = ?, status = ?,\n                 version = COALESCE(version, 1) + 1,\n                 updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\n             WHERE id = ?`"
