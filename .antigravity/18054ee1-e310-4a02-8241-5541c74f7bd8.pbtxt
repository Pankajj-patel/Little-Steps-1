      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Document production private object storage environment variables in .env.example.\", \"EndLine\":16, \"Instruction\":\"Add OBJECT_STORAGE_PROVIDER and OBJECT_STORAGE_BUCKET placeholders to .env.example.\", \"ReplacementContent\":\"# LittleSteps Security & Storage Configuration\\nSQLITE_DB_PATH=\\\"./data/littlesteps.db\\\"\\nPRIVATE_MEDIA_DIR=\\\"./private_media\\\"\\nOBJECT_STORAGE_PROVIDER=\\\"\\\"\\nOBJECT_STORAGE_BUCKET=\\\"\\\"\", \"StartLine\":11, \"TargetContent\":\"# LittleSteps Security Secrets (override with strong random 32+ char strings in production)\\nSESSION_SECRET=\\\"replace-with-strong-session-secret\\\"\\nVIDEO_TOKEN_SECRET=\\\"replace-with-strong-video-token-secret\\\"\\nSQLITE_DB_PATH=\\\"./data/littlesteps.db\\\"\\nPRIVATE_MEDIA_DIR=\\\"./private_media\\\"\", \"TargetFile\":\"/.env.example\", \"toolAction\":\"Updating .env.example storage config\", \"toolSummary\":\"Update .env.example\"}"
      original_name: "replace_file_content"
    }
