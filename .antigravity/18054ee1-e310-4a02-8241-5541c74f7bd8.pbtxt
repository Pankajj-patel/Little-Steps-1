    content: "import React, { useMemo, useState } from \'react\';\nimport {\n  ArrowRight,\n  Award,\n  Calendar,\n  CalendarClock,\n  CheckCircle2,\n  CircleDashed,\n  Clock,\n  History,\n  PlayCircle,\n  ShieldCheck,\n  Sparkles,\n  UploadCloud,\n} from \'lucide-react\';\nimport { EditorialImage } from \'../../components/EditorialImage\';\nimport {\n  ActivityCard,\n  Badge,\n  Button,\n  Card,\n  EmptyState,\n  ProgressIndicator,\n  Tabs,\n  type BadgeTone,\n} from \'../../design-system\';\nimport { formatDateReadable } from \'../../shared/i18n\';\nimport type {\n  ActivityDetail,\n  ActivityPrepLevel,\n  JourneyActivityItem,\n  JourneyDisplayStatus,\n  LocaleCode,\n  TodayJourneyResponse,\n} from \'../../shared/types\';\n\nexport function formatPrepLevel(prepLevel?: ActivityPrepLevel): string {\n  switch (prepLevel) {\n    case \'no_prep\':\n      return \'No prep\';\n    case \'guided_prep\':\n      return \'Guided setup\';\n    case \'quick_setup\':\n    default:\n      return \'2-min setup\';\n  }\n}\n\nexport function getJourneyStatusMeta(item: JourneyActivityItem): {\n  statusState: JourneyDisplayStatus;\n  statusText: string;\n  statusTone: BadgeTone;\n  actionLabel: string;\n} {\n  const statusState = item.displayStatus;\n  switch (statusState) {\n    case \'reviewed\': {\n      const score = item.latestSubmission?.review?.instructionMatchScorePct;\n      return {\n        statusState,\n        statusText: score !== undefined ? `Reviewed \302\267 ${score}%` : \'Reviewed\',\n        statusTone: \'sage\',\n        actionLabel: \'Read Feedback\',\n      };\n    }\n    case \'submitted_for_review\':\n      return {\n        statusState,\n        statusText: \'Submitted for review\',\n        statusTone: \'lavender\',\n        actionLabel: \'View Submission\',\n      };\n    case \'completed\':\n      return {\n        statusState,\n        statusText: \'Completed\',\n        statusTone: \'sage\',\n        actionLabel: \'View Activity\',\n      };\n    case \'in_progress\':\n      return {\n        statusState,\n        statusText: \'In progress\',\n        statusTone: \'peach\',\n        actionLabel: \'Resume Activity\',\n      };\n    case \'not_started\':\n    default:\n      return {\n        statusState: \'not_started\',\n        statusText: \'Not started\',\n        statusTone: \'neutral\',\n        actionLabel: \'Start Activity\',\n      };\n  }\n}\n\ninterface MyPlanSectionProps {\n  journey: TodayJourneyResponse;\n  selectedDay: number;\n  locale: LocaleCode;\n  onSelectDay: (dayNumber: number) => void;\n  onOpenActivity: (activityOrId: ActivityDetail | string) => void;\n  onOpenLibrary: () => void;\n}\n\ntype PlanTab = \'today\' | \'upcoming\' | \'completed\';\n\nexport function MyPlanSection({\n  journey,\n  selectedDay,\n  locale,\n  onSelectDay,\n  onOpenActivity,\n  onOpenLibrary,\n}: MyPlanSectionProps) {\n  const [activeTab, setActiveTab] = useState<PlanTab>(\'today\');\n\n  const todayFormatted = useMemo(() => {\n    const dt = new Date(`${journey.learningWeek.todayDateIso}T12:00:00`);"
