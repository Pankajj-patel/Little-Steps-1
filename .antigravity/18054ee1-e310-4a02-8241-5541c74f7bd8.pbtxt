        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useState } from \'react\';\nimport { MailCheck } from \'lucide-react\';\nimport { PublicLayout } from \'./components/PublicLayout\';\nimport { TopBar, type TopBarNavItem } from \'./components/TopBar\';\nimport { AuthProvider, useAuth } from \'./context/AuthContext\';\nimport { Button, ToastProvider, useToast } from \'./design-system\';\nimport { usePublicRouter, type NavigateTarget, type PublicRoute } from \'./lib/router\';\nimport { AdminConsoleView, type AdminTab } from \'./pages/AdminConsoleView\';\nimport { DesignSystemShowcasePage } from \'./pages/DesignSystemShowcasePage\';\nimport { ParentJourneyView, type ParentTab } from \'./pages/ParentJourneyView\';\nimport { ParentOnboardingView } from \'./pages/ParentOnboardingView\';\nimport { ReviewerWorkbenchView } from \'./pages/ReviewerWorkbenchView\';\nimport {\n  ForgotPasswordPage,\n  LoginPage,\n  RegisterPage,\n  ResetPasswordPage,\n  VerifyEmailPage,\n} from \'./pages/public/AuthPages\';\nimport { HomePage } from \'./pages/public/HomePage\';\nimport { AboutPage, HowItWorksPage, OurApproachPage } from \'./pages/public/InfoPages\';\nimport { ContactPage, PrivacyPolicyPage, TermsPage } from \'./pages/public/SupportLegalPages\';\n\nfunction AuthenticatedWorkspace({\n  onOpenDesignSystem,\n  onNavigate,\n  onLogout,\n}: {\n  onOpenDesignSystem: () => void;\n  onNavigate: (target: NavigateTarget) => void;\n  onLogout: () => Promise<void>;\n}) {\n  const { user, t, verificationPreviewPath } = useAuth();\n  const [parentTab, setParentTab] = useState<ParentTab>(\'today\');\n  const [adminTab, setAdminTab] = useState<AdminTab>(\'curriculum\');\n\n  if (!user) return null;\n\n  if (user.role === \'parent\') {\n    const navItems: TopBarNavItem[] = [\n      { id: \'today\', label: t(\'nav.today\') },\n      { id: \'feedback\', label: t(\'nav.feedback\') },\n      { id: \'progress\', label: t(\'nav.progress\') },\n      { id: \'design-system\', label: \'Design System\' },\n    ];\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        <TopBar\n          navItems={navItems}\n          activeNavId={parentTab}\n          onSelectNav={(id) => {\n            if (id === \'design-system\') {\n              onOpenDesignSystem();\n              return;\n            }\n            setParentTab(id as ParentTab);\n          }}\n          primaryActionLabel={t(\'auth.signOut\')}\n          onPrimaryAction={() => void onLogout()}\n          onBrandClick={() => setParentTab(\'today\')}\n        />\n\n        {!user.emailVerifiedAt && (\n          <div className=\"bg-peach-soft/80 border-b border-peach\">\n            <div className=\"max-w-5xl mx-auto px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs\">\n              <span className=\"inline-flex items-center gap-2 text-charcoal\">\n                <MailCheck className=\"w-4 h-4 text-peach-ink shrink-0\" aria-hidden=\"true\" />\n                Please verify your email ({user.email}) so you can recover your account safely.\n              </span>\n              <Button\n                variant=\"secondary\"\n                size=\"sm\"\n                onClick={() =>\n                  onNavigate((verificationPreviewPath || \'/verify-email\') as NavigateTarget)\n                }\n              >\n                Verify Email\n              </Button>\n            </div>\n          </div>\n        )}\n\n        <main className=\"flex-1\">\n          <ParentJourneyView activeTab={parentTab} onChangeTab={setParentTab} />\n        </main>\n      </div>\n    );\n  }\n\n  if (user.role === \'reviewer\') {\n    const navItems: TopBarNavItem[] = [\n      { id: \'queue\', label: t(\'nav.queue\') },\n      { id: \'design-system\', label: \'Design System\' },\n    ];\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        <TopBar\n          navItems={navItems}\n          activeNavId=\"queue\"\n          onSelectNav={(id) => {\n            if (id === \'design-system\') onOpenDesignSystem();\n          }}\n          primaryActionLabel={t(\'auth.signOut\')}\n          onPrimaryAction={() => void onLogout()}\n        />\n        <main className=\"flex-1\">\n          <ReviewerWorkbenchView />\n        </main>\n      </div>\n    );\n  }\n\n  const adminNavItems: TopBarNavItem[] = [\n    { id: \'curriculum\', label: t(\'nav.curriculum\') },\n    { id: \'plans\', label: t(\'nav.plans\') },\n    { id: \'users\', label: t(\'nav.users\') },\n    { id: \'privacy\', label: t(\'nav.privacy\') },\n    { id: \'design-system\', label: \'Design System\' },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n      <TopBar\n        navItems={adminNavItems}\n        activeNavId={adminTab}\n        onSelectNav={(id) => {\n          if (id === \'design-system\') {\n            onOpenDesignSystem();\n            return;\n          }\n          setAdminTab(id as AdminTab);\n        }}\n        primaryActionLabel={t(\'auth.signOut\')}\n        onPrimaryAction={() => void onLogout()}\n        onBrandClick={() => setAdminTab(\'curriculum\')}\n      />\n      <main className=\"flex-1\">\n        <AdminConsoleView activeTab={adminTab} />\n      </main>\n    </div>\n  );\n}\n\nfunction LittleStepsRouter() {\n  const { user, loading, logout, t } = useAuth();\n  const { notify } = useToast();\n  const { route, getQueryParam, navigate } = usePublicRouter();\n\n  const handleLogout = async () => {\n    await logout();\n    notify({\n      tone: \'info\',\n      title: \'Signed out safely\',\n      description: \'See you soon for your next calm moment.\',\n    });\n    navigate(\'/login\');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-offwhite flex items-center justify-center\">\n        <p className=\"font-display text-lg text-muted\">Preparing LittleSteps...</p>\n      </div>\n    );\n  }\n\n  // Step 1 Design System Reference accessible anytime via /design-system\n  if (route === \'/design-system\') {\n    return <DesignSystemShowcasePage onOpenPrototype={() => navigate(\'/\')} />;\n  }\n\n  // Allow email verification and password reset pages to work whether logged in or signed out\n  if (route === \'/verify-email\') {\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        {user ? (\n          <TopBar\n            navItems={[]}\n            activeNavId=\"\"\n            onSelectNav={() => {}}\n            primaryActionLabel={t(\'auth.signOut\')}\n            onPrimaryAction={() => void handleLogout()}\n            onBrandClick={() => navigate(\'/\')}\n          />\n        ) : null}\n        {user ? (\n          <main className=\"flex-1\">\n            <VerifyEmailPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n          </main>\n        ) : (\n          <PublicLayout currentRoute={route} onNavigate={navigate}>\n            <VerifyEmailPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n          </PublicLayout>\n        )}\n      </div>\n    );\n  }\n\n  if (route === \'/reset-password\') {\n    return (\n      <PublicLayout currentRoute={route} onNavigate={navigate}>\n        <ResetPasswordPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n      </PublicLayout>\n    );\n  }\n\n  // Step 3 Parent Onboarding Gate: guide newly registered mothers step-by-step before entering dashboard\n  if (user && user.role === \'parent\' && !user.onboardingCompletedAt) {\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        <TopBar\n          navItems={[]}\n          activeNavId=\"\"\n          onSelectNav={() => {}}\n          primaryActionLabel={t(\'auth.signOut\')}\n          onPrimaryAction={() => void handleLogout()}\n        />\n        <main className=\"flex-1\">\n          <ParentOnboardingView onNavigate={navigate} />\n        </main>\n      </div>\n    );\n  }\n\n  // Authenticated users enter their role workspace cleanly\n  if (user) {\n    return (\n      <AuthenticatedWorkspace\n        onOpenDesignSystem={() => navigate(\'/design-system\')}\n        onNavigate={navigate}\n        onLogout={handleLogout}\n      />\n    );\n  }\n\n  // Step 2 & Step 3 Public & Authentication Website\n  const renderPublicPage = (activeRoute: PublicRoute) => {\n    switch (activeRoute) {\n      case \'/\':\n        return <HomePage onNavigate={navigate} />;\n      case \'/about\':\n        return <AboutPage onNavigate={navigate} />;\n      case \'/how-it-works\':\n        return <HowItWorksPage onNavigate={navigate} />;\n      case \'/our-approach\':\n        return <OurApproachPage onNavigate={navigate} />;\n      case \'/contact\':\n        return <ContactPage onNavigate={navigate} />;\n      case \'/privacy\':\n        return <PrivacyPolicyPage onNavigate={navigate} />;\n      case \'/terms\':\n        return <TermsPage onNavigate={navigate} />;\n      case \'/login\':\n        return <LoginPage onNavigate={navigate} />;\n      case \'/register\':\n        return <RegisterPage onNavigate={navigate} />;\n      case \'/forgot-password\':\n        return <ForgotPasswordPage onNavigate={navigate} />;\n      default:\n        return <HomePage onNavigate={navigate} />;\n    }\n  };\n\n  return (\n    <PublicLayout currentRoute={route} onNavigate={navigate}>\n      {renderPublicPage(route)}\n    </PublicLayout>\n  );\n}\n\nexport default function App() {\n  return (\n    <ToastProvider>\n      <AuthProvider>\n        <LittleStepsRouter />\n      </AuthProvider>\n    </ToastProvider>\n  );\n}"
          replacement_content: "import React, { useState } from \'react\';\nimport { PublicLayout } from \'./components/PublicLayout\';\nimport { TopBar, type TopBarNavItem } from \'./components/TopBar\';\nimport { AuthProvider, useAuth } from \'./context/AuthContext\';\nimport { ToastProvider, useToast } from \'./design-system\';\nimport { usePublicRouter, type NavigateTarget, type PublicRoute } from \'./lib/router\';\nimport { AdminConsoleView, type AdminTab } from \'./pages/AdminConsoleView\';\nimport { DesignSystemShowcasePage } from \'./pages/DesignSystemShowcasePage\';\nimport { ParentDashboardView } from \'./pages/ParentDashboardView\';\nimport { ParentOnboardingView } from \'./pages/ParentOnboardingView\';\nimport { ReviewerWorkbenchView } from \'./pages/ReviewerWorkbenchView\';\nimport {\n  ForgotPasswordPage,\n  LoginPage,\n  RegisterPage,\n  ResetPasswordPage,\n  VerifyEmailPage,\n} from \'./pages/public/AuthPages\';\nimport { HomePage } from \'./pages/public/HomePage\';\nimport { AboutPage, HowItWorksPage, OurApproachPage } from \'./pages/public/InfoPages\';\nimport { ContactPage, PrivacyPolicyPage, TermsPage } from \'./pages/public/SupportLegalPages\';\n\nfunction AuthenticatedWorkspace({\n  onOpenDesignSystem,\n  onNavigate,\n  onLogout,\n}: {\n  onOpenDesignSystem: () => void;\n  onNavigate: (target: NavigateTarget) => void;\n  onLogout: () => Promise<void>;\n}) {\n  const { user, t } = useAuth();\n  const [adminTab, setAdminTab] = useState<AdminTab>(\'curriculum\');\n\n  if (!user) return null;\n\n  // Step 4 Parent Dashboard owns its dedicated desktop sidebar, top header, and mobile bottom nav\n  if (user.role === \'parent\') {\n    return (\n      <ParentDashboardView\n        onNavigate={onNavigate}\n        onOpenDesignSystem={onOpenDesignSystem}\n        onLogout={onLogout}\n      />\n    );\n  }\n\n  if (user.role === \'reviewer\') {\n    const navItems: TopBarNavItem[] = [\n      { id: \'queue\', label: t(\'nav.queue\') },\n      { id: \'design-system\', label: \'Design System\' },\n    ];\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        <TopBar\n          navItems={navItems}\n          activeNavId=\"queue\"\n          onSelectNav={(id) => {\n            if (id === \'design-system\') onOpenDesignSystem();\n          }}\n          primaryActionLabel={t(\'auth.signOut\')}\n          onPrimaryAction={() => void onLogout()}\n        />\n        <main className=\"flex-1\">\n          <ReviewerWorkbenchView />\n        </main>\n      </div>\n    );\n  }\n\n  const adminNavItems: TopBarNavItem[] = [\n    { id: \'curriculum\', label: t(\'nav.curriculum\') },\n    { id: \'plans\', label: t(\'nav.plans\') },\n    { id: \'users\', label: t(\'nav.users\') },\n    { id: \'privacy\', label: t(\'nav.privacy\') },\n    { id: \'design-system\', label: \'Design System\' },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n      <TopBar\n        navItems={adminNavItems}\n        activeNavId={adminTab}\n        onSelectNav={(id) => {\n          if (id === \'design-system\') {\n            onOpenDesignSystem();\n            return;\n          }\n          setAdminTab(id as AdminTab);\n        }}\n        primaryActionLabel={t(\'auth.signOut\')}\n        onPrimaryAction={() => void onLogout()}\n        onBrandClick={() => setAdminTab(\'curriculum\')}\n      />\n      <main className=\"flex-1\">\n        <AdminConsoleView activeTab={adminTab} />\n      </main>\n    </div>\n  );\n}\n\nfunction LittleStepsRouter() {\n  const { user, loading, logout, t } = useAuth();\n  const { notify } = useToast();\n  const { route, getQueryParam, navigate } = usePublicRouter();\n\n  const handleLogout = async () => {\n    await logout();\n    notify({\n      tone: \'info\',\n      title: \'Signed out safely\',\n      description: \'See you soon for your next calm moment.\',\n    });\n    navigate(\'/login\');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-offwhite flex items-center justify-center\">\n        <p className=\"font-display text-lg text-muted\">Preparing LittleSteps...</p>\n      </div>\n    );\n  }\n\n  // Step 1 Design System Reference accessible anytime via /design-system\n  if (route === \'/design-system\') {\n    return <DesignSystemShowcasePage onOpenPrototype={() => navigate(\'/\')} />;\n  }\n\n  // Allow email verification and password recovery pages whether logged in or signed out\n  if (route === \'/verify-email\') {\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        {user ? (\n          <>\n            <TopBar\n              navItems={[]}\n              activeNavId=\"\"\n              onSelectNav={() => {}}\n              primaryActionLabel={t(\'auth.signOut\')}\n              onPrimaryAction={() => void handleLogout()}\n              onBrandClick={() => navigate(\'/\')}\n            />\n            <main className=\"flex-1\">\n              <VerifyEmailPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n            </main>\n          </>\n        ) : (\n          <PublicLayout currentRoute={route} onNavigate={navigate}>\n            <VerifyEmailPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n          </PublicLayout>\n        )}\n      </div>\n    );\n  }\n\n  if (route === \'/forgot-password\') {\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        {user ? (\n          <>\n            <TopBar\n              navItems={[]}\n              activeNavId=\"\"\n              onSelectNav={() => {}}\n              primaryActionLabel=\"Back to Dashboard\"\n              onPrimaryAction={() => navigate(\'/\')}\n              onBrandClick={() => navigate(\'/\')}\n            />\n            <main className=\"flex-1\">\n              <ForgotPasswordPage onNavigate={navigate} />\n            </main>\n          </>\n        ) : (\n          <PublicLayout currentRoute={route} onNavigate={navigate}>\n            <ForgotPasswordPage onNavigate={navigate} />\n          </PublicLayout>\n        )}\n      </div>\n    );\n  }\n\n  if (route === \'/reset-password\') {\n    return (\n      <PublicLayout currentRoute={route} onNavigate={navigate}>\n        <ResetPasswordPage onNavigate={navigate} initialToken={getQueryParam(\'token\')} />\n      </PublicLayout>\n    );\n  }\n\n  // Step 3 Parent Onboarding Gate: guide newly registered mothers step-by-step before entering dashboard\n  if (user && user.role === \'parent\' && !user.onboardingCompletedAt) {\n    return (\n      <div className=\"min-h-screen bg-offwhite text-charcoal flex flex-col\">\n        <TopBar\n          navItems={[]}\n          activeNavId=\"\"\n          onSelectNav={() => {}}\n          primaryActionLabel={t(\'auth.signOut\')}\n          onPrimaryAction={() => void handleLogout()}\n        />\n        <main className=\"flex-1\">\n          <ParentOnboardingView onNavigate={navigate} />\n        </main>\n      </div>\n    );\n  }\n\n  // Authenticated users enter their role workspace cleanly\n  if (user) {\n    return (\n      <AuthenticatedWorkspace\n        onOpenDesignSystem={() => navigate(\'/design-system\')}\n        onNavigate={navigate}\n        onLogout={handleLogout}\n      />\n    );\n  }\n\n  // Step 2 & Step 3 Public & Authentication Website\n  const renderPublicPage = (activeRoute: PublicRoute) => {\n    switch (activeRoute) {\n      case \'/\':\n        return <HomePage onNavigate={navigate} />;\n      case \'/about\':\n        return <AboutPage onNavigate={navigate} />;\n      case \'/how-it-works\':\n        return <HowItWorksPage onNavigate={navigate} />;\n      case \'/our-approach\':\n        return <OurApproachPage onNavigate={navigate} />;\n      case \'/contact\':\n        return <ContactPage onNavigate={navigate} />;\n      case \'/privacy\':\n        return <PrivacyPolicyPage onNavigate={navigate} />;\n      case \'/terms\':\n        return <TermsPage onNavigate={navigate} />;\n      case \'/login\':\n        return <LoginPage onNavigate={navigate} />;\n      case \'/register\':\n        return <RegisterPage onNavigate={navigate} />;\n      default:\n        return <HomePage onNavigate={navigate} />;\n    }\n  };\n\n  return (\n    <PublicLayout currentRoute={route} onNavigate={navigate}>\n      {renderPublicPage(route)}\n    </PublicLayout>\n  );\n}\n\nexport default function App() {\n  return (\n    <ToastProvider>\n      <AuthProvider>\n        <LittleStepsRouter />\n      </AuthProvider>\n    </ToastProvider>\n  );\n}\n"
