      arguments_json: "{\"Description\":\"Wire Step 9 ProgressDashboardSection into ParentDashboardView with learningDomains and onOpenActivity handler.\", \"Instruction\":\"Import ProgressDashboardSection and mount it for the progress section in src/pages/ParentDashboardView.tsx.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":62, \"ReplacementContent\":\"import {\\n  ActivitiesLibrarySection,\\n  NotificationsSection,\\n  ParentingGuidesSection,\\n  ProfileSection,\\n  SettingsSection,\\n} from \'./parent/ParentSecondaryViews\';\\nimport { ProgressDashboardSection } from \'./parent/ProgressDashboardSection\';\", \"StartLine\":51, \"TargetContent\":\"import {\\n  ActivitiesLibrarySection,\\n  NotificationsSection,\\n  ParentingGuidesSection,\\n  ProfileSection,\\n  ProgressAndFeedbackSection,\\n  SettingsSection,\\n} from \'./parent/ParentSecondaryViews\';\"}, {\"AllowMultiple\":false, \"EndLine\":1185, \"ReplacementContent\":\"          {/* =============================================================== */}\\n          {/* PRIMARY TAB 4: PROGRESS TRACKING, ACTIVITY & REVIEW HISTORY     */}\\n          {/* =============================================================== */}\\n          {!studioActivity && !loadingStudioActivity && journey && section === \'progress\' && (\\n            <ProgressDashboardSection\\n              journey={journey}\\n              learningDomains={learningDomains}\\n              locale={locale}\\n              nonDiagnosticTitle={t(\'policy.nonDiagnosticTitle\')}\\n              nonDiagnosticBody={t(\'policy.nonDiagnosticBody\')}\\n              onRefreshJourney={async () => {\\n                if (selectedChildId) await loadJourney(selectedChildId, selectedDay);\\n              }}\\n              onExploreDomain={(domainId) => {\\n                setActivitiesDomainFilter(domainId);\\n                handleSelectSection(\'activities\');\\n              }}\\n              onOpenActivity={(id) => void openActivityInStudio(id)}\\n              onGoToday={() => handleSelectSection(\'today\')}\\n            />\\n          )}\", \"StartLine\":1160, \"TargetContent\":\"          {/* =============================================================== */}\\n          {/* PRIMARY TAB 4: PROGRESS & CAREGIVER FEEDBACK                    */}\\n          {/* =============================================================== */}\\n          {!studioActivity && !loadingStudioActivity && journey && section === \'progress\' && (\\n            <ProgressAndFeedbackSection\\n              journey={journey}\\n              locale={locale}\\n              nonDiagnosticTitle={t(\'policy.nonDiagnosticTitle\')}\\n              nonDiagnosticBody={t(\'policy.nonDiagnosticBody\')}\\n              onRefreshJourney={async () => {\\n                if (selectedChildId) await loadJourney(selectedChildId, selectedDay);\\n              }}\\n              onExploreDomain={(domainId) => {\\n                setActivitiesDomainFilter(domainId);\\n                handleSelectSection(\'activities\');\\n              }}\\n              onGoToday={() => handleSelectSection(\'today\')}\\n            />\\n          )}\"}], \"TargetFile\":\"/src/pages/ParentDashboardView.tsx\", \"toolAction\":\"Wiring ProgressDashboardSection into ParentDashboardView\", \"toolSummary\":\"Mount ProgressDashboardSection\"}"
