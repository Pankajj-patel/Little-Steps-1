            }
            lines {
              text: "    summary: \'Offer two familiar household items and celebrate pointing, gestures, and first words.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    durationMinutes: 5,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
