    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { CheckCircle2, Clock } from \'lucide-react\';\nimport { EditorialImage } from \'../components/EditorialImage\';\nimport { Badge, type BadgeTone } from \'./Badge\';\nimport { Button } from \'./Button\';\n\nexport interface ActivityCardProps {\n  title: string;\n  summary: string;\n  domainName: string;\n  ageGroupLabel: string;\n  durationMinutes: number;\n  materials: string[];\n  posterUrl: string;\n  statusText: string;\n  statusTone?: BadgeTone;\n  completed?: boolean;\n  actionLabel?: string;\n  onAction: () => void;\n}\n\nexport function ActivityCard({\n  title,\n  summary,\n  domainName,\n  ageGroupLabel,\n  durationMinutes,\n  materials,\n  posterUrl,\n  statusText,\n  statusTone = \'neutral\',\n  completed = false,\n  actionLabel = \'Open Guide\',\n  onAction,\n}: ActivityCardProps) {\n  return (\n    <article className=\"rounded-xl border border-border bg-surface overflow-hidden flex flex-col\">\n      <EditorialImage\n        src={posterUrl}\n        alt={title}\n        aspectClassName=\"aspect-[16/10]\"\n      />\n\n      <div className=\"p-5 flex-1 flex flex-col justify-between gap-4\">\n        <div className=\"space-y-2\">\n          {/* Quiet unboxed metadata line */}\n          <p className=\"text-xs text-muted\">\n            {domainName} <span aria-hidden=\"true\">\302\267</span> {ageGroupLabel}{\' \'}\n            <span aria-hidden=\"true\">\302\267</span>{\' \'}\n            <span className=\"font-mono tabular-nums\">{durationMinutes} min</span>\n          </p>\n\n          <h3 className=\"font-display text-xl font-semibold text-charcoal leading-snug\">\n            {title}\n          </h3>\n\n          <p className=\"text-sm text-muted leading-relaxed\">{summary}</p>\n\n          {materials.length > 0 && (\n            <p className=\"text-xs text-muted pt-1\">\n              At home: <span className=\"text-charcoal\">{materials.slice(0, 3).join(\', \')}</span>\n            </p>\n          )}\n        </div>\n\n        <div className=\"pt-3.5 border-t border-border flex flex-wrap items-center justify-between gap-3\">\n          <Badge\n            tone={statusTone}\n            icon={\n              completed ? (\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n              ) : (\n                <Clock className=\"w-3.5 h-3.5\" />\n              )\n            }\n          >\n            {statusText}\n          </Badge>\n\n          <Button variant=\"primary\" size=\"sm\" onClick={onAction}>\n            {actionLabel}\n          </Button>\n        </div>\n      </div>\n    </article>\n  );\n}"
        replacement_content: "import React from \'react\';\nimport { Award, CheckCircle2, CircleDashed, Clock, PlayCircle, UploadCloud } from \'lucide-react\';\nimport { EditorialImage } from \'../components/EditorialImage\';\nimport type { JourneyDisplayStatus } from \'../shared/types\';\nimport { Badge, type BadgeTone } from \'./Badge\';\nimport { Button } from \'./Button\';\n\nexport interface ActivityCardProps {\n  title: string;\n  summary: string;\n  domainName: string;\n  ageGroupLabel: string;\n  durationMinutes: number;\n  prepLevelLabel?: string;\n  materials: string[];\n  posterUrl: string;\n  statusText: string;\n  statusTone?: BadgeTone;\n  statusState?: JourneyDisplayStatus;\n  completed?: boolean;\n  actionLabel?: string;\n  onAction: () => void;\n}\n\nconst STATE_STYLES: Record<\n  JourneyDisplayStatus,\n  {\n    articleClass: string;\n    topStripeClass: string;\n    badgeTone: BadgeTone;\n    buttonVariant: \'primary\' | \'secondary\';\n    icon: React.ReactNode;\n  }\n> = {\n  not_started: {\n    articleClass: \'border-border bg-surface\',\n    topStripeClass: \'bg-border/60\',\n    badgeTone: \'neutral\',\n    buttonVariant: \'primary\',\n    icon: <CircleDashed className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />,\n  },\n  in_progress: {\n    articleClass: \'border-peach bg-peach-soft/20\',\n    topStripeClass: \'bg-peach-ink/70\',\n    badgeTone: \'peach\',\n    buttonVariant: \'primary\',\n    icon: <PlayCircle className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />,\n  },\n  completed: {\n    articleClass: \'border-sage-border bg-sage-soft/25\',\n    topStripeClass: \'bg-sage\',\n    badgeTone: \'sage\',\n    buttonVariant: \'secondary\',\n    icon: <CheckCircle2 className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />,\n  },\n  submitted_for_review: {\n    articleClass: \'border-lavender bg-lavender-soft/35\',\n    topStripeClass: \'bg-lavender-ink/75\',\n    badgeTone: \'lavender\',\n    buttonVariant: \'secondary\',\n    icon: <UploadCloud className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />,\n  },\n  reviewed: {\n    articleClass: \'border-sage bg-sage-soft/45\',\n    topStripeClass: \'bg-sage\',\n    badgeTone: \'sage\',\n    buttonVariant: \'secondary\',\n    icon: <Award className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />,\n  },\n};\n\nexport function ActivityCard({\n  title,\n  summary,\n  domainName,\n  ageGroupLabel,\n  durationMinutes,\n  prepLevelLabel,\n  materials,\n  posterUrl,\n  statusText,\n  statusTone,\n  statusState,\n  completed = false,\n  actionLabel = \'Open Guide\',\n  onAction,\n}: ActivityCardProps) {\n  const stateVisual = statusState ? STATE_STYLES[statusState] : null;\n  const resolvedTone: BadgeTone = statusTone ?? stateVisual?.badgeTone ?? \'neutral\';\n  const resolvedIcon = stateVisual ? (\n    stateVisual.icon\n  ) : completed ? (\n    <CheckCircle2 className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n  ) : (\n    <Clock className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n  );\n  const resolvedButtonVariant = stateVisual?.buttonVariant ?? \'primary\';\n\n  return (\n    <article\n      data-status={statusState ?? (completed ? \'completed\' : \'not_started\')}\n      className={`rounded-xl border overflow-hidden flex flex-col transition-colors ${\n        stateVisual ? stateVisual.articleClass : \'border-border bg-surface\'\n      }`}\n    >\n      {stateVisual && (\n        <div\n          aria-hidden=\"true\"\n          className={`h-1 w-full shrink-0 ${stateVisual.topStripeClass}`}\n        />\n      )}\n\n      <EditorialImage\n        src={posterUrl}\n        alt={title}\n        aspectClassName=\"aspect-[16/10]\"\n      />\n\n      <div className=\"p-5 flex-1 flex flex-col justify-between gap-4\">\n        <div className=\"space-y-2\">\n          {/* Quiet unboxed metadata line */}\n          <p className=\"text-xs text-muted leading-relaxed\">\n            {domainName} <span aria-hidden=\"true\">\302\267</span> {ageGroupLabel}{\' \'}\n            <span aria-hidden=\"true\">\302\267</span>{\' \'}\n            <span className=\"font-mono tabular-nums\">{durationMinutes} min</span>\n            {prepLevelLabel && (\n              <>\n                {\' \'}\n                <span aria-hidden=\"true\">\302\267</span> <span>{prepLevelLabel}</span>\n              </>\n            )}\n          </p>\n\n          <h3 className=\"font-display text-xl font-semibold text-charcoal leading-snug\">\n            {title}\n          </h3>\n\n          <p className=\"text-sm text-muted leading-relaxed\">{summary}</p>\n\n          {materials.length > 0 && (\n            <p className=\"text-xs text-muted pt-1\">\n              Materials:{\' \'}\n              <span className=\"text-charcoal\">{materials.slice(0, 3).join(\', \')}</span>\n            </p>\n          )}\n        </div>\n\n        <div className=\"pt-3.5 border-t border-border/80 flex flex-wrap items-center justify-between gap-3\">\n          <Badge tone={resolvedTone} icon={resolvedIcon}>\n            {statusText}\n          </Badge>\n\n          <Button variant={resolvedButtonVariant} size=\"sm\" onClick={onAction}>\n            {actionLabel}\n          </Button>\n        </div>\n      </div>\n    </article>\n  );\n}\n"
        start_line: 1
        end_line: 88
      }
      num_matches: 1
    }
    description: "Enhance ActivityCard with optional preparation level metadata and distinct Montessori visual styling for all 5 journey activity states while preserving full backward compatibility."
    diff_stats {
      additions: 91
      deletions: 17
    }
  }
}
