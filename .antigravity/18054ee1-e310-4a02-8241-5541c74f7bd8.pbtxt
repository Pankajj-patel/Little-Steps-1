  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\n\nexport interface ProgressIndicatorProps {\n  value: number;\n  max?: number;\n  label?: string;\n  sublabel?: string;\n  variant?: \'linear\' | \'ring\';\n  tone?: \'sage\' | \'peach\' | \'lavender\';\n  size?: \'sm\' | \'md\';\n}\n\nconst FILL_CLASSES = {\n  sage: \'bg-sage\',\n  peach: \'bg-peach-ink\',\n  lavender: \'bg-lavender-ink\',\n};\n\nconst STROKE_COLORS = {\n  sage: \'#446E5A\',\n  peach: \'#844825\',\n  lavender: \'#4F4278\',\n};\n\nexport function ProgressIndicator({\n  value,\n  max = 100,\n  label,\n  sublabel,\n  variant = \'linear\',\n  tone = \'sage\',\n  size = \'md\',\n}: ProgressIndicatorProps) {\n  const safeMax = max <= 0 ? 100 : max;\n  const clamped = Math.max(0, Math.min(safeMax, value));\n  const pct = Math.round((clamped / safeMax) * 100);\n\n  if (variant === \'ring\') {\n    const dim = size === \'sm\' ? 56 : 76;\n    const stroke = size === \'sm\' ? 5 : 6;\n    const radius = (dim - stroke) / 2;\n    const circumference = 2 * Math.PI * radius;\n    const offset = circumference - (pct / 100) * circumference;\n\n    return (\n      <div className=\"inline-flex items-center gap-3.5\">\n        <div\n          role=\"progressbar\"\n          aria-valuenow={clamped}\n          aria-valuemin={0}\n          aria-valuemax={safeMax}\n          aria-label={label || \'Progress\'}\n          className=\"relative inline-flex items-center justify-center shrink-0\"\n          style={{ width: dim, height: dim }}\n        >\n          <svg width={dim} height={dim} className=\"-rotate-90\" aria-hidden=\"true\">\n            <circle\n              cx={dim / 2}\n              cy={dim / 2}\n              r={radius}\n              fill=\"none\"\n              stroke=\"#EAE6DD\"\n              strokeWidth={stroke}\n            />\n            <circle\n              cx={dim / 2}\n              cy={dim / 2}\n              r={radius}\n              fill=\"none\"\n              stroke={STROKE_COLORS[tone]}\n              strokeWidth={stroke}\n              strokeLinecap=\"round\"\n              strokeDasharray={circumference}\n              strokeDashoffset={offset}\n              className=\"transition-all duration-300\"\n            />\n          </svg>\n          <span className=\"absolute font-mono text-xs font-medium text-charcoal tabular-nums\">\n            {pct}%\n          </span>\n        </div>\n\n        {(label || sublabel) && (\n          <div className=\"min-w-0\">\n            {label && <p className=\"text-sm font-medium text-charcoal\">{label}</p>}\n            {sublabel && <p className=\"text-xs text-muted\">{sublabel}</p>}\n          </div>\n        )}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-1.5 w-full\">\n      {(label || sublabel) && (\n        <div className=\"flex items-baseline justify-between gap-3\">\n          <span className=\"text-sm font-medium text-charcoal\">{label}</span>\n          <span className=\"font-mono text-xs text-muted tabular-nums\">\n            {sublabel ?? `${pct}%`}\n          </span>\n        </div>\n      )}\n      <div\n        role=\"progressbar\"\n        aria-valuenow={clamped}\n        aria-valuemin={0}\n        aria-valuemax={safeMax}\n        aria-label={label || \'Progress\'}\n        className={`w-full rounded-full bg-cream overflow-hidden ${size === \'sm\' ? \'h-1.5\' : \'h-2.5\'}`}\n      >\n        <div\n          className={`h-full rounded-full transition-all duration-300 ${FILL_CLASSES[tone]}`}\n          style={{ width: `${pct}%` }}\n        />\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/design-system/ProgressIndicator.tsx"
        }
        overwrite: true
      }
    }
