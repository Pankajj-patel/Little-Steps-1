      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Mark seeded demo users verified and onboarded on fresh DB seed\", \"EndLine\":455, \"Instruction\":\"Set email_verified_at and onboarding_completed_at when inserting seeded demo users\", \"ReplacementContent\":\"    const insertUser = db.prepare(\\n      `INSERT INTO users (\\n         id, email, password_hash, full_name, phone_number, role, preferred_locale,\\n         email_verified_at, onboarding_completed_at, is_active\\n       )\\n       VALUES (\\n         ?, ?, ?, ?, ?, ?, \'en\',\\n         strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'),\\n         strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'),\\n         1\\n       )`\\n    );\", \"StartLine\":446, \"TargetContent\":\"    const insertUser = db.prepare(\\n      `INSERT INTO users (id, email, password_hash, full_name, phone_number, role, preferred_locale, is_active)\\n       VALUES (?, ?, ?, ?, ?, ?, \'en\', 1)`\\n    );\", \"TargetFile\":\"/server/db/seed.ts\", \"toolAction\":\"Updating seed script for demo user verification parity\", \"toolSummary\":\"Update demo user seed columns\"}"
