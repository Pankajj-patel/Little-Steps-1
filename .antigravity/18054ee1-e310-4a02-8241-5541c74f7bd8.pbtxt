              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    materials: [\'High-contrast linen card or bold striped cloth\', \'Soft floor mat\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    safetyNotes: \'Keep cloth out of baby\342\200\231s mouth and maintain hands-on supervision throughout.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    posterUrl: EDITORIAL_IMAGES.tummyMirror,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    steps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Settle comfortably\', instructionText: \'Place baby on their back during a calm, alert window after feeding and burping.\', caregiverTip: \'Avoid starting when baby is hungry.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Present the card steadily\', instructionText: \'Hold the high-contrast cloth 20\342\200\22325 cm above baby\342\200\231s chest line until their eyes settle on it.\', caregiverTip: \'Wait patiently rather than shaking it.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Move in a slow arc\', instructionText: \'Glide the card slowly from center to right, pause, then return smoothly to center and left.\', caregiverTip: \'Count to four as you move across.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { title: \'Close softly\', instructionText: \'Lower the cloth out of view and gently place your warm hand on baby\342\200\231s tummy.\', caregiverTip: \'Finish while baby is still relaxed.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rubric: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Safe positioning\', description: \'Baby rested safely on a firm surface during an alert window.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Steady initial presentation\', description: \'Caregiver held the visual object still until baby noticed it.\', weightPoints: 25 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Slow horizontal arc\', description: \'Caregiver moved smoothly without rapid shaking or jerking.\', weightPoints: 30 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { label: \'Gentle transition out\', description: \'Caregiver ended calmly before signs of overstimulation.\', weightPoints: 20 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 3-6 months"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
