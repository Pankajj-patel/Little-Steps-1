      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Extend shared types for Step 4 parent dashboard progress, weekly chart, continue learning, tips, and notifications\", \"EndLine\":200, \"Instruction\":\"Add WeeklyProgressDay, LastActivityResume, ParentingTip, ParentNotificationItem and extend DomainProgressStat and TodayJourneyResponse\", \"ReplacementContent\":\"export interface DomainProgressStat {\\n  domainId: string;\\n  domainSlug: string;\\n  domainName: string;\\n  completedCount: number;\\n  availableCount: number;\\n}\\n\\nexport interface WeeklyProgressDay {\\n  date: string;\\n  dayLabel: string;\\n  completedCount: number;\\n  isToday: boolean;\\n}\\n\\nexport interface LastActivityResume {\\n  activity: ActivityDetail;\\n  status: CompletionStatus;\\n  updatedAt: string;\\n}\\n\\nexport interface ParentingTip {\\n  id: string;\\n  ageGroupSlug: string;\\n  title: string;\\n  body: string;\\n  focusArea: string;\\n}\\n\\nexport interface ParentNotificationItem {\\n  id: string;\\n  kind: \'review_ready\' | \'submission_queued\' | \'email_verify\' | \'daily_rhythm\';\\n  title: string;\\n  description: string;\\n  createdAt: string;\\n  actionLabel?: string;\\n  targetSection?: \'today\' | \'my-plan\' | \'activities\' | \'progress\' | \'verify-email\';\\n}\\n\\nexport interface TodayJourneyResponse {\\n  child: ChildProfile;\\n  availableDays: Array<{ dayNumber: number; title: string; focusNote: string }>;\\n  selectedDay: {\\n    id: string;\\n    dayNumber: number;\\n    title: string;\\n    focusNote: string;\\n  };\\n  todaySummary: {\\n    completedTodayCount: number;\\n    totalTodayCount: number;\\n    completionPct: number;\\n  };\\n  items: JourneyActivityItem[];\\n  weeklyProgress: WeeklyProgressDay[];\\n  domainProgress: DomainProgressStat[];\\n  lastActivity: LastActivityResume | null;\\n  parentingTip: ParentingTip;\\n  notifications: ParentNotificationItem[];\\n  recentSubmissions: VideoSubmissionSummary[];\\n}\", \"StartLine\":179, \"TargetContent\":\"export interface DomainProgressStat {\\n  domainId: string;\\n  domainSlug: string;\\n  domainName: string;\\n  completedCount: number;\\n}\\n\\nexport interface TodayJourneyResponse {\\n  child: ChildProfile;\\n  availableDays: Array<{ dayNumber: number; title: string; focusNote: string }>;\\n  selectedDay: {\\n    id: string;\\n    dayNumber: number;\\n    title: string;\\n    focusNote: string;\\n  };\\n  items: JourneyActivityItem[];\\n  domainProgress: DomainProgressStat[];\\n  recentSubmissions: VideoSubmissionSummary[];\\n}\", \"TargetFile\":\"/src/shared/types.ts\", \"toolAction\":\"Extending shared dashboard types\", \"toolSummary\":\"Add dashboard analytics and tip types\"}"
