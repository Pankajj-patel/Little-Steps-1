        target_content: "const SESSION_SECRET =\n  process.env.SESSION_SECRET || \'littlesteps-dev-session-secret-change-in-prod\';\nconst VIDEO_TOKEN_SECRET =\n  process.env.VIDEO_TOKEN_SECRET || \'littlesteps-dev-video-secret-change-in-prod\';"
        replacement_content: "function resolveSigningSecret(envName: string): string {\n  const configured = process.env[envName]?.trim();\n  if (\n    configured &&\n    configured.length >= 16 &&\n    !configured.startsWith(\'replace-with-\')\n  ) {\n    return configured;\n  }\n  return crypto.randomBytes(32).toString(\'hex\');\n}\n\nconst SESSION_SECRET = resolveSigningSecret(\'SESSION_SECRET\');\nconst VIDEO_TOKEN_SECRET = resolveSigningSecret(\'VIDEO_TOKEN_SECRET\');"
        start_line: 4
        end_line: 10
      }
      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "/**\n * Validates actual binary video file magic bytes to prevent spoofed Content-Type uploads.\n */\nexport function validateVideoMagicBytes(buffer: Buffer): boolean {\n  if (buffer.length < 12) return false;\n  const isWebm =\n    buffer[0] === 0x1a &&\n    buffer[1] === 0x45 &&\n    buffer[2] === 0xdf &&\n    buffer[3] === 0xa3;\n  const boxType = buffer.subarray(4, 8).toString(\'ascii\');\n  const isMp4OrMov = boxType === \'ftyp\' || boxType === \'moov\' || boxType === \'mdat\' || boxType === \'wide\';\n  return isWebm || isMp4OrMov;\n}"
        replacement_content: "/**\n * Validates actual binary video file magic bytes and enforces MIME-to-container match\n * to prevent spoofed Content-Type or disguised file uploads.\n */\nexport function validateVideoMagicBytes(buffer: Buffer, declaredMime?: string): boolean {\n  if (buffer.length < 12) return false;\n  const isWebm =\n    buffer[0] === 0x1a &&\n    buffer[1] === 0x45 &&\n    buffer[2] === 0xdf &&\n    buffer[3] === 0xa3;\n  const boxType = buffer.subarray(4, 8).toString(\'ascii\');\n  const isMp4OrMov =\n    boxType === \'ftyp\' || boxType === \'moov\' || boxType === \'mdat\' || boxType === \'wide\';\n\n  if (declaredMime === \'video/webm\') {\n    return isWebm;\n  }\n  if (declaredMime === \'video/mp4\' || declaredMime === \'video/quicktime\') {\n    return isMp4OrMov;\n  }\n  return isWebm || isMp4OrMov;\n}"
        start_line: 157
        end_line: 171
      }
      num_matches: 1
    }
    description: "Use CSPRNG fallback for session/video signing secrets when env vars are unset and bind binary video magic-byte validation strictly to declared MIME type."
    diff_stats {
      additions: 27
      deletions: 8
    }
  }
