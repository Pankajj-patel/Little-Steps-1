    tool_calls {
      id: "call_4966363054557844478"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add Step 10 admin types for objectives, instructional video URL, immutable activity version snapshots, age group/domain/reviewer/submission/user management, and unified audit logs.\", \"Instruction\":\"Extend ActivitySummary and AdminOverviewResponse and add Step 10 admin interfaces in src/shared/types.ts.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":140, \"ReplacementContent\":\"  title: string;\\n  summary: string;\\n  objectives?: string[];\\n  durationMinutes: number;\\n  prepLevel?: ActivityPrepLevel;\\n  version: number;\\n  materials: string[];\\n  safetyNotes: string;\\n  instructionalPosterUrl: string;\\n  instructionalVideoUrl?: string | null;\\n  status: ActivityStatus;\\n  createdAt: string;\\n}\\n\\nexport interface ActivityDetail extends ActivitySummary {\\n  steps: ActivityStep[];\\n  rubricCriteria: ActivityRubricCriterion[];\\n}\\n\\nexport interface ActivityVersionSnapshot {\\n  id: string;\\n  activityId: string;\\n  versionNumber: number;\\n  changeNote: string | null;\\n  createdByName: string;\\n  createdAt: string;\\n  linkedSubmissionsCount: number;\\n  snapshot: {\\n    title: string;\\n    summary: string;\\n    ageGroupId: string;\\n    domainId: string;\\n    objectives: string[];\\n    durationMinutes: number;\\n    prepLevel: ActivityPrepLevel;\\n    materials: string[];\\n    safetyNotes: string;\\n    instructionalPosterUrl: string;\\n    instructionalVideoUrl: string | null;\\n    status: ActivityStatus;\\n    steps: Array<{\\n      stepNumber: number;\\n      title: string;\\n      instructionText: string;\\n      caregiverTip: string | null;\\n    }>;\\n    rubricCriteria: Array<{\\n      criterionOrder: number;\\n      label: string;\\n      description: string;\\n      weightPoints: number;\\n    }>;\\n  };\\n}\", \"StartLine\":120, \"TargetContent\":\"  title: string;\\n  summary: string;\\n  durationMinutes: number;\\n  prepLevel?: ActivityPrepLevel;\\n  version: number;\\n  materials: string[];\\n  safetyNotes: string;\\n  instructionalPosterUrl: string;\\n  status: ActivityStatus;\\n  createdAt: string;\\n}\\n\\nexport interface ActivityDetail extends ActivitySummary {\\n  steps: ActivityStep[];\\n  rubricCriteria: ActivityRubricCriterion[];\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":475, \"ReplacementContent\":\"export interface MediaAuditLogItem {\\n  id: string;\\n  actorUserId: string | null;\\n  actorName: string;\\n  actorRole: string;\\n  submissionId: string;\\n  action: MediaAuditAction;\\n  createdAt: string;\\n}\\n\\nexport type UnifiedAuditCategory = \'admin\' | \'review\' | \'media\';\\n\\nexport interface UnifiedAuditLogItem {\\n  id: string;\\n  category: UnifiedAuditCategory;\\n  actorUserId: string | null;\\n  actorName: string;\\n  actorRole: string;\\n  action: string;\\n  entityType: string;\\n  entityId: string;\\n  summary: string;\\n  createdAt: string;\\n}\\n\\nexport interface AdminAgeGroupItem extends AgeGroup {\\n  activityCount: number;\\n  publishedActivityCount: number;\\n  childrenCount: number;\\n}\\n\\nexport interface AdminDomainItem extends LearningDomain {\\n  activityCount: number;\\n  publishedActivityCount: number;\\n}\\n\\nexport interface AdminReviewerItem {\\n  id: string;\\n  email: string;\\n  fullName: string;\\n  isActive: boolean;\\n  allowedAgeGroupSlugs: string[];\\n  specialtyNote: string | null;\\n  completedReviewsCount: number;\\n  activeAssignedCount: number;\\n  createdAt: string;\\n}\\n\\nexport interface AdminSubmissionItem {\\n  submissionId: string;\\n  parentReference: string;\\n  activityId: string;\\n  activityTitle: string;\\n  activityVersion: number;\\n  domainName: string;\\n  ageGroupSlug: string;\\n  ageGroupLabel: string;\\n  reviewStatus: SubmissionReviewStatus;\\n  assignedReviewerId: string | null;\\n  assignedReviewerName: string | null;\\n  hasActiveVideo: boolean;\\n  storageMode: VideoStorageMode;\\n  isAssessable: boolean | null;\\n  instructionMatchScorePct: number | null;\\n  durationSeconds: number;\\n  expiresAt: string;\\n  deletedAt: string | null;\\n  deletionReason: string | null;\\n  createdAt: string;\\n}\\n\\nexport interface AdminUserItem extends UserProfile {\\n  childrenCount: number;\\n  submissionsCount: number;\\n  completedReviewsCount: number;\\n  allowedAgeGroupSlugs: string[];\\n  specialtyNote: string | null;\\n}\\n\\nexport interface AdminOverviewResponse {\\n  counts: {\\n    totalActivities: number;\\n    publishedActivities: number;\\n    draftActivities: number;\\n    archivedActivities: number;\\n    totalParents: number;\\n    totalChildren: number;\\n    totalReviewers: number;\\n    pendingReviews: number;\\n    completedReviews: number;\\n    queuedSubmissions: number;\\n    activeVideosCount: number;\\n    expiredPurgedCount: number;\\n  };\\n  coverageMatrix: Array<{\\n    ageGroupId: string;\\n    ageGroupSlug: string;\\n    ageGroupLabel: string;\\n    domainCounts: Record<string, number>;\\n  }>;\\n  recentActivity: UnifiedAuditLogItem[];\\n  lastRetentionSweepAt: string | null;\\n}\", \"StartLine\":445, \"TargetContent\":\"export interface MediaAuditLogItem {\\n  id: string;\\n  actorUserId: string | null;\\n  actorName: string;\\n  actorRole: string;\\n  submissionId: string;\\n  action: MediaAuditAction;\\n  createdAt: string;\\n}\\n\\nexport interface AdminOverviewResponse {\\n  counts: {\\n    totalActivities: number;\\n    publishedActivities: number;\\n    totalParents: number;\\n    totalReviewers: number;\\n    queuedSubmissions: number;\\n    activeVideosCount: number;\\n    expiredPurgedCount: number;\\n  };\\n  coverageMatrix: Array<{\\n    ageGroupId: string;\\n    ageGroupSlug: string;\\n    ageGroupLabel: string;\\n    domainCounts: Record<string, number>;\\n  }>;\\n  lastRetentionSweepAt: string | null;\\n}\"}], \"TargetFile\":\"/src/shared/types.ts\", \"toolAction\":\"Adding Step 10 admin types to shared types.ts\", \"toolSummary\":\"Update shared types fo