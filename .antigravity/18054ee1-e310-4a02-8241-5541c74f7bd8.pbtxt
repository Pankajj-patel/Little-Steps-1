    tool_calls {
      id: "call_1958060948386236068"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  ArrowRight,\\n  Award,\\n  Calendar,\\n  CalendarClock,\\n  CheckCircle2,\\n  CircleDashed,\\n  Clock,\\n  History,\\n  PlayCircle,\\n  ShieldCheck,\\n  Sparkles,\\n  UploadCloud,\\n} from \'lucide-react\';\\nimport { EditorialImage } from \'../../components/EditorialImage\';\\nimport {\\n  ActivityCard,\\n  Badge,\\n  Button,\\n  Card,\\n  EmptyState,\\n  ProgressIndicator,\\n  Tabs,\\n  type BadgeTone,\\n} from \'../../design-system\';\\nimport { formatDateReadable } from \'../../shared/i18n\';\\nimport type {\\n  ActivityDetail,\\n  ActivityPrepLevel,\\n  JourneyActivityItem,\\n  JourneyDisplayStatus,\\n  LocaleCode,\\n  TodayJourneyResponse,\\n} from \'../../shared/types\';\\n\\nexport function formatPrepLevel(prepLevel?: ActivityPrepLevel): string {\\n  switch (prepLevel) {\\n    case \'no_prep\':\\n      return \'No prep\';\\n    case \'guided_prep\':\\n      return \'Guided setup\';\\n    case \'quick_setup\':\\n    default:\\n      return \'2-min setup\';\\n  }\\n}\\n\\nexport function getJourneyStatusMeta(item: JourneyActivityItem): {\\n  statusState: JourneyDisplayStatus;\\n  statusText: string;\\n  statusTone: BadgeTone;\\n  actionLabel: string;\\n} {\\n  const statusState = item.displayStatus;\\n  switch (statusState) {\\n    case \'reviewed\': {\\n      const score = item.latestSubmission?.review?.instructionMatchScorePct;\\n      return {\\n        statusState,\\n        statusText: score !== undefined ? `Reviewed \302\267 ${score}%` : \'Reviewed\',\\n        statusTone: \'sage\',\\n        actionLabel: \'Read Feedback\',\\n      };\\n    }\\n    case \'submitted_for_review\':\\n      return {\\n        statusState,\\n        statusText: \'Submitted for review\',\\n        statusTone: \'lavender\',\\n        actionLabel: \'View Submission\',\\n      };\\n    case \'completed\':\\n      return {\\n        statusState,\\n        statusText: \'Completed\',\\n        statusTone: \'sage\',\\n        actionLabel: \'View Activity\',\\n      };\\n    case \'in_progress\':\\n      return {\\n        statusState,\\n        statusText: \'In progress\',\\n        statusTone: \'peach\',\\n        actionLabel: \'Resume Activity\',\\n      };\\n    case \'not_started\':\\n    default:\\n      return {\\n        statusState: \'not_started\',\\n        statusText: \'Not started\',\\n        statusTone: \'neutral\',\\n        actionLabel: \'Start Activity\',\\n      };\\n  }\\n}\\n\\ninterface MyPlanSectionProps {\\n  journey: TodayJourneyResponse;\\n  selectedDay: number;\\n  locale: LocaleCode;\\n  onSelectDay: (dayNumber: number) => void;\\n  onOpenActivity: (activityOrId: ActivityDetail | string) => void;\\n  onOpenLibrary: () => void;\\n}\\n\\ntype PlanTab = \'today\' | \'upcoming\' | \'completed\';\\n\\nexport function MyPlanSection({\\n  journey,\\n  selectedDay,\\n  locale,\\n  onSelectDay,\\n  onOpenActivity,\\n  onOpenLibrary,\\n}: MyPlanSectionProps) {\\n  const [activeTab, setActiveTab] = useState<PlanTab>(\'today\');\\n\\n  const todayFormatted = useMemo(() => {\\n    const dt = new Date(`${journey.learningWeek.todayDateIso}T12:00:00`);\\n    return new Intl.DateTimeFormat(locale === \'hi\' ? \'hi-IN\' : \'en-IN\', {\\n      weekday: \'long\',\\n      day: \'numeric\',\\n      month: \'long\',\\n      year: \'numeric\',\\n    }).format(dt);\\n  }, [journey.learningWeek.todayDateIso, locale]);\\n\\n  // Unique domains covered across today\'s selected plan + upcoming days\\n  const stageDomainsCovered = useMemo(() => {\\n    const names = new Set<string>();\\n    journey.items.forEach((i) => names.add(i.activity.domainName));\\n    journey.upcomingDays.forEach((d) =>\\n      d.activities.forEach((a) => names.add(a.domainName))\\n    );\\n    return Array.from(names);\\n  }, [journey.items, journey.upcomingDays]);\\n\\n  const todaysDomains = useMemo(\\n    () => Array.from(new Set(journey.items.map((i) => i.activity.domainName))),\\n    [journey.items]\\n  );\\n\\n  const tabs = [\\n    {\\n      id: \'today\',\\n      label: \\\"Today\'s Activities\\\",\\n      count: journey.items.length,\\n    },\\n    {\\n      id: \'upcoming\',\\n      label: \'Upcoming Days\',\\n      count: journey.upcomingDays.length,\\n    },\\n    {\\n      id: \'completed\',\\n      label: \'Completed History\',\\n      count: journey.completedHistory.length,\\n    },\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* ================================================================= */}\\n      {/* PLAN HEADER SUMMARY: BABY AGE, LEARNING WEEK, DATE & PROGRESS     */}\\n      {/* ================================================================= */}\\n      <Card tone=\\\"sage\\\" padding=\\\"lg\\\" className=\\\"space-y-5\\\">\\n        <div className=\\\"flex flex-col lg:flex-row lg:items-center justify-between gap-5\\\">\\n          <div className=\\\"space-y-2.5\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <Badge tone=\\\"sage\\\">\\n                {journey.child.displayName} \302\267 {journey.child.ageInMonths}{\' \'}\\n                {journey.child.ageInMonths === 1 ? \'month\' : \'months\'} ({journey.child.ageGroupLabel})\\n              </Badge>\\n              <Badge tone=\\\"neutral\\\">\\n                Week {journey.learningWeek.weekNumber} of {journey.learningWeek.totalStageWeeks}\\n              </Badge>\\n            </div>\\n\\n            <div className=\\\"space-y-1\\\">\\n              <h1 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal tracking-tight\\\">\\n                My Plan\\n              </h1>\\n              <p className=\\\"text-sm text-muted flex flex-wrap items-center gap-x-2 gap-y-1\\\">\\n                <span className=\\\"inline-flex items-center gap-1.5 text-charcoal font-medium\\\">\\n                  <Calendar className=\\\"w-4 h-4 text-sage\\\" aria-hidden=\\\"true\\\" />\\n                  {todayFormatted}\\n                </span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>\\n                  Stage: {journey.learningWeek.stageLabel}\\n                </span>\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Daily Completion Progress Ring + Readout */}\\n          <div className=\\\"flex items-center gap-4 bg-surface/80 border border-sage-border rounded-xl px-4 py-3 self-start lg:self-auto shrink-0\\\">\\n            <ProgressIndicator\\n              variant=\\\"ring\\\"\\n              value={journey.todaySummary.completionPct}\\n              max={100}\\n              label=\\\"Today\'s progress\\\"\\n              sublabel={`${journey.todaySummary.completedTodayCount} of ${journey.todaySummary.totalTodayCount} done`}\\n              tone=\\\"sage\\\"\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Linear daily progress bar */}\\n        <div className=\\\"pt-1\\\">\\n          <ProgressIndicator\\n            value={journey.todaySummary.completedTodayCount}\\n            max={Math.max(1, journey.todaySummary.totalTodayCount)}\\n            label={`Daily completion \302\267 ${journey.selectedDay.title}`}\\n            sublabel={`${journey.todaySummary.completedTodayCount}/${journey.todaySummary.totalTodayCount} (${journey.todaySummary.completionPct}%)`}\\n            tone=\\\"sage\\\"\\n          />\\n        </div>\\n      </Card>\\n\\n      {/* ================================================================= */}\\n      {/* RESUME UNFINISHED ACTIVITY CALLOUT (WHEN IN-PROGRESS EXISTS)      */}\\n      {/* ================================================================= */}\\n      {journey.inProgressItems.length > 0 && (\\n        <section aria-label=\\\"Resume unfinished activity\\\">\\n          <Card\\n            tone=\\\"peach\\\"\\n            padding=\\\"md\\\"\\n            className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\"\\n          >\\n            <div className=\\\"flex items-start gap-3.5 min-w-0\\\">\\n              <span className=\\\"w-10 h-10 rounded-xl bg-surface border border-peach text-peach-ink inline-flex items-center justify-center shrink-0\\\">\\n                <PlayCircle className=\\\"w-5 h-5\\\" aria-hidden=\\\"true\\\" />\\n              </span>\\n              <div className=\\\"space-y-0.5 min-w-0\\\">\\n                <p className=\\\"text-xs font-semibold text-peach-ink uppercase tracking-wide\\\">\\n                  Resume unfinished activity\\n                </p>\\n                <p className=\\\"font-display text-lg font-semibold text-charcoal truncate\\\">\\n                  {journey.inProgressItems[0].activity.title}\\n                </p>\\n                <p className=\\\"text-xs text-muted\\\">\\n                  {journey.inProgressItems[0].activity.domainName} \302\267{\' \'}\\n                  <span className=\\\"font-mono tabular-nums\\\">\\n                    {journey.inProgressItems[0].activity.durationMinutes} min\\n                  </span>{\' \'}\\n                  \302\267 {formatPrepLevel(journey.inProgressItems[0].activity.prepLevel)}\\n                </p>\\n              </div>\\n            </div>\\n\\n            <Button\\n              variant=\\\"primary\\\"\\n              size=\\\"md\\\"\\n              className=\\\"shrink-0\\\"\\n              rightIcon={<ArrowRight className=\\\"w-4 h-4\\\" />}\\n              onClick={() => onOpenActivity(journey.inProgressItems[0].activity)}\\n            >\\n              Resume Activity\\n            </Button>\\n          </Card>\\n        </section>\\n      )}\\n\\n      {/* ================================================================= */}\\n      {/* PLAN NAVIGATION TABS: TODAY / UPCOMING / COMPLETED HISTORY        */}\\n      {/* ================================================================= */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n        <Tabs\\n          tabs={tabs}\\n          activeTabId={activeTab}\\n          onChange={(id) => setActiveTab(id as PlanTab)}\\n          ariaLabel=\\\"Learning journey views\\\"\\n        />\\n\\n        {activeTab === \'today\' && journey.availableDays.length > 1 && (\\n          <div className=\\\"flex flex-wrap items-center gap-1.5\\\" aria-label=\\\"Choose plan day\\\">\\n            {journey.availableDays.map((day) => {\\n              const active = day.dayNumber === selectedDay;\\n              return (\\n                <button\\n                  key={day.dayNumber}\\n                  type=\\\"button\\\"\\n                  aria-pressed={active}\\n                  onClick={() => onSelectDay(day.dayNumber)}\\n                  className={`min-h-[40px] px-3.5 py-1.5 rounded-lg border text-xs font-medium transition-colors cursor-pointer ${\\n                    active\\n                      ? \'bg-sage text-white border-sage\'\\n                      : \'bg-surface border-border text-charcoal hover:bg-cream\'\\n                  }`}\\n                >\\n                  Day {day.dayNumber}\\n                </button>\\n              );\\n            })}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* ================================================================= */}\\n      {/* TAB 1: TODAY\'S ACTIVITIES                                         */}\\n      {/* ================================================================= */}\\n      {activeTab === \'today\' && (\\n        <div className=\\\"space-y-6\\\">\\n          {/* Calm Day Focus Banner */}\\n          <Card tone=\\\"cream\\\" className=\\\"space-y-2.5\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n              <h2 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n                {journey.selectedDay.title}\\n              </h2>\\n              <span className=\\\"text-xs text-muted\\\">\\n                Focus areas today:{\' \'}\\n                <strong className=\\\"font-medium text-charcoal\\\">\\n                  {todaysDomains.length > 0 ? todaysDomains.join(\' \302\267 \') : \'Age-matched play\'}\\n                </strong>\\n              </span>\\n            </div>\\n            <p className=\\\"text-sm text-muted leading-relaxed\\\">\\n              {journey.selectedDay.focusNote}\\n            </p>\\n          </Card>\\n\\n          {journey.items.length === 0 ? (\\n            <EmptyState\\n              title={`No activities scheduled for Day ${selectedDay} yet`}\\n              description={`Browse the full ${journey.child.ageGroupLabel} activity library to pick a calm activity for today.`}\\n              actionLabel=\\\"Browse Activity Library\\\"\\n              onAction={onOpenLibrary}\\n            />\\n          ) : (\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\\\">\\n              {journey.items.map((item) => {\\n                const meta = getJourneyStatusMeta(item);\\n                return (\\n                  <ActivityCard\\n                    key={item.planItemId}\\n                    title={item.activity.title}\\n                    summary={item.activity.summary}\\n                    domainName={item.activity.domainName}\\n                    ageGroupLabel={item.activity.ageGroupLabel}\\n                    durationMinutes={item.activity.durationMinutes}\\n                    prepLevelLabel={formatPrepLevel(item.activity.prepLevel)}\\n                    materials={item.activity.materials}\\n                    posterUrl={item.activity.instructionalPosterUrl}\\n                    statusText={meta.statusText}\\n                    statusTone={meta.statusTone}\\n                    statusState={meta.statusState}\\n                    completed={\\n                      meta.statusState === \'completed\' ||\\n                      meta.statusState === \'submitted_for_review\' ||\\n                      meta.statusState === \'reviewed\'\\n                    }\\n                    actionLabel={meta.actionLabel}\\n                    onAction={() => onOpenActivity(item.activity)}\\n                  />\\n                );\\n              })}\\n            </div>\\n          )}\\n\\n          {/* Quiet 5-State Visual Legend */}\\n          <Card className=\\\"space-y-3\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n              <p className=\\\"text-xs font-semibold text-charcoal uppercase tracking-wide\\\">\\n                Activity Status Guide\\n              </p>\\n              <p className=\\\"text-xs text-muted\\\">\\n                An activity becomes Reviewed only after a reviewer shares written coaching feedback.\\n              </p>\\n            </div>\\n            <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n              <Badge tone=\\\"neutral\\\" icon={<CircleDashed className=\\\"w-3.5 h-3.5\\\" />}>\\n                Not started\\n              </Badge>\\n              <Badge tone=\\\"peach\\\" icon={<PlayCircle className=\\\"w-3.5 h-3.5\\\" />}>\\n                In progress\\n              </Badge>\\n              <Badge tone=\\\"sage\\\" icon={<CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />}>\\n                Completed\\n              </Badge>\\n              <Badge tone=\\\"lavender\\\" icon={<UploadCloud className=\\\"w-3.5 h-3.5\\\" />}>\\n                Submitted for review\\n              </Badge>\\n              <Badge tone=\\\"sage\\\" icon={<Award className=\\\"w-3.5 h-3.5\\\" />}>\\n                Reviewed\\n              </Badge>\\n            </div>\\n          </Card>\\n        </div>\\n      )}\\n\\n      {/* ================================================================= */}\\n      {/* TAB 2: UPCOMING ACTIVITIES                                        */}\\n      {/* ================================================================= */}\\n      {activeTab === \'upcoming\' && (\\n        <div className=\\\"space-y-5\\\">\\n          {journey.upcomingDays.length === 0 ? (\\n            <EmptyState\\n              icon={<CalendarClock className=\\\"w-6 h-6\\\" />}\\n              title=\\\"You are viewing the latest day in this stage\\\"\\n              description=\\\"You can revisit earlier days in Today\'s Activities or explore extra ideas in the Activity Library.\\\"\\n              actionLabel=\\\"Browse Activity Library\\\"\\n              onAction={onOpenLibrary}\\n            />\\n          ) : (\\n            journey.upcomingDays.map((upDay) => {\\n              const dateLabel = formatDateReadable(`${upDay.scheduledDate}T12:00:00`, locale);\\n              return (\\n                <Card key={upDay.dayNumber} padding=\\\"lg\\\" className=\\\"space-y-4\\\">\\n                  <div className=\\\"flex flex-wrap items-start justify-between gap-3 border-b border-border pb-3.5\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                        <Badge tone=\\\"neutral\\\">Day {upDay.dayNumber}</Badge>\\n                        <span className=\\\"font-mono text-xs text-muted tabular-nums\\\">\\n                          Planned for {dateLabel}\\n                        </span>\\n                      </div>\\n                      <h2 className=\\\"font-display text-xl font-semibold text-charcoal\\\">\\n                        {upDay.title}\\n                      </h2>\\n                      <p className=\\\"text-sm text-muted\\\">{upDay.focusNote}</p>\\n                    </div>\\n\\n                    <Button\\n                      variant=\\\"subtle\\\"\\n                      size=\\\"sm\\\"\\n                      onClick={() => {\\n                        onSelectDay(upDay.dayNumber);\\n                        setActiveTab(\'today\');\\n                      }}\\n                    >\\n                      Switch to Day {upDay.dayNumber}\\n                    </Button>\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                    {upDay.activities.map((act) => (\\n                      <div\\n                        key={`${upDay.dayNumber}-${act.id}`}\\n                        className=\\\"rounded-xl border border-border bg-offwhite p-4 flex flex-col sm:flex-row gap-4 justify-between\\\"\\n                      >\\n                        <div className=\\\"flex items-start gap-3.5 min-w-0\\\">\\n                          <div className=\\\"w-20 h-20 rounded-lg overflow-hidden shrink-0\\\">\\n                            <EditorialImage\\n                              src={act.instructionalPosterUrl}\\n                              alt={act.title}\\n                              aspectClassName=\\\"w-full h-full\\\"\\n                            />\\n                          </div>\\n                          <div className=\\\"space-y-1 min-w-0\\\">\\n                            <p className=\\\"text-xs text-muted\\\">\\n                              {act.domainName} \302\267{\' \'}\\n                              <span className=\\\"font-mono tabular-nums\\\">{act.durationMinutes} min</span>{\' \'}\\n                              \302\267 {formatPrepLevel(act.prepLevel)}\\n                            </p>\\n                            <h3 className=\\\"font-display text-base font-semibold text-charcoal leading-snug\\\">\\n                              {act.title}\\n                            </h3>\\n                            {act.materials.length > 0 && (\\n                              <p className=\\\"text-xs text-muted line-clamp-1\\\">\\n                                Materials: <span className=\\\"text-charcoal\\\">{act.materials.slice(0, 3).join(\', \')}</span>\\n                              </p>\\n                            )}\\n                          </div>\\n                        </div>\\n\\n                        <div className=\\\"flex sm:flex-col items-center sm:items-end justify-end shrink-0\\\">\\n                          <Button\\n                            variant=\\\"secondary\\\"\\n                            size=\\\"sm\\\"\\n                            onClick={() => onOpenActivity(act.id)}\\n                          >\\n                            Preview Activity\\n                          </Button>\\n                        </div>\\n                      </div>\\n                    ))}\\n                  </div>\\n                </Card>\\n              );\\n            })\\n          )}\\n        </div>\\n      )}\\n\\n      {/* ================================================================= */}\\n      {/* TAB 3: PREVIOUSLY COMPLETED ACTIVITIES (IMMUTABLE HISTORY)        */}\\n      {/* ================================================================= */}\\n      {activeTab === \'completed\' && (\\n        <div className=\\\"space-y-5\\\">\\n          {journey.completedHistory.length === 0 ? (\\n            <EmptyState\\n              icon={<History className=\\\"w-6 h-6\\\" />}\\n              title=\\\"No completed activities yet\\\"\\n              description=\\\"Once you finish an activity with your baby, it will stay safely saved right here\342\200\224even as your baby grows into new age stages.\\\"\\n              actionLabel=\\\"View Today\'s Activities\\\"\\n              onAction={() => setActiveTab(\'today\')}\\n            />\\n          ) : (\\n            <div className=\\\"space-y-3\\\">\\n              {journey.completedHistory.map((record) => {\\n                const isReviewed = record.displayStatus === \'reviewed\';\\n                const isSubmitted = record.displayStatus === \'submitted_for_review\';\\n                const badgeTone: BadgeTone = isSubmitted ? \'lavender\' : \'sage\';\\n                const badgeIcon = isReviewed ? (\\n                  <Award className=\\\"w-3.5 h-3.5\\\" />\\n                ) : isSubmitted ? (\\n                  <UploadCloud className=\\\"w-3.5 h-3.5\\\" />\\n                ) : (\\n                  <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                );\\n                const badgeLabel = isReviewed\\n                  ? record.reviewScorePct !== null\\n                    ? `Reviewed \302\267 ${record.reviewScorePct}%`\\n                    : \'Reviewed\'\\n                  : isSubmitted\\n                    ? \'Submitted for review\'\\n                    : \'Completed\';\\n\\n                return (\\n                  <Card\\n                    key={record.completionId}\\n                    className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\"\\n                  >\\n                    <div className=\\\"space-y-1.5 min-w-0\\\">\\n                      <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                        <Badge tone={badgeTone} icon={badgeIcon}>\\n                          {badgeLabel}\\n                        </Badge>\\n                        <Badge tone=\\\"neutral\\\">\\n                          Completed in {record.ageGroupLabelSnapshot}\\n                        </Badge>\\n                      </div>\\n\\n                      <h3 className=\\\"font-display text-lg font-semibold text-charcoal leading-snug\\\">\\n                        {record.activityTitle}\\n                      </h3>\\n\\n                      <p className=\\\"text-xs text-muted flex flex-wrap items-center gap-x-2 gap-y-1\\\">\\n                        <span>{record.domainName}</span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span className=\\\"font-mono tabular-nums\\\">{record.durationMinutes} min</span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span>{formatPrepLevel(record.prepLevel)}</span>\\n                        <span aria-hidden=\\\"true\\\">\302\267</span>\\n                        <span className=\\\"inline-flex items-center gap-1\\\">\\n                          <Clock className=\\\"w-3 h-3\\\" aria-hidden=\\\"true\\\" />\\n                          {formatDateReadable(record.completedAt, locale)}\\n                        </span>\\n                      </p>\\n\\n                      {record.caregiverNotes && (\\n                        <p className=\\\"text-xs text-charcoal bg-cream/70 border border-border rounded-lg px-3 py-2 max-w-2xl\\\">\\n                          \342\200\234{record.caregiverNotes}\342\200\235\\n                        </p>\\n                      )}\\n                    </div>\\n\\n                    <div className=\\\"shrink-0\\\">\\n                      <Button\\n                        variant=\\\"secondary\\\"\\n                        size=\\\"sm\\\"\\n                        onClick={() => onOpenActivity(record.activityId)}\\n                      >\\n                        Revisit Activity\\n                      </Button>\\n                    </div>\\n                  </Card>\\n                );\\n              })}\\n            </div>\\n          )}\\n\\n          <Card tone=\\\"cream\\\" className=\\\"flex items-start gap-3\\\">\\n            <ShieldCheck className=\\\"w-4 h-4 text-sage shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n            <p className=\\\"text-xs text-muted leading-relaxed\\\">\\n              Your baby\342\200\231s past completions always keep the age stage they were completed in. When\\n              your baby moves into a new age group, today\342\200\231s and upcoming plans automatically update\\n              without altering your earlier history.\\n            </p>\\n          </Card>\\n        </div>\\n      )}\\n\\n      {/* ================================================================= */}\\n      {/* CALM WEEKLY DOMAIN BALANCE FOOTNOTE                               */}\\n      {/* ================================================================= */}\\n      <Card className=\\\"flex flex-col sm:flex-row sm:items-start justify-between gap-4\\\">\\n        <div className=\\\"flex items-start gap-3\\\">\\n          <span className=\\\"w-9 h-9 rounded-lg bg-sage-soft text-sage inline-flex items-center justify-center shrink-0\\\">\\n            <Sparkles className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n          </span>\\n          <div className=\\\"space-y-1\\\">\\n            <h3 className=\\\"font-display text-base font-semibold text-charcoal\\\">\\n              Balanced across six development areas, paced gently\\n            </h3>\\n            <p className=\\\"text-xs sm:text-sm text-muted leading-relaxed max-w-2xl\\\">\\n              Rather than crowding all six areas into a single day, {journey.child.displayName}\342\200\231s{\' \'}\\n              {journey.child.ageGroupLabel} plan spaces 2\342\200\2233 short activities per day so every week\\n              nurtures{\' \'}\\n              <span className=\\\"text-charcoal\\\">\\n                {stageDomainsCovered.length > 0\\n                  ? stageDomainsCovered.join(\', \')\\n                  : \'cognitive, language, physical, social-emotional, sensory, and early independence skills\'}\\n              </span>{\' \'}\\n              at a calm home pace.\\n            </p>\\n          </div>\\n        </div>\\n\\n        <Button\\n          variant=\\\"subtle\\\"\\n          size=\\\"sm\\\"\\n          className=\\\"shrink-0 self-start\\\"\\n          rightIcon={<ArrowRight className=\\\"w-3.5 h-3.5\\\" />}\\n          onClick={onOpenLibrary}\\n        >\\n          Explore Library\\n        </Button>\\n      </Card>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create dedicated Step 5 My Plan section with current baby age, learning week, today\'s date, daily progress, resume unfinished callout, upcoming days, completed history with preserved stage snapshots, and 5-state visual cards.\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/parent/MyPlanSection.tsx\", \"toolAction\":\"Creating MyPlanSection component\", \"toolSummary\":\"Create MyPlanSection component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1958060948386234419"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Integrate MyPlanSection into ParentDashboardView, upgrade Today\'s activity cards to display all 5 journey states and preparation levels, and include full persisted completed history in completedActivityIds.\", \"Instruction\":\"Import MyPlanSection, formatPrepLevel, and getJourneyStatusMeta; include completedHistory in completedActivityIds; upgrade renderActivityCardForJourneyItem to use 5-state visual differentiation and prepLevel; replace the inline my-plan section with MyPlanSection.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":62, \"ReplacementContent\":\"import {\\n  formatPrepLevel,\\n  getJourneyStatusMeta,\\n  MyPlanSection,\\n} from \'./parent/MyPlanSection\';\\nimport { ParentActivityStudio } from \'./parent/ParentActivityStudio\';\\nimport {\\n  ActivitiesLibrarySection,\\n  NotificationsSection,\\n  ParentingGuidesSection,\\n  ProfileSection,\\n  ProgressAndFeedbackSection,\\n  SettingsSection,\\n} from \'./parent/ParentSecondaryViews\';\", \"StartLine\":53, \"TargetContent\":\"import { ParentActivityStudio } from \'./parent/ParentActivityStudio\';\\nimport {\\n  ActivitiesLibrarySection,\\n  NotificationsSection,\\n  ParentingGuidesSection,\\n  ProfileSection,\\n  ProgressAndFeedbackSection,\\n  SettingsSection,\\n} from \'./parent/ParentSecondaryViews\';\"}, {\"AllowMultiple\":false, \"EndLine\":200, \"ReplacementContent\":\"  // Set of completed activity IDs from today\'s items, completed history, and submissions\\n  const completedActivityIds = useMemo(() => {\\n    const set = new Set<string>();\\n    journey?.items.forEach((item) => {\\n      if (\\n        item.displayStatus === \'completed\' ||\\n        item.displayStatus === \'submitted_for_review\' ||\\n        item.displayStatus === \'reviewed\'\\n      ) {\\n        set.add(item.activity.id);\\n      }\\n    });\\n    journey?.completedHistory.forEach((h) => set.add(h.activityId));\\n    journey?.recentSubmissions.forEach((sub) => set.add(sub.activityId));\\n    return set;\\n  }, [journey]);\", \"StartLine\":185, \"TargetContent\":\"  // Set of completed activity IDs from today\'s items + submissions for accurate status tags\\n  const completedActivityIds = useMemo(() => {\\n    const set = new Set<string>();\\n    journey?.items.forEach((item) => {\\n      if (\\n        item.completion?.status === \'completed\' ||\\n        item.completion?.status === \'submitted_for_review\' ||\\n        item.completion?.status === \'reviewed\'\\n      ) {\\n        set.add(item.activity.id);\\n      }\\n    });\\n    journey?.recentSubmissions.forEach((sub) => set.add(sub.activityId));\\n    return set;\\n  }, [journey]);\"}, {\"AllowMultiple\":false, \"EndLine\":339, \"ReplacementContent\":\"  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\\n    const meta = getJourneyStatusMeta(item);\\n\\n    return (\\n      <ActivityCard\\n        key={item.planItemId}\\n        title={item.activity.title}\\n        summary={item.activity.summary}\\n        domainName={item.activity.domainName}\\n        ageGroupLabel={item.activity.ageGroupLabel}\\n        durationMinutes={item.activity.durationMinutes}\\n        prepLevelLabel={formatPrepLevel(item.activity.prepLevel)}\\n        materials={item.activity.materials}\\n        posterUrl={item.activity.instructionalPosterUrl}\\n        statusText={meta.statusText}\\n        statusTone={meta.statusTone}\\n        statusState={meta.statusState}\\n        completed={\\n          meta.statusState === \'completed\' ||\\n          meta.statusState === \'submitted_for_review\' ||\\n          meta.statusState === \'reviewed\'\\n        }\\n        actionLabel={meta.actionLabel}\\n        onAction={() => void openActivityInStudio(item.activity)}\\n      />\\n    );\\n  };\", \"StartLine\":295, \"TargetContent\":\"  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\\n    const isReviewed = Boolean(item.latestSubmission?.review);\\n    const isCompleted =\\n      item.completion?.status === \'completed\' ||\\n      item.completion?.status === \'submitted_for_review\' ||\\n      item.completion?.status === \'reviewed\';\\n    const isStarted = item.completion?.status === \'started\';\\n\\n    const statusText = isReviewed\\n      ? `Reviewed \302\267 ${item.latestSubmission!.review!.instructionMatchScorePct}%`\\n      : item.latestSubmission?.reviewStatus === \'queued\' ||\\n          item.latestSubmission?.reviewStatus === \'in_review\'\\n        ? \'Clip awaiting feedback\'\\n        : isCompleted\\n          ? \'Completed\'\\n          : isStarted\\n            ? \'In progress\'\\n            : \'Ready to start\';\\n\\n    const statusTone = isReviewed || isCompleted ? \'sage\' : isStarted ? \'peach\' : \'neutral\';\\n    const actionLabel = isCompleted\\n      ? \'Review Activity\'\\n      : isStarted\\n        ? \'Continue Activity\'\\n        : \'Start Activity\';\\n\\n    return (\\n      <ActivityCard\\n        key={item.planItemId}\\n        title={item.activity.title}\\n        summary={item.activity.summary}\\n        domainName={item.activity.domainName}\\n        ageGroupLabel={item.activity.ageGroupLabel}\\n        durationMinutes={item.activity.durationMinutes}\\n        materials={item.activity.materials}\\n        posterUrl={item.activity.instructionalPosterUrl}\\n        statusText={statusText}\\n        statusTone={statusTone}\\n        completed={isCompleted || isReviewed}\\n        actionLabel={actionLabel}\\n        onAction={() => void openActivityInStudio(item.activity)}\\n      />\\n    );\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":1221, \"ReplacementContent\":\"          {/* =============================================================== */}\\n          {/* PRIMARY TAB 2: MY PLAN (STRUCTURED DAILY LEARNING JOURNEY)      */}\\n          {/* =============================================================== */}\\n          {!studioActivity && !loadingStudioActivity && journey && section === \'my-plan\' && (\\n            <MyPlanSection\\n              journey={journey}\\n              selectedDay={selectedDay}\\n              locale={locale}\\n              onSelectDay={(dayNumber) => setSelectedDay(dayNumber)}\\n              onOpenActivity={(activityOrId) => void openActivityInStudio(activityOrId)}\\n              onOpenLibrary={() => handleSelectSection(\'activities\')}\\n            />\\n          )}\", \"StartLine\":1145, \"TargetContent\":\"          {/* =============================================================== */}\\n          {/* PRIMARY TAB 2: MY PLAN (DAY-BY-DAY STRUCTURED JOURNEY)          */}\\n          {/* =============================================================== */}\\n          {!studioActivity && !loadingStudioActivity && journey && section === \'my-plan\' && (\\n            <div className=\\\"space-y-6\\\">\\n              <div className=\\\"flex flex-wrap items-end justify-between gap-4\\\">\\n                <div className=\\\"space-y-1\\\">\\n                  <Badge tone=\\\"sage\\\">{journey.child.ageGroupLabel} Plan</Badge>\\n                  <h2 className=\\\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\\\">\\n                    {journey.child.displayName}\342\200\231s Daily Plan\\n                  </h2>\\n                  <p className=\\\"text-sm text-muted max-w-2xl\\\">\\n                    Follow one calm day at a time. Repeating familiar activities builds confidence\\n                    for your baby.\\n                  </p>\\n                </div>\\n              </div>\\n\\n              {/* Day Sequence Switcher */}\\n              {journey.availableDays.length > 0 && (\\n                <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                  {journey.availableDays.map((d) => {\\n                    const active = d.dayNumber === selectedDay;\\n                    return (\\n                      <button\\n                        key={d.dayNumber}\\n                        type=\\\"button\\\"\\n                        onClick={() => setSelectedDay(d.dayNumber)}\\n                        aria-pressed={active}\\n                        className={`min-h-[44px] px-4 py-2 rounded-xl border text-sm font-medium transition-colors cursor-pointer ${\\n                          active\\n                            ? \'bg-sage text-white border-sage\'\\n                            : \'bg-surface border-border text-charcoal hover:bg-cream\'\\n                        }`}\\n                      >\\n                        Day {d.dayNumber}\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n              )}\\n\\n              <Card tone=\\\"cream\\\" className=\\\"space-y-2\\\">\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                  <h3 className=\\\"font-display text-lg font-semibold text-charcoal\\\">\\n                    {journey.selectedDay.title}\\n                  </h3>\\n                  <Badge\\n                    tone={\\n                      journey.todaySummary.completedTodayCount === journey.todaySummary.totalTodayCount &&\\n                      journey.todaySummary.totalTodayCount > 0\\n                        ? \'sage\'\\n                        : \'neutral\'\\n                    }\\n                    icon={<CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />}\\n                  >\\n                    {journey.todaySummary.completedTodayCount}/{journey.todaySummary.totalTodayCount} completed\\n                  </Badge>\\n                </div>\\n                <p className=\\\"text-sm text-muted\\\">{journey.selectedDay.focusNote}</p>\\n              </Card>\\n\\n              {journey.items.length === 0 ? (\\n                <EmptyState\\n                  title=\\\"No activities in this day\342\200\231s plan yet\\\"\\n                  description=\\\"Explore the Activities Library to choose any age-appropriate activity.\\\"\\n                  actionLabel=\\\"Open Activities Library\\\"\\n                  onAction={() => handleSelectSection(\'activities\')}\\n                />\\n              ) : (\\n                <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\\\">\\n                  {journey.items.map(renderActivityCardForJourneyItem)}\\n                </div>\\n              )}\\n            </div>\\n          )}\"}], \"TargetFile\":\"/src/pages/ParentDashboardView.tsx\", \"toolAction\":\"Integrating MyPlanSection in dashboard\", \"toolSummary\":\"Integrate MyPlanSection in ParentDashboardView\"}"
