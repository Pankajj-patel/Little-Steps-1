      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure full-stack Express + Vite dev and start scripts on port 3000.\", \"EndLine\":13, \"Instruction\":\"Update package.json scripts to run server.ts with tsx in dev and node in production.\", \"ReplacementContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"tsx server.ts\\\",\\n    \\\"start\\\": \\\"node server.ts\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\"\\n  },\", \"StartLine\":6, \"TargetContent\":\"  \\\"scripts\\\": {\\n    \\\"dev\\\": \\\"vite --port=3000 --host=0.0.0.0\\\",\\n    \\\"build\\\": \\\"vite build\\\",\\n    \\\"preview\\\": \\\"vite preview\\\",\\n    \\\"clean\\\": \\\"rm -rf dist server.js\\\",\\n    \\\"lint\\\": \\\"tsc --noEmit\\\"\\n  },\", \"TargetFile\":\"/package.json\", \"toolAction\":\"Updating package.json scripts\", \"toolSummary\":\"Update package.json scripts\"}"
