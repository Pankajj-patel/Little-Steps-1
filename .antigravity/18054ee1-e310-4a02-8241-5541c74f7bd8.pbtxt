      num_matches: 1
    }
    replacement_infos {
      original_chunk {
        target_content: "  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\n    const isReviewed = Boolean(item.latestSubmission?.review);\n    const isCompleted =\n      item.completion?.status === \'completed\' ||\n      item.completion?.status === \'submitted_for_review\' ||\n      item.completion?.status === \'reviewed\';\n    const isStarted = item.completion?.status === \'started\';\n\n    const statusText = isReviewed\n      ? `Reviewed \302\267 ${item.latestSubmission!.review!.instructionMatchScorePct}%`\n      : item.latestSubmission?.reviewStatus === \'queued\' ||\n          item.latestSubmission?.reviewStatus === \'in_review\'\n        ? \'Clip awaiting feedback\'\n        : isCompleted\n          ? \'Completed\'\n          : isStarted\n            ? \'In progress\'\n            : \'Ready to start\';\n\n    const statusTone = isReviewed || isCompleted ? \'sage\' : isStarted ? \'peach\' : \'neutral\';\n    const actionLabel = isCompleted\n      ? \'Review Activity\'\n      : isStarted\n        ? \'Continue Activity\'\n        : \'Start Activity\';\n\n    return (\n      <ActivityCard\n        key={item.planItemId}\n        title={item.activity.title}\n        summary={item.activity.summary}\n        domainName={item.activity.domainName}\n        ageGroupLabel={item.activity.ageGroupLabel}\n        durationMinutes={item.activity.durationMinutes}\n        materials={item.activity.materials}\n        posterUrl={item.activity.instructionalPosterUrl}\n        statusText={statusText}\n        statusTone={statusTone}\n        completed={isCompleted || isReviewed}\n        actionLabel={actionLabel}\n        onAction={() => void openActivityInStudio(item.activity)}\n      />\n    );\n  };"
        replacement_content: "  const renderActivityCardForJourneyItem = (item: JourneyActivityItem) => {\n    const meta = getJourneyStatusMeta(item);\n\n    return (\n      <ActivityCard\n        key={item.planItemId}\n        title={item.activity.title}\n        summary={item.activity.summary}\n        domainName={item.activity.domainName}\n        ageGroupLabel={item.activity.ageGroupLabel}\n        durationMinutes={item.activity.durationMinutes}\n        prepLevelLabel={formatPrepLevel(item.activity.prepLevel)}\n        materials={item.activity.materials}\n        posterUrl={item.activity.instructionalPosterUrl}\n        statusText={meta.statusText}\n        statusTone={meta.statusTone}\n        statusState={meta.statusState}\n        completed={\n          meta.statusState === \'completed\' ||\n          meta.statusState === \'submitted_for_review\' ||\n          meta.statusState === \'reviewed\'\n        }\n        actionLabel={meta.actionLabel}\n        onAction={() => void openActivityInStudio(item.activity)}\n      />\n    );\n  };"
