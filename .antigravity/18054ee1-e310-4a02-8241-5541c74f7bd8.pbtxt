  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  ArrowLeft,\n  Check,\n  CheckCircle2,\n  ShieldAlert,\n  Video,\n} from \'lucide-react\';\nimport { InstructionalGuidePlayer } from \'../../components/InstructionalGuidePlayer\';\nimport { VideoCaptureUploader } from \'../../components/VideoCaptureUploader\';\nimport { Badge, Button, Card } from \'../../design-system\';\nimport { api } from \'../../lib/api\';\nimport { formatDateReadable } from \'../../shared/i18n\';\nimport type {\n  ActivityDetail,\n  CompletionStatus,\n  LocaleCode,\n  VideoSubmissionSummary,\n} from \'../../shared/types\';\n\ninterface ParentActivityStudioProps {\n  childId: string;\n  childName: string;\n  activity: ActivityDetail;\n  completionStatus: CompletionStatus | null;\n  initialNotes: string;\n  latestSubmission: VideoSubmissionSummary | null;\n  locale: LocaleCode;\n  onBack: () => void;\n  onProgressUpdated: () => Promise<void>;\n  onOpenFeedback: () => void;\n}\n\nexport function ParentActivityStudio({\n  childId,\n  childName,\n  activity,\n  completionStatus,\n  initialNotes,\n  latestSubmission,\n  locale,\n  onBack,\n  onProgressUpdated,\n  onOpenFeedback,\n}: ParentActivityStudioProps) {\n  const [checkedSteps, setCheckedSteps] = useState<Record<string, boolean>>({});\n  const [reflectionNote, setReflectionNote] = useState(initialNotes);\n  const [savingCompletion, setSavingCompletion] = useState(false);\n  const [showUploader, setShowUploader] = useState(false);\n  const [statusMessage, setStatusMessage] = useState<string | null>(null);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  const isCompleted =\n    completionStatus === \'completed\' ||\n    completionStatus === \'submitted_for_review\' ||\n    completionStatus === \'reviewed\';\n\n  const handleMarkCompleted = async () => {\n    setSavingCompletion(true);\n    setStatusMessage(null);\n    setErrorMessage(null);\n    try {\n      await api.saveCompletion({\n        childId,\n        activityId: activity.id,\n        status: \'completed\',\n        caregiverNotes: reflectionNote,\n      });\n      setStatusMessage(`Saved to ${childName}\342\200\231s daily journal.`);\n      await onProgressUpdated();\n    } catch (err) {\n      setErrorMessage(\n        err instanceof Error ? err.message : \'Unable to save activity progress right now.\'\n      );\n    } finally {\n      setSavingCompletion(false);\n    }\n  };\n\n  const handleVideoSubmitted = async (_submission: VideoSubmissionSummary) => {\n    setShowUploader(false);\n    setStatusMessage(\n      \'Practice clip uploaded securely to your private vault and queued for caregiver coaching.\'\n    );\n    await onProgressUpdated();\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3\">\n        <Button\n          variant=\"subtle\"\n          size=\"sm\"\n          leftIcon={<ArrowLeft className=\"w-4 h-4\" />}\n          onClick={onBack}\n        >\n          Back to Dashboard\n        </Button>\n\n        {isCompleted && (\n          <Badge tone=\"sage\" icon={<CheckCircle2 className=\"w-3.5 h-3.5\" />}>\n            Completed\n          </Badge>\n        )}\n      </div>\n\n      {/* Activity Title & Calm Metadata */}\n      <div className=\"space-y-2\">\n        <p className=\"text-xs text-muted\">\n          {activity.domainName} <span aria-hidden=\"true\">\302\267</span> {activity.ageGroupLabel}{\' \'}\n          <span aria-hidden=\"true\">\302\267</span>{\' \'}\n          <span className=\"font-mono tabular-nums\">{activity.durationMinutes} min</span>\n        </p>\n        <h1 className=\"font-display text-2xl sm:text-3xl font-semibold text-charcoal\">\n          {activity.title}\n        </h1>\n        <p className=\"text-sm sm:text-base text-muted leading-relaxed max-w-2xl\">\n          {activity.summary}\n        </p>\n      </div>\n\n      {/* Interactive Step-Paced Instructional Guide */}\n      <InstructionalGuidePlayer\n        posterUrl={activity.instructionalPosterUrl}\n        activityTitle={activity.title}\n        steps={activity.steps}\n      />\n\n      {/* Everyday Items & Calm Safety Reminder */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        <Card className=\"space-y-3\">\n          <h2 className=\"font-display text-lg font-semibold text-charcoal\">\n            Everyday Items Needed\n          </h2>\n          <ul className=\"space-y-2 text-sm text-muted\">\n            {activity.materials.map((mat, i) => (\n              <li key={i} className=\"flex items-start gap-2.5\">\n                <span className=\"font-mono text-xs text-sage mt-0.5 tabular-nums\">\n                  {String(i + 1).padStart(2, \'0\')}\n                </span>\n                <span className=\"text-charcoal\">{mat}</span>\n              </li>\n            ))}\n          </ul>\n        </Card>\n\n        <Card tone=\"peach\" className=\"space-y-2.5\">\n          <div className=\"flex items-center gap-2 text-peach-ink\">\n            <ShieldAlert className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n            <h2 className=\"font-display text-lg font-semibold text-charcoal\">\n              Calm Safety Reminder\n            </h2>\n          </div>\n          <p className=\"text-sm text-charcoal/90 leading-relaxed\">{activity.safetyNotes}</p>\n        </Card>\n      </div>\n\n      {/* Step-by-Step Caregiver Instructions */}\n      <Card padding=\"lg\" className=\"space-y-5\">\n        <div className=\"flex items-center justify-between gap-4 border-b border-border pb-3\">\n          <h2 className=\"font-display text-xl font-semibold text-charcoal\">Step-by-Step Guide</h2>\n          <span className=\"text-xs text-muted font-mono tabular-nums\">\n            {Object.values(checkedSteps).filter(Boolean).length} / {activity.steps.length} steps tried\n          </span>\n        </div>\n\n        <ol className=\"divide-y divide-border\">\n          {activity.steps.map((step) => {\n            const checked = Boolean(checkedSteps[step.id]);\n            return (\n              <li key={step.id} className=\"py-4 first:pt-1 last:pb-1\">\n                <label className=\"flex items-start gap-3.5 cursor-pointer min-h-[44px]\">\n                  <input\n                    type=\"checkbox\"\n                    checked={checked}\n                    onChange={() =>\n                      setCheckedSteps((prev) => ({ ...prev, [step.id]: !prev[step.id] }))\n                    }\n                    className=\"mt-1 h-4 w-4 rounded border-border-strong accent-sage shrink-0\"\n                  />\n                  <div className=\"space-y-1 flex-1\">\n                    <p\n                      className={`text-sm font-semibold ${\n                        checked ? \'text-muted line-through\' : \'text-charcoal\'\n                      }`}\n                    >\n                      {String(step.stepNumber).padStart(2, \'0\')}. {step.title}\n                    </p>\n                    <p className=\"text-sm text-muted leading-relaxed\">{step.instructionText}</p>\n                    {step.caregiverTip && (\n                      <p className=\"text-xs text-sage pt-0.5\">\n                        Gentle cue: {step.caregiverTip}\n                      </p>\n                    )}\n                  </div>\n                </label>\n              </li>\n            );\n          })}\n        </ol>\n      </Card>\n\n      {/* Completion & Optional Private Video Coaching */}\n      <section className=\"space-y-4\">\n        {statusMessage && (\n          <div\n            role=\"status\"\n            className=\"rounded-xl border border-sage-border bg-sage-soft px-4 py-3 text-sm text-sage flex items-center gap-2\"\n          >\n            <CheckCircle2 className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n            <span>{statusMessage}</span>\n          </div>\n        )}\n\n        {errorMessage && (\n          <p role=\"alert\" className=\"text-sm text-danger bg-danger-soft px-4 py-3 rounded-xl\">\n            {errorMessage}\n          </p>\n        )}\n\n        {!showUploader ? (\n          <Card padding=\"lg\" className=\"space-y-4\">\n            <div className=\"space-y-1\">\n              <h2 className=\"font-display text-xl font-semibold text-charcoal\">\n                Log Today\342\200\231s Practice or Request Caregiver Feedback\n              </h2>\n              <p className=\"text-sm text-muted\">\n                Mark this activity complete for your private journal, or share a short private clip\n                for step-by-step caregiver coaching.\n              </p>\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <label\n                htmlFor=\"studio-reflection-note\"\n                className=\"block text-xs font-medium text-charcoal\"\n              >\n                Short reflection note (Optional)\n              </label>\n              <textarea\n                id=\"studio-reflection-note\"\n                rows={2}\n                value={reflectionNote}\n                onChange={(e) => setReflectionNote(e.target.value)}\n                placeholder=\"How did the pace feel for you and your baby today?\"\n                className=\"w-full rounded-lg border border-border-strong bg-surface px-3.5 py-2.5 text-sm text-charcoal focus:border-sage\"\n              />\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n              <Button\n                variant=\"primary\"\n                loading={savingCompletion}\n                leftIcon={<Check className=\"w-4 h-4\" />}\n                onClick={() => void handleMarkCompleted()}\n              >\n                {isCompleted ? \'Update Journal Note\' : \'Mark Activity Completed\'}\n              </Button>\n\n              <Button\n                variant=\"secondary\"\n                leftIcon={<Video className=\"w-4 h-4 text-sage\" />}\n                onClick={() => setShowUploader(true)}\n              >\n                Record or Upload Clip for Feedback\n              </Button>\n            </div>\n          </Card>\n        ) : (\n          <VideoCaptureUploader\n            childId={childId}\n            activityId={activity.id}\n            activityTitle={activity.title}\n            onSubmitted={handleVideoSubmitted}\n            onCancel={() => setShowUploader(false)}\n          />\n        )}\n\n        {latestSubmission && (\n          <Card tone=\"cream\" className=\"flex flex-wrap items-center justify-between gap-4\">\n            <div className=\"space-y-1\">\n              <p className=\"text-xs text-muted\">\n                Latest practice clip \302\267 Submitted {formatDateReadable(latestSubmission.createdAt, locale)}\n              </p>\n              <p className=\"text-sm font-medium text-charcoal\">\n                {latestSubmission.review\n                  ? `Reviewed \302\267 Caregiver Instruction-Match: ${latestSubmission.review.instructionMatchScorePct}%`\n                  : latestSubmission.reviewStatus === \'in_review\'\n                    ? \'Currently being reviewed by your caregiver coach\'\n                    : \'Queued privately for caregiver coaching review\'}\n              </p>\n            </div>\n            <Button variant=\"secondary\" size=\"sm\" onClick={onOpenFeedback}>\n              View in Progress & Feedback\n            </Button>\n          </Card>\n        )}\n      </section>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/parent/ParentActivityStudio.tsx"
        }
        overwrite: true
      }
    }
