  view_file {
    absolute_path_uri: "file:///src/pages/ReviewerWorkbenchView.tsx"
    end_line: 511
    content: "import React, { useCallback, useEffect, useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, Info, ShieldCheck } from \'lucide-react\';\nimport { SecureVideoPlayer } from \'../components/SecureVideoPlayer\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { api } from \'../lib/api\';\nimport { calculateInstructionMatchScore } from \'../shared/domain\';\nimport { formatDateTimeReadable } from \'../shared/i18n\';\nimport type {\n  ReviewerQueueItem,\n  ReviewerSubmissionDetail,\n  RubricAchievementLevel,\n  SubmissionReviewStatus,\n} from \'../shared/types\';\n\nexport function ReviewerWorkbenchView() {\n  const { ageGroups, locale } = useAuth();\n  const [statusFilter, setStatusFilter] = useState<SubmissionReviewStatus | \'all\'>(\'all\');\n  const [ageFilter, setAgeFilter] = useState<string>(\'all\');\n  const [queue, setQueue] = useState<ReviewerQueueItem[]>([]);\n  const [loadingQueue, setLoadingQueue] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Active workbench submission\n  const [selectedDetail, setSelectedDetail] = useState<ReviewerSubmissionDetail | null>(null);\n  const [loadingDetail, setLoadingDetail] = useState(false);\n\n  // Rubric state\n  const [ratings, setRatings] = useState<Record<string, RubricAchievementLevel>>({});\n  const [strengthsNote, setStrengthsNote] = useState(\'\');\n  const [coachingTip, setCoachingTip] = useState(\'\');\n  const [scopeAcknowledged, setScopeAcknowledged] = useState(false);\n  const [submittingReview, setSubmittingReview] = useState(false);\n  const [submitSuccess, setSubmitSuccess] = useState<string | null>(null);\n\n  const loadQueue = useCallback(async () => {\n    setLoadingQueue(true);\n    setError(null);\n    try {\n      const { queue: rows } = await api.getReviewerQueue(statusFilter, ageFilter);\n      setQueue(rows);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to load review queue.\');\n    } finally {\n      setLoadingQueue(false);\n    }\n  }, [statusFilter, ageFilter]);\n\n  useEffect(() => {\n    void loadQueue();\n  }, [loadQueue]);\n\n  const hydrateDetailForm = (detail: ReviewerSubmissionDetail) => {\n    setSelectedDetail(detail);\n    setSubmitSuccess(null);\n    setError(null);\n    const nextRatings: Record<string, RubricAchievementLevel> = {};\n    if (detail.review) {\n      for (const s of detail.review.rubricScores) {\n        nextRatings[s.criterionId] = s.achievedLevel;\n      }\n      setStrengthsNote(detail.review.strengthsNote);\n      setCoachingTip(detail.review.coachingTip);\n      setScopeAcknowledged(true);\n    } else {\n      for (const c of detail.activity.rubricCriteria) {\n        nextRatings[c.id] = \'met\';\n      }\n      setStrengthsNote(\'\');\n      setCoachingTip(\'\');\n      setScopeAcknowledged(false);\n    }\n    setRatings(nextRatings);\n  };\n\n  const openSubmission = async (item: ReviewerQueueItem) => {\n    setLoadingDetail(true);\n    setError(null);\n    try {\n      const detail =\n        item.reviewStatus === \'queued\'\n          ? await api.claimSubmission(item.submissionId)\n          : await api.getReviewerSubmissionDetail(item.submissionId);\n      hydrateDetailForm(detail);\n    } catch (err) {\n      // Fallback to read-only detail if already claimed\n      try {\n        const detail = await api.getReviewerSubmissionDetail(item.submissionId);\n        hydrateDetailForm(detail);\n      } catch {\n        setError(err instanceof Error ? err.message : \'Unable to open submission.\');\n      }\n    } finally {\n      setLoadingDetail(false);\n    }\n  };\n\n  const handleReviewSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedDetail) return;\n    setError(null);\n    setSubmittingReview(true);\n    try {\n      const criterionRatings = selectedDetail.activity.rubricCriteria.map((c) => ({\n        criterionId: c.id,\n        achievedLevel: ratings[c.id] ?? \'not_observed\',\n      }));\n\n      await api.submitReview(selectedDetail.submission.submissionId, {\n        strengthsNote,\n        coachingTip,\n        evaluationScopeAcknowledged: true,\n        criterionRatings,\n      });\n\n      const refreshed = await api.getReviewerSubmissionDetail(\n        selectedDetail.submission.submissionId\n      );\n      hydrateDetailForm(refreshed);\n      setSubmitSuccess(\'Caregiver coaching feedback published.\');\n      await loadQueue();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \'Unable to submit review.\');\n    } finally {\n      setSubmittingReview(false);\n    }\n  };\n\n  // Split-Screen Evaluation Workbench\n  if (selectedDetail) {\n    const { submission, activity } = selectedDetail;\n    const liveScore = calculateInstructionMatchScore(\n      activity.rubricCriteria.map((c) => ({\n        weightPoints: c.weightPoints,\n        achievedLevel: ratings[c.id] ?? \'not_observed\',\n      }))\n    );\n\n    const canSubmit =\n      scopeAcknowledged &&\n      strengthsNote.trim().length >= 10 &&\n      coachingTip.trim().length >= 10 &&\n      !submittingReview;\n\n    return (\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-4\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setSelectedDetail(null);\n              void loadQueue();\n            }}\n            className=\"inline-flex items-center gap-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\"\n          >\n            <ArrowLeft className=\"w-4 h-4\" />\n            Back to Review Queue\n          </button>\n\n          <p className=\"text-xs text-olive font-mono tabular-nums\">\n            Submission {submission.submissionId} \302\267 Age band: {submission.ageGroupLabel} \302\267 Parent PII hidden\n          </p>\n        </div>\n\n        {/* Non-Diagnostic Policy Header */}\n        <div className=\"rounded-xl border border-stone bg-oat/70 px-4 py-3 flex items-start gap-3\">\n          <ShieldCheck className=\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\" aria-hidden=\"true\" />\n          <p className=\"text-xs text-olive leading-relaxed\">\n            <strong className=\"text-ink\">Reviewer Mandate:</strong> Evaluate only the caregiver\342\200\231s demonstration of activity steps, safety setup, and calm pacing. Never assess or comment on the baby\342\200\231s intelligence, developmental level, or medical health.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n          {/* Left Zone (60%): Secure Video Stream + Activity Guidelines Reference */}\n          <div className=\"lg:col-span-7 space-y-5\">\n            <div className=\"space-y-1\">\n              <p className=\"text-xs text-olive\">\n                {submission.domainName} <span aria-hidden=\"true\">\302\267</span> {submission.ageGroupLabel}\n              </p>\n              <h1 className=\"font-serif text-2xl sm:text-3xl font-medium text-ink\">\n                {activity.title}\n              </h1>\n            </div>\n\n            <SecureVideoPlayer\n              submissionId={submission.submissionId}\n              hasActiveVideo={submission.hasActiveVideo}\n              expiresAt={submission.expiresAt}\n              deletionReason={submission.deletionReason}\n            />\n\n            {submission.caregiverNotes && (\n              <div className=\"rounded-xl border border-stone bg-linen p-4 space-y-1\">\n                <p className=\"text-xs font-semibold text-olive\">Caregiver Note</p>\n                <p className=\"text-sm text-ink\">{submission.caregiverNotes}</p>\n              </div>\n            )}\n\n            {/* Activity Steps Reference */}\n            <div className=\"rounded-xl border border-stone bg-linen p-5 space-y-3\">\n              <h2 className=\"font-serif text-lg font-medium text-ink\">\n                Activity Instructions Reference\n              </h2>\n              <ol className=\"divide-y divide-stone\">\n                {activity.steps.map((s) => (\n                  <li key={s.id} className=\"py-3 first:pt-0 last:pb-0 text-sm\">\n                    <p className=\"font-medium text-ink\">\n                      {String(s.stepNumber).padStart(2, \'0\')}. {s.title}\n                    </p>\n                    <p className=\"text-olive text-xs mt-0.5 leading-relaxed\">{s.instructionText}</p>\n                  </li>\n                ))}\n              </ol>\n              <p className=\"text-xs text-ochre pt-2 border-t border-stone\">\n                Safety note: {activity.safetyNotes}\n              </p>\n            </div>\n          </div>\n\n          {/* Right Zone (40%): Weighted Caregiver Execution Rubric */}\n          <form\n            onSubmit={handleReviewSubmit}\n            className=\"lg:col-span-5 rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\"\n          >\n            <div className=\"flex items-end justify-between gap-4 border-b border-stone pb-4\">\n              <div>\n                <h2 className=\"font-serif text-xl font-medium text-ink\">\n                  Caregiver Execution Rubric\n                </h2>\n                <p className=\"text-xs text-olive mt-0.5\">Weighted instruction-match score</p>\n              </div>\n              <div className=\"text-right\">\n                <p className=\"font-mono text-3xl font-medium text-eucalyptus tabular-nums\">\n                  {liveScore.scorePct}%\n                </p>\n                <p className=\"font-mono text-[11px] text-olive tabular-nums\">\n                  {liveScore.earnedTotal}/{liveScore.maxTotal} pts\n                </p>\n              </div>\n            </div>\n\n            <div className=\"space-y-4\">\n              {activity.rubricCriteria.map((criterion) => {\n                const current = ratings[criterion.id] ?? \'not_observed\';\n                return (\n                  <div\n                    key={criterion.id}\n                    className=\"rounded-lg border border-stone bg-chalk p-3.5 space-y-2.5\"\n                  >\n                    <div className=\"flex items-start justify-between gap-2\">\n                      <div>\n                        <p className=\"text-sm font-medium text-ink\">{criterion.label}</p>\n                        <p className=\"text-xs text-olive mt-0.5\">{criterion.description}</p>\n                      </div>\n                      <span className=\"font-mono text-xs text-olive tabular-nums shrink-0\">\n                        {criterion.weightPoints} pts\n                      </span>\n                    </div>\n\n                    <div className=\"grid grid-cols-3 gap-1 p-1 rounded-lg bg-oat\">\n                      {(\n                        [\n                          { id: \'met\', label: \'Met\' },\n                          { id: \'partially_met\', label: \'Partial\' },\n                          { id: \'not_observed\', label: \'Not Seen\' },\n                        ] as const\n                      ).map((opt) => (\n                        <button\n                          key={opt.id}\n                          type=\"button\"\n                          onClick={() =>\n                            setRatings((prev) => ({ ...prev, [criterion.id]: opt.id }))\n                          }\n                          className={`py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap cursor-pointer ${\n                            current === opt.id\n                              ? \'bg-linen text-ink shadow-xs\'\n                              : \'text-olive hover:text-ink\'\n                          }`}\n                        >\n                          {opt.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n\n            <div className=\"space-y-3 pt-2 border-t border-stone\">\n              <div>\n                <label htmlFor=\"rev-strengths\" className=\"block text-xs font-medium text-ink mb-1\">\n                  What went well (warm, specific observation)\n                </label>\n                <textarea\n                  id=\"rev-strengths\"\n                  required\n                  minLength={10}\n                  rows={3}\n                  value={strengthsNote}\n                  onChange={(e) => setStrengthsNote(e.target.value)}\n                  placeholder=\"Highlight specific caregiver steps demonstrated warmly...\"\n                  className=\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink focus:border-eucalyptus\"\n                />\n              </div>\n\n              <div>\n                <label htmlFor=\"rev-tip\" className=\"block text-xs font-medium text-ink mb-1\">\n                  One practical tip for next time\n                </label>\n                <textarea\n                  id=\"rev-tip\"\n                  required\n                  minLength={10}\n                  rows={3}\n                  value={coachingTip}\n                  onChange={(e) => setCoachingTip(e.target.value)}\n                  placeholder=\"Share one gentle adjustment for the caregiver\342\200\231s next session...\"\n                  className=\"w-full rounded-lg border border-stone bg-chalk px-3 py-2 text-sm text-ink focus:border-eucalyptus\"\n                />\n              </div>\n\n              <label className=\"flex items-start gap-2.5 text-xs text-ink pt-1 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={scopeAcknowledged}\n                  onChange={(e) => setScopeAcknowledged(e.target.checked)}\n                  className=\"mt-0.5 h-4 w-4 rounded border-stone accent-eucalyptus\"\n                />\n                <span>\n                  I confirm this score and written feedback evaluate only the caregiver\342\200\231s activity execution\342\200\224not the baby\342\200\231s intelligence, developmental level, or health.\n                </span>\n              </label>\n            </div>\n\n            {error && (\n              <p role=\"alert\" className=\"text-xs text-crimson bg-crimson-soft px-3 py-2 rounded-lg\">\n                {error}\n              </p>\n            )}\n\n            {submitSuccess && (\n              <p className=\"text-xs text-eucalyptus bg-eucalyptus-soft px-3 py-2 rounded-lg flex items-center gap-1.5\">\n                <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                {submitSuccess}\n              </p>\n            )}\n\n            <button\n              type=\"submit\"\n              disabled={!canSubmit}\n              className=\"w-full px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-45 transition-colors cursor-pointer\"\n            >\n              {submittingReview\n                ? \'Publishing Feedback...\'\n                : selectedDetail.review\n                  ? \'Update Caregiver Feedback\'\n                  : \'Publish Caregiver Feedback\'}\n            </button>\n          </form>\n        </div>\n      </div>\n    );\n  }\n\n  // Queue Overview Screen\n  return (\n    <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6\">\n      <div className=\"flex flex-wrap items-end justify-between gap-4 border-b border-stone pb-5\">\n        <div className=\"space-y-1\">\n          <p className=\"text-xs text-olive\">Reviewer Workbench \302\267 Minimized PII queue</p>\n          <h1 className=\"font-serif text-3xl font-medium text-ink\">Caregiver Clip Review Queue</h1>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"flex items-center gap-1 p-1 rounded-lg bg-oat\">\n            {(\n              [\n                { id: \'all\', label: \'All\' },\n                { id: \'queued\', label: \'Queued\' },\n                { id: \'in_review\', label: \'In Review\' },\n                { id: \'reviewed\', label: \'Reviewed\' },\n              ] as const\n            ).map((tab) => (\n              <button\n                key={tab.id}\n                type=\"button\"\n                onClick={() => setStatusFilter(tab.id)}\n                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                  statusFilter === tab.id\n                    ? \'bg-linen text-ink shadow-xs\'\n                    : \'text-olive hover:text-ink\'\n                }`}\n              >\n                {tab.label}\n              </button>\n            ))}\n          </div>\n\n          <select\n            aria-label=\"Filter by age band\"\n            value={ageFilter}\n            onChange={(e) => setAgeFilter(e.target.value)}\n            className=\"rounded-lg border border-stone bg-linen px-3 py-2 text-xs font-medium text-ink\"\n          >\n            <option value=\"all\">All age groups</option>\n            {ageGroups.map((ag) => (\n              <option key={ag.id} value={ag.slug}>\n                {ag.label}\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      <div className=\"rounded-xl border border-stone bg-oat/70 p-4 flex items-start gap-2.5 text-xs text-olive\">\n        <Info className=\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\" aria-hidden=\"true\" />\n        <span>\n          Parent contact information is hidden by design. Every video stream opened is recorded in the privacy audit log.\n        </span>\n      </div>\n\n      {error && (\n        <p role=\"alert\" className=\"text-sm text-crimson bg-crimson-soft px-4 py-3 rounded-lg\">\n          {error}\n        </p>\n      )}\n\n      {loadingQueue || loadingDetail ? (\n        <div className=\"space-y-3\">\n          <div className=\"h-14 rounded-lg bg-oat animate-pulse\" />\n          <div className=\"h-14 rounded-lg bg-oat animate-pulse\" />\n        </div>\n      ) : queue.length === 0 ? (\n        <div className=\"rounded-xl border border-stone bg-linen p-10 text-center space-y-2\">\n          <p className=\"font-serif text-xl text-ink\">No clips matching this filter</p>\n          <p className=\"text-sm text-olive max-w-md mx-auto\">\n            When a caregiver uploads or records an activity clip from the Parent Journey, it will appear here immediately for rubric evaluation.\n          </p>\n        </div>\n      ) : (\n        <div className=\"rounded-xl border border-stone bg-linen overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-stone text-xs font-medium text-olive\">\n                <th className=\"py-3 px-4\">Activity & Domain</th>\n                <th className=\"py-3 px-4\">Age Band</th>\n                <th className=\"py-3 px-4\">Submitted</th>\n                <th className=\"py-3 px-4\">Status</th>\n                <th className=\"py-3 px-4 text-right\">Match Score</th>\n                <th className=\"py-3 px-4 text-right\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-stone text-sm\">\n              {queue.map((item) => (\n                <tr key={item.submissionId} className=\"hover:bg-chalk/70 transition-colors\">\n                  <td className=\"py-3.5 px-4\">\n                    <p className=\"font-medium text-ink\">{item.activityTitle}</p>\n                    <p className=\"text-xs text-olive\">{item.domainName}</p>\n                  </td>\n                  <td className=\"py-3.5 px-4 font-mono text-xs text-ink tabular-nums whitespace-nowrap\">\n                    {item.ageGroupLabel}\n                  </td>\n                  <td className=\"py-3.5 px-4 font-mono text-xs text-olive tabular-nums whitespace-nowrap\">\n                    {formatDateTimeReadable(item.createdAt, locale)}\n                  </td>\n                  <td className=\"py-3.5 px-4 text-xs whitespace-nowrap\">\n                    <span\n                      className={\n                        item.reviewStatus === \'reviewed\'\n                          ? \'text-eucalyptus font-medium\'\n                          : item.reviewStatus === \'in_review\'\n                            ? \'text-ochre font-medium\'\n                            : \'text-ink font-medium\'\n                      }\n                    >\n                      {item.reviewStatus === \'queued\'\n                        ? \'Queued\'\n                        : item.reviewStatus === \'in_review\'\n                          ? \'In Review\'\n                          : \'Reviewed\'}\n                    </span>\n                    {!item.hasActiveVideo && (\n                      <span className=\"text-olive\"> \302\267 Video deleted</span>\n                    )}\n                  </td>\n                  <td className=\"py-3.5 px-4 text-right font-mono text-xs tabular-nums\">\n                    {item.instructionMatchScorePct !== null\n                      ? `${item.instructionMatchScorePct}%`\n                      : \'\342\200\224\'}\n                  </td>\n                  <td className=\"py-3.5 px-4 text-right whitespace-nowrap\">\n                    <button\n                      type=\"button\"\n                      onClick={() => void openSubmission(item)}\n                      className=\"px-3.5 py-1.5 rounded-lg border border-stone bg-chalk text-xs font-medium text-ink hover:bg-oat transition-colors cursor-pointer\"\n                    >\n                      {item.reviewStatus === \'queued\'\n                        ? \'Claim & Review\'\n                        : item.reviewStatus === \'in_review\'\n                          ? \'Continue Review\'\n                          : \'View Review\'}\n                    </button>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    num_lines: 512
    num_bytes: 21322
    line_range_bytes: 21322
  }
}
