    tool_calls {
      id: "call_2911524466466689066"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { createContext, useCallback, useContext, useEffect, useState } from \'react\';\\nimport { api } from \'../lib/api\';\\nimport { translate, type TranslationKey } from \'../shared/i18n\';\\nimport type { AgeGroup, LearningDomain, LocaleCode, UserProfile } from \'../shared/types\';\\n\\ninterface AuthContextValue {\\n  user: UserProfile | null;\\n  loading: boolean;\\n  locale: LocaleCode;\\n  ageGroups: AgeGroup[];\\n  learningDomains: LearningDomain[];\\n  t: (key: TranslationKey) => string;\\n  login: (email: string, password: string) => Promise<UserProfile>;\\n  register: (payload: {\\n    email: string;\\n    password: string;\\n    fullName: string;\\n    phoneNumber?: string;\\n  }) => Promise<UserProfile>;\\n  logout: () => Promise<void>;\\n  refreshUser: () => Promise<void>;\\n}\\n\\nconst AuthContext = createContext<AuthContextValue | null>(null);\\n\\nexport function AuthProvider({ children }: { children: React.ReactNode }) {\\n  const [user, setUser] = useState<UserProfile | null>(null);\\n  const [loading, setLoading] = useState(true);\\n  const [ageGroups, setAgeGroups] = useState<AgeGroup[]>([]);\\n  const [learningDomains, setLearningDomains] = useState<LearningDomain[]>([]);\\n\\n  const locale: LocaleCode = user?.preferredLocale ?? \'en\';\\n\\n  const t = useCallback((key: TranslationKey) => translate(locale, key), [locale]);\\n\\n  const refreshUser = useCallback(async () => {\\n    try {\\n      const { user: fetched } = await api.me();\\n      setUser(fetched);\\n    } catch {\\n      setUser(null);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    let active = true;\\n    async function boot() {\\n      try {\\n        const [metaResult, meResult] = await Promise.allSettled([\\n          api.getCurriculumMeta(),\\n          api.me(),\\n        ]);\\n        if (!active) return;\\n        if (metaResult.status === \'fulfilled\') {\\n          setAgeGroups(metaResult.value.ageGroups);\\n          setLearningDomains(metaResult.value.learningDomains);\\n        }\\n        if (meResult.status === \'fulfilled\') {\\n          setUser(meResult.value.user);\\n        } else {\\n          setUser(null);\\n        }\\n      } finally {\\n        if (active) setLoading(false);\\n      }\\n    }\\n    void boot();\\n    return () => {\\n      active = false;\\n    };\\n  }, []);\\n\\n  const login = useCallback(async (email: string, password: string) => {\\n    const { user: loggedIn } = await api.login(email, password);\\n    setUser(loggedIn);\\n    return loggedIn;\\n  }, []);\\n\\n  const register = useCallback(\\n    async (payload: { email: string; password: string; fullName: string; phoneNumber?: string }) => {\\n      const { user: created } = await api.register(payload);\\n      setUser(created);\\n      return created;\\n    },\\n    []\\n  );\\n\\n  const logout = useCallback(async () => {\\n    await api.logout();\\n    setUser(null);\\n  }, []);\\n\\n  return (\\n    <AuthContext.Provider\\n      value={{\\n        user,\\n        loading,\\n        locale,\\n        ageGroups,\\n        learningDomains,\\n        t,\\n        login,\\n        register,\\n        logout,\\n        refreshUser,\\n      }}\\n    >\\n      {children}\\n    </AuthContext.Provider>\\n  );\\n}\\n\\nexport function useAuth(): AuthContextValue {\\n  const ctx = useContext(AuthContext);\\n  if (!ctx) {\\n    throw new Error(\'useAuth must be used inside AuthProvider\');\\n  }\\n  return ctx;\\n}\\n\", \"Description\":\"Create AuthContext managing real session hydration, curriculum metadata, and i18n translation helper.\", \"Overwrite\":true, \"TargetFile\":\"/src/context/AuthContext.tsx\", \"toolAction\":\"Creating AuthContext provider\", \"toolSummary\":\"Create AuthContext\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2911524466466691599"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\nexport interface TopBarNavItem {\\n  id: string;\\n  label: string;\\n}\\n\\ninterface TopBarProps {\\n  navItems: TopBarNavItem[];\\n  activeNavId: string;\\n  onSelectNav: (id: string) => void;\\n  primaryActionLabel: string;\\n  onPrimaryAction: () => void;\\n  onBrandClick?: () => void;\\n}\\n\\n/**\\n * Strict 3-zone Top Bar Contract:\\n * [Single-element Brand wordmark] \342\200\224 [Concise single-line nav links] \342\200\224 [1 primary action]\\n */\\nexport function TopBar({\\n  navItems,\\n  activeNavId,\\n  onSelectNav,\\n  primaryActionLabel,\\n  onPrimaryAction,\\n  onBrandClick,\\n}: TopBarProps) {\\n  return (\\n    <header className=\\\"sticky top-0 z-30 bg-chalk/95 backdrop-blur-sm border-b border-stone\\\">\\n      <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-8\\\">\\n        {/* Zone 1: Single text element wordmark */}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onBrandClick}\\n          className=\\\"font-serif text-xl font-medium tracking-tight text-ink whitespace-nowrap shrink-0 cursor-pointer\\\"\\n        >\\n          LittleSteps\\n        </button>\\n\\n        {/* Zone 2: Clean single-line text navigation links */}\\n        <nav\\n          aria-label=\\\"Primary navigation\\\"\\n          className=\\\"flex items-center gap-5 sm:gap-7 overflow-x-auto\\\"\\n        >\\n          {navItems.map((item) => {\\n            const isActive = item.id === activeNavId;\\n            return (\\n              <button\\n                key={item.id}\\n                type=\\\"button\\\"\\n                onClick={() => onSelectNav(item.id)}\\n                className={`text-sm py-1 border-b-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                  isActive\\n                    ? \'border-eucalyptus text-ink font-semibold\'\\n                    : \'border-transparent text-olive hover:text-ink font-medium\'\\n                }`}\\n              >\\n                {item.label}\\n              </button>\\n            );\\n          })}\\n        </nav>\\n\\n        {/* Zone 3: Single primary action */}\\n        <div className=\\\"shrink-0\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onPrimaryAction}\\n            className=\\\"px-4 py-2 text-sm font-medium rounded-lg border border-stone bg-linen text-ink hover:bg-oat transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {primaryActionLabel}\\n          </button>\\n        </div>\\n      </div>\\n    </header>\\n  );\\n}\\n\", \"Description\":\"Create strict 3-zone TopBar component following the Top Bar Contract and Warm Montessori Editorial styling.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TopBar.tsx\", \"toolAction\":\"Creating TopBar component\", \"toolSummary\":\"Create TopBar\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2911524466466690036"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Sprout } from \'lucide-react\';\\n\\ninterface EditorialImageProps {\\n  src: string;\\n  alt: string;\\n  className?: string;\\n  aspectClassName?: string;\\n}\\n\\n/**\\n * Resilient editorial photograph wrapper adhering to the Zero-Broken-Image Policy.\\n */\\nexport function EditorialImage({\\n  src,\\n  alt,\\n  className = \'\',\\n  aspectClassName = \'aspect-[4/3]\',\\n}: EditorialImageProps) {\\n  const [failed, setFailed] = useState(false);\\n\\n  if (failed || !src) {\\n    return (\\n      <div\\n        role=\\\"img\\\"\\n        aria-label={alt}\\n        className={`${aspectClassName} ${className} bg-gradient-to-br from-oat via-chalk to-eucalyptus-soft flex flex-col items-center justify-center p-6 text-center`}\\n      >\\n        <Sprout className=\\\"w-7 h-7 text-eucalyptus/60 mb-2\\\" aria-hidden=\\\"true\\\" />\\n        <span className=\\\"font-serif text-sm text-olive max-w-xs\\\">{alt}</span>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className={`${aspectClassName} overflow-hidden bg-oat ${className}`}>\\n      <img\\n        src={src}\\n        alt={alt}\\n        referrerPolicy=\\\"no-referrer\\\"\\n        onError={() => setFailed(true)}\\n        className=\\\"w-full h-full object-cover\\\"\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create resilient EditorialImage component with Montessori fallback container.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/EditorialImage.tsx\", \"toolAction\":\"Creating EditorialImage component\", \"toolSummary\":\"Create EditorialImage\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2911524466466692569"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { ChevronLeft, ChevronRight, Pause, Play, RotateCcw } from \'lucide-react\';\\nimport type { ActivityStep } from \'../shared/types\';\\nimport { EditorialImage } from \'./EditorialImage\';\\n\\ninterface InstructionalGuidePlayerProps {\\n  posterUrl: string;\\n  activityTitle: string;\\n  steps: ActivityStep[];\\n}\\n\\n/**\\n * Interactive step-paced instructional walkthrough allowing caregivers to preview\\n * the exact rhythm and sequence of an activity before practicing with their baby.\\n */\\nexport function InstructionalGuidePlayer({\\n  posterUrl,\\n  activityTitle,\\n  steps,\\n}: InstructionalGuidePlayerProps) {\\n  const [activeIndex, setActiveIndex] = useState(0);\\n  const [isPlaying, setIsPlaying] = useState(false);\\n\\n  useEffect(() => {\\n    if (!isPlaying || steps.length <= 1) return;\\n    const timer = window.setInterval(() => {\\n      setActiveIndex((prev) => {\\n        if (prev >= steps.length - 1) {\\n          setIsPlaying(false);\\n          return prev;\\n        }\\n        return prev + 1;\\n      });\\n    }, 5000);\\n    return () => window.clearInterval(timer);\\n  }, [isPlaying, steps.length]);\\n\\n  const currentStep = steps[activeIndex] ?? steps[0];\\n\\n  const handleRestart = () => {\\n    setActiveIndex(0);\\n    setIsPlaying(true);\\n  };\\n\\n  return (\\n    <div className=\\\"rounded-xl border border-stone bg-linen overflow-hidden\\\">\\n      <div className=\\\"relative aspect-[16/9] bg-oat overflow-hidden\\\">\\n        <EditorialImage\\n          src={posterUrl}\\n          alt={activityTitle}\\n          aspectClassName=\\\"w-full h-full\\\"\\n        />\\n        {/* Measured scrim ensuring >= 4.5:1 text contrast over editorial photography */}\\n        <div className=\\\"absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10 flex flex-col justify-between p-5 sm:p-6\\\">\\n          <div className=\\\"flex items-center justify-between gap-4 text-xs text-white/90\\\">\\n            <span className=\\\"font-mono tabular-nums\\\">\\n              Guided Demonstration \302\267 Step {activeIndex + 1} of {steps.length}\\n            </span>\\n            <span className=\\\"font-mono tabular-nums\\\">\\n              {isPlaying ? \'Playing pace guide\' : \'Paused\'}\\n            </span>\\n          </div>\\n\\n          {currentStep && (\\n            <div className=\\\"max-w-2xl\\\">\\n              <p className=\\\"font-serif text-lg sm:text-xl text-white font-medium mb-1\\\">\\n                {String(currentStep.stepNumber).padStart(2, \'0\')}. {currentStep.title}\\n              </p>\\n              <p className=\\\"text-sm text-white/90 leading-relaxed\\\">\\n                {currentStep.instructionText}\\n              </p>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* Walkthrough playback controls */}\\n      <div className=\\\"px-4 py-3 bg-linen border-t border-stone flex flex-wrap items-center justify-between gap-4\\\">\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setIsPlaying((p) => !p)}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            {isPlaying ? (\\n              <>\\n                <Pause className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                Pause Guide\\n              </>\\n            ) : (\\n              <>\\n                <Play className=\\\"w-4 h-4\\\" aria-hidden=\\\"true\\\" />\\n                Play Step Guide\\n              </>\\n            )}\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setIsPlaying(false);\\n              setActiveIndex((prev) => Math.max(0, prev - 1));\\n            }}\\n            disabled={activeIndex === 0}\\n            aria-label=\\\"Previous step\\\"\\n            className=\\\"p-2 rounded-lg border border-stone text-ink hover:bg-oat disabled:opacity-40 transition-colors cursor-pointer\\\"\\n          >\\n            <ChevronLeft className=\\\"w-4 h-4\\\" />\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setIsPlaying(false);\\n              setActiveIndex((prev) => Math.min(steps.length - 1, prev + 1));\\n            }}\\n            disabled={activeIndex >= steps.length - 1}\\n            aria-label=\\\"Next step\\\"\\n            className=\\\"p-2 rounded-lg border border-stone text-ink hover:bg-oat disabled:opacity-40 transition-colors cursor-pointer\\\"\\n          >\\n            <ChevronRight className=\\\"w-4 h-4\\\" />\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleRestart}\\n            aria-label=\\\"Restart step guide\\\"\\n            className=\\\"p-2 rounded-lg border border-stone text-olive hover:text-ink hover:bg-oat transition-colors cursor-pointer\\\"\\n          >\\n            <RotateCcw className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Step progress bars */}\\n        <div className=\\\"flex items-center gap-1.5 flex-1 max-w-xs\\\">\\n          {steps.map((step, idx) => (\\n            <button\\n              key={step.id}\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setIsPlaying(false);\\n                setActiveIndex(idx);\\n              }}\\n              aria-label={`Jump to step ${idx + 1}`}\\n              className={`h-1.5 flex-1 rounded-full transition-colors cursor-pointer ${\\n                idx <= activeIndex ? \'bg-eucalyptus\' : \'bg-stone\'\\n              }`}\\n            />\\n          ))}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create interactive step-by-step instructional walkthrough player for caregivers.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/InstructionalGuidePlayer.tsx\", \"toolAction\":\"Creating InstructionalGuidePlayer component\", \"toolSummary\":\"Create InstructionalGuidePlayer\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2911524466466691006"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Lock, RefreshCw, ShieldCheck } from \'lucide-react\';\\nimport { api } from \'../lib/api\';\\nimport { formatDaysUntilExpiry } from \'../shared/domain\';\\n\\ninterface SecureVideoPlayerProps {\\n  submissionId: string;\\n  hasActiveVideo: boolean;\\n  expiresAt: string;\\n  deletionReason?: string | null;\\n}\\n\\n/**\\n * Plays private child-activity videos strictly via short-lived (5-min) HMAC-signed\\n * streaming tokens. Never caches publicly and disables download affordances.\\n */\\nexport function SecureVideoPlayer({\\n  submissionId,\\n  hasActiveVideo,\\n  expiresAt,\\n  deletionReason,\\n}: SecureVideoPlayerProps) {\\n  const [streamUrl, setStreamUrl] = useState<string | null>(null);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const loadToken = async () => {\\n    if (!hasActiveVideo) return;\\n    setLoading(true);\\n    setError(null);\\n    try {\\n      const res = await api.getVideoStreamToken(submissionId);\\n      setStreamUrl(res.streamUrl);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to load private video stream.\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    setStreamUrl(null);\\n    if (hasActiveVideo) {\\n      void loadToken();\\n    }\\n  }, [submissionId, hasActiveVideo]);\\n\\n  if (!hasActiveVideo) {\\n    return (\\n      <div className=\\\"rounded-xl border border-stone bg-oat/70 p-6 text-center\\\">\\n        <ShieldCheck className=\\\"w-6 h-6 text-eucalyptus mx-auto mb-2\\\" aria-hidden=\\\"true\\\" />\\n        <p className=\\\"text-sm font-medium text-ink mb-1\\\">\\n          Video Permanently Removed from Private Vault\\n        </p>\\n        <p className=\\\"text-xs text-olive max-w-md mx-auto\\\">\\n          {deletionReason === \'retention_30d\'\\n            ? \'This video was automatically deleted after the 30-day privacy retention window. Written caregiver feedback remains preserved.\'\\n            : \'This video was deleted from storage. Written caregiver coaching notes and rubric scores remain saved.\'}\\n        </p>\\n      </div>\\n    );\\n  }\\n\\n  const daysLeft = formatDaysUntilExpiry(expiresAt);\\n\\n  return (\\n    <div className=\\\"rounded-xl border border-stone bg-linen overflow-hidden\\\">\\n      <div className=\\\"aspect-video bg-ink flex items-center justify-center relative\\\">\\n        {loading && (\\n          <p className=\\\"text-sm text-white/80\\\">Preparing private encrypted stream...</p>\\n        )}\\n        {!loading && error && (\\n          <div className=\\\"p-6 text-center\\\">\\n            <p className=\\\"text-sm text-white/90 mb-3\\\">{error}</p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => void loadToken()}\\n              className=\\\"inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/15 text-white text-xs font-medium hover:bg-white/25 transition-colors cursor-pointer\\\"\\n            >\\n              <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n              Refresh Private Stream\\n            </button>\\n          </div>\\n        )}\\n        {!loading && !error && streamUrl && (\\n          <video\\n            key={streamUrl}\\n            src={streamUrl}\\n            controls\\n            controlsList=\\\"nodownload noplaybackrate\\\"\\n            disablePictureInPicture\\n            playsInline\\n            onContextMenu={(e) => e.preventDefault()}\\n            className=\\\"w-full h-full object-contain bg-black\\\"\\n          />\\n        )}\\n      </div>\\n      <div className=\\\"px-4 py-2.5 bg-oat/60 border-t border-stone flex flex-wrap items-center justify-between gap-2 text-xs text-olive\\\">\\n        <span className=\\\"inline-flex items-center gap-1.5\\\">\\n          <Lock className=\\\"w-3.5 h-3.5 text-eucalyptus\\\" aria-hidden=\\\"true\\\" />\\n          Private signed stream \302\267 Access audited \302\267 Non-downloadable\\n        </span>\\n        <span className=\\\"font-mono tabular-nums\\\">\\n          Auto-deletes in {daysLeft} {daysLeft === 1 ? \'day\' : \'days\'}\\n        </span>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create SecureVideoPlayer fetching short-lived signed streaming URLs with privacy retention indicator.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SecureVideoPlayer.tsx\", \"toolAction\":\"Creating SecureVideoPlayer component\", \"toolSummary\":\"Create SecureVideoPlayer\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2911524466466689443"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport { Camera, Film, Shield, Square, Upload, Video } from \'lucide-react\';\\nimport { api } from \'../lib/api\';\\nimport { MAX_VIDEO_DURATION_SECONDS, MAX_VIDEO_SIZE_BYTES } from \'../shared/domain\';\\nimport type { VideoSubmissionSummary } from \'../shared/types\';\\n\\ninterface VideoCaptureUploaderProps {\\n  childId: string;\\n  activityId: string;\\n  activityTitle: string;\\n  onSubmitted: (submission: VideoSubmissionSummary) => void;\\n  onCancel: () => void;\\n}\\n\\nexport function VideoCaptureUploader({\\n  childId,\\n  activityId,\\n  activityTitle,\\n  onSubmitted,\\n  onCancel,\\n}: VideoCaptureUploaderProps) {\\n  const [selectedFile, setSelectedFile] = useState<Blob | null>(null);\\n  const [filename, setFilename] = useState<string>(\'practice.webm\');\\n  const [previewUrl, setPreviewUrl] = useState<string | null>(null);\\n  const [durationSeconds, setDurationSeconds] = useState<number>(10);\\n  const [caregiverNotes, setCaregiverNotes] = useState(\'\');\\n  const [consentConfirmed, setConsentConfirmed] = useState(false);\\n\\n  const [isRecording, setIsRecording] = useState(false);\\n  const [isGeneratingSample, setIsGeneratingSample] = useState(false);\\n  const [recordSeconds, setRecordSeconds] = useState(0);\\n  const [uploading, setUploading] = useState(false);\\n  const [uploadProgress, setUploadProgress] = useState(0);\\n  const [error, setError] = useState<string | null>(null);\\n\\n  const liveVideoRef = useRef<HTMLVideoElement | null>(null);\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n  const streamRef = useRef<MediaStream | null>(null);\\n  const chunksRef = useRef<Blob[]>([]);\\n  const timerRef = useRef<number | null>(null);\\n\\n  const cleanupCamera = () => {\\n    if (timerRef.current) {\\n      window.clearInterval(timerRef.current);\\n      timerRef.current = null;\\n    }\\n    if (streamRef.current) {\\n      streamRef.current.getTracks().forEach((t) => t.stop());\\n      streamRef.current = null;\\n    }\\n  };\\n\\n  useEffect(() => {\\n    return () => {\\n      cleanupCamera();\\n      if (previewUrl) URL.revokeObjectURL(previewUrl);\\n    };\\n  }, [previewUrl]);\\n\\n  const setPreparedVideo = (blob: Blob, name: string, seconds: number) => {\\n    if (previewUrl) URL.revokeObjectURL(previewUrl);\\n    const url = URL.createObjectURL(blob);\\n    setSelectedFile(blob);\\n    setFilename(name);\\n    setDurationSeconds(Math.max(1, Math.min(MAX_VIDEO_DURATION_SECONDS, Math.round(seconds))));\\n    setPreviewUrl(url);\\n    setError(null);\\n  };\\n\\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    if (file.size > MAX_VIDEO_SIZE_BYTES) {\\n      setError(\'Please choose a video smaller than 50 MB.\');\\n      return;\\n    }\\n    const normalized = file.type.split(\';\')[0].toLowerCase();\\n    if (![\'video/mp4\', \'video/webm\', \'video/quicktime\'].includes(normalized)) {\\n      setError(\'Please upload an MP4, WebM, or MOV video file.\');\\n      return;\\n    }\\n    const tempUrl = URL.createObjectURL(file);\\n    const probe = document.createElement(\'video\');\\n    probe.preload = \'metadata\';\\n    probe.onloadedmetadata = () => {\\n      const dur = Number.isFinite(probe.duration) ? probe.duration : 15;\\n      URL.revokeObjectURL(tempUrl);\\n      if (dur > MAX_VIDEO_DURATION_SECONDS) {\\n        setError(\'Please keep activity clips under 2 minutes so uploads stay light and fast.\');\\n        return;\\n      }\\n      setPreparedVideo(file, file.name, dur);\\n    };\\n    probe.onerror = () => {\\n      URL.revokeObjectURL(tempUrl);\\n      setPreparedVideo(file, file.name, 15);\\n    };\\n    probe.src = tempUrl;\\n  };\\n\\n  const startCameraRecording = async () => {\\n    setError(null);\\n    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === \'undefined\') {\\n      setError(\\n        \'Camera recording is unavailable in this browser. You can upload a video file or record a 3-second test clip below.\'\\n      );\\n      return;\\n    }\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });\\n      streamRef.current = stream;\\n      if (liveVideoRef.current) {\\n        liveVideoRef.current.srcObject = stream;\\n        await liveVideoRef.current.play();\\n      }\\n      chunksRef.current = [];\\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm;codecs=vp8\')\\n        ? \'video/webm;codecs=vp8\'\\n        : \'video/webm\';\\n      const recorder = new MediaRecorder(stream, { mimeType });\\n      mediaRecorderRef.current = recorder;\\n\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data.size > 0) chunksRef.current.push(ev.data);\\n      };\\n      recorder.onstop = () => {\\n        const blob = new Blob(chunksRef.current, { type: \'video/webm\' });\\n        cleanupCamera();\\n        setIsRecording(false);\\n        setPreparedVideo(blob, `littlesteps-recording-${Date.now()}.webm`, Math.max(1, recordSeconds));\\n      };\\n\\n      setRecordSeconds(0);\\n      setIsRecording(true);\\n      recorder.start(250);\\n\\n      timerRef.current = window.setInterval(() => {\\n        setRecordSeconds((prev) => {\\n          const next = prev + 1;\\n          if (next >= MAX_VIDEO_DURATION_SECONDS) {\\n            recorder.stop();\\n          }\\n          return next;\\n        });\\n      }, 1000);\\n    } catch {\\n      cleanupCamera();\\n      setIsRecording(false);\\n      setError(\\n        \'Could not access camera permission. You can upload a saved video clip or record a 3-second sample clip.\'\\n      );\\n    }\\n  };\\n\\n  const stopCameraRecording = () => {\\n    if (mediaRecorderRef.current && mediaRecorderRef.current.state !== \'inactive\') {\\n      mediaRecorderRef.current.stop();\\n    }\\n  };\\n\\n  /**\\n   * Generates a real binary WebM clip via HTMLCanvasElement.captureStream() + MediaRecorder\\n   * so caregivers/testers on devices without a webcam can test genuine end-to-end encrypted vault upload & review.\\n   */\\n  const recordSampleTestClip = async () => {\\n    setError(null);\\n    if (typeof MediaRecorder === \'undefined\') {\\n      setError(\'MediaRecorder is unavailable in this browser. Please choose a video file to upload.\');\\n      return;\\n    }\\n    setIsGeneratingSample(true);\\n    try {\\n      const canvas = document.createElement(\'canvas\');\\n      canvas.width = 640;\\n      canvas.height = 360;\\n      const ctx = canvas.getContext(\'2d\');\\n      if (!ctx) throw new Error(\'Canvas unavailable\');\\n\\n      const stream = canvas.captureStream(20);\\n      const mimeType = MediaRecorder.isTypeSupported(\'video/webm\') ? \'video/webm\' : \'\';\\n      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);\\n      const chunks: Blob[] = [];\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data.size > 0) chunks.push(ev.data);\\n      };\\n\\n      const done = new Promise<Blob>((resolve) => {\\n        recorder.onstop = () => {\\n          stream.getTracks().forEach((t) => t.stop());\\n          resolve(new Blob(chunks, { type: \'video/webm\' }));\\n        };\\n      });\\n\\n      recorder.start();\\n      let frame = 0;\\n      const drawInterval = window.setInterval(() => {\\n        frame += 1;\\n        ctx.fillStyle = \'#FAF9F6\';\\n        ctx.fillRect(0, 0, 640, 360);\\n        ctx.strokeStyle = \'#E6E3DC\';\\n        ctx.lineWidth = 2;\\n        ctx.strokeRect(24, 24, 592, 312);\\n\\n        // Gentle expanding botanical circle representing calm caregiver pacing\\n        const radius = 34 + Math.sin(frame / 8) * 10;\\n        ctx.beginPath();\\n        ctx.arc(320, 140, radius, 0, Math.PI * 2);\\n        ctx.fillStyle = \'#EAF1EE\';\\n        ctx.fill();\\n        ctx.strokeStyle = \'#2F5D50\';\\n        ctx.lineWidth = 2;\\n        ctx.stroke();\\n\\n        ctx.fillStyle = \'#1F2421\';\\n        ctx.font = \'600 20px Georgia, serif\';\\n        ctx.textAlign = \'center\';\\n        ctx.fillText(activityTitle.slice(0, 44), 320, 235);\\n\\n        ctx.fillStyle = \'#57605A\';\\n        ctx.font = \'14px sans-serif\';\\n        ctx.fillText(`Caregiver Practice Clip \302\267 00:0${Math.min(3, Math.floor(frame / 20))}`, 320, 268);\\n        ctx.fillText(\'Private 30-day vault recording\', 320, 294);\\n      }, 50);\\n\\n      await new Promise((r) => window.setTimeout(r, 3000));\\n      window.clearInterval(drawInterval);\\n      recorder.stop();\\n      const blob = await done;\\n      setPreparedVideo(blob, `practice-sample-${Date.now()}.webm`, 3);\\n    } catch {\\n      setError(\'Could not generate a sample clip in this browser. Please upload a video file instead.\');\\n    } finally {\\n      setIsGeneratingSample(false);\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!selectedFile) {\\n      setError(\'Please record or select a short practice clip first.\');\\n      return;\\n    }\\n    if (!consentConfirmed) {\\n      setError(\'Please confirm private review consent before uploading.\');\\n      return;\\n    }\\n\\n    setUploading(true);\\n    setUploadProgress(5);\\n    setError(null);\\n    try {\\n      const { submission } = await api.uploadSubmissionVideo(\\n        {\\n          childId,\\n          activityId,\\n          file: selectedFile,\\n          filename,\\n          durationSeconds,\\n          caregiverNotes,\\n          consentConfirmed,\\n        },\\n        (pct) => setUploadProgress(pct)\\n      );\\n      onSubmitted(submission);\\n    } catch (err) {\\n      setError(err instanceof Error ? err.message : \'Unable to upload video.\');\\n    } finally {\\n      setUploading(false);\\n    }\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit} className=\\\"rounded-xl border border-stone bg-linen p-5 sm:p-6 space-y-5\\\">\\n      <div className=\\\"flex items-start justify-between gap-4\\\">\\n        <div>\\n          <h3 className=\\\"font-serif text-xl font-medium text-ink\\\">\\n            Share a Short Practice Clip for Feedback\\n          </h3>\\n          <p className=\\\"text-sm text-olive mt-1\\\">\\n            A reviewer will assess how clearly the activity steps were demonstrated and share one encouraging tip.\\n          </p>\\n        </div>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onCancel}\\n          className=\\\"text-sm text-olive hover:text-ink transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n        >\\n          Cancel\\n        </button>\\n      </div>\\n\\n      {/* Capture / Upload options */}\\n      {!isRecording && !previewUrl && (\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => void startCameraRecording()}\\n            className=\\\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center cursor-pointer\\\"\\n          >\\n            <Camera className=\\\"w-5 h-5 text-eucalyptus\\\" aria-hidden=\\\"true\\\" />\\n            <span className=\\\"text-sm font-medium text-ink\\\">Record with Camera</span>\\n            <span className=\\\"text-xs text-olive\\\">Up to 2 minutes</span>\\n          </button>\\n\\n          <label className=\\\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center cursor-pointer\\\">\\n            <Upload className=\\\"w-5 h-5 text-eucalyptus\\\" aria-hidden=\\\"true\\\" />\\n            <span className=\\\"text-sm font-medium text-ink\\\">Upload Video File</span>\\n            <span className=\\\"text-xs text-olive\\\">MP4, WebM, MOV \302\267 Max 50 MB</span>\\n            <input\\n              type=\\\"file\\\"\\n              accept=\\\"video/mp4,video/webm,video/quicktime\\\"\\n              onChange={handleFileChange}\\n              className=\\\"sr-only\\\"\\n            />\\n          </label>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => void recordSampleTestClip()}\\n            disabled={isGeneratingSample}\\n            className=\\\"flex flex-col items-center justify-center gap-2 p-5 rounded-lg border border-stone bg-chalk hover:bg-oat transition-colors text-center disabled:opacity-50 cursor-pointer\\\"\\n          >\\n            <Film className=\\\"w-5 h-5 text-eucalyptus\\\" aria-hidden=\\\"true\\\" />\\n            <span className=\\\"text-sm font-medium text-ink\\\">\\n              {isGeneratingSample ? \'Creating 3s Clip...\' : \'Record 3s Test Clip\'}\\n            </span>\\n            <span className=\\\"text-xs text-olive\\\">No camera required</span>\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Live recording preview */}\\n      {isRecording && (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"aspect-video rounded-lg overflow-hidden bg-black relative\\\">\\n            <video ref={liveVideoRef} muted playsInline className=\\\"w-full h-full object-cover\\\" />\\n            <div className=\\\"absolute top-3 left-3 px-2.5 py-1 rounded bg-black/75 text-white text-xs font-mono tabular-nums\\\">\\n              Recording \302\267 {String(Math.floor(recordSeconds / 60)).padStart(2, \'0\')}:\\n              {String(recordSeconds % 60).padStart(2, \'0\')}\\n            </div>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={stopCameraRecording}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-crimson text-white text-sm font-medium hover:opacity-90 transition-opacity cursor-pointer\\\"\\n          >\\n            <Square className=\\\"w-4 h-4\\\" />\\n            Stop Recording\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Prepared video preview */}\\n      {previewUrl && !isRecording && (\\n        <div className=\\\"space-y-3\\\">\\n          <div className=\\\"aspect-video rounded-lg overflow-hidden bg-black\\\">\\n            <video src={previewUrl} controls playsInline className=\\\"w-full h-full object-contain\\\" />\\n          </div>\\n          <div className=\\\"flex items-center justify-between text-xs text-olive\\\">\\n            <span className=\\\"inline-flex items-center gap-1.5 font-mono tabular-nums\\\">\\n              <Video className=\\\"w-3.5 h-3.5 text-eucalyptus\\\" />\\n              {filename} \302\267 {durationSeconds}s \302\267{\' \'}\\n              {selectedFile ? `${(selectedFile.size / (1024 * 1024)).toFixed(2)} MB` : \'\'}\\n            </span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                if (previewUrl) URL.revokeObjectURL(previewUrl);\\n                setPreviewUrl(null);\\n                setSelectedFile(null);\\n              }}\\n              className=\\\"text-eucalyptus hover:underline font-medium cursor-pointer\\\"\\n            >\\n              Choose a different clip\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Optional caregiver reflection */}\\n      <div>\\n        <label htmlFor=\\\"caregiver-video-note\\\" className=\\\"block text-sm font-medium text-ink mb-1.5\\\">\\n          Optional note for your reviewer\\n        </label>\\n        <textarea\\n          id=\\\"caregiver-video-note\\\"\\n          rows={2}\\n          value={caregiverNotes}\\n          onChange={(e) => setCaregiverNotes(e.target.value)}\\n          placeholder=\\\"For example: Morning session after feeding, used a steel katori and wooden spoon.\\\"\\n          className=\\\"w-full rounded-lg border border-stone bg-chalk px-3.5 py-2.5 text-sm text-ink placeholder:text-olive/70 focus:border-eucalyptus\\\"\\n        />\\n      </div>\\n\\n      {/* Explicit Child Video Privacy & Non-Diagnostic Notice */}\\n      <div className=\\\"rounded-lg border border-stone bg-oat/70 p-4 space-y-3\\\">\\n        <div className=\\\"flex items-start gap-2.5 text-xs text-olive leading-relaxed\\\">\\n          <Shield className=\\\"w-4 h-4 text-eucalyptus shrink-0 mt-0.5\\\" aria-hidden=\\\"true\\\" />\\n          <div>\\n            <p className=\\\"font-medium text-ink\\\">Private \302\267 Auto-deletes in 30 days \302\267 Delete anytime</p>\\n            <p className=\\\"mt-0.5\\\">\\n              Your clip is stored in a private vault accessible only to you and your assigned reviewer (who sees only your baby\342\200\231s age band, never your contact details). Review scores measure caregiver activity execution only\342\200\224never your baby\342\200\231s development or health.\\n            </p>\\n          </div>\\n        </div>\\n\\n        <label className=\\\"flex items-start gap-2.5 text-sm text-ink cursor-pointer\\\">\\n          <input\\n            type=\\\"checkbox\\\"\\n            checked={consentConfirmed}\\n            onChange={(e) => setConsentConfirmed(e.target.checked)}\\n            className=\\\"mt-1 h-4 w-4 rounded border-stone accent-eucalyptus\\\"\\n          />\\n          <span>\\n            I consent to private storage of this activity clip for caregiver feedback under the 30-day auto-deletion policy.\\n          </span>\\n        </label>\\n      </div>\\n\\n      {error && (\\n        <p role=\\\"alert\\\" className=\\\"text-sm text-crimson bg-crimson-soft px-3.5 py-2.5 rounded-lg\\\">\\n          {error}\\n        </p>\\n      )}\\n\\n      {uploading && (\\n        <div className=\\\"space-y-1.5\\\">\\n          <div className=\\\"flex justify-between text-xs text-olive font-mono tabular-nums\\\">\\n            <span>Encrypting & uploading to private vault...</span>\\n            <span>{uploadProgress}%</span>\\n          </div>\\n          <div className=\\\"h-1.5 w-full rounded-full bg-oat overflow-hidden\\\">\\n            <div\\n              className=\\\"h-full bg-eucalyptus transition-all duration-150\\\"\\n              style={{ width: `${uploadProgress}%` }}\\n            />\\n          </div>\\n        </div>\\n      )}\\n\\n      <div className=\\\"flex items-center justify-end gap-3 pt-1\\\">\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onCancel}\\n          disabled={uploading}\\n          className=\\\"px-4 py-2 text-sm font-medium text-olive hover:text-ink transition-colors cursor-pointer\\\"\\n        >\\n          Cancel\\n        </button>\\n        <button\\n          type=\\\"submit\\\"\\n          disabled={uploading || !selectedFile || !consentConfirmed}\\n          className=\\\"px-5 py-2.5 rounded-lg bg-eucalyptus text-white text-sm font-medium hover:bg-eucalyptus-hover disabled:opacity-45 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n        >\\n          {uploading ? \'Uploading...\' : \'Submit Clip for Review\'}\\n        </button>\\n      </div>\\n    </form>\\n  );\\n}\\n\", \"Description\":\"Create VideoCaptureUploader supporting live camera recording, file upload, 3s test clip generation, explicit 30-day consent, and progress bar.\", \"Overwrite\":true, \"TargetFile\":\"/src/components/VideoCaptureUploader.tsx\", \"toolAction\":\"Creating VideoCaptureUploader component\", \"toolSummary\":\"Create VideoCaptureUploader\"}"
      original_name: "write_to_file"
    }
