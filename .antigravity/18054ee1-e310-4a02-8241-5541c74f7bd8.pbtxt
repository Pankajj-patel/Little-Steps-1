      arguments_json: "{\"CodeContent\":\"import React, { useId } from \'react\';\\n\\nexport interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {\\n  label: string;\\n  helperText?: string;\\n  error?: string;\\n  leadingIcon?: React.ReactNode;\\n}\\n\\nexport const Input = React.forwardRef<HTMLInputElement, InputProps>(function Input(\\n  { label, helperText, error, leadingIcon, id, required, disabled, className = \'\', ...rest },\\n  ref\\n) {\\n  const autoId = useId();\\n  const inputId = id ?? autoId;\\n  const helperId = `${inputId}-helper`;\\n  const errorId = `${inputId}-error`;\\n\\n  const describedBy = [error ? errorId : null, helperText && !error ? helperId : null]\\n    .filter(Boolean)\\n    .join(\' \');\\n\\n  return (\\n    <div className=\\\"space-y-1.5 w-full\\\">\\n      <label htmlFor={inputId} className=\\\"block text-sm font-medium text-charcoal\\\">\\n        {label}\\n        {required && (\\n          <span className=\\\"text-danger ml-0.5\\\" aria-hidden=\\\"true\\\">\\n            *\\n          </span>\\n        )}\\n      </label>\\n\\n      <div className=\\\"relative\\\">\\n        {leadingIcon && (\\n          <span\\n            aria-hidden=\\\"true\\\"\\n            className=\\\"pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muted\\\"\\n          >\\n            {leadingIcon}\\n          </span>\\n        )}\\n        <input\\n          ref={ref}\\n          id={inputId}\\n          required={required}\\n          disabled={disabled}\\n          aria-invalid={Boolean(error) || undefined}\\n          aria-describedby={describedBy || undefined}\\n          className={`w-full min-h-[44px] rounded-lg border bg-surface px-3.5 py-2.5 text-sm text-charcoal placeholder:text-muted/70 transition-colors disabled:bg-cream disabled:text-muted disabled:cursor-not-allowed ${\\n            leadingIcon ? \'pl-10\' : \'\'\\n          } ${\\n            error\\n              ? \'border-danger focus:border-danger\'\\n              : \'border-border-strong hover:border-sage/70 focus:border-sage\'\\n          } ${className}`}\\n          {...rest}\\n        />\\n      </div>\\n\\n      {error ? (\\n        <p id={errorId} role=\\\"alert\\\" className=\\\"text-xs text-danger\\\">\\n          {error}\\n        </p>\\n      ) : helperText ? (\\n        <p id={helperId} className=\\\"text-xs text-muted\\\">\\n          {helperText}\\n        </p>\\n      ) : null}\\n    </div>\\n  );\\n});\\n\", \"Description\":\"Create accessible LittleSteps Input component with label, helper text, error ARIA wiring, and 44px one-handed mobile touch target.\", \"Overwrite\":true, \"TargetFile\":\"/src/design-system/Input.tsx\", \"toolAction\":\"Creating Input component\", \"toolSummary\":\"Create Input component\"}"
