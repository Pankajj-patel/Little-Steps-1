    wait_ms_before_async: 10000
    combined_output {
      full: "1-2. RBAC & Reviewer Dashboard Summary OK: { totalPending: 0, underReview: 0, completedReviews: 1 }3. Draft privacy boundary verified (parent review === null while reviewer sees draft).4. 4-level weighted formula verified: { scorePct: 50, earned: 40, applicable: 80 }5. Versioned edit & immutable audit history verified: [ \'updated\', \'published\', \'draft_saved\' ]6. Not Assessable (insufficient evidence) flow verified: scorePct === null.7. Request Another Submission flow & audit history verified.8. Cleaned up temporary test data cleanly.ALL STEP 8 E2E CHECKS PASSED!"
    }
    command_line: "node -e \'\n(async () => {\n  const BASE = \"http://localhost:3000/api/v1\";\n\n  async function login(email, password) {\n    const r = await fetch(`${BASE}/auth/login`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ email, password }),\n    });\n    if (!r.ok) throw new Error(`Login failed for ${email}: ${r.status}`);\n    const cookie = r.headers.get(\"set-cookie\")?.split(\";\")[0];\n    if (!cookie) throw new Error(\"No session cookie\");\n    return cookie;\n  }\n\n  async function apiFetch(cookie, path, opts = {}) {\n    const headers = { ...(opts.headers || {}), Cookie: cookie };\n    if (opts.body && !(opts.body instanceof FormData)) {\n      headers[\"Content-Type\"] = \"application/json\";\n    }\n    const r = await fetch(`${BASE}${path}`, { ...opts, headers });\n    const data = await r.json().catch(() => ({}));\n    return { status: r.status, data };\n  }\n\n  const assert = (cond, msg) => {\n    if (!cond) throw new Error(`ASSERTION FAILED: ${msg}`);\n  };\n\n  const parentCookie = await login(\"meera@littlesteps.in\", \"LittleSteps123!\");\n  const reviewerCookie = await login(\"ananya.reviewer@littlesteps.in\", \"LittleSteps123!\");\n\n  // 1. RBAC: Parent blocked from reviewer endpoints\n  const parentQueue = await apiFetch(parentCookie, \"/reviewer/queue\");\n  assert(parentQueue.status === 403, `Expected 403 for parent on /reviewer/queue, got ${parentQueue.status}`);\n\n  // 2. Reviewer dashboard summary & PII minimization\n  const qRes = await apiFetch(reviewerCookie, \"/reviewer/queue?status=all&ageGroupSlug=all\");\n  assert(qRes.status === 200, `Queue failed: ${qRes.status}`);\n  assert(typeof qRes.data.summary.totalPending === \"number\", \"Missing summary.totalPending\");\n  assert(typeof qRes.data.summary.underReview === \"number\", \"Missing summary.underReview\");\n  assert(typeof qRes.data.summary.completedReviews === \"number\", \"Missing summary.completedReviews\");\n  assert(Array.isArray(qRes.data.summary.recentSubmissions), \"Missing summary.recentSubmissions\");\n  if (qRes.data.queue.length > 0) {\n    const first = qRes.data.queue[0];\n    assert(/^PAR-[A-Z0-9]{6}$/.test(first.parentReference), `Bad parentReference: ${first.parentReference}`);\n    assert(!(\"email\" in first) && !(\"parentEmail\" in first) && !(\"parentName\" in first), \"PII leaked in queue\");\n    assert([\"high\", \"normal\", \"low\"].includes(first.priority), `Bad priority: ${first.priority}`);\n    assert(typeof first.activityVersion === \"number\", \"Missing activityVersion\");\n  }\n  console.log(\"1-2. RBAC & Reviewer Dashboard Summary OK:\", {\n    totalPending: qRes.data.summary.totalPending,\n    underReview: qRes.data.summary.underReview,\n    completedReviews: qRes.data.summary.completedReviews,\n  });\n\n  // 3. Create temp child and upload 3 tiny WebM clips (EBML magic bytes 1A 45 DF A3)\n  const dob = new Date();\n  dob.setMonth(dob.getMonth() - 7);\n  const childRes = await apiFetch(parentCookie, \"/children\", {\n    method: \"POST\",\n    body: JSON.stringify({\n      displayName: \"Step8TempBaby\",\n      dateOfBirth: dob.toISOString().slice(0, 10),\n    }),\n  });\n  assert(childRes.status === 201, `Child create failed: ${childRes.status}`);\n  const childId = childRes.data.child.id;\n\n  const journeyRes = await apiFetch(parentCookie, `/journey/${childId}/today`);\n  assert(journeyRes.status === 200 && journeyRes.data.items.length >= 2, \"Need at least 2 activities\");\n  const act1 = journeyRes.data.items[0].activity;\n  const act2 = journeyRes.data.items[1].activity;\n\n  async function uploadClip(activityId, note) {\n    const fd = new FormData();\n    const bytes = new Uint8Array([0x1a, 0x45, 0xdf, 0xa3, 0x9f, 0x42, 0x86, 0x81, 0x01, 0x00, 0x00, 0x00]);\n    fd.append(\"video\", new Blob([bytes], { type: \"video/webm\" }), \"step8-test.webm\");\n    fd.append(\"childId\", childId);\n    fd.append(\"activityId\", activityId);\n    fd.append(\"durationSeconds\", \"18\");\n    fd.append(\"caregiverNotes\", note);\n    fd.append(\"consentConfirmed\", \"true\");\n    const up = await apiFetch(parentCookie, \"/submissions\", { method: \"POST\", body: fd });\n    assert(up.status === 201, `Upload failed: ${up.status} ${JSON.stringify(up.data)}`);\n    return up.data.submission.id;\n  }\n\n  const sub1 = await uploadClip(act1.id, \"Parent note for Step 8 draft/publish/edit test.\");\n  const sub2 = await uploadClip(act2.id, \"Parent note for Not Assessable test.\");\n  const sub3 = await uploadClip(act1.id, \"Parent note for Request Changes test.\");\n\n  try {\n    // 4. Flow A: Claim -> Save Draft -> Verify Parent Hidden -> Missing Explanation Rejected -> Publish 4-Level -> Verify Math & Parent View -> Edit v2 & Audit History\n    const claim1 = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/claim`, { method: \"POST\" });\n    assert(claim1.status === 200, `Claim sub1 failed: ${claim1.status}`);\n    const criteria = claim1.data.activity.rubricCriteria;\n    assert(criteria.length >= 3, `Expected >= 3 rubric criteria, got ${criteria.length}`);\n\n    // Save Draft\n    const draftRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"draft\",\n        strengthsNote: \"Draft warm note in progress\",\n        coachingTip: \"\",\n        reviewerComments: \"Draft internal comment\",\n        evaluationScopeAcknowledged: false,\n        criterionRatings: criteria.map((c) => ({ criterionId: c.id, achievedLevel: \"met\" })),\n      }),\n    });\n    assert(draftRes.status === 201, `Draft save failed: ${draftRes.status} ${JSON.stringify(draftRes.data)}`);\n    assert(draftRes.data.review.reviewStatus === \"draft\", \"Expected draft status\");\n\n    // Verify Parent does NOT see draft\n    const parentCheckDraft = await apiFetch(parentCookie, `/journey/${childId}/today`);\n    const pSub1Draft = parentCheckDraft.data.recentSubmissions.find((s) => s.id === sub1);\n    assert(pSub1Draft && pSub1Draft.review === null, \"Parent must NOT see unpublished draft review!\");\n    console.log(\"3. Draft privacy boundary verified (parent review === null while reviewer sees draft).\");\n\n    // Attempt publish with not_assessable missing explanation -> must reject 400\n    const badRatings = criteria.map((c, idx) => ({\n      criterionId: c.id,\n      achievedLevel: idx === criteria.length - 1 ? \"not_assessable\" : \"met\",\n    }));\n    const badPub = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Calm eye-level setup and gentle voice throughout.\",\n        coachingTip: \"Try pausing two seconds longer after each step.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: badRatings,\n      }),\n    });\n    assert(badPub.status === 400, `Expected 400 for missing not_assessable explanation, got ${badPub.status}`);\n\n    // Publish with mixed 4-level ratings: Met (1), Partial (0.5), Not met (0), Not assessable (excluded)\n    const levels = [\"met\", \"partially_met\", \"not_met\", \"not_assessable\"];\n    const mixedRatings = criteria.map((c, idx) => {\n      const level = levels[Math.min(idx, levels.length - 1)];\n      return {\n        criterionId: c.id,\n        achievedLevel: level,\n        explanation:\n          level === \"not_assessable\"\n            ? \"Camera angle was cropped so this step was out of frame.\"\n            : level === \"partially_met\"\n              ? \"Gentle pace overall; slight rush on transition.\"\n              : null,\n      };\n    });\n\n    // Compute expected formula independently\n    let expectedEarned = 0;\n    let expectedApplicable = 0;\n    criteria.forEach((c, idx) => {\n      const level = levels[Math.min(idx, levels.length - 1)];\n      if (level === \"met\") { expectedEarned += c.weightPoints; expectedApplicable += c.weightPoints; }\n      else if (level === \"partially_met\") { expectedEarned += c.weightPoints * 0.5; expectedApplicable += c.weightPoints; }\n      else if (level === \"not_met\") { expectedApplicable += c.weightPoints; }\n    });\n    const expectedPct = Math.round((expectedEarned / expectedApplicable) * 100);\n\n    const pubRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Calm eye-level setup and gentle reassuring tone throughout.\",\n        coachingTip: \"Try pausing two extra seconds before introducing the second object.\",\n        reviewerComments: \"Lovely calm connection; thank you for sharing this session.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: mixedRatings,\n      }),\n    });\n    assert(pubRes.status === 201, `Publish failed: ${pubRes.status} ${JSON.stringify(pubRes.data)}`);\n    assert(pubRes.data.review.isAssessable === true, \"Expected assessable review\");\n    assert(\n      pubRes.data.review.instructionMatchScorePct === expectedPct,\n      `Formula mismatch: got ${pubRes.data.review.instructionMatchScorePct}, expected ${expectedPct}`\n    );\n    assert(pubRes.data.review.version === 1, `Expected v1, got ${pubRes.data.review.version}`);\n    console.log(\"4. 4-level weighted formula verified:\", {\n      scorePct: pubRes.data.review.instructionMatchScorePct,\n      earned: pubRes.data.review.earnedWeightPoints,\n      applicable: pubRes.data.review.applicableWeightPoints,\n    });\n\n    // Verify Parent sees ALL 6 result fields\n    const parentAfterPub = await apiFetch(parentCookie, `/journey/${childId}/today`);\n    const pSub1 = parentAfterPub.data.recentSubmissions.find((s) => s.id === sub1);\n    assert(pSub1?.review?.instructionMatchScorePct === expectedPct, \"Parent score mismatch\");\n    assert(pSub1?.review?.reviewerComments?.includes(\"Lovely calm connection\"), \"Missing reviewerComments for parent\");\n    assert(pSub1?.review?.rubricScores.some((s) => s.achievedLevel === \"not_assessable\" && s.explanation), \"Missing criterion explanation for parent\");\n\n    // Verify Parent CANNOT edit published review\n    const parentEdit = await apiFetch(parentCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({ mode: \"publish\", strengthsNote: \"hack\", coachingTip: \"hack\", evaluationScopeAcknowledged: true, criterionRatings: [] }),\n    });\n    assert(parentEdit.status === 403, `Expected 403 for parent review edit, got ${parentEdit.status}`);\n\n    // Reviewer edits published review -> version increments to 2 & history preserves prior versions\n    const editRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Updated: calm eye-level setup and wonderfully responsive pacing.\",\n        coachingTip: \"Updated tip: keep the mat clear of extra distractions.\",\n        reviewerComments: \"Revised comment after double-checking step 3.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: criteria.map((c) => ({ criterionId: c.id, achievedLevel: \"met\" })),\n      }),\n    });\n    assert(editRes.status === 201 && editRes.data.review.version === 2, \"Expected version 2 on edit\");\n    assert(editRes.data.review.instructionMatchScorePct === 100, \"Expected 100% on all Met edit\");\n    const histActions = editRes.data.detail.history.map((h) => h.action);\n    assert(\n      histActions.includes(\"draft_saved\") && histActions.includes(\"published\") && histActions.includes(\"updated\"),\n      `Missing audit history entries: ${JSON.stringify(histActions)}`\n    );\n    console.log(\"5. Versioned edit & immutable audit history verified:\", histActions);\n\n    // 5. Flow B: Mark Evidence Insufficient (Not Assessable)\n    await apiFetch(reviewerCookie, `/reviewer/submissions/${sub2}/claim`, { method: \"POST\" });\n    const naRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub2}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"not_assessable\",\n        notAssessableReason: \"The lighting was too dark to observe the materials or steps clearly.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: [],\n      }),\n    });\n    assert(naRes.status === 201, `Not assessable failed: ${naRes.status} ${JSON.stringify(naRes.data)}`);\n    assert(naRes.data.review.isAssessable === false, \"Expected isAssessable === false\");\n    assert(naRes.data.review.instructionMatchScorePct === null, \"Expected null scorePct for Not Assessable\");\n    assert(naRes.data.detail.history.some((h) => h.action === \"marked_not_assessable\"), \"Missing marked_not_assessable audit entry\");\n    console.log(\"6. Not Assessable (insufficient evidence) flow verified: scorePct === null.\");\n\n    // 6. Flow C: Request Another Submission\n    await apiFetch(reviewerCookie, `/reviewer/submissions/${sub3}/claim`, { method: \"POST\" });\n    const rcRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub3}/request-changes`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        note: \"Please angle the camera slightly wider so we can see both the mat setup and step 2.\",\n      }),\n    });\n    assert(rcRes.status === 200 && rcRes.data.detail.submission.reviewStatus === \"resubmit_requested\", \"Request changes failed\");\n    assert(rcRes.data.detail.history.some((h) => h.action === \"changes_requested\"), \"Missing changes_requested audit entry\");\n    console.log(\"7. Request Another Submission flow & audit history verified.\");\n  } finally {\n    // Clean up test media files and temp child\n    for (const sid of [sub1, sub2, sub3]) {\n      await apiFetch(parentCookie, `/submissions/${sid}/video`, { method: \"DELETE\" });\n    }\n    await apiFetch(parentCookie, `/children/${childId}`, { method: \"DELETE\" });\n    console.log(\"8. Cleaned up temporary test data cleanly.\");\n  }\n\n  console.log(\"ALL STEP 8 E2E CHECKS PASSED!\");\n})().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n\'"
    proposed_command_line: "node -e \'\n(async () => {\n  const BASE = \"http://localhost:3000/api/v1\";\n\n  async function login(email, password) {\n    const r = await fetch(`${BASE}/auth/login`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ email, password }),\n    });\n    if (!r.ok) throw new Error(`Login failed for ${email}: ${r.status}`);\n    const cookie = r.headers.get(\"set-cookie\")?.split(\";\")[0];\n    if (!cookie) throw new Error(\"No session cookie\");\n    return cookie;\n  }\n\n  async function apiFetch(cookie, path, opts = {}) {\n    const headers = { ...(opts.headers || {}), Cookie: cookie };\n    if (opts.body && !(opts.body instanceof FormData)) {\n      headers[\"Content-Type\"] = \"application/json\";\n    }\n    const r = await fetch(`${BASE}${path}`, { ...opts, headers });\n    const data = await r.json().catch(() => ({}));\n    return { status: r.status, data };\n  }\n\n  const assert = (cond, msg) => {\n    if (!cond) throw new Error(`ASSERTION FAILED: ${msg}`);\n  };\n\n  const parentCookie = await login(\"meera@littlesteps.in\", \"LittleSteps123!\");\n  const reviewerCookie = await login(\"ananya.reviewer@littlesteps.in\", \"LittleSteps123!\");\n\n  // 1. RBAC: Parent blocked from reviewer endpoints\n  const parentQueue = await apiFetch(parentCookie, \"/reviewer/queue\");\n  assert(parentQueue.status === 403, `Expected 403 for parent on /reviewer/queue, got ${parentQueue.status}`);\n\n  // 2. Reviewer dashboard summary & PII minimization\n  const qRes = await apiFetch(reviewerCookie, \"/reviewer/queue?status=all&ageGroupSlug=all\");\n  assert(qRes.status === 200, `Queue failed: ${qRes.status}`);\n  assert(typeof qRes.data.summary.totalPending === \"number\", \"Missing summary.totalPending\");\n  assert(typeof qRes.data.summary.underReview === \"number\", \"Missing summary.underReview\");\n  assert(typeof qRes.data.summary.completedReviews === \"number\", \"Missing summary.completedReviews\");\n  assert(Array.isArray(qRes.data.summary.recentSubmissions), \"Missing summary.recentSubmissions\");\n  if (qRes.data.queue.length > 0) {\n    const first = qRes.data.queue[0];\n    assert(/^PAR-[A-Z0-9]{6}$/.test(first.parentReference), `Bad parentReference: ${first.parentReference}`);\n    assert(!(\"email\" in first) && !(\"parentEmail\" in first) && !(\"parentName\" in first), \"PII leaked in queue\");\n    assert([\"high\", \"normal\", \"low\"].includes(first.priority), `Bad priority: ${first.priority}`);\n    assert(typeof first.activityVersion === \"number\", \"Missing activityVersion\");\n  }\n  console.log(\"1-2. RBAC & Reviewer Dashboard Summary OK:\", {\n    totalPending: qRes.data.summary.totalPending,\n    underReview: qRes.data.summary.underReview,\n    completedReviews: qRes.data.summary.completedReviews,\n  });\n\n  // 3. Create temp child and upload 3 tiny WebM clips (EBML magic bytes 1A 45 DF A3)\n  const dob = new Date();\n  dob.setMonth(dob.getMonth() - 7);\n  const childRes = await apiFetch(parentCookie, \"/children\", {\n    method: \"POST\",\n    body: JSON.stringify({\n      displayName: \"Step8TempBaby\",\n      dateOfBirth: dob.toISOString().slice(0, 10),\n    }),\n  });\n  assert(childRes.status === 201, `Child create failed: ${childRes.status}`);\n  const childId = childRes.data.child.id;\n\n  const journeyRes = await apiFetch(parentCookie, `/journey/${childId}/today`);\n  assert(journeyRes.status === 200 && journeyRes.data.items.length >= 2, \"Need at least 2 activities\");\n  const act1 = journeyRes.data.items[0].activity;\n  const act2 = journeyRes.data.items[1].activity;\n\n  async function uploadClip(activityId, note) {\n    const fd = new FormData();\n    const bytes = new Uint8Array([0x1a, 0x45, 0xdf, 0xa3, 0x9f, 0x42, 0x86, 0x81, 0x01, 0x00, 0x00, 0x00]);\n    fd.append(\"video\", new Blob([bytes], { type: \"video/webm\" }), \"step8-test.webm\");\n    fd.append(\"childId\", childId);\n    fd.append(\"activityId\", activityId);\n    fd.append(\"durationSeconds\", \"18\");\n    fd.append(\"caregiverNotes\", note);\n    fd.append(\"consentConfirmed\", \"true\");\n    const up = await apiFetch(parentCookie, \"/submissions\", { method: \"POST\", body: fd });\n    assert(up.status === 201, `Upload failed: ${up.status} ${JSON.stringify(up.data)}`);\n    return up.data.submission.id;\n  }\n\n  const sub1 = await uploadClip(act1.id, \"Parent note for Step 8 draft/publish/edit test.\");\n  const sub2 = await uploadClip(act2.id, \"Parent note for Not Assessable test.\");\n  const sub3 = await uploadClip(act1.id, \"Parent note for Request Changes test.\");\n\n  try {\n    // 4. Flow A: Claim -> Save Draft -> Verify Parent Hidden -> Missing Explanation Rejected -> Publish 4-Level -> Verify Math & Parent View -> Edit v2 & Audit History\n    const claim1 = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/claim`, { method: \"POST\" });\n    assert(claim1.status === 200, `Claim sub1 failed: ${claim1.status}`);\n    const criteria = claim1.data.activity.rubricCriteria;\n    assert(criteria.length >= 3, `Expected >= 3 rubric criteria, got ${criteria.length}`);\n\n    // Save Draft\n    const draftRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"draft\",\n        strengthsNote: \"Draft warm note in progress\",\n        coachingTip: \"\",\n        reviewerComments: \"Draft internal comment\",\n        evaluationScopeAcknowledged: false,\n        criterionRatings: criteria.map((c) => ({ criterionId: c.id, achievedLevel: \"met\" })),\n      }),\n    });\n    assert(draftRes.status === 201, `Draft save failed: ${draftRes.status} ${JSON.stringify(draftRes.data)}`);\n    assert(draftRes.data.review.reviewStatus === \"draft\", \"Expected draft status\");\n\n    // Verify Parent does NOT see draft\n    const parentCheckDraft = await apiFetch(parentCookie, `/journey/${childId}/today`);\n    const pSub1Draft = parentCheckDraft.data.recentSubmissions.find((s) => s.id === sub1);\n    assert(pSub1Draft && pSub1Draft.review === null, \"Parent must NOT see unpublished draft review!\");\n    console.log(\"3. Draft privacy boundary verified (parent review === null while reviewer sees draft).\");\n\n    // Attempt publish with not_assessable missing explanation -> must reject 400\n    const badRatings = criteria.map((c, idx) => ({\n      criterionId: c.id,\n      achievedLevel: idx === criteria.length - 1 ? \"not_assessable\" : \"met\",\n    }));\n    const badPub = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Calm eye-level setup and gentle voice throughout.\",\n        coachingTip: \"Try pausing two seconds longer after each step.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: badRatings,\n      }),\n    });\n    assert(badPub.status === 400, `Expected 400 for missing not_assessable explanation, got ${badPub.status}`);\n\n    // Publish with mixed 4-level ratings: Met (1), Partial (0.5), Not met (0), Not assessable (excluded)\n    const levels = [\"met\", \"partially_met\", \"not_met\", \"not_assessable\"];\n    const mixedRatings = criteria.map((c, idx) => {\n      const level = levels[Math.min(idx, levels.length - 1)];\n      return {\n        criterionId: c.id,\n        achievedLevel: level,\n        explanation:\n          level === \"not_assessable\"\n            ? \"Camera angle was cropped so this step was out of frame.\"\n            : level === \"partially_met\"\n              ? \"Gentle pace overall; slight rush on transition.\"\n              : null,\n      };\n    });\n\n    // Compute expected formula independently\n    let expectedEarned = 0;\n    let expectedApplicable = 0;\n    criteria.forEach((c, idx) => {\n      const level = levels[Math.min(idx, levels.length - 1)];\n      if (level === \"met\") { expectedEarned += c.weightPoints; expectedApplicable += c.weightPoints; }\n      else if (level === \"partially_met\") { expectedEarned += c.weightPoints * 0.5; expectedApplicable += c.weightPoints; }\n      else if (level === \"not_met\") { expectedApplicable += c.weightPoints; }\n    });\n    const expectedPct = Math.round((expectedEarned / expectedApplicable) * 100);\n\n    const pubRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Calm eye-level setup and gentle reassuring tone throughout.\",\n        coachingTip: \"Try pausing two extra seconds before introducing the second object.\",\n        reviewerComments: \"Lovely calm connection; thank you for sharing this session.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: mixedRatings,\n      }),\n    });\n    assert(pubRes.status === 201, `Publish failed: ${pubRes.status} ${JSON.stringify(pubRes.data)}`);\n    assert(pubRes.data.review.isAssessable === true, \"Expected assessable review\");\n    assert(\n      pubRes.data.review.instructionMatchScorePct === expectedPct,\n      `Formula mismatch: got ${pubRes.data.review.instructionMatchScorePct}, expected ${expectedPct}`\n    );\n    assert(pubRes.data.review.version === 1, `Expected v1, got ${pubRes.data.review.version}`);\n    console.log(\"4. 4-level weighted formula verified:\", {\n      scorePct: pubRes.data.review.instructionMatchScorePct,\n      earned: pubRes.data.review.earnedWeightPoints,\n      applicable: pubRes.data.review.applicableWeightPoints,\n    });\n\n    // Verify Parent sees ALL 6 result fields\n    const parentAfterPub = await apiFetch(parentCookie, `/journey/${childId}/today`);\n    const pSub1 = parentAfterPub.data.recentSubmissions.find((s) => s.id === sub1);\n    assert(pSub1?.review?.instructionMatchScorePct === expectedPct, \"Parent score mismatch\");\n    assert(pSub1?.review?.reviewerComments?.includes(\"Lovely calm connection\"), \"Missing reviewerComments for parent\");\n    assert(pSub1?.review?.rubricScores.some((s) => s.achievedLevel === \"not_assessable\" && s.explanation), \"Missing criterion explanation for parent\");\n\n    // Verify Parent CANNOT edit published review\n    const parentEdit = await apiFetch(parentCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({ mode: \"publish\", strengthsNote: \"hack\", coachingTip: \"hack\", evaluationScopeAcknowledged: true, criterionRatings: [] }),\n    });\n    assert(parentEdit.status === 403, `Expected 403 for parent review edit, got ${parentEdit.status}`);\n\n    // Reviewer edits published review -> version increments to 2 & history preserves prior versions\n    const editRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub1}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"publish\",\n        strengthsNote: \"Updated: calm eye-level setup and wonderfully responsive pacing.\",\n        coachingTip: \"Updated tip: keep the mat clear of extra distractions.\",\n        reviewerComments: \"Revised comment after double-checking step 3.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: criteria.map((c) => ({ criterionId: c.id, achievedLevel: \"met\" })),\n      }),\n    });\n    assert(editRes.status === 201 && editRes.data.review.version === 2, \"Expected version 2 on edit\");\n    assert(editRes.data.review.instructionMatchScorePct === 100, \"Expected 100% on all Met edit\");\n    const histActions = editRes.data.detail.history.map((h) => h.action);\n    assert(\n      histActions.includes(\"draft_saved\") && histActions.includes(\"published\") && histActions.includes(\"updated\"),\n      `Missing audit history entries: ${JSON.stringify(histActions)}`\n    );\n    console.log(\"5. Versioned edit & immutable audit history verified:\", histActions);\n\n    // 5. Flow B: Mark Evidence Insufficient (Not Assessable)\n    await apiFetch(reviewerCookie, `/reviewer/submissions/${sub2}/claim`, { method: \"POST\" });\n    const naRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub2}/review`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        mode: \"not_assessable\",\n        notAssessableReason: \"The lighting was too dark to observe the materials or steps clearly.\",\n        evaluationScopeAcknowledged: true,\n        criterionRatings: [],\n      }),\n    });\n    assert(naRes.status === 201, `Not assessable failed: ${naRes.status} ${JSON.stringify(naRes.data)}`);\n    assert(naRes.data.review.isAssessable === false, \"Expected isAssessable === false\");\n    assert(naRes.data.review.instructionMatchScorePct === null, \"Expected null scorePct for Not Assessable\");\n    assert(naRes.data.detail.history.some((h) => h.action === \"marked_not_assessable\"), \"Missing marked_not_assessable audit entry\");\n    console.log(\"6. Not Assessable (insufficient evidence) flow verified: scorePct === null.\");\n\n    // 6. Flow C: Request Another Submission\n    await apiFetch(reviewerCookie, `/reviewer/submissions/${sub3}/claim`, { method: \"POST\" });\n    const rcRes = await apiFetch(reviewerCookie, `/reviewer/submissions/${sub3}/request-changes`, {\n      method: \"POST\",\n      body: JSON.stringify({\n        note: \"Please angle the camera slightly wider so we can see both the mat setup and step 2.\",\n      }),\n    });\n    assert(rcRes.status === 200 && rcRes.data.detail.submission.reviewStatus === \"resubmit_requested\", \"Request changes failed\");\n    assert(rcRes.data.detail.history.some((h) => h.action === \"changes_requested\"), \"Missing changes_requested audit entry\");\n    console.log(\"7. Request Another Submission flow & audit history verified.\");\n  } finally {\n    // Clean up test media files and temp child\n    for (const sid of [sub1, sub2, sub3]) {\n      await apiFetch(parentCookie, `/submissions/${sid}/video`, { method: \"DELETE\" });\n    }\n    await apiFetch(parentCookie, `/children/${childId}`, { method: \"DELETE\" });\n    console.log(\"8. Cleaned up temporary test data cleanly.\");\n  }\n\n  console.log(\"ALL STEP 8 E2E CHECKS PASSED!\");\n})().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n\'"
    shell_name: "bash"
  }
