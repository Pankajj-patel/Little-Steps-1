      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Extend shared types for Step 8 4-level rubric ratings, Not Assessable results, reviewer comments, draft/published review states, queue dashboard metrics, parent reference, priority, and immutable review audit history.\", \"Instruction\":\"Update RubricAchievementLevel, ReviewRubricScoreDetail, SubmissionReviewDetail, ReviewerQueueItem, ReviewerSubmissionDetail, and add ReviewerDashboardSummary and ReviewHistoryEntry types.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":21, \"ReplacementContent\":\"export type RubricAchievementLevel =\\n  | \'met\'\\n  | \'partially_met\'\\n  | \'not_met\'\\n  | \'not_observed\'\\n  | \'not_assessable\';\\n\\nexport type ReviewPublicationStatus = \'draft\' | \'published\';\\n\\nexport type QueuePriority = \'high\' | \'normal\' | \'low\';\", \"StartLine\":20, \"TargetContent\":\"export type RubricAchievementLevel = \'met\' | \'partially_met\' | \'not_observed\';\"}, {\"AllowMultiple\":false, \"EndLine\":155, \"ReplacementContent\":\"export interface ReviewRubricScoreDetail {\\n  id: string;\\n  criterionId: string;\\n  criterionLabel: string;\\n  criterionDescription: string;\\n  achievedLevel: RubricAchievementLevel;\\n  earnedPoints: number;\\n  maxPoints: number;\\n  explanation: string | null;\\n}\\n\\nexport interface ReviewHistoryEntry {\\n  id: string;\\n  submissionId: string;\\n  reviewId: string | null;\\n  actorUserId: string;\\n  actorName: string;\\n  actorRole: string;\\n  action: \'draft_saved\' | \'published\' | \'updated\' | \'marked_not_assessable\' | \'changes_requested\';\\n  version: number;\\n  scorePct: number | null;\\n  isAssessable: boolean;\\n  summaryNote: string;\\n  createdAt: string;\\n}\\n\\nexport interface SubmissionReviewDetail {\\n  id: string;\\n  submissionId: string;\\n  reviewerUserId: string;\\n  reviewerName: string;\\n  reviewStatus: ReviewPublicationStatus;\\n  version: number;\\n  isAssessable: boolean;\\n  notAssessableReason: string | null;\\n  instructionMatchScorePct: number | null;\\n  applicableWeightPoints: number;\\n  earnedWeightPoints: number;\\n  strengthsNote: string;\\n  coachingTip: string;\\n  reviewerComments: string | null;\\n  evaluationScopeAcknowledgedAt: string;\\n  submittedAt: string;\\n  rubricScores: ReviewRubricScoreDetail[];\\n}\", \"StartLine\":132, \"TargetContent\":\"export interface ReviewRubricScoreDetail {\\n  id: string;\\n  criterionId: string;\\n  criterionLabel: string;\\n  criterionDescription: string;\\n  achievedLevel: RubricAchievementLevel;\\n  earnedPoints: number;\\n  maxPoints: number;\\n}\\n\\nexport interface SubmissionReviewDetail {\\n  id: string;\\n  submissionId: string;\\n  reviewerUserId: string;\\n  reviewerName: string;\\n  instructionMatchScorePct: number;\\n  strengthsNote: string;\\n  coachingTip: string;\\n  evaluationScopeAcknowledgedAt: string;\\n  submittedAt: string;\\n  rubricScores: ReviewRubricScoreDetail[];\\n}\"}, {\"AllowMultiple\":false, \"EndLine\":335, \"ReplacementContent\":\"export interface ReviewerQueueItem {\\n  submissionId: string;\\n  parentReference: string;\\n  activityId: string;\\n  activityVersion: number;\\n  activityTitle: string;\\n  domainName: string;\\n  ageGroupSlug: string;\\n  ageGroupLabel: string;\\n  reviewStatus: SubmissionReviewStatus;\\n  priority: QueuePriority;\\n  assignedReviewerId: string | null;\\n  assignedReviewerName: string | null;\\n  hasActiveVideo: boolean;\\n  hasDraftReview: boolean;\\n  isAssessable: boolean;\\n  durationSeconds: number;\\n  expiresAt: string;\\n  createdAt: string;\\n  instructionMatchScorePct: number | null;\\n}\\n\\nexport interface ReviewerDashboardSummary {\\n  totalPending: number;\\n  underReview: number;\\n  completedReviews: number;\\n  changesRequested: number;\\n  recentSubmissions: ReviewerQueueItem[];\\n}\\n\\nexport interface ReviewerSubmissionDetail {\\n  submission: ReviewerQueueItem & {\\n    caregiverNotes: string | null;\\n    changeRequestNote