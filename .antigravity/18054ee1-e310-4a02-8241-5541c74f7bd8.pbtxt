    tool_calls {
      id: "call_1769390757084740220"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Align appendReviewAuditHistory and listReviewHistory with the exact review_audit_history SQLite schema columns (actor_role, score_pct, summary_note).\", \"Instruction\":\"Update appendReviewAuditHistory, listReviewHistory, requestSubmissionChanges, and submitRubricReview history calls in server/repositories/index.ts.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":1645, \"ReplacementContent\":\"  private appendReviewAuditHistory(params: {\\n    submissionId: string;\\n    reviewId: string | null;\\n    actorUserId: string;\\n    actorRole?: string;\\n    action: ReviewAuditAction;\\n    version: number;\\n    isAssessable: boolean;\\n    scorePct: number | null;\\n    summaryNote: string | null;\\n    snapshot: Record<string, unknown>;\\n  }): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO review_audit_history (\\n           id, submission_id, review_id, actor_user_id, actor_role, action, version,\\n           score_pct, is_assessable, summary_note, snapshot_json\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`\\n      )\\n      .run(\\n        `rh_${crypto.randomUUID().slice(0, 12)}`,\\n        params.submissionId,\\n        params.reviewId,\\n        params.actorUserId,\\n        params.actorRole ?? \'reviewer\',\\n        params.action,\\n        params.version,\\n        params.scorePct,\\n        params.isAssessable ? 1 : 0,\\n        params.summaryNote ?? \'\',\\n        JSON.stringify(params.snapshot)\\n      );\\n  }\\n\\n  listReviewHistory(submissionId: string): ReviewHistoryEntry[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT rah.*, u.full_name as actor_name\\n         FROM review_audit_history rah\\n         JOIN users u ON u.id = rah.actor_user_id\\n         WHERE rah.submission_id = ?\\n         ORDER BY rah.created_at DESC`\\n      )\\n      .all(submissionId) as Array<{\\n      id: string;\\n      submission_id: string;\\n      review_id: string | null;\\n      actor_user_id: string;\\n      actor_name: string;\\n      actor_role: string;\\n      action: ReviewAuditAction;\\n      version: number;\\n      score_pct: number | null;\\n      is_assessable: number;\\n      summary_note: string;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      submissionId: r.submission_id,\\n      reviewId: r.review_id,\\n      actorUserId: r.actor_user_id,\\n      actorName: r.actor_name,\\n      actorRole: r.actor_role,\\n      action: r.action,\\n      version: r.version,\\n      scorePct: r.score_pct,\\n      isAssessable: r.is_assessable === 1,\\n      summaryNote: r.summary_note ?? \'\',\\n      createdAt: r.created_at,\\n    }));\\n  }\", \"StartLine\":1560, \"TargetContent\":\"  private appendReviewAuditHistory(params: {\\n    submissionId: string;\\n    reviewId: string | null;\\n    actorUserId: string;\\n    action: ReviewAuditAction;\\n    version: number;\\n    isAssessable: boolean;\\n    instructionMatchScorePct: number | null;\\n    summaryNote: string | null;\\n    snapshot: Record<string, unknown>;\\n  }): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO review_audit_history (\\n           id, submission_id, review_id, actor_user_id, action, version,\\n           is_assessable, instruction_match_score_pct, summary_note, snapshot_json\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`\\n      )\\n      .run(\\n        `rh_${crypto.randomUUID().slice(0, 12)}`,\\n        params.submissionId,\\n        params.reviewId,\\n        params.actorUserId,\\n        params.action,\\n        params.version,\\n        params.isAssessable ? 1 : 0,\\n        params.instructionMatchScorePct,\\n        params.summaryNote,\\n        JSON.stringify(params.snapshot)\\n      );\\n  }\\n\\n  listReviewHistory(submissionId: string): ReviewHistoryEntry[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT rah.*, u.full_name as actor_name\\n         FROM review_audit_history rah\\n         JOIN users u ON u.id = rah.actor_user_id\\n         WHERE rah.submission_id = ?\\n         ORDER BY rah.created_at DESC`\\n      )\\n      .all(submissionId) as Array<{\\n      id: string;\\n      submission_id: string;\\n      review_id: string | null;\\n      actor_user_id: string;\\n      actor_name: string;\\n      action: ReviewAuditAction;\\n      version: number;\\n      is_assessable: number;\\n      instruction_match_score_pct: number | null;\\n      summary_note: string | null;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => ({\\n      id: r.id,\\n      submissionId: r.submission_id,\\n      reviewId: r.review_id,\\n      actorUserId: r.actor_user_id,\\n      actorName: r.actor_name,\\n      action: r.action,\\n      version: r.version,\\n      isAssessable: r.is_assessable === 1,\\n      instructionMatchScorePct: r.instruction_match_score_pct,\\n      summaryNote: r.summary_note,\\n      createdAt: r.created_at,\\n    }));\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":1930, \"ReplacementContent\":\"      this.appendReviewAuditHistory({\\n        submissionId,\\n        reviewId: null,\\n        actorUserId: reviewerUserId,\\n        actorRole: \'reviewer\',\\n        action: \'changes_requested\',\\n        version: 1,\\n        isAssessable: false,\\n        scorePct: null,\\n        summaryNote: trimmedNote,\\n        snapshot: { changeRequestNote: trimmedNote },\\n      });\", \"StartLine\":1895, \"TargetContent\":\"      this.appendReviewAuditHistory({\\n        submissionId,\\n        reviewId: null,\\n        actorUserId: reviewerUserId,\\n        action: \'changes_requested\',\\n        version: 1,\\n        isAssessable: false,\\n        instructionMatchScorePct: null,\\n        summaryNote: trimmedNote,\\n        snapshot: { changeRequestNote: trimmedNote },\\n      });\"}, {\"AllowMultiple\":false, \"EndLine\":2370, \"ReplacementContent\":\"      this.appendReviewAuditHistory({\\n        submissionId: params.submissionId,\\n        reviewId,\\n        actorUserId: params.reviewerUserId,\\n        actorRole: \'reviewer\',\\n        action: auditAction,\\n        version: nextVersion,\\n        isAssessable,\\n        scorePct,\\n        summaryNote: !isAssessable\\n          ? finalNotAssessableReason\\n          : comments || strengths || \'Draft saved\',\\n        snapshot: {\\n          mode: params.mode,\\n          reviewStatus,\\n          version: nextVersion,\\n          isAssessable,\\n          instructionMatchScorePct: scorePct,\\n          notAssessableReason: finalNotAssessableReason,\\n          strengthsNote: strengths,\\n          coachingTip: coaching,\\n          reviewerComments: comments,\\n          criterionRatings: computedScores,\\n        },\\n      });\", \"StartLine\":2320, \"TargetContent\":\"      this.appendReviewAuditHistory({\\n        submissionId: params.submissionId,\\n        reviewId,\\n        actorUserId: params.reviewerUserId,\\n        action: auditAction,\\n        version: nextVersion,\\n        isAssessable,\\n        instructionMatchScorePct: scorePct,\\n        summaryNote: !isAssessable\\n          ? finalNotAssessableReason\\n          : comments || strengths || \'Draft saved\',\\n        snapshot: {\\n          mode: params.mode,\\n          reviewStatus,\\n          version: nextVersion,\\n          isAssessable,\\n          instructionMatchScorePct: scorePct,\\n          notAssessableReason: finalNotAssessableReason,\\n          strengthsNote: strengths,\\n          coachingTip: coaching,\\n          reviewerComments: comments,\\n          criterionRatings: computedScores,\\n        },\\n      });\"}], \"TargetFile\":\"/server/repositories/index.ts\", \"toolAction\":\"Aligning review audit history columns in repository\", \"toolSummary\":\"Align review audit history SQL\"}"
