      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import crypto from \'crypto\';\\nimport type { UserRole } from \'../../src/shared/types\';\\n\\nconst SESSION_SECRET =\\n  process.env.SESSION_SECRET || \'littlesteps-dev-session-secret-change-in-prod\';\\nconst VIDEO_TOKEN_SECRET =\\n  process.env.VIDEO_TOKEN_SECRET || \'littlesteps-dev-video-secret-change-in-prod\';\\n\\nconst SESSION_TTL_SECONDS = 60 * 60 * 24 * 7; // 7 days\\nconst VIDEO_TOKEN_TTL_SECONDS = 60 * 5; // 5 minutes short-lived token\\n\\nexport function hashPassword(password: string): string {\\n  const salt = crypto.randomBytes(16).toString(\'hex\');\\n  const derived = crypto.scryptSync(password, salt, 64).toString(\'hex\');\\n  return `${salt}:${derived}`;\\n}\\n\\nexport function verifyPassword(password: string, storedHash: string): boolean {\\n  const [salt, keyHex] = storedHash.split(\':\');\\n  if (!salt || !keyHex) return false;\\n  const derived = crypto.scryptSync(password, salt, 64);\\n  const keyBuf = Buffer.from(keyHex, \'hex\');\\n  if (derived.length !== keyBuf.length) return false;\\n  return crypto.timingSafeEqual(derived, keyBuf);\\n}\\n\\nexport function hashIp(ip: string): string {\\n  return crypto.createHash(\'sha256\').update(`${ip}:${SESSION_SECRET}`).digest(\'hex\').slice(0, 24);\\n}\\n\\n/**\\n * Generates a cryptographically random URL-safe token and its SHA-256 hash.\\n * Only the hash is stored in SQLite; the raw token is never persisted or logged.\\n */\\nexport function generateOneTimeToken(): { rawToken: string; tokenHash: string } {\\n  const rawToken = crypto.randomBytes(32).toString(\'base64url\');\\n  const tokenHash = hashOneTimeToken(rawToken);\\n  return { rawToken, tokenHash };\\n}\\n\\nexport function hashOneTimeToken(rawToken: string): string {\\n  return crypto.createHash(\'sha256\').update(`${rawToken}:${SESSION_SECRET}`).digest(\'hex\');\\n}\\n\\ninterface SessionPayload {\\n  userId: string;\\n  role: UserRole;\\n  sessionVersion: number;\\n  exp: number;\\n}\\n\\nexport function signSessionToken(\\n  userId: string,\\n  role: UserRole,\\n  sessionVersion = 1\\n): string {\\n  const payload: SessionPayload = {\\n    userId,\\n    role,\\n    sessionVersion,\\n    exp: Math.floor(Date.now() / 1000) + SESSION_TTL_SECONDS,\\n  };\\n  const encoded = Buffer.from(JSON.stringify(payload), \'utf8\').toString(\'base64url\');\\n  const sig = crypto\\n    .createHmac(\'sha256\', SESSION_SECRET)\\n    .update(encoded)\\n    .digest(\'base64url\');\\n  return `${encoded}.${sig}`;\\n}\\n\\nexport function verifySessionToken(token: string | undefined): SessionPayload | null {\\n  if (!token) return null;\\n  const parts = token.split(\'.\');\\n  if (parts.length !== 2) return null;\\n  const [encoded, sig] = parts;\\n  const expectedSig = crypto\\n    .createHmac(\'sha256\', SESSION_SECRET)\\n    .update(encoded)\\n    .digest(\'base64url\');\\n  const sigBuf = Buffer.from(sig);\\n  const expectedBuf = Buffer.from(expectedSig);\\n  if (sigBuf.length !== expectedBuf.length || !crypto.timingSafeEqual(sigBuf, expectedBuf)) {\\n    return null;\\n  }\\n  try {\\n    const parsed = JSON.parse(Buffer.from(encoded, \'base64url\').toString(\'utf8\')) as SessionPayload;\\n    if (\\n      !parsed.userId ||\\n      !parsed.role ||\\n      typeof parsed.sessionVersion !== \'number\' ||\\n      parsed.exp < Math.floor(Date.now() / 1000)\\n    ) {\\n      return null;\\n    }\\n    return parsed;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\ninterface VideoStreamTokenPayload {\\n  userId: string;\\n  role: UserRole;\\n  submissionId: string;\\n  exp: number;\\n}\\n\\nexport function signVideoStreamToken(\\n  userId: string,\\n  role: UserRole,\\n  submissionId: string\\n): { token: string; expiresAt: string } {\\n  const exp = Math.floor(Date.now() / 1000) + VIDEO_TOKEN_TTL_SECONDS;\\n  const payload: VideoStreamTokenPayload = { userId, role, submissionId, exp };\\n  const encoded = Buffer.from(JSON.stringify(payload), \'utf8\').toString(\'base64url\');\\n  const sig = crypto\\n    .createHmac(\'sha256\', VIDEO_TOKEN_SECRET)\\n    .update(encoded)\\n    .digest(\'base64url\');\\n  return {\\n    token: `${encoded}.${sig}`,\\n    expiresAt: new Date(exp * 1000).toISOString(),\\n  };\\n}\\n\\nexport function verifyVideoStreamToken(token: string | undefined): VideoStreamTokenPayload | null {\\n  if (!token) return null;\\n  const parts = token.split(\'.\');\\n  if (parts.length !== 2) return null;\\n  const [encoded, sig] = parts;\\n  const expectedSig = crypto\\n    .createHmac(\'sha256\', VIDEO_TOKEN_SECRET)\\n    .update(encoded)\\n    .digest(\'base64url\');\\n  const sigBuf = Buffer.from(sig);\\n  const expectedBuf = Buffer.from(expectedSig);\\n  if (sigBuf.length !== expectedBuf.length || !crypto.timingSafeEqual(sigBuf, expectedBuf)) {\\n    return null;\\n  }\\n  try {\\n    const parsed = JSON.parse(\\n      Buffer.from(encoded, \'base64url\').toString(\'utf8\')\\n    ) as VideoStreamTokenPayload;\\n    if (\\n      !parsed.userId ||\\n      !parsed.submissionId ||\\n      parsed.exp < Math.floor(Date.now() / 1000)\\n    ) {\\n      return null;\\n    }\\n    return parsed;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\n/**\\n * Validates actual binary video file magic bytes to prevent spoofed Content-Type uploads.\\n */\\nexport function validateVideoMagicBytes(buffer: Buffer): boolean {\\n  if (buffer.length < 12) return false;\\n  const isWebm =\\n    buffer[0] === 0x1a &&\\n    buffer[1] === 0x45 &&\\n    buffer[2] === 0xdf &&\\n    buffer[3] === 0xa3;\\n  const boxType = buffer.subarray(4, 8).toString(\'ascii\');\\n  const isMp4OrMov = boxType === \'ftyp\' || boxType === \'moov\' || boxType === \'mdat\' || boxType === \'wide\';\\n  return isWebm || isMp4OrMov;\\n}\\n\\n/**\\n * Validates actual binary image magic bytes (JPEG, PNG, WebP) for optional profile photos.\\n */\\nexport function validateImageMagicBytes(buffer: Buffer): boolean {\\n  if (buffer.length < 12) return false;\\n  const isJpeg = buffer[0] === 0xff && buffer[1] === 0xd8 && buffer[2] === 0xff;\\n  const isPng =\\n    buffer[0] === 0x89 &&\\n    buffer[1] === 0x50 &&\\n    buffer[2] === 0x4e &&\\n    buffer[3] === 0x47;\\n  const isWebp =\\n    buffer.subarray(0, 4).toString(\'ascii\') === \'RIFF\' &&\\n    buffer.subarray(8, 12).toString(\'ascii\') === \'WEBP\';\\n  return isJpeg || isPng || isWebp;\\n}\\n\", \"Description\":\"Add session versioning, SHA-256 hashed one-time auth token generation, and image magic-byte validation to server security module.\", \"Overwrite\":true, \"TargetFile\":\"/server/security/crypto.ts\", \"toolAction\":\"Enhancing server crypto and token utilities\", \"toolSummary\":\"Update server/security/crypto.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16655288673639888163"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add auth_tokens table and idempotent SQLite column migrations for email verification, session_version, profile photos, onboarding completion, and preferences.\", \"EndLine\":184, \"Instruction\":\"Add auth_tokens table and safe ALTER TABLE upgrades at the end of runMigrations in server/db/schema.ts.\", \"ReplacementContent\":\"    CREATE TABLE IF NOT EXISTS contact_inquiries (\\n      id TEXT PRIMARY KEY,\\n      full_name TEXT NOT NULL,\\n      email TEXT NOT NULL,\\n      topic TEXT NOT NULL,\\n      message TEXT NOT NULL,\\n      created_at TEXT NOT NULL DEFAULT (strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n    );\\n\\n    CREATE TABLE IF NOT EXISTS auth_tokens (\\n      id TEXT PRIMARY KEY,\\n      user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\\n      token_type TEXT NOT NULL CHECK (token_type IN (\'email_verification\', \'password_reset\')),\\n      token_hash TEXT NOT NULL UNIQUE,\\n      expires_at TEXT NOT NULL,\\n      used_at TEXT,\\n      created_at TEXT NOT NULL DEFAULT (strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n    );\\n\\n    CREATE INDEX IF NOT EXISTS idx_children_parent ON children(parent_user_id);\\n    CREATE INDEX IF NOT EXISTS idx_activities_age_domain ON activities(age_group_id, domain_id, status);\\n    CREATE INDEX IF NOT EXISTS idx_submissions_queue ON video_submissions(review_status, created_at);\\n    CREATE INDEX IF NOT EXISTS idx_submissions_expiry ON video_submissions(expires_at, deleted_at);\\n    CREATE INDEX IF NOT EXISTS idx_audit_created ON media_access_audit_logs(created_at DESC);\\n    CREATE INDEX IF NOT EXISTS idx_auth_tokens_hash ON auth_tokens(token_hash, token_type);\\n  `);\\n\\n  // Safe idempotent column migrations for existing databases\\n  const ensureColumn = (table: string, column: string, definition: string) => {\\n    const cols = db.prepare(`PRAGMA table_info(${table})`).all() as Array<{ name: string }>;\\n    if (!cols.some((c) => c.name === column)) {\\n      db.exec(`ALTER TABLE ${table} ADD COLUMN ${column} ${definition}`);\\n    }\\n  };\\n\\n  ensureColumn(\'users\', \'email_verified_at\', \'TEXT\');\\n  ensureColumn(\'users\', \'profile_photo_url\', \'TEXT\');\\n  ensureColumn(\'users\', \'preferred_activity_time\', \\\"TEXT NOT NULL DEFAULT \'morning\'\\\");\\n  ensureColumn(\'users\', \'notification_preference\', \\\"TEXT NOT NULL DEFAULT \'daily_gentle\'\\\");\\n  ensureColumn(\'users\', \'onboarding_completed_at\', \'TEXT\');\\n  ensureColumn(\'users\', \'session_version\', \'INTEGER NOT NULL DEFAULT 1\');\\n\\n  ensureColumn(\'children\', \'profile_photo_url\', \'TEXT\');\\n  ensureColumn(\'children\', \'activity_preferences\', \'TEXT\');\\n\\n  // Ensure seeded demo accounts are marked verified & onboarded\\n  db.exec(`\\n    UPDATE users\\n    SET email_verified_at = COALESCE(email_verified_at, created_at),\\n        onboarding_completed_at = COALESCE(onboarding_completed_at, created_at)\\n    WHERE id IN (\'usr_parent_meera\', \'usr_reviewer_ananya\', \'usr_admin_kavita\');\\n  `);\\n}\", \"StartLine\":169, \"TargetContent\":\"    CREATE TABLE IF NOT EXISTS contact_inquiries (\\n      id TEXT PRIMARY KEY,\\n      full_name TEXT NOT NULL,\\n      email TEXT NOT NULL,\\n      topic TEXT NOT NULL,\\n      message TEXT NOT NULL,\\n      created_at TEXT NOT NULL DEFAULT (strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n    );\\n\\n    CREATE INDEX IF NOT EXISTS idx_children_parent ON children(parent_user_id);\\n    CREATE INDEX IF NOT EXISTS idx_activities_age_domain ON activities(age_group_id, domain_id, status);\\n    CREATE INDEX IF NOT EXISTS idx_submissions_queue ON video_submissions(review_status, created_at);\\n    CREATE INDEX IF NOT EXISTS idx_submissions_expiry ON video_submissions(expires_at, deleted_at);\\n    CREATE INDEX IF NOT EXISTS idx_audit_created ON media_access_audit_logs(created_at DESC);\\n  `);\\n}\", \"TargetFile\":\"/server/db/schema.ts\", \"toolAction\":\"Updating SQLite schema for Step 3 auth and onboarding\", \"toolSummary\":\"Update server/db/schema.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_16655288673639890338"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Validate sessionVersion in requireAuth middleware so password reset invalidates older sessions.\", \"EndLine\":31, \"Instruction\":\"Check sessionVersion match against DB in server/middleware/auth.ts.\", \"ReplacementContent\":\"export function createAuthMiddleware(repo: LittleStepsRepository) {\\n  return function requireAuth(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\\n    const token = req.cookies?.[SESSION_COOKIE_NAME] as string | undefined;\\n    const payload = verifySessionToken(token);\\n    if (!payload) {\\n      res.status(401).json({ error: \'Authentication required. Please sign in.\' });\\n      return;\\n    }\\n    const authRecord = repo.findUserAuthById(payload.userId);\\n    if (!authRecord || !authRecord.user.isActive || authRecord.sessionVersion !== payload.sessionVersion) {\\n      res.clearCookie(SESSION_COOKIE_NAME, { path: \'/\' });\\n      res.status(401).json({ error: \'Session expired or no longer valid. Please sign in again.\' });\\n      return;\\n    }\\n    req.authUser = authRecord.user;\\n    next();\\n  };\\n}\", \"StartLine\":12, \"TargetContent\":\"export function createAuthMiddleware(repo: LittleStepsRepository) {\\n  return function requireAuth(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\\n    const token = req.cookies?.[SESSION_COOKIE_NAME] as string | undefined;\\n    const payload = verifySessionToken(token);\\n    if (!payload) {\\n      res.status(401).json({ error: \'Authentication required. Please sign in.\' });\\n      return;\\n    }\\n    const user = repo.findUserById(payload.userId);\\n    if (!user || !user.isActive) {\\n      res.clearCookie(SESSION_COOKIE_NAME);\\n      res.status(401).json({ error: \'Account is inactive or no longer valid.\' });\\n      return;\\n    }\\n    req.authUser = user;\\n    next();\\n  };\\n}\", \"TargetFile\":\"/server/middleware/auth.ts\", \"toolAction\":\"Adding sessionVersion check to auth middleware\", \"toolSummary\":\"Update server/middleware/auth.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_16655288673639888417"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update UserRow mapping and add Step 3 auth token, verification, password reset, onboarding, and photo-ownership methods in LittleStepsRepository.\", \"EndLine\":265, \"Instruction\":\"Update UserRow, mapUser, user/child methods, and add auth token and onboarding persistence in server/repositories/index.ts.\", \"ReplacementContent\":\"interface UserRow {\\n  id: string;\\n  email: string;\\n  password_hash: string;\\n  full_name: string;\\n  phone_number: string | null;\\n  role: UserRole;\\n  preferred_locale: LocaleCode;\\n  profile_photo_url: string | null;\\n  preferred_activity_time: \'morning\' | \'afternoon\' | \'evening\' | \'flexible\';\\n  notification_preference: \'daily_gentle\' | \'weekly_summary\' | \'none\';\\n  email_verified_at: string | null;\\n  onboarding_completed_at: string | null;\\n  session_version: number;\\n  is_active: number;\\n  created_at: string;\\n}\\n\\nfunction mapUser(row: UserRow): UserProfile {\\n  return {\\n    id: row.id,\\n    email: row.email,\\n    fullName: row.full_name,\\n    phoneNumber: row.phone_number,\\n    role: row.role,\\n    preferredLocale: row.preferred_locale,\\n    profilePhotoUrl: row.profile_photo_url ?? null,\\n    preferredActivityTime: row.preferred_activity_time ?? \'morning\',\\n    notificationPreference: row.notification_preference ?? \'daily_gentle\',\\n    emailVerifiedAt: row.email_verified_at ?? null,\\n    onboardingCompletedAt: row.onboarding_completed_at ?? null,\\n    isActive: row.is_active === 1,\\n    createdAt: row.created_at,\\n  };\\n}\\n\\nexport class LittleStepsRepository {\\n  constructor(private readonly db: Database.Database) {}\\n\\n  // ======================== USERS, AUTH TOKENS & ONBOARDING ========================\\n\\n  findUserByEmail(\\n    email: string\\n  ): (UserProfile & { passwordHash: string; sessionVersion: number }) | null {\\n    const row = this.db\\n      .prepare(\'SELECT * FROM users WHERE email = ?\')\\n      .get(email.trim().toLowerCase()) as UserRow | undefined;\\n    if (!row) return null;\\n    return {\\n      ...mapUser(row),\\n      passwordHash: row.password_hash,\\n      sessionVersion: row.session_version ?? 1,\\n    };\\n  }\\n\\n  findUserById(id: string): UserProfile | null {\\n    const row = this.db.prepare(\'SELECT * FROM users WHERE id = ?\').get(id) as UserRow | undefined;\\n    return row ? mapUser(row) : null;\\n  }\\n\\n  findUserAuthById(id: string): { user: UserProfile; sessionVersion: number } | null {\\n    const row = this.db.prepare(\'SELECT * FROM users WHERE id = ?\').get(id) as UserRow | undefined;\\n    if (!row) return null;\\n    return { user: mapUser(row), sessionVersion: row.session_version ?? 1 };\\n  }\\n\\n  createUser(params: {\\n    email: string;\\n    passwordHash: string;\\n    fullName: string;\\n    phoneNumber: string | null;\\n    role: UserRole;\\n    preferredLocale: LocaleCode;\\n    ipHash: string;\\n  }): { user: UserProfile; sessionVersion: number } {\\n    const id = `usr_${crypto.randomUUID().slice(0, 12)}`;\\n    const tx = this.db.transaction(() => {\\n      this.db\\n        .prepare(\\n          `INSERT INTO users (id, email, password_hash, full_name, phone_number, role, preferred_locale, session_version)\\n           VALUES (?, ?, ?, ?, ?, ?, ?, 1)`\\n        )\\n        .run(\\n          id,\\n          params.email.trim().toLowerCase(),\\n          params.passwordHash,\\n          params.fullName.trim(),\\n          params.phoneNumber?.trim() || null,\\n          params.role,\\n          params.preferredLocale\\n        );\\n      this.db\\n        .prepare(\\n          `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n           VALUES (?, ?, \'privacy_policy\', \'v1.0\', ?)`\\n        )\\n        .run(crypto.randomUUID(), id, params.ipHash);\\n    });\\n    tx();\\n    return this.findUserAuthById(id)!;\\n  }\\n\\n  createAuthToken(params: {\\n    userId: string;\\n    tokenType: \'email_verification\' | \'password_reset\';\\n    tokenHash: string;\\n    expiresAt: string;\\n  }): void {\\n    const tx = this.db.transaction(() => {\\n      // Invalidate any previous unused tokens of the same type for this user\\n      this.db\\n        .prepare(\\n          `UPDATE auth_tokens\\n           SET used_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n           WHERE user_id = ? AND token_type = ? AND used_at IS NULL`\\n        )\\n        .run(params.userId, params.tokenType);\\n\\n      this.db\\n        .prepare(\\n          `INSERT INTO auth_tokens (id, user_id, token_type, token_hash, expires_at)\\n           VALUES (?, ?, ?, ?, ?)`\\n        )\\n        .run(crypto.randomUUID(), params.userId, params.tokenType, params.tokenHash, params.expiresAt);\\n    });\\n    tx();\\n  }\\n\\n  consumeAuthToken(\\n    tokenHash: string,\\n    tokenType: \'email_verification\' | \'password_reset\'\\n  ): { userId: string } | null {\\n    const row = this.db\\n      .prepare(\\n        `SELECT id, user_id, expires_at, used_at\\n         FROM auth_tokens\\n         WHERE token_hash = ? AND token_type = ?`\\n      )\\n      .get(tokenHash, tokenType) as\\n      | { id: string; user_id: string; expires_at: string; used_at: string | null }\\n      | undefined;\\n\\n    if (!row || row.used_at !== null) return null;\\n    if (new Date(row.expires_at).getTime() <= Date.now()) return null;\\n\\n    this.db\\n      .prepare(\\\"UPDATE auth_tokens SET used_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\') WHERE id = ?\\\")\\n      .run(row.id);\\n\\n    return { userId: row.user_id };\\n  }\\n\\n  markEmailVerified(userId: string): UserProfile | null {\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET email_verified_at = COALESCE(email_verified_at, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')),\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(userId);\\n    return this.findUserById(userId);\\n  }\\n\\n  updateUserPasswordAndBumpSession(userId: string, newPasswordHash: string): void {\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET password_hash = ?,\\n             session_version = session_version + 1,\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(newPasswordHash, userId);\\n  }\\n\\n  updateParentProfileAndPreferences(\\n    userId: string,\\n    updates: {\\n      fullName?: string;\\n      email?: string;\\n      preferredLocale?: LocaleCode;\\n      profilePhotoUrl?: string | null;\\n      preferredActivityTime?: \'morning\' | \'afternoon\' | \'evening\' | \'flexible\';\\n      notificationPreference?: \'daily_gentle\' | \'weekly_summary\' | \'none\';\\n      markOnboardingComplete?: boolean;\\n    }\\n  ): UserProfile | null {\\n    const existing = this.findUserById(userId);\\n    if (!existing) return null;\\n\\n    const nextEmail = updates.email ? updates.email.trim().toLowerCase() : existing.email;\\n    const emailChanged = nextEmail !== existing.email;\\n\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET full_name = ?,\\n             email = ?,\\n             preferred_locale = ?,\\n             profile_photo_url = ?,\\n             preferred_activity_time = ?,\\n             notification_preference = ?,\\n             email_verified_at = CASE WHEN ? = 1 THEN NULL ELSE email_verified_at END,\\n             onboarding_completed_at = CASE WHEN ? = 1\\n               THEN COALESCE(onboarding_completed_at, strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\'))\\n               ELSE onboarding_completed_at END,\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(\\n        updates.fullName !== undefined ? updates.fullName.trim() : existing.fullName,\\n        nextEmail,\\n        updates.preferredLocale ?? existing.preferredLocale,\\n        updates.profilePhotoUrl !== undefined ? updates.profilePhotoUrl : existing.profilePhotoUrl,\\n        updates.preferredActivityTime ?? existing.preferredActivityTime,\\n        updates.notificationPreference ?? existing.notificationPreference,\\n        emailChanged ? 1 : 0,\\n        updates.markOnboardingComplete ? 1 : 0,\\n        userId\\n      );\\n\\n    return this.findUserById(userId);\\n  }\\n\\n  userOwnsPhotoKey(userId: string, storageKey: string): boolean {\\n    const expectedUrl = `/api/v1/profile/photo/${storageKey}`;\\n    const userRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM users WHERE id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    if (userRow) return true;\\n    const childRow = this.db\\n      .prepare(\'SELECT 1 as ok FROM children WHERE parent_user_id = ? AND profile_photo_url = ?\')\\n      .get(userId, expectedUrl);\\n    return Boolean(childRow);\\n  }\\n\\n  recordUserConsent(\\n    userId: string,\\n    consentType: \'video_processing\' | \'privacy_policy\' | \'child_data\',\\n    ipHash: string\\n  ): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n         VALUES (?, ?, ?, \'v1.0\', ?)`\\n      )\\n      .run(crypto.randomUUID(), userId, consentType, ipHash);\\n  }\\n\\n  listAllUsers(): UserProfile[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM users ORDER BY created_at DESC\')\\n      .all() as UserRow[];\\n    return rows.map(mapUser);\\n  }\\n\\n  updateUserRoleAndStatus(\\n    userId: string,\\n    updates: { role?: UserRole; isActive?: boolean }\\n  ): UserProfile | null {\\n    const existing = this.findUserById(userId);\\n    if (!existing) return null;\\n    const nextRole = updates.role ?? existing.role;\\n    const nextActive = updates.isActive !== undefined ? (updates.isActive ? 1 : 0) : existing.isActive ? 1 : 0;\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET role = ?, is_active = ?, updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(nextRole, nextActive, userId);\\n    return this.findUserById(userId);\\n  }\\n\\n  // ======================== META: AGE GROUPS & DOMAINS ========================\\n\\n  listAgeGroups(): AgeGroup[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM age_groups ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      label: string;\\n      min_months: number;\\n      max_months: number;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  findAgeGroupBySlug(slug: string): AgeGroup | null {\\n    const r = this.db.prepare(\'SELECT * FROM age_groups WHERE slug = ?\').get(slug) as\\n      | {\\n          id: string;\\n          slug: string;\\n          label: string;\\n          min_months: number;\\n          max_months: number;\\n          sort_order: number;\\n        }\\n      | undefined;\\n    if (!r) return null;\\n    return {\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    };\\n  }\\n\\n  listLearningDomains(): LearningDomain[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM learning_domains ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      name: string;\\n      description: string;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      name: r.name,\\n      description: r.description,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  // ======================== CHILDREN ========================\\n\\n  listChildrenByParent(parentUserId: string): ChildProfile[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT c.*, ag.label as age_group_label, ag.slug as age_group_slug\\n         FROM children c\\n         JOIN age_groups ag ON ag.id = c.active_age_group_id\\n         WHERE c.parent_user_id = ?\\n         ORDER BY c.created_at ASC`\\n      )\\n      .all(parentUserId) as Array<{\\n      id: string;\\n      parent_user_id: string;\\n      display_name: string;\\n      date_of_birth: string;\\n      profile_photo_url: string | null;\\n      activity_preferences: string | null;\\n      active_age_group_id: string;\\n      age_group_label: string;\\n      age_group_slug: string;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => {\\n      const ageMonths = calculateAgeInMonths(r.date_of_birth);\\n      const currentSlug = resolveAgeGroupSlug(ageMonths);\\n      let activeAgeGroupId = r.active_age_group_id;\\n      let ageGroupLabel = r.age_group_label;\\n      let ageGroupSlug = r.age_group_slug;\\n      if (currentSlug !== r.age_group_slug) {\\n        const freshGroup = this.findAgeGroupBySlug(currentSlug);\\n        if (freshGroup) {\\n          this.db\\n            .prepare(\'UPDATE children SET active_age_group_id = ? WHERE id = ?\')\\n            .run(freshGroup.id, r.id);\\n          activeAgeGroupId = freshGroup.id;\\n          ageGroupLabel = freshGroup.label;\\n          ageGroupSlug = freshGroup.slug;\\n        }\\n      }\\n      return {\\n        id: r.id,\\n        parentUserId: r.parent_user_id,\\n        displayName: r.display_name,\\n        dateOfBirth: r.date_of_birth,\\n        profilePhotoUrl: r.profile_photo_url ?? null,\\n        activityPreferences: r.activity_preferences ?? null,\\n        activeAgeGroupId,\\n        ageGroupLabel,\\n        ageGroupSlug,\\n        ageInMonths: ageMonths,\\n        createdAt: r.created_at,\\n      };\\n    });\\n  }\\n\\n  findChildByIdForParent(childId: string, parentUserId: string): ChildProfile | null {\\n    const children = this.listChildrenByParent(parentUserId);\\n    return children.find((c) => c.id === childId) ?? null;\\n  }\\n\\n  createChild(\\n    parentUserId: string,\\n    displayName: string,\\n    dateOfBirth: string,\\n    options?: { profilePhotoUrl?: string | null; activityPreferences?: string | null }\\n  ): ChildProfile {\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const slug = resolveAgeGroupSlug(ageMonths);\\n    const ageGroup = this.findAgeGroupBySlug(slug);\\n    if (!ageGroup) {\\n      throw new Error(\'Could not resolve age group\');\\n    }\\n    const id = `ch_${crypto.randomUUID().slice(0, 10)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO children (\\n           id, parent_user_id, display_name, date_of_birth,\\n           profile_photo_url, activity_preferences, active_age_group_id\\n         ) VALUES (?, ?, ?, ?, ?, ?, ?)`\\n      )\\n      .run(\\n        id,\\n        parentUserId,\\n        displayName.trim(),\\n        dateOfBirth,\\n        options?.profilePhotoUrl ?? null,\\n        options?.activityPreferences?.trim() || null,\\n        ageGroup.id\\n      );\\n    return this.findChildByIdForParent(id, parentUserId)!;\\n  }\\n\\n  updateChild(\\n    childId: string,\\n    parentUserId: string,\\n    displayName: string,\\n    dateOfBirth: string,\\n    options?: { profilePhotoUrl?: string | null; activityPreferences?: string | null }\\n  ): ChildProfile | null {\\n    const existing = this.findChildByIdForParent(childId, parentUserId);\\n    if (!existing) return null;\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const ageGroup = this.findAgeGroupBySlug(resolveAgeGroupSlug(ageMonths))!;\\n    this.db\\n      .prepare(\\n        `UPDATE children\\n         SET display_name = ?, date_of_birth = ?,\\n             profile_photo_url = ?, activity_preferences = ?,\\n             active_age_group_id = ?,\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ? AND parent_user_id = ?`\\n      )\\n      .run(\\n        displayName.trim(),\\n        dateOfBirth,\\n        options?.profilePhotoUrl !== undefined ? options.profilePhotoUrl : existing.profilePhotoUrl,\\n        options?.activityPreferences !== undefined\\n          ? options.activityPreferences?.trim() || null\\n          : existing.activityPreferences,\\n        ageGroup.id,\\n        childId,\\n        parentUserId\\n      );\\n    return this.findChildByIdForParent(childId, parentUserId);\\n  }\", \"StartLine\":31, \"TargetContent\":\"interface UserRow {\\n  id: string;\\n  email: string;\\n  password_hash: string;\\n  full_name: string;\\n  phone_number: string | null;\\n  role: UserRole;\\n  preferred_locale: LocaleCode;\\n  is_active: number;\\n  created_at: string;\\n}\\n\\nfunction mapUser(row: UserRow): UserProfile {\\n  return {\\n    id: row.id,\\n    email: row.email,\\n    fullName: row.full_name,\\n    phoneNumber: row.phone_number,\\n    role: row.role,\\n    preferredLocale: row.preferred_locale,\\n    isActive: row.is_active === 1,\\n    createdAt: row.created_at,\\n  };\\n}\\n\\nexport class LittleStepsRepository {\\n  constructor(private readonly db: Database.Database) {}\\n\\n  // ======================== USERS & CONSENT ========================\\n\\n  findUserByEmail(email: string): (UserProfile & { passwordHash: string }) | null {\\n    const row = this.db\\n      .prepare(\'SELECT * FROM users WHERE email = ?\')\\n      .get(email.trim().toLowerCase()) as UserRow | undefined;\\n    if (!row) return null;\\n    return { ...mapUser(row), passwordHash: row.password_hash };\\n  }\\n\\n  findUserById(id: string): UserProfile | null {\\n    const row = this.db.prepare(\'SELECT * FROM users WHERE id = ?\').get(id) as UserRow | undefined;\\n    return row ? mapUser(row) : null;\\n  }\\n\\n  createUser(params: {\\n    email: string;\\n    passwordHash: string;\\n    fullName: string;\\n    phoneNumber: string | null;\\n    role: UserRole;\\n    preferredLocale: LocaleCode;\\n    ipHash: string;\\n  }): UserProfile {\\n    const id = `usr_${crypto.randomUUID().slice(0, 12)}`;\\n    const tx = this.db.transaction(() => {\\n      this.db\\n        .prepare(\\n          `INSERT INTO users (id, email, password_hash, full_name, phone_number, role, preferred_locale)\\n           VALUES (?, ?, ?, ?, ?, ?, ?)`\\n        )\\n        .run(\\n          id,\\n          params.email.trim().toLowerCase(),\\n          params.passwordHash,\\n          params.fullName.trim(),\\n          params.phoneNumber?.trim() || null,\\n          params.role,\\n          params.preferredLocale\\n        );\\n      this.db\\n        .prepare(\\n          `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n           VALUES (?, ?, \'privacy_policy\', \'v1.0\', ?)`\\n        )\\n        .run(crypto.randomUUID(), id, params.ipHash);\\n    });\\n    tx();\\n    return this.findUserById(id)!;\\n  }\\n\\n  recordUserConsent(\\n    userId: string,\\n    consentType: \'video_processing\' | \'privacy_policy\' | \'child_data\',\\n    ipHash: string\\n  ): void {\\n    this.db\\n      .prepare(\\n        `INSERT INTO user_consents (id, user_id, consent_type, policy_version, ip_hash)\\n         VALUES (?, ?, ?, \'v1.0\', ?)`\\n      )\\n      .run(crypto.randomUUID(), userId, consentType, ipHash);\\n  }\\n\\n  listAllUsers(): UserProfile[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM users ORDER BY created_at DESC\')\\n      .all() as UserRow[];\\n    return rows.map(mapUser);\\n  }\\n\\n  updateUserRoleAndStatus(\\n    userId: string,\\n    updates: { role?: UserRole; isActive?: boolean }\\n  ): UserProfile | null {\\n    const existing = this.findUserById(userId);\\n    if (!existing) return null;\\n    const nextRole = updates.role ?? existing.role;\\n    const nextActive = updates.isActive !== undefined ? (updates.isActive ? 1 : 0) : existing.isActive ? 1 : 0;\\n    this.db\\n      .prepare(\\n        `UPDATE users\\n         SET role = ?, is_active = ?, updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ?`\\n      )\\n      .run(nextRole, nextActive, userId);\\n    return this.findUserById(userId);\\n  }\\n\\n  // ======================== META: AGE GROUPS & DOMAINS ========================\\n\\n  listAgeGroups(): AgeGroup[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM age_groups ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      label: string;\\n      min_months: number;\\n      max_months: number;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  findAgeGroupBySlug(slug: string): AgeGroup | null {\\n    const r = this.db.prepare(\'SELECT * FROM age_groups WHERE slug = ?\').get(slug) as\\n      | {\\n          id: string;\\n          slug: string;\\n          label: string;\\n          min_months: number;\\n          max_months: number;\\n          sort_order: number;\\n        }\\n      | undefined;\\n    if (!r) return null;\\n    return {\\n      id: r.id,\\n      slug: r.slug,\\n      label: r.label,\\n      minMonths: r.min_months,\\n      maxMonths: r.max_months,\\n      sortOrder: r.sort_order,\\n    };\\n  }\\n\\n  listLearningDomains(): LearningDomain[] {\\n    const rows = this.db\\n      .prepare(\'SELECT * FROM learning_domains ORDER BY sort_order ASC\')\\n      .all() as Array<{\\n      id: string;\\n      slug: string;\\n      name: string;\\n      description: string;\\n      sort_order: number;\\n    }>;\\n    return rows.map((r) => ({\\n      id: r.id,\\n      slug: r.slug,\\n      name: r.name,\\n      description: r.description,\\n      sortOrder: r.sort_order,\\n    }));\\n  }\\n\\n  // ======================== CHILDREN ========================\\n\\n  listChildrenByParent(parentUserId: string): ChildProfile[] {\\n    const rows = this.db\\n      .prepare(\\n        `SELECT c.*, ag.label as age_group_label, ag.slug as age_group_slug\\n         FROM children c\\n         JOIN age_groups ag ON ag.id = c.active_age_group_id\\n         WHERE c.parent_user_id = ?\\n         ORDER BY c.created_at ASC`\\n      )\\n      .all(parentUserId) as Array<{\\n      id: string;\\n      parent_user_id: string;\\n      display_name: string;\\n      date_of_birth: string;\\n      active_age_group_id: string;\\n      age_group_label: string;\\n      age_group_slug: string;\\n      created_at: string;\\n    }>;\\n\\n    return rows.map((r) => {\\n      const ageMonths = calculateAgeInMonths(r.date_of_birth);\\n      const currentSlug = resolveAgeGroupSlug(ageMonths);\\n      // Keep child\'s age band automatically synced as baby grows\\n      let activeAgeGroupId = r.active_age_group_id;\\n      let ageGroupLabel = r.age_group_label;\\n      let ageGroupSlug = r.age_group_slug;\\n      if (currentSlug !== r.age_group_slug) {\\n        const freshGroup = this.findAgeGroupBySlug(currentSlug);\\n        if (freshGroup) {\\n          this.db\\n            .prepare(\'UPDATE children SET active_age_group_id = ? WHERE id = ?\')\\n            .run(freshGroup.id, r.id);\\n          activeAgeGroupId = freshGroup.id;\\n          ageGroupLabel = freshGroup.label;\\n          ageGroupSlug = freshGroup.slug;\\n        }\\n      }\\n      return {\\n        id: r.id,\\n        parentUserId: r.parent_user_id,\\n        displayName: r.display_name,\\n        dateOfBirth: r.date_of_birth,\\n        activeAgeGroupId,\\n        ageGroupLabel,\\n        ageGroupSlug,\\n        ageInMonths: ageMonths,\\n        createdAt: r.created_at,\\n      };\\n    });\\n  }\\n\\n  findChildByIdForParent(childId: string, parentUserId: string): ChildProfile | null {\\n    const children = this.listChildrenByParent(parentUserId);\\n    return children.find((c) => c.id === childId) ?? null;\\n  }\\n\\n  createChild(parentUserId: string, displayName: string, dateOfBirth: string): ChildProfile {\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const slug = resolveAgeGroupSlug(ageMonths);\\n    const ageGroup = this.findAgeGroupBySlug(slug);\\n    if (!ageGroup) {\\n      throw new Error(\'Could not resolve age group\');\\n    }\\n    const id = `ch_${crypto.randomUUID().slice(0, 10)}`;\\n    this.db\\n      .prepare(\\n        `INSERT INTO children (id, parent_user_id, display_name, date_of_birth, active_age_group_id)\\n         VALUES (?, ?, ?, ?, ?)`\\n      )\\n      .run(id, parentUserId, displayName.trim(), dateOfBirth, ageGroup.id);\\n    return this.findChildByIdForParent(id, parentUserId)!;\\n  }\\n\\n  updateChild(\\n    childId: string,\\n    parentUserId: string,\\n    displayName: string,\\n    dateOfBirth: string\\n  ): ChildProfile | null {\\n    const existing = this.findChildByIdForParent(childId, parentUserId);\\n    if (!existing) return null;\\n    const ageMonths = calculateAgeInMonths(dateOfBirth);\\n    const ageGroup = this.findAgeGroupBySlug(resolveAgeGroupSlug(ageMonths))!;\\n    this.db\\n      .prepare(\\n        `UPDATE children\\n         SET display_name = ?, date_of_birth = ?, active_age_group_id = ?,\\n             updated_at = strftime(\'%Y-%m-%dT%H:%M:%fZ\', \'now\')\\n         WHERE id = ? AND parent_user_id = ?`\\n      )\\n      .run(displayName.trim(), dateOfBirth, ageGroup.id, childId, parentUserId);\\n    return this.findChildByIdForParent(childId, parentUserId);\\n  }\", \"TargetFile\":\"/server/repositories/index.ts\", \"toolAction\":\"Adding Step 3 auth and onboarding repository methods\", \"toolSummary\":\"Update server/repositories/index.ts\"}"
