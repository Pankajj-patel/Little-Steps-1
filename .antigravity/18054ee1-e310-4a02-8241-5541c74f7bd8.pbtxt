            lines {
              text: "        { title: \'Greet gently by name\', instructionText: \'Wave softly at the reflection and say baby\342\200\231s name followed by \342\200\234and Mama are right here.\342\200\235\', caregiverTip: \'Pause so baby can study both faces.\' },"
