              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      { title: \'Present the card steadily\', instructionText: \'Hold the high-contrast cloth 20\342\200\22325 cm above baby\342\200\231s chest line until their eyes settle on it.\', caregiverTip: \'Wait patiently rather than shaking it.\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
